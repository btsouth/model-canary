 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(),
+                   range(1, 13)))
+_DAYS = dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+    unrestricted = text in ('*', '?')
+    if text == '?' and index in (2, 4):
+        text = '*'
+
+    def number(token):
+        if re.fullmatch(r'[0-9]+', token):
+            value = int(token)
+        elif token.upper() in names:
+            value = names[token.upper()]
+        else:
+            raise ValueError(f'bad value: {token!r}')
+        if not low <= value <= high:
+            raise ValueError(f'value out of range: {token!r}')
+        return value
+
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            specials.append(('last',))
+            continue
+        special = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if index == 4 and special:
+            weekday = number(special[1]) % 7
+            if special[2] == 'L':
+                specials.append(('last_weekday', weekday))
+            else:
+                occurrence = int(special[3])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError('weekday occurrence out of range')
+                specials.append(('nth_weekday', weekday, occurrence))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError(f'bad item: {item!r}')
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError(f'bad step: {item!r}')
+            step = int(pieces[1])
+        base = pieces[0]
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError(f'bad range: {item!r}')
+            start, end = map(number, endpoints)
+        else:
+            start = number(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError(f'reversed range: {item!r}')
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {value % 7 for value in values}
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expression must be text')
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f'unknown shortcut: {expr!r}') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return tuple(_field(field, index) for index, field in enumerate(fields))
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last = monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or bool(dom[1]) and day.day == last
+    dow_match = weekday in dow[0]
+    for special in dow[1]:
+        if weekday == special[1]:
+            if special[0] == 'last_weekday':
+                dow_match |= day.day + 7 > last
+            else:
+                dow_match |= (day.day - 1) // 7 + 1 == special[2]
+    if dom[2]:
+        return dow[2] or dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
