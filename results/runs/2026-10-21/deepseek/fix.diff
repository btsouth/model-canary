index 8965296..c921469 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,247 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTH_NAMES = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+
+_DOW_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+
+
+def _parse_value(token, minimum, maximum, names):
+    if names is not None:
+        name = token.upper()
+        if name in names:
+            return names[name]
+    if not _NUMBER.fullmatch(token):
+        raise ValueError(f"bad value: {token!r}")
+    value = int(token)
+    if value < minimum or value > maximum:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _parse_field(text, kind):
+    if kind == "minute":
+        minimum, maximum, names = 0, 59, None
+    elif kind == "hour":
+        minimum, maximum, names = 0, 23, None
+    elif kind == "dom":
+        minimum, maximum, names = 1, 31, None
+    elif kind == "month":
+        minimum, maximum, names = 1, 12, _MONTH_NAMES
+    else:
+        minimum, maximum, names = 0, 7, _DOW_NAMES
+
+    values = set()
+    last = False
+    specials = []
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in field {text!r}")
+
+        if kind == "dom" and item == "L":
+            last = True
+            continue
+
+        if kind == "dow":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                day = int(match.group(1))
+                if day > 7:
+                    raise ValueError(f"day out of range: {item!r}")
+                specials.append(("last", day))
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                day = int(match.group(1))
+                count = int(match.group(2))
+                if day > 7 or not 1 <= count <= 5:
+                    raise ValueError(f"bad day-of-week item: {item!r}")
+                specials.append(("nth", day, count))
+                continue
+
+        step = None
+        base = item
+        if "/" in item:
+            pieces = item.split("/")
+            if len(pieces) != 2 or not pieces[0] or not _NUMBER.fullmatch(pieces[1]):
+                raise ValueError(f"bad step: {item!r}")
+            base = pieces[0]
+            step = int(pieces[1])
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+
+        if base == "*":
+            start, end = minimum, maximum
+        elif "-" in base:
+            pieces = base.split("-")
+            if len(pieces) != 2 or not pieces[0] or not pieces[1]:
+                raise ValueError(f"bad range: {base!r}")
+            start = _parse_value(pieces[0], minimum, maximum, names)
+            end = _parse_value(pieces[1], minimum, maximum, names)
+            if start > end:
+                raise ValueError(f"range is backwards: {base!r}")
+        else:
+            start = _parse_value(base, minimum, maximum, names)
+            end = maximum if step is not None else start
+
+        if step is None:
+            values.update(range(start, end + 1))
+        else:
+            values.update(range(start, end + 1, step))
+
+    if kind == "dow":
+        values = {0 if value == 7 else value for value in values}
+
+    return values, last, specials
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        text = expr.strip()
+        if not text:
+            raise ValueError(f"bad schedule: {expr!r}")
+
+        if text.startswith("@"):
+            expanded = _SHORTCUTS.get(text.lower())
+            if expanded is None:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            fields = expanded.split()
+        else:
+            fields = re.split(r"[ \t]+", text)
+
+        if len(fields) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+
+        self.dom_unrestricted = fields[2] in ("*", "?")
+        self.dow_unrestricted = fields[4] in ("*", "?")
+
+        dom_text = "*" if fields[2] == "?" else fields[2]
+        dow_text = "*" if fields[4] == "?" else fields[4]
+
+        self.minutes, _, _ = _parse_field(fields[0], "minute")
+        self.hours, _, _ = _parse_field(fields[1], "hour")
+        self.dom_values, self.dom_last, _ = _parse_field(dom_text, "dom")
+        self.months, _, _ = _parse_field(fields[3], "month")
+        self.dow_values, _, self.dow_specials = _parse_field(dow_text, "dow")
+
+        self._hours = sorted(self.hours)
+        self._minutes = sorted(self.minutes)
+
+    def _dow_match(self, day):
+        weekday = (day.weekday() + 1) % 7
+        if weekday in self.dow_values:
+            return True
+        for special in self.dow_specials:
+            wanted = special[1] % 7
+            if weekday != wanted:
+                continue
+            if special[0] == "last":
+                if day.day + 7 > calendar.monthrange(day.year, day.month)[1]:
+                    return True
+            elif (day.day - 1) // 7 + 1 == special[2]:
+                return True
+        return False
+
+    def _day_allowed(self, day):
+        if day.month not in self.months:
+            return False
+        dom_match = day.day in self.dom_values or (
+            self.dom_last
+            and day.day == calendar.monthrange(day.year, day.month)[1]
+        )
+        dow_match = self._dow_match(day)
+        if not self.dom_unrestricted and not self.dow_unrestricted:
+            return dom_match or dow_match
+        if not self.dom_unrestricted:
+            return dom_match
+        if not self.dow_unrestricted:
+            return dow_match
+        return True
+
+    def matches(self, when):
+        return (
+            when.minute in self.minutes
+            and when.hour in self.hours
+            and self._day_allowed(when)
+        )
+
+    def next_run(self, after):
+        base = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+        limit = after + timedelta(days=20 * 365)
+        if base > limit:
+            return None
+
+        day = base.date()
+        end_day = limit.date()
+        while day <= end_day:
+            if self._day_allowed(day):
+                start_hour = base.hour if day == base.date() else 0
+                start_minute = base.minute if day == base.date() else 0
+                for hour in self._hours:
+                    if hour < start_hour:
+                        continue
+                    if hour == start_hour:
+                        minute = next(
+                            (m for m in self._minutes if m >= start_minute), None
+                        )
+                        if minute is None:
+                            continue
+                    else:
+                        minute = self._minutes[0]
+                    candidate = datetime(
+                        day.year, day.month, day.day, hour, minute
+                    )
+                    if candidate > limit:
+                        return None
+                    return candidate
+            day += timedelta(days=1)
+        return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _Schedule(expr).matches(when)
 
 
