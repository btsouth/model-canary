 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (low, high, names mapped to values)
+_FIELDS = [
+    (0, 59, {}),
+    (0, 23, {}),
+    (1, 31, {}),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, months, weekdays,
+                 last_day, last_weekdays, nth_weekdays,
+                 days_restricted, weekdays_restricted):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.minute_set = minutes
+        self.hour_set = hours
+        self.days = days
+        self.months = months
+        self.weekdays = weekdays
+        self.last_day = last_day
+        self.last_weekdays = last_weekdays
+        self.nth_weekdays = nth_weekdays
+        self.days_restricted = days_restricted
+        self.weekdays_restricted = weekdays_restricted
+
+    def _day_of_month_ok(self, date, month_length):
+        return date.day in self.days or (self.last_day and date.day == month_length)
+
+    def _day_of_week_ok(self, date, month_length):
+        weekday = (date.weekday() + 1) % 7
+        if weekday in self.weekdays:
+            return True
+        if weekday in self.last_weekdays and date.day + 7 > month_length:
+            return True
+        return (weekday, (date.day - 1) // 7 + 1) in self.nth_weekdays
+
+    def day_ok(self, date):
+        if date.month not in self.months:
+            return False
+        month_length = calendar.monthrange(date.year, date.month)[1]
+        if self.days_restricted and self.weekdays_restricted:
+            return (self._day_of_month_ok(date, month_length)
+                    or self._day_of_week_ok(date, month_length))
+        if self.days_restricted:
+            return self._day_of_month_ok(date, month_length)
+        if self.weekdays_restricted:
+            return self._day_of_week_ok(date, month_length)
+        return True
+
+    def matches(self, when):
+        return (when.minute in self.minute_set and when.hour in self.hour_set
+                and self.day_ok(when.date()))
+
+
+def _value(text, field, allow_names):
+    low, high, names = _FIELDS[field]
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif allow_names and names and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range")
+    return value
+
+
+def _item(text, field, values, extras):
+    low, high, _ = _FIELDS[field]
+    if field == 2 and text == "L":
+        extras["last_day"] = True
+        return
+    if field == 4:
+        match = _LAST_WEEKDAY.fullmatch(text)
+        if match:
+            extras["last_weekdays"].add(_value(match.group(1), 4, False) % 7)
+            return
+        match = _NTH_WEEKDAY.fullmatch(text)
+        if match:
+            weekday = _value(match.group(1), 4, False) % 7
+            nth = int(match.group(2))
+            if not 1 <= nth <= 5:
+                raise ValueError(f"bad week number in {text!r}")
+            extras["nth_weekdays"].add((weekday, nth))
+            return
+    base, slash, step_text = text.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step in {text!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step in {text!r}")
+    if base == "*":
+        first, last = low, high
+    elif "-" in base:
+        start_text, _, end_text = base.partition("-")
+        first = _value(start_text, field, True)
+        last = _value(end_text, field, True)
+        if first > last:
+            raise ValueError(f"backwards range {text!r}")
+    else:
+        first = _value(base, field, True)
+        last = high if slash else first
+    for value in range(first, last + 1, step):
+        values.add(value % 7 if field == 4 else value)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    sets = []
+    extras = {"last_day": False, "last_weekdays": set(), "nth_weekdays": set()}
+    for field, part in enumerate(parts):
+        values = set()
+        if part == "?":
+            if field not in (2, 4):
+                raise ValueError(f"'?' not allowed in {part!r}")
+            part = "*"
+        for item in part.split(","):
+            _item(item, field, values, extras)
+        sets.append(values)
+    return _Schedule(
+        sets[0], sets[1], sets[2], sets[3], sets[4],
+        extras["last_day"], extras["last_weekdays"], extras["nth_weekdays"],
+        parts[2] not in ("*", "?"), parts[4] not in ("*", "?"),
+    )
 
 
