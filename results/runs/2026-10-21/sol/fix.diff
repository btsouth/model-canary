 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from bisect import bisect_left
+from datetime import date, datetime, timedelta
+import re
+
+
+_MONTHS = {name: i for i, name in enumerate(
+    ('JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN',
+     'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, low, high, names=None):
+    if re.fullmatch(r'[0-9]+', token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f'bad field value: {token!r}')
+    if not low <= value <= high:
+        raise ValueError(f'field value out of range: {token!r}')
+    return value
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    unrestricted = text in ('*', '?')
+    if text == '?' and index in (2, 4):
+        text = '*'
+    values, specials = set(), []
+    for item in text.split(','):
+        if item == 'L' and index == 2:
+            specials.append(('last',))
+            continue
+        special = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if special is not None and index == 4:
+            day = _number(special[1], 0, 7) % 7
+            if special[2] == 'L':
+                specials.append(('last_weekday', day))
+            else:
+                specials.append(('nth_weekday', day,
+                                 _number(special[3], 1, 5)))
+            continue
+
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError(f'bad step: {item!r}')
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError(f'bad step: {item!r}')
+            step = int(pieces[1])
+        base = pieces[0]
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError(f'bad range: {item!r}')
+            start, end = (_number(p, low, high, names) for p in endpoints)
+            if start > end:
+                raise ValueError(f'reversed range: {item!r}')
+        else:
+            start = _number(base, low, high, names)
+            end = high if len(pieces) == 2 else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('schedule must be text')
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f'unknown shortcut: {expr!r}') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('schedule needs five fields')
+    return [_field(part, index) for index, part in enumerate(parts)]
+
+
+def _allowed_day(fields, day):
+    dom, dom_specials, dom_any = fields[2]
+    dow, dow_specials, dow_any = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    dom_match = day.day in dom
+    dow_match = weekday in dow
+    if dom_specials or dow_specials:
+        last = calendar.monthrange(day.year, day.month)[1]
+        dom_match |= bool(dom_specials) and day.day == last
+        for special in dow_specials:
+            if special[1] == weekday:
+                if special[0] == 'last_weekday':
+                    dow_match |= day.day + 7 > last
+                else:
+                    dow_match |= (day.day - 1) // 7 + 1 == special[2]
+    if dom_any and dow_any:
+        return True
+    if dom_any:
+        return dow_match
+    if dow_any:
+        return dom_match
+    return dom_match or dow_match
+
 
