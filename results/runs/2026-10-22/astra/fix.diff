 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())},
+}
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal digits')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    values, specials = set(), []
+
+    def value(token):
+        number = _NAMES.get(index, {}).get(token)
+        if number is None:
+            number = _number(token)
+        if not low <= number <= high:
+            raise ValueError('value outside field range')
+        return number
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            specials.append(('last',))
+            continue
+        special = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if index == 4 and special:
+            weekday = value(special[1]) % 7
+            if special[2] == 'L':
+                specials.append(('last_weekday', weekday))
+            else:
+                nth = _number(special[3])
+                if not 1 <= nth <= 5:
+                    raise ValueError('weekday occurrence outside range')
+                specials.append(('nth_weekday', weekday, nth))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('too many steps')
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        base = pieces[0]
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError('bad range')
+            start, end = map(value, endpoints)
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError('reversed range')
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expression must be text')
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_specials = fields[2]
+    if day.day not in dom and not (dom_specials and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow, dow_specials = fields[4]
+    if weekday in dow:
+        return True
+    return any(weekday == spec[1] and (
+        day.day + 7 > last if spec[0] == 'last_weekday'
+        else (day.day - 1) // 7 + 1 == spec[2]) for spec in dow_specials)
+
 
