 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_BOUNDS = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+
+_MONTH_NAMES = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+
+_DAY_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+
+
+def _resolve(token, field):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+        low, high = _BOUNDS[field]
+        if low <= value <= high:
+            return value
+        raise ValueError(f"{token!r} is out of range for {field}")
+    if field == "month":
+        name = token.upper()
+        if name in _MONTH_NAMES:
+            return _MONTH_NAMES[name]
+    elif field == "dow":
+        name = token.upper()
+        if name in _DAY_NAMES:
+            return _DAY_NAMES[name]
+    raise ValueError(f"bad value {token!r} for {field}")
+
+
+def _parse_field(text, field):
+    low, high = _BOUNDS[field]
+
+    if text == "?":
+        if field not in ("dom", "dow"):
+            raise ValueError(f"'?' is not allowed in {field}")
+        text = "*"
+    elif "?" in text:
+        raise ValueError(f"'?' is not allowed in {field}")
+
+    if field == "dom":
+        result = {"values": set(), "last": False}
+    elif field == "dow":
+        result = {"values": set(), "last": [], "nth": []}
+    else:
+        result = set()
+
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {field}")
+
+        if field == "dom" and item == "L":
+            result["last"] = True
+            continue
+
+        if field == "dow":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                day = int(match.group(1))
+                if not 0 <= day <= 7:
+                    raise ValueError(f"bad day {day} for {field}")
+                result["last"].append(day % 7)
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                day = int(match.group(1))
+                occurrence = int(match.group(2))
+                if not 0 <= day <= 7 or not 1 <= occurrence <= 5:
+                    raise ValueError(f"bad day occurrence {item!r} for {field}")
+                result["nth"].append((day % 7, occurrence))
+                continue
+
+        if "/" in item:
+            pieces = item.split("/")
+            if len(pieces) != 2:
+                raise ValueError(f"bad step in {item!r}")
+            base, step_text = pieces
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step in {item!r}")
+        else:
+            base = item
+            step = None
+
+        if base == "*":
+            values = list(range(low, high + 1))
+        elif "-" in base:
+            pieces = base.split("-")
+            if len(pieces) != 2:
+                raise ValueError(f"bad range {base!r} for {field}")
+            first = _resolve(pieces[0], field)
+            last = _resolve(pieces[1], field)
+            if first > last:
+                raise ValueError(f"bad range {base!r} for {field}")
+            values = list(range(first, last + 1))
+        else:
+            value = _resolve(base, field)
+            if step is None:
+                values = [value]
+            else:
+                values = list(range(value, high + 1))
+
+        if step is not None:
+            values = values[::step]
+
+        if field == "dom":
+            result["values"].update(values)
+        elif field == "dow":
+            result["values"].update(value % 7 for value in values)
+        else:
+            result.update(values)
+
+    return result
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    shortcut = text.lower()
+    if shortcut in _SHORTCUTS:
+        text = _SHORTCUTS[shortcut]
+    elif shortcut.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    if text:
+        parts = re.split(r"[ \t]+", text)
+    else:
+        parts = []
+    if len(parts) != 5:
+        raise ValueError(f"bad schedule: {expr!r}")
+
+    minute = _parse_field(parts[0], "minute")
+    hour = _parse_field(parts[1], "hour")
+    dom = _parse_field(parts[2], "dom")
+    month = _parse_field(parts[3], "month")
+    dow = _parse_field(parts[4], "dow")
+
+    return {
+        "minute": minute,
+        "hour": hour,
+        "dom": dom,
+        "month": month,
+        "dow": dow,
+        "hours": sorted(hour),
+        "minutes": sorted(minute),
+    }
+
+
+def _days_in_month(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _dom_matches(rule, when):
+    if when.day in rule["values"]:
+        return True
+    return rule["last"] and when.day == _days_in_month(when.year, when.month)
+
+
+def _dow_matches(rule, when):
+    weekday = when.isoweekday() % 7
+    if weekday in rule["values"]:
+        return True
+    last_day = _days_in_month(when.year, when.month)
+    if rule["last"] and weekday in rule["last"] and when.day + 7 > last_day:
+        return True
+    for day, occurrence in rule["nth"]:
+        if day == weekday and (when.day - 1) // 7 + 1 == occurrence:
+            return True
+    return False
+
+
+def _day_matches(spec, when):
+    return _dom_matches(spec["dom"], when) and _dow_matches(spec["dow"], when)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return (
+        when.minute in spec["minute"]
+        and when.hour in spec["hour"]
+        and when.month in spec["month"]
+        and _day_matches(spec, when)
+    )
+
+
+def _first_time(spec, date, start):
+    first_hour = start.hour if date == start.date() else 0
+    first_minute = start.minute if date == start.date() else 0
+    for hour in spec["hours"]:
+        if hour < first_hour:
+            continue
+        if hour > first_hour:
+            return hour, spec["minutes"][0]
+        for minute in spec["minutes"]:
+            if minute >= first_minute:
+                return hour, minute
+    return None
 
 
