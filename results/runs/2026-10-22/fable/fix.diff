+            for hour in hours:
+                if date == floor.date() and hour < floor.hour:
+                    continue
+                for minute in minutes:
+                    run = _dt.datetime.combine(date, _dt.time(hour, minute))
+                    if run <= floor:
+                        continue
+                    if run > limit:
+                        return None
+                    return run
+        date += one_day
+        if _dt.datetime.combine(date, _dt.time()) > limit:
+            return None
