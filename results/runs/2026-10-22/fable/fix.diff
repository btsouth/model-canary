 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_MONTH_NAMES = {name: i + 1 for i, name in enumerate(_MONTHS)}
+_DAY_NAMES = {name: i for i, name in enumerate(_DAYS)}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (low, high, names) per field: minute, hour, day of month, month, day of week
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTH_NAMES), (0, 7, _DAY_NAMES)]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_NUMBER = re.compile(r"[0-9]+", re.ASCII)
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+def _number(text, expr):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad number {text!r} in {expr!r}")
+    return int(text)
+
+
+def _value(text, low, high, names, expr):
+    """A single value: a number in range, or a name if names are allowed."""
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    value = _number(text, expr)
+    if not low <= value <= high:
+        raise ValueError(f"value {value} out of range in {expr!r}")
+    return value
+
+
+def _parse_item(item, index, expr, spec):
+    """Add one comma-separated item of a field to spec."""
+    low, high, names = _FIELDS[index]
+    if not item:
+        raise ValueError(f"empty item in {expr!r}")
+
+    if index == _DOM and item.upper() == "L":
+        spec["last_dom"] = True
+        return
+    if index == _DOW and "#" in item:
+        n, _, k = item.partition("#")
+        n, k = _number(n, expr), _number(k, expr)
+        if not 0 <= n <= 7 or not 1 <= k <= 5:
+            raise ValueError(f"bad N#K item {item!r} in {expr!r}")
+        spec["nth_dow"].add((n % 7, k))
+        return
+    if index == _DOW and item.upper().endswith("L"):
+        n = _number(item[:-1], expr)
+        if not 0 <= n <= 7:
+            raise ValueError(f"bad NL item {item!r} in {expr!r}")
+        spec["last_dow"].add(n % 7)
+        return
+
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        step = _number(step_text, expr)
+        if step < 1:
+            raise ValueError(f"step must be at least 1 in {expr!r}")
+
+    if base == "*":
+        start, end = low, high
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        start, end = _value(a, low, high, names, expr), _value(b, low, high, names, expr)
+        if start > end:
+            raise ValueError(f"range {base!r} runs backwards in {expr!r}")
+    else:
+        start = _value(base, low, high, names, expr)
+        end = high if slash else start
+
+    values = range(start, end + 1, step)
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    spec["values"].update(values)
+
+
+def _parse_field(text, index, expr):
+    spec = {"values": set(), "any": False, "last_dom": False, "last_dow": set(), "nth_dow": set()}
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError(f"'?' only allowed in the day fields: {expr!r}")
+        spec["any"] = True
+        return spec
+    for item in text.split(","):
+        _parse_item(item, index, expr, spec)
+    low, high, _ = _FIELDS[index]
+    full = set(range(low, high + 1)) if index != _DOW else set(range(7))
+    if spec["values"] >= full:
+        spec["any"] = True
+    return spec
+
+
+def _parse(expr):
+    """Parse an expression into a list of five field specs, or raise ValueError."""
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string, not {type(expr).__name__}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields in {expr!r}")
+    return [_parse_field(part, i, expr) for i, part in enumerate(parts)]
+
+
+def _day_allowed(spec, date):
+    """True if the date passes the day-of-month, month and day-of-week fields."""
+    if date.month not in spec[_MONTH]["values"]:
+        return False
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom = spec[_DOM]
+    if not (dom["any"] or date.day in dom["values"] or (dom["last_dom"] and date.day == last)):
+        return False
+    dow = spec[_DOW]
+    if dow["any"]:
+        return True
+    weekday = (date.weekday() + 1) % 7  # Sunday is 0
+    if weekday in dow["values"]:
+        return True
+    if weekday in dow["last_dow"] and date.day + 7 > last:
+        return True
+    return (weekday, (date.day - 1) // 7 + 1) in dow["nth_dow"]
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return (
