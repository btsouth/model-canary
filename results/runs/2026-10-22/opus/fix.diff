 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun",
+     "jul", "aug", "sep", "oct", "nov", "dec"], 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+
+_NUM = re.compile(r"[0-9]+")
+_STEP = re.compile(r"(.*)/([0-9]+)")
+_RANGE = re.compile(r"([^-]+)-([^-]+)")
+_LAST = re.compile(r"([0-9]+)L")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays, last_weekdays, nth):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.days = days
+        self.last_day = last_day
+        self.months = months
+        self.weekdays = weekdays
+        self.last_weekdays = last_weekdays
+        self.nth = nth
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        last = calendar.monthrange(date.year, date.month)[1]
+        if not (date.day in self.days or (self.last_day and date.day == last)):
+            return False
+        weekday = (date.weekday() + 1) % 7
+        return (weekday in self.weekdays
+                or (weekday in self.last_weekdays and date.day + 7 > last)
+                or (weekday, (date.day - 1) // 7 + 1) in self.nth)
+
+
+def _value(text, low, high, names):
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.lower() in names:
+        value = names[text.lower()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _number(text, low, high):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+
+    sets = []
+    last_day = False
+    last_weekdays, nth = set(), set()
+    for index, (part, (low, high, names)) in enumerate(zip(parts, _FIELDS)):
+        values = set()
+        if part == "?" and index in (2, 4):
+            part = "*"
+        for item in part.split(","):
+            if index == 2 and item == "L":
+                last_day = True
+                continue
+            if index == 4:
+                m = _LAST.fullmatch(item)
+                if m:
+                    last_weekdays.add(_number(m.group(1), 0, 7) % 7)
+                    continue
+                m = _NTH.fullmatch(item)
+                if m:
+                    nth.add((_number(m.group(1), 0, 7) % 7, _number(m.group(2), 1, 5)))
+                    continue
+            step = None
+            m = _STEP.fullmatch(item)
+            if m:
+                item = m.group(1)
+                step = int(m.group(2))
+                if step < 1:
+                    raise ValueError(f"step must be at least 1: {part!r}")
+            if item == "*":
+                start, end = low, high
+            else:
+                m = _RANGE.fullmatch(item)
+                if m:
+                    start = _value(m.group(1), low, high, names)
+                    end = _value(m.group(2), low, high, names)
+                    if start > end:
+                        raise ValueError(f"backwards range: {item!r}")
+                else:
+                    start = _value(item, low, high, names)
+                    end = start if step is None else high
+            values.update(range(start, end + 1, step or 1))
+        sets.append(values)
+
+    minutes, hours, days, months, weekdays = sets
+    weekdays = {d % 7 for d in weekdays}
+    return _Schedule(minutes, hours, days, last_day, months, weekdays, last_weekdays, nth)
 
 
