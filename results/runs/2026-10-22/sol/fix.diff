 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import date, datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_RANGES = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text, low, high, names=None):
+    if names and text.upper() in names:
+        return names[text.upper()]
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError("invalid schedule number")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError("schedule number out of range")
+    return value
+
+
+def _field(text, index):
+    low, high = _RANGES[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    values, specials = set(), []
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last", 0, 0))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if index == 4 and special:
+            weekday = _number(special[1], 0, 7) % 7
+            nth = _number(special[3], 1, 5) if special[3] else 0
+            specials.append(("weekday", weekday, nth))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid schedule step")
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError("invalid schedule step")
+            step = int(pieces[1])
+        base = pieces[0]
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            bounds = base.split("-")
+            if len(bounds) != 2:
+                raise ValueError("invalid schedule range")
+            start, end = (_number(bound, low, high, names) for bound in bounds)
+        else:
+            start = _number(base, low, high, names)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError("descending schedule range")
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {value % 7 for value in values}
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(part, index) for index, part in enumerate(parts)]
+
+
+def _day_matches(fields, day):
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_specials = fields[2]
+    dow, dow_specials = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    dom_match = day.day in dom or (bool(dom_specials) and day.day == last)
+    dow_match = weekday in dow or any(
+        weekday == target and
+        ((nth == 0 and day.day + 7 > last) or (day.day - 1) // 7 + 1 == nth)
+        for _, target, nth in dow_specials)
+    return dom_match and dow_match
+
 
