 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, low, high, names=None):
+    if re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    elif names and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"invalid value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _field(text, index):
+    low, high = _LIMITS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    values, specials = set(), []
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if index == 4 and special:
+            day = _number(special[1], 0, 7) % 7
+            if special[2] == "L":
+                specials.append(("last", day))
+            else:
+                specials.append(("nth", day, _number(special[3], 1, 5)))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError(f"invalid step: {pieces[1]!r}")
+            step = int(pieces[1])
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = (_number(part, low, high, names) for part in endpoints)
+            if start > end:
+                raise ValueError(f"reversed range: {base!r}")
+        else:
+            start = _number(base, low, high, names)
+            end = high if len(pieces) == 2 else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {value % 7 for value in values}
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    return tuple(_field(field, index) for index, field in enumerate(fields))
+
+
+def _day_matches(parsed, day):
+    if day.month not in parsed[3][0]:
+        return False
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    last = calendar.monthrange(day.year, day.month)[1]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    if weekday in dow:
+        return True
+    return any(weekday == special[1] and (
+        day.day + 7 > last if special[0] == "last"
+        else (day.day - 1) // 7 + 1 == special[2]
+    ) for special in dow_special)
+
+
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    parsed = _parse(expr)
+    return (when.minute in parsed[0][0] and when.hour in parsed[1][0]
+            and _day_matches(parsed, when))
 
 
