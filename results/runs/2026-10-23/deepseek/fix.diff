+    def __init__(self, values, last=False, last_weekdays=(), nth_weekdays=()):
+        self.values = frozenset(values)
+        self.last = last
+        self.last_weekdays = frozenset(last_weekdays)
+        self.nth_weekdays = frozenset(nth_weekdays)
+
+
+class _Schedule:
+    __slots__ = ("minute", "hour", "dom", "month", "dow", "minutes", "hours")
+
+    def __init__(self, minute, hour, dom, month, dow):
+        self.minute = minute
+        self.hour = hour
+        self.dom = dom
+        self.month = month
+        self.dow = dow
+        self.minutes = sorted(minute.values)
+        self.hours = sorted(hour.values)
+
+
+def _resolve(token, low, high, names, allow_names):
+    if allow_names and names is not None and token.upper() in names:
+        value = names[token.upper()]
+    elif _NUMBER.fullmatch(token):
+        value = int(token)
+    else:
+        raise ValueError(f"bad value {token!r}")
+    if value < low or value > high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _parse_base(item, low, high, names, allow_names):
+    if item == "*":
+        return list(range(low, high + 1))
+    if "-" in item:
+        if item.count("-") != 1:
+            raise ValueError(f"bad range: {item!r}")
+        left, right = item.split("-")
+        start = _resolve(left, low, high, names, allow_names)
+        end = _resolve(right, low, high, names, allow_names)
+        if start > end:
+            raise ValueError(f"bad range: {item!r}")
+        return list(range(start, end + 1))
+    return [_resolve(item, low, high, names, allow_names)]
+
+
+def _parse_field(text, kind):
+    low, high, names = _SPECS[kind]
+
+    if kind in ("dom", "dow") and text == "?":
+        text = "*"
+
+    values = set()
+    last = False
+    last_weekdays = set()
+    nth_weekdays = set()
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+
+        if kind == "dom" and item == "L":
+            last = True
+            continue
+
+        if kind == "dow":
+            match = _LAST_WEEKDAY.fullmatch(item)
+            if match:
+                weekday = int(match.group(1))
+                if weekday < 0 or weekday > 7:
+                    raise ValueError(f"value out of range: {item!r}")
+                last_weekdays.add(weekday % 7)
+                continue
+
+            match = _NTH_WEEKDAY.fullmatch(item)
+            if match:
+                weekday = int(match.group(1))
+                occurrence = int(match.group(2))
+                if weekday < 0 or weekday > 7:
+                    raise ValueError(f"value out of range: {item!r}")
+                if occurrence < 1 or occurrence > 5:
+                    raise ValueError(f"value out of range: {item!r}")
+                nth_weekdays.add((weekday % 7, occurrence))
+                continue
+
+        if "/" in item:
+            if item.count("/") != 1:
+                raise ValueError(f"bad step: {item!r}")
+            base, step_text = item.split("/")
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+
+            if base == "*":
+                sequence = list(range(low, high + 1))
+            else:
+                sequence = _parse_base(base, low, high, names, False)
+                if "-" not in base:
+                    sequence = list(range(sequence[0], high + 1))
+            values.update(sequence[::step])
+        else:
+            values.update(_parse_base(item, low, high, names, True))
+
+    if kind == "dow":
+        values = {value % 7 for value in values}
+    return _Field(values, last, last_weekdays, nth_weekdays)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule")
+
+    if text.startswith("@"):
+        shortcut = _SHORTCUTS.get(text.lower())
+        if shortcut is None:
+            raise ValueError(f"unknown shortcut: {text!r}")
+        fields = shortcut.split()
+    else:
+        fields = re.split(r"[ \t]+", text)
+
+    if len(fields) != 5:
+        raise ValueError(f"wrong number of fields: {text!r}")
+
+    minute = _parse_field(fields[0], "minute")
+    hour = _parse_field(fields[1], "hour")
+    dom = _parse_field(fields[2], "dom")
+    month = _parse_field(fields[3], "month")
+    dow = _parse_field(fields[4], "dow")
+    return _Schedule(minute, hour, dom, month, dow)
+
+
+def _day_matches(day, schedule):
+    last_day = calendar.monthrange(day.year, day.month)[1]
+
+    dom = schedule.dom
+    if day.day not in dom.values and not (dom.last and day.day == last_day):
+        return False
+
+    dow = schedule.dow
+    weekday = day.isoweekday() % 7
+
+    if weekday in dow.values:
+        return True
+    if weekday in dow.last_weekdays and day.day + 7 > last_day:
+        return True
+    occurrence = (day.day - 1) // 7 + 1
+    return (weekday, occurrence) in dow.nth_weekdays
+
 
