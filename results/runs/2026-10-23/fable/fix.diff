 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+_NUMBER = re.compile(r"[0-9]+\Z")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)\Z")
+_LAST_DOW = re.compile(r"([0-9]+)L\Z")
+_LIMIT = dt.timedelta(days=10 * 365)
+
+# (minimum, maximum, names) per field
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last", "dom_any",
+                 "dow", "dow_last", "dow_nth", "dow_any")
+
+    def day_allowed(self, date):
+        last = calendar.monthrange(date.year, date.month)[1]
+        if not self.dom_any:
+            if date.day not in self.dom and not (self.dom_last and date.day == last):
+                return False
+        if self.dow_any:
+            return True
+        wd = (date.weekday() + 1) % 7
+        if wd in self.dow:
+            return True
+        if wd in self.dow_last and date.day + 7 > last:
+            return True
+        return (wd, (date.day - 1) // 7 + 1) in self.dow_nth
+
+
+def _value(token, lo, hi, names, allow_names=True):
+    if _NUMBER.match(token):
+        value = int(token)
+    elif names and allow_names and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {token!r} out of range {lo}-{hi}")
+    return value
+
+
+def _item(item, lo, hi, names):
+    """Expand one plain item (*, N, A-B, optionally /S) into a list of values."""
+    if not item:
+        raise ValueError("empty item")
+    base, sep, step = item.partition("/")
+    if sep:
+        if not _NUMBER.match(step):
+            raise ValueError(f"bad step {step!r}")
+        step = int(step)
+        if step < 1:
+            raise ValueError("step must be at least 1")
+    else:
+        step = 1
+    if base == "*":
+        values = range(lo, hi + 1)
+    elif "-" in base:
+        a, b = base.split("-", 1)
+        a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+        if a > b:
+            raise ValueError(f"range {base!r} runs backwards")
+        values = range(a, b + 1)
+    else:
+        n = _value(base, lo, hi, names)
+        values = range(n, hi + 1) if sep else [n]
+    return list(values)[::step]
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {text!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}")
+    s = _Schedule()
+    s.dom, s.dom_last, s.dom_any = set(), False, False
+    s.dow, s.dow_last, s.dow_nth, s.dow_any = set(), set(), set(), False
+    plain = []
+    for index, (field, (lo, hi, names)) in enumerate(zip(parts, _FIELDS)):
+        if field == "?" and index in (2, 4):
+            if index == 2:
+                s.dom_any = True
+            else:
+                s.dow_any = True
+            plain.append(set())
+            continue
+        values = set()
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                s.dom_last = True
+                continue
+            if index == 4:
+                m = _LAST_DOW.match(item)
+                if m:
+                    s.dow_last.add(_value(m.group(1), 0, 7, None) % 7)
+                    continue
+                m = _NTH.match(item)
+                if m:
+                    k = int(m.group(2))
+                    if not 1 <= k <= 5:
+                        raise ValueError(f"bad week number in {item!r}")
+                    s.dow_nth.add((_value(m.group(1), 0, 7, None) % 7, k))
+                    continue
+            values.update(_item(item, lo, hi, names))
+        plain.append(values)
+    s.minutes = sorted(plain[0])
+    s.hours = sorted(plain[1])
+    s.months = plain[3]
+    if not s.dom_any:
+        s.dom = plain[2]
+        s.dom_any = s.dom == set(range(1, 32))
+    if not s.dow_any:
+        s.dow = {d % 7 for d in plain[4]}
+        s.dow_any = s.dow == set(range(7))
+    return s
+
 
