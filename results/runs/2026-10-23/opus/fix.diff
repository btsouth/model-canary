 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"], 1)}
+_DAYS = {name: i for i, name in enumerate(["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+
+# (minimum, maximum, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays, last_weekdays, nth_weekdays):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.days = days
+        self.last_day = last_day
+        self.months = months
+        self.weekdays = weekdays
+        self.last_weekdays = last_weekdays
+        self.nth_weekdays = nth_weekdays
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        length = calendar.monthrange(date.year, date.month)[1]
+        if not (date.day in self.days or (self.last_day and date.day == length)):
+            return False
+        weekday = (date.weekday() + 1) % 7
+        return (
+            weekday in self.weekdays
+            or (weekday in self.last_weekdays and date.day + 7 > length)
+            or (weekday, (date.day - 1) // 7 + 1) in self.nth_weekdays
+        )
+
+
+def _number(text, low, high):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _value(text, low, high, names):
+    if names is not None and text.lower() in names:
+        return names[text.lower()]
+    return _number(text, low, high)
+
+
+def _parse_field(text, index):
+    """Return (values, last_day, last_weekdays, nth_weekdays) for one field."""
+    low, high, names = _FIELDS[index]
+    values, last_day, last_weekdays, nth_weekdays = set(), False, set(), set()
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == 2 and item == "L":
+            last_day = True
+            continue
+        if index == 4 and item.endswith("L") and _NUMBER.fullmatch(item[:-1]):
+            last_weekdays.add(_number(item[:-1], 0, 7) % 7)
+            continue
+        if index == 4 and "#" in item:
+            day, _, nth = item.partition("#")
+            nth_weekdays.add((_number(day, 0, 7) % 7, _number(nth, 1, 5)))
+            continue
+        base, slash, step = item.partition("/")
+        step = _number(step, 1, float("inf")) if slash else 1
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            first, _, last = base.partition("-")
+            start, end = _value(first, low, high, names), _value(last, low, high, names)
+            if start > end:
+                raise ValueError(f"range goes backwards: {item!r}")
+        else:
+            start = _value(base, low, high, names)
+            end = high if slash else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, last_day, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom, month, dow = (_parse_field(part, i) for i, part in enumerate(parts))
+    return _Schedule(minute[0], hour[0], dom[0], dom[1], month[0], dow[0], dow[2], dow[3])
 
 
