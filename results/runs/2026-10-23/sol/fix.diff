 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from bisect import bisect_right
+from datetime import date, datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(),
+                   range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+
+
+def _number(token, low, high, names=None):
+    if re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    elif names and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"invalid value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    if text == "?" and index in (2, 4):
+        text = "*"
+    values, special = set(), []
+    for item in text.split(","):
+        if index == 2 and item.upper() == "L":
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item, re.IGNORECASE)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if index == 4 and (last or nth):
+            day = _number((last or nth).group(1), 0, 7) % 7
+            if last:
+                special.append(("last", day))
+            else:
+                special.append(("nth", day, _number(nth.group(2), 1, 5)))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError(f"invalid step: {item!r}")
+            step = int(pieces[1])
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid range: {item!r}")
+            start, end = (_number(token, low, high, names) for token in ends)
+            if start > end:
+                raise ValueError(f"reversed range: {item!r}")
+        else:
+            start = _number(base, low, high, names)
+            end = high if len(pieces) == 2 else start
+        listed = range(start, end + 1, step)
+        values.update(value % 7 if index == 4 else value for value in listed)
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("expected five schedule fields")
+    return [_field(field, i) for i, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    dom, dom_special = fields[2]
+    dow, dow_special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in dom or bool(dom_special) and day.day == last_day
+    dow_ok = weekday in dow or any(
+        weekday == rule[1] and (
+            day.day + 7 > last_day if rule[0] == "last"
+            else (day.day - 1) // 7 + 1 == rule[2]
+        ) for rule in dow_special
+    )
+    return dom_ok and dow_ok
+
 
