 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from bisect import bisect_right
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())},
+}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five schedule fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        values, special = set(), []
+
+        def number(token):
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in _NAMES.get(index, {}):
+                value = _NAMES[index][token.upper()]
+            else:
+                raise ValueError('invalid schedule value')
+            if not low <= value <= high:
+                raise ValueError('schedule value out of range')
+            return value
+
+        if field == '?' and index in (2, 4):
+            field = '*'
+        for item in field.split(','):
+            if item == 'L' and index == 2:
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-9]+)(L|#([1-5]))', item)
+            if match and index == 4:
+                weekday = number(match[1]) % 7
+                special.append(('weekday', weekday,
+                                None if match[2] == 'L' else int(match[3])))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2:
+                raise ValueError('invalid step')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                sequence = list(range(low, high + 1))
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, ends)
+                if start <= end:
+                    sequence = list(range(start, end + 1))
+                elif index == 4:
+                    start, end = start % 7, end % 7
+                    sequence = [(start + offset) % 7
+                                for offset in range((end - start) % 7 + 1)]
+                else:
+                    sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+            else:
+                start = number(base)
+                sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+            values.update(value % 7 if index == 4 else value for value in sequence[::step])
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, day):
+    if day.month not in parsed[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = parsed[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow, dow_special = parsed[4]
+    return weekday in dow or any(
+        weekday == wanted and
+        (day.day + 7 > last if occurrence is None else (day.day - 1) // 7 + 1 == occurrence)
+        for _, wanted, occurrence in dow_special)
+
 
