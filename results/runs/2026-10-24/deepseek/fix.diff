+    except OverflowError:
+        limit = datetime.max
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    last = limit.replace(second=0, microsecond=0)
+    if start > last:
+        return None
+    ordered_minutes = sorted(minutes)
+    ordered_hours = sorted(hours)
+    day = start.date()
+    last_day = last.date()
+    start_day = start.date()
