 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+_DAY_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6,
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUMBER = re.compile(r"[0-9]+\Z")
+
+
+def _field_value(token, low, high, names=None):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad field value: {token!r}")
+    if value < low or value > high:
+        raise ValueError(f"field value out of range: {token!r}")
+    return value
+
+
+def _split_step(item):
+    if "/" not in item:
+        return item, 1, False
+    pieces = item.split("/")
+    if len(pieces) != 2 or not pieces[0] or not pieces[1]:
+        raise ValueError(f"bad step: {item!r}")
+    if not _NUMBER.fullmatch(pieces[1]):
+        raise ValueError(f"bad step: {item!r}")
+    step = int(pieces[1])
+    if step < 1:
+        raise ValueError(f"bad step: {item!r}")
+    return pieces[0], step, True
+
+
+def _plain_item(item, low, high, names=None):
+    base, step, has_step = _split_step(item)
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        ends = base.split("-")
+        if len(ends) != 2 or not ends[0] or not ends[1]:
+            raise ValueError(f"bad range: {item!r}")
+        start = _field_value(ends[0], low, high, names)
+        end = _field_value(ends[1], low, high, names)
+        if start <= end:
+            values = list(range(start, end + 1))
+        else:
+            values = list(range(start, high + 1)) + list(range(low, end + 1))
+    else:
+        start = _field_value(base, low, high, names)
+        values = list(range(start, high + 1)) if has_step else [start]
+    return values[::step]
+
+
+def _parse_list(text, low, high, names=None):
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        values.update(_plain_item(item, low, high, names))
+    return values
+
+
+def _parse_dom(text):
+    if text == "?":
+        return set(range(1, 32)), False
+    days = set()
+    last = False
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if item == "L":
+            last = True
+        else:
+            days.update(_plain_item(item, 1, 31))
+    return days, last
+
+
+def _dow_item(base, step, has_step):
+    if base == "*":
+        values = list(range(0, 8))
+    elif "-" in base:
+        ends = base.split("-")
+        if len(ends) != 2 or not ends[0] or not ends[1]:
+            raise ValueError(f"bad range: {base!r}")
+        start = _field_value(ends[0], 0, 7, _DAY_NAMES)
+        end = _field_value(ends[1], 0, 7, _DAY_NAMES)
+        if start <= end:
+            values = list(range(start, end + 1))
+        else:
+            start = 0 if start == 7 else start
+            end = 0 if end == 7 else end
+            if start <= end:
+                values = list(range(start, end + 1))
+            else:
+                values = list(range(start, 7)) + list(range(0, end + 1))
+    else:
+        start = _field_value(base, 0, 7, _DAY_NAMES)
+        values = list(range(start, 8)) if has_step else [start]
+    return {0 if value == 7 else value for value in values[::step]}
+
+
+def _parse_dow(text):
+    if text == "?":
+        return set(range(0, 7)), set(), set()
+    weekdays = set()
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        base, step, has_step = _split_step(item)
+        if "#" in base:
+            if has_step:
+                raise ValueError(f"bad special day: {item!r}")
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", base)
+            if not match:
+                raise ValueError(f"bad special day: {item!r}")
+            weekday = int(match.group(1))
+            occurrence = int(match.group(2))
+            if weekday > 7 or occurrence < 1 or occurrence > 5:
+                raise ValueError(f"bad special day: {item!r}")
+            nth_weekdays.add((0 if weekday == 7 else weekday, occurrence))
+        elif base.endswith("L"):
+            if has_step:
+                raise ValueError(f"bad special day: {item!r}")
+            match = re.fullmatch(r"([0-9]+)L", base)
+            if not match:
+                raise ValueError(f"bad special day: {item!r}")
+            weekday = int(match.group(1))
+            if weekday > 7:
+                raise ValueError(f"bad special day: {item!r}")
+            last_weekdays.add(0 if weekday == 7 else weekday)
+        else:
+            weekdays.update(_dow_item(base, step, has_step))
+    return weekdays, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"schedule must have five fields: {expr!r}")
+    minutes = _parse_list(fields[0], 0, 59)
+    hours = _parse_list(fields[1], 0, 23)
+    dom_days, dom_last = _parse_dom(fields[2])
+    months = _parse_list(fields[3], 1, 12, _MONTH_NAMES)
+    weekdays, last_weekdays, nth_weekdays = _parse_dow(fields[4])
+    return (
+        minutes, hours, dom_days, dom_last, months,
+        weekdays, last_weekdays, nth_weekdays,
+    )
+
+
+def _day_matches(schedule, day):
+    minutes, hours, dom_days, dom_last, months, weekdays, last_weekdays, nth_weekdays = schedule
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    if day.day not in dom_days and not (dom_last and day.day == last_day):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    if weekday in weekdays:
+        return True
+    if weekday in last_weekdays and day.day + 7 > last_day:
+        return True
+    occurrence = (day.day - 1) // 7 + 1
+    return (weekday, occurrence) in nth_weekdays
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    minutes, hours, dom_days, dom_last, months, weekdays, last_weekdays, nth_weekdays = schedule
