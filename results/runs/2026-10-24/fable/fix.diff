 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_HORIZON = _dt.timedelta(days=20 * 365)
+_DIGITS = re.compile(r"[0-9]+$")
+
+
+class _Field:
+    """One parsed field: a set of values plus day-field extras."""
+
+    def __init__(self):
+        self.star = False       # '*' or '?': matches everything
+        self.values = set()
+        self.last_day = False   # day of month 'L'
+        self.last_dow = set()   # day of week 'NL'
+        self.nth_dow = set()    # day of week 'N#K' as (N, K)
+
+
+def _number(text, lo, hi, names, what):
+    """Parse a single value for a field, allowing names when given."""
+    if _DIGITS.match(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r} in {what} field")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {text!r} out of range in {what} field")
+    return value
+
+
+def _parse_field(text, lo, hi, names, what):
+    is_dom = what == "day of month"
+    is_dow = what == "day of week"
+    field = _Field()
+    if text == "?":
+        if not (is_dom or is_dow):
+            raise ValueError(f"'?' is not allowed in the {what} field")
+        field.star = True
+        return field
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {what} field")
+        if item == "L":
+            if not is_dom:
+                raise ValueError("'L' is only allowed in the day of month field")
+            field.last_day = True
+            continue
+        if is_dow and item.endswith("L") and _DIGITS.match(item[:-1]):
+            n = int(item[:-1])
+            if n > 7:
+                raise ValueError(f"bad value {item!r} in {what} field")
+            field.last_dow.add(n % 7)
+            continue
+        if "#" in item:
+            if not is_dow:
+                raise ValueError("'N#K' is only allowed in the day of week field")
+            n_text, _, k_text = item.partition("#")
+            if not (_DIGITS.match(n_text) and _DIGITS.match(k_text)):
+                raise ValueError(f"bad item {item!r} in {what} field")
+            n, k = int(n_text), int(k_text)
+            if n > 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad item {item!r} in {what} field")
+            field.nth_dow.add((n % 7, k))
+            continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not _DIGITS.match(step_text):
+                raise ValueError(f"bad step in {item!r} in {what} field")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step of 0 in {what} field")
+        if base == "*":
+            if not slash:
+                field.star = True
+                field.values.update(range(lo, hi + 1))
+                continue
+            listed = list(range(lo, hi + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a = _number(a_text, lo, hi, names, what)
+            b = _number(b_text, lo, hi, names, what)
+            if is_dow:
+                a, b = a % 7, b % 7
+                top = 6
+            else:
+                top = hi
+            if a <= b:
+                listed = list(range(a, b + 1))
+            else:
+                listed = list(range(a, top + 1)) + list(range(lo, b + 1))
+        else:
+            n = _number(base, lo, hi, names, what)
+            listed = list(range(n, hi + 1)) if slash else [n]
+        field.values.update(listed[::step])
+    if is_dow:
+        field.values = {v % 7 for v in field.values}
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {text!r}") from None
+    parts = re.split(r"[ \t]+", text) if text else []
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    minute = _parse_field(parts[0], 0, 59, None, "minute")
+    hour = _parse_field(parts[1], 0, 23, None, "hour")
+    dom = _parse_field(parts[2], 1, 31, None, "day of month")
+    month = _parse_field(parts[3], 1, 12, _MONTHS, "month")
+    dow = _parse_field(parts[4], 0, 7, _DAYS, "day of week")
+    return minute, hour, dom, month, dow
+
+
+def _day_allowed(dom, dow, date):
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = date.isoweekday() % 7  # Sunday is 0
+    dom_ok = (dom.star or date.day in dom.values
+              or (dom.last_day and date.day == last))
+    if not dom_ok:
+        return False
+    if dow.star or weekday in dow.values:
+        return True
+    if weekday in dow.last_dow and date.day + 7 > last:
+        return True
+    return (weekday, (date.day - 1) // 7 + 1) in dow.nth_dow
+
 
