 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (low, high, names) for minute, hour, day of month, month and day of week.
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, months, weekdays, last_day,
+                 last_weekdays, nth_weekdays, any_day, any_weekday):
+        self.minutes = minutes
+        self.hours = hours
+        self.days = days
+        self.months = months
+        self.weekdays = weekdays
+        self.last_day = last_day
+        self.last_weekdays = last_weekdays
+        self.nth_weekdays = nth_weekdays
+        self.any_day = any_day
+        self.any_weekday = any_weekday
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        last = calendar.monthrange(date.year, date.month)[1]
+        if not self.any_day:
+            if not (date.day in self.days or (self.last_day and date.day == last)):
+                return False
+        if not self.any_weekday:
+            weekday = (date.weekday() + 1) % 7
+            if not (weekday in self.weekdays
+                    or (weekday in self.last_weekdays and date.day + 7 > last)
+                    or (weekday, (date.day - 1) // 7 + 1) in self.nth_weekdays):
+                return False
+        return True
+
+
+def _value(text, low, high, names):
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _number(text, low, high):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad number {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _range_values(base, index):
+    """The values a '*', 'N', 'A-B' or 'N/S' base lists, in order."""
+    low, high, names = _FIELDS[index]
+    if base == "*":
+        return list(range(low, 7 if index == _DOW else high + 1))
+    if "-" in base:
+        first, last = base.split("-", 1)
+        a = _value(first, low, high, names)
+        b = _value(last, low, high, names)
+        if a <= b:
+            return list(range(a, b + 1))
+        if index == _DOW:
+            a, b = a % 7, b % 7
+            values = [a]
+            while values[-1] != b:
+                values.append((values[-1] + 1) % 7)
+            return values
+        return list(range(a, high + 1)) + list(range(low, b + 1))
+    return [_value(base, low, high, names)]
+
+
+def _parse_field(text, index):
+    """Return (values, last_day, last_weekdays, nth_weekdays, is_any)."""
+    low, high, names = _FIELDS[index]
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    values, last_weekdays, nth_weekdays = set(), set(), set()
+    last_day = False
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if item == "L":
+            if index != _DOM:
+                raise ValueError("'L' is only allowed in the day-of-month field")
+            last_day = True
+            continue
+        if index == _DOW:
+            match = _LAST_WEEKDAY.fullmatch(item)
+            if match:
+                last_weekdays.add(_number(match.group(1), 0, 7) % 7)
+                continue
+            match = _NTH_WEEKDAY.fullmatch(item)
+            if match:
+                nth_weekdays.add((_number(match.group(1), 0, 7) % 7,
+                                  _number(match.group(2), 1, 5)))
+                continue
+        if "/" in item:
+            base, step_text = item.split("/", 1)
+            step = _number(step_text, 1, float("inf"))
+            listed = _range_values(base, index)
+            if base != "*" and "-" not in base:
+                listed = list(range(listed[0], high + 1))
+            listed = listed[::step]
+        else:
+            listed = _range_values(item, index)
+        values.update(listed)
+    if index == _DOW:
+        values = {v % 7 for v in values}
+    return values, last_day, last_weekdays, nth_weekdays, text == "*"
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    minutes, hours, dom, months, dow = (_parse_field(p, i) for i, p in enumerate(parts))
+    return _Schedule(
+        minutes=minutes[0], hours=hours[0], days=dom[0], months=months[0],
+        weekdays=dow[0], last_day=dom[1], last_weekdays=dow[2],
+        nth_weekdays=dow[3], any_day=dom[4], any_weekday=dow[4],
+    )
 
 
