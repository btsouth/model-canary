 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_MONTHS = {name: i for i, name in enumerate(
+    ('JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r'[0-9]+', token):
+        raise ValueError('expected decimal digits')
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def value(token):
+        n = names[token.upper()] if token.upper() in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError('value outside field range')
+        return n
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if item == 'L' and index == 2:
+            special.append(('last', 0, 0))
+            continue
+        last = re.fullmatch(r'([0-9]+)L', item)
+        nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item)
+        if index == 4 and (last or nth):
+            match = last or nth
+            day = value(match[1]) % 7
+            k = _number(nth[2]) if nth else 0
+            if nth and not 1 <= k <= 5:
+                raise ValueError('weekday occurrence outside range')
+            special.append(('nth' if nth else 'last', day, k))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('bad step')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError('bad range')
+            start, end = map(value, endpoints)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = (list(range(start, end + 1)) if start <= end else
+                            list(range(start, 7)) + list(range(0, end + 1)))
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expression must be text')
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    dow, dow_special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    return weekday in dow or any(
+        weekday == n and (day.day + 7 > last if kind == 'last' else
+                          (day.day - 1) // 7 + 1 == k)
+        for kind, n, k in dow_special)
+
 
