 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import date, datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(),
+                   range(1, 13)))
+_DAYS = dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError(f'bad number: {text!r}')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f'value out of range: {token!r}')
+        return number
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    values, specials = set(), []
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            specials.append(('last',))
+            continue
+        if index == 4:
+            last = re.fullmatch(r'([0-9]+)L', item)
+            nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item)
+            if last:
+                specials.append(('last_weekday', value(last[1]) % 7))
+                continue
+            if nth:
+                occurrence = _number(nth[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError('weekday occurrence out of range')
+                specials.append(('nth_weekday', value(nth[1]) % 7, occurrence))
+                continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError(f'bad item: {item!r}')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step == 0:
+            raise ValueError('zero step')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            ends = base.split('-')
+            if len(ends) != 2:
+                raise ValueError(f'bad range: {base!r}')
+            start, end = map(value, ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                # Sunday has two spellings, but occurs once in a wrap.
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('schedule must be text')
+    expr = expr.strip().upper()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f'unknown shortcut: {expr!r}') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('schedule needs five fields')
+    return tuple(_field(text, index) for index, text in enumerate(fields))
+
+
+def _day_matches(parsed, day):
+    if day.month not in parsed[3][0]:
+        return False
+    month_days, month_specials = parsed[2]
+    weekdays, week_specials = parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    month_match = day.day in month_days or bool(month_specials) and day.day == last_day
+    week_match = weekday in weekdays
+    for special in week_specials:
+        if weekday == special[1]:
+            if special[0] == 'last_weekday':
+                week_match |= day.day + 7 > last_day
+            else:
+                week_match |= (day.day - 1) // 7 + 1 == special[2]
+    return month_match and week_match
+
 
