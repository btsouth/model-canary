 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+
+_DAY_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+
+
+class _Field:
+    __slots__ = ("minimum", "maximum", "names", "allow_l", "day_specials", "question")
+
+    def __init__(self, minimum, maximum, names=None, allow_l=False,
+                 day_specials=False, question=False):
+        self.minimum = minimum
+        self.maximum = maximum
+        self.names = names
+        self.allow_l = allow_l
+        self.day_specials = day_specials
+        self.question = question
+
+
+_MINUTE = _Field(0, 59)
+_HOUR = _Field(0, 23)
+_DAY = _Field(1, 31, allow_l=True, question=True)
+_MONTH = _Field(1, 12, names=_MONTH_NAMES)
+_WEEKDAY = _Field(0, 7, names=_DAY_NAMES, day_specials=True, question=True)
+
+_FIELDS = (
+    (_MINUTE, False),
+    (_HOUR, False),
+    (_DAY, False),
+    (_MONTH, False),
+    (_WEEKDAY, True),
+)
+
+
+class _Schedule:
+    __slots__ = (
+        "minutes", "minute_set", "hours", "hour_set",
+        "days", "last_day", "months", "month_set",
+        "weekdays", "last_weekdays", "nth_weekdays",
+    )
+
+    def __init__(self):
+        self.minutes = []
+        self.minute_set = set()
+        self.hours = []
+        self.hour_set = set()
+        self.days = set()
+        self.last_day = False
+        self.months = set()
+        self.month_set = set()
+        self.weekdays = set()
+        self.last_weekdays = set()
+        self.nth_weekdays = set()
+
+
+def _normalise_weekday(value):
+    return 0 if value == 7 else value
+
+
+def _parse_value(text, field):
+    if field.names is not None:
+        name = field.names.get(text.upper())
+        if name is not None:
+            return name
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad value: {text!r}")
+    value = int(text)
+    if value < field.minimum or value > field.maximum:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _range_values(start, end, field, weekday):
+    if start <= end:
+        return list(range(start, end + 1))
+    if weekday:
+        start = _normalise_weekday(start)
+        end = _normalise_weekday(end)
+        if start <= end:
+            return list(range(start, end + 1))
+        return list(range(start, 7)) + list(range(0, end + 1))
+    return (list(range(start, field.maximum + 1))
+            + list(range(field.minimum, end + 1)))
+
+
+def _parse_item(item, field, weekday):
+    if not item:
+        raise ValueError("empty item")
+
+    if item.count("/") > 1:
+        raise ValueError(f"bad step: {item!r}")
+    if "/" in item:
+        base, step_text = item.split("/", 1)
+        if not _DIGITS.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+    else:
+        base = item
+        step = None
+
+    if field.allow_l and base == "L":
+        if step is not None:
+            raise ValueError(f"bad item: {item!r}")
+        return set(), True, set(), set()
+
+    if field.day_specials:
+        match = re.fullmatch(r"([0-9]+)L", base)
+        if match:
+            if step is not None:
+                raise ValueError(f"bad item: {item!r}")
+            number = int(match.group(1))
+            if number > 7:
+                raise ValueError(f"value out of range: {item!r}")
+            return set(), False, {_normalise_weekday(number)}, set()
+
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", base)
+        if match:
+            if step is not None:
+                raise ValueError(f"bad item: {item!r}")
+            number, occurrence = int(match.group(1)), int(match.group(2))
+            if number > 7 or occurrence < 1 or occurrence > 5:
+                raise ValueError(f"bad item: {item!r}")
+            return (set(), False, set(),
+                    {(_normalise_weekday(number), occurrence)})
+
+    if base == "*":
+        values = list(range(field.minimum, field.maximum + 1))
+        if weekday:
+            values = [_normalise_weekday(value) for value in values]
+        if step is not None:
+            values = values[::step]
+        return set(values), False, set(), set()
+
+    if "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range: {item!r}")
+        start_text, end_text = base.split("-", 1)
+        start = _parse_value(start_text, field)
+        end = _parse_value(end_text, field)
+        values = _range_values(start, end, field, weekday)
+        if step is not None:
+            values = values[::step]
+        if weekday:
+            values = [_normalise_weekday(value) for value in values]
+        return set(values), False, set(), set()
+
+    value = _parse_value(base, field)
+    if step is None:
+        values = [value]
+    else:
+        values = list(range(value, field.maximum + 1, step))
+    if weekday:
+        values = [_normalise_weekday(number) for number in values]
+    return set(values), False, set(), set()
+
+
+def _parse_field(text, field, weekday):
+    if text == "?":
+        if not field.question:
+            raise ValueError("'?' is only allowed in a day field")
+        text = "*"
+    elif "?" in text:
+        raise ValueError("'?' must be the whole day field")
+
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in text.split(","):
+        item_values, item_last, item_last_weekdays, item_nth = _parse_item(
+            item, field, weekday)
+        values |= item_values
+        last_day = last_day or item_last
+        last_weekdays |= item_last_weekdays
+        nth_weekdays |= item_nth
+    return values, last_day, last_weekdays, nth_weekdays
+
+
+def _compile(expr):
+    text = expr.strip()
+    shortcut = text.lower()
+    if shortcut.startswith("@"):
+        if shortcut not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[shortcut]
+
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    schedule = _Schedule()
+    for part, (field, weekday) in zip(parts, _FIELDS):
+        values, last_day, last_weekdays, nth_weekdays = _parse_field(
+            part, field, weekday)
+        if field is _MINUTE:
+            schedule.minute_set = values
+            schedule.minutes = sorted(values)
+        elif field is _HOUR:
+            schedule.hour_set = values
+            schedule.hours = sorted(values)
+        elif field is _DAY:
+            schedule.days = values
+            schedule.last_day = last_day
+        elif field is _MONTH:
+            schedule.month_set = values
+            schedule.months = values
+        else:
+            schedule.weekdays = values
+            schedule.last_weekdays = last_weekdays
+            schedule.nth_weekdays = nth_weekdays
+    return schedule
+
+
+def _matches_day(schedule, date):
+    if date.month not in schedule.month_set:
+        return False
+
+    last_day = calendar.monthrange(date.year, date.month)[1]
+
+    day_of_month = date.day in schedule.days
+    if not day_of_month and schedule.last_day:
+        day_of_month = date.day == last_day
+    if not day_of_month:
+        return False
+
+    weekday = (date.weekday() + 1) % 7
+    day_of_week = weekday in schedule.weekdays
+    if not day_of_week and weekday in schedule.last_weekdays:
+        day_of_week = date.day + 7 > last_day
+    if not day_of_week:
+        occurrence = (date.day - 1) // 7 + 1
+        day_of_week = (weekday, occurrence) in schedule.nth_weekdays
+    return day_of_week
+
 
