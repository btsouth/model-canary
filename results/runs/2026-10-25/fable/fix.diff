--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,194 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names) for the five fields in order.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+def _error(expr, detail):
+    return ValueError(f"bad schedule {expr!r}: {detail}")
+
+
+def _value(token, low, high, names, expr):
+    """Turn a single number or name into an int within [low, high]."""
+    if names is not None and token.upper() in names:
+        return names[token.upper()]
+    if not _NUMBER.fullmatch(token):
+        raise _error(expr, f"bad value {token!r}")
+    value = int(token)
+    if not low <= value <= high:
+        raise _error(expr, f"value {token!r} out of range")
+    return value
+
+
+def _number(token, low, high, expr):
+    """A plain number (no names allowed) within [low, high]."""
+    return _value(token, low, high, None, expr)
+
+
+def _parse_field(index, text, expr):
+    """Return (values, last_dom, last_dow, nth_dow) for one field.
+
+    values is the set of plain values listed; last_dom is True when the day-of-month
+    field lists ``L``; last_dow is a set of weekdays with ``NL``; nth_dow is a set of
+    (weekday, k) pairs from ``N#K``.
+    """
+    low, high, names = _FIELDS[index]
+    values = set()
+    last_dom = False
+    last_dow = set()
+    nth_dow = set()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise _error(expr, "'?' only allowed in day fields")
+        return set(range(low, high + 1)), last_dom, last_dow, nth_dow
+    for item in text.split(","):
+        if not item:
+            raise _error(expr, "empty item")
+        upper = item.upper()
+        if index == _DOM and upper == "L":
+            last_dom = True
+            continue
+        if index == _DOW and upper.endswith("L"):
+            last_dow.add(_number(item[:-1], 0, 7, expr) % 7)
+            continue
+        if index == _DOW and "#" in item:
+            n, k = item.split("#", 1)
+            nth_dow.add((_number(n, 0, 7, expr) % 7, _number(k, 1, 5, expr)))
+            continue
+        step = 1
+        base = item
+        if "/" in item:
+            base, step_text = item.split("/", 1)
+            if not _NUMBER.fullmatch(step_text):
+                raise _error(expr, f"bad step {step_text!r}")
+            step = int(step_text)
+            if step < 1:
+                raise _error(expr, "step must be at least 1")
+        if base == "*":
+            listed = list(range(low, high + 1))
+        elif "-" in base:
+            a, b = base.split("-", 1)
+            a = _value(a, low, high, names, expr)
+            b = _value(b, low, high, names, expr)
+            if a <= b:
+                listed = list(range(a, b + 1))
+            else:
+                top = 6 if index == _DOW else high
+                a, b = (a % 7, b % 7) if index == _DOW else (a, b)
+                if a <= b:
+                    listed = list(range(a, b + 1))
+                else:
+                    listed = list(range(a, top + 1)) + list(range(low, b + 1))
+        else:
+            start = _value(base, low, high, names, expr)
+            listed = list(range(start, high + 1)) if "/" in item else [start]
+        values.update(listed[::step])
+    if index == _DOW:
+        values = {v % 7 for v in values}
+    return values, last_dom, last_dow, nth_dow
+
+
+class _Schedule:
+    def __init__(self, expr):
+        text = expr.strip(" \t")
+        if text.lower() in _SHORTCUTS:
+            text = _SHORTCUTS[text.lower()]
+        parts = re.split(r"[ \t]+", text) if text else []
+        if len(parts) != 5:
+            raise _error(expr, "expected five fields")
+        parsed = [_parse_field(i, part, expr) for i, part in enumerate(parts)]
+        self.minutes = parsed[_MINUTE][0]
+        self.hours = parsed[_HOUR][0]
+        self.months = parsed[_MONTH][0]
+        self.dom = parsed[_DOM][0]
+        self.last_dom = parsed[_DOM][1]
+        self.dow = parsed[_DOW][0]
+        self.last_dow = parsed[_DOW][2]
+        self.nth_dow = parsed[_DOW][3]
+        self.any_dom = parts[_DOM] in ("*", "?")
+        self.any_dow = parts[_DOW] in ("*", "?")
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        last = calendar.monthrange(date.year, date.month)[1]
+        weekday = (date.weekday() + 1) % 7
+        dom_ok = (self.any_dom or date.day in self.dom
+                  or (self.last_dom and date.day == last))
+        dow_ok = (self.any_dow or weekday in self.dow
+                  or (weekday in self.last_dow and date.day + 7 > last)
+                  or (weekday, (date.day - 1) // 7 + 1) in self.nth_dow)
+        return dom_ok and dow_ok
+
+    def matches(self, when):
+        return (when.minute in self.minutes and when.hour in self.hours
+                and self.day_allowed(when.date()))
+
+    def next_run(self, after):
+        limit = after + _LIMIT
+        start = after.replace(second=0, microsecond=0) + datetime.timedelta(minutes=1)
+        hours = sorted(self.hours)
+        minutes = sorted(self.minutes)
+        date = start.date()
+        first_day = True
+        while True:
+            if date.month not in self.months:
+                # Skip straight to the first day of the next month.
+                year, month = divmod(date.month, 12)
+                date = datetime.date(date.year + year, month + 1, 1)
+                first_day = False
+                if datetime.datetime.combine(date, datetime.time()) > limit:
+                    return None
+                continue
+            if self.day_allowed(date):
+                for hour in hours:
+                    for minute in minutes:
+                        candidate = datetime.datetime(date.year, date.month, date.day,
+                                                      hour, minute)
+                        if first_day and candidate < start:
+                            continue
+                        if candidate > limit:
+                            return None
+                        return candidate
+            date += datetime.timedelta(days=1)
+            first_day = False
+            if datetime.datetime.combine(date, datetime.time()) > limit:
+                return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _Schedule(expr).matches(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    return _Schedule(expr).next_run(after)
