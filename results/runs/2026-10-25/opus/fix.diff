 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+_NUMBER = re.compile(r"[0-9]+")
+_SPACES = re.compile(r"[ \t]+")
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (low, high, names mapped to values) for each field, in order.
+_FIELDS = [
+    (0, 59, {}),
+    (0, 23, {}),
+    (1, 31, {}),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+_DOM, _DOW = 2, 4
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+def _bad(expr):
+    return ValueError(f"bad schedule: {expr!r}")
+
+
+def _number(text, low, high, expr):
+    if not _NUMBER.fullmatch(text):
+        raise _bad(expr)
+    value = int(text)
+    if not low <= value <= high:
+        raise _bad(expr)
+    return value
+
+
+def _value(text, index, expr):
+    low, high, names = _FIELDS[index]
+    if text.upper() in names:
+        return names[text.upper()]
+    return _number(text, low, high, expr)
+
+
+def _values(base, index, expr):
+    """The values a stepless item lists, in order."""
+    low, high, _ = _FIELDS[index]
+    if base == "*":
+        return list(range(low, 7 if index == _DOW else high + 1))
+    if "-" in base:
+        first, _, last = base.partition("-")
+        a = _value(first, index, expr)
+        b = _value(last, index, expr)
+        if a <= b:
+            return list(range(a, b + 1))
+        if index == _DOW:
+            a, b = a % 7, b % 7
+            if a <= b:
+                return list(range(a, b + 1))
+            return list(range(a, 7)) + list(range(0, b + 1))
+        return list(range(a, high + 1)) + list(range(low, b + 1))
+    return [_value(base, index, expr)]
+
+
+def _field(text, index, expr):
+    """Parse one field into (values, special) where special holds L/NL/N#K items."""
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise _bad(expr)
+        text = "*"
+    values, special = set(), []
+    for item in text.split(","):
+        if not item:
+            raise _bad(expr)
+        if index == _DOM and item == "L":
+            special.append(("L",))
+            continue
+        if index == _DOW and item.endswith("L"):
+            special.append(("L", _number(item[:-1], 0, 7, expr) % 7))
+            continue
+        if index == _DOW and "#" in item:
+            day, _, nth = item.partition("#")
+            special.append(("#", _number(day, 0, 7, expr) % 7,
+                            _number(nth, 1, 5, expr)))
+            continue
+        base, slash, step = item.partition("/")
+        listed = None
+        if slash:
+            step = _number(step, 1, float("inf"), expr)
+            if base != "*" and "-" not in base:
+                start = _value(base, index, expr)
+                listed = list(range(start, _FIELDS[index][1] + 1))
+        else:
+            step = 1
+        if listed is None:
+            listed = _values(base, index, expr)
+        values.update(listed[::step])
+    if index == _DOW:
+        values = {v % 7 for v in values}
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise _bad(expr)
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise _bad(expr)
+        text = _SHORTCUTS[text.lower()]
+    parts = _SPACES.split(text)
+    if len(parts) != 5:
+        raise _bad(expr)
+    return [_field(part, i, expr) for i, part in enumerate(parts)]
+
+
+def _day_ok(fields, date):
+    (dom, dom_special), (dow, dow_special) = fields[_DOM], fields[_DOW]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    if date.day not in dom and not (dom_special and date.day == last):
+        return False
+    if weekday in dow:
+        return True
+    for item in dow_special:
+        if item[1] != weekday:
+            continue
+        if item[0] == "L" and date.day + 7 > last:
+            return True
+        if item[0] == "#" and (date.day - 1) // 7 + 1 == item[2]:
+            return True
+    return False
+
 
