+                if date.year == datetime.MAXYEAR:
+                    return None
+                date = datetime.date(date.year + 1, 1, 1)
+            else:
+                date = datetime.date(date.year, date.month + 1, 1)
+            first = False
+            continue
+        if _day_ok(fields, date):
+            for h, m in times:
+                if first and (h, m) < (start.hour, start.minute):
+                    continue
+                run = datetime.datetime(date.year, date.month, date.day, h, m)
+                if run > limit:
+                    return None
+                return run
+        first = False
+        if date == datetime.date.max:
+            return None
+        date += datetime.timedelta(days=1)
+    return None
