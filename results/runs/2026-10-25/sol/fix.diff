 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_LIMITS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(text, minimum, maximum, names=None):
+    if names and text.upper() in names:
+        return names[text.upper()]
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError("invalid schedule value")
+    value = int(text)
+    if not minimum <= value <= maximum:
+        raise ValueError("schedule value out of range")
+    return value
+
+
+def _field(text, index):
+    minimum, maximum = _LIMITS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    if text == "?" and index in (2, 4):
+        text = "*"
+    values = set()
+    specials = []
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        special = re.fullmatch(r"([0-9]+)(?:L|#([0-9]+))", item)
+        if index == 4 and special:
+            day = _number(special[1], 0, 7) % 7
+            if special[2] is None:
+                specials.append(("last_weekday", day))
+            else:
+                nth = _number(special[2], 1, 5)
+                specials.append(("nth_weekday", day, nth))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid schedule step")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError("invalid schedule step")
+            step = int(pieces[1])
+        if base == "*":
+            sequence = list(range(minimum, maximum + 1))
+        else:
+            bounds = base.split("-")
+            if len(bounds) not in (1, 2):
+                raise ValueError("invalid schedule range")
+            first = _number(bounds[0], minimum, maximum, names)
+            last = (_number(bounds[1], minimum, maximum, names)
+                    if len(bounds) == 2 else maximum if len(pieces) == 2 else first)
+            if first <= last:
+                sequence = list(range(first, last + 1))
+            else:
+                # Wrapping weekdays use the seven-day cycle, with 7 as Sunday.
+                cycle_max = maximum
+                if index == 4:
+                    first %= 7
+                    last %= 7
+                    cycle_max = 6
+                if first <= last:
+                    sequence = list(range(first, last + 1))
+                else:
+                    sequence = list(range(first, cycle_max + 1)) + list(range(minimum, last + 1))
+        selected = sequence[::step]
+        if index == 4:
+            selected = [value % 7 for value in selected]
+        values.update(selected)
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule needs five fields")
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_specials = fields[2]
+    if day.day not in dom and not (dom_specials and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow, dow_specials = fields[4]
+    if weekday in dow:
+        return True
+    for special in dow_specials:
+        if weekday != special[1]:
+            continue
+        if special[0] == "last_weekday" and day.day + 7 > last:
+            return True
+        if special[0] == "nth_weekday" and (day.day - 1) // 7 + 1 == special[2]:
+            return True
+    return False
+
 
