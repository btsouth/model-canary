+        if index == 4 and match:
+            day = _number(match[1], 0, 7, {}) % 7
+            special.append((day, match[2]))
+            continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = parts[0]
+        step = 1
+        if len(parts) == 2:
+            if not re.fullmatch(r"[0-9]+", parts[1]) or int(parts[1]) < 1:
+                raise ValueError(f"invalid step: {item!r}")
+            step = int(parts[1])
+        if base == "*":
