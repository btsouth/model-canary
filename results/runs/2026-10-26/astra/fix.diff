+        values.update(value % 7 if index == 4 else value for value in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("a schedule needs five fields")
+    bounds = [(0, 59, {}), (0, 23, {}), (1, 31, {}),
+              (1, 12, _MONTHS), (0, 7, _DAYS)]
+    return [_field(text, i, *bound) for i, (text, bound) in enumerate(zip(fields, bounds))]
+
+
+def _day_matches(fields, year, month, day, weekday, last):
+    dom, dom_special = fields[2]
