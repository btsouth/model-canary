 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+from bisect import bisect_left
+
+
+_MONTH_NAMES = {
+    "jan": 1,
+    "feb": 2,
+    "mar": 3,
+    "apr": 4,
+    "may": 5,
+    "jun": 6,
+    "jul": 7,
+    "aug": 8,
+    "sep": 9,
+    "oct": 10,
+    "nov": 11,
+    "dec": 12,
+}
+
+_DOW_NAMES = {
+    "sun": 0,
+    "mon": 1,
+    "tue": 2,
+    "wed": 3,
+    "thu": 4,
+    "fri": 5,
+    "sat": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MAX_DAYS = 50 * 365
+
+
+class _Schedule:
+    __slots__ = (
+        "minutes",
+        "hours",
+        "dom_values",
+        "dom_last",
+        "months",
+        "dow_values",
+        "dow_last",
+        "dow_nth",
+    )
+
+    def __init__(
+        self, minutes, hours, dom_values, dom_last, months, dow_values, dow_last, dow_nth
+    ):
+        self.minutes = minutes
+        self.hours = hours
+        self.dom_values = dom_values
+        self.dom_last = dom_last
+        self.months = months
+        self.dow_values = dow_values
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+
+
+def _value(token, low, high, names):
+    if re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    elif names is not None and token.lower() in names:
+        value = names[token.lower()]
+    else:
+        raise ValueError(f"bad field value: {token!r}")
+
+    if value < low or value > high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _split_step(item):
+    if "/" not in item:
+        return item, None
+    if item.count("/") != 1:
+        raise ValueError(f"bad step: {item!r}")
+
+    base, step_text = item.split("/")
+    if not re.fullmatch(r"[0-9]+", step_text):
+        raise ValueError(f"bad step: {item!r}")
+    step = int(step_text)
+    if step < 1:
+        raise ValueError(f"bad step: {item!r}")
+    if re.search(r"[A-Za-z]", base):
+        raise ValueError(f"name in step: {item!r}")
+    return base, step
+
+
+def _simple_item_values(item, low, high, names):
+    base, step = _split_step(item)
+
+    if base == "*":
+        ordered = list(range(low, high + 1))
+    elif "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range: {item!r}")
+        left, right = base.split("-")
+        first = _value(left, low, high, names)
+        last = _value(right, low, high, names)
+        if first <= last:
+            ordered = list(range(first, last + 1))
+        else:
+            ordered = list(range(first, high + 1)) + list(range(low, last + 1))
+    else:
+        only = _value(base, low, high, names)
+        if step is not None:
+            ordered = list(range(only, high + 1))
+        else:
+            ordered = [only]
+
+    if step is not None:
+        ordered = ordered[::step]
+    return ordered
+
+
+def _parse_simple(field, low, high, names=None):
+    if not field or "?" in field:
+        raise ValueError(f"bad field: {field!r}")
+
+    values = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        values.update(_simple_item_values(item, low, high, names))
+    return values
+
+
+def _parse_dom(field):
+    if field == "?":
+        return set(range(1, 32)), False
+    if not field or "?" in field:
+        raise ValueError(f"bad day-of-month field: {field!r}")
+
+    values = set()
+    last = False
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        if item == "L":
+            last = True
+        else:
+            values.update(_simple_item_values(item, 1, 31, None))
+    return values, last
+
+
+def _dow_item_values(item):
+    base, step = _split_step(item)
+
+    if base == "*":
+        ordered = list(range(0, 8))
+    elif "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range: {item!r}")
+        left, right = base.split("-")
+        first = _value(left, 0, 7, _DOW_NAMES)
+        last = _value(right, 0, 7, _DOW_NAMES)
+        if first <= last:
+            ordered = list(range(first, last + 1))
+        else:
+            # A wrapping range counts 0 through 6, treating 7 as 0.
+            ordered = list(range(first, 7)) + list(range(0, last + 1))
+    else:
+        only = _value(base, 0, 7, _DOW_NAMES)
+        if step is not None:
+            ordered = list(range(only, 8))
+        else:
+            ordered = [only]
+
+    if step is not None:
+        ordered = ordered[::step]
+    return {value % 7 for value in ordered}
+
+
+def _parse_dow(field):
+    if field == "?":
+        return set(range(7)), set(), []
+    if not field or "?" in field:
+        raise ValueError(f"bad day-of-week field: {field!r}")
+
+    values = set()
+    last_days = set()
+    nth_days = []
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+
+        match = re.fullmatch(r"([0-9]+)L", item)
+        if match:
+            day = int(match.group(1))
+            if day > 7:
+                raise ValueError(f"value out of range: {item!r}")
+            last_days.add(day % 7)
+            continue
+
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if match:
+            day = int(match.group(1))
+            count = int(match.group(2))
+            if day > 7 or count < 1 or count > 5:
+                raise ValueError(f"value out of range: {item!r}")
+            nth_days.append((day % 7, count))
+            continue
+
+        if "L" in item or "l" in item or "#" in item:
+            raise ValueError(f"bad day-of-week item: {item!r}")
+
+        values.update(_dow_item_values(item))
+
+    return values, last_days, nth_days
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule expression")
+
+    lowered = text.lower()
+    if lowered in _SHORTCUTS:
+        text = _SHORTCUTS[lowered]
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    minutes = _parse_simple(fields[0], 0, 59)
+    hours = _parse_simple(fields[1], 0, 23)
+    dom_values, dom_last = _parse_dom(fields[2])
+    months = _parse_simple(fields[3], 1, 12, _MONTH_NAMES)
+    dow_values, dow_last, dow_nth = _parse_dow(fields[4])
+
+    return _Schedule(
+        minutes,
+        hours,
+        dom_values,
+        dom_last,
+        months,
+        dow_values,
+        dow_last,
+        dow_nth,
+    )
+
+
+def _dom_matches(schedule, day):
+    if day.day in schedule.dom_values:
+        return True
+    if schedule.dom_last:
+        last_day = calendar.monthrange(day.year, day.month)[1]
+        return day.day == last_day
+    return False
+
+
+def _dow_matches(schedule, day):
+    weekday = (day.weekday() + 1) % 7
+    if weekday in schedule.dow_values:
+        return True
+
+    if weekday in schedule.dow_last:
+        last_day = calendar.monthrange(day.year, day.month)[1]
+        if day.day + 7 > last_day:
+            return True
+
+    occurrence = (day.day - 1) // 7 + 1
+    for nth_weekday, nth in schedule.dow_nth:
+        if nth_weekday == weekday and occurrence == nth:
+            return True
+
+    return False
+
+
+def _day_matches(schedule, day):
+    return _dom_matches(schedule, day) and _dow_matches(schedule, day)
+
 
