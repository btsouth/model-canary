--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,206 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"],
+        start=1,
+    )
+}
+_DAY_NAMES = {
+    name: number
+    for number, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_HORIZON = _dt.timedelta(days=50 * 365)
+
+
+class _Field:
+    """One parsed field: a set of plain values plus the day-only specials."""
+
+    def __init__(self):
+        self.star = False          # '*' or '?' (matches everything)
+        self.values = set()        # plain values listed by the field
+        self.last_day = False      # day of month: 'L'
+        self.last_weekdays = set() # day of week: 'NL' (N normalised to 0-6)
+        self.nth_weekdays = set()  # day of week: 'N#K' as (N, K), N in 0-6
+
+
+def _parse_number(text, names, low, high, what):
+    """Parse a single value: digits, or a name when names is given."""
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r} in {what} field")
+    if not low <= value <= high:
+        raise ValueError(f"{value} is outside {low}-{high} in {what} field")
+    return value
+
+
+def _parse_range(text, names, low, high, what, is_dow):
+    """List the values of '*', 'N' or 'A-B', in the order the item lists them."""
+    if text == "*":
+        return list(range(low, high + 1))
+    if "-" in text:
+        first, _, second = text.partition("-")
+        a = _parse_number(first, names, low, high, what)
+        b = _parse_number(second, names, low, high, what)
+        if a <= b:
+            return list(range(a, b + 1))
+        if is_dow:
+            # Wrap through 0..6 with 7 treated as 0.
+            a, b = a % 7, b % 7
+            if a <= b:
+                return list(range(a, b + 1))
+            return list(range(a, 7)) + list(range(0, b + 1))
+        return list(range(a, high + 1)) + list(range(low, b + 1))
+    return [_parse_number(text, names, low, high, what)]
+
+
+def _parse_item(item, field, names, low, high, what, is_dow, is_dom):
+    """Add one comma-separated item to field."""
+    if item == "":
+        raise ValueError(f"empty item in {what} field")
+    if is_dom and item == "L":
+        field.last_day = True
+        return
+    if is_dow:
+        if item.endswith("L") and _NUMBER.fullmatch(item[:-1]):
+            n = _parse_number(item[:-1], None, low, high, what)
+            field.last_weekdays.add(n % 7)
+            return
+        if "#" in item:
+            first, _, second = item.partition("#")
+            if not (_NUMBER.fullmatch(first) and _NUMBER.fullmatch(second)):
+                raise ValueError(f"bad item {item!r} in {what} field")
+            n = _parse_number(first, None, low, high, what)
+            k = int(second)
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad week number in {item!r}")
+            field.nth_weekdays.add((n % 7, k))
+            return
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step must be at least 1 in {item!r}")
+        if base != "*" and "-" not in base:
+            # N/S lists N up to the field's maximum.
+            n = _parse_number(base, names, low, high, what)
+            listed = list(range(n, high + 1))
+        else:
+            listed = _parse_range(base, names, low, high, what, is_dow)
+        listed = listed[::step]
+    else:
+        listed = _parse_range(base, names, low, high, what, is_dow)
+    if is_dow:
+        listed = [v % 7 for v in listed]
+    field.values.update(listed)
+
+
+def _parse_field(text, names, low, high, what, is_dow=False, is_dom=False):
+    field = _Field()
+    if text == "*" or (text == "?" and (is_dow or is_dom)):
+        field.star = True
+        field.values = set(range(low, high + 1))
+        if is_dow:
+            field.values.discard(7)
+        return field
+    for item in text.split(","):
+        _parse_item(item, field, names, low, high, what, is_dow, is_dom)
+    return field
+
+
+def _parse(expr):
+    """Parse expr into (minutes, hours, dom, months, dow) fields."""
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {text!r}") from None
+    parts = re.split(r"[ \t]+", text) if text else []
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    minute = _parse_field(parts[0], None, 0, 59, "minute")
+    hour = _parse_field(parts[1], None, 0, 23, "hour")
+    dom = _parse_field(parts[2], None, 1, 31, "day of month", is_dom=True)
+    month = _parse_field(parts[3], _MONTH_NAMES, 1, 12, "month")
+    dow = _parse_field(parts[4], _DAY_NAMES, 0, 7, "day of week", is_dow=True)
+    return minute, hour, dom, month, dow
+
+
+def _day_allowed(date, dom, dow):
+    """True if the date matches both day fields."""
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    if not dom.star:
+        if not (date.day in dom.values or (dom.last_day and date.day == days_in_month)):
+            return False
+    if not dow.star:
+        weekday = (date.weekday() + 1) % 7  # Sunday = 0
+        if weekday in dow.values:
+            return True
+        if weekday in dow.last_weekdays and date.day + 7 > days_in_month:
+            return True
+        if (weekday, (date.day - 1) // 7 + 1) in dow.nth_weekdays:
+            return True
+        return False
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    minute, hour, dom, month, dow = _parse(expr)
+    return (
+        when.minute in minute.values
+        and when.hour in hour.values
+        and when.month in month.values
+        and _day_allowed(when.date(), dom, dow)
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    minute, hour, dom, month, dow = _parse(expr)
+    minutes = sorted(minute.values)
+    hours = sorted(hour.values)
+    limit = after + _HORIZON
+    date = after.date()
+    first_day = True
+    while date <= limit.date():
+        if date.month not in month.values:
+            # Jump to the first day of the next month.
+            year, mon = (date.year + 1, 1) if date.month == 12 else (date.year, date.month + 1)
+            date = _dt.date(year, mon, 1)
+            first_day = False
+            continue
+        if _day_allowed(date, dom, dow):
+            for h in hours:
+                for m in minutes:
+                    candidate = _dt.datetime(date.year, date.month, date.day, h, m)
+                    if not first_day or candidate > after:
+                        return candidate if candidate <= limit else None
+        date += _dt.timedelta(days=1)
+        first_day = False
+    return None
