 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+from bisect import bisect_left
+from functools import lru_cache
+
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (minimum, maximum, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+def _value(text, index):
+    low, high, names = _FIELDS[index]
+    if _NUMBER.fullmatch(text):
+        number = int(text)
+    elif names is not None and text.upper() in names:
+        number = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= number <= high:
+        raise ValueError(f"value {text!r} out of range")
+    return number
+
+
+def _item(item, index):
+    """The values an ordinary item lists, in order."""
+    low, high, _ = _FIELDS[index]
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        first, _, last = base.partition("-")
+        a, b = _value(first, index), _value(last, index)
+        if a <= b:
+            values = list(range(a, b + 1))
+        elif index == _DOW:
+            values = list(range(a % 7, 7)) + list(range(0, b % 7 + 1))
+        else:
+            values = list(range(a, high + 1)) + list(range(low, b + 1))
+    else:
+        a = _value(base, index)
+        values = list(range(a, high + 1)) if slash else [a]
+    return values[::step]
+
+
+class _Spec:
+    def __init__(self, minutes, hours, dom, last_dom, months, dow, last_dow, nth_dow):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.minute_set = set(minutes)
+        self.hour_set = set(hours)
+        self.months = set(months)
+        self.dom = dom
+        self.last_dom = last_dom
+        self.dow = dow
+        self.last_dow = last_dow
+        self.nth_dow = nth_dow
+        self._days = {}
+
+    def days(self, year, month):
+        """The sorted allowed days of a month (month and day rules only)."""
+        first, length = calendar.monthrange(year, month)
+        first = (first + 1) % 7  # Sunday is 0
+        key = (first, length)
+        if key not in self._days:
+            allowed = []
+            for day in range(1, length + 1):
+                weekday = (first + day - 1) % 7
+                dom_ok = day in self.dom or (self.last_dom and day == length)
+                dow_ok = (
+                    weekday in self.dow
+                    or (weekday in self.last_dow and day + 7 > length)
+                    or (weekday, (day - 1) // 7 + 1) in self.nth_dow
+                )
+                if dom_ok and dow_ok:
+                    allowed.append(day)
+            self._days[key] = allowed
+        return self._days[key]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string, not {expr!r}")
+    return _parse_text(expr)
+
+
+@lru_cache(maxsize=256)
+def _parse_text(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {text!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    sets = [set() for _ in range(5)]
+    last_dom = False
+    last_dow, nth_dow = set(), set()
+    for index, part in enumerate(parts):
+        if part == "?" and index in (_DOM, _DOW):
+            part = "*"
+        for item in part.split(","):
+            if not item:
+                raise ValueError(f"empty item in {expr!r}")
+            if index == _DOM and item == "L":
+                last_dom = True
+                continue
+            if index == _DOW:
+                match = _LAST_DOW.fullmatch(item)
+                if match:
+                    n = int(match.group(1))
+                    if n > 7:
+                        raise ValueError(f"bad day of week in {item!r}")
+                    last_dow.add(n % 7)
+                    continue
+                match = _NTH_DOW.fullmatch(item)
+                if match:
+                    n, k = int(match.group(1)), int(match.group(2))
+                    if n > 7 or not 1 <= k <= 5:
+                        raise ValueError(f"bad day of week in {item!r}")
+                    nth_dow.add((n % 7, k))
+                    continue
+            sets[index].update(_item(item, index))
+    minutes, hours, dom, months, dow = sets
+    dow = {d % 7 for d in dow}
+    return _Spec(minutes, hours, dom, last_dom, months, dow, last_dow, nth_dow)
 
 
