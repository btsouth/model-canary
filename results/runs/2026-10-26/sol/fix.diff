+
+
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if re.fullmatch(r"[0-9]+", text) is None:
+        raise ValueError(f"invalid number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+
+    def value(token):
+        number = names[token.upper()] if token.upper() in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return number
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if item == "L" and index == 2:
+            specials.append(("last",))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if special and index == 4:
+            weekday = value(special[1]) % 7
+            if special[2] == "L":
+                specials.append(("last", weekday))
+            else:
+                occurrence = _number(special[3])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence must be 1 through 5")
+                specials.append(("nth", weekday, occurrence))
+            continue
+
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"invalid step: {item!r}")
+        base = parts[0]
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(value, ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, specials
+
+
+def _parse(expr):
+    text = expr.strip()
+    text = _SHORTCUTS.get(text.lower(), text)
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError("a schedule must have five fields")
+    return [_field(field, i) for i, field in enumerate(fields)]
+
+
+def _allowed_day(parsed, year, month, day, last):
+    dom, dom_specials = parsed[2]
+    dow, dow_specials = parsed[4]
+    if day not in dom and not (dom_specials and day == last):
+        return False
+    weekday = (datetime(year, month, day).weekday() + 1) % 7
+    return weekday in dow or any(
+        weekday == rule[1] and (
+            day + 7 > last if rule[0] == "last" else (day - 1) // 7 + 1 == rule[2]
+        ) for rule in dow_specials
+    )
+
 
