 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+_MONTHS = dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), range(1, 13)))
+_DAYS = dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7)))
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal digits')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError('value outside field range')
+        return number
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if item == 'L' and index == 2:
+            specials.append(('last', 0))
+            continue
+        special = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if special and index == 4:
+            weekday = value(special[1]) % 7
+            if special[2] == 'L':
+                specials.append(('last', weekday))
+            else:
+                nth = _number(special[3])
+                if not 1 <= nth <= 5:
+                    raise ValueError('weekday occurrence outside range')
+                specials.append((nth, weekday))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('invalid step')
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        base = pieces[0]
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            ends = base.split('-')
+            if len(ends) != 2:
+                raise ValueError('invalid range')
+            start, end = map(value, ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = [(start + i) % 7 for i in range((end - start) % 7 + 1)]
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('schedule must be text')
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr.upper())
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = [_field(field, i) for i, field in enumerate(fields)]
+    return parsed, fields[2] in ('*', '?'), fields[4] in ('*', '?')
+
+
+def _day_allowed(parsed, dom_free, dow_free, year, month, day, last):
+    dom = day in parsed[2][0] or (bool(parsed[2][1]) and day == last)
+    weekday = (datetime(year, month, day).weekday() + 1) % 7
+    dow = weekday in parsed[4][0]
+    for occurrence, wanted in parsed[4][1]:
+        if weekday == wanted:
+            dow |= day + 7 > last if occurrence == 'last' else (day - 1) // 7 + 1 == occurrence
+    if dom_free:
+        return dow_free or dow
+    if dow_free:
+        return dom
+    return dom or dow
+
 
