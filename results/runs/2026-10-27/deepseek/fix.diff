 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_FIELD_INFO = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
+        1,
+    )
+}
+
+_DOW_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+
+class _Field:
+    __slots__ = ("values", "unrestricted", "last", "last_days", "nth")
+
+    def __init__(self, values, unrestricted=False, last=False,
+                 last_days=None, nth=None):
+        self.values = values
+        self.unrestricted = unrestricted
+        self.last = last
+        self.last_days = last_days if last_days is not None else set()
+        self.nth = nth if nth is not None else set()
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "dom", "month", "dow")
+
+    def __init__(self, minutes, hours, dom, month, dow):
+        self.minutes = minutes
+        self.hours = hours
+        self.dom = dom
+        self.month = month
+        self.dow = dow
+
+
+def _all_values(field):
+    if field == "minute":
+        return list(range(0, 60))
+    if field == "hour":
+        return list(range(0, 24))
+    if field == "dom":
+        return list(range(1, 32))
+    if field == "month":
+        return list(range(1, 13))
+    return list(range(0, 7))
+
+
+def _parse_value(token, field):
+    names = None
+    if field == "month":
+        names = _MONTH_NAMES
+    elif field == "dow":
+        names = _DOW_NAMES
+
+    if re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r} in {field}")
+
+    low, high = _FIELD_INFO[field]
+    if not low <= value <= high:
+        raise ValueError(f"value {token!r} out of range in {field}")
+    return value
+
+
+def _dow_range(first, last):
+    # A range over the week runs through the cycle 0..6, with 7 as another
+    # spelling of Sunday (0).
+    if first == 7 and last == 7:
+        return [0]
+    if first <= last:
+        if last == 7:
+            if first == 0:
+                return list(range(0, 7))
+            return list(range(first, 7)) + [0]
+        return list(range(first, last + 1))
+    if first == 7:
+        return list(range(0, last + 1))
+    return list(range(first, 7)) + list(range(0, last + 1))
+
+
+def _parse_field(text, field):
+    if field in ("dom", "dow") and text == "?":
+        return _Field(set(_all_values(field)), unrestricted=True)
+
+    unrestricted = text == "*"
+    values = set()
+    last = False
+    last_days = set()
+    nth = set()
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field}")
+
+        if field == "dom" and item == "L":
+            last = True
+            continue
+
+        if field == "dow":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                day = int(match.group(1))
+                if day > 7:
+                    raise ValueError(f"bad last weekday {item!r}")
+                last_days.add(0 if day == 7 else day)
+                continue
+
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                day = int(match.group(1))
+                occurrence = int(match.group(2))
+                if day > 7 or not 1 <= occurrence <= 5:
+                    raise ValueError(f"bad weekday occurrence {item!r}")
+                nth.add((0 if day == 7 else day, occurrence))
+                continue
+
+        if item.count("/") > 1:
+            raise ValueError(f"bad step in {item!r}")
+        if "/" in item:
+            base, step_text = item.split("/")
+            if not re.fullmatch(r"[0-9]+", step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step in {item!r}")
+        else:
+            base = item
+            step = None
+
+        if not base:
+            raise ValueError(f"empty item in {field}")
+
+        # L, NL and N#K never take a step.
+        if field == "dom" and base == "L" and step is not None:
+            raise ValueError(f"bad step in {item!r}")
+        if field == "dow" and step is not None and (
+                re.fullmatch(r"[0-9]+L", base)
+                or re.fullmatch(r"[0-9]+#[0-9]+", base)):
+            raise ValueError(f"bad step in {item!r}")
+
+        if base == "*":
+            vals = _all_values(field)
+            if step is not None:
+                vals = vals[::step]
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError(f"bad range {base!r}")
+            first_text, last_text = base.split("-")
+            if not first_text or not last_text:
+                raise ValueError(f"bad range {base!r}")
+            first = _parse_value(first_text, field)
+            last_value = _parse_value(last_text, field)
+            if field == "dow":
+                vals = _dow_range(first, last_value)
+            else:
+                low, high = _FIELD_INFO[field]
+                if first <= last_value:
+                    vals = list(range(first, last_value + 1))
+                else:
+                    vals = (list(range(first, high + 1))
+                            + list(range(low, last_value + 1)))
+            if step is not None:
+                vals = vals[::step]
+        else:
+            value = _parse_value(base, field)
+            if step is None:
+                vals = [value]
+            else:
+                _, high = _FIELD_INFO[field]
+                vals = list(range(value, high + 1))
+            if field == "dow":
+                vals = [0 if value == 7 else value for value in vals]
+            if step is not None:
+                vals = vals[::step]
+
+        values.update(vals)
+
+    return _Field(values, unrestricted, last, last_days, nth)
+
+
+def _parse_expression(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    text = expr.strip()
+    shortcut = text.lower()
+    if shortcut in _SHORTCUTS:
+        text = _SHORTCUTS[shortcut]
+    elif shortcut.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"wrong number of fields: {expr!r}")
+
+    minutes = _parse_field(fields[0], "minute").values
+    hours = _parse_field(fields[1], "hour").values
+    dom = _parse_field(fields[2], "dom")
+    month = _parse_field(fields[3], "month")
+    dow = _parse_field(fields[4], "dow")
+    return _Schedule(minutes, hours, dom, month, dow)
+
+
+def _day_allowed(schedule, day):
+    dom_restricted = not schedule.dom.unrestricted
+    dow_restricted = not schedule.dow.unrestricted
+    if not dom_restricted and not dow_restricted:
+        return True
+
+    last_day = calendar.monthrange(day.year, day.month)[1]
+
+    dom_match = False
+    if dom_restricted:
+        dom_match = (day.day in schedule.dom.values
+                     or (schedule.dom.last and day.day == last_day))
+
+    dow_match = False
+    if dow_restricted:
+        weekday = (day.weekday() + 1) % 7
+        if weekday in schedule.dow.values:
+            dow_match = True
+        else:
+            if (schedule.dow.last_days
+                    and weekday in schedule.dow.last_days
+                    and day.day + 7 > last_day):
+                dow_match = True
+            if not dow_match and schedule.dow.nth:
+                occurrence = (day.day - 1) // 7 + 1
+                for weekday_value, wanted in schedule.dow.nth:
+                    if weekday_value == weekday and occurrence == wanted:
+                        dow_match = True
+                        break
+
+    if dom_restricted and dow_restricted:
+        return dom_match or dow_match
+    if dom_restricted:
+        return dom_match
+    return dow_match
+
 
