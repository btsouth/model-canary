+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_LIMIT = _dt.timedelta(days=50 * 365)
