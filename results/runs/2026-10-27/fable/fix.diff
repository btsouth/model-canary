+
+def _number(text, low, high, names, expr):
+    """Read a single value: digits, or a name when names are allowed."""
+    if text.isdigit() and text.isascii():
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r} in {expr!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range in {expr!r}")
+    return value
+
+
+def _step(text, expr):
+    if not (text.isdigit() and text.isascii()) or int(text) < 1:
+        raise ValueError(f"bad step {text!r} in {expr!r}")
+    return int(text)
+
+
+def _parse_field(text, index, expr, sched):
+    """Parse one field into a set of values, recording the day specials on sched."""
+    low, high, names = _FIELDS[index]
+    values = set()
+    if text == "":
+        raise ValueError(f"empty field in {expr!r}")
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {expr!r}")
+        if index == _DOM and item == "L":
+            sched.dom_last = True
+            continue
+        if index == _DOW and item.endswith("L") and len(item) > 1:
+            sched.dow_last.add(_number(item[:-1], 0, 7, None, expr) % 7)
+            continue
+        if index == _DOW and "#" in item:
+            day, _, nth = item.partition("#")
+            n = _number(day, 0, 7, None, expr) % 7
+            k = _number(nth, 1, 5, None, expr)
+            sched.dow_nth.add((n, k))
+            continue
+        base, slash, step_text = item.partition("/")
+        step = _step(step_text, expr) if slash else 1
+        if slash:
+            names = None  # names are not allowed anywhere in a stepped item
+        if base == "*":
+            listed = list(range(low, high + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a = _number(a_text, low, high, names, expr)
+            b = _number(b_text, low, high, names, expr)
+            if index == _DOW:
+                a %= 7
+                b %= 7
+                top = 6
+            else:
+                top = high
+            if a <= b:
+                listed = list(range(a, b + 1))
+            else:
+                listed = list(range(a, top + 1)) + list(range(low, b + 1))
+        else:
+            n = _number(base, low, high, names, expr)
+            listed = list(range(n, high + 1)) if slash else [n]
+        values.update(listed[::step])
+    if index == _DOW:
+        values = {v % 7 for v in values}
+    return values
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = text.replace("\t", " ").split(" ")
+    parts = [p for p in parts if p]
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    sched = _Schedule()
+    sched.dom_last = False
+    sched.dow_last = set()
+    sched.dow_nth = set()
+    sched.dom_any = parts[_DOM] in ("*", "?")
+    sched.dow_any = parts[_DOW] in ("*", "?")
+    for index in (_DOM, _DOW):
+        if parts[index] == "?":
+            parts[index] = "*"
+    sched.minutes = sorted(_parse_field(parts[_MINUTE], _MINUTE, expr, sched))
+    sched.hours = sorted(_parse_field(parts[_HOUR], _HOUR, expr, sched))
+    sched.dom = _parse_field(parts[_DOM], _DOM, expr, sched)
+    sched.months = _parse_field(parts[_MONTH], _MONTH, expr, sched)
+    sched.dow = _parse_field(parts[_DOW], _DOW, expr, sched)
+    return sched
+
+
+def _day_allowed(sched, date):
+    if sched.dom_any and sched.dow_any:
+        return True
+    last = calendar.monthrange(date.year, date.month)[1]
+    dow = (date.weekday() + 1) % 7
+    dom_ok = date.day in sched.dom or (sched.dom_last and date.day == last)
+    dow_ok = (dow in sched.dow
+              or (dow in sched.dow_last and date.day + 7 > last)
+              or (dow, (date.day - 1) // 7 + 1) in sched.dow_nth)
+    if sched.dom_any:
+        return dow_ok
+    if sched.dow_any:
+        return dom_ok
+    return dom_ok or dow_ok
