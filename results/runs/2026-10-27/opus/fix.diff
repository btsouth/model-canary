 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+# (minimum, maximum, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_NUMBER = re.compile(r"[0-9]+\Z")
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays,
+                 last_weekdays, nth_weekdays, dom_restricted, dow_restricted):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.days = days
+        self.last_day = last_day
+        self.months = months
+        self.weekdays = weekdays
+        self.last_weekdays = last_weekdays
+        self.nth_weekdays = nth_weekdays
+        self.dom_restricted = dom_restricted
+        self.dow_restricted = dow_restricted
+
+    def day_ok(self, year, month, day, last):
+        dom = day in self.days or (self.last_day and day == last)
+        weekday = (datetime.date(year, month, day).weekday() + 1) % 7
+        dow = (weekday in self.weekdays
+               or (weekday in self.last_weekdays and day + 7 > last)
+               or (weekday, (day - 1) // 7 + 1) in self.nth_weekdays)
+        if self.dom_restricted and self.dow_restricted:
+            return dom or dow
+        if self.dom_restricted:
+            return dom
+        if self.dow_restricted:
+            return dow
+        return True
+
+
+def _number(text, low, high, names=None):
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    if not _NUMBER.match(text):
+        raise ValueError(f"bad value: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _item(text, index):
+    low, high, names = _FIELDS[index]
+    base, slash, step_text = text.partition("/")
+    if slash:
+        if not _NUMBER.match(step_text):
+            raise ValueError(f"bad step: {text!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step must be at least 1: {text!r}")
+    else:
+        step = 1
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        a_text, _, b_text = base.partition("-")
+        a = _number(a_text, low, high, names)
+        b = _number(b_text, low, high, names)
+        if a <= b:
+            values = list(range(a, b + 1))
+        elif index == 4:
+            a = 0 if a == 7 else a
+            if a <= b:
+                values = list(range(a, b + 1))
+            else:
+                values = list(range(a, 7)) + list(range(0, b + 1))
+        else:
+            values = list(range(a, high + 1)) + list(range(low, b + 1))
+    else:
+        a = _number(base, low, high, names)
+        values = list(range(a, high + 1)) if slash else [a]
+    return values[::step]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    sets = [set() for _ in range(5)]
+    last_day = False
+    last_weekdays, nth_weekdays = set(), set()
+    for index, part in enumerate(parts):
+        if part == "?":
+            if index not in (2, 4):
+                raise ValueError(f"'?' not allowed here: {expr!r}")
+            part = "*"
+        for item in part.split(","):
+            if not item:
+                raise ValueError(f"empty item: {expr!r}")
+            if index == 2 and item == "L":
+                last_day = True
+            elif index == 4 and item.endswith("L"):
+                last_weekdays.add(_number(item[:-1], 0, 7) % 7)
+            elif index == 4 and "#" in item:
+                n_text, _, k_text = item.partition("#")
+                nth_weekdays.add((_number(n_text, 0, 7) % 7, _number(k_text, 1, 5)))
+            else:
+                sets[index].update(_item(item, index))
+    weekdays = {d % 7 for d in sets[4]}
+    return _Schedule(sets[0], sets[1], sets[2], last_day, sets[3], weekdays,
+                     last_weekdays, nth_weekdays,
+                     parts[2] not in ("*", "?"), parts[4] not in ("*", "?"))
 
 
