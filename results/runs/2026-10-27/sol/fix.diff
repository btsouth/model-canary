+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ('JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'), 1)}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 6))
+
+
+def _number(token, field):
+    if re.fullmatch(r'[0-9]+', token):
+        value = int(token)
+    elif field == 3 and token.upper() in _MONTHS:
+        value = _MONTHS[token.upper()]
+    elif field == 4 and token.upper() in _DAYS:
+        value = _DAYS[token.upper()]
+    else:
+        raise ValueError('invalid field value')
+    low, high = _LIMITS[field]
+    if not low <= value <= (7 if field == 4 else high):
+        raise ValueError('field value out of range')
+    return value % 7 if field == 4 else value
+
+
+def _field(text, field):
+    values, specials = set(), []
+    if text == '?' and field in (2, 4):
+        text = '*'
+    low, high = _LIMITS[field]
+    for item in text.split(','):
+        if field == 2 and item == 'L':
+            specials.append(('last',))
+            continue
+        special = re.fullmatch(r'([0-9]+)(?:L|#([0-9]+))', item) if field == 4 else None
+        if special:
+            target = _number(special[1], field)
+            nth = int(special[2]) if special[2] is not None else None
+            if nth is not None and not 1 <= nth <= 5:
+                raise ValueError('invalid weekday occurrence')
+            specials.append((target, nth))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('invalid step')
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError('invalid step')
+            step = int(pieces[1])
+        base = pieces[0]
+        if base == '*':
+            ordered = list(range(low, high + 1))
+        elif '-' in base:
+            ends = base.split('-')
+            if len(ends) != 2:
+                raise ValueError('invalid range')
+            start, end = (_number(token, field) for token in ends)
+            if start <= end:
+                ordered = list(range(start, end + 1))
+            else:
+                ordered = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _number(base, field)
+            ordered = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(ordered[::step])
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    parsed = [_field(part, i) for i, part in enumerate(parts)]
+    return parsed, parts[2] in ('*', '?'), parts[4] in ('*', '?')
+
+
+def _day_allowed(parsed, dom_free, dow_free, year, month, day, last):
+    dom_values, dom_specials = parsed[2]
+    dow_values, dow_specials = parsed[4]
+    dom = day in dom_values or (bool(dom_specials) and day == last)
+    weekday = (calendar.weekday(year, month, day) + 1) % 7
+    dow = weekday in dow_values or any(
+        weekday == target and (day + 7 > last if nth is None else (day - 1) // 7 + 1 == nth)
+        for target, nth in dow_specials
+    )
+    if dom_free:
+        return dow_free or dow
+    if dow_free:
+        return dom
+    return dom or dow
+
 
