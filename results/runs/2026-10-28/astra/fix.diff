 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), range(1, 13)))
+_DAYS = dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7)))
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, low, high, names=None):
+    if re.fullmatch(r'[0-9]+', token):
+        value = int(token)
+    elif names and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f'bad schedule value: {token!r}')
+    if not low <= value <= high:
+        raise ValueError(f'schedule value out of range: {token!r}')
+    return value
+
+
+def _field(text, index):
+    low, high = _LIMITS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    values, specials = set(), []
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            specials.append(('last',))
+            continue
+        special = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if index == 4 and special:
+            day = _number(special[1], 0, 7) % 7
+            if special[2] == 'L':
+                specials.append(('last', day))
+            else:
+                specials.append(('nth', day, _number(special[3], 1, 5)))
+            continue
+        parts = item.split('/')
+        if len(parts) > 2:
+            raise ValueError(f'bad schedule item: {item!r}')
+        base = parts[0]
+        step = 1
+        if len(parts) == 2:
+            if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                raise ValueError(f'bad schedule step: {parts[1]!r}')
+            step = int(parts[1])
+        maximum = 6 if index == 4 else high
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        else:
+            ends = base.split('-')
+            if len(ends) not in (1, 2):
+                raise ValueError(f'bad schedule range: {base!r}')
+            ends = [_number(end, low, high, names) for end in ends]
+            start = ends[0]
+            end = ends[-1] if len(ends) == 2 else high if len(parts) == 2 else start
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                if index == 4:
+                    start, end = start % 7, end % 7
+                if start <= end:
+                    sequence = list(range(start, end + 1))
+                else:
+                    sequence = list(range(start, maximum + 1)) + list(range(low, end + 1))
+        selected = sequence[::step]
+        if index == 4:
+            selected = [value % 7 for value in selected]
+        values.update(selected)
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f'unknown schedule shortcut: {expr!r}') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('a schedule must have five fields')
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, year, month, day, last):
+    dom, dom_specials = fields[2]
+    if day not in dom and not (dom_specials and day == last):
+        return False
+    dow = (datetime(year, month, day).weekday() + 1) % 7
+    values, specials = fields[4]
+    if dow in values:
+        return True
+    for special in specials:
+        if special[1] == dow:
+            if special[0] == 'last' and day + 7 > last:
+                return True
+            if special[0] == 'nth' and (day - 1) // 7 + 1 == special[2]:
+                return True
+    return False
+
 
