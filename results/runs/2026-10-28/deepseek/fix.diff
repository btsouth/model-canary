 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_MONTH_NAMES = {
+    "jan": 1,
+    "feb": 2,
+    "mar": 3,
+    "apr": 4,
+    "may": 5,
+    "jun": 6,
+    "jul": 7,
+    "aug": 8,
+    "sep": 9,
+    "oct": 10,
+    "nov": 11,
+    "dec": 12,
+}
+_DOW_NAMES = {
+    "sun": 0,
+    "mon": 1,
+    "tue": 2,
+    "wed": 3,
+    "thu": 4,
+    "fri": 5,
+    "sat": 6,
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+
+
+def _parse_single(token, low, high, names=None):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    elif names is not None and _NAME.fullmatch(token):
+        value = names.get(token.lower())
+        if value is None:
+            raise ValueError(f"bad value: {token!r}")
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _parse_dow_range(base, names=None):
+    parts = base.split("-")
+    if len(parts) != 2:
+        raise ValueError(f"bad range: {base!r}")
+    start = _parse_single(parts[0], 0, 7, names)
+    end = _parse_single(parts[1], 0, 7, names)
+    if start <= end:
+        return list(range(start, end + 1))
+    # Wrapping ranges go through the week 0..6, with 7 meaning Sunday.
+    first = start % 7
+    last = end % 7
+    if first <= last:
+        return list(range(first, last + 1))
+    return list(range(first, 7)) + list(range(0, last + 1))
+
+
+def _parse_sequence(base, low, high, names=None, dow=False):
+    if "-" in base:
+        if dow:
+            return _parse_dow_range(base, names)
+        parts = base.split("-")
+        if len(parts) != 2:
+            raise ValueError(f"bad range: {base!r}")
+        start = _parse_single(parts[0], low, high, names)
+        end = _parse_single(parts[1], low, high, names)
+        if start <= end:
+            return list(range(start, end + 1))
+        return list(range(start, high + 1)) + list(range(low, end + 1))
+    return [_parse_single(base, low, high, names)]
+
+
+def _parse_item(item, low, high, names=None, dow=False):
+    if not item:
+        raise ValueError("empty item")
+    if item == "*":
+        return list(range(low, high + 1))
+    if "/" in item:
+        parts = item.split("/")
+        if len(parts) != 2:
+            raise ValueError(f"bad step: {item!r}")
+        base, step_text = parts
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            sequence = _parse_sequence(base, low, high, names, dow)
+        else:
+            start = _parse_single(base, low, high, names)
+            sequence = list(range(start, high + 1))
+        return sequence[::step]
+    return _parse_sequence(item, low, high, names, dow)
+
+
+def _parse_simple(field, low, high, names=None):
+    values = set()
+    for item in field.split(","):
+        values.update(_parse_item(item, low, high, names))
+    return values
+
+
+def _parse_dom(field):
+    values = set()
+    last = False
+    for item in field.split(","):
+        if item == "L":
+            last = True
+        else:
+            values.update(_parse_item(item, 1, 31))
+    return values, last
+
+
+def _parse_dow(field):
+    values = set()
+    last = set()
+    nth = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+        match = re.fullmatch(r"([0-9]+)L", item)
+        if match:
+            number = int(match.group(1))
+            if number > 7:
+                raise ValueError(f"value out of range: {item!r}")
+            last.add(number % 7)
+            continue
+        if "#" in item:
+            parts = item.split("#")
+            if (
+                len(parts) != 2
+                or not _NUMBER.fullmatch(parts[0])
+                or not _NUMBER.fullmatch(parts[1])
+            ):
+                raise ValueError(f"bad day of week item: {item!r}")
+            number = int(parts[0])
+            occurrence = int(parts[1])
+            if number > 7 or not 1 <= occurrence <= 5:
+                raise ValueError(f"bad day of week item: {item!r}")
+            nth.add((number % 7, occurrence))
+            continue
+        for value in _parse_item(item, 0, 7, _DOW_NAMES, dow=True):
+            values.add(value % 7)
+    return values, last, nth
+
+
+def _parse(expr):
+    text = expr.strip()
+    shortcut = text.lower()
+    if shortcut in _SHORTCUTS:
+        text = _SHORTCUTS[shortcut]
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"wrong number of fields: {expr!r}")
+    minute, hour, dom, month, dow = fields
+    if dom == "?":
+        dom = "*"
+    if dow == "?":
+        dow = "*"
+    minutes = _parse_simple(minute, 0, 59)
+    hours = _parse_simple(hour, 0, 23)
+    months = _parse_simple(month, 1, 12, _MONTH_NAMES)
+    dom_values, dom_last = _parse_dom(dom)
+    dow_values, dow_last, dow_nth = _parse_dow(dow)
+    return (
+        minutes,
+        hours,
+        months,
+        dom_values,
+        dom_last,
+        dow_values,
+        dow_last,
+        dow_nth,
+    )
+
+
+def _day_allowed(schedule, day):
+    (
+        _minutes,
+        _hours,
+        months,
+        dom_values,
+        dom_last,
+        dow_values,
+        dow_last,
+        dow_nth,
+    ) = schedule
+    if day.month not in months:
+        return False
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    if day.day not in dom_values and not (dom_last and day.day == last_day):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    if weekday in dow_values:
+        return True
+    if weekday in dow_last and day.day + 7 > last_day:
+        return True
+    occurrence = (day.day - 1) // 7 + 1
+    if (weekday, occurrence) in dow_nth:
+        return True
+    return False
+
 
