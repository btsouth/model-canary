 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAY_NAMES = {name: i for i, name in enumerate(
+    ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_RANGES = {_MINUTE: (0, 59), _HOUR: (0, 23), _DOM: (1, 31), _MONTH: (1, 12), _DOW: (0, 7)}
+_NAMES = {_MONTH: _MONTH_NAMES, _DOW: _DAY_NAMES}
+
+_NUMBER = re.compile(r"^[0-9]+$")
+_LIMIT = _dt.timedelta(days=50 * 365)
+_MINUTE_DELTA = _dt.timedelta(minutes=1)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom_star", "dom", "dom_last",
+                 "dow_star", "dow", "dow_last", "dow_nth")
+
+    def __init__(self):
+        self.minutes = set()
+        self.hours = set()
+        self.months = set()
+        self.dom_star = False
+        self.dom = set()
+        self.dom_last = False
+        self.dow_star = False
+        self.dow = set()
+        self.dow_last = set()   # weekdays (0-6) whose last occurrence in the month runs
+        self.dow_nth = set()    # (weekday, k) pairs
+
+    def day_allowed(self, year, month, day, weekday, days_in_month):
+        """weekday is 0=Sunday .. 6=Saturday."""
+        if not self.dom_star:
+            if day not in self.dom and not (self.dom_last and day == days_in_month):
+                return False
+        if self.dow_star:
+            return True
+        if weekday in self.dow:
+            return True
+        if weekday in self.dow_last and day + 7 > days_in_month:
+            return True
+        if self.dow_nth and (weekday, (day - 1) // 7 + 1) in self.dow_nth:
+            return True
+        return False
+
+
+def _value(text, field, allow_names):
+    """Parse a single value of a field into an int within range."""
+    if not text:
+        raise ValueError("empty value")
+    if _NUMBER.match(text):
+        n = int(text)
+    else:
+        names = _NAMES.get(field) if allow_names else None
+        if names is None or text.upper() not in names:
+            raise ValueError(f"bad value {text!r}")
+        n = names[text.upper()]
+    low, high = _RANGES[field]
+    if not low <= n <= high:
+        raise ValueError(f"value {n} out of range {low}-{high}")
+    return n
+
+
+def _item_values(item, field):
+    """Expand a *, N, A-B item (optionally with /S) into an ordered list of values."""
+    low, high = _RANGES[field]
+    step = 1
+    if "/" in item:
+        base, _, step_text = item.partition("/")
+        if "/" in step_text or not _NUMBER.match(step_text):
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step must be at least 1 in {item!r}")
+    else:
+        base = item
+    if not base:
+        raise ValueError(f"empty item in {item!r}")
+
+    if base == "*":
+        values = list(range(low, high + 1))
+        if field == _DOW:
+            values = list(range(0, 7))
+    elif "-" in base:
+        a_text, _, b_text = base.partition("-")
+        if "-" in b_text:
+            raise ValueError(f"bad range {base!r}")
+        a = _value(a_text, field, True)
+        b = _value(b_text, field, True)
+        if a <= b:
+            values = list(range(a, b + 1))
+        elif field == _DOW:
+            a %= 7
+            b %= 7
+            values = list(range(a, 7)) + list(range(0, b + 1))
+        else:
+            values = list(range(a, high + 1)) + list(range(low, b + 1))
+    else:
+        n = _value(base, field, True)
+        if step == 1 and "/" not in item:
+            values = [n]
+        else:
+            values = list(range(n, high + 1))
+    return values[::step]
+
+
+def _parse_field(text, field, sched):
+    if field in (_DOM, _DOW) and text == "?":
+        text = "*"
+    items = text.split(",")
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in field {text!r}")
+        if field == _DOM and item == "L":
+            sched.dom_last = True
+            continue
+        if field == _DOW:
+            if item.endswith("L") and _NUMBER.match(item[:-1] or "x"):
+                n = _value(item[:-1], field, False)
+                sched.dow_last.add(n % 7)
+                continue
+            if "#" in item:
+                n_text, _, k_text = item.partition("#")
+                if not _NUMBER.match(n_text) or not _NUMBER.match(k_text):
+                    raise ValueError(f"bad item {item!r}")
+                n = _value(n_text, field, False)
+                k = int(k_text)
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad week number in {item!r}")
+                sched.dow_nth.add((n % 7, k))
+                continue
+        values = _item_values(item, field)
+        if field == _MINUTE:
+            sched.minutes.update(values)
+        elif field == _HOUR:
+            sched.hours.update(values)
+        elif field == _MONTH:
+            sched.months.update(values)
+        elif field == _DOM:
+            if item == "*" or item == "*/1":
+                sched.dom_star = True
+            sched.dom.update(values)
+        else:
+            if item == "*" or item == "*/1":
+                sched.dow_star = True
+            sched.dow.update(v % 7 for v in values)
+    # A field listing every possible day is equivalent to '*'.
+    if field == _DOM and sched.dom == set(range(1, 32)):
+        sched.dom_star = True
+    if field == _DOW and sched.dow == set(range(7)):
+        sched.dow_star = True
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip(" \t")
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text) if text else []
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    sched = _Schedule()
+    for field, part in enumerate(parts):
+        _parse_field(part, field, sched)
+    return sched
+
+
+def _weekday(date):
+    """0=Sunday .. 6=Saturday."""
+    return (date.weekday() + 1) % 7
+
 
