 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import bisect
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_RANGES = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+_NAMES = {
+    _MONTH: {name: i + 1 for i, name in enumerate(_MONTHS)},
+    _DOW: {name: i for i, name in enumerate(_DAYS)},
+}
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+def _bad(expr, why):
+    return ValueError(f"bad schedule {expr!r}: {why}")
+
+
+def _number(text, expr):
+    if not text or any(c not in "0123456789" for c in text):
+        raise _bad(expr, f"not a number: {text!r}")
+    return int(text)
+
+
+def _value(text, field, expr):
+    names = _NAMES.get(field, {})
+    if text.isascii() and text.upper() in names:
+        return names[text.upper()]
+    value = _number(text, expr)
+    low, high = _RANGES[field]
+    if not low <= value <= high:
+        raise _bad(expr, f"{value} out of range")
+    return value
+
+
+def _item_values(item, field, expr):
+    """The values a plain or stepped item lists, in order."""
+    low, high = _RANGES[field]
+    body, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        step = _number(step_text, expr)
+        if step < 1:
+            raise _bad(expr, "step must be at least 1")
+    if body == "*":
+        values = list(range(low, high + 1))
+    elif "-" in body:
+        start_text, _, end_text = body.partition("-")
+        start = _value(start_text, field, expr)
+        end = _value(end_text, field, expr)
+        if start <= end:
+            values = list(range(start, end + 1))
+        elif field == _DOW:
+            start %= 7
+            values = list(range(start, 7)) + list(range(0, end + 1)) \
+                if start > end else list(range(start, end + 1))
+        else:
+            values = list(range(start, high + 1)) + list(range(low, end + 1))
+    else:
+        start = _value(body, field, expr)
+        values = list(range(start, high + 1)) if slash else [start]
+    return values[::step]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise _bad(expr, "not a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise _bad(expr, "unknown shortcut")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise _bad(expr, "need five fields")
+    sets = [set() for _ in range(5)]
+    last_dom = False
+    last_dow, nth_dow = set(), set()
+    any_dom = any_dow = False
+    for field, part in enumerate(parts):
+        if part == "?":
+            if field not in (_DOM, _DOW):
+                raise _bad(expr, "'?' outside the day fields")
+            part = "*"
+        if part == "*":
+            if field == _DOM:
+                any_dom = True
+            elif field == _DOW:
+                any_dow = True
+        for item in part.split(","):
+            if not item:
+                raise _bad(expr, "empty item")
+            if item == "L":
+                if field != _DOM:
+                    raise _bad(expr, "'L' outside day of month")
+                last_dom = True
+            elif re.fullmatch(r"[0-9]+L", item):
+                if field != _DOW:
+                    raise _bad(expr, "'NL' outside day of week")
+                last_dow.add(_number_in_range(item[:-1], field, expr) % 7)
+            elif re.fullmatch(r"[0-9]+#[0-9]+", item):
+                if field != _DOW:
+                    raise _bad(expr, "'N#K' outside day of week")
+                day_text, _, nth_text = item.partition("#")
+                nth = _number(nth_text, expr)
+                if not 1 <= nth <= 5:
+                    raise _bad(expr, "'#' must be 1 to 5")
+                nth_dow.add((_number_in_range(day_text, field, expr) % 7, nth))
+            else:
+                sets[field].update(_item_values(item, field, expr))
+    sets[_DOW] = {d % 7 for d in sets[_DOW]}
+    return {
+        "minutes": sorted(sets[_MINUTE]),
+        "hours": sorted(sets[_HOUR]),
+        "months": sets[_MONTH],
+        "dom": sets[_DOM], "last_dom": last_dom, "any_dom": any_dom,
+        "dow": sets[_DOW], "last_dow": last_dow, "nth_dow": nth_dow,
+        "any_dow": any_dow,
+    }
+
+
+def _number_in_range(text, field, expr):
+    value = _number(text, expr)
+    low, high = _RANGES[field]
+    if not low <= value <= high:
+        raise _bad(expr, f"{value} out of range")
+    return value
+
+
+def _days_in_month(spec, year, month):
+    """Sorted days of the month that both day fields allow."""
+    first_weekday, length = calendar.monthrange(year, month)
+    first_dow = (first_weekday + 1) % 7
+
+    def dow_of(day):
+        return (first_dow + day - 1) % 7
+
+    days = range(1, length + 1)
+    if not spec["any_dom"]:
+        days = [d for d in days
+                if d in spec["dom"] or (spec["last_dom"] and d == length)]
+    if not spec["any_dow"]:
+        days = [d for d in days
+                if dow_of(d) in spec["dow"]
+                or (dow_of(d) in spec["last_dow"] and d + 7 > length)
+                or (dow_of(d), (d - 1) // 7 + 1) in spec["nth_dow"]]
+    return list(days)
 
 
