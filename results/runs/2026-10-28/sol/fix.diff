 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import date, datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name: i for i, name in enumerate(
+    'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)}
+_DAYS = {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal digits')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+
+    def value(token):
+        n = names[token.upper()] if token.upper() in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError('value outside field range')
+        return n
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            specials.append(('last', 0, 0))
+            continue
+        special = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if index == 4 and special:
+            n = value(special[1]) % 7
+            k = _number(special[3]) if special[3] is not None else 0
+            if special[3] is not None and not 1 <= k <= 5:
+                raise ValueError('weekday occurrence outside range')
+            specials.append(('nth' if k else 'last_weekday', n, k))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('bad step')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, 7 if index == 4 else high + 1))
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError('bad range')
+            start, end = map(value, endpoints)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                if index == 4:
+                    start, end = start % 7, end % 7
+                    sequence = (list(range(start, 7)) + list(range(0, end + 1))
+                                if start > end else list(range(start, end + 1)))
+                else:
+                    sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        selected = sequence[::step]
+        values.update(n % 7 if index == 4 else n for n in selected)
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_matches(fields, day):
+    dom, dom_specials = fields[2]
+    dow, dow_specials = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    if day.day in dom and weekday in dow:
+        return True
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom or bool(dom_specials) and day.day == last
+    dow_match = weekday in dow or any(
+        weekday == n and (day.day + 7 > last if kind == 'last_weekday'
+                          else (day.day - 1) // 7 + 1 == k)
+        for kind, n, k in dow_specials)
+    return dom_match and dow_match
