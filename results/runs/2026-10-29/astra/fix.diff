 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), range(1, 13)))
+_DAYS = dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7)))
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _parse_field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def number(token):
+        if re.fullmatch(r'[0-9]+', token):
+            value = int(token)
+        elif token in names:
+            value = names[token]
+        else:
+            raise ValueError('invalid field value')
+        if not low <= value <= high:
+            raise ValueError('field value out of range')
+        return value
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        last = re.fullmatch(r'([0-9]+)L', item) if index == 4 else None
+        nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item) if index == 4 else None
+        if last:
+            special.append(('weekday_last', number(last[1]) % 7))
+            continue
+        if nth:
+            day, occurrence = number(nth[1]) % 7, int(nth[2])
+            if not 1 <= occurrence <= 5:
+                raise ValueError('weekday occurrence out of range')
+            special.append(('weekday_nth', day, occurrence))
+            continue
+        parts = item.split('/')
+        if len(parts) > 2:
+            raise ValueError('invalid step')
+        step = 1
+        if len(parts) == 2:
+            if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                raise ValueError('invalid step')
+            step = int(parts[1])
+        base = parts[0]
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            bounds = base.split('-')
+            if len(bounds) != 2:
+                raise ValueError('invalid range')
+            start, end = map(number, bounds)
+        else:
+            start = number(base)
+            end = high if len(parts) == 2 else start
+        if start > end:
+            raise ValueError('reversed range')
+        values.update(v % 7 if index == 4 else v for v in range(start, end + 1, step))
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_parse_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow, dow_special = fields[4]
+    if weekday in dow:
+        return True
+    for rule in dow_special:
+        if weekday == rule[1]:
+            if rule[0] == 'weekday_last' and day.day + 7 > last:
+                return True
+            if rule[0] == 'weekday_nth' and (day.day - 1) // 7 + 1 == rule[2]:
+                return True
+    return False
+
 
