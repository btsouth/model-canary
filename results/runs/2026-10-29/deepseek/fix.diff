 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from collections import namedtuple
+from datetime import datetime, timedelta
+
+_RANGES = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+
+_MONTHS = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+
+_DAYS = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+
+_Schedule = namedtuple(
+    "_Schedule",
+    "minutes hours dom_values dom_last months dow_values dow_last dow_nth",
+)
+
+
+def _value(token, kind):
+    """Return the numeric value of a plain item endpoint."""
+    upper = token.upper()
+    if kind == "month" and upper in _MONTHS:
+        return _MONTHS[upper]
+    if kind == "dow" and upper in _DAYS:
+        return _DAYS[upper]
+    if not _NUMBER.fullmatch(token):
+        raise ValueError(f"bad value: {token!r}")
+    number = int(token)
+    low, high = _RANGES[kind]
+    if low <= number <= high:
+        return number
+    raise ValueError(f"value out of range: {token!r}")
+
+
+def _split_step(item):
+    """Split an item into its base and optional step."""
+    if item.count("/") > 1:
+        raise ValueError(f"bad step: {item!r}")
+    if "/" not in item:
+        return item, None
+    base, step_text = item.split("/")
+    if not base or not _NUMBER.fullmatch(step_text):
+        raise ValueError(f"bad step: {item!r}")
+    step = int(step_text)
+    if step < 1:
+        raise ValueError(f"bad step: {item!r}")
+    return base, step
+
+
+def _parse_field(text, kind):
+    """Parse one field, returning a set of values plus day-of-month/week rules."""
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("'?' is only allowed in day fields")
+        text = "*"
+
+    items = text.split(",")
+    if not items or any(item == "" for item in items):
+        raise ValueError(f"empty item in {text!r}")
+
+    values = set()
+    last_day = False
+    dow_last = set()
+    dow_nth = set()
+    low, high = _RANGES[kind]
+
+    for item in items:
+        base, step = _split_step(item)
+
+        if kind == "dom" and base == "L" and step is None:
+            last_day = True
+            continue
+
+        if kind == "dow" and step is None:
+            if base.endswith("L") and len(base) > 1:
+                number_text = base[:-1]
+                if not _NUMBER.fullmatch(number_text):
+                    raise ValueError(f"bad last-day rule: {item!r}")
+                number = int(number_text)
+                if not 0 <= number <= 7:
+                    raise ValueError(f"bad last-day rule: {item!r}")
+                dow_last.add(number % 7)
+                continue
+            if "#" in base:
+                parts = base.split("#")
+                if len(parts) != 2:
+                    raise ValueError(f"bad nth-day rule: {item!r}")
+                day_text, nth_text = parts
+                if not _NUMBER.fullmatch(day_text) or not _NUMBER.fullmatch(nth_text):
+                    raise ValueError(f"bad nth-day rule: {item!r}")
+                day_number, nth = int(day_text), int(nth_text)
+                if not 0 <= day_number <= 7 or not 1 <= nth <= 5:
+                    raise ValueError(f"bad nth-day rule: {item!r}")
+                dow_nth.add((day_number % 7, nth))
+                continue
+
+        if base == "*":
+            if step is None:
+                numbers = range(low, high + 1)
+            else:
+                numbers = range(low, high + 1, step)
+        elif "-" in base:
+            parts = base.split("-")
+            if len(parts) != 2 or not parts[0] or not parts[1]:
+                raise ValueError(f"bad range: {item!r}")
+            start = _value(parts[0], kind)
+            end = _value(parts[1], kind)
+            if start > end:
+                raise ValueError(f"range starts after it ends: {item!r}")
+            numbers = range(start, end + 1, step if step is not None else 1)
+        else:
+            start = _value(base, kind)
+            if step is None:
+                numbers = [start]
+            else:
+                numbers = range(start, high + 1, step)
+        values.update(numbers)
+
+    if kind == "dow":
+        values = {0 if value == 7 else value for value in values}
+
+    return values, last_day, dow_last, dow_nth
+
+
+def _parse(expr):
+    """Parse a full expression, raising ValueError if it is not valid."""
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    expr = expr.strip()
+    lower = expr.lower()
+    if lower.startswith("@"):
+        if lower not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        expr = _SHORTCUTS[lower]
+
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError(f"wrong number of fields: {expr!r}")
+
+    minutes, _, _, _ = _parse_field(fields[0], "minute")
+    hours, _, _, _ = _parse_field(fields[1], "hour")
+    dom_values, dom_last, _, _ = _parse_field(fields[2], "dom")
+    months, _, _, _ = _parse_field(fields[3], "month")
+    dow_values, _, dow_last, dow_nth = _parse_field(fields[4], "dow")
+
+    return _Schedule(
+        tuple(sorted(minutes)),
+        tuple(sorted(hours)),
+        dom_values,
+        dom_last,
+        months,
+        dow_values,
+        dow_last,
+        dow_nth,
+    )
+
+
+def _last_day(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _day_matches(schedule, day):
+    """True if the date-like day is allowed by both day fields."""
+    month_last = _last_day(day.year, day.month)
+    if day.day not in schedule.dom_values:
+        if not (schedule.dom_last and day.day == month_last):
+            return False
+
+    cron_day = (day.weekday() + 1) % 7
+    if cron_day in schedule.dow_values:
+        return True
+    if cron_day in schedule.dow_last and day.day > month_last - 7:
+        return True
+    occurrence = (day.day - 1) // 7 + 1
+    return any(
+        cron_day == wanted and occurrence == nth
+        for wanted, nth in schedule.dow_nth
+    )
+
 
