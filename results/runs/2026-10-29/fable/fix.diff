 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i for i, name in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"], 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+
+# (low, high, names) for each of the five fields
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+MINUTE, HOUR, DOM, MONTH, DOW = range(5)
+
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+def _is_number(text):
+    return text != "" and all(c in "0123456789" for c in text)
+
+
+def _value(text, field):
+    """Parse one value of a field, a number or (where allowed) a name."""
+    low, high, names = _FIELDS[field]
+    if _is_number(text):
+        value = int(text)
+    elif names is not None and text.lower() in names:
+        value = names[text.lower()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _item(text, field, spec):
+    """Add one comma-separated item to spec."""
+    low, high, _ = _FIELDS[field]
+    if text == "":
+        raise ValueError("empty item")
+
+    # Day-only specials, which take no step.
+    if field == DOM and text == "L":
+        spec["last"] = True
+        return
+    if field == DOW:
+        if text.endswith("L") and _is_number(text[:-1]):
+            spec["last_dow"].add(_value(text[:-1], field) % 7)
+            return
+        if "#" in text:
+            n, _, k = text.partition("#")
+            if not (_is_number(n) and _is_number(k)):
+                raise ValueError(f"bad item {text!r}")
+            k = int(k)
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad week number in {text!r}")
+            spec["nth_dow"].add((_value(n, field) % 7, k))
+            return
+
+    step = 1
+    if "/" in text:
+        text, _, step_text = text.partition("/")
+        if not _is_number(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step {step_text!r}")
+        step = int(step_text)
+        if text == "":
+            raise ValueError("empty item before step")
+        has_step = True
+    else:
+        has_step = False
+
+    if text == "*":
+        start, stop = low, high
+    elif "-" in text:
+        a, _, b = text.partition("-")
+        start, stop = _value(a, field), _value(b, field)
+        if start > stop:
+            raise ValueError(f"range {text!r} runs backwards")
+    else:
+        start = _value(text, field)
+        stop = high if has_step else start
+
+    values = range(start, stop + 1, step)
+    if field == DOW:
+        values = [v % 7 for v in values]
+    spec["values"].update(values)
+
+
+def _field(text, field):
+    spec = {"values": set(), "last": False, "last_dow": set(), "nth_dow": set(), "any": False}
+    if text == "?":
+        if field not in (DOM, DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        spec["any"] = True
+        return spec
+    for item in text.split(","):
+        _item(item, field, spec)
+    low, high, _ = _FIELDS[field]
+    full = set(range(low, high + 1))
+    if field == DOW:
+        full = set(range(7))
+    if spec["values"] >= full:
+        spec["any"] = True
+    return spec
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {text!r}") from None
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}")
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_allowed(spec, date):
+    dom, dow = spec[DOM], spec[DOW]
+    last_day = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7  # Sunday = 0
+
+    dom_ok = (dom["any"] or date.day in dom["values"]
+              or (dom["last"] and date.day == last_day))
+    if not dom_ok:
+        return False
+    if dow["any"] or weekday in dow["values"]:
+        return True
+    if weekday in dow["last_dow"] and date.day + 7 > last_day:
+        return True
+    if (weekday, (date.day - 1) // 7 + 1) in dow["nth_dow"]:
+        return True
+    return False
+
 
