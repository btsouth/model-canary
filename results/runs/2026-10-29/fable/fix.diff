+        # Skip whitespace before the value.
+        while i < n and text[i].isspace() and text[i] != SEP:
+            i += 1
+        if i < n and text[i] == QUOTE:
+            i += 1
+            value = []
+            while True:
+                if i >= n:
+                    raise ValueError(f"unclosed quote in {text!r}")
+                ch = text[i]
+                if ch == QUOTE:
+                    if i + 1 < n and text[i + 1] == QUOTE:
+                        value.append(QUOTE)
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                value.append(ch)
+                i += 1
+            # Only whitespace may follow the closing quote.
+            while i < n and text[i] != SEP:
+                if not text[i].isspace():
+                    raise ValueError(f"text after closing quote in {text!r}")
+                i += 1
+            fields.append((key, "".join(value)))
+            i += 1
+        else:
+            start = i
+            while i < n and text[i] != SEP:
+                i += 1
+            fields.append((key, text[start:i].strip()))
+            i += 1
+    return fields
+
