+def _split_fields(text):
+    """Split text on SEP outside quotes into (key, value) pairs, or None for a bare field."""
+    fields = []
+    i, n = 0, len(text)
+    while i <= n:
+        # Key runs up to '=' or SEP.
+        start = i
+        while i < n and text[i] not in (SEP, "="):
+            i += 1
+        key = text[start:i]
+        if i >= n or text[i] == SEP:
