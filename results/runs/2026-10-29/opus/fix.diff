 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (minimum, maximum, names) for each field, in order.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+_DOM, _DOW = 2, 4
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays, last_weekdays,
+                 nth_weekdays, any_day_of_month, any_day_of_week):
+        self.minutes = minutes
+        self.hours = hours
+        self.days = days
+        self.last_day = last_day
+        self.months = months
+        self.weekdays = weekdays
+        self.last_weekdays = last_weekdays
+        self.nth_weekdays = nth_weekdays
+        self.any_day_of_month = any_day_of_month
+        self.any_day_of_week = any_day_of_week
+
+    def day_allowed(self, day):
+        if day.month not in self.months:
+            return False
+        length = calendar.monthrange(day.year, day.month)[1]
+        if not self.any_day_of_month:
+            if day.day not in self.days and not (self.last_day and day.day == length):
+                return False
+        if not self.any_day_of_week:
+            weekday = (day.weekday() + 1) % 7
+            if not (weekday in self.weekdays
+                    or (weekday in self.last_weekdays and day.day + 7 > length)
+                    or (weekday, (day.day - 1) // 7 + 1) in self.nth_weekdays):
+                return False
+        return True
+
+
+def _number(text, low, high):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value {value} out of range {low}-{high}")
+    return value
+
+
+def _value(text, low, high, names):
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    return _number(text, low, high)
+
+
+def _parse_field(text, index):
+    low, high, names = _FIELDS[index]
+    values, last_day, last_weekdays, nth_weekdays = set(), False, set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if index == _DOM and item == "L":
+            last_day = True
+            continue
+        if index == _DOW and item.endswith("L"):
+            last_weekdays.add(_number(item[:-1], 0, 7) % 7)
+            continue
+        if index == _DOW and "#" in item:
+            day, nth = item.split("#", 1)
+            nth_weekdays.add((_number(day, 0, 7) % 7, _number(nth, 1, 5)))
+            continue
+        base, slash, step = item.partition("/")
+        step = _number(step, 1, float("inf")) if slash else 1
+        if base == "*":
+            start, stop = low, high
+        elif "-" in base:
+            first, _, second = base.partition("-")
+            start = _value(first, low, high, names)
+            stop = _value(second, low, high, names)
+            if start > stop:
+                raise ValueError(f"range {base!r} runs backwards")
+        else:
+            start = _value(base, low, high, names)
+            stop = high if slash else start
+        values.update(range(start, stop + 1, step))
+    if index == _DOW:
+        values = {v % 7 for v in values}
+    return values, last_day, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {text!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    any_day = [False] * 5
+    parsed = []
+    for index, part in enumerate(parts):
+        if part == "?" and index in (_DOM, _DOW):
+            part = "*"
+        if part == "*":
+            any_day[index] = True
+        parsed.append(_parse_field(part, index))
+    return _Schedule(
+        minutes=parsed[0][0],
+        hours=parsed[1][0],
+        days=parsed[_DOM][0],
+        last_day=parsed[_DOM][1],
+        months=parsed[3][0],
+        weekdays=parsed[_DOW][0],
+        last_weekdays=parsed[_DOW][2],
+        nth_weekdays=parsed[_DOW][3],
+        any_day_of_month=any_day[_DOM],
+        any_day_of_week=any_day[_DOW],
+    )
 
 
