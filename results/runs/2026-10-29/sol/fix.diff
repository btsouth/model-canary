 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name: i for i, name in enumerate(
+    'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)}
+_DAYS = {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError(f'bad number: {text!r}')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _LIMITS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f'value outside field range: {token!r}')
+        return number
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.upper().split(','):
+        if index == 2 and item == 'L':
+            special.append(('last', 0, 0))
+            continue
+        match = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if index == 4 and match:
+            day = value(match[1]) % 7
+            occurrence = _number(match[3]) if match[3] is not None else 0
+            if match[3] is not None and not 1 <= occurrence <= 5:
+                raise ValueError('weekday occurrence must be 1 to 5')
+            special.append(('weekday', day, occurrence))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('too many steps')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            first, last = low, high
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError('bad range')
+            first, last = map(value, endpoints)
+            if first > last:
+                raise ValueError('reversed range')
+        else:
+            first = value(base)
+            last = high if len(pieces) == 2 else first
+        values.update(range(first, last + 1, step))
+    if index == 4:
+        values = {day % 7 for day in values}
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expression must be text')
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom = day.day in fields[2][0] or bool(fields[2][1]) and day.day == last
+    weekday = (day.weekday() + 1) % 7
+    dow = weekday in fields[4][0]
+    for _, wanted, occurrence in fields[4][1]:
+        if weekday == wanted:
+            dow |= (day.day + 7 > last if occurrence == 0
+                    else (day.day - 1) // 7 + 1 == occurrence)
+    return dom and dow
+
 
