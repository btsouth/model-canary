 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+_NAMES = {
+    3: dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), range(1, 13))),
+    4: dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7))),
+}
+
+
+def _number(token):
+    if not re.fullmatch(r'[0-9]+', token):
+        raise ValueError(f'invalid number: {token!r}')
+    return int(token)
+
+
+def _value(token, index):
+    value = _NAMES.get(index, {}).get(token.upper())
+    if value is None:
+        value = _number(token)
+    low, high = _BOUNDS[index]
+    if not low <= value <= high:
+        raise ValueError(f'out of range: {token!r}')
+    return value
+
+
+def _field(field, index):
+    unrestricted = field in ('*', '?')
+    if field == '?':
+        if index not in (2, 4):
+            raise ValueError('question mark outside day fields')
+        field = '*'
+    values, special = set(), []
+    low, high = _BOUNDS[index]
+    for item in field.split(','):
+        if index == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        match = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+        if index == 4 and match:
+            weekday = _value(match[1], index) % 7
+            if match[2] == 'L':
+                special.append(('last', weekday))
+            else:
+                occurrence = _number(match[3])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError('weekday occurrence must be 1 to 5')
+                special.append(('nth', weekday, occurrence))
+            continue
+        parts = item.split('/')
+        if len(parts) > 2:
+            raise ValueError('too many steps')
+        base = parts[0]
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError('invalid range')
+            start, end = [_value(token, index) for token in endpoints]
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _value(base, index)
+            sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+        values.update(value % 7 if index == 4 else value for value in sequence[::step])
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expression must be text')
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, when):
+    dom, dow = fields[2], fields[4]
+    weekday = (when.weekday() + 1) % 7
+    last = calendar.monthrange(when.year, when.month)[1]
+    dom_match = when.day in dom[0] or bool(dom[1]) and when.day == last
+    dow_match = weekday in dow[0]
+    for rule in dow[1]:
+        if weekday == rule[1]:
+            if rule[0] == 'last':
+                dow_match |= when.day + 7 > last
+            else:
+                dow_match |= (when.day - 1) // 7 + 1 == rule[2]
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
