 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import datetime
+import re
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+_DOW_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6,
+}
+_RANGES = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+_NAMES = {
+    "minute": {},
+    "hour": {},
+    "dom": {},
+    "month": _MONTH_NAMES,
+    "dow": _DOW_NAMES,
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUMBER = re.compile(r"[0-9]+")
+
+
+def _parse_value(token, lo, hi, names):
+    name = token.upper()
+    if name in names:
+        return names[name]
+    if not _NUMBER.fullmatch(token):
+        raise ValueError(f"bad value: {token!r}")
+    value = int(token)
+    if not lo <= value <= hi:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _parse_field(text, kind):
+    lo, hi = _RANGES[kind]
+    names = _NAMES[kind]
+    if kind in ("dom", "dow") and text == "?":
+        text = "*"
+
+    values = set()
+    last_day = False
+    specials = []
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"bad item: {item!r}")
+        base = pieces[0]
+        step = None
+        if len(pieces) == 2:
+            step_text = pieces[1]
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+        if not base:
+            raise ValueError(f"bad item: {item!r}")
+
+        if kind == "dom" and base == "L":
+            if step is not None:
+                raise ValueError(f"bad item: {item!r}")
+            last_day = True
+            continue
+
+        if kind == "dow":
+            match = re.fullmatch(r"([0-9]+)L", base)
+            if match:
+                if step is not None:
+                    raise ValueError(f"bad item: {item!r}")
+                n = int(match.group(1))
+                if not 0 <= n <= 7:
+                    raise ValueError(f"value out of range: {item!r}")
+                specials.append(("last", n % 7))
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", base)
+            if match:
+                if step is not None:
+                    raise ValueError(f"bad item: {item!r}")
+                n = int(match.group(1))
+                k = int(match.group(2))
+                if not 0 <= n <= 7 or not 1 <= k <= 5:
+                    raise ValueError(f"value out of range: {item!r}")
+                specials.append(("nth", n % 7, k))
+                continue
+
+        if base == "*":
+            sequence = list(range(lo, hi + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError(f"bad range: {item!r}")
+            left, right = base.split("-")
+            if not left or not right:
+                raise ValueError(f"bad range: {item!r}")
+            a = _parse_value(left, lo, hi, names)
+            b = _parse_value(right, lo, hi, names)
+            if kind == "dow" and a > b:
+                # Day-of-week wraps through 0..6, with 7 treated as 0.
+                a %= 7
+                b %= 7
+                sequence = []
+                value = a
+                while True:
+                    sequence.append(value)
+                    if value == b:
+                        break
+                    value = (value + 1) % 7
+            elif a <= b:
+                sequence = list(range(a, b + 1))
+            else:
+                sequence = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            value = _parse_value(base, lo, hi, names)
+            if step is not None:
+                # N/S means N up to the field's maximum, then every S-th value.
+                sequence = list(range(value, hi + 1))
+            else:
+                sequence = [value]
+
+        if step is not None:
+            sequence = sequence[::step]
+        values.update(sequence)
+
+    if kind == "dow":
+        values = {value % 7 for value in values}
+    return values, last_day, specials
+
+
+class _Schedule:
+
+    def __init__(self, fields):
+        minute, hour, dom, month, dow = fields
+        self.minutes, _, _ = _parse_field(minute, "minute")
+        self.hours, _, _ = _parse_field(hour, "hour")
+        self.dom_days, self.dom_last, _ = _parse_field(dom, "dom")
+        self.months, _, _ = _parse_field(month, "month")
+        self.dow_days, _, self.dow_specials = _parse_field(dow, "dow")
+        self.dom_restricted = dom not in ("*", "?")
+        self.dow_restricted = dow not in ("*", "?")
+        self.times = sorted(
+            (hour, minute)
+            for hour in self.hours
+            for minute in self.minutes
+        )
+
+    def day_allowed(self, day):
+        if day.month not in self.months:
+            return False
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+
+        last = None
+        dom_ok = False
+        if self.dom_restricted:
+            dom_ok = day.day in self.dom_days
+            if not dom_ok and self.dom_last:
+                last = calendar.monthrange(day.year, day.month)[1]
+                dom_ok = day.day == last
+
+        dow_ok = False
+        if self.dow_restricted:
+            weekday = (day.weekday() + 1) % 7
+            dow_ok = weekday in self.dow_days
+            if not dow_ok and self.dow_specials:
+                if last is None:
+                    last = calendar.monthrange(day.year, day.month)[1]
+                for special in self.dow_specials:
+                    if special[0] == "last":
+                        if weekday == special[1] and day.day + 7 > last:
+                            dow_ok = True
+                            break
+                    else:
+                        _, n, k = special
+                        if weekday == n and (day.day - 1) // 7 + 1 == k:
+                            dow_ok = True
+                            break
+
+        if self.dom_restricted and self.dow_restricted:
+            return dom_ok or dow_ok
+        if self.dom_restricted:
+            return dom_ok
+        return dow_ok
+
+    def matches(self, when):
+        if when.minute not in self.minutes or when.hour not in self.hours:
+            return False
+        return self.day_allowed(when)
+
+
+def _compile(expr):
+    text = expr.strip()
+    lowered = text.lower()
+    if lowered.startswith("@"):
+        if lowered not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[lowered]
+    if not text:
+        raise ValueError("empty expression")
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+    return _Schedule(fields)
+
 
