 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+
+_MONTHS = ["jan", "feb", "mar", "apr", "may", "jun",
+           "jul", "aug", "sep", "oct", "nov", "dec"]
+_DAYS = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names) for each of the five fields.
+_SPECS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+def _value(token, spec, expr):
+    low, high, names = spec
+    if token.isdigit() and token.isascii():
+        value = int(token)
+    elif names is not None and token.lower() in names:
+        value = names[token.lower()]
+    else:
+        raise ValueError(f"bad value {token!r} in {expr!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {token!r} out of range in {expr!r}")
+    return value
+
+
+def _item_values(item, index, expr):
+    """The ordered values an ordinary item (*, N, A-B, with optional /S) lists."""
+    spec = _SPECS[index]
+    low, high, _ = spec
+    if "/" in item:
+        base, _, step_text = item.partition("/")
+        if "/" in step_text or not (step_text.isdigit() and step_text.isascii()):
+            raise ValueError(f"bad step in {item!r} in {expr!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step of 0 in {expr!r}")
+    else:
+        base, step = item, None
+    if base == "*":
+        top = 6 if index == _DOW else high
+        values = list(range(low, top + 1))
+    elif "-" in base:
+        start_text, _, end_text = base.partition("-")
+        if "-" in end_text:
+            raise ValueError(f"bad range {base!r} in {expr!r}")
+        start = _value(start_text, spec, expr)
+        end = _value(end_text, spec, expr)
+        if index == _DOW:
+            start, end = start % 7, end % 7
+            high = 6
+        if start <= end:
+            values = list(range(start, end + 1))
+        else:
+            values = list(range(start, high + 1)) + list(range(low, end + 1))
+    else:
+        start = _value(base, spec, expr)
+        values = list(range(start, high + 1)) if step is not None else [start]
+    if step is not None:
+        values = values[::step]
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    return values
+
+
+def _parse_field(text, index, expr):
+    """Parse one field into a dict describing it."""
+    field = {"any": False, "values": set(), "last": False,
+             "last_dow": set(), "nth_dow": set()}
+    if text in ("*", "?"):
+        if text == "?" and index not in (_DOM, _DOW):
+            raise ValueError(f"'?' not allowed here in {expr!r}")
+        field["any"] = True
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {expr!r}")
+        if item == "?":
+            if index not in (_DOM, _DOW) or text != "?":
+                raise ValueError(f"bad '?' in {expr!r}")
+            continue
+        upper = item.upper()
+        if upper == "L":
+            if index != _DOM:
+                raise ValueError(f"'L' not allowed here in {expr!r}")
+            field["last"] = True
+            continue
+        if upper.endswith("L") and upper[:-1].isdigit() and upper[:-1].isascii():
+            if index != _DOW:
+                raise ValueError(f"'NL' not allowed here in {expr!r}")
+            n = int(upper[:-1])
+            if not 0 <= n <= 7:
+                raise ValueError(f"bad day {item!r} in {expr!r}")
+            field["last_dow"].add(n % 7)
+            continue
+        if "#" in item:
+            if index != _DOW:
+                raise ValueError(f"'N#K' not allowed here in {expr!r}")
+            n_text, _, k_text = item.partition("#")
+            if not (n_text.isdigit() and n_text.isascii()
+                    and k_text.isdigit() and k_text.isascii()):
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            n, k = int(n_text), int(k_text)
+            if not 0 <= n <= 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            field["nth_dow"].add((n % 7, k))
+            continue
+        field["values"].update(_item_values(item, index, expr))
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut in {expr!r}") from None
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    return [_parse_field(part, i, expr) for i, part in enumerate(parts)]
+
+
+def _day_allowed(fields, date):
+    dom, dow = fields[_DOM], fields[_DOW]
+    if dom["any"] and dow["any"]:
+        return True
+    day = date.day
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dom_ok = day in dom["values"] or (dom["last"] and day == days_in_month)
+    dow_ok = (weekday in dow["values"]
+              or (weekday in dow["last_dow"] and day + 7 > days_in_month)
+              or (weekday, (day - 1) // 7 + 1) in dow["nth_dow"])
+    if dom["any"]:
+        return dow_ok
+    if dow["any"]:
+        return dom_ok
+    return dom_ok or dow_ok
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    return (when.minute in fields[_MINUTE]["values"]
+            and when.hour in fields[_HOUR]["values"]
+            and when.month in fields[_MONTH]["values"]
+            and _day_allowed(fields, when.date()))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    minutes = sorted(fields[_MINUTE]["values"])
+    hours = sorted(fields[_HOUR]["values"])
+    months = fields[_MONTH]["values"]
+    limit = after + _LIMIT
+    start = after.replace(second=0, microsecond=0) + _dt.timedelta(minutes=1)
+    date = start.date()
+    first_day = True
+    while True:
+        if date.month in months and _day_allowed(fields, date):
+            for hour in hours:
+                if first_day and hour < start.hour:
+                    continue
+                for minute in minutes:
+                    if first_day and hour == start.hour and minute < start.minute:
+                        continue
+                    candidate = _dt.datetime.combine(date, _dt.time(hour, minute))
+                    if candidate > limit:
+                        return None
+                    return candidate
+        first_day = False
+        date += _dt.timedelta(days=1)
+        if _dt.datetime.combine(date, _dt.time()) > limit:
+            return None
