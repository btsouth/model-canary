     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    s = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + _MINUTE
+    except OverflowError:
+        return None
+    try:
+        limit = after + _SPAN
+    except OverflowError:
+        limit = datetime.max
+
+    times = sorted(h * 60 + m for h in s.hour for m in s.minute)
+    start_ordinal = start.toordinal()
+    start_minute = start.hour * 60 + start.minute
+    for ordinal in range(start_ordinal, limit.toordinal() + 1):
+        day = date.fromordinal(ordinal)
+        if day.month not in s.month or not _day_matches(s, day):
+            continue
+        floor = start_minute if ordinal == start_ordinal else 0
+        index = bisect_left(times, floor)
+        if index < len(times):
+            run = datetime.combine(day, time()) + timedelta(minutes=times[index])
+            return run if run <= limit else None
+    return None
