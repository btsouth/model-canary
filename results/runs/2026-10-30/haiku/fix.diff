 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from collections import namedtuple
+from datetime import date, datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTH_NAMES = {n: i for i, n in enumerate("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAY_NAMES = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+_SEPARATOR = re.compile(r"[ \t]+")
+_MINUTE = timedelta(minutes=1)
+_SPAN = timedelta(days=20 * 365)
+
+_Schedule = namedtuple(
+    "_Schedule",
+    "minute hour dom dom_last dom_restricted month dow dow_specials dow_restricted",
+)
+
+
+def _in_range(n, lo, hi):
+    if not lo <= n <= hi:
+        raise ValueError(f"{n} is outside {lo}-{hi}")
+    return n
+
+
+def _value(token, lo, hi, names):
+    """A single number, or a name from names (names are matched in any case)."""
+    if _DIGITS.fullmatch(token):
+        return _in_range(int(token), lo, hi)
+    if token.upper() in names:
+        return names[token.upper()]
+    raise ValueError(f"bad value {token!r}")
+
+
+def _field(text, lo, hi, names, day=None):
+    """Parse one field into (values, specials). day is "dom" or "dow" for day fields."""
+    values, specials = set(), []
+    for item in text.split(","):
+        if day == "dom" and item == "L":
+            specials.append(("last",))
+            continue
+        if day == "dow":
+            last = _LAST_WEEKDAY.fullmatch(item)
+            if last:
+                specials.append(("last", _in_range(int(last.group(1)), 0, 7) % 7))
+                continue
+            nth = _NTH_WEEKDAY.fullmatch(item)
+            if nth:
+                n = _in_range(int(nth.group(1)), 0, 7) % 7
+                k = _in_range(int(nth.group(2)), 1, 5)
+                specials.append(("nth", n, k))
+                continue
+
+        base, slash, step_text = item.partition("/")
+        step = None
+        if slash:
+            if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        else:
+            first, dash, last_text = base.partition("-")
+            start = _value(first, lo, hi, names)
+            if not dash:
+                seq = list(range(start, hi + 1)) if slash else [start]
+            else:
+                end = _value(last_text, lo, hi, names)
+                if day == "dow" and start == 7 and start > end:
+                    start = 0
+                if start <= end:
+                    seq = list(range(start, end + 1))
+                elif day == "dow":
+                    seq = list(range(start, 7)) + list(range(0, end + 1))
+                else:
+                    seq = list(range(start, hi + 1)) + list(range(lo, end + 1))
+        if step is not None:
+            seq = seq[::step]
+        if day == "dow":
+            seq = [v % 7 for v in seq]
+        values.update(seq)
+    return values, specials
+
+
+def _parse(expr):
+    """Check and parse a whole expression; raises ValueError if it is bad."""
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError(f"unknown shortcut {expr!r}")
+    fields = _SEPARATOR.split(text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+
+    minute, _ = _field(fields[0], 0, 59, {})
+    hour, _ = _field(fields[1], 0, 23, {})
+    dom_text = fields[2]
+    dom, dom_specials = _field("*" if dom_text == "?" else dom_text, 1, 31, {}, "dom")
+    month, _ = _field(fields[3], 1, 12, _MONTH_NAMES)
+    dow_text = fields[4]
+    dow, dow_specials = _field("*" if dow_text == "?" else dow_text, 0, 7, _DAY_NAMES, "dow")
+    return _Schedule(
+        minute=minute,
+        hour=hour,
+        dom=dom,
+        dom_last=bool(dom_specials),
+        dom_restricted=dom_text not in ("*", "?"),
+        month=month,
+        dow=dow,
+        dow_specials=dow_specials,
+        dow_restricted=dow_text not in ("*", "?"),
+    )
+
+
+def _special_hits(special, weekday, day, last_day):
+    if special[0] == "last":
+        return weekday == special[1] and day + 7 > last_day
+    return weekday == special[1] and (day - 1) // 7 == special[2] - 1
+
+
+def _day_matches(s, day):
+    """Classic cron: if both day fields are restricted, either one may match."""
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom_hit = day.day in s.dom or (s.dom_last and day.day == last_day)
+    weekday = (day.weekday() + 1) % 7
+    dow_hit = weekday in s.dow or any(
+        _special_hits(sp, weekday, day.day, last_day) for sp in s.dow_specials
+    )
+    if s.dom_restricted and s.dow_restricted:
+        return dom_hit or dow_hit
+    return dom_hit and dow_hit
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _parse(expr)
+    return (
+        when.minute in s.minute
+        and when.hour in s.hour
+        and when.month in s.month
+        and _day_matches(s, when.date())
+    )
 
 
