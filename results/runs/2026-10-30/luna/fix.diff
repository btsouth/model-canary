 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i for i, n in enumerate(("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC").split(), 1)}
+_DAYS = {n: i for i, n in enumerate(("SUN MON TUE WED THU FRI SAT").split())}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *", "@hourly": "0 * * * *",
+}
+_RANGES = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _atom(s, idx, allow_names):
+    upper = s.upper()
+    names = _MONTHS if idx == 3 else _DAYS if idx == 4 else {}
+    if allow_names and upper in names:
+        return names[upper]
+    if not re.fullmatch(r"\d+", s):
+        raise ValueError("invalid field value")
+    n = int(s)
+    lo, hi = _RANGES[idx]
+    if not lo <= n <= hi:
+        raise ValueError("field value out of range")
+    return n
+
+
+def _field(s, idx):
+    lo, hi = _RANGES[idx]
+    specials = []
+    values = set()
+    unrestricted = s in ("*", "?")
+    if s == "?" and idx not in (2, 4):
+        raise ValueError("? only allowed in day fields")
+    if s == "?":
+        s = "*"
+    for item in s.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if idx == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if idx == 4 and (m := re.fullmatch(r"(\d+)L", item)):
+            n = _atom(m.group(1), idx, False); specials.append(("last_weekday", n % 7)); continue
+        if idx == 4 and (m := re.fullmatch(r"(\d+)#([1-5])", item)):
+            n = _atom(m.group(1), idx, False); specials.append(("nth_weekday", n % 7, int(m.group(2)))); continue
+        if "#" in item or ("L" in item):
+            raise ValueError("invalid special day item")
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        if len(pieces) == 2 and re.search(r"[A-Za-z]", pieces[0]):
+            raise ValueError("names are not allowed with steps")
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"\d+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError("invalid step")
+            step = int(pieces[1])
+        base = pieces[0]
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            if base.count("-") != 1: raise ValueError("invalid range")
+            a, b = (_atom(x, idx, True) for x in base.split("-"))
+            if idx == 4:
+                a %= 7; b %= 7; maximum = 6; minimum = 0
+            else:
+                maximum, minimum = hi, lo
+            seq = list(range(a, b + 1)) if a <= b else list(range(a, maximum + 1)) + list(range(minimum, b + 1))
+        else:
+            n = _atom(base, idx, True)
+            end = hi
+            if idx == 4:
+                if n == 7:
+                    seq = [7]
+                else:
+                    end = 6
+                    seq = list(range(n, end + 1)) if len(pieces) == 2 else [n]
+            else:
+                seq = list(range(n, end + 1)) if len(pieces) == 2 else [n]
+        if idx == 4: seq = [n % 7 for n in seq]
+        values.update(seq[::step])
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str): raise ValueError("expression must be text")
+    source = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", source.strip()) if source.strip() else []
+    if len(parts) != 5: raise ValueError("schedule needs five fields")
+    parsed = [_field(p, i) for i, p in enumerate(parts)]
+    return parsed
+
+
+def _day_allowed(dt, dom, dow):
+    domset, domspecial, domu = dom
+    dowset, dowspecial, dowu = dow
+    day = dt.day
+    last = calendar.monthrange(dt.year, dt.month)[1]
+    pyweekday = dt.weekday()
+    weekday = (pyweekday + 1) % 7
+    dm = day in domset or any(x[0] == "last" and day == last for x in domspecial)
+    dw = weekday in dowset
+    for sp in dowspecial:
+        if sp[0] == "last_weekday" and weekday == sp[1] and day + 7 > last: dw = True
+        if sp[0] == "nth_weekday" and weekday == sp[1] and (day - 1) // 7 + 1 == sp[2]: dw = True
+    if domu and dowu: return True
+    if domu: return dw
+    if dowu: return dm
+    return dm or dw
 
 
