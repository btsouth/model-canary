 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (minimum, maximum, names) for each field; names map to values.
+_MINUTE = (0, 59, None)
+_HOUR = (0, 23, None)
+_DOM = (1, 31, None)
+_MONTH = (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)})
+_DOW = (0, 7, {name: i for i, name in enumerate(_DAYS)})
+
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, dom, dom_last, months, dow, dow_last, dow_nth,
+                 dom_restricted, dow_restricted):
+        self.minutes = sorted(minutes)
+        self.minute_set = minutes
+        self.hours = sorted(hours)
+        self.hour_set = hours
+        self.dom = dom
+        self.dom_last = dom_last
+        self.months = months
+        self.dow = dow
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+        self.dom_restricted = dom_restricted
+        self.dow_restricted = dow_restricted
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+        last = calendar.monthrange(date.year, date.month)[1]
+        if self.dom_restricted:
+            dom_ok = date.day in self.dom or (self.dom_last and date.day == last)
+            if dom_ok or not self.dow_restricted:
+                return dom_ok
+        weekday = (date.weekday() + 1) % 7
+        return (weekday in self.dow
+                or (weekday in self.dow_last and date.day + 7 > last)
+                or (weekday, (date.day - 1) // 7 + 1) in self.dow_nth)
+
+
+def _value(text, field, allow_names=True):
+    low, high, names = field
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif allow_names and names and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _item(item, field):
+    """The values listed by one '*', 'N' or 'A-B' item with an optional '/S' step."""
+    low, high, _ = field
+    base, slash, step = item.partition("/")
+    if slash:
+        if not _NUMBER.fullmatch(step) or int(step) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step)
+    else:
+        step = 1
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        first, _, last = base.partition("-")
+        first, last = _value(first, field), _value(last, field)
+        if first <= last:
+            values = list(range(first, last + 1))
+        elif field is _DOW:
+            values = [first % 7]
+            while values[-1] != last:
+                values.append((values[-1] + 1) % 7)
+        else:
+            values = list(range(first, high + 1)) + list(range(low, last + 1))
+    else:
+        first = _value(base, field)
+        values = list(range(first, high + 1)) if slash else [first]
+    return set(values[::step])
+
+
+def _field(text, field):
+    """Parse a plain field into a set of values."""
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        values |= _item(item, field)
+    return values
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+    minute, hour, dom_text, month, dow_text = parts
+
+    minutes = _field(minute, _MINUTE)
+    hours = _field(hour, _HOUR)
+    months = _field(month, _MONTH)
+
+    dom, dom_last = set(), False
+    dom_restricted = dom_text not in ("*", "?")
+    if dom_text == "?":
+        dom_text = "*"
+    for item in dom_text.split(","):
+        if item == "L":
+            dom_last = True
+        elif not item:
+            raise ValueError(f"empty item in {dom_text!r}")
+        else:
+            dom |= _item(item, _DOM)
+
+    dow, dow_last, dow_nth = set(), set(), set()
+    dow_restricted = dow_text not in ("*", "?")
+    if dow_text == "?":
+        dow_text = "*"
+    for item in dow_text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {dow_text!r}")
+        if item.endswith("L") and "/" not in item:
+            dow_last.add(_value(item[:-1], _DOW, allow_names=False) % 7)
+        elif "#" in item:
+            day, _, nth = item.partition("#")
+            day = _value(day, _DOW, allow_names=False) % 7
+            if not _NUMBER.fullmatch(nth) or not 1 <= int(nth) <= 5:
+                raise ValueError(f"bad week number: {item!r}")
+            dow_nth.add((day, int(nth)))
+        else:
+            dow |= {d % 7 for d in _item(item, _DOW)}
+
+    return _Schedule(minutes, hours, dom, dom_last, months, dow, dow_last, dow_nth,
+                     dom_restricted, dow_restricted)
 
 
