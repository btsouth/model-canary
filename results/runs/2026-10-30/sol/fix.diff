 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1
+)}
+_DAYS = {name: i for i, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, minimum, maximum, names=None):
+    if names and token.upper() in names:
+        return names[token.upper()]
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError("invalid schedule value")
+    value = int(token)
+    if not minimum <= value <= maximum:
+        raise ValueError("schedule value out of range")
+    return value
+
+
+def _field(text, index):
+    minimum, maximum = _LIMITS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    unrestricted = text in ("*", "?")
+    if text == "?" and index in (2, 4):
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if index == 4:
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if special:
+                weekday = _number(special[1], 0, 7) % 7
+                if special[2] == "L":
+                    specials.append(("last", weekday))
+                else:
+                    specials.append(("nth", weekday, _number(special[3], 1, 5)))
+                continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError("invalid step")
+            step = int(pieces[1])
+        if base == "*":
+            sequence = list(range(minimum, maximum + 1))
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError("invalid range")
+            start, end = (_number(part, minimum, maximum, names) for part in endpoints)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, maximum + 1)) + list(range(minimum, end + 1))
+        else:
+            start = _number(base, minimum, maximum, names)
+            sequence = list(range(start, maximum + 1)) if len(pieces) == 2 else [start]
+        values.update(value % 7 if index == 4 else value for value in sequence[::step])
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("a schedule needs five fields")
+    return [_field(part, index) for index, part in enumerate(parts)]
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or bool(dom[1]) and day.day == last_day
+    dow_match = weekday in dow[0] or any(
+        weekday == special[1] and (
+            day.day + 7 > last_day if special[0] == "last"
+            else (day.day - 1) // 7 + 1 == special[2]
+        ) for special in dow[1]
+    )
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
+
