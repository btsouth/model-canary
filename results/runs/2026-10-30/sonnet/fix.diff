 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "jan feb mar apr may jun jul aug sep oct nov dec".split())}
+_DAYS = {n: i for i, n in enumerate("sun mon tue wed thu fri sat".split())}
+_NUM = re.compile(r"[0-9]+")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+_LAST = re.compile(r"([0-9]+)[Ll]")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        n = int(tok)
+    elif names and tok.isascii() and tok.lower() in names:
+        n = names[tok.lower()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= n <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return n
+
+
+def _expand(base, lo, hi, names, dow):
+    """Ordered list of values for '*', 'N' or 'A-B' (before any step)."""
+    if base == "*":
+        return list(range(lo, hi + 1)), False
+    if "-" in base:
+        a, _, b = base.partition("-")
+        a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+        if dow and a > b and a == 7:
+            a = 0
+        if a <= b:
+            return list(range(a, b + 1)), True
+        top = 6 if dow else hi
+        return list(range(a, top + 1)) + list(range(lo, b + 1)), True
+    return [_value(base, lo, hi, names)], False
+
+
+def _parse_field(text, lo, hi, names=None, dom=False, dow=False):
+    """Return (values, extras) where extras holds L / NL / N#K items."""
+    values, extras = set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if dom and item in ("L", "l"):
+            extras.add("L")
+            continue
+        if dow:
+            m = _NTH.fullmatch(item)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if not (0 <= n <= 7 and 1 <= k <= 5):
+                    raise ValueError(f"bad item {item!r}")
+                extras.add((n % 7, k))
+                continue
+            m = _LAST.fullmatch(item)
+            if m:
+                n = int(m.group(1))
+                if not 0 <= n <= 7:
+                    raise ValueError(f"bad item {item!r}")
+                extras.add((n % 7, "L"))
+                continue
+        base, slash, step = item.partition("/")
+        if slash:
+            if not _NUM.fullmatch(step) or int(step) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step)
+        else:
+            step = 1
+        if slash and "-" not in base and base != "*":
+            n = _value(base, lo, hi, names)
+            seq = list(range(n, hi + 1))
+        else:
+            seq, _ = _expand(base, lo, hi, names, dow)
+        values.update(seq[::step])
+    if dow:
+        values = {v % 7 for v in values}
+    return values, extras
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        if expr.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        expr = _SHORTCUTS[expr.lower()]
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minute, hour, dom, month, dow = parts
+    minutes, _ = _parse_field(minute, 0, 59)
+    hours, _ = _parse_field(hour, 0, 23)
+    months, _ = _parse_field(month, 1, 12, _MONTHS)
+    dom_restricted = dom not in ("*", "?")
+    dow_restricted = dow not in ("*", "?")
+    if dom == "?":
+        dom = "*"
+    if dow == "?":
+        dow = "*"
+    doms, dom_extra = _parse_field(dom, 1, 31, dom=True)
+    dows, dow_extra = _parse_field(dow, 0, 7, _DAYS, dow=True)
+    return (sorted(minutes), sorted(hours), months, doms, dom_extra, dows,
+            dow_extra, dom_restricted, dow_restricted)
+
+
+def _day_ok(p, year, month, day):
+    _, _, _, doms, dom_extra, dows, dow_extra, dom_r, dow_r = p
+    if not dom_r and not dow_r:
+        return True
+    last = calendar.monthrange(year, month)[1]
+    dom_hit = day in doms or ("L" in dom_extra and day == last)
+    wd = (datetime(year, month, day).weekday() + 1) % 7
+    dow_hit = (wd in dows
+               or (wd, "L") in dow_extra and day + 7 > last
+               or (wd, (day - 1) // 7 + 1) in dow_extra)
+    if dom_r and dow_r:
+        return dom_hit or dow_hit
+    return dom_hit if dom_r else dow_hit
 
 
