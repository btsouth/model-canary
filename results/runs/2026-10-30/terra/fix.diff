 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        unrestricted = field in ('*', '?')
+        if field == '?' and index in (2, 4):
+            field = '*'
+        values, specials = set(), []
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in names:
+                value = names[token.upper()]
+            else:
+                raise ValueError('invalid value')
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                specials.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])(L|#([1-5]))', item) if index == 4 else None
+            if match:
+                specials.append((match.group(2)[0], int(match.group(1)) % 7,
+                                 int(match.group(3)) if match.group(3) else None))
+                continue
+            parts = item.split('/')
+            if len(parts) > 2 or not parts[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(parts) == 2:
+                if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(parts[1])
+            base = parts[0]
+            if base == '*':
+                sequence = list(range(low, high + 1))
+            elif '-' in base:
+                endpoints = base.split('-')
+                if len(endpoints) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, endpoints)
+                if index == 4:
+                    original_start = start
+                    if start == 7:
+                        start = 0
+                    if end == 7 and start != 0:
+                        sequence = list(range(start, 8))
+                    elif end == 7 and original_start == 0:
+                        sequence = list(range(0, 8))
+                    else:
+                        end %= 7
+                        sequence = list(range(start, end + 1)) if start <= end else list(range(start, 7)) + list(range(0, end + 1))
+                else:
+                    sequence = list(range(start, end + 1)) if start <= end else list(range(start, high + 1)) + list(range(low, end + 1))
+            else:
+                start = number(base)
+                sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+            values.update((v % 7 if index == 4 else v) for v in sequence[::step])
+        parsed.append((values, specials, unrestricted))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    dom, dow = parsed[2], parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    month_match = date.day in dom[0] or bool(dom[1] and date.day == last)
+    week_match = weekday in dow[0]
+    for kind, day, nth in dow[1]:
+        if weekday == day and ((kind == 'L' and date.day + 7 > last) or
+                               (kind == '#' and (date.day - 1) // 7 + 1 == nth)):
+            week_match = True
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return week_match
+    if dow[2]:
+        return month_match
+    return month_match or week_match
+
 
