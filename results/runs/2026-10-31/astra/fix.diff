 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from bisect import bisect_right
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())},
+}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal digits')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _LIMITS[index]
+    values, special = set(), []
+    unrestricted = text in ('*', '?')
+    if text == '?' and index in (2, 4):
+        text = '*'
+
+    def value(token):
+        number = _NAMES.get(index, {}).get(token.upper())
+        if number is None:
+            number = _number(token)
+        if not low <= number <= high:
+            raise ValueError('value outside field range')
+        return number
+
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        last = re.fullmatch(r'([0-9]+)L', item)
+        nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item)
+        if index == 4 and (last or nth):
+            day = value((last or nth).group(1)) % 7
+            if last:
+                special.append(('last', day))
+            else:
+                occurrence = _number(nth.group(2))
+                if not 1 <= occurrence <= 5:
+                    raise ValueError('invalid weekday occurrence')
+                special.append(('nth', day, occurrence))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('invalid step')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            bounds = base.split('-')
+            if len(bounds) != 2:
+                raise ValueError('invalid range')
+            start, end = map(value, bounds)
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError('reversed range')
+        values.update(n % 7 if index == 4 else n
+                      for n in range(start, end + 1, step))
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expression must be text')
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    return tuple(_field(part, i) for i, part in enumerate(parts))
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    month_end = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or bool(dom[1]) and day.day == month_end
+    dow_match = weekday in dow[0]
+    for rule in dow[1]:
+        if weekday == rule[1]:
+            if rule[0] == 'last':
+                dow_match |= day.day + 7 > month_end
+            else:
+                dow_match |= (day.day - 1) // 7 + 1 == rule[2]
+    if dom[2]:
+        return dow[2] or dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
