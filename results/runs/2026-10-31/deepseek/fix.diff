 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_RANGES = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ("jan", "feb", "mar", "apr", "may", "jun",
+         "jul", "aug", "sep", "oct", "nov", "dec"),
+        1,
+    )
+}
+
+_DOW_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ("sun", "mon", "tue", "wed", "thu", "fri", "sat")
+    )
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+def _number(text, low, high):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if value < low or value > high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _value(text, kind):
+    if kind == "month" and text.lower() in _MONTH_NAMES:
+        return _MONTH_NAMES[text.lower()]
+    if kind == "dow" and text.lower() in _DOW_NAMES:
+        return _DOW_NAMES[text.lower()]
+    low, high = _RANGES[kind]
+    return _number(text, low, high)
+
+
+def _standard_item(item, kind):
+    """Parse one ordinary item in a field (no L / NL / N#K specials)."""
+    low, high = _RANGES[kind]
+    values = set()
+
+    if "/" in item:
+        if item.count("/") != 1:
+            raise ValueError(f"bad item: {item!r}")
+        base, step_text = item.split("/")
+        if not base:
+            raise ValueError(f"bad item: {item!r}")
+        if not _DIGITS.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+        if any(ch.isalpha() for ch in base):
+            raise ValueError(f"name in a step: {item!r}")
+
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError(f"bad range: {item!r}")
+            left, right = base.split("-")
+            start = _number(left, low, high)
+            end = _number(right, low, high)
+            if start > end:
+                raise ValueError(f"descending range: {item!r}")
+        else:
+            start = _number(base, low, high)
+            end = high
+        values.update(range(start, end + 1, step))
+        return values
+
+    if item == "*":
+        values.update(range(low, high + 1))
+    elif "-" in item:
+        if item.count("-") != 1:
+            raise ValueError(f"bad range: {item!r}")
+        left, right = item.split("-")
+        start = _value(left, kind)
+        end = _value(right, kind)
+        if start > end:
+            raise ValueError(f"descending range: {item!r}")
+        values.update(range(start, end + 1))
+    else:
+        values.add(_value(item, kind))
+    return values
+
+
+def _standard_field(text, kind):
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in: {text!r}")
+        values.update(_standard_item(item, kind))
+    return values
+
+
+def _parse_dom(text):
+    if text == "?":
+        return set(range(1, 32)), False, False
+    restricted = text not in ("*", "?")
+    values = set()
+    last = False
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in: {text!r}")
+        if item == "L":
+            last = True
+            continue
+        values.update(_standard_item(item, "dom"))
+    return values, last, restricted
+
+
+def _parse_dow(text):
+    if text == "?":
+        return set(range(0, 7)), set(), [], False
+    restricted = text not in ("*", "?")
+    values = set()
+    last = set()
+    nth = []
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in: {text!r}")
+        match = _LAST_DOW.fullmatch(item)
+        if match:
+            n = _number(match.group(1), 0, 7)
+            last.add(n % 7)
+            continue
+        match = _NTH_DOW.fullmatch(item)
+        if match:
+            n = _number(match.group(1), 0, 7)
+            k = _number(match.group(2), 1, 5)
+            nth.append((n % 7, k))
+            continue
+        if "L" in item or "#" in item:
+            raise ValueError(f"bad day of week item: {item!r}")
+        values.update(_standard_item(item, "dow"))
+    values = {value % 7 for value in values}
+    return values, last, nth, restricted
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, months, dom, dom_last,
+                 dom_restricted, dow, dow_last, dow_nth, dow_restricted):
+        self.minutes = minutes
+        self.hours = hours
+        self.months = months
+        self.minutes_sorted = sorted(minutes)
+        self.hours_sorted = sorted(hours)
+        self.dom = dom
+        self.dom_last = dom_last
+        self.dom_restricted = dom_restricted
+        self.dow = dow
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+        self.dow_restricted = dow_restricted
+
+    def day_allowed(self, day):
+        last_day = calendar.monthrange(day.year, day.month)[1]
+        dom_match = day.day in self.dom or (
+            self.dom_last and day.day == last_day
+        )
+
+        cron_dow = (day.weekday() + 1) % 7
+        dow_match = cron_dow in self.dow
+        if not dow_match:
+            for n in self.dow_last:
+                if n == cron_dow and day.day + 7 > last_day:
+                    dow_match = True
+                    break
+        if not dow_match:
+            for n, k in self.dow_nth:
+                if n == cron_dow and (day.day - 1) // 7 + 1 == k:
+                    dow_match = True
+                    break
+
+        if self.dom_restricted and self.dow_restricted:
+            return dom_match or dow_match
+        if self.dom_restricted:
+            return dom_match
+        if self.dow_restricted:
+            return dow_match
+        return True
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule")
+    lowered = text.lower()
+    if lowered in _SHORTCUTS:
+        text = _SHORTCUTS[lowered]
+    elif lowered.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    fields = re.split(r"[ \t]+", text.strip())
+    if len(fields) != 5:
+        raise ValueError(f"a schedule needs five fields: {expr!r}")
+
+    minutes = _standard_field(fields[0], "minute")
+    hours = _standard_field(fields[1], "hour")
+    dom, dom_last, dom_restricted = _parse_dom(fields[2])
+    months = _standard_field(fields[3], "month")
+    dow, dow_last, dow_nth, dow_restricted = _parse_dow(fields[4])
+    return _Schedule(
+        minutes, hours, months, dom, dom_last, dom_restricted,
+        dow, dow_last, dow_nth, dow_restricted,
+    )
+
+
+def _find_time(schedule, day, lower_hour, lower_minute):
+    hours = schedule.hours_sorted
+    start = bisect_left(hours, lower_hour)
+    for hour in hours[start:]:
+        first_minute = lower_minute if hour == lower_hour else 0
+        index = bisect_left(schedule.minutes_sorted, first_minute)
+        if index < len(schedule.minutes_sorted):
+            return datetime(
+                day.year, day.month, day.day, hour,
+                schedule.minutes_sorted[index],
+            )
+    return None
+
 
