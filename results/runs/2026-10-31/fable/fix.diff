--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,201 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DOW_NAMES = {name: i for i, name in enumerate(
+    ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTH_NAMES),
+    (0, 7, _DOW_NAMES),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_NUMBER = re.compile(r"\d+\Z")
+_LAST_DOW = re.compile(r"(\d+)L\Z")
+_NTH_DOW = re.compile(r"(\d+)#(\d+)\Z")
+
+_HORIZON = dt.timedelta(days=20 * 365)
+
+
+def _value(token, low, high, names, expr):
+    """Turn a number or name into a value within [low, high]."""
+    if _NUMBER.match(token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r} in {expr!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {token!r} out of range in {expr!r}")
+    return value
+
+
+def _parse_item(item, index, expr):
+    """Return the set of values an ordinary item lists."""
+    low, high, names = _FIELDS[index]
+    if not item:
+        raise ValueError(f"empty item in {expr!r}")
+    base, step = item, 1
+    if "/" in item:
+        base, step_text = item.split("/", 1)
+        if not _NUMBER.match(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step {step_text!r} in {expr!r}")
+        step = int(step_text)
+    if base == "*":
+        values = range(low, high + 1)
+    elif "-" in base:
+        a, b = base.split("-", 1)
+        start = _value(a, low, high, names, expr)
+        end = _value(b, low, high, names, expr)
+        if start > end:
+            raise ValueError(f"range {base!r} runs backwards in {expr!r}")
+        values = range(start, end + 1)
+    else:
+        start = _value(base, low, high, names, expr)
+        values = range(start, high + 1) if "/" in item else [start]
+    return set(values[::step])
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut in {expr!r}")
+            text = _SHORTCUTS[text.lower()]
+        parts = re.split(r"[ \t]+", text)
+        if len(parts) != 5 or any(not p for p in parts):
+            raise ValueError(f"expected five fields in {expr!r}")
+
+        self.minutes = self._plain(parts[_MINUTE], _MINUTE, expr)
+        self.hours = self._plain(parts[_HOUR], _HOUR, expr)
+        self.months = self._plain(parts[_MONTH], _MONTH, expr)
+
+        # Day of month.
+        dom = parts[_DOM]
+        self.dom_restricted = dom not in ("*", "?")
+        self.dom_days = set()
+        self.dom_last = False
+        if self.dom_restricted:
+            for item in dom.split(","):
+                if item == "L":
+                    self.dom_last = True
+                else:
+                    self.dom_days |= _parse_item(item, _DOM, expr)
+
+        # Day of week.
+        dow = parts[_DOW]
+        self.dow_restricted = dow not in ("*", "?")
+        self.dow_days = set()
+        self.dow_last = set()   # weekdays whose last occurrence in the month counts
+        self.dow_nth = set()    # (weekday, k) pairs
+        if self.dow_restricted:
+            for item in dow.split(","):
+                m = _LAST_DOW.match(item)
+                if m:
+                    self.dow_last.add(_value(m.group(1), 0, 7, None, expr) % 7)
+                    continue
+                m = _NTH_DOW.match(item)
+                if m:
+                    k = int(m.group(2))
+                    if not 1 <= k <= 5:
+                        raise ValueError(f"bad occurrence {item!r} in {expr!r}")
+                    self.dow_nth.add((_value(m.group(1), 0, 7, None, expr) % 7, k))
+                    continue
+                self.dow_days |= {d % 7 for d in _parse_item(item, _DOW, expr)}
+
+        self.minute_list = sorted(self.minutes)
+        self.times = [(h, m) for h in sorted(self.hours) for m in self.minute_list]
+
+    @staticmethod
+    def _plain(field, index, expr):
+        values = set()
+        for item in field.split(","):
+            values |= _parse_item(item, index, expr)
+        return values
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+        dom_ok = dow_ok = False
+        if self.dom_restricted:
+            last_day = calendar.monthrange(date.year, date.month)[1]
+            dom_ok = date.day in self.dom_days or (self.dom_last and date.day == last_day)
+        if self.dow_restricted:
+            weekday = (date.weekday() + 1) % 7  # Sunday == 0
+            last_day = calendar.monthrange(date.year, date.month)[1]
+            dow_ok = (
+                weekday in self.dow_days
+                or (weekday in self.dow_last and date.day + 7 > last_day)
+                or (weekday, (date.day - 1) // 7 + 1) in self.dow_nth
+            )
+        if self.dom_restricted and self.dow_restricted:
+            return dom_ok or dow_ok
+        return dom_ok if self.dom_restricted else dow_ok
+
+    def matches(self, when):
+        return (
+            when.minute in self.minutes
+            and when.hour in self.hours
+            and self.day_allowed(when.date())
+        )
+
+    def next_run(self, after):
+        limit = after + _HORIZON
+        start = after.replace(second=0, microsecond=0) + dt.timedelta(minutes=1)
+        date = start.date()
+        first = True
+        while True:
+            if date.month not in self.months:
+                # Jump to the first day of the next month.
+                year, month = date.year, date.month
+                date = dt.date(year + month // 12, month % 12 + 1, 1)
+                if dt.datetime.combine(date, dt.time()) > limit:
+                    return None
+                first = False
+                continue
+            if self.day_allowed(date):
+                for hour, minute in self.times:
+                    candidate = dt.datetime.combine(date, dt.time(hour, minute))
+                    if first and candidate < start:
+                        continue
+                    if candidate > limit:
+                        return None
+                    return candidate
+            date += dt.timedelta(days=1)
+            first = False
+            if dt.datetime.combine(date, dt.time()) > limit:
+                return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _Schedule(expr).matches(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    return _Schedule(expr).next_run(after)
