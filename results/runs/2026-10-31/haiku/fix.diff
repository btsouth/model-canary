 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+from typing import NamedTuple
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {
+    name: i + 1
+    for i, name in enumerate(
+        ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+    )
+}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+
+class _Spec(NamedTuple):
+    lo: int
+    hi: int
+    names: dict
+    day: bool
+
+
+_MINUTE = _Spec(0, 59, {}, False)
+_HOUR = _Spec(0, 23, {}, False)
+_DOM = _Spec(1, 31, {}, True)
+_MONTH = _Spec(1, 12, _MONTHS, False)
+_DOW = _Spec(0, 7, _DAYS, True)
+
+
+class _Plan(NamedTuple):
+    minutes: frozenset
+    hours: frozenset
+    months: frozenset
+    days: frozenset           # day-of-month numbers
+    last_day: bool            # L
+    weekdays: frozenset       # day-of-week numbers, 0 is Sunday
+    last_weekdays: frozenset  # NL: the last such weekday of the month
+    nth: frozenset            # (weekday, K) pairs for N#K
+    days_free: bool           # day of month is exactly * or ?
+    weekdays_free: bool       # day of week is exactly * or ?
+
+
+def _num(text, lo, hi):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"not a number: {text!r}")
+    n = int(text)
+    if not lo <= n <= hi:
+        raise ValueError(f"{n} is outside {lo}-{hi}")
+    return n
+
+
+def _value(text, spec):
+    if text.upper() in spec.names:
+        return spec.names[text.upper()]
+    return _num(text, spec.lo, spec.hi)
+
+
+def _span(text, spec):
+    first, _, last = text.partition("-")
+    a, b = _value(first, spec), _value(last, spec)
+    if a > b:
+        raise ValueError(f"range runs backwards: {text!r}")
+    return range(a, b + 1)
+
+
+def _item(item, spec, is_dom, is_dow):
+    """Return (values, specials) for one comma-separated item of a field."""
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not re.fullmatch(r"[0-9]+", step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        if base == "*":
+            span = range(spec.lo, spec.hi + 1)
+        elif "-" in base:
+            span = _span(base, spec)
+        else:
+            span = range(_value(base, spec), spec.hi + 1)
+        return set(span[:: int(step_text)]), []
+    if is_dom and item == "L":
+        return set(), [("L",)]
+    if is_dow:
+        m = re.fullmatch(r"([0-9]+)L", item)
+        if m:
+            return set(), [("NL", _num(m.group(1), 0, 7) % 7)]
+        m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if m:
+            n, k = _num(m.group(1), 0, 7) % 7, _num(m.group(2), 1, 5)
+            return set(), [("NTH", n, k)]
+    if item == "*":
+        return set(range(spec.lo, spec.hi + 1)), []
+    if "-" in item:
+        return set(_span(item, spec)), []
+    return {_value(item, spec)}, []
+
+
+def _field(text, spec, is_dom=False, is_dow=False):
+    """Return (values, specials, free) for one field; free means it is exactly * or ?."""
+    if text in ("*", "?"):
+        if text == "?" and not spec.day:
+            raise ValueError("? is only allowed in the day fields")
+        return set(range(spec.lo, spec.hi + 1)), [], True
+    values, specials = set(), []
+    for item in text.split(","):
+        item_values, item_specials = _item(item, spec, is_dom, is_dow)
+        values |= item_values
+        specials += item_specials
+    return values, specials, False
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom, month, dow = fields
+    minutes, _, _ = _field(minute, _MINUTE)
+    hours, _, _ = _field(hour, _HOUR)
+    months, _, _ = _field(month, _MONTH)
+    days, dom_specials, days_free = _field(dom, _DOM, is_dom=True)
+    weekdays, dow_specials, weekdays_free = _field(dow, _DOW, is_dow=True)
+    return _Plan(
+        minutes=frozenset(minutes),
+        hours=frozenset(hours),
+        months=frozenset(months),
+        days=frozenset(days),
+        last_day=("L",) in dom_specials,
+        weekdays=frozenset(v % 7 for v in weekdays),
+        last_weekdays=frozenset(s[1] for s in dow_specials if s[0] == "NL"),
+        nth=frozenset((s[1], s[2]) for s in dow_specials if s[0] == "NTH"),
+        days_free=days_free,
+        weekdays_free=weekdays_free,
+    )
+
+
+def _day_ok(plan, year, month, day):
+    last = calendar.monthrange(year, month)[1]
+    weekday = datetime.date(year, month, day).isoweekday() % 7
+    dom_hit = day in plan.days or (plan.last_day and day == last)
+    dow_hit = (
+        weekday in plan.weekdays
+        or (weekday in plan.last_weekdays and day + 7 > last)
+        or (weekday, (day - 1) // 7 + 1) in plan.nth
+    )
+    if plan.days_free and plan.weekdays_free:
+        return True
+    if not plan.days_free and not plan.weekdays_free:
+        return dom_hit or dow_hit
+    if not plan.days_free:
+        return dom_hit
+    return dow_hit
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    plan = _parse(expr)
+    return (
+        when.minute in plan.minutes
+        and when.hour in plan.hours
+        and when.month in plan.months
+        and _day_ok(plan, when.year, when.month, when.day)
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    plan = _parse(expr)
+    try:
+        limit = after + datetime.timedelta(days=20 * 365)
+    except OverflowError:
+        limit = datetime.datetime.max
+    t = after.replace(second=0, microsecond=0) + datetime.timedelta(minutes=1)
+    try:
+        while t <= limit:
+            if t.month not in plan.months:
+                year, month = (t.year + 1, 1) if t.month == 12 else (t.year, t.month + 1)
+                t = datetime.datetime(year, month, 1)
+            elif not _day_ok(plan, t.year, t.month, t.day):
+                t = t.replace(hour=0, minute=0) + datetime.timedelta(days=1)
+            elif t.hour not in plan.hours:
+                t = t.replace(minute=0) + datetime.timedelta(hours=1)
+            elif t.minute not in plan.minutes:
+                t += datetime.timedelta(minutes=1)
+            else:
+                return t
+    except (OverflowError, ValueError):
+        pass
+    return None
