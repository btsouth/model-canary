 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+
+
+def _parse_field(raw, index):
+    lo, hi = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)][index]
+    if index in (2, 4) and raw == "?":
+        raw = "*"
+    if "?" in raw and not (index in (2, 4) and raw == "*"):
+        raise ValueError("invalid ?")
+    values, special = set(), set()
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == 2 and item == "L":
+            special.add(("last_dom",))
+            continue
+        if index == 4 and re.fullmatch(r"\d+[L]", item):
+            n = int(item[:-1])
+            if not 0 <= n <= 7: raise ValueError("day out of range")
+            special.add(("last_dow", n % 7)); continue
+        if index == 4 and re.fullmatch(r"\d+#\d+", item):
+            n, k = map(int, item.split("#"))
+            if not 0 <= n <= 7 or not 1 <= k <= 5: raise ValueError("day occurrence out of range")
+            special.add(("nth_dow", n % 7, k)); continue
+        if "#" in item or ("L" in item): raise ValueError("invalid special item")
+        bits = item.split("/")
+        if len(bits) > 2 or (len(bits) == 2 and (not bits[1].isdigit() or int(bits[1]) < 1)):
+            raise ValueError("invalid step")
+        base = bits[0]
+        if len(bits) == 2 and not base.isdigit() and base != "*":
+            raise ValueError("names are not allowed with steps")
+        if base == "*": seq = list(range(lo, hi + 1))
+        else:
+            sep = re.fullmatch(r"([^\-]+)-([^\-]+)", base)
+            def val(s):
+                if s.isdigit(): return int(s)
+                if index == 3 and s.upper() in _MONTHS: return _MONTHS[s.upper()]
+                if index == 4 and s.upper() in _DAYS: return _DAYS[s.upper()]
+                raise ValueError("invalid value")
+            if sep:
+                a, b = val(sep.group(1)), val(sep.group(2))
+                if a < lo or b > hi or a > b: raise ValueError("range out of bounds")
+                seq = list(range(a, b + 1))
+            else:
+                n = val(base)
+                if not lo <= n <= hi: raise ValueError("value out of bounds")
+                seq = list(range(n, hi + 1)) if len(bits) == 2 else [n]
+        if len(bits) == 2: seq = seq[::int(bits[1])]
+        values.update(seq)
+    return values, special
+
+
+def _compile(expr):
+    if not isinstance(expr, str): raise ValueError("expression must be text")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        try: stripped = _SHORTCUTS[stripped.lower()]
+        except KeyError: raise ValueError("unknown shortcut") from None
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5: raise ValueError("expected five fields")
+    parsed = [_parse_field(f, i) for i, f in enumerate(fields)]
+    return parsed, fields
+
+
+def _day_match(parsed, fields, when):
+    dom, domsp = parsed[2]
+    dow, dowsp = parsed[4]
+    dom_un = fields[2] in ("*", "?")
+    dow_un = fields[4] in ("*", "?")
+    dom_ok = when.day in dom or ("last_dom",) in domsp and when.day == calendar.monthrange(when.year, when.month)[1]
+    wd = (when.weekday() + 1) % 7
+    dow_ok = (wd in dow or 0 in dow and wd == 0 or 7 in dow and wd == 0)
+    last = calendar.monthrange(when.year, when.month)[1]
+    for item in dowsp:
+        if item[0] == "last_dow" and item[1] == wd and when.day + 7 > last: dow_ok = True
+        if item[0] == "nth_dow" and item[1] == wd and (when.day - 1) // 7 + 1 == item[2]: dow_ok = True
+    if dom_un and dow_un: return True
+    if dom_un: return dow_ok
+    if dow_un: return dom_ok
+    return dom_ok or dow_ok
+
 
