 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (low, high, names mapping upper-case name to value)
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays,
+                 last_weekdays, nth_weekdays, dom_restricted, dow_restricted):
+        self.minutes = sorted(minutes)
+        self.minute_set = set(minutes)
+        self.hours = sorted(hours)
+        self.hour_set = set(hours)
+        self.days = days
+        self.last_day = last_day
+        self.months = months
+        self.weekdays = weekdays
+        self.last_weekdays = last_weekdays
+        self.nth_weekdays = nth_weekdays
+        self.dom_restricted = dom_restricted
+        self.dow_restricted = dow_restricted
+
+    def _dom_ok(self, date, month_length):
+        return date.day in self.days or (self.last_day and date.day == month_length)
+
+    def _dow_ok(self, date, month_length):
+        weekday = (date.weekday() + 1) % 7
+        if weekday in self.weekdays:
+            return True
+        if weekday in self.last_weekdays and date.day + 7 > month_length:
+            return True
+        return (weekday, (date.day - 1) // 7 + 1) in self.nth_weekdays
+
+    def day_ok(self, date):
+        if date.month not in self.months:
+            return False
+        month_length = calendar.monthrange(date.year, date.month)[1]
+        if self.dom_restricted and self.dow_restricted:
+            return self._dom_ok(date, month_length) or self._dow_ok(date, month_length)
+        if self.dom_restricted:
+            return self._dom_ok(date, month_length)
+        if self.dow_restricted:
+            return self._dow_ok(date, month_length)
+        return True
+
+
+def _value(text, field):
+    low, high, names = _FIELDS[field]
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range")
+    return value
+
+
+def _parse_field(text, field, sched):
+    """Parse one field, filling sched (a dict of sets) and returning the plain values."""
+    low, high, _ = _FIELDS[field]
+    values = set()
+    if text == "?":
+        if field not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(range(low, high + 1))
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if field == _DOM and item == "L":
+            sched["last_day"] = True
+            continue
+        if field == _DOW:
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                sched["last_weekdays"].add(_value(match.group(1), _DOW) % 7)
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                weekday = _value(match.group(1), _DOW) % 7
+                nth = int(match.group(2))
+                if not 1 <= nth <= 5:
+                    raise ValueError(f"bad week number in {item!r}")
+                sched["nth_weekdays"].add((weekday, nth))
+                continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1 in {item!r}")
+        else:
+            step = 1
+        if base == "*":
+            start, stop = low, high
+        elif "-" in base:
+            first, _, last = base.partition("-")
+            start, stop = _value(first, field), _value(last, field)
+            if start > stop:
+                raise ValueError(f"backwards range {item!r}")
+        else:
+            start = _value(base, field)
+            stop = high if slash else start
+        values.update(range(start, stop + 1, step))
+    return values
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    extra = {"last_day": False, "last_weekdays": set(), "nth_weekdays": set()}
+    minutes = _parse_field(parts[_MINUTE], _MINUTE, extra)
+    hours = _parse_field(parts[_HOUR], _HOUR, extra)
+    days = _parse_field(parts[_DOM], _DOM, extra)
+    months = _parse_field(parts[_MONTH], _MONTH, extra)
+    weekdays = {d % 7 for d in _parse_field(parts[_DOW], _DOW, extra)}
+    return _Schedule(
+        minutes, hours, days, extra["last_day"], months, weekdays,
+        extra["last_weekdays"], extra["nth_weekdays"],
+        parts[_DOM] not in ("*", "?"), parts[_DOW] not in ("*", "?"),
+    )
 
 
