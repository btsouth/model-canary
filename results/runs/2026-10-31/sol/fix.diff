 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from bisect import bisect_left
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name: i for i, name in enumerate(
+    'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)}
+_DAYS = {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal number')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+    unrestricted = text in ('*', '?')
+    if text == '?' and index in (2, 4):
+        text = '*'
+
+    def value(token):
+        number = names[token.upper()] if token.upper() in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError('value outside field range')
+        return number
+
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        if index == 4:
+            match = re.fullmatch(r'([0-9]+)(L|#[0-9]+)', item)
+            if match:
+                day = value(match[1]) % 7
+                if match[2] == 'L':
+                    special.append(('last', day))
+                else:
+                    occurrence = _number(match[2][1:])
+                    if not 1 <= occurrence <= 5:
+                        raise ValueError('invalid weekday occurrence')
+                    special.append(('nth', day, occurrence))
+                continue
+        parts = item.split('/')
+        if len(parts) > 2:
+            raise ValueError('invalid step')
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        base = parts[0]
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            ends = base.split('-')
+            if len(ends) != 2:
+                raise ValueError('invalid range')
+            start, end = map(value, ends)
+        else:
+            start = value(base)
+            end = high if len(parts) == 2 else start
+        if start > end:
+            raise ValueError('descending range')
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {day % 7 for day in values}
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(field, i) for i, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or bool(dom[1]) and day.day == last_day
+    dow_match = weekday in dow[0] or any(
+        weekday == item[1] and (
+            day.day + 7 > last_day if item[0] == 'last'
+            else (day.day - 1) // 7 + 1 == item[2])
+        for item in dow[1])
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
