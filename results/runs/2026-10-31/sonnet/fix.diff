 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_NUM = re.compile(r"[0-9]+\Z")
+_NL = re.compile(r"([0-9]+)[Ll]\Z")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)\Z")
+
+
+def _value(text, lo, hi, names):
+    if _NUM.match(text):
+        n = int(text)
+    elif names and text.upper() in names:
+        n = names.index(text.upper()) + (1 if names is _MONTHS else 0)
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not lo <= n <= hi:
+        raise ValueError(f"value out of range: {text!r}")
+    return n
+
+
+def _field(text, lo, hi, names=None, kind=None):
+    """Return (values, extras) for one field; extras are special day rules."""
+    if kind and text == "?":
+        text = "*"
+    values, extras = set(), []
+    for item in text.split(","):
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.match(step) or int(step) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step)
+        else:
+            step = 1
+        if base == "*":
+            listed = list(range(lo, hi + 1))
+        elif kind == "dom" and base.upper() == "L":
+            listed = [("L",)]
+        elif kind == "dow" and _NL.match(base):
+            listed = [("L", _value(_NL.match(base).group(1), 0, 7, None) % 7)]
+        elif kind == "dow" and _NTH.match(base):
+            m = _NTH.match(base)
+            k = int(m.group(2))
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad occurrence: {item!r}")
+            listed = [("N", _value(m.group(1), 0, 7, None) % 7, k)]
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a > b:
+                raise ValueError(f"descending range: {item!r}")
+            listed = list(range(a, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            listed = list(range(a, hi + 1)) if sep else [a]
+        for v in listed[::step]:
+            if isinstance(v, tuple):
+                extras.append(v)
+            else:
+                values.add(v)
+    return values, extras
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    mi, ho, dom, mo, dow = parts
+    minutes, _ = _field(mi, 0, 59)
+    hours, _ = _field(ho, 0, 23)
+    doms, dom_x = _field(dom, 1, 31, kind="dom")
+    months, _ = _field(mo, 1, 12, _MONTHS)
+    dows, dow_x = _field(dow, 0, 7, _DAYS, kind="dow")
+    dows = {d % 7 for d in dows}
+    times = sorted(h * 60 + m for h in hours for m in minutes)
+    return (times, months, (doms, bool(dom_x)), (dows, dow_x),
+            dom not in ("*", "?"), dow not in ("*", "?"))
+
+
+def _day_ok(p, d):
+    _, months, (doms, last), (dows, dow_x), dom_r, dow_r = p
+    if d.month not in months:
+        return False
+    if not dom_r and not dow_r:
+        return True
+    mlen = calendar.monthrange(d.year, d.month)[1]
+    dom_ok = d.day in doms or (last and d.day == mlen)
+    wd = (d.weekday() + 1) % 7
+    dow_ok = wd in dows
+    for x in dow_x:
+        if x[1] != wd:
+            continue
+        if x[0] == "L" and d.day + 7 > mlen:
+            dow_ok = True
+        elif x[0] == "N" and (d.day - 1) // 7 + 1 == x[2]:
+            dow_ok = True
+    if dom_r and dow_r:
+        return dom_ok or dow_ok
+    return dom_ok if dom_r else dow_ok
 
 
