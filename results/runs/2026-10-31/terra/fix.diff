 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if i}
+_DAYS = dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    fields = []
+    specials = [[], []]
+    for index, part in enumerate(parts):
+        low, high = _BOUNDS[index]
+        values = set()
+        if part == '?' and index in (2, 4):
+            part = '*'
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if token.upper() in names:
+                value = names[token.upper()]
+            elif re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            else:
+                raise ValueError('invalid value')
+            if not low <= value <= high:
+                raise ValueError('out of range')
+            return value
+        for item in part.split(','):
+            if index == 2 and item == 'L':
+                specials[0].append(('last',))
+                continue
+            match = re.fullmatch(r'([0-9]+)L|([0-9]+)#([0-9]+)', item) if index == 4 else None
+            if match:
+                if match.group(1) is not None:
+                    n = int(match.group(1))
+                    if n > 7:
+                        raise ValueError('out of range')
+                    specials[1].append(('last', n % 7))
+                else:
+                    n, k = int(match.group(2)), int(match.group(3))
+                    if n > 7 or not 1 <= k <= 5:
+                        raise ValueError('out of range')
+                    specials[1].append(('nth', n % 7, k))
+                continue
+            bits = item.split('/')
+            if len(bits) > 2 or not bits[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(bits) == 2:
+                if not re.fullmatch(r'[0-9]+', bits[1]) or int(bits[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(bits[1])
+            base = bits[0]
+            if base == '*':
+                start, end = low, high
+            elif '-' in base:
+                bounds = base.split('-')
+                if len(bounds) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, bounds)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = high if len(bits) == 2 else start
+            values.update(range(start, end + 1, step))
+        if index == 4 and 7 in values:
+            values.add(0)
+            values.remove(7)
+        fields.append(values)
+    return fields, specials, (parts[2] in ('*', '?'), parts[4] in ('*', '?'))
+
+
+def _day_matches(date, fields, specials, unrestricted):
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dom = date.day in fields[2] or (date.day == last and bool(specials[0]))
+    dow = weekday in fields[4] or any(
+        weekday == item[1] and (date.day + 7 > last if item[0] == 'last' else (date.day - 1) // 7 + 1 == item[2])
+        for item in specials[1])
+    if unrestricted[0] and unrestricted[1]:
+        return True
+    if unrestricted[0]:
+        return dow
+    if unrestricted[1]:
+        return dom
+    return dom or dow
+
 
