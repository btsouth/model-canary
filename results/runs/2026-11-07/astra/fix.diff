 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, low, high, names=None):
+    if names and token in names:
+        value = names[token]
+    elif re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    else:
+        raise ValueError(f"invalid value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    values, special = set(), []
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if item == "L" and index == 2:
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if index == 4 and (last or nth):
+            weekday = _number((last or nth)[1], 0, 7) % 7
+            special.append(("last", weekday) if last else
+                           ("nth", weekday, _number(nth[2], 1, 5)))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError(f"invalid step: {item!r}")
+            step = int(pieces[1])
+        maximum = 6 if index == 4 else high
+        if base == "*":
+            ordered = list(range(low, maximum + 1))
+        else:
+            endpoints = base.split("-")
+            if len(endpoints) not in (1, 2):
+                raise ValueError(f"invalid range: {item!r}")
+            endpoints = [_number(token, low, high, names) for token in endpoints]
+            if index == 4:
+                endpoints = [value % 7 for value in endpoints]
+            start = endpoints[0]
+            end = endpoints[1] if len(endpoints) == 2 else (
+                maximum if len(pieces) == 2 else start)
+            ordered = (list(range(start, end + 1)) if start <= end else
+                       list(range(start, maximum + 1)) + list(range(low, end + 1)))
+        values.update(ordered[::step])
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    dow, dow_special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    return weekday in dow or any(
+        weekday == rule[1] and (
+            day.day + 7 > last if rule[0] == "last" else
+            (day.day - 1) // 7 + 1 == rule[2])
+        for rule in dow_special)
+
 
