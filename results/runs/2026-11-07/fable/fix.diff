 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (min, max, names -> value) for the five fields
+_SPECS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_HASH = re.compile(r"([0-9]+)#([0-9]+)")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+def _value(token, field, allow_names=True):
+    lo, hi, names = _SPECS[field]
+    if _DIGITS.fullmatch(token):
+        v = int(token)
+    elif allow_names and names is not None and token.upper() in names:
+        v = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value {token!r} out of range")
+    return v
+
+
+def _base_values(base, field):
+    """Values listed by '*', 'N' or 'A-B', in order."""
+    lo, hi, _ = _SPECS[field]
+    if base == "*":
+        return list(range(lo, hi + 1))
+    if "-" in base:
+        a_text, b_text = base.split("-", 1)
+        a = _value(a_text, field)
+        b = _value(b_text, field)
+        if field == _DOW:
+            a %= 7
+            b %= 7
+            hi = 6
+        if a <= b:
+            return list(range(a, b + 1))
+        return list(range(a, hi + 1)) + list(range(lo, b + 1))
+    v = _value(base, field)
+    return [v]
+
+
+class _Field:
+    def __init__(self):
+        self.values = set()
+        self.any = False
+        self.last_dom = False
+        self.last_dow = set()
+        self.nth_dow = set()
+
+    def __contains__(self, v):
+        return self.any or v in self.values
+
+
+def _parse_field(text, field):
+    result = _Field()
+    if text == "?":
+        if field not in (_DOM, _DOW):
+            raise ValueError("'?' only allowed in day fields")
+        result.any = True
+        return result
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if field == _DOM and item == "L":
+            result.last_dom = True
+            continue
+        if field == _DOW:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                result.last_dow.add(_value(m.group(1), field, False) % 7)
+                continue
+            m = _HASH.fullmatch(item)
+            if m:
+                n = _value(m.group(1), field, False) % 7
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad '#' count in {item!r}")
+                result.nth_dow.add((n, k))
+                continue
+        base, step = item, 1
+        if "/" in item:
+            base, step_text = item.split("/", 1)
+            if not _DIGITS.fullmatch(step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1 in {item!r}")
+            if base != "*" and "-" not in base:
+                # N/S lists N up to the field's maximum.
+                lo, hi, _ = _SPECS[field]
+                start = _value(base, field)
+                listed = list(range(start, hi + 1))
+                result.values.update(listed[::step])
+                continue
+        listed = _base_values(base, field)
+        result.values.update(listed[::step])
+    if field == _DOW:
+        result.values = {v % 7 for v in result.values}
+    if text == "*":
+        result.any = True
+    return result
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.lower() in _SHORTCUTS:
+        text = _SHORTCUTS[text.lower()]
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut {text!r}")
+    parts = re.split(r"[ \t]+", text) if text else []
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}")
+    return [_parse_field(p, i) for i, p in enumerate(parts)]
+
+
+def _cron_dow(date):
+    return (date.weekday() + 1) % 7
+
+
+def _day_allowed(fields, date):
+    dom, dow = fields[_DOM], fields[_DOW]
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    if not dom.any:
+        ok = date.day in dom.values or (dom.last_dom and date.day == days_in_month)
+        if not ok:
+            return False
+    if not dow.any:
+        wd = _cron_dow(date)
+        ok = wd in dow.values
+        if not ok and wd in dow.last_dow and date.day + 7 > days_in_month:
+            ok = True
+        if not ok and (wd, (date.day - 1) // 7 + 1) in dow.nth_dow:
+            ok = True
+        if not ok:
+            return False
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    return (
+        when.minute in fields[_MINUTE]
+        and when.hour in fields[_HOUR]
+        and when.month in fields[_MONTH]
+        and _day_allowed(fields, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    minutes = sorted(fields[_MINUTE].values if not fields[_MINUTE].any else range(60))
+    hours = sorted(fields[_HOUR].values if not fields[_HOUR].any else range(24))
+    limit = after + _LIMIT
+    start = after.replace(second=0, microsecond=0) + _dt.timedelta(minutes=1)
+    date = start.date()
+    first_day = True
+    one_day = _dt.timedelta(days=1)
+    while date <= limit.date():
+        if date.month not in fields[_MONTH]:
+            # Jump to the first day of the next month.
+            year, month = date.year, date.month + 1
+            if month > 12:
+                year, month = year + 1, 1
+            if year > _dt.MAXYEAR:
+                return None
+            date = _dt.date(year, month, 1)
+            first_day = False
+            continue
+        if _day_allowed(fields, date):
+            for h in hours:
+                for m in minutes:
+                    if first_day and (h, m) < (start.hour, start.minute):
+                        continue
+                    candidate = _dt.datetime(date.year, date.month, date.day, h, m)
+                    if candidate > limit:
+                        return None
+                    return candidate
+        first_day = False
+        if date == _dt.date.max:
+            return None
+        date += one_day
+    return None
