+        elif ch == SEP and not quoted:
+            fields.append(field)
+            field = []
+        else:
+            field.append((ch, quoted))
+        i += 1
+    if quoted:
+        raise ValueError(f"unclosed quote in {text!r}")
+    fields.append(field)
+    return fields
