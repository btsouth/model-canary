 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {"JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+           "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12}
+_DAYS = {"SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6}
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+class _Schedule:
+    """Parsed expression. Day-of-week values are stored modulo 7 (Sunday is 0)."""
+
+    def __init__(self, minute, hour, dom, dom_last, month, dow, dow_last, dow_nth):
+        self.minute = minute
+        self.hour = hour
+        self.dom = dom
+        self.dom_last = dom_last
+        self.month = month
+        self.dow = dow
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+
+
+def _value(tok, names, lo, hi):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names is not None and _NAME.fullmatch(tok) and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value {v} out of range {lo}-{hi}")
+    return v
+
+
+def _parse_field(text, lo, hi, names=None, dom=False, dow=False):
+    """Return (values, last_day, lasts, nths) for one field.
+
+    values: set of matching numbers (dow reduced modulo 7).
+    last_day: True if the field has L (day of month only).
+    lasts: dow numbers N (mod 7) that have an NL item.
+    nths: (N mod 7, K) pairs from N#K items.
+    """
+    values, lasts, nths = set(), set(), set()
+    last_day = False
+    if (dom or dow) and text == "?":
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if dom and item == "L":
+            last_day = True
+            continue
+        if dow:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                lasts.add(_value(m.group(1), None, 0, 7) % 7)
+                continue
+            m = _NTH_DOW.fullmatch(item)
+            if m:
+                n = _value(m.group(1), None, 0, 7) % 7
+                k = _value(m.group(2), None, 1, 5)
+                nths.add((n, k))
+                continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not _NUM.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+        else:
+            step = 1
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            if "-" in b_text:
+                raise ValueError(f"bad range {base!r}")
+            a = _value(a_text, names, lo, hi)
+            b = _value(b_text, names, lo, hi)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif dow:
+                seq = list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, names, lo, hi)
+            seq = list(range(a, hi + 1)) if slash else [a]
+        seq = seq[::step]
+        values.update(v % 7 if dow else v for v in seq)
+    return values, last_day, lasts, nths
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    shortcut = _SHORTCUTS.get(text.lower())
+    if shortcut is not None:
+        text = shortcut
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut {expr!r}")
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)} in {expr!r}")
+    minute = _parse_field(parts[0], 0, 59)[0]
+    hour = _parse_field(parts[1], 0, 23)[0]
+    dom, dom_last, _, _ = _parse_field(parts[2], 1, 31, dom=True)
+    month = _parse_field(parts[3], 1, 12, names=_MONTHS)[0]
+    dow, _, dow_last, dow_nth = _parse_field(parts[4], 0, 7, names=_DAYS, dow=True)
+    return _Schedule(minute, hour, dom, dom_last, month, dow, dow_last, dow_nth)
+
+
+def _day_ok(s, day):
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in s.dom or (s.dom_last and day.day == days_in_month)
+    cron_dow = (day.weekday() + 1) % 7
+    nth = (day.day - 1) // 7 + 1
+    dow_ok = (
+        cron_dow in s.dow
+        or (cron_dow in s.dow_last and day.day + 7 > days_in_month)
+        or (cron_dow, nth) in s.dow_nth
+    )
+    return bool(dom_ok and dow_ok)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
