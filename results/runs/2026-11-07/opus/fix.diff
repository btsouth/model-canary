 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+from functools import lru_cache
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+     "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], start=1)}
+_DAYS = {name: i for i, name in enumerate(
+    ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (minimum, maximum, names) for each field, in expression order.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+def _is_number(text):
+    return text.isascii() and text.isdigit()
+
+
+def _number(text, low, high):
+    if not _is_number(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _value(text, index):
+    low, high, names = _FIELDS[index]
+    if names is not None and text.upper() in names and text.isalpha():
+        return names[text.upper()]
+    return _number(text, low, high)
+
+
+def _item_values(item, index):
+    """The values listed by a plain item (*, N, A-B, optionally with /S), in order."""
+    low, high, _ = _FIELDS[index]
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _is_number(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step must be at least 1: {item!r}")
+    else:
+        step = 1
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        first_text, _, last_text = base.partition("-")
+        first = _value(first_text, index)
+        last = _value(last_text, index)
+        if first <= last:
+            values = list(range(first, last + 1))
+        elif index == _DOW:
+            first, last = first % 7, last % 7
+            values = [first]
+            while values[-1] != last:
+                values.append((values[-1] + 1) % 7)
+        else:
+            values = list(range(first, high + 1)) + list(range(low, last + 1))
+    else:
+        first = _value(base, index)
+        values = list(range(first, high + 1)) if slash else [first]
+    values = values[::step]
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    return values
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"expression must be a string: {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            lowered = text.lower()
+            if lowered not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            text = _SHORTCUTS[lowered]
+        parts = re.split(r"[ \t]+", text)
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields: {expr!r}")
+        self.sets = [set() for _ in range(5)]
+        self.any_day = [False] * 5
+        self.last_dom = False
+        self.last_dow = set()    # weekdays N for NL
+        self.nth_dow = set()     # (weekday, K) pairs for N#K
+        for index, part in enumerate(parts):
+            if part in ("*", "?"):
+                if part == "?" and index not in (_DOM, _DOW):
+                    raise ValueError(f"'?' is only allowed in day fields: {expr!r}")
+                self.any_day[index] = True
+            for item in part.split(","):
+                self._add_item(item, index, part)
+        self.minutes = sorted(self.sets[_MINUTE])
+        self.hours = sorted(self.sets[_HOUR])
+        self.months = self.sets[_MONTH]
+        self._day_cache = {}
+
+    def _add_item(self, item, index, part):
+        if not item:
+            raise ValueError(f"empty item in {part!r}")
+        if item == "?":
+            if part != "?":
+                raise ValueError(f"'?' must be a whole field: {part!r}")
+            item = "*"
+        if index == _DOM and item == "L":
+            self.last_dom = True
+            return
+        if index == _DOW and item.endswith("L") and _is_number(item[:-1]):
+            self.last_dow.add(_number(item[:-1], 0, 7) % 7)
+            return
+        if index == _DOW and "#" in item:
+            day_text, _, nth_text = item.partition("#")
+            day = _number(day_text, 0, 7) % 7
+            nth = _number(nth_text, 1, 5)
+            self.nth_dow.add((day, nth))
+            return
+        self.sets[index].update(_item_values(item, index))
+
+    def day_allowed(self, day, weekday, month_length):
+        """weekday uses 0 for Sunday."""
+        dom_ok = (self.any_day[_DOM] or day in self.sets[_DOM]
+                  or (self.last_dom and day == month_length))
+        if not dom_ok:
+            return False
+        return (self.any_day[_DOW] or weekday in self.sets[_DOW]
+                or (weekday in self.last_dow and day + 7 > month_length)
+                or (weekday, (day - 1) // 7 + 1) in self.nth_dow)
+
+    def allowed_days(self, year, month):
+        first_weekday, length = calendar.monthrange(year, month)
+        key = (first_weekday, length)
+        days = self._day_cache.get(key)
+        if days is None:
+            sunday_based = (first_weekday + 1) % 7
+            days = [d for d in range(1, length + 1)
+                    if self.day_allowed(d, (sunday_based + d - 1) % 7, length)]
+            self._day_cache[key] = days
+        return days
+
+    def matches(self, when):
+        if when.minute not in self.sets[_MINUTE] or when.hour not in self.sets[_HOUR]:
+            return False
+        if when.month not in self.months:
+            return False
+        length = calendar.monthrange(when.year, when.month)[1]
+        return self.day_allowed(when.day, (when.weekday() + 1) % 7, length)
+
+    def first_time(self, hour, minute):
+        """The first (hour, minute) of the schedule at or after hour:minute, or None."""
+        for h in self.hours:
+            if h < hour:
+                continue
+            for m in self.minutes:
+                if h > hour or m >= minute:
+                    return h, m
+        return None
+
+
+@lru_cache(maxsize=256)
+def _parse(expr):
+    return _Schedule(expr)
+
+
+def _schedule(expr):
+    try:
+        return _parse(expr)
+    except TypeError:  # unhashable expression
+        raise ValueError(f"expression must be a string: {expr!r}") from None
 
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _schedule(expr).matches(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    sched = _schedule(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + _dt.timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _LIMIT
+    except OverflowError:
+        limit = _dt.datetime.max
+    year, month = start.year, start.month
+    while (year, month) <= (limit.year, limit.month):
+        if month in sched.months:
+            for day in sched.allowed_days(year, month):
+                if (year, month, day) < (start.year, start.month, start.day):
+                    continue
+                if (year, month, day) == (start.year, start.month, start.day):
+                    found = sched.first_time(start.hour, start.minute)
+                else:
+                    found = sched.first_time(0, 0)
