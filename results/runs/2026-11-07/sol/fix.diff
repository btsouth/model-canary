 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError("expected decimal digits")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def endpoint(token):
+        value = names[token] if token in names else _number(token)
+        if not low <= value <= high:
+            raise ValueError("value outside field range")
+        return value
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if item == "L" and index == 2:
+            special.append(("last",))
+            continue
+        match = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if match and index == 4:
+            weekday = endpoint(match[1]) % 7
+            if match[2] == "L":
+                special.append(("last_weekday", weekday))
+            else:
+                ordinal = _number(match[3])
+                if not 1 <= ordinal <= 5:
+                    raise ValueError("invalid weekday ordinal")
+                special.append(("nth", weekday, ordinal))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = pieces[0]
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError("invalid range")
+            first, last = map(endpoint, ends)
+            if first <= last:
+                sequence = list(range(first, last + 1))
+            elif index == 4:
+                first, last = first % 7, last % 7
+                sequence = [first]
+                while sequence[-1] != last:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(first, high + 1)) + list(range(low, last + 1))
+        else:
+            first = endpoint(base)
+            sequence = list(range(first, high + 1)) if len(pieces) == 2 else [first]
+        values.update(value % 7 if index == 4 else value for value in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_matches(fields, date):
+    if date.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom, dom_special = fields[2]
+    if date.day not in dom and not (dom_special and date.day == last):
+        return False
+    dow, dow_special = fields[4]
+    weekday = (date.weekday() + 1) % 7
+    return weekday in dow or any(
+        weekday == rule[1] and (
+            date.day + 7 > last if rule[0] == "last_weekday"
+            else (date.day - 1) // 7 + 1 == rule[2]
+        ) for rule in dow_special)
+
 
