 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "jan feb mar apr may jun jul aug sep oct nov dec".split())}
+_DAYS = {n: i for i, n in enumerate("sun mon tue wed thu fri sat".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _bad(msg):
+    raise ValueError(msg)
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names is not None and tok.lower() in names:
+        v = names[tok.lower()]
+    else:
+        _bad(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        _bad(f"value out of range {tok!r}")
+    return v
+
+
+def _parse_field(text, lo, hi, names, kind):
+    """kind: 'plain', 'dom' or 'dow'. Returns (set, extras)."""
+    values, extras = set(), []
+    if text == "?":
+        if kind == "plain":
+            _bad("? not allowed here")
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            _bad("empty item")
+        if kind == "dom" and item in ("L", "l"):
+            extras.append("L")
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)[lL]", item)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    _bad("bad day of week")
+                extras.append(("L", n % 7))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if n > 7 or not 1 <= k <= 5:
+                    _bad("bad N#K")
+                extras.append(("#", n % 7, k))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            _bad("bad step")
+        base = parts[0]
+        step = None
+        if len(parts) == 2:
+            if not _NUM.fullmatch(parts[1]) or int(parts[1]) < 1:
+                _bad("bad step")
+            step = int(parts[1])
+            if base != "*" and not re.fullmatch(r"[0-9]+(-[0-9]+)?", base):
+                _bad("names not allowed in a step")
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+            if kind == "dow":
+                seq = list(range(0, 7))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a = _value(a, lo, hi, names)
+            b = _value(b, lo, hi, names)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif kind == "dow":
+                seq = list(range(a, 7)) + list(range(0, b + 1))
+                if a == 7:
+                    seq = list(range(0, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            seq = [a] if step is None else list(range(a, hi + 1))
+        if step:
+            seq = seq[::step]
+        values.update(seq)
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, extras
+
+
+class _Spec:
+    pass
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORTCUTS.get(expr.lower())
+        if expr is None:
+            _bad("unknown shortcut")
+    toks = re.split(r"[ \t]+", expr)
+    if len(toks) != 5:
+        _bad("need five fields")
+    s = _Spec()
+    s.minutes, _ = _parse_field(toks[0], 0, 59, None, "plain")
+    s.hours, _ = _parse_field(toks[1], 0, 23, None, "plain")
+    s.dom, s.dom_extra = _parse_field(toks[2], 1, 31, None, "dom")
+    s.months, _ = _parse_field(toks[3], 1, 12, _MONTHS, "plain")
+    s.dow, s.dow_extra = _parse_field(toks[4], 0, 7, _DAYS, "dow")
+    s.minutes_l = sorted(s.minutes)
+    s.hours_l = sorted(s.hours)
+    return s
+
+
+def _day_ok(s, d, cache):
+    key = (d.year, d.month)
+    mlen = cache.get(key)
+    if mlen is None:
+        mlen = cache[key] = calendar.monthrange(d.year, d.month)[1]
+    if d.month not in s.months:
+        return False
+    if not (d.day in s.dom or ("L" in s.dom_extra and d.day == mlen)):
+        return False
+    wd = (d.weekday() + 1) % 7
+    if wd in s.dow:
+        return True
+    for e in s.dow_extra:
+        if e[1] != wd:
+            continue
+        if e[0] == "L":
+            if d.day + 7 > mlen:
+                return True
+        elif (d.day - 1) // 7 + 1 == e[2]:
+            return True
+    return False
 
 
