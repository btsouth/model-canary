 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7)))
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))[index]
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(token):
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in names:
+                value = names[token.upper()]
+            else:
+                raise ValueError('invalid value')
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])L|([0-7])#([1-5])', item) if index == 4 else None
+            if match:
+                special.append(('last_weekday', int(match[1]) % 7) if match[1] is not None
+                               else ('nth', int(match[2]) % 7, int(match[3])))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            else:
+                step = 1
+            base = pieces[0]
+            if base == '*':
+                sequence = list(range(low, high + 1))
+            elif '-' in base:
+                endpoints = base.split('-')
+                if len(endpoints) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, endpoints)
+                if index == 4:
+                    # Sunday has two spellings; preserve 0-7 as a full range.
+                    if start <= end:
+                        sequence = list(range(start, end + 1))
+                    else:
+                        start %= 7
+                        end %= 7
+                        sequence = [start]
+                        while sequence[-1] != end:
+                            sequence.append((sequence[-1] + 1) % 7)
+                else:
+                    sequence = (list(range(start, end + 1)) if start <= end else
+                                list(range(start, high + 1)) + list(range(low, end + 1)))
+            else:
+                start = number(base)
+                sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+            values.update((v % 7 if index == 4 else v) for v in sequence[::step])
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(schedule, day):
+    weekday = (day.weekday() + 1) % 7
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = schedule[2]
+    dow, dow_special = schedule[4]
+    return ((day.day in dom or (dom_special and day.day == last)) and
+            (weekday in dow or any(
+                (s[0] == 'last_weekday' and weekday == s[1] and day.day + 7 > last) or
+                (s[0] == 'nth' and weekday == s[1] and (day.day - 1) // 7 + 1 == s[2])
+                for s in dow_special)))
+
 
