 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), range(1, 13)))
+_DAYS = dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7)))
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError(f'invalid number: {text!r}')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _LIMITS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+    unrestricted = index in (2, 4) and text in ('*', '?')
+    if text == '?' and index in (2, 4):
+        text = '*'
+
+    def value(token):
+        n = names[token] if token in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError(f'value outside field range: {token!r}')
+        return n
+
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        last = re.fullmatch(r'([0-9]+)L', item) if index == 4 else None
+        nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item) if index == 4 else None
+        if last:
+            special.append(('last_weekday', value(last[1]) % 7))
+            continue
+        if nth:
+            occurrence = _number(nth[2])
+            if not 1 <= occurrence <= 5:
+                raise ValueError('weekday occurrence must be between 1 and 5')
+            special.append(('nth_weekday', value(nth[1]) % 7, occurrence))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('invalid step')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            bounds = base.split('-')
+            if len(bounds) != 2:
+                raise ValueError('invalid range')
+            start, end = map(value, bounds)
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError('reversed range')
+        values.update(n % 7 if index == 4 else n for n in range(start, end + 1, step))
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('a schedule needs five fields')
+    return tuple(_field(field, i) for i, field in enumerate(fields))
+
+
+def _day_matches(fields, day):
+    dom, dom_special, dom_free = fields[2]
+    dow, dow_special, dow_free = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    dom_match = day.day in dom
+    dow_match = weekday in dow
+    if dom_special or dow_special:
+        last = calendar.monthrange(day.year, day.month)[1]
+        dom_match |= bool(dom_special) and day.day == last
+        for rule in dow_special:
+            if weekday == rule[1]:
+                if rule[0] == 'last_weekday':
+                    dow_match |= day.day + 7 > last
+                else:
+                    dow_match |= (day.day - 1) // 7 + 1 == rule[2]
+    if dom_free:
+        return dow_free or dow_match
+    if dow_free:
+        return dom_match
+    return dom_match or dow_match
+
 
