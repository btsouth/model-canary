 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import datetime
+import re
+
+_NUMBER = re.compile(r"[0-9]+")
+_SPLIT = re.compile(r"[ \t]+")
+
+_ORDER = ("minute", "hour", "day of month", "month", "day of week")
+
+_MONTHS = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+_WEEKDAYS = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _value(token, low, high, names, label):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r} in {label} field")
+    if not low <= value <= high:
+        raise ValueError(f"value {token!r} out of range in {label} field")
+    return value
+
+
+def _field(text, low, high, label, names=None, question=False,
+           last_day=False, dow_special=False):
+    if text == "*" or (question and text == "?"):
+        return {
+            "values": set(range(low, high + 1)),
+            "restricted": False,
+            "last_day": False,
+            "last_weekdays": set(),
+            "nth": set(),
+        }
+
+    result = {
+        "values": set(),
+        "restricted": True,
+        "last_day": False,
+        "last_weekdays": set(),
+        "nth": set(),
+    }
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {label} field")
+
+        if item == "L":
+            if not last_day:
+                raise ValueError(f"'L' not allowed in {label} field")
+            result["last_day"] = True
+            continue
+
+        if dow_special:
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                day = int(match.group(1))
+                if not 0 <= day <= 7:
+                    raise ValueError(f"value {item!r} out of range in {label} field")
+                result["last_weekdays"].add(0 if day == 7 else day)
+                continue
+
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                day, occurrence = int(match.group(1)), int(match.group(2))
+                if not 0 <= day <= 7 or not 1 <= occurrence <= 5:
+                    raise ValueError(f"value {item!r} out of range in {label} field")
+                result["nth"].add((0 if day == 7 else day, occurrence))
+                continue
+
+        step = None
+        if "/" in item:
+            if item.count("/") > 1:
+                raise ValueError(f"bad item {item!r} in {label} field")
+            base, step_text = item.split("/")
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step {step_text!r} in {label} field")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step {step_text!r} in {label} field")
+        else:
+            base = item
+
+        if base == "*":
+            values = list(range(low, high + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError(f"bad range {base!r} in {label} field")
+            start_text, end_text = base.split("-")
+            start = _value(start_text, low, high, names, label)
+            end = _value(end_text, low, high, names, label)
+            if start > end:
+                raise ValueError(f"bad range {base!r} in {label} field")
+            values = list(range(start, end + 1))
+        else:
+            start = _value(base, low, high, names, label)
+            values = list(range(start, high + 1)) if step is not None else [start]
+
+        if step is not None:
+            values = values[::step]
+        result["values"].update(values)
+
+    return result
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule")
+
+    shortcut = _SHORTCUTS.get(text.lower())
+    if shortcut is not None:
+        text = shortcut
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {text!r}")
+
+    fields = _SPLIT.split(text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    minute = _field(fields[0], 0, 59, _ORDER[0])
+    hour = _field(fields[1], 0, 23, _ORDER[1])
+    day_of_month = _field(fields[2], 1, 31, _ORDER[2],
+                          question=True, last_day=True)
+    month = _field(fields[3], 1, 12, _ORDER[3], names=_MONTHS)
+    day_of_week = _field(fields[4], 0, 7, _ORDER[4],
+                         names=_WEEKDAYS, question=True, dow_special=True)
+
+    times = sorted(h * 60 + m for h in hour["values"] for m in minute["values"])
+    return {
+        "minute": minute,
+        "hour": hour,
+        "day_of_month": day_of_month,
+        "month": month,
+        "day_of_week": day_of_week,
+        "times": times,
+    }
+
+
+def _day_of_month_matches(field, day):
+    if day.day in field["values"]:
+        return True
+    if field["last_day"]:
+        return day.day == calendar.monthrange(day.year, day.month)[1]
+    return False
+
+
+def _day_of_week_matches(field, day):
+    weekday = (day.weekday() + 1) % 7
+    if weekday in field["values"] or (weekday == 0 and 7 in field["values"]):
+        return True
+
+    if field["last_weekdays"]:
+        last = calendar.monthrange(day.year, day.month)[1]
+        if day.day > last - 7 and weekday in field["last_weekdays"]:
+            return True
+
+    occurrence = (day.day - 1) // 7 + 1
+    return any(weekday == wanted and occurrence == which
+               for wanted, which in field["nth"])
+
+
+def _day_matches(parsed, day):
+    dom = parsed["day_of_month"]
+    dow = parsed["day_of_week"]
+
+    if not dom["restricted"] and not dow["restricted"]:
+        return True
+    if dom["restricted"] and dow["restricted"]:
+        return (_day_of_month_matches(dom, day)
+                or _day_of_week_matches(dow, day))
+    if dom["restricted"]:
+        return _day_of_month_matches(dom, day)
+    return _day_of_week_matches(dow, day)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    parsed = _parse(expr)
+    if when.minute not in parsed["minute"]["values"]:
+        return False
+    if when.hour not in parsed["hour"]["values"]:
+        return False
+    if when.month not in parsed["month"]["values"]:
+        return False
+    return _day_matches(parsed, when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    parsed = _parse(expr)
+    times = parsed["times"]
+
+    try:
+        first = after.replace(second=0, microsecond=0) + datetime.timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + datetime.timedelta(days=20 * 365)
+    except OverflowError:
+        limit = datetime.datetime.max
+
+    day = first.date()
+    first_day = day
+    limit_day = limit.date()
+
+    while day <= limit_day:
+        if day.month in parsed["month"]["values"] and _day_matches(parsed, day):
+            start = first.hour * 60 + first.minute if day == first_day else 0
+            index = bisect.bisect_left(times, start)
+            if index < len(times):
+                minute_of_day = times[index]
+                result = datetime.datetime(
+                    day.year, day.month, day.day,
+                    minute_of_day // 60, minute_of_day % 60,
+                )
+                if result <= limit:
+                    return result
+        if day == datetime.date.max:
+            break
+        day += datetime.timedelta(days=1)
+
+    return None
