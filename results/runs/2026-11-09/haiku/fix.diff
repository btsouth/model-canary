+import math
 from fractions import Fraction
 
 
@@ -16,8 +17,18 @@ def share_out(total, weights):
     """
     if not weights or any(w < 0 for w in weights) or sum(weights) == 0:
         raise ValueError("weights must be non-negative and not all zero")
-    whole = sum(weights)
-    return [round(total * w / whole) for w in weights]
+    sign = -1 if total < 0 else 1
+    total = abs(total)
+    ws = [Fraction(w) for w in weights]
+    whole = sum(ws)
+    exact = [total * w / whole for w in ws]
+    shares = [math.floor(e) for e in exact]
+    leftover = total - sum(shares)
+    # Largest remainder first; ties go to the earlier share.
+    order = sorted(range(len(ws)), key=lambda i: (-(exact[i] - shares[i]), i))
+    for i in order[:leftover]:
+        shares[i] += 1
+    return [sign * s for s in shares]
 
 
