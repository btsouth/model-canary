 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+from collections import namedtuple
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST = re.compile(r"([0-9]+)L")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+
+# dom, dom_x, dom_r: day-of-month values, extra rules, and whether the field restricts days.
+# dow and dow_x: day-of-week values (0-6) and extra rules, normalised so 7 becomes 0.
+_Spec = namedtuple(
+    "_Spec", "minute hour dom dom_x dom_r month dow dow_x dow_r")
+
+
+def _number(text, lo, hi, names):
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _range_item(item, lo, hi, names):
+    """Values listed by one item such as '*', '5', '1-4', '*/15' or '10-30/5'."""
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _NUM.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+    else:
+        step = 1
+    if base == "*":
+        first, last = lo, hi
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        first = _number(a, lo, hi, names)
+        last = _number(b, lo, hi, names)
+        if first > last:
+            raise ValueError(f"range runs backwards: {item!r}")
+    else:
+        first = _number(base, lo, hi, names)
+        last = hi if slash else first
+    return range(first, last + 1, step)
+
+
+def _field(text, lo, hi, names=None, day=None):
+    """Parse one field. Returns (values, extras, restricted)."""
+    restricted = text not in ("*", "?")
+    if day and text == "?":
+        text = "*"
+    values, extras = set(), set()
+    for item in text.split(","):
+        if day == "dom" and item == "L":
+            extras.add(("L", 0))
+            continue
+        if day == "dow":
+            m = _LAST.fullmatch(item)
+            if m:
+                extras.add(("L", _number(m.group(1), 0, 7, None) % 7))
+                continue
+            m = _NTH.fullmatch(item)
+            if m:
+                n = _number(m.group(1), 0, 7, None) % 7
+                k = _number(m.group(2), 1, 5, None)
+                extras.add(("#", n, k))
+                continue
+        values.update(_range_item(item, lo, hi, names))
+    return values, extras, restricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, _, _ = _field(parts[0], 0, 59)
+    hour, _, _ = _field(parts[1], 0, 23)
+    dom, dom_x, dom_r = _field(parts[2], 1, 31, day="dom")
+    month, _, _ = _field(parts[3], 1, 12, names=_MONTHS)
+    dow, dow_x, dow_r = _field(parts[4], 0, 7, names=_DAYS, day="dow")
+    return _Spec(
+        minute=minute, hour=hour, dom=dom, dom_x=dom_x, dom_r=dom_r,
+        month=month, dow={v % 7 for v in dow}, dow_x=dow_x, dow_r=dow_r,
+    )
+
+
+def _day_ok(spec, day):
+    """Whether a run may happen on the given date (the month is checked separately)."""
+    ndays = calendar.monthrange(day.year, day.month)[1]
+    nth = (day.day - 1) // 7 + 1
+    wd = day.isoweekday() % 7
+    dom_m = day.day in spec.dom or (("L", 0) in spec.dom_x and day.day == ndays)
+    dow_m = (
+        wd in spec.dow
+        or (("L", wd) in spec.dow_x and day.day + 7 > ndays)
+        or (("#", wd, nth) in spec.dow_x)
+    )
+    if spec.dom_r and spec.dow_r:
+        return dom_m or dow_m
+    if spec.dom_r:
+        return dom_m
+    if spec.dow_r:
+        return dow_m
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
