 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"))}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORTCUTS.get(expr.lower(), "")
+        if not expr:
+            raise ValueError("unknown shortcut")
+    fields = re.split(r"[ \t]+", expr.strip())
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    limits = [(0,59),(0,23),(1,31),(1,12),(0,7)]
+    result = []
+    originals = []
+    for idx, raw in enumerate(fields):
+        if idx in (2,4) and raw == "?": raw = "*"
+        originals.append(raw)
+        vals, last, nth = set(), False, []
+        if idx == 2 and raw == "L":
+            result.append((set(), True, [])); continue
+        if idx == 4 and raw == "*":
+            result.append((set(range(7)), False, [])); continue
+        for item in raw.split(","):
+            if not item: raise ValueError("empty item")
+            if idx == 4 and re.fullmatch(r"\d+L", item):
+                n=int(item[:-1]);
+                if not 0 <= n <= 7: raise ValueError("day out of range")
+                nth.append(("last", n % 7)); continue
+            if idx == 4 and re.fullmatch(r"\d+#\d+", item):
+                n,k=map(int,item.split("#"))
+                if not 0 <= n <= 7 or not 1 <= k <= 5: raise ValueError("bad nth weekday")
+                nth.append((k,n % 7)); continue
+            base, slash, steptext = item.partition("/")
+            if slash:
+                if not steptext.isdigit() or int(steptext) < 1: raise ValueError("bad step")
+                step=int(steptext)
+            else: step=1
+            if base == "*": lo,hi=limits[idx]
+            elif "-" in base:
+                if base.count("-") != 1: raise ValueError("bad range")
+                a,b=base.split("-")
+                lo=_value(a,idx); hi=_value(b,idx)
+                if lo > hi: raise ValueError("descending range")
+            else:
+                lo=_value(base,idx)
+                if slash: hi=limits[idx][1]
+                else: hi=lo
+            if lo < limits[idx][0] or hi > limits[idx][1]: raise ValueError("value out of range")
+            vals.update(range(lo,hi+1,step))
+        if idx == 4 and 7 in vals: vals.add(0); vals.discard(7)
+        result.append((vals,last,nth))
+    # wildcard-plus-step fields are restricted for classic day logic.
+    restricted = [originals[2] not in ("*", "?"), originals[4] not in ("*", "?")]
+    return result, restricted
+
+
+def _value(s, idx):
+    if idx == 3 and s.upper() in _MONTHS: return _MONTHS[s.upper()]
+    if idx == 4 and s.upper() in _DAYS: return _DAYS[s.upper()]
+    if not s.isdigit(): raise ValueError("invalid value")
+    return int(s)
+
+
+def _day_ok(parsed, restricted, date):
+    dom, dow = parsed[2], parsed[4]
+    dom_match = date.day in dom[0] or (dom[1] and date.day == calendar.monthrange(date.year,date.month)[1])
+    cron_dow = (date.weekday()+1) % 7
+    dow_match = cron_dow in dow[0]
+    for kind, n in dow[2]:
+        if cron_dow == n:
+            if kind == "last":
+                if date.day + 7 > calendar.monthrange(date.year,date.month)[1]: dow_match=True
+            else:
+                if (date.day-1)//7+1 == kind: dow_match=True
+    if restricted[0] and restricted[1]: return dom_match or dow_match
+    if restricted[0]: return dom_match
+    if restricted[1]: return dow_match
+    return True
 
 
