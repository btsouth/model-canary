+    # Convert through decimal spelling for floats so allocation follows their
+    # human supplied decimal values rather than binary approximation.
+    from fractions import Fraction
+    exact = [Fraction(str(w)) if isinstance(w, float) else Fraction(w) for w in weights]
+    whole = sum(exact)
+    sign = -1 if total < 0 else 1
+    amount = abs(total)
+    quotas = [Fraction(amount) * w / whole for w in exact]
+    shares = [q.numerator // q.denominator for q in quotas]
+    left = amount - sum(shares)
+    order = sorted(range(len(weights)), key=lambda i: (-(quotas[i] - shares[i]), i))
+    for i in order[:left]:
+        shares[i] += 1
+    return [sign * n for n in shares]
 
 
