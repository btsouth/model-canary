 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_DIGITS = re.compile(r"[0-9]+")
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "dom", "dom_last", "months",
+                 "dow", "dow_last", "dow_nth", "dom_restricted", "dow_restricted")
+
+
+def _number(text, low, high):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value {value} out of range {low}-{high}")
+    return value
+
+
+def _value(text, low, high, names):
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    return _number(text, low, high)
+
+
+def _item(item, low, high, names):
+    """Values listed by a plain item: *, N, A-B, each optionally with /S."""
+    if not item:
+        raise ValueError("empty item")
+    base, slash, step_text = item.partition("/")
+    if slash:
+        step = _number(step_text, 1, float("inf")) if _DIGITS.fullmatch(step_text) else None
+        if step is None:
+            raise ValueError(f"bad step: {step_text!r}")
+    else:
+        step = 1
+    if base == "*":
+        first, last = low, high
+    elif "-" in base:
+        a, dash, b = base.partition("-")
+        first = _value(a, low, high, names)
+        last = _value(b, low, high, names)
+        if first > last:
+            raise ValueError(f"range {base!r} runs backwards")
+    else:
+        first = _value(base, low, high, names)
+        last = high if slash else first
+    return range(first, last + 1, step)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+
+    sched = _Schedule()
+    sched.dom_last = False
+    sched.dow_last = set()
+    sched.dow_nth = set()
+    sets = []
+    for index, (field, (low, high, names)) in enumerate(zip(parts, _FIELDS)):
+        values = set()
+        if field == "?" and index in (2, 4):
+            sets.append(set(range(low, high + 1)))
+            continue
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                sched.dom_last = True
+                continue
+            if index == 4:
+                m = re.fullmatch(r"([0-9]+)L", item)
+                if m:
+                    sched.dow_last.add(_number(m.group(1), 0, 7) % 7)
+                    continue
+                m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+                if m:
+                    day = _number(m.group(1), 0, 7) % 7
+                    nth = _number(m.group(2), 1, 5)
+                    sched.dow_nth.add((day, nth))
+                    continue
+            values.update(_item(item, low, high, names))
+        sets.append(values)
+
+    sched.minutes = sorted(sets[0])
+    sched.hours = sorted(sets[1])
+    sched.dom = sets[2]
+    sched.months = sets[3]
+    sched.dow = {d % 7 for d in sets[4]}
+    sched.dom_restricted = parts[2] not in ("*", "?")
+    sched.dow_restricted = parts[4] not in ("*", "?")
+    return sched
+
+
+def _day_allowed(sched, year, month, day, last_day, weekday):
+    """weekday is cron style: 0 is Sunday."""
+    def dom_ok():
+        return day in sched.dom or (sched.dom_last and day == last_day)
+
+    def dow_ok():
+        return (weekday in sched.dow
+                or (weekday in sched.dow_last and day + 7 > last_day)
+                or (weekday, (day - 1) // 7 + 1) in sched.dow_nth)
+
+    if sched.dom_restricted and sched.dow_restricted:
+        return dom_ok() or dow_ok()
+    if sched.dom_restricted:
+        return dom_ok()
+    if sched.dow_restricted:
+        return dow_ok()
+    return True
 
 
