 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text, low, high, names=None):
+    if names and text.upper() in names:
+        return names[text.upper()]
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid schedule value: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"schedule value out of range: {text!r}")
+    return value
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("a schedule needs five fields")
+    parsed = []
+    for index, (field, (low, high)) in enumerate(zip(fields, _LIMITS)):
+        values, special = set(), []
+        unrestricted = field in ("*", "?")
+        if field == "?":
+            if index not in (2, 4):
+                raise ValueError("'?' is only allowed in day fields")
+            field = "*"
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                special.append(("last",))
+                continue
+            last = re.fullmatch(r"([0-9]+)L", item) if index == 4 else None
+            nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item) if index == 4 else None
+            if last:
+                special.append(("weekday_last", _number(last[1], 0, 7) % 7))
+                continue
+            if nth:
+                special.append(("weekday_nth", _number(nth[1], 0, 7) % 7,
+                                _number(nth[2], 1, 5)))
+                continue
+            pieces = item.split("/")
+            if len(pieces) > 2:
+                raise ValueError("invalid schedule step")
+            base = pieces[0]
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError("invalid schedule step")
+                step = int(pieces[1])
+            if base == "*":
+                start, end = low, high
+            elif "-" in base:
+                endpoints = base.split("-")
+                if len(endpoints) != 2:
+                    raise ValueError("invalid schedule range")
+                start, end = (_number(p, low, high, names) for p in endpoints)
+                if start > end:
+                    raise ValueError("reversed schedule range")
+            else:
+                start = _number(base, low, high, names)
+                end = high if len(pieces) == 2 else start
+            selected = range(start, end + 1, step)
+            values.update(v % 7 if index == 4 else v for v in selected)
+        parsed.append((values, special, unrestricted))
+    return parsed
+
+
+def _day_matches(parsed, day):
+    dom, dow = parsed[2], parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    month_end = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or bool(dom[1] and day.day == month_end)
+    dow_match = weekday in dow[0]
+    for rule in dow[1]:
+        if weekday == rule[1]:
+            if rule[0] == "weekday_last":
+                dow_match |= day.day + 7 > month_end
+            else:
+                dow_match |= (day.day - 1) // 7 + 1 == rule[2]
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
