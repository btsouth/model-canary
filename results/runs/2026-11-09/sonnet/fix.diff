 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "jan feb mar apr may jun jul aug sep oct nov dec".split())}
+_DAYS = {n: i for i, n in enumerate("sun mon tue wed thu fri sat".split())}
+_NUM = re.compile(r"[0-9]+\Z")
+
+
+def _bad(msg):
+    raise ValueError(msg)
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.match(tok):
+        v = int(tok)
+    elif names and tok.lower() in names:
+        v = names[tok.lower()]
+    else:
+        _bad(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        _bad(f"value out of range: {tok!r}")
+    return v
+
+
+def _plain_item(item, lo, hi, names):
+    """Return the list of values for *, N, A-B, optionally with /S."""
+    parts = item.split("/")
+    if len(parts) > 2:
+        _bad("bad step")
+    base = parts[0]
+    step = None
+    if len(parts) == 2:
+        if not _NUM.match(parts[1]) or int(parts[1]) < 1:
+            _bad("bad step")
+        step = int(parts[1])
+    if base == "*":
+        vals = list(range(lo, hi + 1))
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+        if a > b:
+            _bad("descending range")
+        vals = list(range(a, b + 1))
+    else:
+        v = _value(base, lo, hi, names)
+        vals = list(range(v, hi + 1)) if step is not None else [v]
+    if step is not None:
+        vals = vals[::step]
+    return vals
+
+
+def _parse_field(text, lo, hi, names=None):
+    out = set()
+    for item in text.split(","):
+        if not item:
+            _bad("empty item")
+        out.update(_plain_item(item, lo, hi, names))
+    return out
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            _bad("unknown shortcut")
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        _bad("need five fields")
+    mi, ho, dom, mo, dow = fields
+    minutes = _parse_field(mi, 0, 59)
+    hours = _parse_field(ho, 0, 23)
+    months = _parse_field(mo, 1, 12, _MONTHS)
+
+    dom_restricted = dom not in ("*", "?")
+    dom_days, dom_last = set(), False
+    if dom == "?":
+        dom_days = set(range(1, 32))
+    else:
+        for item in dom.split(","):
+            if item == "L":
+                dom_last = True
+            elif not item:
+                _bad("empty item")
+            else:
+                dom_days.update(_plain_item(item, 1, 31, None))
+
+    dow_restricted = dow not in ("*", "?")
+    dow_days, dow_last, dow_nth = set(), set(), set()
+    if dow == "?":
+        dow = "*"
+    for item in dow.split(","):
+        if not item:
+            _bad("empty item")
+        if re.fullmatch(r"[0-9]+L", item):
+            dow_last.add(_value(item[:-1], 0, 7, None) % 7)
+        elif "#" in item:
+            n, _, k = item.partition("#")
+            n = _value(n, 0, 7, None)
+            k = _value(k, 1, 5, None)
+            dow_nth.add((n % 7, k))
+        else:
+            dow_days.update(v % 7 for v in _plain_item(item, 0, 7, _DAYS))
+    return (sorted(minutes), sorted(hours), months, dom_restricted, dom_days,
+            dom_last, dow_restricted, dow_days, dow_last, dow_nth)
+
+
+def _day_ok(p, d):
+    _, _, _, dr, dd, dl, wr, wd, wl, wn = p
+    if not dr and not wr:
+        return True
+    wday = (d.weekday() + 1) % 7
+    dom_m = d.day in dd or (dl and d.day == calendar.monthrange(d.year, d.month)[1])
+    dow_m = (wday in wd
+             or (wday in wl and d.day + 7 > calendar.monthrange(d.year, d.month)[1])
+             or (wday, (d.day - 1) // 7 + 1) in wn)
+    if dr and wr:
+        return dom_m or dow_m
+    return dom_m if dr else dow_m
 
 
