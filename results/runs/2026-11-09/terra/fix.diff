 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = dict(zip(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"), range(7)))
+_SHORTCUTS = {"@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+              "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+              "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+              "@hourly": "0 * * * *"}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown shortcut") from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(token):
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in names:
+                value = names[token.upper()]
+            else:
+                raise ValueError("invalid value")
+            if not low <= value <= high:
+                raise ValueError("value out of range")
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])L|([0-7])#([1-5])', item) if index == 4 else None
+            if match:
+                if match.group(1) is not None:
+                    special.append(('last_weekday', int(match.group(1)) % 7))
+                else:
+                    special.append(('nth', int(match.group(2)) % 7, int(match.group(3))))
+                continue
+            parts = item.split('/')
+            if len(parts) > 2 or not parts[0]:
+                raise ValueError("invalid item")
+            step = 1
+            if len(parts) == 2:
+                if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                    raise ValueError("invalid step")
+                step = int(parts[1])
+            base = parts[0]
+            if base == '*':
+                start, end = low, high
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError("invalid range")
+                start, end = map(number, ends)
+                if start > end:
+                    raise ValueError("descending range")
+            else:
+                start = number(base)
+                end = high if len(parts) == 2 else start
+            values.update(range(start, end + 1, step))
+        if index == 4 and 7 in values:
+            values.remove(7)
+            values.add(0)
+        parsed.append((values, special))
+    return parsed, fields[2] in ('*', '?'), fields[4] in ('*', '?')
+
+
+def _day_matches(date, parsed, dom_free, dow_free):
+    dom_values, dom_special = parsed[2]
+    dow_values, dow_special = parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dom = date.day in dom_values or (dom_special and date.day == last)
+    dow = weekday in dow_values or any(
+        (s[0] == 'last_weekday' and weekday == s[1] and date.day + 7 > last)
+        or (s[0] == 'nth' and weekday == s[1] and (date.day - 1) // 7 + 1 == s[2])
+        for s in dow_special)
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return bool(dow)
+    if dow_free:
+        return bool(dom)
+    return bool(dom or dow)
 
 
