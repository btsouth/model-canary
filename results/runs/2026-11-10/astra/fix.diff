 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(),
+                   range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"invalid number: {token!r}")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    maximum = 6 if index == 4 else high
+    values, specials = set(), []
+
+    def value(token):
+        n = names[token] if token in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError(f"value out of range: {token!r}")
+        return n % 7 if index == 4 else n
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last", 0))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#[0-9]+)", item)
+        if index == 4 and special:
+            weekday = value(special[1])
+            if special[2].startswith("#") and not 1 <= _number(special[2][1:]) <= 5:
+                raise ValueError("weekday occurrence out of range")
+            specials.append((special[2], weekday))
+            continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = parts[0]
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            ordered = list(range(low, maximum + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(value, ends)
+            ordered = (list(range(start, end + 1)) if start <= end else
+                       list(range(start, maximum + 1)) + list(range(low, end + 1)))
+        else:
+            start = value(base)
+            ordered = (list(range(start, maximum + 1)) if len(parts) == 2
+                       else [start])
+        values.update(ordered[::step])
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown shortcut") from None
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    return [_field(part, index) for index, part in enumerate(parts)]
+
+
+def _day_matches(fields, day, last, weekday):
+    dom, dom_special = fields[2]
+    dow, dow_special = fields[4]
+    if day not in dom and not (dom_special and day == last):
+        return False
+    if weekday in dow:
+        return True
+    return any(weekday == wanted and
+               (day + 7 > last if kind == "L" else
+                (day - 1) // 7 + 1 == int(kind[1:]))
+               for kind, wanted in dow_special)
+
 
