 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import datetime
+import re
+
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4,
+    "MAY": 5, "JUN": 6, "JUL": 7, "AUG": 8,
+    "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+_DAY_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3,
+    "THU": 4, "FRI": 5, "SAT": 6,
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUMBER = re.compile(r"[0-9]+")
+_FIELD = re.compile(r"[ \t]+")
+
+
+class _Field:
+    def __init__(self, minimum, maximum, names=None, kind="standard"):
+        self.minimum = minimum
+        self.maximum = maximum
+        self.names = names
+        self.kind = kind
+
+
+_MINUTE = _Field(0, 59)
+_HOUR = _Field(0, 23)
+_DAY_OF_MONTH = _Field(1, 31, kind="dom")
+_MONTH = _Field(1, 12, names=_MONTH_NAMES)
+_DAY_OF_WEEK = _Field(0, 7, names=_DAY_NAMES, kind="dow")
+
+
+def _number(text, minimum, maximum):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad value: {text!r}")
+    value = int(text)
+    if value < minimum or value > maximum:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _token_value(text, field, allow_names):
+    if allow_names and field.names is not None:
+        name = text.upper()
+        if name in field.names:
+            return field.names[name]
+    return _number(text, field.minimum, field.maximum)
+
+
+def _range_values(first, last, field):
+    if field.kind == "dow":
+        if first <= last:
+            return list(range(first, last + 1))
+        first %= 7
+        last %= 7
+        if first <= last:
+            return list(range(first, last + 1))
+        return list(range(first, 7)) + list(range(0, last + 1))
+
+    if first <= last:
+        return list(range(first, last + 1))
+    return list(range(first, field.maximum + 1)) + list(range(field.minimum, last + 1))
+
+
+def _expand(base, field, step, allow_names):
+    if base == "*":
+        values = list(range(field.minimum, field.maximum + 1))
+    elif "-" in base:
+        parts = base.split("-")
+        if len(parts) != 2 or not parts[0] or not parts[1]:
+            raise ValueError(f"bad range: {base!r}")
+        first = _token_value(parts[0], field, allow_names)
+        last = _token_value(parts[1], field, allow_names)
+        values = _range_values(first, last, field)
+    else:
+        value = _token_value(base, field, allow_names)
+        if step:
+            values = list(range(value, field.maximum + 1))
+        else:
+            values = [value]
+
+    if step:
+        values = values[::step]
+    return values
+
+
+def _canonical(field, value):
+    if field.kind == "dow" and value == 7:
+        return 0
+    return value
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays,
+                 last_weekdays, nth_weekdays):
+        self.minutes = frozenset(minutes)
+        self.hours = frozenset(hours)
+        self.days = frozenset(days)
+        self.last_day = last_day
+        self.months = frozenset(months)
+        self.weekdays = frozenset(weekdays)
+        self.last_weekdays = frozenset(last_weekdays)
+        self.nth_weekdays = frozenset(nth_weekdays)
+        self.times = tuple(
+            (hour, minute)
+            for hour in sorted(self.hours)
+            for minute in sorted(self.minutes)
+        )
+
+
+def _parse_field(text, field):
+    if field.kind in ("dom", "dow") and text == "?":
+        text = "*"
+
+    items = text.split(",")
+    if any(item == "" for item in items):
+        raise ValueError(f"empty item in {text!r}")
+
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+
+    for item in items:
+        if "/" in item:
+            if item.count("/") != 1:
+                raise ValueError(f"bad step: {item!r}")
+            base, step_text = item.split("/")
+            if not base or not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+            for value in _expand(base, field, step, allow_names=False):
+                values.add(_canonical(field, value))
+            continue
+
+        if field.kind == "dom" and item == "L":
+            last_day = True
+            continue
+
+        if field.kind == "dow":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                weekday = _number(match.group(1), 0, 7) % 7
+                last_weekdays.add(weekday)
+                continue
+
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                weekday = _number(match.group(1), 0, 7) % 7
+                occurrence = _number(match.group(2), 1, 5)
+                nth_weekdays.add((weekday, occurrence))
+                continue
+
+        for value in _expand(item, field, 0, allow_names=True):
+            values.add(_canonical(field, value))
+
+    return values, last_day, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be a string")
+
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule")
+
+    if text.startswith("@"):
+        shortcut = text.lower()
+        if shortcut not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[shortcut]
+
+    parts = _FIELD.split(text)
+    if len(parts) != 5:
+        raise ValueError(f"schedule needs five fields: {expr!r}")
+
+    minutes, _, _, _ = _parse_field(parts[0], _MINUTE)
+    hours, _, _, _ = _parse_field(parts[1], _HOUR)
+    days, last_day, _, _ = _parse_field(parts[2], _DAY_OF_MONTH)
+    months, _, _, _ = _parse_field(parts[3], _MONTH)
+    weekdays, _, last_weekdays, nth_weekdays = _parse_field(parts[4], _DAY_OF_WEEK)
+
+    return _Schedule(minutes, hours, days, last_day, months, weekdays,
+                     last_weekdays, nth_weekdays)
+
+
+def _date_matches(schedule, date):
+    if date.month not in schedule.months:
+        return False
+
+    day_matches = date.day in schedule.days
+    if not day_matches and schedule.last_day:
+        last = calendar.monthrange(date.year, date.month)[1]
+        day_matches = date.day == last
+    if not day_matches:
+        return False
+
+    weekday = (date.weekday() + 1) % 7
+    if weekday in schedule.weekdays:
+        return True
+
+    if schedule.last_weekdays:
+        last = calendar.monthrange(date.year, date.month)[1]
+        if weekday in schedule.last_weekdays and date.day + 7 > last:
+            return True
+
+    occurrence = (date.day - 1) // 7 + 1
+    return any(
+        weekday == day and occurrence == nth
+        for day, nth in schedule.nth_weekdays
+    )
+
 
