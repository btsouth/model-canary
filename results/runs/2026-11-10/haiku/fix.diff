+    whole = sum(Fraction(w) for w in weights)
+    sign = -1 if total < 0 else 1
+    amount = abs(total)
+    exact = [Fraction(amount) * Fraction(w) / whole for w in weights]
+    shares = [math.floor(e) for e in exact]
+    left = amount - sum(shares)
+    # Largest remainder first; on equal remainders the later share wins.
+    order = sorted(range(len(weights)), key=lambda i: (exact[i] - shares[i], i), reverse=True)
