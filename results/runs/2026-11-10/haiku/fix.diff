 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+from collections import namedtuple
+from functools import lru_cache
+
+# (smallest, largest) plain value per field. Day of week is 0-7, with 7 meaning Sunday.
+_RANGES = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], start=1)}
+_DOW_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+# values: frozenset of plain values; last: day-of-month L flag;
+# specials: day-of-week ("last", N) or ("nth", N, K) items.
+_Field = namedtuple("_Field", "values last specials")
+_Spec = namedtuple("_Spec", "minutes hours dom months dow")
+
+
+def _number(text, kind):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad value {text!r}")
+    value = int(text)
+    lo, hi = _RANGES[kind]
+    if not lo <= value <= hi:
+        raise ValueError(f"{value} out of range for {kind}")
+    return value
+
+
+def _value(text, kind, names):
+    if names is not None and _NAME.fullmatch(text):
+        if text.upper() in names:
+            return names[text.upper()]
+        raise ValueError(f"unknown name {text!r}")
+    return _number(text, kind)
+
+
+def _parse_field(text, kind):
+    lo, hi = _RANGES[kind]
+    names = {"month": _MONTH_NAMES, "dow": _DOW_NAMES}.get(kind)
+    if kind in ("dom", "dow") and text == "?":
+        text = "*"
+    values, last, specials = set(), False, []
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {text!r}")
+        if item == "L" and kind == "dom":
+            last = True
+            continue
+        if kind == "dow":
+            match = _LAST_WEEKDAY.fullmatch(item)
+            if match:
+                specials.append(("last", _number(match.group(1), "dow")))
+                continue
+            match = _NTH_WEEKDAY.fullmatch(item)
+            if match:
+                n = _number(match.group(1), "dow")
+                k = int(match.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad occurrence {k} in {item!r}")
+                specials.append(("nth", n, k))
+                continue
+
+        body, step = item, None
+        if "/" in item:
+            body, step_text = item.split("/", 1)
+            if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+        # A name cannot be used in a step.
+        plain_names = names if step is None else None
+
+        if body == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in body:
+            parts = body.split("-")
+            if len(parts) != 2:
+                raise ValueError(f"bad range {body!r}")
+            a = _value(parts[0], kind, plain_names)
+            b = _value(parts[1], kind, plain_names)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif kind == "dow":
+                # Counts through 0 to 6; 7 is Sunday, i.e. 0.
+                seq = list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(body, kind, plain_names)
+            seq = list(range(a, hi + 1)) if step else [a]
+
+        if step:
+            seq = seq[::step]
+        for v in seq:
+            values.add(v % 7 if kind == "dow" else v)
+    return _Field(frozenset(values), last, tuple(specials))
+
+
+@lru_cache(maxsize=256)
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {text!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    minute, hour, dom, month, dow = parts
+    fields = [
+        _parse_field(minute, "minute"),
+        _parse_field(hour, "hour"),
+        _parse_field(dom, "dom"),
+        _parse_field(month, "month"),
+        _parse_field(dow, "dow"),
+    ]
+    return _Spec(fields[0].values, fields[1].values, fields[2], fields[3].values, fields[4])
+
+
+def _spec(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    return _parse(expr)
+
+
+def _day_ok(spec, year, month, day, dim):
+    """True if the day matches both the day-of-month and the day-of-week fields."""
+    dom = spec.dom
+    if not (day in dom.values or (dom.last and day == dim)):
+        return False
+    weekday = _dt.date(year, month, day).isoweekday() % 7  # Sunday is 0
+    if weekday in spec.dow.values:
+        return True
+    for special in spec.dow.specials:
+        if special[0] == "last":
+            if special[1] % 7 == weekday and day + 7 > dim:
+                return True
+        else:
+            _, n, k = special
+            if n % 7 == weekday and (day - 1) // 7 + 1 == k:
+                return True
+    return False
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
