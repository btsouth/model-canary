+            first_day = start.day if (year, month) == (start.year, start.month) else 1
+            for day in range(first_day, dim + 1):
+                if not _day_ok(spec, year, month, day, dim):
+                    continue
+                for hour in hours:
+                    for minute in minutes:
+                        candidate = _dt.datetime(year, month, day, hour, minute)
+                        if candidate < start:
+                            continue
+                        if candidate > limit:
+                            return None
+                        return candidate
+        month += 1
+        if month > 12:
