 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
 
+_SHORT = {"@yearly":"0 0 1 1 *", "@annually":"0 0 1 1 *", "@monthly":"0 0 1 * *",
+          "@weekly":"0 0 * * 0", "@daily":"0 0 * * *", "@midnight":"0 0 * * *", "@hourly":"0 * * * *"}
+_MONTH = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DOW = {n[:3].upper(): i for i, n in enumerate(("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"))}
 
-def matches(expr, when):
-    """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    raw = expr.strip()
+    if raw.startswith("@"):
+        raw = _SHORT.get(raw.lower(), "")
+        if not raw: raise ValueError("unknown schedule shortcut")
+    fields = re.split(r"[ \t]+", raw) if raw else []
+    if len(fields) != 5: raise ValueError("schedule must have five fields")
+    mins = _field(fields[0], 0, 59)
+    hours = _field(fields[1], 0, 23)
+    dom = _field(fields[2], 1, 31, day=True)
+    months = _field(fields[3], 1, 12, names=_MONTH)
+    dow = _field(fields[4], 0, 7, names=_DOW, weekday=True)
+    return mins, hours, dom, months, dow
+
+def _field(s, lo, hi, day=False, names=None, weekday=False):
+    if day and s == "?": s = "*"
+    if "?" in s: raise ValueError("invalid ? field")
+    result = set()
+    for item in s.split(","):
+        if not item: raise ValueError("empty list item")
+        if day and item == "L":
+            result.add(("last",)); continue
+        special = None
+        if weekday:
+            m = re.fullmatch(r"(\d+)L", item)
+            h = re.fullmatch(r"(\d+)#([1-5])", item)
+            if m: special = ("lastweekday", int(m.group(1)))
+            elif h: special = ("nthweekday", int(h.group(1)), int(h.group(2)))
+            if special:
+                n = special[1]
+                if not 0 <= n <= 7: raise ValueError("weekday outside range")
+                result.add(special); continue
+        bits = item.split("/")
+        if len(bits) > 2: raise ValueError("invalid step")
+        step = 1
+        if len(bits) == 2:
+            if not bits[1].isdigit() or int(bits[1]) < 1: raise ValueError("invalid step")
+            step = int(bits[1])
+        base = bits[0]
+        def number(token):
+            if names and token.upper() in names: return names[token.upper()]
+            if not token.isdigit(): raise ValueError("invalid value")
+            n = int(token)
+            if not lo <= n <= hi: raise ValueError("value outside range")
+            return n
+        if base == "*": seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            if base.count("-") != 1: raise ValueError("invalid range")
+            a, b = (number(x) for x in base.split("-"))
+            if weekday and a > b:
+                seq = list(range(a, 8)) + list(range(0, b + 1))
+            elif a <= b: seq = list(range(a, b + 1))
+            else: seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            n = number(base)
+            seq = list(range(n, hi + 1)) if len(bits) == 2 else [n]
+        result.update(seq[::step])
+    return result
+
+def _dow_number(date): return (date.weekday() + 1) % 7
 
+def _day_ok(date, dom, dow):
+    lastday = calendar.monthrange(date.year, date.month)[1]
+    d = date.day
+    dn = _dow_number(date)
+    dom_ok = d in dom or ("last",) in dom and d == lastday
+    dow_ok = dn in dow or 7 in dow and dn == 0
+    for item in dow:
+        if isinstance(item, tuple):
+            if item[0] == "lastweekday" and dn == item[1] % 7 and d + 7 > lastday: dow_ok = True
+            if item[0] == "nthweekday" and dn == item[1] % 7 and (d - 1)//7 + 1 == item[2]: dow_ok = True
+    return dom_ok and dow_ok
+
+def matches(expr, when):
+    mins, hours, dom, months, dow = _parse(expr)
+    return when.minute in mins and when.hour in hours and when.month in months and _day_ok(when.date(), dom, dow)
 
