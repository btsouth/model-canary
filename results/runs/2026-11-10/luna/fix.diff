+    # Convert through decimal spelling for floats so the allocation follows the
+    # supplied value rather than its binary representation.
+    values = [Fraction(str(w)) for w in weights]
+    whole = sum(values)
+    sign = -1 if total < 0 else 1
+    amount = abs(total)
+    exact = [Fraction(amount) * w / whole for w in values]
+    shares = [x.numerator // x.denominator for x in exact]
+    left = amount - sum(shares)
+    order = sorted(range(len(values)), key=lambda i: (exact[i] - shares[i], i), reverse=True)
+    for i in order[:left]:
+        shares[i] += 1
+    return [sign * x for x in shares]
 
 
