 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+from functools import lru_cache
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# name, minimum, maximum, names (value for each name)
+_FIELDS = [
+    ("minute", 0, 59, None),
+    ("hour", 0, 23, None),
+    ("day of month", 1, 31, None),
+    ("month", 1, 12, {n: i + 1 for i, n in enumerate(_MONTHS)}),
+    ("day of week", 0, 7, {n: i for i, n in enumerate(_DAYS)}),
+]
+
+_DIGITS = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=50 * 365)
+_MINUTE = datetime.timedelta(minutes=1)
+
+
+def _number(text):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    return int(text)
+
+
+def _value(text, index):
+    name, lo, hi, names = _FIELDS[index]
+    if names is not None and text.isascii() and text.isalpha():
+        value = names.get(text.upper()) if len(text) == 3 else None
+        if value is None:
+            raise ValueError(f"bad name in {name} field: {text!r}")
+        return value
+    value = _number(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"{value} out of range for {name} field")
+    return value
+
+
+def _range_values(a, b, index):
+    _, lo, hi, _ = _FIELDS[index]
+    if a <= b:
+        return list(range(a, b + 1))
+    if index == 4:
+        a, b = a % 7, b % 7
+        out = [a]
+        while out[-1] != b:
+            out.append((out[-1] + 1) % 7)
+        return out
+    return list(range(a, hi + 1)) + list(range(lo, b + 1))
+
+
+def _parse_field(text, index):
+    """Return (values, specials) for one field.
+
+    specials holds ("L",) for day of month, and ("L", n) or ("#", n, k) for day of week.
+    """
+    name, lo, hi, _ = _FIELDS[index]
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError(f"'?' not allowed in {name} field")
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {name} field")
+        if index == 2 and item == "L":
+            specials.append(("L",))
+            continue
+        if index == 4 and item.endswith("L") and len(item) > 1:
+            n = _number(item[:-1])
+            if n > 7:
+                raise ValueError(f"{n} out of range for {name} field")
+            specials.append(("L", n % 7))
+            continue
+        if index == 4 and "#" in item:
+            n_text, _, k_text = item.partition("#")
+            n, k = _number(n_text), _number(k_text)
+            if n > 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad item {item!r} in {name} field")
+            specials.append(("#", n % 7, k))
+            continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            step = _number(step_text)
+            if step < 1:
+                raise ValueError(f"step of 0 in {name} field")
+        if base == "*":
+            listed = list(range(lo, hi + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            listed = _range_values(_value(a_text, index), _value(b_text, index), index)
+        else:
+            start = _value(base, index)
+            listed = list(range(start, hi + 1)) if slash else [start]
+        values.update(listed[::step])
+    if index == 4:
+        values = {v % 7 for v in values}
+    return frozenset(values), tuple(specials)
+
+
+@lru_cache(maxsize=256)
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    return tuple(_parse_field(part, i) for i, part in enumerate(parts))
+
+
+def _check(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    return _parse(expr)
+
+
+@lru_cache(maxsize=4096)
+def _allowed_days(dom, dow, length, first_dow):
+    """Days of a month with the given length and weekday (0 = Sunday) of the 1st."""
+    dom_values, dom_specials = dom
+    dow_values, dow_specials = dow
+    days = []
+    for day in range(1, length + 1):
+        if not (day in dom_values or (dom_specials and day == length)):
+            continue
+        wd = (first_dow + day - 1) % 7
+        ok = wd in dow_values
+        for special in dow_specials:
+            if ok:
+                break
+            if special[0] == "L":
+                ok = wd == special[1] and day + 7 > length
+            else:
+                ok = wd == special[1] and (day - 1) // 7 + 1 == special[2]
+        if ok:
+            days.append(day)
+    return tuple(days)
+
+
+def _days_in(fields, year, month):
+    length = calendar.monthrange(year, month)[1]
+    first_dow = (datetime.date(year, month, 1).weekday() + 1) % 7
+    return _allowed_days(fields[2], fields[4], length, first_dow)
 
 
