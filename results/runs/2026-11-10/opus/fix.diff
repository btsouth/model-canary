+            if i + 1 < len(value) and value[i + 1] == QUOTE:
+                out.append(QUOTE)
+                i += 2
+                continue
+            if i != len(value) - 1:
+                raise ValueError(f"text after closing quote in {value!r}")
+            return "".join(out)
+        out.append(ch)
+        i += 1
+    raise ValueError(f"unclosed quote in {value!r}")
