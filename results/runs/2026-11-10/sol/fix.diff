 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _number(text):
+    if re.fullmatch(r"[0-9]+", text) is None:
+        raise ValueError(f"bad number: {text!r}")
+    return int(text)
+
+
+def _field(text, low, high, names, kind):
+    values, special = set(), []
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f"value out of range: {token!r}")
+        return number
+
+    if text == "?" and kind in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if kind == 2 and item == "L":
+            special.append(("last",))
+            continue
+        match = re.fullmatch(r"([0-9]+)(?:L|#([0-9]+))", item) if kind == 4 else None
+        if match:
+            weekday = value(match[1]) % 7
+            if match[2] is None:
+                special.append(("last", weekday))
+            else:
+                occurrence = _number(match[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence must be between 1 and 5")
+                special.append(("nth", weekday, occurrence))
+            continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"bad item: {item!r}")
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = parts[0]
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError(f"bad range: {base!r}")
+            start, end = map(value, endpoints)
+            maximum = high
+            if kind == 4:
+                start, end, maximum = start % 7, end % 7, 6
+            sequence = (list(range(start, end + 1)) if start <= end else
+                        list(range(start, maximum + 1)) + list(range(low, end + 1)))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+        selected = sequence[::step]
+        values.update(number % 7 if kind == 4 else number for number in selected)
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr.upper())
+    if len(fields) != 5:
+        raise ValueError("a schedule needs five fields")
+    bounds = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+    return [_field(text, low, high, _MONTHS if i == 3 else _DAYS if i == 4 else {}, i)
+            for i, (text, (low, high)) in enumerate(zip(fields, bounds))]
+
+
+def _day_matches(parsed, year, month, day, last):
+    days, dom_special = parsed[2]
+    weekdays, dow_special = parsed[4]
+    if day not in days and not (dom_special and day == last):
+        return False
+    weekday = (datetime(year, month, day).weekday() + 1) % 7
+    return weekday in weekdays or any(
+        weekday == rule[1] and (day + 7 > last if rule[0] == "last"
+                               else (day - 1) // 7 + 1 == rule[2])
+        for rule in dow_special
+    )
+
 
