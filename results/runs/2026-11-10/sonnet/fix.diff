 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "jan feb mar apr may jun jul aug sep oct nov dec".split())}
+_DAYS = {n: i for i, n in enumerate("sun mon tue wed thu fri sat".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.lower() in names:
+        v = names[tok.lower()]
+    else:
+        raise ValueError(f"bad value: {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _sequence(base, lo, hi, names, dow):
+    """Ordered list of values an item (without step) lists."""
+    if base == "*":
+        return list(range(lo, hi + 1))
+    if "-" in base:
+        a, _, b = base.partition("-")
+        a = _value(a, lo, hi, names)
+        b = _value(b, lo, hi, names)
+        if a <= b:
+            return list(range(a, b + 1))
+        if dow:
+            seq = [a % 7]
+            while seq[-1] != b % 7:
+                seq.append((seq[-1] + 1) % 7)
+            return seq
+        return list(range(a, hi + 1)) + list(range(lo, b + 1))
+    return None
+
+
+def _parse_field(text, lo, hi, names=None, kind="plain"):
+    """Return (values, specials). kind is 'dom', 'dow' or 'plain'."""
+    values, specials = set(), set()
+    if text == "?":
+        if kind == "plain":
+            raise ValueError("'?' not allowed here")
+        text = "*"
+    dow = kind == "dow"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        base, slash, step = item.partition("/")
+        if slash:
+            if not _NUM.fullmatch(step) or int(step) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step)
+        else:
+            step = None
+        if kind == "dom" and base == "L":
+            specials.add("L")
+            continue
+        if dow and re.fullmatch(r"[0-9]+L", base):
+            specials.add((_value(base[:-1], 0, 7, None) % 7, "L"))
+            continue
+        if dow and re.fullmatch(r"[0-9]+#[0-9]+", base):
+            n, _, k = base.partition("#")
+            specials.add((_value(n, 0, 7, None) % 7, _value(k, 1, 5, None)))
+            continue
+        seq = _sequence(base, lo, hi, names, dow)
+        if seq is None:
+            v = _value(base, lo, hi, names)
+            seq = list(range(v, hi + 1)) if step else [v]
+        if step:
+            seq = seq[::step]
+        values.update(seq)
+    if dow:
+        values = {v % 7 for v in values}
+    return values, specials
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minute, hour, dom, month, dow = parts
+    minutes = _parse_field(minute, 0, 59)[0]
+    hours = _parse_field(hour, 0, 23)[0]
+    doms = _parse_field(dom, 1, 31, None, "dom")
+    months = _parse_field(month, 1, 12, _MONTHS)[0]
+    dows = _parse_field(dow, 0, 7, _DAYS, "dow")
+    return sorted(minutes), sorted(hours), doms, months, dows
+
+
+def _day_ok(y, m, d, doms, dows):
+    last = calendar.monthrange(y, m)[1]
+    dvals, dspec = doms
+    if not (d in dvals or ("L" in dspec and d == last)):
+        return False
+    wd = (calendar.weekday(y, m, d) + 1) % 7
+    wvals, wspec = dows
+    if wd in wvals:
+        return True
+    for n, k in wspec:
+        if n != wd:
+            continue
+        if k == "L":
+            if d + 7 > last:
+                return True
+        elif (d - 1) // 7 + 1 == k:
+            return True
+    return False
 
 
