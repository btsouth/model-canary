 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(),
+                   range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, low, high, names=None):
+    if re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    elif names and token in names:
+        value = names[token]
+    else:
+        raise ValueError(f"invalid value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    unrestricted = text in ("*", "?")
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError("? is only allowed in day fields")
+        text = "*"
+    values, special = set(), []
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if index == 4 and (last or nth):
+            match = last or nth
+            weekday = _number(match[1], 0, 7) % 7
+            special.append(("last", weekday) if last else
+                           ("nth", weekday, _number(match[2], 1, 5)))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError(f"invalid step: {pieces[1]!r}")
+            step = int(pieces[1])
+        if base == "*":
+            ordered = list(range(low, high + 1))
+        else:
+            endpoints = base.split("-")
+            if len(endpoints) > 2:
+                raise ValueError(f"invalid range: {base!r}")
+            endpoints = [_number(part, low, high, names) for part in endpoints]
+            start = endpoints[0]
+            if len(endpoints) == 2:
+                end = endpoints[1]
+            else:
+                end = high if len(pieces) == 2 else start
+            maximum = high
+            if index == 4 and start > end:
+                # Wrapping weekday ranges visit Sunday only once.
+                start, end, maximum = start % 7, end % 7, 6
+            ordered = (list(range(start, end + 1)) if start <= end else
+                       list(range(start, maximum + 1)) + list(range(low, end + 1)))
+        values.update(value % 7 if index == 4 else value
+                      for value in ordered[::step])
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(part, index) for index, part in enumerate(parts)]
+
+
+def _day_matches(fields, day):
+    dom, dom_special, dom_free = fields[2]
+    dow, dow_special, dow_free = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    dom_match = day.day in dom
+    dow_match = weekday in dow
+    if dom_special or dow_special:
+        last = calendar.monthrange(day.year, day.month)[1]
+        dom_match |= bool(dom_special) and day.day == last
+        for rule in dow_special:
+            if weekday == rule[1]:
+                dow_match |= (day.day + 7 > last if rule[0] == "last" else
+                              (day.day - 1) // 7 + 1 == rule[2])
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_match
+    if dow_free:
+        return dom_match
+    return dom_match or dow_match
+
 
