 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTH_NAMES = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+
+_DOW_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_FIELDS = (
+    ("minute", 0, 59, None),
+    ("hour", 0, 23, None),
+    ("dom", 1, 31, None),
+    ("month", 1, 12, _MONTH_NAMES),
+    ("dow", 0, 7, _DOW_NAMES),
+)
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+def _value(token, minimum, maximum, names):
+    if _NUMBER.fullmatch(token):
+        number = int(token)
+        if number < minimum or number > maximum:
+            raise ValueError(f"value out of range: {token!r}")
+        return number
+    if names is not None and token.upper() in names:
+        return names[token.upper()]
+    raise ValueError(f"bad value: {token!r}")
+
+
+def _expand_range(start, end, minimum, maximum, kind):
+    if kind == "dow":
+        if start <= end:
+            values = list(range(start, end + 1))
+        else:
+            values = list(range(start, 7)) + list(range(0, end + 1))
+        return [value % 7 for value in values]
+    if start <= end:
+        return list(range(start, end + 1))
+    return list(range(start, maximum + 1)) + list(range(minimum, end + 1))
+
+
+def _range_parts(item):
+    parts = item.split("-")
+    if len(parts) != 2 or not parts[0] or not parts[1]:
+        raise ValueError(f"bad range: {item!r}")
+    return parts
+
+
+def _parse_field(text, kind, minimum, maximum, names):
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+
+    items = text.split(",")
+    if any(item == "" for item in items):
+        raise ValueError(f"empty item in {text!r}")
+
+    values = set()
+    last_day = False
+    last_dow = set()
+    nth_dow = set()
+
+    for item in items:
+        if item == "?":
+            raise ValueError("'?' must be the whole day field")
+        if item.count("/") > 1:
+            raise ValueError(f"bad step: {item!r}")
+
+        if "/" in item:
+            base, step_text = item.split("/")
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+
+            if base == "*":
+                listed = list(range(minimum, maximum + 1))
+            elif "-" in base:
+                first, second = _range_parts(base)
+                start = _value(first, minimum, maximum, None)
+                end = _value(second, minimum, maximum, None)
+                listed = _expand_range(start, end, minimum, maximum, kind)
+            elif _NUMBER.fullmatch(base):
+                start = _value(base, minimum, maximum, None)
+                listed = list(range(start, maximum + 1))
+            else:
+                raise ValueError(f"bad stepped item: {item!r}")
+
+            if kind == "dow":
+                listed = [value % 7 for value in listed]
+            values.update(listed[::step])
+            continue
+
+        if kind == "dom" and item == "L":
+            last_day = True
+            continue
+
+        if kind == "dow":
+            match = _LAST_DOW.fullmatch(item)
+            if match:
+                number = int(match.group(1))
+                if number < 0 or number > 7:
+                    raise ValueError(f"bad last weekday: {item!r}")
+                last_dow.add(number % 7)
+                continue
+            match = _NTH_DOW.fullmatch(item)
+            if match:
+                number = int(match.group(1))
+                nth = int(match.group(2))
+                if number < 0 or number > 7 or nth < 1 or nth > 5:
+                    raise ValueError(f"bad nth weekday: {item!r}")
+                nth_dow.add((number % 7, nth))
+                continue
+
+        if item == "*":
+            listed = list(range(minimum, maximum + 1))
+            if kind == "dow":
+                listed = [value % 7 for value in listed]
+            values.update(listed)
+        elif "-" in item:
+            first, second = _range_parts(item)
+            start = _value(first, minimum, maximum, names)
+            end = _value(second, minimum, maximum, names)
+            values.update(_expand_range(start, end, minimum, maximum, kind))
+        else:
+            value = _value(item, minimum, maximum, names)
+            values.add(value % 7 if kind == "dow" else value)
+
+    return values, last_day, last_dow, nth_dow
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.lower() in _SHORTCUTS:
+        text = _SHORTCUTS[text.lower()]
+
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    parsed = {}
+    for text_field, (kind, minimum, maximum, names) in zip(parts, _FIELDS):
+        parsed[kind] = _parse_field(text_field, kind, minimum, maximum, names)
+
+    parsed["dom_restricted"] = parts[2] not in ("*", "?")
+    parsed["dow_restricted"] = parts[4] not in ("*", "?")
+    return parsed
+
+
+def _dom_matches(schedule, day):
+    values, last_day, _, _ = schedule["dom"]
+    if day.day in values:
+        return True
+    if last_day:
+        return day.day == calendar.monthrange(day.year, day.month)[1]
+    return False
+
+
+def _dow_matches(schedule, day):
+    _, _, last_dow, nth_dow = schedule["dow"]
+    weekday = (day.weekday() + 1) % 7
+    if weekday in schedule["dow"][0]:
+        return True
+    if weekday in last_dow:
+        last = calendar.monthrange(day.year, day.month)[1]
+        if day.day + 7 > last:
+            return True
+    occurrence = (day.day - 1) // 7 + 1
+    return any(number == weekday and nth == occurrence for number, nth in nth_dow)
+
+
+def _day_matches(schedule, day):
+    dom_restricted = schedule["dom_restricted"]
+    dow_restricted = schedule["dow_restricted"]
+    if dom_restricted and dow_restricted:
+        return _dom_matches(schedule, day) or _dow_matches(schedule, day)
+    if dom_restricted:
+        return _dom_matches(schedule, day)
+    if dow_restricted:
+        return _dow_matches(schedule, day)
+    return True
+
+
+def _matches(schedule, when):
+    if when.minute not in schedule["minute"][0]:
+        return False
+    if when.hour not in schedule["hour"][0]:
+        return False
+    if when.month not in schedule["month"][0]:
+        return False
+    return _day_matches(schedule, when.date())
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    return _matches(schedule, when)
+
+
+def _next_time(schedule, lower_hour, lower_minute):
+    for hour in sorted(schedule["hour"][0]):
+        if hour < lower_hour:
+            continue
+        for minute in sorted(schedule["minute"][0]):
+            if hour == lower_hour and minute < lower_minute:
+                continue
+            return hour, minute
+    return None
 
 
