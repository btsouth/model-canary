--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,209 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from datetime import date, datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_MONTH_NAMES = {name: i + 1 for i, name in enumerate(_MONTHS)}
+_DAY_NAMES = {name: i for i, name in enumerate(_DAYS)}
+_LIMIT = timedelta(days=20 * 365)
+
+
+class _Field:
+    def __init__(self, name, low, high, names=None):
+        self.name, self.low, self.high, self.names = name, low, high, names or {}
+
+    def value(self, text):
+        if text.isdigit() and text.isascii():
+            n = int(text)
+        elif text.upper() in self.names:
+            n = self.names[text.upper()]
+        else:
+            raise ValueError(f"bad value {text!r} in {self.name} field")
+        if not self.low <= n <= self.high:
+            raise ValueError(f"{n} out of range in {self.name} field")
+        return n
+
+    def parse(self, text):
+        """Return a set of values plus the special day items found."""
+        values, specials = set(), set()
+        for item in text.split(","):
+            if not item:
+                raise ValueError(f"empty item in {self.name} field")
+            self._item(item, values, specials)
+        return values, specials
+
+    def _item(self, item, values, specials):
+        base, step = item, None
+        if "/" in item:
+            base, _, step_text = item.partition("/")
+            if "/" in step_text or not (step_text.isdigit() and step_text.isascii()):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step of 0 in {item!r}")
+        if base == "*":
+            listed = list(range(self.low, self.high + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a, b = self.value(a_text), self.value(b_text)
+            listed = self._range(a, b)
+        elif step is not None:
+            listed = list(range(self.value(base), self.high + 1))
+        elif self._special(base, specials):
+            return
+        else:
+            listed = [self.value(base)]
+        if step is not None:
+            listed = listed[::step]
+        values.update(self._normalise(v) for v in listed)
+
+    def _range(self, a, b):
+        if a <= b:
+            return list(range(a, b + 1))
+        return list(range(a, self.high + 1)) + list(range(self.low, b + 1))
+
+    def _normalise(self, v):
+        return v
+
+    def _special(self, base, specials):
+        return False
+
+
+class _DayOfMonth(_Field):
+    def _special(self, base, specials):
+        if base == "L":
+            specials.add("L")
+            return True
+        return False
+
+
+class _DayOfWeek(_Field):
+    def _normalise(self, v):
+        return v % 7
+
+    def _range(self, a, b):
+        a, b = a % 7, b % 7
+        if a <= b:
+            return list(range(a, b + 1))
+        return list(range(a, 7)) + list(range(0, b + 1))
+
+    def _number(self, text):
+        if not (text.isdigit() and text.isascii()) or not 0 <= int(text) <= 7:
+            raise ValueError(f"bad day of week {text!r}")
+        return int(text) % 7
+
+    def _special(self, base, specials):
+        if base.endswith("L"):
+            specials.add(("L", self._number(base[:-1])))
+            return True
+        if "#" in base:
+            n_text, _, k_text = base.partition("#")
+            if not (k_text.isdigit() and k_text.isascii()) or not 1 <= int(k_text) <= 5:
+                raise ValueError(f"bad occurrence in {base!r}")
+            specials.add(("#", self._number(n_text), int(k_text)))
+            return True
+        return False
+
+
+_FIELDS = [
+    _Field("minute", 0, 59),
+    _Field("hour", 0, 23),
+    _DayOfMonth("day of month", 1, 31),
+    _Field("month", 1, 12, _MONTH_NAMES),
+    _DayOfWeek("day of week", 0, 7, _DAY_NAMES),
+]
+
+
+def _last_day(d):
+    first_next = (d.replace(day=1) + timedelta(days=32)).replace(day=1)
+    return (first_next - timedelta(days=1)).day
+
+
+class _Schedule:
+    def __init__(self, expr):
+        text = expr.strip()
+        if text.startswith("@"):
+            try:
+                text = _SHORTCUTS[text.lower()]
+            except KeyError:
+                raise ValueError(f"unknown shortcut {expr!r}") from None
+        parts = re.split(r"[ \t]+", text) if text else []
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields in {expr!r}")
+        self.dom_restricted = parts[2] not in ("*", "?")
+        self.dow_restricted = parts[4] not in ("*", "?")
+        for i in (2, 4):
+            if parts[i] == "?":
+                parts[i] = "*"
+        parsed = [field.parse(part) for field, part in zip(_FIELDS, parts)]
+        self.minutes, self.hours = parsed[0][0], parsed[1][0]
+        self.dom, self.dom_special = parsed[2]
+        self.months = parsed[3][0]
+        self.dow, self.dow_special = parsed[4]
+        self.times = sorted((h, m) for h in self.hours for m in self.minutes)
+
+    def _dom_match(self, d, last):
+        return d.day in self.dom or ("L" in self.dom_special and d.day == last)
+
+    def _dow_match(self, d, last):
+        wd = (d.weekday() + 1) % 7
+        if wd in self.dow:
+            return True
+        if ("L", wd) in self.dow_special and d.day + 7 > last:
+            return True
+        return ("#", wd, (d.day - 1) // 7 + 1) in self.dow_special
+
+    def day_allowed(self, d):
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+        last = _last_day(d)
+        if self.dom_restricted and self.dow_restricted:
+            return self._dom_match(d, last) or self._dow_match(d, last)
+        if self.dom_restricted:
+            return self._dom_match(d, last)
+        return self._dow_match(d, last)
+
+    def matches(self, when):
+        return (when.minute in self.minutes and when.hour in self.hours
+                and when.month in self.months and self.day_allowed(when.date()))
+
+    def next_run(self, after):
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+        limit = after + _LIMIT
+        day = start.date()
+        earliest = (start.hour, start.minute)
+        while datetime.combine(day, time()) <= limit:
+            if day.month not in self.months:
+                day = (day.replace(day=1) + timedelta(days=32)).replace(day=1)
+                earliest = (0, 0)
+                continue
+            if self.day_allowed(day):
+                for h, m in self.times:
+                    if (h, m) >= earliest:
+                        candidate = datetime.combine(day, time(h, m))
+                        return candidate if candidate <= limit else None
+            day += timedelta(days=1)
+            earliest = (0, 0)
+        return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _Schedule(expr).matches(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    return _Schedule(expr).next_run(after)
