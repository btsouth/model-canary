--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,213 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from collections import namedtuple
+from datetime import datetime, timedelta
+
+_LIMIT = timedelta(days=20 * 365)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAY_NAMES = {n: i for i, n in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+
+# kind -> (minimum, maximum, names)
+_RANGES = {
+    "minute": (0, 59, {}),
+    "hour": (0, 23, {}),
+    "dom": (1, 31, {}),
+    "month": (1, 12, _MONTH_NAMES),
+    "dow": (0, 7, _DAY_NAMES),
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+_NTH_LAST = re.compile(r"([0-9]+)[Ll]")
+
+_Spec = namedtuple("_Spec", [
+    "minutes", "hours", "months",
+    "dom", "dom_last", "dom_restricted",
+    "dow", "dow_last", "dow_nth", "dow_restricted",
+    "minutes_sorted", "hours_sorted",
+])
+
+
+def _value(token, kind):
+    lo, hi, names = _RANGES[kind]
+    if _DIGITS.fullmatch(token):
+        value = int(token)
+    elif names and _NAME.fullmatch(token) and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad {kind} value {token!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"{kind} value {value} out of range")
+    return value
+
+
+def _span(a, b, lo, wrap_hi):
+    """Values from a to b. When a > b the range wraps through wrap_hi back to lo."""
+    if a <= b:
+        return list(range(a, b + 1))
+    return list(range(a, wrap_hi + 1)) + list(range(lo, b + 1))
+
+
+def _parse_field(text, kind):
+    """Return (set of values, list of special items) for one field."""
+    lo, hi, _ = _RANGES[kind]
+    wrap_hi = 6 if kind == "dow" else hi
+    if text == "?" and kind in ("dom", "dow"):
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        body, step = item, None
+        if "/" in item:
+            body, step_text = item.split("/", 1)
+            if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+        if kind == "dom" and body in ("L", "l"):
+            if step is not None:
+                raise ValueError(f"cannot step {item!r}")
+            specials.append(("L",))
+            continue
+        if kind == "dow":
+            nth = _NTH.fullmatch(body)
+            last = _NTH_LAST.fullmatch(body)
+            if nth or last:
+                if step is not None:
+                    raise ValueError(f"cannot step {item!r}")
+                if nth:
+                    n, k = int(nth.group(1)), int(nth.group(2))
+                    if n > 7 or not 1 <= k <= 5:
+                        raise ValueError(f"bad nth weekday {item!r}")
+                    specials.append(("nth", n % 7, k))
+                else:
+                    n = int(last.group(1))
+                    if n > 7:
+                        raise ValueError(f"bad weekday {item!r}")
+                    specials.append(("last", n % 7))
+                continue
+        if body == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in body:
+            parts = body.split("-")
+            if len(parts) != 2:
+                raise ValueError(f"bad range {item!r}")
+            seq = _span(_value(parts[0], kind), _value(parts[1], kind), lo, wrap_hi)
+        else:
+            v = _value(body, kind)
+            seq = list(range(v, hi + 1)) if step is not None else [v]
+        if step is not None:
+            seq = seq[::step]
+        values.update(seq)
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, specials
+
+
+def _parse(expr):
+    """Parse and check a whole expression. Raises ValueError if it is bad."""
+    if not isinstance(expr, str):
+        raise ValueError(f"schedule must be a string, not {type(expr).__name__}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)} in {expr!r}")
+    minute, hour, dom, month, dow = parts
+    minutes, _ = _parse_field(minute, "minute")
+    hours, _ = _parse_field(hour, "hour")
+    dom_values, dom_specials = _parse_field(dom, "dom")
+    months, _ = _parse_field(month, "month")
+    dow_values, dow_specials = _parse_field(dow, "dow")
+    return _Spec(
+        minutes=frozenset(minutes),
+        hours=frozenset(hours),
+        months=frozenset(months),
+        dom=frozenset(dom_values),
+        dom_last=any(s[0] == "L" for s in dom_specials),
+        dom_restricted=dom not in ("*", "?"),
+        dow=frozenset(dow_values),
+        dow_last=tuple(s[1] for s in dow_specials if s[0] == "last"),
+        dow_nth=tuple((s[1], s[2]) for s in dow_specials if s[0] == "nth"),
+        dow_restricted=dow not in ("*", "?"),
+        minutes_sorted=sorted(minutes),
+        hours_sorted=sorted(hours),
+    )
+
+
+def _day_ok(spec, day):
+    """True if a schedule may run on the calendar date day."""
+    if day.month not in spec.months:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in spec.dom or (spec.dom_last and day.day == last)
+    cron_wd = (day.weekday() + 1) % 7  # cron: Sunday is 0
+    dow_ok = (
+        cron_wd in spec.dow
+        or any(n == cron_wd and day.day + 7 > last for n in spec.dow_last)
+        or any(n == cron_wd and (day.day - 1) // 7 + 1 == k for n, k in spec.dow_nth)
+    )
+    if spec.dom_restricted and spec.dow_restricted:
+        return dom_ok or dow_ok
+    if spec.dom_restricted:
+        return dom_ok
+    if spec.dow_restricted:
+        return dow_ok
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return when.minute in spec.minutes and when.hour in spec.hours and _day_ok(spec, when.date())
+
+
+def _first_run_on(spec, day, start):
+    """Earliest run on day, not before start if start is given (same day only)."""
+    for hour in spec.hours_sorted:
+        if start is not None and hour < start.hour:
+            continue
+        for minute in spec.minutes_sorted:
+            if start is not None and hour == start.hour and minute < start.minute:
+                continue
+            return datetime(day.year, day.month, day.day, hour, minute)
+    return None
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    try:
+        limit = after + _LIMIT
+    except OverflowError:
+        limit = datetime.max
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    first = start.date()
+    for offset in range((limit.date() - first).days + 1):
+        day = first + timedelta(days=offset)
+        if not _day_ok(spec, day):
+            continue
+        run = _first_run_on(spec, day, start if offset == 0 else None)
+        if run is not None:
+            return run if run <= limit else None
+    return None
