 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(calendar.day_abbr)}
+_SHORT = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *", "@hourly": "0 * * * *",
+}
+_RANGES = [(0,59), (0,23), (1,31), (1,12), (0,7)]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try: expr = _SHORT[expr.lower()]
+        except KeyError: raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", expr) if expr else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    return [(f, i, _field(f, i)) for i, f in enumerate(fields)]
+
+
+def _field(field, idx):
+    lo, hi = _RANGES[idx]
+    if idx in (2,4) and field == "?":
+        return {"all": True, "values": set(), "special": []}
+    values, specials = set(), []
+    if not field: raise ValueError("empty field")
+    for item in field.split(','):
+        if not item: raise ValueError("empty item")
+        if idx == 2 and item == "L":
+            specials.append(("last",)); continue
+        if idx == 4 and re.fullmatch(r"\dL", item):
+            n = int(item[0]);
+            if n > 7: raise ValueError("day out of range")
+            specials.append(("last_weekday", n % 7)); continue
+        if idx == 4 and re.fullmatch(r"\d#\d", item):
+            n, k = map(int, item.split('#'))
+            if n > 7 or not 1 <= k <= 5: raise ValueError("bad weekday ordinal")
+            specials.append(("nth", n % 7, k)); continue
+        base, slash, steptext = item.partition('/')
+        if slash and (not steptext.isdigit() or int(steptext) < 1): raise ValueError("bad step")
+        step = int(steptext) if slash else 1
+        def number(s):
+            if s.isdigit(): return int(s)
+            if idx == 3 and s.upper() in _MONTHS: return _MONTHS[s.upper()]
+            if idx == 4 and s.upper() in _DAYS: return _DAYS[s.upper()]
+            raise ValueError("bad value")
+        if base == '*': seq = list(range(lo, hi+1))
+        elif '-' in base:
+            if base.count('-') != 1: raise ValueError("bad range")
+            a,b = (number(s) for s in base.split('-'))
+            if not lo <= a <= hi or not lo <= b <= hi: raise ValueError("out of range")
+            if idx == 4 and a > b:
+                seq = list(range(a,7)) + list(range(0,b+1))
+            elif a <= b: seq = list(range(a,b+1))
+            else: seq = list(range(a,hi+1)) + list(range(lo,b+1))
+        else:
+            a = number(base)
+            if not lo <= a <= hi: raise ValueError("out of range")
+            seq = list(range(a, hi+1)) if slash else [a]
+        values.update(seq[::step])
+    return {"all": field in ('*','?'), "values": values, "special": specials}
+
+
+def _daymatch(parsed, when):
+    dom, dow = parsed[2][2], parsed[4][2]
+    actual_dow = (when.weekday()+1) % 7
+    def match(spec, idx):
+        if when.day in spec['values'] if idx == 2 else actual_dow in {0 if x == 7 else x for x in spec['values']}: return True
+        for sp in spec['special']:
+            if sp[0] == 'last' and when.day == calendar.monthrange(when.year, when.month)[1]: return True
+            if sp[0] == 'last_weekday' and actual_dow == sp[1] and when.day + 7 > calendar.monthrange(when.year, when.month)[1]: return True
+            if sp[0] == 'nth' and actual_dow == sp[1] and (when.day-1)//7+1 == sp[2]: return True
+        return False
+    a,b = match(dom,2), match(dow,4)
+    return (b if dom['all'] else a) if dow['all'] else ((a or b) if not dom['all'] else b)
 
 
