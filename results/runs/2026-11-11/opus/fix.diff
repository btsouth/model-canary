 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (minimum, maximum, names) for each field.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_DOM, _DOW = 2, 4
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+def _number(text, low, high):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _value(text, low, high, names):
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    return _number(text, low, high)
+
+
+def _parse_field(text, index):
+    """Return (values, extras) where extras lists the special day items."""
+    low, high, names = _FIELDS[index]
+    values, extras = set(), []
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(range(low, high + 1)) if index == _DOM else set(range(7)), extras
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if index == _DOM and item == "L":
+            extras.append(("L",))
+            continue
+        if index == _DOW:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                extras.append(("NL", _number(m.group(1), 0, 7) % 7))
+                continue
+            m = _NTH_DOW.fullmatch(item)
+            if m:
+                extras.append(("#", _number(m.group(1), 0, 7) % 7, _number(m.group(2), 1, 5)))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"bad item: {item!r}")
+        base = parts[0]
+        step = None
+        if len(parts) == 2:
+            if not _DIGITS.fullmatch(parts[1]) or int(parts[1]) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(parts[1])
+        if base == "*":
+            seq = list(range(low, (6 if index == _DOW else high) + 1))
+        elif "-" in base:
+            bounds = base.split("-")
+            if len(bounds) != 2:
+                raise ValueError(f"bad range: {item!r}")
+            a = _value(bounds[0], low, high, names)
+            b = _value(bounds[1], low, high, names)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif index == _DOW:
+                seq = list(range(a % 7, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, high + 1)) + list(range(low, b + 1))
+        else:
+            a = _value(base, low, high, names)
+            seq = list(range(a, high + 1)) if step is not None else [a]
+        if step is not None:
+            seq = seq[::step]
+        if index == _DOW:
+            seq = [v % 7 for v in seq]
+        values.update(seq)
+    return values, extras
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("expression must be a string")
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {text!r}")
+            text = _SHORTCUTS[text.lower()]
+        fields = re.split(r"[ \t]+", text)
+        if len(fields) != 5:
+            raise ValueError(f"expected 5 fields: {expr!r}")
+        parsed = [_parse_field(f, i) for i, f in enumerate(fields)]
+        self.minutes = sorted(parsed[0][0])
+        self.hours = sorted(parsed[1][0])
+        self.dom, self.dom_extras = parsed[2]
+        self.months = parsed[3][0]
+        self.dow, self.dow_extras = parsed[4]
+        self.dom_restricted = fields[2] not in ("*", "?")
+        self.dow_restricted = fields[4] not in ("*", "?")
+
+    def _dom_match(self, day):
+        if day.day in self.dom:
+            return True
+        last = calendar.monthrange(day.year, day.month)[1]
+        return any(e[0] == "L" and day.day == last for e in self.dom_extras)
+
+    def _dow_match(self, day):
+        weekday = (day.weekday() + 1) % 7
+        if weekday in self.dow:
+            return True
+        last = calendar.monthrange(day.year, day.month)[1]
+        for extra in self.dow_extras:
+            if extra[1] != weekday:
+                continue
+            if extra[0] == "NL" and day.day + 7 > last:
+                return True
+            if extra[0] == "#" and (day.day - 1) // 7 + 1 == extra[2]:
+                return True
+        return False
+
+    def day_allowed(self, day):
+        if day.month not in self.months:
+            return False
+        if self.dom_restricted and self.dow_restricted:
+            return self._dom_match(day) or self._dow_match(day)
+        if self.dom_restricted:
+            return self._dom_match(day)
+        if self.dow_restricted:
+            return self._dow_match(day)
+        return True
+
+    def matches(self, when):
+        return (when.minute in self.minutes and when.hour in self.hours
+                and self.day_allowed(when.date()))
+
+    def first_time(self, hour, minute):
+        """First (hour, minute) of the schedule at or after hour:minute, or None."""
+        for h in self.hours:
+            if h < hour:
+                continue
+            for m in self.minutes:
+                if h > hour or m >= minute:
+                    return h, m
+        return None
 
 
