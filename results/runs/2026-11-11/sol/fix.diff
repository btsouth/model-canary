 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_left
+from calendar import monthrange
+from datetime import date, datetime, timedelta
+import re
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(),
+                   range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _decimal(text):
+    if re.fullmatch(r"[0-9]+", text) is None:
+        raise ValueError(f"bad number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    minimum, maximum = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    cycle_maximum = 6 if index == 4 else maximum
+
+    def number(token):
+        value = names.get(token.upper())
+        if value is None:
+            value = _decimal(token)
+        if not minimum <= value <= maximum:
+            raise ValueError(f"value outside field range: {token!r}")
+        return value
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if index == 4 and special:
+            weekday = number(special[1]) % 7
+            if special[2] == "L":
+                specials.append(("last_weekday", weekday))
+            else:
+                occurrence = _decimal(special[3])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence outside 1-5")
+                specials.append(("nth_weekday", weekday, occurrence))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"bad item: {item!r}")
+        base = pieces[0]
+        step = _decimal(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            sequence = list(range(minimum, maximum + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"bad range: {base!r}")
+            start, end = map(number, ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                if index == 4:
+                    start, end = start % 7, end % 7
+                if start <= end:
+                    sequence = list(range(start, end + 1))
+                else:
+                    sequence = (list(range(start, cycle_maximum + 1))
+                                + list(range(minimum, end + 1)))
+        else:
+            start = number(base)
+            sequence = (list(range(start, maximum + 1))
+                        if len(pieces) == 2 else [start])
+        values.update(value % 7 if index == 4 else value
+                      for value in sequence[::step])
+    return values, specials, text == "*"
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must contain five fields")
+    return tuple(_field(field, i) for i, field in enumerate(fields))
+
+
+def _day_matches(fields, day):
+    dom, dom_specials, dom_free = fields[2]
+    dow, dow_specials, dow_free = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    dom_match = day.day in dom
+    dow_match = weekday in dow
+    if dom_specials or dow_specials:
+        last = monthrange(day.year, day.month)[1]
+        dom_match |= bool(dom_specials) and day.day == last
+        for special in dow_specials:
+            if weekday == special[1]:
+                if special[0] == "last_weekday":
+                    dow_match |= day.day + 7 > last
+                else:
+                    dow_match |= (day.day - 1) // 7 + 1 == special[2]
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_match
+    if dow_free:
+        return dom_match
+    return dom_match or dow_match
+
 
