 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import re
+from datetime import datetime, timedelta
+import calendar
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names and len(tok) == 3 and tok.isascii():
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _step(seq, step):
+    return seq[::step]
+
+
+def _parse_field(text, lo, hi, names, kind):
+    """Return (values, extra) where extra holds special day items."""
+    values = set()
+    last = False
+    nth = set()
+    lastdow = set()
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("? not allowed here")
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError("bad step")
+        base = parts[0]
+        step = 1
+        if len(parts) == 2:
+            if not _NUM.fullmatch(parts[1]) or int(parts[1]) < 1:
+                raise ValueError("bad step")
+            step = int(parts[1])
+        if not base:
+            raise ValueError("empty item")
+        if kind == "dom" and base == "L":
+            last = True
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)L", base)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError("bad day")
+                lastdow.add(n % 7)
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", base)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if n > 7 or not 1 <= k <= 5:
+                    raise ValueError("bad N#K")
+                nth.add((n % 7, k))
+                continue
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif kind == "dow":
+                seq = list(range(a % 7, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            seq = [a] if len(parts) == 1 else list(range(a, hi + 1))
+        values.update(_step(seq, step))
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, last, nth, lastdow
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        if expr.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        expr = _SHORTCUTS[expr.lower()]
+    fs = re.split(r"[ \t]+", expr)
+    if len(fs) != 5:
+        raise ValueError("expected five fields")
+    minute = _parse_field(fs[0], 0, 59, None, "minute")[0]
+    hour = _parse_field(fs[1], 0, 23, None, "hour")[0]
+    dom, dom_last, _, _ = _parse_field(fs[2], 1, 31, None, "dom")
+    month = _parse_field(fs[3], 1, 12, _MONTHS, "month")[0]
+    dow, _, nth, lastdow = _parse_field(fs[4], 0, 7, _DAYS, "dow")
+    dom_r = fs[2] not in ("*", "?")
+    dow_r = fs[4] not in ("*", "?")
+    return (sorted(minute), sorted(hour), (dom, dom_last), month,
+            (dow, nth, lastdow), dom_r, dow_r)
+
+
+def _day_ok(p, y, m, d):
+    _, _, (dom, dom_last), _, (dow, nth, lastdow), dom_r, dow_r = p
+    if not dom_r and not dow_r:
+        return True
+    ndays = calendar.monthrange(y, m)[1]
+    ok_dom = d in dom or (dom_last and d == ndays)
+    wd = (datetime(y, m, d).weekday() + 1) % 7
+    ok_dow = (wd in dow or (wd, (d - 1) // 7 + 1) in nth
+              or (wd in lastdow and d + 7 > ndays))
+    if dom_r and dow_r:
+        return ok_dom or ok_dow
+    return ok_dom if dom_r else ok_dow
 
 
