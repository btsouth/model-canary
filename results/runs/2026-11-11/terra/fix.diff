 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import date, datetime, timedelta
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7)))
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    # Only spaces and tabs are field separators.
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    result = []
+    for index, field in enumerate(parts):
+        low, high = _LIMITS[index]
+        unrestricted = index in (2, 4) and field in ('*', '?')
+        if field == '?' and index in (2, 4):
+            field = '*'
+        values, special = set(), []
+
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if token.upper() in names:
+                n = names[token.upper()]
+            elif re.fullmatch(r'[0-9]+', token):
+                n = int(token)
+            else:
+                raise ValueError('invalid value')
+            if not low <= n <= high:
+                raise ValueError('value out of range')
+            return n
+
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])L|([0-7])#([1-5])', item) if index == 4 else None
+            if match:
+                if match.group(1) is not None:
+                    special.append(('weekday_last', int(match.group(1)) % 7))
+                else:
+                    special.append(('weekday_nth', int(match.group(2)) % 7, int(match.group(3))))
+                continue
+            bits = item.split('/')
+            if len(bits) > 2 or not bits[0]:
+                raise ValueError('invalid item')
+            if len(bits) == 2:
+                if not re.fullmatch(r'[0-9]+', bits[1]) or int(bits[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(bits[1])
+            else:
+                step = 1
+            base = bits[0]
+            if base == '*':
+                sequence = list(range(low, high + 1))
+            elif '-' in base:
+                endpoints = base.split('-')
+                if len(endpoints) != 2:
+                    raise ValueError('invalid range')
+                a, b = map(number, endpoints)
+                if index == 4 and a > b:
+                    a, b = a % 7, b % 7
+                    sequence = list(range(a, b + 1)) if a <= b else list(range(a, 7)) + list(range(0, b + 1))
+                else:
+                    sequence = list(range(a, b + 1)) if a <= b else list(range(a, high + 1)) + list(range(low, b + 1))
+            else:
+                a = number(base)
+                sequence = list(range(a, high + 1)) if len(bits) == 2 else [a]
+            values.update(n % 7 if index == 4 else n for n in sequence[::step])
+        result.append((values, special, unrestricted))
+    return result
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or bool(dom[1]) and day.day == last
+    dow_match = weekday in dow[0] or any(
+        weekday == rule[1] and (day.day + 7 > last if rule[0] == 'weekday_last' else (day.day - 1) // 7 + 1 == rule[2])
+        for rule in dow[1]
+    )
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
