 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = dict(zip('JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), range(1, 13)))
+_DAYS = dict(zip('SUN MON TUE WED THU FRI SAT'.split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if re.fullmatch(r'[0-9]+', token) is None:
+        raise ValueError(f'invalid number: {token!r}')
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def value(token):
+        result = names[token] if token in names else _number(token)
+        if not low <= result <= high:
+            raise ValueError(f'value outside field range: {token!r}')
+        return result
+
+    if text == '?' and index in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        last = re.fullmatch(r'([0-9]+)L', item) if index == 4 else None
+        nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item) if index == 4 else None
+        if last:
+            special.append(('weekday_last', value(last[1]) % 7))
+            continue
+        if nth:
+            occurrence = _number(nth[2])
+            if not 1 <= occurrence <= 5:
+                raise ValueError('weekday occurrence must be 1 to 5')
+            special.append(('weekday_nth', value(nth[1]) % 7, occurrence))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError(f'invalid step: {item!r}')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError(f'invalid range: {base!r}')
+            start, end = map(value, endpoints)
+            if start > end:
+                raise ValueError('reversed range')
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, special
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith('@'):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f'unknown shortcut: {text!r}') from None
+    fields = re.split(r'[ \t]+', text.upper())
+    if len(fields) != 5:
+        raise ValueError('schedule must have five fields')
+    return tuple(_field(field, index) for index, field in enumerate(fields))
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    dow, dow_special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    if weekday in dow:
+        return True
+    for rule in dow_special:
+        if weekday == rule[1]:
+            if rule[0] == 'weekday_last' and day.day + 7 > last:
+                return True
+            if rule[0] == 'weekday_nth' and (day.day - 1) // 7 + 1 == rule[2]:
+                return True
+    return False
+
 
