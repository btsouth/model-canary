index 8965296..d24e1ed 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,238 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import re
+from datetime import datetime, time, timedelta
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        "jan feb mar apr may jun jul aug sep oct nov dec".split(), start=1
+    )
+}
+_DOW_NAMES = {
+    name: number
+    for number, name in enumerate("sun mon tue wed thu fri sat".split())
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_SEARCH_DAYS = 10 * 365
+
+
+def _is_number(text):
+    return bool(text) and text.isascii() and text.isdigit()
+
+
+def _parse_value(text, low, high, names, allow_names):
+    if _is_number(text):
+        value = int(text)
+    elif allow_names and names is not None and text.lower() in names:
+        value = names[text.lower()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _parse_single_or_range(text, low, high, names, allow_names):
+    parts = text.split("-")
+    if len(parts) == 1:
+        return _parse_value(parts[0], low, high, names, allow_names)
+    if len(parts) == 2:
+        start = _parse_value(parts[0], low, high, names, allow_names)
+        end = _parse_value(parts[1], low, high, names, allow_names)
+        if start > end:
+            raise ValueError(f"range starts after it ends: {text!r}")
+        return start, end
+    raise ValueError(f"bad range: {text!r}")
+
+
+def _item_values(item, low, high, names):
+    if "/" in item:
+        base, step_text = item.split("/", 1)
+        if not _is_number(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+        if base == "*":
+            start, end = low, high
+        else:
+            # Names are not allowed in a step.
+            value = _parse_single_or_range(base, low, high, names, False)
+            if isinstance(value, tuple):
+                start, end = value
+            else:
+                start, end = value, high
+        return list(range(start, end + 1, step))
+
+    if item == "*":
+        return list(range(low, high + 1))
+
+    value = _parse_single_or_range(item, low, high, names, True)
+    if isinstance(value, tuple):
+        return list(range(value[0], value[1] + 1))
+    return [value]
+
+
+def _split_items(field):
+    items = field.split(",")
+    if any(item == "" for item in items):
+        raise ValueError("empty item")
+    return items
+
+
+def _parse_simple(field, low, high, names):
+    values = set()
+    for item in _split_items(field):
+        values.update(_item_values(item, low, high, names))
+    return frozenset(values)
+
+
+def _parse_day_of_month(field):
+    if field == "?":
+        field = "*"
+    values = set()
+    last = False
+    for item in _split_items(field):
+        if item == "L":
+            last = True
+            continue
+        if "L" in item or "#" in item:
+            raise ValueError(f"bad day-of-month item: {item!r}")
+        values.update(_item_values(item, 1, 31, None))
+    return frozenset(values), last
+
+
+def _parse_day_of_week(field):
+    if field == "?":
+        field = "*"
+    values = set()
+    last = set()
+    nth = set()
+    for item in _split_items(field):
+        match = re.fullmatch(r"([0-9]+)L", item)
+        if match:
+            day = int(match.group(1))
+            if not 0 <= day <= 7:
+                raise ValueError(f"day out of range: {item!r}")
+            last.add(day % 7)
+            continue
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if match:
+            day = int(match.group(1))
+            occurrence = int(match.group(2))
+            if not 0 <= day <= 7 or not 1 <= occurrence <= 5:
+                raise ValueError(f"bad day-of-week item: {item!r}")
+            nth.add((day % 7, occurrence))
+            continue
+        if "L" in item or "#" in item:
+            raise ValueError(f"bad day-of-week item: {item!r}")
+        values.update(value % 7 for value in _item_values(item, 0, 7, _DOW_NAMES))
+    return frozenset(values), frozenset(last), frozenset(nth)
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        shortcut = _SHORTCUTS.get(text.lower())
+        if shortcut is None:
+            raise ValueError(f"unknown shortcut: {text!r}")
+        text = shortcut
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    minute, hour, day_of_month, month, day_of_week = fields
+    return (
+        _parse_simple(minute, 0, 59, None),
+        _parse_simple(hour, 0, 23, None),
+        _parse_day_of_month(day_of_month),
+        _parse_simple(month, 1, 12, _MONTH_NAMES),
+        _parse_day_of_week(day_of_week),
+    )
+
+
+def _day_matches(day, day_of_month, day_of_week):
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    values, last = day_of_month
+    if day.day not in values and not (last and day.day == days_in_month):
+        return False
+
+    weekday = (day.weekday() + 1) % 7
+    values, last, nth = day_of_week
+    if weekday in values:
+        return True
+    if weekday in last and day.day > days_in_month - 7:
+        return True
+    for nth_day, occurrence in nth:
+        if weekday == nth_day and (day.day - 1) // 7 + 1 == occurrence:
+            return True
+    return False
+
+
+def _first_time_on_day(hours, minutes, after_hour, after_minute):
+    index = bisect.bisect_left(hours, after_hour)
+    if index >= len(hours):
+        return None
+    hour = hours[index]
+    if hour == after_hour:
+        minute_index = bisect.bisect_left(minutes, after_minute)
+        if minute_index < len(minutes):
+            return time(hour, minutes[minute_index])
+        index += 1
+        if index >= len(hours):
+            return None
+        hour = hours[index]
+    return time(hour, minutes[0])
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    minutes, hours, day_of_month, month, day_of_week = _parse(expr)
+    return (
+        when.minute in minutes
+        and when.hour in hours
+        and when.month in month
+        and _day_matches(when.date(), day_of_month, day_of_week)
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    minutes, hours, day_of_month, month, day_of_week = _parse(expr)
+    hour_list = sorted(hours)
+    minute_list = sorted(minutes)
+
+    start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    limit = after + timedelta(days=_SEARCH_DAYS)
+
+    day = start.date()
+    last_day = limit.date()
+    while day <= last_day:
+        if day.month in month and _day_matches(day, day_of_month, day_of_week):
+            if day == start.date():
+                found = _first_time_on_day(
+                    hour_list, minute_list, start.hour, start.minute
+                )
+            else:
+                found = _first_time_on_day(hour_list, minute_list, 0, 0)
+            if found is not None:
+                candidate = datetime.combine(day, found)
+                if candidate <= limit:
+                    return candidate
+                return None
+        day += timedelta(days=1)
+    return None
