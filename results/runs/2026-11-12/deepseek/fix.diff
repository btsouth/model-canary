+
+    sign = -1 if total < 0 else 1
+    amount = abs(total)
+    exact = [Fraction(amount) * w / whole for w in fractions]
+    shares = [math.floor(share) for share in exact]
+    left = amount - sum(shares)
+
+    # Largest remainder first; on a tie, the earlier share wins.
+    order = sorted(range(len(shares)), key=lambda i: (shares[i] - exact[i], i))
+    for i in order[:left]:
+        shares[i] += 1
+    return [sign * share for share in shares]
 
 
