--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,173 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+_NUMBER = re.compile(r"^[0-9]+$")
+_NTH = re.compile(r"^([0-9]+)#([0-9]+)$")
+_LAST_DOW = re.compile(r"^([0-9]+)L$")
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+def _value(text, low, high, names):
+    """Parse a single number or name, in the range low..high."""
+    if _NUMBER.match(text):
+        n = int(text)
+    elif names and text.upper() in names:
+        n = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= n <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return n
+
+
+def _item(text, low, high, names):
+    """Expand one item (*, N, A-B, optionally /S) into a list of values in order."""
+    if text == "":
+        raise ValueError("empty item")
+    step = 1
+    if "/" in text:
+        base, _, step_text = text.partition("/")
+        if not _NUMBER.match(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {text!r}")
+        step = int(step_text)
+    else:
+        base = text
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        a, b = _value(a, low, high, names), _value(b, low, high, names)
+        if a > b:
+            raise ValueError(f"range {base!r} runs backwards")
+        values = list(range(a, b + 1))
+    elif step != 1:
+        values = list(range(_value(base, low, high, names), high + 1))
+    else:
+        values = [_value(base, low, high, names)]
+    return values[::step]
+
+
+def _field(text, low, high, names=None):
+    values = set()
+    for item in text.split(","):
+        values.update(_item(item, low, high, names))
+    return values
+
+
+def _day_of_month(text):
+    """Return (set of days, last-day flag)."""
+    if text == "?":
+        return set(range(1, 32)), False
+    days, last = set(), False
+    for item in text.split(","):
+        if item == "L":
+            last = True
+        else:
+            days.update(_item(item, 1, 31, None))
+    return days, last
+
+
+def _day_of_week(text):
+    """Return (set of weekdays 0-6, set of last-N, set of (N, K))."""
+    if text == "?":
+        return set(range(7)), set(), set()
+    days, lasts, nths = set(), set(), set()
+    for item in text.split(","):
+        m = _LAST_DOW.match(item)
+        if m:
+            lasts.add(_value(m.group(1), 0, 7, None) % 7)
+            continue
+        m = _NTH.match(item)
+        if m:
+            n = _value(m.group(1), 0, 7, None) % 7
+            k = int(m.group(2))
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad week number in {item!r}")
+            nths.add((n, k))
+            continue
+        days.update(v % 7 for v in _item(item, 0, 7, _DAYS))
+    return days, lasts, nths
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            try:
+                text = _SHORTCUTS[text.lower()]
+            except KeyError:
+                raise ValueError(f"unknown shortcut {text!r}") from None
+        parts = text.split()
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields in {expr!r}")
+        minute, hour, dom, month, dow = parts
+        self.minutes = _field(minute, 0, 59)
+        self.hours = _field(hour, 0, 23)
+        self.dom, self.dom_last = _day_of_month(dom)
+        self.months = _field(month, 1, 12, _MONTHS)
+        self.dow, self.dow_last, self.dow_nth = _day_of_week(dow)
+
+    def day_allowed(self, date):
+        days_in_month = calendar.monthrange(date.year, date.month)[1]
+        day, weekday = date.day, (date.weekday() + 1) % 7
+        dom_ok = day in self.dom or (self.dom_last and day == days_in_month)
+        dow_ok = (
+            weekday in self.dow
+            or (weekday in self.dow_last and day + 7 > days_in_month)
+            or (weekday, (day - 1) // 7 + 1) in self.dow_nth
+        )
+        return dom_ok and dow_ok
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    sched = _Schedule(expr)
+    return (
