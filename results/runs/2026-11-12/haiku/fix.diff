--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,194 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAY_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_NUM = re.compile(r"[0-9]+")
+_STEP = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Z]{3}")
+_NL = re.compile(r"([0-9]+)L")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+class _Spec:
+    """A parsed expression: concrete sets of allowed values for each field."""
+
+    def __init__(self, minutes, hours, days, months, weekdays, last_weekdays, nth_weekdays):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.days = days                    # plain day-of-month numbers
+        self.months = months
+        self.weekdays = weekdays            # plain weekdays, 0 = Sunday .. 6
+        self.last_weekdays = last_weekdays  # weekdays whose last occurrence is allowed
+        self.nth_weekdays = nth_weekdays    # (weekday, K) pairs
+
+        self.dom_last = False               # L in the day-of-month field
+
+    def day_allowed(self, day):
+        """True if the date `day` matches both day fields."""
+        if day.month not in self.months:
+            return False
+        dom_ok = day.day in self.days or (self.dom_last and day.day == calendar.monthrange(day.year, day.month)[1])
+        if not dom_ok:
+            return False
+        wd = (day.weekday() + 1) % 7  # Sunday = 0
+        if wd in self.weekdays:
+            return True
+        if wd in self.last_weekdays and day.day + 7 > calendar.monthrange(day.year, day.month)[1]:
+            return True
+        return ((wd, (day.day - 1) // 7 + 1) in self.nth_weekdays)
+
+
+def _number(text, low, high, what):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad {what}: {text!r}")
+    n = int(text)
+    if not low <= n <= high:
+        raise ValueError(f"{what} {n} out of range {low}-{high}")
+    return n
+
+
+def _value(text, low, high, names, what):
+    """A single number, or a name from `names` if the field has names."""
+    if names is not None and _NAME.fullmatch(text):
+        if text not in names:
+            raise ValueError(f"unknown {what} name: {text!r}")
+        return names[text]
+    return _number(text, low, high, what)
+
+
+def _parse_field(text, low, high, what, names=None, dom=False, dow=False):
+    """Parse one field into (values, has_last, last_weekdays, nth_weekdays).
+
+    values: set of plain values (for dow, reduced mod 7 so 7 becomes 0).
+    has_last: True if L appears (day of month only).
+    last_weekdays / nth_weekdays: NL and N#K entries (day of week only).
+    """
+    if text == "?":
+        if not (dom or dow):
+            raise ValueError(f"'?' not allowed in {what}")
+        text = "*"
+    values, has_last = set(), False
+    last_weekdays, nth_weekdays = set(), set()
+    if text == "":
+        raise ValueError(f"empty {what} field")
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {what}")
+        base, step = item, None
+        if "/" in item:
+            base, _, step_text = item.partition("/")
+            if not _STEP.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {what}: {item!r}")
+            step = int(step_text)
+            if not base:
+                raise ValueError(f"missing base in {what}: {item!r}")
+        if "?" in item:
+            raise ValueError(f"'?' only allowed as a whole {what} field")
+        if base == "*":
+            values.update(range(low, high + 1, step or 1))
+            continue
+        if dom and base == "L":
+            has_last = True          # single value; a step leaves it unchanged
+            continue
+        if dow and _NL.fullmatch(base):
+            n = int(_NL.fullmatch(base).group(1))
+            if not 0 <= n <= 7:
+                raise ValueError(f"weekday {n} out of range 0-7")
+            last_weekdays.add(n % 7)
+            continue
+        if dow and _NTH.fullmatch(base):
+            m = _NTH.fullmatch(base)
+            n, k = int(m.group(1)), int(m.group(2))
+            if not 0 <= n <= 7:
+                raise ValueError(f"weekday {n} out of range 0-7")
+            if not 1 <= k <= 5:
+                raise ValueError(f"occurrence {k} out of range 1-5")
+            nth_weekdays.add((n % 7, k))
+            continue
+        if base.count("-") > 1:
+            raise ValueError(f"bad item in {what}: {item!r}")
+        first, dash, last = base.partition("-")
+        if not first or (dash and not last):
+            raise ValueError(f"bad item in {what}: {item!r}")
+        a = _value(first, low, high, names, what)
+        b = _value(last, low, high, names, what) if dash else a
+        if a > b:
+            raise ValueError(f"range start after end in {what}: {item!r}")
+        values.update(range(a, b + 1, step or 1))
+    if dow:
+        values = {v % 7 for v in values}
+    return values, has_last, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    """Validate expr and return a _Spec. Raises ValueError for anything bad."""
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    key = expr.strip().lower()
+    if key in _SHORTCUTS:
+        expr = _SHORTCUTS[key]
+    fields = re.split(r"[ \t]+", expr.strip())
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields)}: {expr!r}")
+    minute_t, hour_t, dom_t, month_t, dow_t = fields
+
+    minutes, _, _, _ = _parse_field(minute_t, 0, 59, "minute")
+    hours, _, _, _ = _parse_field(hour_t, 0, 23, "hour")
+    months, _, _, _ = _parse_field(month_t.upper(), 1, 12, "month", names=_MONTH_NAMES)
+    days, dom_last, _, _ = _parse_field(dom_t, 1, 31, "day of month", dom=True)
+    weekdays, _, last_wd, nth_wd = _parse_field(
+        dow_t.upper(), 0, 7, "day of week", names=_DAY_NAMES, dow=True)
+
+    spec = _Spec(minutes, hours, days, months, weekdays, last_wd, nth_wd)
+    spec.dom_last = dom_last
+    return spec
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    if when.minute not in spec.minutes or when.hour not in spec.hours:
+        return False
+    return spec.day_allowed(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + _dt.timedelta(minutes=1)
+        try:
+            limit = after + _dt.timedelta(days=3650)
+        except OverflowError:
+            limit = _dt.datetime.max
+        day = start.date()
+        while day <= limit.date():
+            if spec.day_allowed(day):
+                for h in spec.hours:
+                    for m in spec.minutes:
+                        cand = _dt.datetime(day.year, day.month, day.day, h, m)
+                        if cand < start:
+                            continue
+                        if cand > limit:
+                            return None
+                        return cand
+            day += _dt.timedelta(days=1)
+    except OverflowError:  # no representable run after the end of datetime
+        return None
+    return None
