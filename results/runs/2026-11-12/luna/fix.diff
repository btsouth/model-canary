+        step = 1
+        if len(bits)==2:
+            if not bits[1].isdigit() or int(bits[1]) < 1: raise ValueError("bad step")
+            step=int(bits[1])
+        base=bits[0]
+        if base == "*": seq=list(range(limits[0], limits[1]+1))
+        elif "-" in base:
+            if base.count("-") != 1: raise ValueError("bad range")
+            a,b=base.split("-"); a=_value(a,names); b=_value(b,names)
+            _check(a,limits); _check(b,limits)
+            if a>b: raise ValueError("descending range")
