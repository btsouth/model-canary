+
+def _value(s,names):
+    if s.upper() in names: return names[s.upper()]
+    if not s.isdigit(): raise ValueError("bad value")
+    return int(s)
+
+def _check(n, limits):
+    if not limits[0] <= n <= limits[1]: raise ValueError("out of range")
+
+def _compile(expr):
+    if not isinstance(expr, str): raise ValueError("bad expression")
+    raw=expr.strip()
+    if raw.lower().startswith("@"):
+        try: raw=_SHORTCUTS[raw.lower()]
+        except KeyError: raise ValueError("unknown shortcut") from None
+    parts=re.split(r"[ \t]+", raw) if raw else []
+    if len(parts)!=5: raise ValueError("expected five fields")
+    parsed=[_parse_field(p,i) for i,p in enumerate(parts)]
+    return parsed
+
+def _daymatch(parsed, day):
