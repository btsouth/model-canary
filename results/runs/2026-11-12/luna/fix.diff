+def _parse_field(src, field):
+    limits = [(0,59),(0,23),(1,31),(1,12),(0,7)][field]
+    names = _MONTH if field == 3 else _DOW if field == 4 else {}
+    values, specials = set(), []
+    if field in (2,4) and src == "?": src = "*"
+    for item in src.split(","):
+        if not item: raise ValueError("empty item")
+        if field == 2 and item == "L":
+            specials.append(("lastday",)); continue
+        if field == 4:
+            m = re.fullmatch(r"(\d+)L", item)
+            if m:
+                n=int(m.group(1)); _check(n, limits); specials.append(("lastdow", n % 7)); continue
+            m = re.fullmatch(r"(\d+)#([1-5])", item)
+            if m:
