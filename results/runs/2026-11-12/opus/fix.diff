 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last", "dom_any",
+                 "dow", "dow_last", "dow_nth", "dow_any")
+
+    def day_allowed(self, day):
+        if not self.dom_any:
+            last = calendar.monthrange(day.year, day.month)[1]
+            if not (day.day in self.dom or (self.dom_last and day.day == last)):
+                return False
+        if not self.dow_any:
+            weekday = (day.weekday() + 1) % 7
+            if weekday in self.dow:
+                return True
+            if weekday in self.dow_last:
+                last = calendar.monthrange(day.year, day.month)[1]
+                if day.day + 7 > last:
+                    return True
+            if (weekday, (day.day - 1) // 7 + 1) in self.dow_nth:
+                return True
+            return False
+        return True
+
+
+def _value(text, low, high, names):
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _dow_number(text):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad day of week {text!r}")
+    value = int(text)
+    if not 0 <= value <= 7:
+        raise ValueError(f"day of week {text!r} out of range")
+    return value % 7
+
+
+def _parse_field(text, index):
+    """Return (values, last, special, is_any) for one field."""
+    low, high, names = _FIELDS[index]
+    is_day = index in (2, 4)
+    if text == "?":
+        if not is_day:
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(), False, set(), True
+    is_any = text == "*"
+    values, last, special = set(), False, set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if index == 2 and item == "L":
+            last = True
+            continue
+        if index == 4:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                special.add(("last", _dow_number(m.group(1))))
+                continue
+            m = _NTH_DOW.fullmatch(item)
+            if m:
+                k = m.group(2)
+                if not _NUM.fullmatch(k) or not 1 <= int(k) <= 5:
+                    raise ValueError(f"bad occurrence in {item!r}")
+                special.add(("nth", _dow_number(m.group(1)), int(k)))
+                continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not _NUM.fullmatch(step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1 in {item!r}")
+        else:
+            step = 1
+        if base == "*":
+            start, stop = low, high
+        elif "-" in base:
+            a, dash, b = base.partition("-")
+            start = _value(a, low, high, names)
+            stop = _value(b, low, high, names)
+            if start > stop:
+                raise ValueError(f"range {base!r} is backwards")
+        else:
+            start = _value(base, low, high, names)
+            stop = high if slash else start
+        values.update(range(start, stop + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, last, special, is_any
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"schedule must be a string, not {type(expr).__name__}")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {text!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)} in {expr!r}")
+    parsed = [_parse_field(part, i) for i, part in enumerate(parts)]
+    s = _Schedule()
+    s.minutes = sorted(parsed[0][0])
+    s.hours = sorted(parsed[1][0])
+    s.months = parsed[3][0]
+    s.dom, s.dom_last, _, s.dom_any = parsed[2]
+    s.dow, _, special, s.dow_any = parsed[4]
+    s.dow_last = {item[1] for item in special if item[0] == "last"}
+    s.dow_nth = {(item[1], item[2]) for item in special if item[0] == "nth"}
+    return s
 
 
