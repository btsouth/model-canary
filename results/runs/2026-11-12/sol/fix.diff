 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+     "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values = set()
+    special = []
+    if text == "?" and index in (2, 4):
+        text = "*"
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return number
+
+    for item in text.split(","):
+        if item == "L" and index == 2:
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item) if index == 4 else None
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item) if index == 4 else None
+        if last:
+            special.append(("last_weekday", value(last[1]) % 7))
+            continue
+        if nth:
+            weekday, occurrence = value(nth[1]) % 7, _number(nth[2])
+            if not 1 <= occurrence <= 5:
+                raise ValueError("weekday occurrence must be 1 through 5")
+            special.append(("nth_weekday", weekday, occurrence))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(value, endpoints)
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError("range starts after its end")
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {day % 7 for day in values}
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("a schedule must have five fields")
+    return tuple(_field(field, i) for i, field in enumerate(fields))
+
+
+def _day_matches(parsed, day):
+    if day.month not in parsed[3][0]:
+        return False
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    month_days, month_special = parsed[2]
+    if day.day not in month_days and not (month_special and day.day == last_day):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    week_days, week_special = parsed[4]
+    if weekday in week_days:
+        return True
+    for rule in week_special:
+        if weekday != rule[1]:
+            continue
+        if rule[0] == "last_weekday" and day.day + 7 > last_day:
+            return True
+        if rule[0] == "nth_weekday" and (day.day - 1) // 7 + 1 == rule[2]:
+            return True
+    return False
+
 
