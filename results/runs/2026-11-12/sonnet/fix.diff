 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names.index(tok.upper()) + (1 if names is _MONTHS else 0)
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _parse_field(text, lo, hi, names=None, kind=None):
+    """Return (set of values, specials list)."""
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("? not allowed here")
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item.upper() == "L" and item == item.upper():
+            specials.append(("L",))
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)L", item)
+            if m:
+                specials.append(("last", _value(m.group(1), 0, 7, None) % 7))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError("bad occurrence")
+                specials.append(("nth", _value(m.group(1), 0, 7, None) % 7, k))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError("bad step")
+        base = parts[0]
+        if base == "*":
+            vals = list(range(lo, hi + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a > b:
+                raise ValueError("descending range")
+            vals = list(range(a, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            vals = list(range(a, hi + 1)) if len(parts) == 2 else [a]
+        if len(parts) == 2:
+            if not _NUM.fullmatch(parts[1]) or int(parts[1]) < 1:
+                raise ValueError("bad step")
+            vals = vals[::int(parts[1])]
+        values.update(vals)
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError("unknown shortcut")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minute = _parse_field(parts[0], 0, 59)[0]
+    hour = _parse_field(parts[1], 0, 23)[0]
+    dom = _parse_field(parts[2], 1, 31, None, "dom")
+    month = _parse_field(parts[3], 1, 12, _MONTHS)[0]
+    dow = _parse_field(parts[4], 0, 7, _DAYS, "dow")
+    return sorted(minute), sorted(hour), dom, month, dow
+
+
+def _day_ok(day, dom, dow):
+    dvals, dspec = dom
+    wvals, wspec = dow
+    last = calendar.monthrange(day.year, day.month)[1]
+    ok = day.day in dvals or any(day.day == last for s in dspec)
+    if not ok:
+        return False
+    wd = (day.weekday() + 1) % 7
+    if wd in wvals:
+        return True
+    for s in wspec:
+        if s[0] == "last" and wd == s[1] and day.day + 7 > last:
+            return True
+        if s[0] == "nth" and wd == s[1] and (day.day - 1) // 7 + 1 == s[2]:
+            return True
+    return False
 
 
