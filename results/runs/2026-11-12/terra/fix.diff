 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_NAMES = [None, None, None,
+          {name.upper(): i for i, name in enumerate(calendar.month_abbr) if i},
+          {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}]
+_LIMITS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(token):
+            if re.fullmatch(r'[0-9]+', token):
+                n = int(token)
+            elif _NAMES[index] is not None and token.upper() in _NAMES[index]:
+                n = _NAMES[index][token.upper()]
+            else:
+                raise ValueError('invalid value')
+            if not low <= n <= high:
+                raise ValueError('value out of range')
+            return n
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            m = re.fullmatch(r'([0-7])L|([0-7])#([1-5])', item) if index == 4 else None
+            if m:
+                special.append(('last_weekday', int(m.group(1)) % 7) if m.group(1) is not None
+                               else ('nth', int(m.group(2)) % 7, int(m.group(3))))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                start, end = low, high
+            elif '-' in base:
+                parts = base.split('-')
+                if len(parts) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, parts)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = high if len(pieces) == 2 else start
+            values.update(n % 7 if index == 4 else n for n in range(start, end + 1, step))
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    return ((date.day in dom or bool(dom_special and date.day == last)) and
+            (weekday in dow or any(
+                (rule[0] == 'last_weekday' and weekday == rule[1] and date.day + 7 > last) or
+                (rule[0] == 'nth' and weekday == rule[1] and (date.day - 1) // 7 + 1 == rule[2])
+                for rule in dow_special)))
+
+
