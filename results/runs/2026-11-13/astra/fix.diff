 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    "SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if re.fullmatch(r"[0-9]+", text) is None:
+        raise ValueError("expected decimal digits")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+    unrestricted = text in ("*", "?")
+    if text == "?" and index in (2, 4):
+        text = "*"
+
+    def value(token):
+        n = names[token] if token in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError("value out of range")
+        return n
+
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last", 0))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if index == 4 and special:
+            weekday = value(special[1]) % 7
+            if special[2] == "L":
+                specials.append(("last", weekday))
+            else:
+                occurrence = _number(special[3])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence out of range")
+                specials.append((occurrence, weekday))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError("invalid range")
+            start, end = map(value, endpoints)
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError("reversed range")
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {n % 7 for n in values}
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown shortcut") from None
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    return tuple(_field(part, i) for i, part in enumerate(parts))
+
+
+def _day_matches(fields, year, month, day, last):
+    dom, dom_specials, dom_any = fields[2]
+    dow, dow_specials, dow_any = fields[4]
+    month_day = day in dom or (bool(dom_specials) and day == last)
+    weekday = (datetime(year, month, day).weekday() + 1) % 7
+    week_day = weekday in dow or any(
+        weekday == n and (day + 7 > last if kind == "last"
+                          else (day - 1) // 7 + 1 == kind)
+        for kind, n in dow_specials
+    )
+    if dom_any and dow_any:
+        return True
+    if dom_any:
+        return week_day
+    if dow_any:
+        return month_day
+    return month_day or week_day
+
 
