--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,274 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from collections import namedtuple
+from datetime import datetime, timedelta
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+_DOW_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6,
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+_Schedule = namedtuple(
+    "_Schedule",
+    "minutes hours months dom dom_last dom_unrestricted "
+    "dow dow_last dow_nth dow_unrestricted",
+)
+
+_LIMIT_DAYS = 50 * 365
+
+
+def _number(text, low, high, names=None):
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad value: {text!r}")
+    value = int(text)
+    if value < low or value > high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _expand(base, low, high, names, step, stepped, allow_names):
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range: {base!r}")
+        left, right = base.split("-")
+        if not left or not right:
+            raise ValueError(f"bad range: {base!r}")
+        usable_names = names if allow_names else None
+        start = _number(left, low, high, usable_names)
+        end = _number(right, low, high, usable_names)
+        if start > end:
+            raise ValueError(f"range starts after it ends: {base!r}")
+        values = list(range(start, end + 1))
+    else:
+        value = _number(base, low, high, names if allow_names else None)
+        values = list(range(value, high + 1)) if stepped else [value]
+    return values[::step]
+
+
+def _parse_item(item, low, high, names):
+    if not item:
+        raise ValueError("empty item")
+    if "/" in item:
+        if item.count("/") != 1:
+            raise ValueError(f"bad step: {item!r}")
+        base, step_text = item.split("/")
+        if not base or not step_text:
+            raise ValueError(f"bad step: {item!r}")
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+        return _expand(base, low, high, names, step, True, False)
+    return _expand(item, low, high, names, 1, False, True)
+
+
+def _parse_simple(field, low, high, names=None):
+    if not field:
+        raise ValueError("empty field")
+    values = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+        values.update(_parse_item(item, low, high, names))
+    return values
+
+
+def _parse_day(field, kind):
+    if field == "?":
+        return set(), False, set(), [], True
+
+    if kind == "dom":
+        low, high, names = 1, 31, None
+    else:
+        low, high, names = 0, 7, _DOW_NAMES
+
+    values = set()
+    has_last = False
+    last_dows = set()
+    nth_dows = []
+
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+
+        if kind == "dom" and item == "L":
+            has_last = True
+            continue
+
+        if kind == "dow":
+            match = _LAST_DOW.fullmatch(item)
+            if match:
+                day = int(match.group(1))
+                if day < 0 or day > 7:
+                    raise ValueError(f"day of week out of range: {item!r}")
+                last_dows.add(day % 7)
+                continue
+
+            match = _NTH_DOW.fullmatch(item)
+            if match:
+                day = int(match.group(1))
+                occurrence = int(match.group(2))
+                if day < 0 or day > 7:
+                    raise ValueError(f"day of week out of range: {item!r}")
+                if occurrence < 1 or occurrence > 5:
+                    raise ValueError(f"bad occurrence: {item!r}")
+                nth_dows.append((day % 7, occurrence))
+                continue
+
+        values.update(_parse_item(item, low, high, names))
+
+    if kind == "dow":
+        values = {value % 7 for value in values}
+
+    return values, has_last, last_dows, nth_dows, field == "*"
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule")
+
+    if text.startswith("@"):
+        shortcut = text.lower()
+        if shortcut not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[shortcut]
+
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"wrong number of fields: {expr!r}")
+
+    minute_text, hour_text, dom_text, month_text, dow_text = parts
+    minutes = _parse_simple(minute_text, 0, 59)
+    hours = _parse_simple(hour_text, 0, 23)
+    months = _parse_simple(month_text, 1, 12, _MONTH_NAMES)
+    dom, dom_last, _, _, dom_unrestricted = _parse_day(dom_text, "dom")
+    dow, _, dow_last, dow_nth, dow_unrestricted = _parse_day(dow_text, "dow")
+
+    return _Schedule(
+        tuple(sorted(minutes)),
+        tuple(sorted(hours)),
+        frozenset(months),
+        frozenset(dom),
+        dom_last,
+        dom_unrestricted,
+        frozenset(dow),
+        frozenset(dow_last),
+        tuple(dow_nth),
+        dow_unrestricted,
+    )
+
+
+def _day_allowed(schedule, year, month, day):
+    dom_restricted = not schedule.dom_unrestricted
+    dow_restricted = not schedule.dow_unrestricted
+
+    if not dom_restricted and not dow_restricted:
+        return True
+
+    last_day = calendar.monthrange(year, month)[1]
+
+    dom_match = False
+    if dom_restricted:
+        dom_match = day in schedule.dom or (schedule.dom_last and day == last_day)
+
+    dow_match = False
+    if dow_restricted:
+        cron_day = (datetime(year, month, day).weekday() + 1) % 7
+        dow_match = cron_day in schedule.dow
+        if not dow_match:
+            dow_match = any(
+                cron_day == weekday and day + 7 > last_day
+                for weekday in schedule.dow_last
+            )
+        if not dow_match:
+            dow_match = any(
+                cron_day == weekday and (day - 1) // 7 + 1 == occurrence
+                for weekday, occurrence in schedule.dow_nth
+            )
+
+    if dom_restricted and dow_restricted:
+        return dom_match or dow_match
+    if dom_restricted:
+        return dom_match
+    return dow_match
+
 
 def matches(expr, when):
