 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = datetime.timedelta(days=50 * 365)
+_MINUTE = datetime.timedelta(minutes=1)
+
+
+def _value(token, lo, hi, names):
+    if _NUMBER.fullmatch(token):
+        number = int(token)
+    elif names and token.upper() in names:
+        number = names[token.upper()]
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if not lo <= number <= hi:
+        raise ValueError(f"value out of range: {token!r}")
+    return number
+
+
+def _field(text, lo, hi, names=None, kind=None):
+    """Return (values, last, last_dows, nth_dows, restricted) for one field."""
+    values, last, last_dows, nth_dows = set(), False, set(), set()
+    if text == "?":
+        if kind is None:
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(range(lo, hi + 1)), last, last_dows, nth_dows, False
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item == "L":
+            last = True
+            continue
+        if kind == "dow":
+            match = _LAST_DOW.fullmatch(item)
+            if match:
+                last_dows.add(_value(match.group(1), 0, 7, None) % 7)
+                continue
+            match = _NTH_DOW.fullmatch(item)
+            if match:
+                nth = int(match.group(2))
+                if not 1 <= nth <= 5:
+                    raise ValueError(f"bad item: {item!r}")
+                nth_dows.add((_value(match.group(1), 0, 7, None) % 7, nth))
+                continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+        if base == "*":
+            listed = range(lo, hi + 1)
+        elif "-" in base:
+            first, _, second = base.partition("-")
+            first = _value(first, lo, hi, names)
+            second = _value(second, lo, hi, names)
+            if first > second:
+                raise ValueError(f"bad range: {item!r}")
+            listed = range(first, second + 1)
+        else:
+            first = _value(base, lo, hi, names)
+            listed = range(first, hi + 1) if slash else range(first, first + 1)
+        values.update(listed[::step])
+    return values, last, last_dows, nth_dows, text != "*"
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad expression: {expr!r}")
+        expr = expr.strip()
+        if expr.startswith("@"):
+            if expr.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            expr = _SHORTCUTS[expr.lower()]
+        parts = re.split(r"[ \t]+", expr)
+        if len(parts) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        self.minutes = sorted(_field(parts[0], 0, 59)[0])
+        self.hours = sorted(_field(parts[1], 0, 23)[0])
+        self.doms, self.last, _, _, self.dom_restricted = _field(
+            parts[2], 1, 31, kind="dom")
+        self.months = _field(parts[3], 1, 12, _MONTHS)[0]
+        dows, _, self.last_dows, self.nth_dows, self.dow_restricted = _field(
+            parts[4], 0, 7, _DAYS, kind="dow")
+        self.dows = {d % 7 for d in dows}
+
+    def days(self, year, month):
+        """The allowed days of a month, in order."""
+        first_weekday, length = calendar.monthrange(year, month)
+        if not self.dom_restricted and not self.dow_restricted:
+            return list(range(1, length + 1))
+        result = []
+        for day in range(1, length + 1):
+            by_dom = self.dom_restricted and (
+                day in self.doms or (self.last and day == length))
+            by_dow = False
+            if self.dow_restricted and not by_dom:
+                dow = (first_weekday + day) % 7  # Sunday is 0
+                by_dow = (
+                    dow in self.dows
+                    or (dow in self.last_dows and day + 7 > length)
+                    or (dow, (day - 1) // 7 + 1) in self.nth_dows)
+            if by_dom or by_dow:
+                result.append(day)
+        return result
 
 
