+def _tokenize(text):
+    """Split text on SEP outside quotes.
+
+    Returns a list of (tokens, raw) pairs, one per field. Each token is (char, quoted),
+    where quoted says whether the char was inside quotes. Quote marks are dropped from
+    tokens, and two QUOTE characters in a row inside quotes give one literal QUOTE.
+    raw is the field's text exactly as written.
+    """
+    fields = []
+    tokens, raw = [], []
+    quoted = False
+    i, n = 0, len(text)
+    while i < n:
+        ch = text[i]
+        if ch == QUOTE:
+            raw.append(ch)
+            if quoted and i + 1 < n and text[i + 1] == QUOTE:
+                tokens.append((QUOTE, True))
+                raw.append(QUOTE)
+                i += 2
+                continue
+            quoted = not quoted
+        elif ch == SEP and not quoted:
+            fields.append((tokens, raw))
+            tokens, raw = [], []
+        else:
+            raw.append(ch)
+            tokens.append((ch, quoted))
+        i += 1
+    if quoted:
+        raise ValueError(f"unclosed quote in {text!r}")
+    fields.append((tokens, raw))
+    return fields
+
+
+def _trim(tokens):
+    """Drop unquoted whitespace at both ends and return the text."""
+    start, end = 0, len(tokens)
+    while start < end and tokens[start][0].isspace() and not tokens[start][1]:
+        start += 1
+    while end > start and tokens[end - 1][0].isspace() and not tokens[end - 1][1]:
+        end -= 1
+    return "".join(ch for ch, _ in tokens[start:end])
+
