 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, time, timedelta
+
+_SEARCH_DAYS = 50 * 365
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {"jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6,
+           "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12}
+_DAYS = {"sun": 0, "mon": 1, "tue": 2, "wed": 3, "thu": 4, "fri": 5, "sat": 6}
+
+# kind: (lowest, highest, names)
+_RANGES = {
+    "minute": (0, 59, None),
+    "hour": (0, 23, None),
+    "dom": (1, 31, None),
+    "month": (1, 12, _MONTHS),
+    "dow": (0, 7, _DAYS),
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)[Ll]")
+
+
+class _Schedule:
+    """A compiled expression."""
+
+    def __init__(self, minutes, hours, months, dom, dom_restricted, dow, dow_restricted):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.months = frozenset(months)
+        self.dom_values, self.dom_last = dom
+        self.dom_restricted = dom_restricted
+        self.dow_values, self.dow_last, self.dow_nth = dow
+        self.dow_restricted = dow_restricted
+
+
+def _value(token, kind):
+    lo, hi, names = _RANGES[kind]
+    if _NUMBER.fullmatch(token):
+        v = int(token)
+    elif names is not None and len(token) == 3 and token.lower() in names:
+        v = names[token.lower()]
+    else:
+        raise ValueError(f"bad {kind} value: {token!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"{kind} value out of range: {v}")
+    return v
+
+
+def _small_weekday(token):
+    if not _NUMBER.fullmatch(token) or int(token) > 7:
+        raise ValueError(f"bad weekday number: {token!r}")
+    return int(token) % 7
+
+
+def _parse_item(item, kind):
+    """Return ('values', list), ('last', None), ('wdlast', wd) or ('nth', (wd, k))."""
+    if kind == "dom" and item.upper() == "L":
+        return "last", None
+    if kind == "dow":
+        m = _LAST_WEEKDAY.fullmatch(item)
+        if m:
+            return "wdlast", _small_weekday(m.group(1))
+        m = _NTH.fullmatch(item)
+        if m:
+            k = int(m.group(2))
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad occurrence: {k}")
+            return "nth", (_small_weekday(m.group(1)), k)
+
+    lo, hi, _ = _RANGES[kind]
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {step_text!r}")
+        step = int(step_text)
+
+    if base == "*":
+        a, b = lo, hi
+    elif "-" in base:
+        left, _, right = base.partition("-")
+        a, b = _value(left, kind), _value(right, kind)
+        if a > b:
+            raise ValueError(f"range runs backwards: {base!r}")
+    else:
+        a = _value(base, kind)
+        b = hi if slash else a
+    values = list(range(a, b + 1, step))
+    if kind == "dow":
+        values = [v % 7 for v in values]
+    return "values", values
+
+
+def _parse_field(text, kind):
+    """Return (values, last_day_or_weekdays, nth) for one field."""
+    lo, hi, _ = _RANGES[kind]
+    if kind in ("dom", "dow") and text == "?":
+        values = {v % 7 for v in range(lo, hi + 1)} if kind == "dow" else set(range(lo, hi + 1))
+        return values, False, set(), set()
+
+    values, last, wd_last, nth = set(), False, set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {kind} field {text!r}")
+        tag, payload = _parse_item(item, kind)
+        if tag == "values":
+            values.update(payload)
+        elif tag == "last":
+            last = True
+        elif tag == "wdlast":
+            wd_last.add(payload)
+        else:
+            nth.add(payload)
+    return values, last, wd_last, nth
+
+
+def _compile(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom, month, dow = parts
+
+    minutes, _, _, _ = _parse_field(minute, "minute")
+    hours, _, _, _ = _parse_field(hour, "hour")
+    months, _, _, _ = _parse_field(month, "month")
+    dom_values, dom_last, _, _ = _parse_field(dom, "dom")
+    dow_values, _, dow_last, dow_nth = _parse_field(dow, "dow")
+    return _Schedule(
+        minutes, hours, months,
+        (dom_values, dom_last), dom not in ("*", "?"),
+        (dow_values, dow_last, dow_nth), dow not in ("*", "?"),
+    )
+
+
+def _day_ok(s, day):
+    dim = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in s.dom_values or (s.dom_last and day.day == dim)
+    wd = day.isoweekday() % 7
+    dow_ok = (
+        wd in s.dow_values
+        or (wd in s.dow_last and day.day + 7 > dim)
+        or (wd, (day.day - 1) // 7 + 1) in s.dow_nth
+    )
+    if s.dom_restricted and s.dow_restricted:
+        return dom_ok or dow_ok
+    return dom_ok and dow_ok
+
 
