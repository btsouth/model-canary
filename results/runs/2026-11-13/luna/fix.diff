 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
 
+_SHORT = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+_RANGES = [(0,59),(0,23),(1,31),(1,12),(0,7)]
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    expr = _SHORT.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr) if expr else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    parsed = []
+    for idx, field in enumerate(fields):
+        if idx in (2,4) and field == "?":
+            parsed.append({"values": None, "unrestricted": True, "special": []})
+            continue
+        vals = set(); specials=[]
+        for item in field.split(","):
+            if not item: raise ValueError("empty item")
+            if idx == 2 and item == "L":
+                specials.append(("lastday",)); continue
+            if idx == 4:
+                m = re.fullmatch(r"(\d+|[A-Za-z]{3})(L|#([1-5]))", item)
+                if m:
+                    if m.group(2) == "L" and m.group(3) is None:
+                        n = _value(m.group(1), idx, names=False)
+                        specials.append(("lastweekday", n % 7)); continue
+                    if m.group(3):
+                        n = _value(m.group(1), idx, names=False)
+                        specials.append(("nthweekday", n % 7, int(m.group(3)))); continue
+            bits=item.split("/")
+            if len(bits)>2: raise ValueError("bad step")
+            step=1
+            if len(bits)==2:
+                if not bits[1].isdigit() or int(bits[1])<1: raise ValueError("bad step")
+                step=int(bits[1])
+            base=bits[0]; lo,hi=_RANGES[idx]
+            if base == "*": seq=list(range(lo,hi+1))
+            elif "-" in base:
+                if base.count("-") != 1: raise ValueError("bad range")
+                a,b=base.split("-"); a=_value(a,idx); b=_value(b,idx)
+                if a>b: raise ValueError("descending range")
+                seq=list(range(a,b+1))
+            else:
+                n=_value(base,idx)
+                seq=list(range(n,hi+1)) if len(bits)==2 else [n]
+            kept = seq[::step]
+            vals.update((n % 7 for n in kept) if idx == 4 else kept)
+        parsed.append({"values": vals, "unrestricted": field in ("*", "?"), "special": specials})
+    return parsed
+
+def _value(s, idx, names=True):
+    if names and idx==3 and s.upper() in _MONTHS: return _MONTHS[s.upper()]
+    if names and idx==4 and s.upper() in _DAYS: return _DAYS[s.upper()]
+    if not s.isdigit(): raise ValueError("bad field value")
+    n=int(s); lo,hi=_RANGES[idx]
+    if not lo<=n<=hi: raise ValueError("field value out of range")
+    return n
+
+def _day_ok(p, date):
+    dom,dow=p[2],p[4]
+    a=date.day in (dom["values"] or set())
+    for s in dom["special"]:
+        if s[0]=="lastday" and date.day==calendar.monthrange(date.year,date.month)[1]: a=True
+    cron_dow=(date.weekday()+1)%7
+    b=cron_dow in (dow["values"] or set())
+    for s in dow["special"]:
+        if s[0]=="lastweekday" and cron_dow==s[1] and date.day+7>calendar.monthrange(date.year,date.month)[1]: b=True
+        if s[0]=="nthweekday" and cron_dow==s[1] and (date.day-1)//7+1==s[2]: b=True
+    if dom["unrestricted"] and dow["unrestricted"]: return True
+    if dom["unrestricted"]: return b
+    if dow["unrestricted"]: return a
+    return a or b
+
+def _matches(p, when):
+    return (when.minute in p[0]["values"] and when.hour in p[1]["values"] and
+            when.month in p[3]["values"] and _day_ok(p,when.date()))
 
