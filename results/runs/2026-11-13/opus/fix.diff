index 8965296..45c0b9a 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,220 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {n: i for i, n in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun",
+     "jul", "aug", "sep", "oct", "nov", "dec"], start=1)}
+_DAYS = {n: i for i, n in enumerate(
+    ["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+
+# (low, high, names)
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_NUM = re.compile(r"[0-9]+\Z")
+_NAME = re.compile(r"[A-Za-z]{3}\Z")
+_SPLIT = re.compile(r"[ \t]+")
+
+_LIMIT = _dt.timedelta(days=50 * 365)
+
+
+def _number(text):
+    if not _NUM.match(text):
+        raise ValueError(f"bad number: {text!r}")
+    return int(text)
+
+
+def _value(text, low, high, names):
+    if names is not None and _NAME.match(text):
+        key = text.lower()
+        if key not in names:
+            raise ValueError(f"unknown name: {text!r}")
+        return names[key]
+    n = _number(text)
+    if not low <= n <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return n
+
+
+def _parse_field(text, index):
+    """Return (values, specials) for one field.
+
+    specials holds ('L',) for day-of-month L, and (n, 'L') or (n, k) for
+    day-of-week NL and N#K.
+    """
+    low, high, names = _FIELDS[index]
+    values, specials = set(), set()
+    if text == "?" and index in (2, 4):
+        return set(range(low, high + 1)), specials
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == 2 and item == "L":
+            specials.add(("L",))
+            continue
+        if index == 4 and "#" in item:
+            n_text, _, k_text = item.partition("#")
+            n = _number(n_text)
+            k = _number(k_text)
+            if not 0 <= n <= 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad item: {item!r}")
+            specials.add((n % 7, k))
+            continue
+        if index == 4 and item[-1:] == "L" and _NUM.match(item[:-1]):
+            n = _number(item[:-1])
+            if not 0 <= n <= 7:
+                raise ValueError(f"bad item: {item!r}")
+            specials.add((n % 7, "L"))
+            continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            step = _number(step_text)
+            if step < 1:
+                raise ValueError("step must be at least 1")
+        else:
+            step = 1
+        if base == "*":
+            first, last = low, high
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            first = _value(a_text, low, high, names)
+            last = _value(b_text, low, high, names)
+            if first > last:
+                raise ValueError(f"bad range: {item!r}")
+        else:
+            first = _value(base, low, high, names)
+            last = high if slash else first
+        values.update(range(first, last + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, specials
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("expression must be a string")
+        text = expr.strip()
+        if text.startswith("@"):
+            key = text.lower()
+            if key not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            text = _SHORTCUTS[key]
+        parts = _SPLIT.split(text)
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields: {expr!r}")
+        parsed = [_parse_field(p, i) for i, p in enumerate(parts)]
+        self.minutes = sorted(parsed[0][0])
+        self.hours = sorted(parsed[1][0])
+        self.dom, self.dom_special = parsed[2]
+        self.months = parsed[3][0]
+        self.dow, self.dow_special = parsed[4]
+        self.dom_restricted = parts[2] not in ("*", "?")
+        self.dow_restricted = parts[4] not in ("*", "?")
+
+    def _dom_ok(self, year, month, day, last):
+        return day in self.dom or (day == last and ("L",) in self.dom_special)
+
+    def _dow_ok(self, year, month, day, last):
+        wd = (_dt.date(year, month, day).weekday() + 1) % 7
+        if wd in self.dow:
+            return True
+        for n, k in self.dow_special:
+            if n != wd:
+                continue
+            if k == "L":
+                if day + 7 > last:
+                    return True
+            elif (day - 1) // 7 + 1 == k:
+                return True
+        return False
+
+    def day_ok(self, year, month, day):
+        last = calendar.monthrange(year, month)[1]
+        if self.dom_restricted and self.dow_restricted:
+            return (self._dom_ok(year, month, day, last)
+                    or self._dow_ok(year, month, day, last))
+        if self.dom_restricted:
+            return self._dom_ok(year, month, day, last)
+        if self.dow_restricted:
+            return self._dow_ok(year, month, day, last)
+        return True
+
+    def matches(self, when):
+        return (when.minute in self.minutes and when.hour in self.hours
+                and when.month in self.months
+                and self.day_ok(when.year, when.month, when.day))
+
+    def next_run(self, after):
+        base = after.replace(second=0, microsecond=0)
+        try:
+            start = base + _dt.timedelta(minutes=1)
+        except OverflowError:
+            return None
+        try:
+            limit = after + _LIMIT
+        except OverflowError:
+            limit = None
+        year, month = start.year, start.month
+        first_day = start.day
+        while True:
+            if limit is not None and (year, month) > (limit.year, limit.month):
+                return None
+            if month in self.months:
+                last = calendar.monthrange(year, month)[1]
+                for day in range(first_day, last + 1):
+                    if not self.day_ok(year, month, day):
+                        continue
+                    if (year, month, day) == (start.year, start.month, start.day):
+                        found = self._first_time(start.hour, start.minute)
+                        if found is None:
+                            continue
+                    else:
+                        found = (self.hours[0], self.minutes[0])
+                    result = _dt.datetime(year, month, day, *found)
+                    if limit is not None and result > limit:
+                        return None
+                    return result
+            first_day = 1
+            month += 1
+            if month > 12:
+                month = 1
+                year += 1
+                if year > _dt.MAXYEAR:
+                    return None
+
+    def _first_time(self, hour, minute):
+        for h in self.hours:
+            if h < hour:
+                continue
+            for m in self.minutes:
+                if h > hour or m >= minute:
+                    return h, m
+        return None
 
 
