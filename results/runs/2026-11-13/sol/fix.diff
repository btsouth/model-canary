 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_RANGES = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"bad number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _RANGES[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+    if text == "?" and index in (2, 4):
+        text = "*"
+
+    def value(token):
+        n = names[token] if token in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError(f"value out of range: {token!r}")
+        return n
+
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if index == 4:
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if special:
+                weekday = value(special[1]) % 7
+                if special[2] == "L":
+                    specials.append(("weekday_last", weekday))
+                else:
+                    occurrence = _number(special[3])
+                    if not 1 <= occurrence <= 5:
+                        raise ValueError("weekday occurrence out of range")
+                    specials.append(("weekday_nth", weekday, occurrence))
+                continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"bad item: {item!r}")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            bounds = base.split("-")
+            if len(bounds) != 2:
+                raise ValueError(f"bad range: {base!r}")
+            start, end = map(value, bounds)
+            if start > end:
+                raise ValueError("backwards range")
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {n % 7 for n in values}
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule requires five fields")
+    parsed = [_field(field, i) for i, field in enumerate(fields)]
+    return parsed, fields[2] in ("*", "?"), fields[4] in ("*", "?")
+
+
+def _allowed_day(parsed, dom_free, dow_free, year, month, day, last, weekday):
+    dom = day in parsed[2][0] or bool(parsed[2][1]) and day == last
+    dow = weekday in parsed[4][0]
+    for special in parsed[4][1]:
+        if weekday == special[1]:
+            if special[0] == "weekday_last":
+                dow = dow or day + 7 > last
+            else:
+                dow = dow or (day - 1) // 7 + 1 == special[2]
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow
+    if dow_free:
+        return dom
+    return dom or dow
+
 
