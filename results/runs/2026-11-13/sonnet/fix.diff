 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+", re.A)
+
+
+def _num(text, names, lo, hi):
+    if _NUM.fullmatch(text):
+        v = int(text)
+    elif names and text.upper() in names and text.isalpha() and text.isascii():
+        v = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value {text!r} out of range")
+    return v
+
+
+def _parse_field(text, lo, hi, names=None, kind=None):
+    """Return (values, specials). kind is 'dom' or 'dow' for the day fields."""
+    values, specials = set(), []
+    if text == "?":
+        if kind is None:
+            raise ValueError("? not allowed here")
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item == "L":
+            specials.append("L")
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)L", item, re.A)
+            if m:
+                specials.append((_num(m.group(1), None, 0, 7) % 7, "L"))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item, re.A)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError("bad K")
+                specials.append((_num(m.group(1), None, 0, 7) % 7, k))
+                continue
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.fullmatch(step) or int(step) < 1:
+                raise ValueError("bad step")
+            step = int(step)
+        else:
+            step = 1
+        if base == "*":
+            a, b = lo, hi
+        elif "-" in base:
+            x, _, y = base.partition("-")
+            a, b = _num(x, names, lo, hi), _num(y, names, lo, hi)
+            if a > b:
+                raise ValueError("descending range")
+        else:
+            a = _num(base, names, lo, hi)
+            b = hi if sep else a
+        values.update(range(a, b + 1, step))
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        if expr.lower() not in _SHORTCUTS:
+            raise ValueError("unknown shortcut")
+        expr = _SHORTCUTS[expr.lower()]
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("need five fields")
+    mi, _ = _parse_field(parts[0], 0, 59)
+    ho, _ = _parse_field(parts[1], 0, 23)
+    dom, dom_sp = _parse_field(parts[2], 1, 31, None, "dom")
+    mo, _ = _parse_field(parts[3], 1, 12, _MONTHS)
+    dow, dow_sp = _parse_field(parts[4], 0, 7, _DAYS, "dow")
+    dow = {v % 7 for v in dow}
+    dom_free = parts[2] in ("*", "?")
+    dow_free = parts[4] in ("*", "?")
+    return (sorted(mi), sorted(ho), dom, dom_sp, mo, dow, dow_sp,
+            dom_free, dow_free)
+
+
+def _day_ok(p, d):
+    _, _, dom, dom_sp, _, dow, dow_sp, dom_free, dow_free = p
+    last = calendar.monthrange(d.year, d.month)[1]
+    wd = (d.weekday() + 1) % 7
+    dom_ok = d.day in dom or ("L" in dom_sp and d.day == last)
+    dow_ok = wd in dow
+    for n, k in dow_sp:
+        if n == wd and (d.day + 7 > last if k == "L" else (d.day - 1) // 7 + 1 == k):
+            dow_ok = True
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_ok
+    if dow_free:
+        return dom_ok
+    return dom_ok or dow_ok
 
 
