 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    result = []
+    for index, part in enumerate(parts):
+        low, high = _BOUNDS[index]
+        unrestricted = part in ('*', '?')
+        if part == '?' and index in (2, 4):
+            part = '*'
+        values, special = set(), []
+
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if token.upper() in names:
+                value = names[token.upper()]
+            elif re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            else:
+                raise ValueError('invalid value')
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+
+        for item in part.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])(?:L|#([1-5]))', item) if index == 4 else None
+            if match:
+                special.append(('weekday', int(match.group(1)) % 7,
+                                int(match.group(2)) if match.group(2) else None))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                start, end = low, high
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, ends)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = high if len(pieces) == 2 else start
+            values.update(v % 7 if index == 4 else v for v in range(start, end + 1, step))
+        result.append((values, special, unrestricted))
+    return result
+
+
+def _day_matches(schedule, date):
+    dom, dow = schedule[2], schedule[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dom_match = date.day in dom[0] or bool(dom[1] and date.day == last)
+    dow_match = weekday in dow[0] or any(
+        weekday == target and (date.day + 7 > last if nth is None else (date.day - 1) // 7 + 1 == nth)
+        for _, target, nth in dow[1])
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
