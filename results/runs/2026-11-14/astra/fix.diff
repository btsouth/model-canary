 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from bisect import bisect_right
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())},
+}
+
+
+def _number(token):
+    if not re.fullmatch(r'[0-9]+', token):
+        raise ValueError(f'bad number: {token!r}')
+    return int(token)
+
+
+def _value(token, field):
+    value = _NAMES.get(field, {}).get(token)
+    if value is None:
+        value = _number(token)
+    low, high = _BOUNDS[field]
+    if not low <= value <= high:
+        raise ValueError(f'value out of range: {token!r}')
+    return value
+
+
+def _field(text, field):
+    values, special = set(), []
+    low, high = _BOUNDS[field]
+    if text == '?' and field in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if field == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        last = re.fullmatch(r'([0-9]+)L', item)
+        nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item)
+        if field == 4 and (last or nth):
+            match = last or nth
+            weekday = _value(match[1], field) % 7
+            if last:
+                special.append(('last_weekday', weekday))
+            else:
+                occurrence = _number(match[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError('weekday occurrence out of range')
+                special.append(('nth_weekday', weekday, occurrence))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('too many steps')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            ends = base.split('-')
+            if len(ends) != 2:
+                raise ValueError('bad range')
+            start, end = (_value(token, field) for token in ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif field == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _value(base, field)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(value % 7 if field == 4 else value for value in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('schedule must be text')
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr.upper())
+    if len(fields) != 5:
+        raise ValueError('schedule must have five fields')
+    return [_field(text, i) for i, text in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow, dow_special = fields[4]
+    if weekday in dow:
+        return True
+    for rule in dow_special:
+        if weekday == rule[1]:
+            if rule[0] == 'last_weekday' and day.day + 7 > last:
+                return True
+            if rule[0] == 'nth_weekday' and (day.day - 1) // 7 + 1 == rule[2]:
+                return True
+    return False
+
 
