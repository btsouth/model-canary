@@ -1,11 +1,275 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+
+_DOWS = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+
+
+class _Field:
+    __slots__ = ("values", "last_day", "last_dow", "nth")
+
+    def __init__(self):
+        self.values = set()
+        self.last_day = False
+        self.last_dow = set()
+        self.nth = set()
+
+
+def _parse_value(text, kind, low, high, allow_name):
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+        if value < low or value > high:
+            raise ValueError(f"value out of range: {text!r}")
+        return value
+    if allow_name and kind == "month":
+        value = _MONTHS.get(text.upper())
+        if value is not None:
+            return value
+    if allow_name and kind == "dow":
+        value = _DOWS.get(text.upper())
+        if value is not None:
+            return value
+    raise ValueError(f"bad value: {text!r}")
+
+
+def _range_values(first, last, low, high, is_dow):
+    if is_dow:
+        if first <= last:
+            return list(range(first, last + 1))
+        first = 0 if first == 7 else first
+        last = 0 if last == 7 else last
+        if first <= last:
+            return list(range(first, last + 1))
+        return list(range(first, 7)) + list(range(0, last + 1))
+    if first <= last:
+        return list(range(first, last + 1))
+    return list(range(first, high + 1)) + list(range(low, last + 1))
+
+
+def _add_values(field, values, is_dow):
+    for value in values:
+        field.values.add(0 if is_dow and value == 7 else value)
+
+
+def _parse_field(text, kind, low, high):
+    field = _Field()
+    is_dow = kind == "dow"
+
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    elif "?" in text:
+        raise ValueError("'?' must be the whole day field")
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+
+        if "/" in item:
+            pieces = item.split("/")
+            if len(pieces) != 2:
+                raise ValueError(f"bad item: {item!r}")
+            base, step_text = pieces
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+            if re.search(r"[A-Za-z]", base):
+                raise ValueError(f"names and letters cannot be stepped: {item!r}")
+
+            if base == "*":
+                values = list(range(low, high + 1))
+            elif "-" in base:
+                if base.count("-") != 1:
+                    raise ValueError(f"bad range: {item!r}")
+                first_text, last_text = base.split("-")
+                first = _parse_value(first_text, kind, low, high, False)
+                last = _parse_value(last_text, kind, low, high, False)
+                values = _range_values(first, last, low, high, is_dow)
+            else:
+                first = _parse_value(base, kind, low, high, False)
+                values = list(range(first, high + 1))
+
+            _add_values(field, values[::step], is_dow)
+            continue
+
+        if item == "*":
+            _add_values(field, range(low, high + 1), is_dow)
+            continue
+
+        if kind == "dom" and item == "L":
+            field.last_day = True
+            continue
+
+        if kind == "dow":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                day = int(match.group(1))
+                if day < 0 or day > 7:
+                    raise ValueError(f"bad day of week: {item!r}")
+                field.last_dow.add(0 if day == 7 else day)
+                continue
+
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                day = int(match.group(1))
+                which = int(match.group(2))
+                if day < 0 or day > 7 or which < 1 or which > 5:
+                    raise ValueError(f"bad day of week: {item!r}")
+                field.nth.add((0 if day == 7 else day, which))
+                continue
+
+        if "-" in item:
+            if item.count("-") != 1:
+                raise ValueError(f"bad range: {item!r}")
+            first_text, last_text = item.split("-")
+            first = _parse_value(first_text, kind, low, high, True)
+            last = _parse_value(last_text, kind, low, high, True)
+            _add_values(
+                field, _range_values(first, last, low, high, is_dow), is_dow
+            )
+        else:
+            value = _parse_value(item, kind, low, high, True)
+            _add_values(field, [value], is_dow)
+
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+
+    text = expr.strip()
+    if text.startswith("@"):
+        replacement = _SHORTCUTS.get(text.lower())
+        if replacement is None:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = replacement
+
+    parts = [part for part in re.split(r"[ \t]+", text) if part]
+    if len(parts) != 5:
+        raise ValueError(f"a schedule needs five fields: {expr!r}")
+
+    return (
+        _parse_field(parts[0], "minute", 0, 59),
+        _parse_field(parts[1], "hour", 0, 23),
+        _parse_field(parts[2], "dom", 1, 31),
+        _parse_field(parts[3], "month", 1, 12),
+        _parse_field(parts[4], "dow", 0, 7),
+    )
+
+
+def _day_allowed(dom, dow, date):
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    if date.day not in dom.values and not (
+        dom.last_day and date.day == days_in_month
+    ):
+        return False
+
+    weekday = (date.weekday() + 1) % 7
+    if weekday in dow.values:
+        return True
+    if weekday in dow.last_dow and date.day + 7 > days_in_month:
+        return True
+    for day, which in dow.nth:
+        if day == weekday and (date.day - 1) // 7 + 1 == which:
+            return True
+    return False
+
+
+def _matches(schedule, when):
+    minute, hour, dom, month, dow = schedule
+    return (
+        when.minute in minute.values
+        and when.hour in hour.values
+        and when.month in month.values
+        and _day_allowed(dom, dow, when.date())
+    )
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _matches(_parse(expr), when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    minute, hour, dom, month, dow = schedule
+
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        deadline = after + timedelta(days=20 * 365)
+    except OverflowError:
+        deadline = datetime.max
+    hours = sorted(hour.values)
+    minutes = sorted(minute.values)
+    start_date = start.date()
+    day = start_date
+    last_date = deadline.date()
+
+    while day <= last_date:
+        if day.month in month.values and _day_allowed(dom, dow, day):
+            for hour_value in hours:
+                if day == start_date and hour_value < start.hour:
+                    continue
+                for minute_value in minutes:
+                    if (
+                        day == start_date
+                        and hour_value == start.hour
+                        and minute_value < start.minute
+                    ):
+                        continue
+                    candidate = datetime(
+                        day.year, day.month, day.day, hour_value, minute_value
+                    )
+                    if candidate <= deadline:
+                        return candidate
+                    return None
+        if day == last_date:
+            break
+        day += timedelta(days=1)
+
+    return None
