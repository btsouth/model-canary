 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
+_DAYS = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]
+_NUMBER = re.compile(r"[0-9]+\Z")
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names) for each of the five fields
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_SPECS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+class _Field:
+    """One parsed field: a set of plain values plus day-related extras."""
+
+    def __init__(self):
+        self.star = False
+        self.values = set()
+        self.last_dom = False      # 'L' in day of month
+        self.last_dow = set()      # 'NL' in day of week
+        self.nth_dow = set()       # (N, K) from 'N#K' in day of week
+
+
+def _value(text, index, raw):
+    """Read one field value, a number or (in month / day-of-week) a name."""
+    low, high, names = _SPECS[index]
+    if _NUMBER.match(text):
+        value = int(text)
+    elif names is not None and text.lower() in names:
+        value = names.index(text.lower()) + (1 if index == _MONTH else 0)
+    else:
+        raise ValueError(f"bad value {text!r} in {raw!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range in {raw!r}")
+    return value
+
+
+def _range_values(text, index, raw):
+    """Values listed by '*', 'N' or 'A-B' before any step is applied."""
+    low, high, _ = _SPECS[index]
+    if text == "*":
+        return list(range(low, high + 1))
+    if "-" not in text:
+        return [_value(text, index, raw)]
+    first, _, second = text.partition("-")
+    a = _value(first, index, raw)
+    b = _value(second, index, raw)
+    if index == _DOW:
+        a %= 7
+        b %= 7
+        high = 6
+    if a <= b:
+        return list(range(a, b + 1))
+    return list(range(a, high + 1)) + list(range(low, b + 1))
+
+
+def _item(text, index, field, raw):
+    if not text:
+        raise ValueError(f"empty item in {raw!r}")
+    if index == _DOM and text == "L":
+        field.last_dom = True
+        return
+    if index == _DOW and _NUMBER.match(text[:-1] or "x") and text.endswith("L"):
+        n = int(text[:-1])
+        if not 0 <= n <= 7:
+            raise ValueError(f"value out of range in {raw!r}")
+        field.last_dow.add(n % 7)
+        return
+    if index == _DOW and "#" in text:
+        n_text, _, k_text = text.partition("#")
+        if not (_NUMBER.match(n_text) and _NUMBER.match(k_text)):
+            raise ValueError(f"bad item {text!r} in {raw!r}")
+        n, k = int(n_text), int(k_text)
+        if not 0 <= n <= 7 or not 1 <= k <= 5:
+            raise ValueError(f"value out of range in {raw!r}")
+        field.nth_dow.add((n % 7, k))
+        return
+    base, slash, step_text = text.partition("/")
+    if slash:
+        if not _NUMBER.match(step_text):
+            raise ValueError(f"bad step {step_text!r} in {raw!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step must be at least 1 in {raw!r}")
+        if base != "*" and "-" not in base:
+            # 'N/S' lists N up to the field's maximum.
+            base = f"{base}-{_SPECS[index][1]}"
+    values = _range_values(base, index, raw)
+    if slash:
+        values = values[::step]
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    field.values.update(values)
+
+
+def _field(text, index, raw):
+    field = _Field()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError(f"'?' only allowed in the day fields: {raw!r}")
+        field.star = True
+        return field
+    for item in text.split(","):
+        _item(item, index, field, raw)
+    if text == "*":
+        field.star = True
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    return [_field(part, index, expr) for index, part in enumerate(parts)]
+
+
+def _day_allowed(fields, year, month, day):
+    dom, dow = fields[_DOM], fields[_DOW]
+    last = calendar.monthrange(year, month)[1]
+    weekday = (_dt.date(year, month, day).weekday() + 1) % 7  # Sunday is 0
+    dom_ok = dom.star or day in dom.values or (dom.last_dom and day == last)
+    dow_ok = (
+        dow.star
+        or weekday in dow.values
+        or (weekday in dow.last_dow and day + 7 > last)
+        or (weekday, (day - 1) // 7 + 1) in dow.nth_dow
+    )
+    return dom_ok and dow_ok
+
 
