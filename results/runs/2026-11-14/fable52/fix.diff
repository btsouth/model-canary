 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names)
+_SPECS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_DOM, _DOW = 2, 4
+
+_NUM = re.compile(r"[0-9]+\Z")
+_LAST_DOW = re.compile(r"([0-9]+)L\Z")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)\Z")
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+def _value(text, lo, hi, names):
+    if _NUM.match(text):
+        n = int(text)
+    elif names is not None and text.upper() in names:
+        n = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not lo <= n <= hi:
+        raise ValueError(f"value out of range: {text!r}")
+    return n
+
+
+def _parse_field(text, index):
+    """Return (values, last_dom, last_dows, nth_dows) for one field."""
+    lo, hi, names = _SPECS[index]
+    values, last_dom, last_dows, nth_dows = set(), False, set(), set()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == _DOM and item == "L":
+            last_dom = True
+            continue
+        if index == _DOW:
+            found = _LAST_DOW.match(item)
+            if found:
+                last_dows.add(_value(found.group(1), lo, hi, None) % 7)
+                continue
+            found = _NTH_DOW.match(item)
+            if found:
+                k = int(found.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad occurrence: {item!r}")
+                nth_dows.add((_value(found.group(1), lo, hi, None) % 7, k))
+                continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not _NUM.match(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+        if base == "*":
+            listed = list(range(lo, hi + 1))
+            if index == _DOW:
+                listed = list(range(0, 7))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a = _value(a_text, lo, hi, names)
+            b = _value(b_text, lo, hi, names)
+            if a <= b:
+                listed = list(range(a, b + 1))
+            elif index == _DOW:
+                a %= 7
+                if a <= b:
+                    listed = list(range(a, b + 1))
+                else:
+                    listed = list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                listed = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            listed = list(range(a, hi + 1)) if slash else [a]
+        listed = listed[::step]
+        if index == _DOW:
+            listed = [v % 7 for v in listed]
+        values.update(listed)
+    return values, last_dom, last_dows, nth_dows
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("expression must be a string")
+        expr = expr.strip()
+        if expr.startswith("@"):
+            if expr.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            expr = _SHORTCUTS[expr.lower()]
+        parts = [p for p in re.split(r"[ \t]+", expr)]
+        if len(parts) != 5:
+            raise ValueError("expected five fields")
+        parsed = [_parse_field(p, i) for i, p in enumerate(parts)]
+        self.minutes = sorted(parsed[0][0])
+        self.hours = sorted(parsed[1][0])
+        self.doms, self.last_dom = parsed[2][0], parsed[2][1]
+        self.months = parsed[3][0]
+        self.dows, self.last_dows, self.nth_dows = parsed[4][0], parsed[4][2], parsed[4][3]
+
+    def day_ok(self, year, month, day):
+        if month not in self.months:
+            return False
+        first_weekday, length = calendar.monthrange(year, month)
+        if not (day in self.doms or (self.last_dom and day == length)):
+            return False
+        dow = (first_weekday + day) % 7  # Monday=0 -> cron Sunday=0
+        if dow in self.dows:
+            return True
+        if dow in self.last_dows and day + 7 > length:
+            return True
+        return (dow, (day - 1) // 7 + 1) in self.nth_dows
+
+    def time_ok(self, hour, minute):
+        return hour in self.hours and minute in self.minutes
 
 
