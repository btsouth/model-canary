 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+_WINDOW = timedelta(days=20 * 365)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i for i, n in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"], start=1)}
+_DAYS = {n: i for i, n in enumerate(["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+
+# (field name, lowest value, highest value, names or None)
+_FIELDS = (
+    ("minute", 0, 59, None),
+    ("hour", 0, 23, None),
+    ("dom", 1, 31, None),
+    ("month", 1, 12, _MONTHS),
+    ("dow", 0, 7, _DAYS),
+)
+
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+@dataclass(frozen=True)
+class _Schedule:
+    minutes: frozenset
+    hours: frozenset
+    dom: frozenset
+    dom_last: bool
+    months: frozenset
+    dow: frozenset        # weekdays 0-6, Sunday = 0
+    dow_lastn: frozenset  # "NL": last weekday N of the month
+    dow_nth: frozenset    # (weekday, K) for "N#K"
+
+
+def _value(token, field):
+    name, lo, hi, names = field
+    if _DIGITS.fullmatch(token):
+        value = int(token)
+    elif names is not None and _NAME.fullmatch(token) and token.lower() in names:
+        value = names[token.lower()]
+    else:
+        raise ValueError(f"bad {name} value: {token!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"{name} value out of range: {token!r}")
+    return value
+
+
+def _parse_item(item, field):
+    name, lo, hi, _ = field
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+
+    if name == "dom" and base == "L" and not slash:
+        return ("last",)
+    if name == "dow" and not slash:
+        m = _LAST_WEEKDAY.fullmatch(base)
+        if m:
+            n = int(m.group(1))
+            if n > 7:
+                raise ValueError(f"bad weekday in {item!r}")
+            return ("lastn", n % 7)
+        m = _NTH_WEEKDAY.fullmatch(base)
+        if m:
+            n, k = int(m.group(1)), int(m.group(2))
+            if n > 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad weekday occurrence in {item!r}")
+            return ("nth", n % 7, k)
+
+    if base == "*":
+        seq = list(range(lo, hi + 1))
+    elif "-" in base:
+        a_text, _, b_text = base.partition("-")
+        a = _value(a_text, field)
+        b = _value(b_text, field)
+        if a <= b:
+            seq = list(range(a, b + 1))
+        elif name == "dow":
+            # Counts through 0 to 6 with 7 treated as 0.
+            seq = list(range(a, max(a + 1, 7))) + list(range(0, b + 1))
+        else:
+            seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        a = _value(base, field)
+        seq = list(range(a, hi + 1)) if step is not None else [a]
+
+    if step is not None:
+        seq = seq[::step]
+    return ("vals", seq)
+
+
+def _parse_field(text, field):
+    name = field[0]
+    if text == "?":
+        if name not in ("dom", "dow"):
+            raise ValueError(f"'?' not allowed in {name} field")
+        text = "*"
+    elif "?" in text:
+        raise ValueError(f"'?' must be the whole {name} field: {text!r}")
+
+    vals, last, lastn, nth = set(), False, set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {name} field: {text!r}")
+        parsed = _parse_item(item, field)
+        if parsed[0] == "vals":
+            for v in parsed[1]:
+                vals.add(v % 7 if name == "dow" else v)
+        elif parsed[0] == "last":
+            last = True
+        elif parsed[0] == "lastn":
+            lastn.add(parsed[1])
+        else:
+            nth.add((parsed[1], parsed[2]))
+    return vals, last, lastn, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string, not {type(expr).__name__}")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    minutes, _, _, _ = _parse_field(parts[0], _FIELDS[0])
+    hours, _, _, _ = _parse_field(parts[1], _FIELDS[1])
+    dom, dom_last, _, _ = _parse_field(parts[2], _FIELDS[2])
+    months, _, _, _ = _parse_field(parts[3], _FIELDS[3])
+    dow, _, dow_lastn, dow_nth = _parse_field(parts[4], _FIELDS[4])
+    return _Schedule(
+        minutes=frozenset(minutes),
+        hours=frozenset(hours),
+        dom=frozenset(dom),
+        dom_last=dom_last,
+        months=frozenset(months),
+        dow=frozenset(dow),
+        dow_lastn=frozenset(dow_lastn),
+        dow_nth=frozenset(dow_nth),
+    )
+
+
+def _day_ok(s, day):
+    """True if the schedule runs on any minute of the calendar day."""
+    if day.month not in s.months:
+        return False
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    if day.day not in s.dom and not (s.dom_last and day.day == days_in_month):
+        return False
+    wd = (day.weekday() + 1) % 7  # Sunday = 0
+    if wd in s.dow:
+        return True
+    if (wd, (day.day - 1) // 7 + 1) in s.dow_nth:
+        return True
+    return wd in s.dow_lastn and day.day + 7 > days_in_month
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _parse(expr)
+    return when.minute in s.minutes and when.hour in s.hours and _day_ok(s, when.date())
 
 
