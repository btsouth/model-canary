 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(calendar.day_abbr)}  # Mon=0
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *", "@hourly": "0 * * * *",
+}
+
+
+def _parse_field(field, kind):
+    limits = {"minute": (0, 59), "hour": (0, 23), "dom": (1, 31), "month": (1, 12), "dow": (0, 7)}
+    lo, hi = limits[kind]
+    if kind in ("dom", "dow") and field == "?":
+        field = "*"
+    any_field = field == "*"
+    values, specials = set(), []
+    if not field:
+        raise ValueError("empty field")
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item == "L":
+            specials.append(("last",)); continue
+        if kind == "dow" and re.fullmatch(r"[0-7]L", item):
+            specials.append(("last_weekday", int(item[:-1]) % 7)); continue
+        if kind == "dow" and re.fullmatch(r"[0-7]#[1-5]", item):
+            specials.append(("nth_weekday", int(item[0]) % 7, int(item[2]))); continue
+        base, sep, step_text = item.partition("/")
+        if sep and any(c.isalpha() for c in base):
+            raise ValueError("names are not allowed with steps")
+        if sep:
+            if not step_text.isdigit() or int(step_text) < 1:
+                raise ValueError("bad step")
+            step = int(step_text)
+        else:
+            step = 1
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        else:
+            # Names are allowed only as complete month or weekday endpoints.
+            def endpoint(token):
+                if token.isdigit():
+                    return int(token)
+                if kind == "month" and token.upper() in _MONTHS:
+                    return _MONTHS[token.upper()]
+                if kind == "dow" and token.upper() in _DAYS:
+                    return (_DAYS[token.upper()] + 1) % 7
+                raise ValueError("invalid field token")
+            if "/" in base:
+                raise ValueError("invalid field token")
+            if "-" in base:
+                if base.count("-") != 1:
+                    raise ValueError("invalid range")
+                a, b = base.split("-")
+                a, b = endpoint(a), endpoint(b)
+                if not lo <= a <= hi or not lo <= b <= hi: raise ValueError("value out of range")
+                if kind == "dow" and a > b:
+                    seq = list(range(a, 8)) + list(range(0, b + 1))
+                elif a <= b:
+                    seq = list(range(a, b + 1))
+                else:
+                    seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+            else:
+                a = endpoint(base)
+                if not lo <= a <= hi: raise ValueError("value out of range")
+                seq = list(range(a, hi + 1)) if sep else [a]
+        values.update(seq[::step])
+    return values, specials, any_field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    stripped = expr.strip()
+    if stripped.lower().startswith("@"):
+        if stripped.lower() not in _SHORTCUTS: raise ValueError("unknown shortcut")
+        stripped = _SHORTCUTS[stripped.lower()]
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5: raise ValueError("expected five fields")
+    parsed = [_parse_field(f, k) for f, k in zip(fields, ("minute", "hour", "dom", "month", "dow"))]
+    return parsed
+
+
+def _day_allowed(parsed, date):
+    (_, _, dom, _, dow) = parsed
+    dom_values, dom_special, dom_any = dom
+    dow_values, dow_special, dow_any = dow
+    day_match = dom_any or date.day in dom_values
+    if any(s[0] == "last" and date.day == calendar.monthrange(date.year, date.month)[1] for s in dom_special): day_match = True
+    weekday = (date.weekday() + 1) % 7
+    week_match = dow_any or weekday in dow_values or 7 in dow_values and weekday == 0
+    last_week = calendar.monthrange(date.year, date.month)[1] - date.day < 7
+    for s in dow_special:
+        if s[0] == "last_weekday" and s[1] == weekday and last_week: week_match = True
+        if s[0] == "nth_weekday" and s[1] == weekday and (date.day - 1) // 7 + 1 == s[2]: week_match = True
+    return day_match and week_match
 
 
