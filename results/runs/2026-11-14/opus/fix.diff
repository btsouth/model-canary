 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (minimum, maximum, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last", "dow", "dow_last", "dow_nth")
+
+
+def _number(text):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    return int(text)
+
+
+def _value(text, lo, hi, names):
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    value = _number(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"value {value} out of range {lo}-{hi}")
+    return value
+
+
+def _range_values(a, b, lo, hi, is_dow):
+    if a <= b:
+        return list(range(a, b + 1))
+    if is_dow:
+        a, b = a % 7, b % 7
+        if a <= b:
+            return list(range(a, b + 1))
+        return list(range(a, 7)) + list(range(0, b + 1))
+    return list(range(a, hi + 1)) + list(range(lo, b + 1))
+
+
+def _parse_item(item, index):
+    lo, hi, names = _FIELDS[index]
+    is_dow = index == 4
+    if item == "":
+        raise ValueError("empty item")
+    if "/" in item:
+        base, step_text = item.split("/", 1)
+        step = _number(step_text)
+        if step < 1:
+            raise ValueError("step must be at least 1")
+    else:
+        base, step = item, None
+    if base == "":
+        raise ValueError("empty item")
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    elif "-" in base:
+        a_text, b_text = base.split("-", 1)
+        a = _value(a_text, lo, hi, names)
+        b = _value(b_text, lo, hi, names)
+        values = _range_values(a, b, lo, hi, is_dow)
+    else:
+        n = _value(base, lo, hi, names)
+        values = list(range(n, hi + 1)) if step is not None else [n]
+    if step is not None:
+        values = values[::step]
+    if is_dow:
+        values = [v % 7 for v in values]
+    return set(values)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    sched = _Schedule()
+    sched.dom_last = False
+    sched.dow_last = set()
+    sched.dow_nth = set()
+    sets = []
+    for index, field in enumerate(parts):
+        values = set()
+        if field == "?" and index in (2, 4):
+            lo, hi, _ = _FIELDS[index]
+            values = set(range(lo, hi + 1))
+            if index == 4:
+                values = {v % 7 for v in values}
+            sets.append(values)
+            continue
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                sched.dom_last = True
+            elif index == 4 and item.endswith("L") and _NUMBER.fullmatch(item[:-1]):
+                n = int(item[:-1])
+                if n > 7:
+                    raise ValueError(f"bad day of week: {item!r}")
+                sched.dow_last.add(n % 7)
+            elif index == 4 and "#" in item:
+                n_text, k_text = item.split("#", 1)
+                n, k = _number(n_text), _number(k_text)
+                if n > 7 or not 1 <= k <= 5:
+                    raise ValueError(f"bad day of week: {item!r}")
+                sched.dow_nth.add((n % 7, k))
+            else:
+                values |= _parse_item(item, index)
+        sets.append(values)
+    sched.minutes, sched.hours, sched.dom, sched.months, sched.dow = sets
+    return sched
+
+
+def _day_allowed(sched, date):
+    last = calendar.monthrange(date.year, date.month)[1]
+    day = date.day
+    if not (day in sched.dom or (sched.dom_last and day == last)):
+        return False
+    weekday = (date.weekday() + 1) % 7
+    if weekday in sched.dow:
+        return True
+    if weekday in sched.dow_last and day + 7 > last:
+        return True
+    return (weekday, (day - 1) // 7 + 1) in sched.dow_nth
 
 
