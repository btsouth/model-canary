+        if not dom_last or day.day != calendar.monthrange(day.year, day.month)[1]:
+            return False
+    if weekday in dow or (weekday, (day.day - 1) // 7 + 1) in dow_nth:
+        return True
+    return weekday in dow_last and day.day + 7 > calendar.monthrange(day.year, day.month)[1]
+
 
