 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import date, datetime, timedelta
+
+
+_MONTHS = dict(zip(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
+    range(1, 13),
+))
+_DAYS = dict(zip(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError("expected decimal digits")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, last, nth = set(), set(), set()
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError("schedule value out of range")
+        return number
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            last.add(None)
+            continue
+        if index == 4:
+            special = re.fullmatch(r"([0-9]+)(L|#[1-5])", item)
+            if special:
+                weekday = value(special[1]) % 7
+                if special[2] == "L":
+                    last.add(weekday)
+                else:
+                    nth.add((weekday, int(special[2][1:])))
+                continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid schedule step")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("schedule step must be positive")
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError("invalid schedule range")
+            start, end = map(value, ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, last, nth
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("a schedule needs five fields")
+    return tuple(_field(part, index) for index, part in enumerate(parts))
+
+
+def _day_matches(schedule, day):
+    dom, dom_last, _ = schedule[2]
+    dow, dow_last, dow_nth = schedule[4]
+    weekday = (day.weekday() + 1) % 7
