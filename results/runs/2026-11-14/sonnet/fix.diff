 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _item_values(item, lo, hi, names, dow):
+    """Values listed by an item without special forms, in order."""
+    step = 1
+    if "/" in item:
+        item, s = item.split("/", 1)
+        if not _NUM.fullmatch(s) or int(s) < 1:
+            raise ValueError(f"bad step {s!r}")
+        step = int(s)
+    if item == "*":
+        vals = list(range(lo, hi + 1))
+    elif "-" in item:
+        a, b = item.split("-", 1)
+        a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+        if a <= b:
+            vals = list(range(a, b + 1))
+        elif dow:
+            vals = list(range(a % 7, 7)) + list(range(0, b + 1))
+        else:
+            vals = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        a = _value(item, lo, hi, names)
+        vals = [a]
+    return vals[::step]
+
+
+def _parse_field(text, lo, hi, names=None, kind=None):
+    """Return (set of values, extras)."""
+    if kind is not None and text == "?":
+        return set(range(lo, hi + 1)), None
+    vals, extra = set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item.upper() == "L":
+            extra.add("L")
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)[lL]", item)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError("bad day")
+                extra.add(("L", n % 7))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if n > 7 or not 1 <= k <= 5:
+                    raise ValueError("bad day")
+                extra.add(("#", n % 7, k))
+                continue
+        if "/" in item:
+            base, s = item.split("/", 1)
+            if not _NUM.fullmatch(s) or int(s) < 1:
+                raise ValueError(f"bad step {s!r}")
+            step = int(s)
+            if "-" in base or base == "*":
+                vals.update(_item_values(item, lo, hi, names, kind == "dow"))
+            else:
+                a = _value(base, lo, hi, names)
+                vals.update(list(range(a, hi + 1))[::step])
+        else:
+            vals.update(_item_values(item, lo, hi, names, kind == "dow"))
+    return vals, extra
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError(f"unknown shortcut {expr!r}")
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minute, _ = _parse_field(parts[0], 0, 59)
+    hour, _ = _parse_field(parts[1], 0, 23)
+    dom, dom_x = _parse_field(parts[2], 1, 31, None, "dom")
+    month, _ = _parse_field(parts[3], 1, 12, _MONTHS)
+    dow, dow_x = _parse_field(parts[4], 0, 7, _DAYS, "dow")
+    return (sorted(minute), sorted(hour), dom, dom_x, month,
+            {v % 7 for v in dow}, dow_x)
+
+
+def _day_ok(p, d):
+    _, _, dom, dom_x, month, dow, dow_x = p
+    if d.month not in month:
+        return False
+    last = calendar.monthrange(d.year, d.month)[1]
+    if not (d.day in dom or "L" in dom_x and d.day == last):
+        return False
+    wd = (d.weekday() + 1) % 7
+    if wd in dow:
+        return True
+    for x in dow_x:
+        if x[0] == "L":
+            if x[1] == wd and d.day + 7 > last:
+                return True
+        elif x[1] == wd and (d.day - 1) // 7 + 1 == x[2]:
+            return True
+    return False
 
 
