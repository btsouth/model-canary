 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import timedelta
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7)))
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, part in enumerate(parts):
+        lo, hi = _LIMITS[index]
+        values, special = set(), []
+        if part == '?' and index in (2, 4):
+            part = '*'
+        def number(s):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if s.upper() in names:
+                n = names[s.upper()]
+            elif re.fullmatch(r'[0-9]+', s):
+                n = int(s)
+            else:
+                raise ValueError('bad value')
+            if not lo <= n <= hi:
+                raise ValueError('value out of range')
+            return n
+        for item in part.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-9]+)(?:L|#([0-9]+))', item) if index == 4 else None
+            if match:
+                if int(match[1]) > 7 or (match[2] is not None and not 1 <= int(match[2]) <= 5):
+                    raise ValueError('bad weekday special')
+                special.append(('weekday', int(match[1]) % 7, int(match[2]) if match[2] else None))
+                continue
+            bits = item.split('/')
+            if len(bits) > 2 or not bits[0]:
+                raise ValueError('bad item')
+            if len(bits) == 2:
+                if not re.fullmatch(r'[0-9]+', bits[1]) or int(bits[1]) < 1:
+                    raise ValueError('bad step')
+                step = int(bits[1])
+            else:
+                step = 1
+            base = bits[0]
+            if base == '*':
+                seq = list(range(lo, hi + 1))
+            elif '-' in base:
+                endpoints = base.split('-')
+                if len(endpoints) != 2:
+                    raise ValueError('bad range')
+                a, b = map(number, endpoints)
+                if index == 4:
+                    if a <= b:
+                        seq = list(range(a, b + 1))
+                    else:
+                        a, b = a % 7, b % 7
+                        seq = list(range(a, b + 1)) if a <= b else list(range(a, 7)) + list(range(0, b + 1))
+                else:
+                    seq = list(range(a, b + 1)) if a <= b else list(range(a, hi + 1)) + list(range(lo, b + 1))
+            else:
+                a = number(base)
+                seq = list(range(a, hi + 1)) if len(bits) == 2 else [a]
+            values.update(n % 7 if index == 4 else n for n in seq[::step])
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_ok(p, day):
+    dom, dow = p[2], p[4]
+    weekday = (day.weekday() + 1) % 7
+    last = calendar.monthrange(day.year, day.month)[1]
+    return (day.day in dom[0] or bool(dom[1]) and day.day == last) and (
+        weekday in dow[0] or any(weekday == n and (day.day + 7 > last if k is None else (day.day - 1) // 7 + 1 == k)
+                                 for _, n, k in dow[1]))
+
 
