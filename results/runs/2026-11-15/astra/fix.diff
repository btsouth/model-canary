 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from bisect import bisect_right
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate(
+        'SUN MON TUE WED THU FRI SAT'.split())},
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(token):
+    if not re.fullmatch(r'[0-9]+', token):
+        raise ValueError('expected decimal digits')
+    return int(token)
+
+
+def _value(token, field):
+    value = _NAMES.get(field, {}).get(token)
+    if value is None:
+        value = _number(token)
+    low, high = _BOUNDS[field]
+    if not low <= value <= high:
+        raise ValueError('value outside field range')
+    return value
+
+
+def _field(text, field):
+    values, specials = set(), []
+    unrestricted = text in ('*', '?')
+    if text == '?':
+        if field not in (2, 4):
+            raise ValueError('? only allowed in day fields')
+        text = '*'
+    low, high = _BOUNDS[field]
+    for item in text.split(','):
+        if field == 2 and item == 'L':
+            specials.append(('last',))
+            continue
+        if field == 4:
+            special = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+            if special:
+                weekday = _value(special[1], field) % 7
+                if special[2] == 'L':
+                    specials.append(('last', weekday))
+                else:
+                    ordinal = _number(special[3])
+                    if not 1 <= ordinal <= 5:
+                        raise ValueError('weekday ordinal outside 1 to 5')
+                    specials.append(('nth', weekday, ordinal))
+                continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('too many steps')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError('invalid range')
+            start, end = [_value(p, field) for p in endpoints]
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif field == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _value(base, field)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        if field == 4:
+            # Sunday has two spellings, but is only one position in a sequence.
+            sequence = list(dict.fromkeys(value % 7 for value in sequence))
+        values.update(sequence[::step])
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expression must be text')
+    expr = expr.strip().upper()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(text, index) for index, text in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    dom, dom_specials, dom_free = fields[2]
+    dow, dow_specials, dow_free = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom or (bool(dom_specials) and day.day == last)
+    dow_match = weekday in dow
+    for special in dow_specials:
+        if weekday == special[1]:
+            if special[0] == 'last':
+                dow_match |= day.day + 7 > last
+            else:
+                dow_match |= (day.day - 1) // 7 + 1 == special[2]
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_match
+    if dow_free:
+        return dom_match
+    return dom_match or dow_match
+
 
