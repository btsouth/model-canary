--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,264 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_NUMBER = re.compile(r"[0-9]+")
+_MONTH_NAMES = {
+    name: index
+    for index, name in enumerate(
+        ("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
+        start=1,
+    )
+}
+_DOW_NAMES = {
+    name: index
+    for index, name in enumerate(
+        ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT")
+    )
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _bad(expr):
+    return ValueError(f"bad schedule: {expr!r}")
+
+
+def _value(token, low, high, names, expr):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+        if not low <= value <= high:
+            raise _bad(expr)
+        return value
+    if names is not None and token.upper() in names:
+        return names[token.upper()]
+    raise _bad(expr)
+
+
+def _range_values(text, low, high, names, expr):
+    parts = text.split("-")
+    if len(parts) != 2:
+        raise _bad(expr)
+    start = _value(parts[0], low, high, names, expr)
+    end = _value(parts[1], low, high, names, expr)
+    if start <= end:
+        return list(range(start, end + 1))
+    return list(range(start, high + 1)) + list(range(low, end + 1))
+
+
+def _item_values(item, low, high, names, expr):
+    if not item:
+        raise _bad(expr)
+
+    if "/" in item:
+        if item.count("/") > 1:
+            raise _bad(expr)
+        base, step_text = item.split("/")
+        if not _NUMBER.fullmatch(step_text):
+            raise _bad(expr)
+        step = int(step_text)
+        if step < 1:
+            raise _bad(expr)
+        if names is not None and any(char.isalpha() for char in base):
+            raise _bad(expr)
+        if base == "*":
+            values = list(range(low, high + 1))
+        elif "-" in base:
+            values = _range_values(base, low, high, names, expr)
+        else:
+            start = _value(base, low, high, names, expr)
+            values = list(range(start, high + 1))
+        return values[::step]
+
+    if item == "*":
+        return list(range(low, high + 1))
+    if "-" in item:
+        return _range_values(item, low, high, names, expr)
+    return [_value(item, low, high, names, expr)]
+
+
+def _simple_field(text, low, high, names, expr):
+    if text == "?":
+        raise _bad(expr)
+    values = set()
+    for item in text.split(","):
+        values.update(_item_values(item, low, high, names, expr))
+    return values
+
+
+def _dom_field(text, expr):
+    if text == "?":
+        return set(range(1, 32)), False
+    values = set()
+    last = False
+    for item in text.split(","):
+        if item == "L":
+            last = True
+        else:
+            values.update(_item_values(item, 1, 31, None, expr))
+    return values, last
+
+
+def _dow_field(text, expr):
+    if text == "?":
+        return set(), set(), set()
+    values = set()
+    last = set()
+    nth = set()
+    for item in text.split(","):
+        match = re.fullmatch(r"([0-9]+)L", item)
+        if match:
+            day = int(match.group(1))
+            if not 0 <= day <= 7:
+                raise _bad(expr)
+            last.add(day % 7)
+            continue
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if match:
+            day = int(match.group(1))
+            count = int(match.group(2))
+            if not (0 <= day <= 7 and 1 <= count <= 5):
+                raise _bad(expr)
+            nth.add((day % 7, count))
+            continue
+        if "L" in item or "#" in item:
+            raise _bad(expr)
+        values.update(_item_values(item, 0, 7, _DOW_NAMES, expr))
+    return {value % 7 for value in values}, last, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise _bad(expr)
+    text = expr.strip()
+    if text.startswith("@"):
+        shortcut = _SHORTCUTS.get(text.lower())
+        if shortcut is None:
+            raise _bad(expr)
+        text = shortcut
+
+    parts = text.split()
+    if len(parts) != 5:
+        raise _bad(expr)
+    minute_text, hour_text, dom_text, month_text, dow_text = parts
+
+    minutes = tuple(sorted(_simple_field(minute_text, 0, 59, None, expr)))
+    hours = tuple(sorted(_simple_field(hour_text, 0, 23, None, expr)))
+    months = tuple(sorted(_simple_field(month_text, 1, 12, _MONTH_NAMES, expr)))
+    dom_values, dom_last = _dom_field(dom_text, expr)
+    dow_values, dow_last, dow_nth = _dow_field(dow_text, expr)
+
+    return {
+        "minutes": minutes,
+        "hours": hours,
+        "months": months,
+        "dom_values": dom_values,
+        "dom_last": dom_last,
+        "dow_values": dow_values,
+        "dow_last": dow_last,
+        "dow_nth": dow_nth,
+        "dom_restricted": dom_text not in ("*", "?"),
+        "dow_restricted": dow_text not in ("*", "?"),
+    }
+
+
+def _cron_weekday(day):
+    return (day.weekday() + 1) % 7
+
+
+def _last_day_of_month(day):
+    return calendar.monthrange(day.year, day.month)[1]
+
+
+def _dom_matches(schedule, day):
+    if day.day in schedule["dom_values"]:
+        return True
+    return schedule["dom_last"] and day.day == _last_day_of_month(day)
+
+
+def _dow_matches(schedule, day):
+    weekday = _cron_weekday(day)
+    if weekday in schedule["dow_values"]:
+        return True
+    if weekday in schedule["dow_last"] and day.day + 7 > _last_day_of_month(day):
+        return True
+    for wanted, count in schedule["dow_nth"]:
+        if weekday == wanted and (day.day - 1) // 7 + 1 == count:
+            return True
+    return False
+
+
+def _day_allowed(schedule, day):
+    if day.month not in schedule["months"]:
+        return False
+    dom = _dom_matches(schedule, day)
+    dow = _dow_matches(schedule, day)
+    if schedule["dom_restricted"] and schedule["dow_restricted"]:
+        return dom or dow
+    if schedule["dom_restricted"]:
+        return dom
+    if schedule["dow_restricted"]:
+        return dow
+    return True
+
+
+def _first_time(schedule, day, min_hour, min_minute):
+    for hour in schedule["hours"]:
+        if hour < min_hour:
+            continue
+        for minute in schedule["minutes"]:
+            if hour == min_hour and minute < min_minute:
+                continue
+            return datetime(day.year, day.month, day.day, hour, minute)
+    return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    if when.minute not in schedule["minutes"]:
