 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = ["jan", "feb", "mar", "apr", "may", "jun",
+           "jul", "aug", "sep", "oct", "nov", "dec"]
+_DAYS = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]
+_MONTH_NAMES = {name: i + 1 for i, name in enumerate(_MONTHS)}
+_DAY_NAMES = {name: i for i, name in enumerate(_DAYS)}
+
+# (minimum, maximum, names) per field; day of week allows 7 as well as 0 for Sunday.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTH_NAMES),
+    (0, 7, _DAY_NAMES),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+def _value(token, index):
+    """One field value, from a number or (where allowed) a name."""
+    low, high, names = _FIELDS[index]
+    if _NUMBER.fullmatch(token):
+        n = int(token)
+    elif names is not None and token.lower() in names:
+        n = names[token.lower()]
+    else:
+        raise ValueError(f"bad value {token!r}")
+    if not low <= n <= high:
+        raise ValueError(f"value {token!r} out of range")
+    return n
+
+
+def _range(token, index):
+    """Values listed by '*', 'N' or 'A-B' (before any step), in order."""
+    low, high, _ = _FIELDS[index]
+    if token == "*":
+        return list(range(low, high + 1))
+    if "-" in token:
+        a_text, b_text = token.split("-", 1)
+        if not a_text or not b_text:
+            raise ValueError(f"bad range {token!r}")
+        a, b = _value(a_text, index), _value(b_text, index)
+        if index == _DOW:
+            if a == 7:
+                a = 0
+            if a > b:
+                # Wraps through 0-6 with 7 treated as 0.
+                return list(range(a, 7)) + list(range(0, b + 1))
+            return list(range(a, b + 1))
+        if a > b:
+            return list(range(a, high + 1)) + list(range(low, b + 1))
+        return list(range(a, b + 1))
+    return [_value(token, index)]
+
+
+def _item(token, index, parsed):
+    """Add one comma-separated item to parsed, a dict describing the field."""
+    if not token:
+        raise ValueError("empty item")
+    upper = token.upper()
+    if index == _DOM and upper == "L":
+        parsed["last_dom"] = True
+        return
+    if index == _DOW:
+        if upper.endswith("L") and _NUMBER.fullmatch(token[:-1] or "x"):
+            n = _value(token[:-1], _DOW)
+            parsed["last_dow"].add(n % 7)
+            return
+        if "#" in token:
+            n_text, k_text = token.split("#", 1)
+            if not (_NUMBER.fullmatch(n_text) and _NUMBER.fullmatch(k_text)):
+                raise ValueError(f"bad item {token!r}")
+            n, k = _value(n_text, _DOW), int(k_text)
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad week number in {token!r}")
+            parsed["nth_dow"].add((n % 7, k))
+            return
