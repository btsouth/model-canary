+    if "/" in token:
+        token, step_text = token.split("/", 1)
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step {step_text!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError("step must be at least 1")
+        if token != "*" and "-" not in token:
+            # N/S lists N up to the field's maximum; N must be a number here.
+            if not _NUMBER.fullmatch(token):
+                raise ValueError(f"bad step item {token!r}")
+            low, high, _ = _FIELDS[index]
+            values = list(range(_value(token, index), high + 1))
+        else:
+            values = _range(token, index)
+    else:
+        values = _range(token, index)
+    values = values[::step]
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    parsed["values"].update(values)
+
+
+def _field(text, index):
+    parsed = {"values": set(), "last_dom": False, "last_dow": set(), "nth_dow": set(),
+              "restricted": True}
+    if text == "*" or (text == "?" and index in (_DOM, _DOW)):
+        parsed["restricted"] = False
+        low, high, _ = _FIELDS[index]
+        parsed["values"] = set(range(low, high + 1))
+        return parsed
+    for token in text.split(","):
+        _item(token, index, parsed)
+    return parsed
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {text!r}") from None
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}")
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_allowed(fields, year, month, day):
+    dom, dow = fields[_DOM], fields[_DOW]
+    if not dom["restricted"] and not dow["restricted"]:
+        return True
+    days_in_month = calendar.monthrange(year, month)[1]
+    weekday = (calendar.weekday(year, month, day) + 1) % 7  # Sunday is 0
+
+    dom_ok = day in dom["values"] or (dom["last_dom"] and day == days_in_month)
+    dow_ok = (weekday in dow["values"]
+              or (weekday in dow["last_dow"] and day + 7 > days_in_month)
+              or (weekday, (day - 1) // 7 + 1) in dow["nth_dow"])
+
+    if dom["restricted"] and dow["restricted"]:
+        return dom_ok or dow_ok
+    return dom_ok if dom["restricted"] else dow_ok
 
 
