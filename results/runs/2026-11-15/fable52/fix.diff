 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+# (minimum, maximum, names)
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_RANGES = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+def _value(text, index):
+    low, high, names = _RANGES[index]
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _item(item, index):
+    """The ordered list of values one plain item (not L, NL or N#K) lists."""
+    low, high, _ = _RANGES[index]
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+    if base == "*":
+        values = list(range(low, 7 if index == _DOW else high + 1))
+    elif "-" in base:
+        first_text, _, last_text = base.partition("-")
+        first, last = _value(first_text, index), _value(last_text, index)
+        if first <= last:
+            values = list(range(first, last + 1))
+        elif index == _DOW:
+            first %= 7
+            if first <= last:
+                values = list(range(first, last + 1))
+            else:
+                values = list(range(first, 7)) + list(range(0, last + 1))
+        else:
+            values = list(range(first, high + 1)) + list(range(low, last + 1))
+    else:
+        first = _value(base, index)
+        values = list(range(first, high + 1)) if slash else [first]
+    if step is not None:
+        values = values[::step]
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    return values
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad expression: {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            text = _SHORTCUTS[text.lower()]
+        parts = re.split(r"[ \t]+", text)
+        if len(parts) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        self.sets = []
+        self.last_dom = False
+        self.last_dows = set()
+        self.nth_dows = set()
+        for index, field in enumerate(parts):
+            values = set()
+            if field == "?" and index in (_DOM, _DOW):
+                field = "*"
+            for item in field.split(","):
+                if index == _DOM and item == "L":
+                    self.last_dom = True
+                    continue
+                if index == _DOW:
+                    match = _LAST_DOW.fullmatch(item)
+                    if match:
+                        self.last_dows.add(_value(match.group(1), index) % 7)
+                        continue
+                    match = _NTH_DOW.fullmatch(item)
+                    if match:
+                        nth = int(match.group(2))
+                        if not 1 <= nth <= 5:
+                            raise ValueError(f"bad item: {item!r}")
+                        self.nth_dows.add((_value(match.group(1), index) % 7, nth))
+                        continue
+                values.update(_item(item, index))
+            self.sets.append(values)
+        self.minutes = sorted(self.sets[_MINUTE])
+        self.hours = sorted(self.sets[_HOUR])
+        self.dom_restricted = parts[_DOM] not in ("*", "?")
+        self.dow_restricted = parts[_DOW] not in ("*", "?")
+
+    def day_ok(self, year, month, day):
+        if month not in self.sets[_MONTH]:
+            return False
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+        first_weekday, length = calendar.monthrange(year, month)
+        if self.dom_restricted:
+            if day in self.sets[_DOM] or (self.last_dom and day == length):
+                return True
+            if not self.dow_restricted:
+                return False
+        weekday = (first_weekday + 1 + day - 1) % 7  # 0 is Sunday
+        return (
+            weekday in self.sets[_DOW]
+            or (weekday in self.last_dows and day + 7 > length)
+            or (weekday, (day - 1) // 7 + 1) in self.nth_dows
+        )
+
+    def first_time(self, hour=0, minute=0):
+        """The first (hour, minute) run at or after the given time of day."""
+        for h in self.hours:
+            if h < hour:
+                continue
+            for m in self.minutes:
+                if h > hour or m >= minute:
+                    return h, m
+        return None
 
 
