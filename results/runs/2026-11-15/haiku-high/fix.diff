index 8965296..9fbf73a 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,200 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"],
+        start=1,
+    )
+}
+_DAY_NAMES = {
+    name: number
+    for number, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])
+}
+
+# (lowest, highest, names) for minute, hour, day of month, month, day of week.
+_RANGES = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTH_NAMES),
+    (0, 7, _DAY_NAMES),
+]
+_DOM = 2
+_DOW = 4
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_DAY = re.compile(r"([0-9]+)[lL]")
+_NTH_DAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+_LIMIT_DAYS = 10 * 365
+
+
+def _number(text, lo, hi, names=None):
+    """Read one value: plain digits, or a name if the field allows names."""
+    if _DIGITS.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {value} outside {lo}-{hi}")
+    return value
+
+
+def _parse_field(text, index):
+    """Return (values, specials) for one field.
+
+    values is the set of numbers the field lists (day of week folded to 0-6).
+    specials holds the day-only forms: ("L",) for the last day of the month,
+    ("last", N) for the last weekday N, and ("nth", N, K) for the K-th weekday N.
+    """
+    lo, hi, names = _RANGES[index]
+    is_dom = index == _DOM
+    is_dow = index == _DOW
+    if (is_dom or is_dow) and text == "?":
+        text = "*"
+    values, specials = set(), set()
+
+    for item in text.split(","):
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+        else:
+            step = 1
+
+        special = None
+        if is_dom and base.upper() == "L":
+            special = ("L",)
+        elif is_dow and _LAST_DAY.fullmatch(base):
+            day = _LAST_DAY.fullmatch(base)
+            special = ("last", _number(day.group(1), 0, 7) % 7)
+        elif is_dow and _NTH_DAY.fullmatch(base):
+            nth = _NTH_DAY.fullmatch(base)
+            special = ("nth", _number(nth.group(1), 0, 7) % 7,
+                       _number(nth.group(2), 1, 5))
+        if special is not None:
+            if slash:
+                raise ValueError(f"step not allowed in {item!r}")
+            specials.add(special)
+            continue
+
+        if base == "*":
+            listed = list(range(lo, hi + 1))
+        else:
+            start_text, dash, end_text = base.partition("-")
+            start = _number(start_text, lo, hi, names)
+            if not dash:
+                listed = list(range(start, hi + 1)) if slash else [start]
+            else:
+                end = _number(end_text, lo, hi, names)
+                if start <= end:
+                    listed = list(range(start, end + 1))
+                else:
+                    top = 6 if is_dow else hi
+                    listed = list(range(start, top + 1)) + list(range(lo, end + 1))
+        for value in listed[::step]:
+            values.add(value % 7 if is_dow else value)
+    return values, specials
+
+
+class _Schedule:
+    """A parsed expression, ready for matching."""
+
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"schedule must be a string: {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            text = _SHORTCUTS[text.lower()]
+        fields = re.split(r"[ \t]+", text)
+        if len(fields) != 5:
+            raise ValueError(f"expected 5 fields: {expr!r}")
+        minute, hour, dom, month, dow = fields
+        self.minutes, _ = _parse_field(minute, 0)
+        self.hours, _ = _parse_field(hour, 1)
+        self.doms, self.dom_specials = _parse_field(dom, _DOM)
+        self.months, _ = _parse_field(month, 3)
+        self.dows, self.dow_specials = _parse_field(dow, _DOW)
+        self.dom_restricted = dom not in ("*", "?")
+        self.dow_restricted = dow not in ("*", "?")
+
+
+def _day_matches(schedule, day):
+    """True if the schedule allows the calendar date day."""
+    last = calendar.monthrange(day.year, day.month)[1]
+    weekday = (day.weekday() + 1) % 7  # cron numbering: Sunday is 0
+    dom_hit = day.day in schedule.doms or (
+        ("L",) in schedule.dom_specials and day.day == last
+    )
+    dow_hit = (
+        weekday in schedule.dows
+        or (("last", weekday) in schedule.dow_specials and day.day + 7 > last)
+        or (("nth", weekday, (day.day - 1) // 7 + 1) in schedule.dow_specials)
+    )
+    if schedule.dom_restricted and schedule.dow_restricted:
+        return dom_hit or dow_hit
+    if schedule.dom_restricted:
+        return dom_hit
+    if schedule.dow_restricted:
+        return dow_hit
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _Schedule(expr)
+    return (
+        when.minute in schedule.minutes
+        and when.hour in schedule.hours
+        and when.month in schedule.months
+        and _day_matches(schedule, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    schedule = _Schedule(expr)
+    start = after.replace(second=0, microsecond=0)
+    try:
+        start += _dt.timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _dt.timedelta(days=_LIMIT_DAYS)
+    except OverflowError:
+        limit = _dt.datetime.max
+
+    times = sorted(h * 60 + m for h in schedule.hours for m in schedule.minutes)
+    day = start.date()
+    last_day = limit.date()
+    while day <= last_day:
+        if day.month in schedule.months and _day_matches(schedule, day):
+            for t in times:
+                run = _dt.datetime.combine(day, _dt.time(t // 60, t % 60))
+                if run >= start:
+                    return run if run <= limit else None
+        if day == last_day:
+            break
+        day += _dt.timedelta(days=1)
+    return None
