 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+from collections import namedtuple
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], start=1)}
+_DAY_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_NAME = re.compile(r"[A-Za-z]{3}")
+_NUM = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)[Ll]")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+# Parsed form of an expression. dom/dow hold the matching values; *_restricted is
+# False only when the field is exactly '*' or '?'. dow values are normalised to 0-6.
+_Spec = namedtuple(
+    "_Spec",
+    "minutes hours dom dom_last dom_restricted months dow dow_nth dow_last dow_restricted",
+)
+
+
+def _all_values(lo, hi, kind):
+    if kind == "dow":
+        return set(range(7))
+    return set(range(lo, hi + 1))
+
+
+def _value(token, lo, hi, names):
+    if names is not None and _NAME.fullmatch(token) and token.upper() in names:
+        return names[token.upper()]
+    if _NUM.fullmatch(token):
+        value = int(token)
+        if lo <= value <= hi:
+            return value
+    raise ValueError(f"bad value {token!r}")
+
+
+def _parse_item(item, lo, hi, names, kind):
+    """Parse one comma-separated item. Returns (values, extras)."""
+    if not item:
+        raise ValueError("empty item")
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _NUM.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    if not base:
+        raise ValueError(f"bad item {item!r}")
+
+    extra = None
+    if kind == "dom" and base.upper() == "L":
+        extra = ("L",)
+    elif kind == "dow":
+        last = _LAST_WEEKDAY.fullmatch(base)
+        nth = _NTH_WEEKDAY.fullmatch(base)
+        if last:
+            day = int(last.group(1))
+            if day > 7:
+                raise ValueError(f"bad weekday in {item!r}")
+            extra = ("L", day % 7)
+        elif nth:
+            day, k = int(nth.group(1)), int(nth.group(2))
+            if day > 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad nth weekday in {item!r}")
+            extra = ("#", day % 7, k)
+    if extra is not None:
+        if step is not None:
+            raise ValueError(f"step not allowed in {item!r}")
+        return set(), [extra]
+
+    if step is not None and re.search(r"[A-Za-z]", base):
+        raise ValueError(f"names not allowed in a step: {item!r}")
+
+    if base == "*":
+        seq = list(range(lo, hi + 1))
+    elif "-" in base:
+        a_text, _, b_text = base.partition("-")
+        a = _value(a_text, lo, hi, names)
+        b = _value(b_text, lo, hi, names)
+        # Day-of-week wraps through 0 to 6 with 7 treated as 0.
+        wrap_max = 6 if kind == "dow" else hi
+        if a <= b:
+            seq = list(range(a, b + 1))
+        else:
+            seq = list(range(a, wrap_max + 1)) + list(range(lo, b + 1))
+    else:
+        a = _value(base, lo, hi, names)
+        seq = list(range(a, hi + 1)) if step is not None else [a]
+
+    if step is not None:
+        seq = seq[::step]
+    if kind == "dow":
+        seq = [v % 7 for v in seq]
+    return set(seq), []
+
+
+def _parse_field(text, lo, hi, names, kind):
+    """Parse one field. Returns (values, extras, restricted)."""
+    if text == "*" or (text == "?" and kind is not None):
+        return _all_values(lo, hi, kind), [], False
+    if text == "?":
+        raise ValueError("'?' is only allowed in the day fields")
+    values, extras = set(), []
+    for item in text.split(","):
+        vals, ex = _parse_item(item, lo, hi, names, kind)
+        values |= vals
+        extras.extend(ex)
+    return values, extras, True
+
+
+def _compile(expr):
+    """Check expr completely and return its parsed form. Raises ValueError if bad."""
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    minutes, _, _ = _parse_field(parts[0], 0, 59, None, None)
+    hours, _, _ = _parse_field(parts[1], 0, 23, None, None)
+    dom, dom_extras, dom_restricted = _parse_field(parts[2], 1, 31, None, "dom")
+    months, _, _ = _parse_field(parts[3], 1, 12, _MONTH_NAMES, None)
+    dow, dow_extras, dow_restricted = _parse_field(parts[4], 0, 7, _DAY_NAMES, "dow")
+    return _Spec(
+        minutes=frozenset(minutes),
+        hours=frozenset(hours),
+        dom=frozenset(dom),
+        dom_last=any(e[0] == "L" for e in dom_extras),
+        dom_restricted=dom_restricted,
+        months=frozenset(months),
+        dow=frozenset(dow),
+        dow_nth=tuple((e[1], e[2]) for e in dow_extras if e[0] == "#"),
+        dow_last=tuple(e[1] for e in dow_extras if e[0] == "L"),
+        dow_restricted=dow_restricted,
+    )
+
+
+def _day_ok(spec, day):
+    """True if the schedule allows the calendar date day."""
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    dom_hit = day.day in spec.dom or (spec.dom_last and day.day == days_in_month)
+    weekday = (day.weekday() + 1) % 7  # cron: Sunday is 0
+    dow_hit = (
+        weekday in spec.dow
+        or any(weekday == n and (day.day - 1) // 7 + 1 == k for n, k in spec.dow_nth)
+        or any(weekday == n and day.day + 7 > days_in_month for n in spec.dow_last)
+    )
+    if spec.dom_restricted and spec.dow_restricted:
+        return dom_hit or dow_hit
+    if spec.dom_restricted:
+        return dom_hit
+    if spec.dow_restricted:
+        return dow_hit
+    return True
+
 
