 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, time, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_WEEKDAYS = {name: i for i, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_FIELDS = ((0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _WEEKDAYS))
+
+
+def _atom(text, index, names, step_part=False):
+    if not text:
+        raise ValueError("empty schedule value")
+    if re.fullmatch(r"[0-9]+", text):
+        return int(text)
+    if names is not None and not step_part and text.upper() in names:
+        return names[text.upper()]
+    raise ValueError(f"bad schedule value: {text!r}")
+
+
+def _parse_field(text, index):
+    lo, hi, names = _FIELDS[index]
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError("? is only valid in day fields")
+        text = "*"
+        unrestricted = True
+    else:
+        unrestricted = text == "*"
+    if "?" in text:
+        raise ValueError("? must be the whole day field")
+    values = set()
+    last_dom = False
+    dow_last = set()
+    dow_nth = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if index == 2 and item == "L":
+            last_dom = True
+            continue
+        if index == 4:
+            m = re.fullmatch(r"([0-9]+)L", item)
+            if m:
+                n = int(m.group(1))
+                if not 0 <= n <= 7:
+                    raise ValueError("day of week out of range")
+                dow_last.add(n % 7)
+                continue
+            m = re.fullmatch(r"([0-9]+)#([1-5])", item)
+            if m:
+                n, k = map(int, m.groups())
+                if not 0 <= n <= 7:
+                    raise ValueError("day of week out of range")
+                dow_nth.add((n % 7, k))
+                continue
+        if "L" in item or "#" in item:
+            raise ValueError("invalid calendar day expression")
+        if item.count("/") > 1:
+            raise ValueError("invalid step")
+        base, slash, step_s = item.partition("/")
+        step = 1
+        if slash:
+            if not re.fullmatch(r"[0-9]+", step_s) or int(step_s) < 1:
+                raise ValueError("step must be positive")
+            step = int(step_s)
+            if names and any(c.isalpha() for c in base):
+                raise ValueError("names are not allowed with steps")
+        if base == "*":
+            sequence = list(range(lo, hi + 1))
+        elif base.count("-") == 1:
+            left, right = base.split("-")
+            a, b = _atom(left, index, names), _atom(right, index, names)
+            if not lo <= a <= hi or not lo <= b <= hi:
+                raise ValueError("schedule value out of range")
+            if index == 4:
+                # The stated 0..7 range contains every weekday once, with 7
+                # serving as another spelling of Sunday.
+                if a <= b:
+                    sequence = list(range(a, b + 1))
+                else:
+                    start, end = a % 7, b % 7
+                    sequence = list(range(start, 7)) + list(range(0, end + 1))
+                sequence = [v % 7 for v in sequence]
+            elif a <= b:
+                sequence = list(range(a, b + 1))
+            else:
+                sequence = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        elif "-" in base:
+            raise ValueError("invalid range")
+        else:
+            a = _atom(base, index, names)
+            if not lo <= a <= hi:
+                raise ValueError("schedule value out of range")
+            sequence = list(range(a, hi + 1)) if slash else [a]
+            if index == 4:
+                sequence = [v % 7 for v in sequence]
+        values.update(sequence[::step])
+    if not values and not last_dom and not dow_last and not dow_nth:
+        raise ValueError("empty schedule field")
+    return {"values": values, "unrestricted": unrestricted,
+            "last_dom": last_dom, "dow_last": dow_last, "dow_nth": dow_nth}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    stripped = expr.strip()
+    shortcut = _SHORTCUTS.get(stripped.lower())
+    if shortcut is not None:
+        stripped = shortcut
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_parse_field(field, i) for i, field in enumerate(fields)]
+
+
+def _dow(date):
+    return (date.weekday() + 1) % 7
+
+
+def _day_matches(dom, dow, date):
+    dom_match = date.day in dom["values"] or (dom["last_dom"] and date.day == calendar.monthrange(date.year, date.month)[1])
+    weekday = _dow(date)
+    dow_match = weekday in dow["values"]
+    if any(day == weekday and date.day + 7 > calendar.monthrange(date.year, date.month)[1]
+           for day in dow["dow_last"]):
+        dow_match = True
+    if any(day == weekday and (date.day - 1) // 7 + 1 == nth for day, nth in dow["dow_nth"]):
+        dow_match = True
+    if dom["unrestricted"] and dow["unrestricted"]:
+        return True
+    if dom["unrestricted"]:
+        return dow_match
+    if dow["unrestricted"]:
+        return dom_match
+    return dom_match or dow_match
 
 
