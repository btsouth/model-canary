 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    raw = expr.strip()
+    if raw.startswith("@"):
+        try:
+            raw = _SHORTCUTS[raw.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", raw) if raw else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    bounds = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+    names = [None, None, None, _MONTHS, _DAYS]
+    parsed, unrestricted = [], []
+    for idx, (field, (lo, hi)) in enumerate(zip(fields, bounds)):
+        if field == "?":
+            if idx not in (2, 4):
+                raise ValueError("? is only valid in day fields")
+            field = "*"
+        unrestricted.append(field == "*")
+        values = set()
+        for item in field.split(","):
+            if not item:
+                raise ValueError("empty schedule item")
+            special = None
+            if idx == 2 and item == "L":
+                special = ("last",)
+            elif idx == 4:
+                m = re.fullmatch(r"(\d+)L", item)
+                h = re.fullmatch(r"(\d+)#([1-5])", item)
+                if m:
+                    n = int(m.group(1)); _check(n, 0, 7); special = ("last_weekday", n % 7)
+                elif h:
+                    n = int(h.group(1)); _check(n, 0, 7); special = ("nth_weekday", n % 7, int(h.group(2)))
+            if special:
+                values.add(special)
+                continue
+            if "L" in item or "#" in item:
+                raise ValueError("invalid special day item")
+            if "/" in item:
+                if item.count("/") != 1:
+                    raise ValueError("invalid step")
+                base, steptext = item.split("/")
+                if not steptext.isdigit() or int(steptext) < 1:
+                    raise ValueError("invalid step")
+                step = int(steptext)
+            else:
+                base, step = item, 1
+            if not base:
+                raise ValueError("empty item")
+            if base == "*":
+                seq = list(range(lo, hi + 1))
+            elif "-" in base:
+                if base.count("-") != 1:
+                    raise ValueError("invalid range")
+                a, b = base.split("-")
+                a = _value(a, idx, lo, hi, names); b = _value(b, idx, lo, hi, names)
+                if idx == 4:
+                    a %= 7; b %= 7
+                seq = list(range(a, b + 1)) if a <= b else list(range(a, hi + 1)) + list(range(lo, b + 1))
+            else:
+                a = _value(base, idx, lo, hi, names)
+                seq = list(range(a, hi + 1)) if "/" in item else [a]
+            if idx == 4:
+                seq = [v % 7 for v in seq]
+            values.update(seq[::step])
+        if not values:
+            raise ValueError("empty field")
+        parsed.append(values)
+    return parsed, unrestricted
+
+
+def _check(n, lo, hi):
+    if n < lo or n > hi:
+        raise ValueError("value outside field range")
+
+
+def _value(token, idx, lo, hi, names):
+    token = token.upper()
+    if token in (names[idx] or {}):
+        return names[idx][token]
+    if not token.isdigit():
+        raise ValueError("invalid field value")
+    n = int(token); _check(n, lo, hi)
+    return n
+
+
+def _day_allowed(parsed, unrestricted, date):
+    dom, dow = parsed[2], parsed[4]
+    actual_dow = (date.weekday() + 1) % 7
+    lastday = calendar.monthrange(date.year, date.month)[1]
+    dom_match = date.day in dom or ("last",) in dom and date.day == lastday
+    dow_match = False
+    for item in dow:
+        if isinstance(item, tuple) and item[0] == "last_weekday":
+            if actual_dow == item[1] and date.day + 7 > lastday:
+                dow_match = True
+        elif isinstance(item, tuple) and item[0] == "nth_weekday":
+            if actual_dow == item[1] and (date.day - 1) // 7 + 1 == item[2]:
+                dow_match = True
+        elif not isinstance(item, tuple) and actual_dow == item:
+            dow_match = True
+    if unrestricted[2] and unrestricted[4]: return True
+    if unrestricted[2]: return dow_match
+    if unrestricted[4]: return dom_match
+    return dom_match or dow_match
+
+
+def _matches(parsed, unrestricted, when):
+    return (when.minute in parsed[0] and when.hour in parsed[1] and when.month in parsed[3]
+            and _day_allowed(parsed, unrestricted, when.date()))
+
 
