 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (minimum, maximum, names mapping to values or None)
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {n: i + 1 for i, n in enumerate(_MONTHS)}),
+    (0, 7, {n: i for i, n in enumerate(_DAYS)}),
+]
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "doms", "dom_last", "months",
+                 "dows", "dow_last", "dow_nth", "dom_any", "dow_any")
+
+
+def _value(text, index):
+    low, high, names = _FIELDS[index]
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range")
+    return value
+
+
+def _number(text, low, high):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"number {text!r} out of range")
+    return value
+
+
+def _range_values(base, index):
+    low, high, _ = _FIELDS[index]
+    if base == "*":
+        return list(range(low, high + 1))
+    if "-" in base:
+        a_text, b_text = base.split("-", 1)
+        a, b = _value(a_text, index), _value(b_text, index)
+        if a <= b:
+            return list(range(a, b + 1))
+        if index == 4:
+            a, b = a % 7, b % 7
+            out = [a]
+            while out[-1] != b:
+                out.append((out[-1] + 1) % 7)
+            return out
+        return list(range(a, high + 1)) + list(range(low, b + 1))
+    return None
+
+
+def _parse_field(text, index, sched):
+    low, high, _ = _FIELDS[index]
+    values = set()
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError("'?' is only allowed in the day fields")
+        return values, True
+    unrestricted = text == "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == 2 and item == "L":
+            sched.dom_last = True
+            continue
+        if index == 4:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                sched.dow_last.add(_number(m.group(1), 0, 7) % 7)
+                continue
+            m = _NTH.fullmatch(item)
+            if m:
+                n = _number(m.group(1), 0, 7) % 7
+                k = _number(m.group(2), 1, 5)
+                sched.dow_nth.add((n, k))
+                continue
+        if "/" in item:
+            base, step_text = item.split("/", 1)
+            if not _NUM.fullmatch(step_text):
+                raise ValueError(f"bad step {step_text!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError("step must be at least 1")
+        else:
+            base, step = item, 1
+        listed = _range_values(base, index)
+        if listed is None:
+            start = _value(base, index)
+            listed = [start] if step == 1 and "/" not in item else list(range(start, high + 1))
+        values.update(listed[::step])
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text) if text else []
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    sched = _Schedule()
+    sched.dom_last = False
+    sched.dow_last = set()
+    sched.dow_nth = set()
+    sched.minutes, _ = _parse_field(parts[0], 0, sched)
+    sched.hours, _ = _parse_field(parts[1], 1, sched)
+    sched.doms, sched.dom_any = _parse_field(parts[2], 2, sched)
+    sched.months, _ = _parse_field(parts[3], 3, sched)
+    sched.dows, sched.dow_any = _parse_field(parts[4], 4, sched)
+    sched.minutes = sorted(sched.minutes)
+    sched.hours = sorted(sched.hours)
+    return sched
+
+
+def _day_ok(sched, date):
+    if date.month not in sched.months:
+        return False
+    if sched.dom_any and sched.dow_any:
+        return True
+    last = calendar.monthrange(date.year, date.month)[1]
+    day = date.day
+    dom = day in sched.doms or (sched.dom_last and day == last)
+    weekday = date.isoweekday() % 7
+    dow = (weekday in sched.dows
+           or (weekday in sched.dow_last and day + 7 > last)
+           or (weekday, (day - 1) // 7 + 1) in sched.dow_nth)
+    if sched.dom_any:
+        return dow
+    if sched.dow_any:
+        return dom
+    return dom or dow
 
 
