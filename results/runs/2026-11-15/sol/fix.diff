 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+
+_MONTHS = {name: i for i, name in enumerate(
+    'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    'SUN MON TUE WED THU FRI SAT'.split())}
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_LIMITS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(text):
+    if re.fullmatch(r'[0-9]+', text) is None:
+        raise ValueError('expected decimal digits')
+    try:
+        return int(text)
+    except ValueError:
+        raise ValueError('invalid number') from None
+
+
+def _value(text, field):
+    names = _MONTHS if field == 3 else _DAYS if field == 4 else {}
+    value = names[text] if text in names else _number(text)
+    low, high = _LIMITS[field]
+    if not low <= value <= high:
+        raise ValueError('value outside field range')
+    return value % 7 if field == 4 else value
+
+
+def _field(text, field):
+    unrestricted = text in ('*', '?')
+    if text == '?' and field in (2, 4):
+        text = '*'
+    values, special = set(), []
+    low, high = _LIMITS[field]
+    if field == 4:
+        high = 6
+    for item in text.split(','):
+        if field == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        if field == 4:
+            match = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+            if match:
+                day = _value(match[1], field)
+                if match[2] == 'L':
+                    special.append(('last_weekday', day))
+                else:
+                    nth = _number(match[3])
+                    if not 1 <= nth <= 5:
+                        raise ValueError('weekday occurrence outside range')
+                    special.append(('nth_weekday', day, nth))
+                continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('invalid step')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            endpoints = base.split('-')
+            if len(endpoints) != 2:
+                raise ValueError('invalid range')
+            start, end = (_value(part, field) for part in endpoints)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _value(base, field)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(sequence[::step])
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(text, i) for i, text in enumerate(fields)]
+
+
+def _day_matches(fields, date):
+    dom, dow = fields[2], fields[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    month_match = date.day in dom[0] or bool(dom[1] and date.day == last)
+    week_match = weekday in dow[0]
+    for special in dow[1]:
+        if weekday == special[1]:
+            if special[0] == 'last_weekday':
+                week_match |= date.day + 7 > last
+            else:
+                week_match |= (date.day - 1) // 7 + 1 == special[2]
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return week_match
+    if dow[2]:
+        return month_match
+    return month_match or week_match
+
 
