 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _bad(msg):
+    raise ValueError(msg)
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names and tok.isalpha() and tok.isascii():
+        v = names[tok.upper()]
+    else:
+        return _bad(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        _bad(f"value out of range {tok!r}")
+    return v
+
+
+def _parse_field(text, kind):
+    """Return (values, extra) where values is a set and extra holds specials."""
+    lo, hi, names = {
+        "minute": (0, 59, None), "hour": (0, 23, None), "dom": (1, 31, None),
+        "month": (1, 12, _MONTHS), "dow": (0, 7, _DAYS),
+    }[kind]
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            _bad("? not allowed here")
+        text = "*"
+    values, last, nth, lastdow = set(), False, set(), set()
+    for item in text.split(","):
+        if not item:
+            _bad("empty item")
+        parts = item.split("/")
+        if len(parts) > 2:
+            _bad("bad step")
+        base = parts[0]
+        step = 1
+        if len(parts) == 2:
+            if not _NUM.fullmatch(parts[1]) or int(parts[1]) < 1:
+                _bad("bad step")
+            step = int(parts[1])
+        if not base:
+            _bad("empty item")
+        special = None
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+            if kind == "dow":
+                seq = list(range(0, 7))
+        elif kind == "dom" and base == "L":
+            special = ("L",)
+        elif kind == "dow" and re.fullmatch(r"[0-9]+L", base):
+            n = int(base[:-1])
+            if n > 7:
+                _bad("bad day")
+            special = ("lastdow", n % 7)
+        elif kind == "dow" and "#" in base:
+            a, _, k = base.partition("#")
+            if not (_NUM.fullmatch(a) and _NUM.fullmatch(k)):
+                _bad("bad N#K")
+            if int(a) > 7 or not 1 <= int(k) <= 5:
+                _bad("bad N#K")
+            special = ("nth", int(a) % 7, int(k))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            av, bv = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if av <= bv:
+                seq = list(range(av, bv + 1))
+            elif kind == "dow":
+                seq, c = [], av % 7
+                while True:
+                    seq.append(c)
+                    if c == bv % 7:
+                        break
+                    c = (c + 1) % 7
+            else:
+                seq = list(range(av, hi + 1)) + list(range(lo, bv + 1))
+        else:
+            v = _value(base, lo, hi, names)
+            seq = list(range(v, hi + 1)) if len(parts) == 2 else [v]
+        if special:
+            if special[0] == "L":
+                last = True
+            elif special[0] == "lastdow":
+                lastdow.add(special[1])
+            else:
+                nth.add((special[1], special[2]))
+            continue
+        for v in seq[::step]:
+            values.add(v % 7 if kind == "dow" else v)
+    return values, last, nth, lastdow
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        _bad("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORTCUTS.get(expr.lower())
+        if expr is None:
+            _bad("unknown shortcut")
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        _bad("need five fields")
+    kinds = ["minute", "hour", "dom", "month", "dow"]
+    parsed = [_parse_field(f, k) for f, k in zip(fields, kinds)]
+    dom_free = fields[2] in ("*", "?")
+    dow_free = fields[4] in ("*", "?")
+    return {
+        "minute": parsed[0][0], "hour": parsed[1][0], "dom": parsed[2],
+        "month": parsed[3][0], "dow": parsed[4],
+        "dom_free": dom_free, "dow_free": dow_free,
+    }
+
+
+def _day_ok(s, d):
+    if s["dom_free"] and s["dow_free"]:
+        return True
+    vals, last, _, _ = s["dom"]
+    mlen = calendar.monthrange(d.year, d.month)[1]
+    dom_ok = d.day in vals or (last and d.day == mlen)
+    dvals, _, nth, lastdow = s["dow"]
+    wd = (d.weekday() + 1) % 7
+    dow_ok = (wd in dvals or (wd, (d.day - 1) // 7 + 1) in nth
+              or (wd in lastdow and d.day + 7 > mlen))
+    if s["dom_free"]:
+        return dow_ok
+    if s["dow_free"]:
+        return dom_ok
+    return dom_ok or dow_ok
 
 
