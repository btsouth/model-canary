 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from bisect import bisect_left
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        values, special = set(), []
+        unrestricted = field in ('*', '?')
+        if field == '?':
+            if index not in (2, 4):
+                raise ValueError('invalid question mark')
+            field = '*'
+
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if token.upper() in names:
+                value = names[token.upper()]
+            elif re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            else:
+                raise ValueError('invalid value')
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])(?:L|#([1-5]))', item) if index == 4 else None
+            if match:
+                special.append(('weekday', int(match[1]) % 7, int(match[2]) if match[2] else None))
+                continue
+            parts = item.split('/')
+            if len(parts) > 2 or not parts[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(parts) == 2:
+                if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) == 0:
+                    raise ValueError('invalid step')
+                step = int(parts[1])
+            base = parts[0]
+            if base == '*':
+                sequence = list(range(low, high + 1))
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, ends)
+                if index == 4:
+                    if end == 7 and start < 7:
+                        sequence = list(range(start, 8))
+                    else:
+                        start %= 7
+                        end %= 7
+                        sequence = list(range(start, end + 1)) if start <= end else list(range(start, 7)) + list(range(end + 1))
+                else:
+                    sequence = list(range(start, end + 1)) if start <= end else list(range(start, high + 1)) + list(range(low, end + 1))
+            else:
+                start = number(base)
+                sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+            values.update((v % 7 if index == 4 else v) for v in sequence[::step])
+        parsed.append((values, special, unrestricted))
+    return parsed
+
+
+def _day_matches(schedule, date):
+    dom, dow = schedule[2], schedule[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dom_match = date.day in dom[0] or bool(dom[1]) and date.day == last
+    dow_match = weekday in dow[0] or any(
+        weekday == day and (date.day + 7 > last if occurrence is None else (date.day - 1) // 7 + 1 == occurrence)
+        for _, day, occurrence in dow[1]
+    )
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
