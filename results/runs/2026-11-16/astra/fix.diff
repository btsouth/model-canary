 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_RANGES = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"invalid number: {token!r}")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _RANGES[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    unrestricted = index in (2, 4) and text in ("*", "?")
+    if text == "?" and index in (2, 4):
+        text = "*"
+    values, specials = set(), []
+
+    def value(token):
+        result = names[token] if token in names else _number(token)
+        if not low <= result <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return result
+
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if index == 4 and special:
+            weekday = value(special[1]) % 7
+            if special[2] == "L":
+                specials.append(("last_weekday", weekday))
+            else:
+                occurrence = _number(special[3])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence must be 1 to 5")
+                specials.append(("nth_weekday", weekday, occurrence))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = pieces[0]
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError("invalid range")
+            start, end = map(value, ends)
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError("descending range")
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or bool(dom[1]) and day.day == last_day
+    dow_match = weekday in dow[0]
+    for special in dow[1]:
+        if weekday == special[1]:
+            if special[0] == "last_weekday":
+                dow_match |= day.day + 7 > last_day
+            else:
+                dow_match |= (day.day - 1) // 7 + 1 == special[2]
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    fields = _parse(expr)
