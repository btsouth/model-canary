index 8965296..3d28799 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,293 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import datetime
+import re
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+_RANGES = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_QUESTION_FIELDS = (2, 4)
+
+_MONTH_NAMES = {
+    name: index
+    for index, name in enumerate(
+        ("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
+        start=1,
+    )
+}
+_DOW_NAMES = {
+    name: index
+    for index, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))
+}
+_NAMES = {3: _MONTH_NAMES, 4: _DOW_NAMES}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_DAYS = datetime.timedelta(days=3650)
+
+
+class _Schedule:
+    __slots__ = (
+        "minutes",
+        "hours",
+        "months",
+        "dom_values",
+        "dom_last",
+        "dow_values",
+        "dow_last",
+        "dow_nth",
+        "dom_restricted",
+        "dow_restricted",
+    )
+
+    def __init__(self, minutes, hours, months, dom_values, dom_last,
+                 dow_values, dow_last, dow_nth, dom_restricted, dow_restricted):
+        self.minutes = minutes
+        self.hours = hours
+        self.months = months
+        self.dom_values = dom_values
+        self.dom_last = dom_last
+        self.dow_values = dow_values
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+        self.dom_restricted = dom_restricted
+        self.dow_restricted = dow_restricted
+
+
+def _parse_value(token, index, in_step):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    else:
+        names = _NAMES.get(index)
+        if names is None or in_step:
+            raise ValueError(f"bad value: {token!r}")
+        try:
+            value = names[token.upper()]
+        except KeyError:
+            raise ValueError(f"bad value: {token!r}") from None
+    low, high = _RANGES[index]
+    if value < low or value > high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _parse_item(index, item):
+    if not item:
+        raise ValueError("empty item")
+
+    low, high = _RANGES[index]
+    has_step = False
+    step = 1
+    if "/" in item:
+        pieces = item.split("/")
+        if len(pieces) != 2:
+            raise ValueError(f"bad step: {item!r}")
+        base, step_text = pieces
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+        has_step = True
+    else:
+        base = item
+
+    if not base:
+        raise ValueError(f"empty item: {item!r}")
+
+    if not has_step:
+        if index == 2 and base == "L":
+            return ("L", None)
+        if index == 4:
+            match = _LAST_DOW.fullmatch(base)
+            if match:
+                day = int(match.group(1))
+                if day > 7:
+                    raise ValueError(f"bad weekday: {item!r}")
+                return ("NL", day % 7)
+            match = _NTH_DOW.fullmatch(base)
+            if match:
+                day = int(match.group(1))
+                occurrence = int(match.group(2))
+                if day > 7 or occurrence < 1 or occurrence > 5:
+                    raise ValueError(f"bad weekday: {item!r}")
+                return ("N#K", (day % 7, occurrence))
+    else:
+        # L, NL and N#K cannot take a step.
+        if index == 2 and base == "L":
+            raise ValueError(f"bad step: {item!r}")
+        if index == 4 and (_LAST_DOW.fullmatch(base) or _NTH_DOW.fullmatch(base)):
+            raise ValueError(f"bad step: {item!r}")
+
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        pieces = base.split("-")
+        if len(pieces) != 2:
+            raise ValueError(f"bad range: {item!r}")
+        start = _parse_value(pieces[0], index, has_step)
+        end = _parse_value(pieces[1], index, has_step)
+        if start > end:
+            raise ValueError(f"bad range: {item!r}")
+        values = list(range(start, end + 1))
+    else:
+        value = _parse_value(base, index, has_step)
+        values = list(range(value, high + 1)) if has_step else [value]
+
+    if has_step:
+        values = values[::step]
+    return ("values", values)
+
+
+def _parse_field(index, text):
+    low, high = _RANGES[index]
+    if text == "?":
+        if index not in _QUESTION_FIELDS:
+            raise ValueError("'?' is only allowed in day fields")
+        values = set(range(low, high + 1))
+        if index == 4:
+            values = {0 if value == 7 else value for value in values}
+        return values, False, set(), set()
+    if not text:
+        raise ValueError("empty field")
+
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in text.split(","):
+        kind, payload = _parse_item(index, item)
+        if kind == "values":
+            for value in payload:
+                values.add(0 if index == 4 and value == 7 else value)
+        elif kind == "L":
+            last_day = True
+        elif kind == "NL":
+            last_weekdays.add(payload)
+        else:
+            nth_weekdays.add(payload)
+    return values, last_day, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    text = expr.strip()
+    folded = text.lower()
+    if folded in _SHORTCUTS:
+        text = _SHORTCUTS[folded]
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"wrong number of fields: {expr!r}")
+
+    minutes, _, _, _ = _parse_field(0, parts[0])
+    hours, _, _, _ = _parse_field(1, parts[1])
+    dom_values, dom_last, _, _ = _parse_field(2, parts[2])
+    months, _, _, _ = _parse_field(3, parts[3])
+    dow_values, _, dow_last, dow_nth = _parse_field(4, parts[4])
+
+    return _Schedule(
+        minutes,
+        hours,
+        months,
+        dom_values,
+        dom_last,
+        dow_values,
+        dow_last,
+        dow_nth,
+        parts[2] not in ("*", "?"),
+        parts[4] not in ("*", "?"),
+    )
+
+
+def _last_day(day):
+    if day.month == 12:
+        return 31
+    return (datetime.date(day.year, day.month + 1, 1)
+            - datetime.timedelta(days=1)).day
+
+
+def _dom_matches(schedule, day, last):
+    return day.day in schedule.dom_values or (schedule.dom_last and day.day == last)
+
+
+def _dow_matches(schedule, day, last):
+    weekday = (day.weekday() + 1) % 7
+    if weekday in schedule.dow_values:
+        return True
+    if weekday in schedule.dow_last and day.day + 7 > last:
+        return True
+    for weekday_number, occurrence in schedule.dow_nth:
+        if (weekday == weekday_number
+                and (day.day - 1) // 7 + 1 == occurrence):
+            return True
+    return False
+
+
+def _day_allowed(schedule, day):
+    if not schedule.dom_restricted and not schedule.dow_restricted:
+        return True
+
+    last = _last_day(day)
+    dom_ok = schedule.dom_restricted and _dom_matches(schedule, day, last)
+    dow_ok = schedule.dow_restricted and _dow_matches(schedule, day, last)
+
+    if schedule.dom_restricted and schedule.dow_restricted:
+        return dom_ok or dow_ok
+    if schedule.dom_restricted:
+        return dom_ok
+    return dow_ok
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse(expr)
