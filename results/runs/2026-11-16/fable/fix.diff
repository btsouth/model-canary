+        if day.month in sched.months and sched.day_ok(day):
+            found = None
+            for hour in sched.hours:
+                if first and hour < start.hour:
+                    continue
+                for minute in sched.minutes:
+                    if first and hour == start.hour and minute < start.minute:
+                        continue
+                    found = _dt.datetime.combine(day, _dt.time(hour, minute))
+                    break
+                if found is not None:
+                    break
+            if found is not None:
+                return found if found <= limit else None
+        day += _dt.timedelta(days=1)
+        first = False
+    return None
