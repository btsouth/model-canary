 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (name, low, high, names)
+_FIELDS = [
+    ("minute", 0, 59, None),
+    ("hour", 0, 23, None),
+    ("day of month", 1, 31, None),
+    ("month", 1, 12, {n: i + 1 for i, n in enumerate(_MONTHS)}),
+    ("day of week", 0, 7, {n: i for i, n in enumerate(_DAYS)}),
+]
+
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+def _number(text, expr):
+    if not text or not text.isascii() or not text.isdigit():
+        raise ValueError(f"bad number {text!r} in {expr!r}")
+    return int(text)
+
+
+def _value(text, low, high, names, expr):
+    """A single field value, by number or (where allowed) by name."""
+    if names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        value = _number(text, expr)
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range in {expr!r}")
+    return value
+
+
+def _item(item, low, high, names, expr):
+    """The list of numbers an ordinary item (no L / # forms) stands for."""
+    if not item:
+        raise ValueError(f"empty item in {expr!r}")
+    step = 1
+    if "/" in item:
+        base, _, step_text = item.partition("/")
+        step = _number(step_text, expr)
+        if step < 1:
+            raise ValueError(f"step of 0 in {expr!r}")
+        if not base:
+            raise ValueError(f"empty item in {expr!r}")
+        names = None  # names are not allowed in a step item
+    else:
+        base = item
+    if base == "*":
+        values = range(low, high + 1)
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        start = _value(a, low, high, names, expr)
+        end = _value(b, low, high, names, expr)
+        if start > end:
+            raise ValueError(f"range {base!r} runs backwards in {expr!r}")
+        values = range(start, end + 1)
+    elif step != 1:
+        values = range(_value(base, low, high, names, expr), high + 1)
+    else:
+        values = [_value(base, low, high, names, expr)]
+    return list(values)[::step]
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last",
+                 "dow", "dow_last", "dow_nth", "dom_any", "dow_any")
+
+    def __init__(self, expr):
+        text = expr.strip()
+        if text.lower() in _SHORTCUTS:
+            text = _SHORTCUTS[text.lower()]
+        elif text.startswith("@"):
+            raise ValueError(f"unknown shortcut {expr!r}")
+        parts = text.split()
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields in {expr!r}")
+
+        self.minutes = sorted(set(_parse_plain(parts[0], 0, expr)))
+        self.hours = sorted(set(_parse_plain(parts[1], 1, expr)))
+        self.months = set(_parse_plain(parts[3], 3, expr))
+
+        # Day of month.
+        self.dom, self.dom_last = set(), False
+        self.dom_any = parts[2] in ("*", "?")
+        if not self.dom_any:
+            for item in parts[2].split(","):
+                if item.upper() == "L":
+                    self.dom_last = True
+                else:
+                    self.dom.update(_item(item, 1, 31, None, expr))
+
+        # Day of week.
+        self.dow, self.dow_last, self.dow_nth = set(), set(), set()
+        self.dow_any = parts[4] in ("*", "?")
+        if not self.dow_any:
+            for item in parts[4].split(","):
+                if item.upper().endswith("L"):
+                    _ok7(item[:-1], expr)
+                    self.dow_last.add(_number(item[:-1], expr) % 7)
+                elif "#" in item:
+                    n, _, k = item.partition("#")
+                    _ok7(n, expr)
+                    k = _number(k, expr)
+                    if not 1 <= k <= 5:
+                        raise ValueError(f"bad #K in {expr!r}")
+                    self.dow_nth.add((_number(n, expr) % 7, k))
+                else:
+                    self.dow.update(v % 7 for v in _item(item, 0, 7, _FIELDS[4][3], expr))
+
+    def day_ok(self, day):
+        """Whether the schedule may run on the given date."""
+        if self.dom_any and self.dow_any:
+            return True
+        last = calendar.monthrange(day.year, day.month)[1]
+        dom_ok = day.day in self.dom or (self.dom_last and day.day == last)
+        wd = (day.weekday() + 1) % 7
+        dow_ok = (wd in self.dow
+                  or (wd in self.dow_last and day.day + 7 > last)
+                  or (wd, (day.day - 1) // 7 + 1) in self.dow_nth)
+        if self.dom_any:
+            return dow_ok
+        if self.dow_any:
+            return dom_ok
+        return dom_ok or dow_ok
+
+
+def _ok7(text, expr):
+    """Validate N in NL / N#K: a plain number from 0 to 7."""
+    if not 0 <= _number(text, expr) <= 7:
+        raise ValueError(f"day of week {text!r} out of range in {expr!r}")
+    return True
+
+
+def _parse_plain(field, index, expr):
+    name, low, high, names = _FIELDS[index]
+    values = []
+    for item in field.split(","):
+        values.extend(_item(item, low, high, names, expr))
+    return values
+
 
