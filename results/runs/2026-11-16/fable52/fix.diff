 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (low, high, names)
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DAY = re.compile(r"([0-9]+)L")
+_NTH_DAY = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            text = _SHORTCUTS[text.lower()]
+        fields = re.split(r"[ \t]+", text)
+        if len(fields) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        self.last_dom = False      # 'L' in day of month
+        self.last_dow = set()      # 'NL' in day of week
+        self.nth_dow = set()       # (N, K) from 'N#K' in day of week
+        sets = [self._field(i, f) for i, f in enumerate(fields)]
+        self.minutes, self.hours, self.doms, self.months, self.dows = sets
+        self.minute_list = sorted(self.minutes)
+        self.hour_list = sorted(self.hours)
+        self.dom_free = fields[_DOM] in ("*", "?")
+        self.dow_free = fields[_DOW] in ("*", "?")
+
+    def _field(self, index, field):
+        if field == "?" and index in (_DOM, _DOW):
+            field = "*"
+        values = set()
+        for item in field.split(","):
+            values.update(self._item(index, item))
+        return values
+
+    def _value(self, index, text):
+        low, high, names = _FIELDS[index]
+        if _NUMBER.fullmatch(text):
+            value = int(text)
+        elif names is not None and text.upper() in names:
+            value = names[text.upper()]
+        else:
+            raise ValueError(f"bad value: {text!r}")
+        if not low <= value <= high:
+            raise ValueError(f"value out of range: {text!r}")
+        return value
+
+    def _item(self, index, item):
+        low, high, _ = _FIELDS[index]
+        if index == _DOM and item == "L":
+            self.last_dom = True
+            return ()
+        if index == _DOW:
+            found = _LAST_DAY.fullmatch(item)
+            if found:
+                day = int(found.group(1))
+                if day > 7:
+                    raise ValueError(f"bad day of week: {item!r}")
+                self.last_dow.add(day % 7)
+                return ()
+            found = _NTH_DAY.fullmatch(item)
+            if found:
+                day, nth = int(found.group(1)), int(found.group(2))
+                if day > 7 or not 1 <= nth <= 5:
+                    raise ValueError(f"bad day of week: {item!r}")
+                self.nth_dow.add((day % 7, nth))
+                return ()
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+        if base == "*":
+            first, last = low, (6 if index == _DOW else high)
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            first, last = self._value(index, a), self._value(index, b)
+            if first > last:
+                raise ValueError(f"backwards range: {item!r}")
+        else:
+            first = self._value(index, base)
+            last = high if slash else first
+        values = range(first, last + 1, step)
+        if index == _DOW:
+            return [v % 7 for v in values]
+        return values
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        if self.dom_free and self.dow_free:
+            return True
+        if not self.dom_free and self._dom_matches(date):
+            return True
+        if not self.dow_free and self._dow_matches(date):
+            return True
+        return False
+
+    def _dom_matches(self, date):
+        if date.day in self.doms:
+            return True
+        return self.last_dom and date.day == calendar.monthrange(date.year, date.month)[1]
+
+    def _dow_matches(self, date):
+        dow = (date.weekday() + 1) % 7
+        if dow in self.dows:
+            return True
+        if (dow, (date.day - 1) // 7 + 1) in self.nth_dow:
+            return True
+        if dow in self.last_dow:
+            return date.day + 7 > calendar.monthrange(date.year, date.month)[1]
+        return False
+
+    def first_time(self, hour=0, minute=0):
+        """The first (hour, minute) of a day at or after the given time, or None."""
+        for h in self.hour_list:
+            if h < hour:
+                continue
+            for m in self.minute_list:
+                if h > hour or m >= minute:
+                    return h, m
+        return None
 
 
