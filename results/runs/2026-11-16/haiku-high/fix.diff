 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date, datetime, time, timedelta
+
+_LOOKAHEAD = timedelta(days=10 * 365)
+_ONE_DAY = timedelta(days=1)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_WEEKDAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_SPACES = re.compile(r"[ \t]+")
+_PART = "day of month"
+_DOW = "day of week"
+
+# (field name, smallest value, largest value, names allowed in the field)
+_FIELDS = (
+    ("minute", 0, 59, None),
+    ("hour", 0, 23, None),
+    (_PART, 1, 31, None),
+    ("month", 1, 12, _MONTHS),
+    (_DOW, 0, 7, _WEEKDAYS),
+)
+
+
+@dataclass(frozen=True)
+class _Schedule:
+    minutes: frozenset
+    hours: frozenset
+    months: frozenset
+    days: frozenset        # day-of-month numbers
+    last_day: bool         # L in the day-of-month field
+    weekdays: frozenset    # day-of-week numbers, 0 = Sunday
+    last_weekdays: frozenset   # NL: the last weekday N of the month
+    nth_weekdays: frozenset    # N#K: (weekday, K)
+    days_restricted: bool
+    weekdays_restricted: bool
+
+
+def _value(text, name, lo, hi, names):
+    """A plain number, or a three-letter name where names are allowed, within range."""
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad {name} value {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"{name} value {value} is outside {lo}-{hi}")
+    return value
+
+
+def _item(item, name, lo, hi, names):
+    """Parse one comma-separated item.
+
+    Returns ("values", [numbers]), ("last", None), ("last_weekday", N) or ("nth", (N, K)).
+    """
+    if item == "":
+        raise ValueError(f"empty item in {name} field")
+    is_day = name == _PART
+    is_dow = name == _DOW
+    if is_day and item == "L":
+        return "last", None
+    if is_dow and "#" in item:
+        n_text, _, k_text = item.partition("#")
+        if not (_NUMBER.fullmatch(n_text) and _NUMBER.fullmatch(k_text)):
+            raise ValueError(f"bad nth weekday {item!r}")
+        return "nth", (_value(n_text, name, lo, hi, None), _value(k_text, "occurrence", 1, 5, None))
+    if is_dow and item.endswith("L") and len(item) > 1:
+        return "last_weekday", _value(item[:-1], name, lo, hi, None)
+
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    if base == "*":
+        start, stop = lo, hi
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        start = _value(a, name, lo, hi, names)
+        stop = _value(b, name, lo, hi, names)
+        if start > stop:
+            raise ValueError(f"range {item!r} starts after it ends")
+    else:
+        start = _value(base, name, lo, hi, names)
+        stop = hi if slash else start
+    return "values", list(range(start, stop + 1))[::step]
+
+
+def _field(text, spec):
+    """Parse one field. Returns (values, last, last_weekdays, nth_weekdays)."""
+    name, lo, hi, names = spec
+    is_dow = name == _DOW
+    if (name == _PART or is_dow) and text == "?":
+        text = "*"
+    values, last, last_weekdays, nth_weekdays = set(), False, set(), set()
+    for item in text.split(","):
+        kind, data = _item(item, name, lo, hi, names)
+        if kind == "values":
+            values.update(v % 7 if is_dow else v for v in data)
+        elif kind == "last":
+            last = True
+        elif kind == "last_weekday":
+            last_weekdays.add(data % 7)
+        else:
+            nth_weekdays.add((data[0] % 7, data[1]))
+    return values, last, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    """Check the whole expression and return a _Schedule. Raises ValueError if it is bad."""
+    text = expr.strip()
+    if text.startswith("@"):
+        if not text.isascii() or text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown schedule shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    fields = _SPACES.split(text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields)}: {expr!r}")
+    minutes, hours, days, months, weekdays = (
+        _field(text_part, spec) for text_part, spec in zip(fields, _FIELDS))
+    return _Schedule(
+        minutes=frozenset(minutes[0]),
+        hours=frozenset(hours[0]),
+        months=frozenset(months[0]),
+        days=frozenset(days[0]),
+        last_day=days[1],
+        weekdays=frozenset(weekdays[0]),
+        last_weekdays=frozenset(weekdays[2]),
+        nth_weekdays=frozenset(weekdays[3]),
+        days_restricted=fields[2] not in ("*", "?"),
+        weekdays_restricted=fields[4] not in ("*", "?"),
+    )
+
+
+def _day_allowed(spec, day):
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    day_of_month_hit = day.day in spec.days or (spec.last_day and day.day == days_in_month)
+    weekday = (day.weekday() + 1) % 7  # cron: Sunday is 0
+    nth = (day.day - 1) // 7 + 1
+    weekday_hit = (
+        weekday in spec.weekdays
+        or (weekday in spec.last_weekdays and day.day + 7 > days_in_month)
+        or (weekday, nth) in spec.nth_weekdays
+    )
+    if spec.days_restricted and spec.weekdays_restricted:
+        return day_of_month_hit or weekday_hit
+    if spec.days_restricted:
+        return day_of_month_hit
+    if spec.weekdays_restricted:
+        return weekday_hit
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return (
+        when.minute in spec.minutes
+        and when.hour in spec.hours
+        and when.month in spec.months
+        and _day_allowed(spec, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _LOOKAHEAD
+    except OverflowError:
+        limit = datetime.max
+    times = sorted(h * 60 + m for h in spec.hours for m in spec.minutes)
+    first_minute = start.hour * 60 + start.minute
+    day, last = start.date(), limit.date()
+    while day <= last:
+        if day.month in spec.months and _day_allowed(spec, day):
+            floor = first_minute if day == start.date() else 0
+            for minute_of_day in times:
+                if minute_of_day >= floor:
+                    run = datetime.combine(day, time(minute_of_day // 60, minute_of_day % 60))
+                    return run if run <= limit else None
+        if day == date.max:
+            break
+        day += _ONE_DAY
+    return None
