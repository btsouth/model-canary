--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,193 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i for i, n in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {n: i for i, n in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+_SPLIT = re.compile(r"[ \t]+")
+
+
+class _Spec:
+    """A parsed expression. Day-of-month and day-of-week are kept as separate parts."""
+
+    def __init__(self, minutes, hours, months, dom, dom_last, dom_restricted,
+                 dow, dow_nth, dow_last, dow_restricted):
+        self.minutes = minutes          # sorted list
+        self.hours = hours              # sorted list
+        self.months = months            # set
+        self.dom = dom                  # set of day numbers
+        self.dom_last = dom_last        # True if L is listed
+        self.dom_restricted = dom_restricted
+        self.dow = dow                  # set of cron weekdays 0-6 (0 = Sunday)
+        self.dow_nth = dow_nth          # set of (weekday, K): K-th occurrence
+        self.dow_last = dow_last        # set of weekdays: last occurrence in month
+        self.dow_restricted = dow_restricted
+
+
+def _value(token, lo, hi, names):
+    """Read one number or (if names are allowed) one three-letter name."""
+    if names is not None and _NAME.fullmatch(token):
+        key = token.upper()
+        if key not in names:
+            raise ValueError(f"unknown name {token!r}")
+        value = names[key]
+    elif _DIGITS.fullmatch(token):
+        value = int(token)
+    else:
+        raise ValueError(f"bad value {token!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {value} outside {lo}-{hi}")
+    return value
+
+
+def _expand(item, lo, hi, names):
+    """Expand one comma-separated item (no L, NL or N#K) into its list of values."""
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    if base == "*":
+        start, end = lo, hi
+    elif base.count("-") == 1:
+        left, right = base.split("-")
+        start = _value(left, lo, hi, names)
+        end = _value(right, lo, hi, names)
+        if start > end:
+            raise ValueError(f"range start after end in {item!r}")
+    else:
+        start = _value(base, lo, hi, names)
+        end = hi if step is not None else start
+    values = list(range(start, end + 1))
+    return values if step is None else values[::step]
+
+
+def _parse_plain(text, lo, hi, names):
+    values = set()
+    for item in text.split(","):
+        values.update(_expand(item, lo, hi, names))
+    return values
+
+
+def _parse_dom(text):
+    if text == "?":
+        text = "*"
+    values, last = set(), False
+    for item in text.split(","):
+        if item == "L":
+            last = True
+        else:
+            values.update(_expand(item, 1, 31, None))
+    return values, last
+
+
+def _parse_dow(text):
+    if text == "?":
+        text = "*"
+    days, nth, last = set(), set(), set()
+    for item in text.split(","):
+        m = _LAST_WEEKDAY.fullmatch(item)
+        if m:
+            last.add(_value(m.group(1), 0, 7, None) % 7)
+            continue
+        m = _NTH_WEEKDAY.fullmatch(item)
+        if m:
+            nth.add((_value(m.group(1), 0, 7, None) % 7, _value(m.group(2), 1, 5, None)))
+            continue
+        days.update(v % 7 for v in _expand(item, 0, 7, _DAYS))
+    return days, nth, last
+
+
+def _parse(expr):
+    """Check and parse a whole expression. Raises ValueError if it is bad."""
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = _SPLIT.split(text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    minute_t, hour_t, dom_t, month_t, dow_t = parts
+    minutes = sorted(_parse_plain(minute_t, 0, 59, None))
+    hours = sorted(_parse_plain(hour_t, 0, 23, None))
+    months = _parse_plain(month_t, 1, 12, _MONTHS)
+    dom, dom_last = _parse_dom(dom_t)
+    dow, dow_nth, dow_last = _parse_dow(dow_t)
+    return _Spec(
+        minutes, hours, months, dom, dom_last, dom_t not in ("*", "?"),
+        dow, dow_nth, dow_last, dow_t not in ("*", "?"),
+    )
+
+
+def _day_ok(spec, day):
+    """True if a schedule with spec may run on the date day."""
+    month_days = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in spec.dom or (spec.dom_last and day.day == month_days)
+    weekday = (day.weekday() + 1) % 7
+    occurrence = (day.day - 1) // 7 + 1
+    dow_match = (
+        weekday in spec.dow
+        or (weekday, occurrence) in spec.dow_nth
+        or (weekday in spec.dow_last and day.day + 7 > month_days)
+    )
+    if spec.dom_restricted and spec.dow_restricted:
+        return dom_match or dow_match
+    return dom_match and dow_match
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return (
+        when.minute in spec.minutes
+        and when.hour in spec.hours
+        and when.month in spec.months
+        and _day_ok(spec, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + timedelta(days=3650)
+    except OverflowError:
+        limit = datetime.max
+    last_day = limit.date()
+    day_count = (last_day - start.date()).days + 1
+    for n in range(day_count):
+        day = start.date() + timedelta(days=n)
+        if day.month not in spec.months or not _day_ok(spec, day):
+            continue
+        for hour in spec.hours:
+            for minute in spec.minutes:
+                candidate = datetime.combine(day, time(hour, minute))
+                if candidate < start:
+                    continue
+                if candidate > limit:
+                    return None
+                return candidate
+    return None
