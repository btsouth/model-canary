 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"))}
+
+
+def _parse_field(raw, minimum, maximum, kind):
+    """Return field values and any calendar-specific day rules."""
+    if kind in ("dom", "dow") and raw == "?":
+        raw = "*"
+    unrestricted = raw == "*"
+    values = set()
+    last = False
+    last_weekdays = set()
+    nth_weekdays = set()
+
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty cron field item")
+        if kind == "dom" and item == "L":
+            last = True
+            continue
+        if kind == "dow":
+            match = re.fullmatch(r"(\d+)L", item)
+            if match:
+                n = int(match.group(1))
+                if not 0 <= n <= 7:
+                    raise ValueError("day of week out of range")
+                last_weekdays.add(n % 7)
+                continue
+            match = re.fullmatch(r"(\d+)#(\d+)", item)
+            if match:
+                n, occurrence = map(int, match.groups())
+                if not 0 <= n <= 7 or not 1 <= occurrence <= 5:
+                    raise ValueError("invalid nth weekday")
+                nth_weekdays.add((n % 7, occurrence))
+                continue
+
+        if "/" in item:
+            if item.count("/") != 1:
+                raise ValueError("invalid step")
+            base, step_text = item.split("/")
+            if not re.fullmatch(r"\d+", step_text) or int(step_text) < 1:
+                raise ValueError("invalid step")
+            step = int(step_text)
+        else:
+            base, step = item, 1
+
+        if base == "*":
+            start, end = minimum, maximum
+        elif "-" in base and base.count("-") == 1:
+            left, right = base.split("-")
+            def atom(value):
+                if re.fullmatch(r"\d+", value):
+                    return int(value)
+                if kind == "month" and value.upper() in _MONTHS:
+                    return _MONTHS[value.upper()]
+                if kind == "dow" and value.upper() in _DAYS:
+                    return _DAYS[value.upper()]
+                raise ValueError("invalid range endpoint")
+            start, end = atom(left), atom(right)
+            if "/" in item and (not re.fullmatch(r"\d+", left) or not re.fullmatch(r"\d+", right)):
+                raise ValueError("names cannot have steps")
+            if start > end:
+                raise ValueError("descending range")
+        elif kind == "month" and base.upper() in _MONTHS:
+            if "/" in item:
+                raise ValueError("names cannot have steps")
+            start = end = _MONTHS[base.upper()]
+        elif kind == "dow" and base.upper() in _DAYS:
+            if "/" in item:
+                raise ValueError("names cannot have steps")
+            start = end = _DAYS[base.upper()]
+        elif re.fullmatch(r"\d+", base):
+            start = int(base)
+            end = maximum if "/" in item else start
+        else:
+            raise ValueError("invalid cron item")
+        if start < minimum or end > maximum:
+            raise ValueError("cron value out of range")
+        sequence = range(start, end + 1, step)
+        values.update((value % 7 if kind == "dow" else value) for value in sequence)
+
+    return values, unrestricted, last, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        try:
+            stripped = _SHORTCUTS[stripped.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    minute = _parse_field(fields[0], 0, 59, "minute")[0]
+    hour = _parse_field(fields[1], 0, 23, "hour")[0]
+    dom, dom_free, dom_last, _, _ = _parse_field(fields[2], 1, 31, "dom")
+    month = _parse_field(fields[3], 1, 12, "month")[0]
+    dow, dow_free, _, dow_last, dow_nth = _parse_field(fields[4], 0, 7, "dow")
+    times = sorted(h * 60 + m for h in hour for m in minute)
+    return minute, hour, dom, dom_last, month, dow, dow_last, dow_nth, dom_free, dow_free, times
+
+
+def _day_matches(parsed, date):
+    _, _, dom, dom_last, _, dow, dow_last, dow_nth, dom_free, dow_free, _ = parsed
+    last_day = calendar.monthrange(date.year, date.month)[1]
+    dom_match = date.day in dom or (dom_last and date.day == last_day)
+    weekday = (date.weekday() + 1) % 7
+    dow_match = weekday in dow
+    if weekday in dow_last and date.day + 7 > last_day:
+        dow_match = True
+    if (weekday, (date.day - 1) // 7 + 1) in dow_nth:
+        dow_match = True
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_match
+    if dow_free:
+        return dom_match
+    return dom_match or dow_match
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
