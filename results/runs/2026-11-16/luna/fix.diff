 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
+
+_SHORT = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *", "@hourly": "0 * * * *",
+}
+_MONTH = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+_RANGES = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    expr = _SHORT.get(expr.strip().lower(), expr.strip())
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    parsed = []
+    for idx, field in enumerate(fields):
+        lo, hi = _RANGES[idx]
+        unrestricted = field in ("*", "?")
+        if field == "?" and idx not in (2, 4):
+            raise ValueError("? only allowed in day fields")
+        values, specials = set(), set()
+        if idx == 2 and field == "L":
+            specials.add(("lastday",))
+        elif idx == 4:
+            for item in field.split(","):
+                m = re.fullmatch(r"(\d+)L", item, re.I)
+                h = re.fullmatch(r"(\d+)#([1-5])", item, re.I)
+                if m or h:
+                    n = int((m or h).group(1))
+                    if not 0 <= n <= 7: raise ValueError("day out of range")
+                    specials.add(("lastweekday", n % 7) if m else ("nthweekday", n % 7, int(h.group(2))))
+                    continue
+                values.update(_item(item, lo, hi, idx))
+        else:
+            for item in field.split(","):
+                values.update(_item(item, lo, hi, idx))
+        if idx == 4 and 7 in values:
+            values.remove(7); values.add(0)
+        if not values and not specials and not unrestricted: raise ValueError("empty field")
+        parsed.append((values, specials, unrestricted))
+    return parsed
+
+
+def _item(item, lo, hi, idx):
+    if not item: raise ValueError("empty item")
+    bits = item.split("/")
+    if len(bits) > 2: raise ValueError("bad step")
+    step = 1
+    if len(bits) == 2:
+        if not bits[1].isdigit() or int(bits[1]) < 1: raise ValueError("bad step")
+        step = int(bits[1])
+    base = bits[0]
+    names = _MONTH if idx == 3 else _DAYS if idx == 4 else {}
+    if base == "*": start, end = lo, hi
+    elif re.fullmatch(r"\d+", base):
+        start = end = int(base)
+        if len(bits) == 2: end = hi
+    elif "-" in base:
+        a, b = base.split("-", 1)
+        start, end = _value(a, names), _value(b, names)
+    else:
+        if len(bits) == 2: raise ValueError("step must be numeric")
+        start = end = _value(base, names)
+    if not lo <= start <= hi or not lo <= end <= hi or start > end: raise ValueError("value out of range")
+    return range(start, end + 1, step)
+
+
+def _value(x, names):
+    if x.upper() in names: return names[x.upper()]
+    if x.isdigit(): return int(x)
+    raise ValueError("invalid value")
+
+
+def _allowed(p, when, check_time=True):
+    minute, hour, dom, month, dow = p
+    if (check_time and (when.minute not in minute[0] or when.hour not in hour[0])) or when.month not in month[0]: return False
+    mdays = calendar.monthrange(when.year, when.month)[1]
+    dom_match = when.day in dom[0] or ("lastday",) in dom[1]
+    wd = (when.weekday() + 1) % 7
+    dow_match = wd in dow[0]
+    for s in dow[1]:
+        if s[0] == "lastweekday" and wd == s[1] and when.day + 7 > mdays: dow_match = True
+        if s[0] == "nthweekday" and wd == s[1] and (when.day - 1) // 7 + 1 == s[2]: dow_match = True
+    dom_free, dow_free = dom[2], dow[2]
+    day_ok = (dom_match or dow_match) if not dom_free and not dow_free else (dow_match if dom_free else dom_match if dow_free else True)
+    return day_ok
 
 
