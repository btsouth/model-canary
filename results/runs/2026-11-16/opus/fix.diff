 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (low, high, names mapping)
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {n: i + 1 for i, n in enumerate(_MONTHS)}),
+    (0, 7, {n: i for i, n in enumerate(_DAYS)}),
+]
+
+_NUM = re.compile(r"[0-9]+\Z")
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+def _bad(expr):
+    return ValueError(f"bad schedule expression: {expr!r}")
+
+
+def _number(text, expr):
+    if not _NUM.match(text):
+        raise _bad(expr)
+    return int(text)
+
+
+def _value(text, index, expr):
+    low, high, names = _FIELDS[index]
+    if names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        value = _number(text, expr)
+    if not low <= value <= high:
+        raise _bad(expr)
+    return value
+
+
+class _Spec:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last",
+                 "dow", "dow_last", "dow_nth", "dom_any", "dow_any")
+
+
+def _parse_field(text, index, expr, spec):
+    """Return the set of plain values; record special day items in spec."""
+    low, high, _ = _FIELDS[index]
+    values = set()
+    for item in text.split(","):
+        if item == "":
+            raise _bad(expr)
+        if index == 2 and item == "L":
+            spec.dom_last = True
+            continue
+        if index == 4:
+            m = re.fullmatch(r"([0-9]+)L", item)
+            if m:
+                n = _number(m.group(1), expr)
+                if n > 7:
+                    raise _bad(expr)
+                spec.dow_last.add(n % 7)
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                n = _number(m.group(1), expr)
+                k = _number(m.group(2), expr)
+                if n > 7 or not 1 <= k <= 5:
+                    raise _bad(expr)
+                spec.dow_nth.add((n % 7, k))
+                continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            step = _number(step_text, expr)
+            if step < 1:
+                raise _bad(expr)
+        else:
+            step = 1
+        if base == "*":
+            listed = range(low, high + 1)
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a = _value(a_text, index, expr)
+            b = _value(b_text, index, expr)
+            if a > b:
+                raise _bad(expr)
+            listed = range(a, b + 1)
+        else:
+            a = _value(base, index, expr)
+            listed = range(a, high + 1) if slash else range(a, a + 1)
+        values.update(listed[::step])
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise _bad(expr)
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise _bad(expr)
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5 or any(p == "" for p in parts):
+        raise _bad(expr)
+    spec = _Spec()
+    spec.dom_last = False
+    spec.dow_last = set()
+    spec.dow_nth = set()
+    for i, part in enumerate(parts):
+        if part == "?":
+            if i not in (2, 4):
+                raise _bad(expr)
+            part = "*"
+        values = _parse_field(part, i, expr, spec)
+        if i == 0:
+            spec.minutes = sorted(values)
+        elif i == 1:
+            spec.hours = sorted(values)
+        elif i == 2:
+            spec.dom = values
+        elif i == 3:
+            spec.months = values
+        else:
+            spec.dow = values
+    spec.dom_any = parts[2] in ("*", "?")
+    spec.dow_any = parts[4] in ("*", "?")
+    return spec
+
+
+def _day_ok(spec, day):
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in spec.dom or (spec.dom_last and day.day == last)
+    wd = (day.weekday() + 1) % 7
+    dow_ok = (wd in spec.dow
+              or (wd in spec.dow_last and day.day + 7 > last)
+              or (wd, (day.day - 1) // 7 + 1) in spec.dow_nth)
+    if spec.dom_any and spec.dow_any:
+        return True
+    if spec.dom_any:
+        return dow_ok
+    if spec.dow_any:
+        return dom_ok
+    return dom_ok or dow_ok
 
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
