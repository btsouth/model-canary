+            found = _first_time(spec, hour, minute)
+            if found is not None:
+                run = candidate_day.replace(hour=found[0], minute=found[1])
+                return run if run <= limit else None
+        hour = minute = 0
+        if day.month not in spec.months:
+            # jump to the first day of the next month
+            if day.month == 12:
+                if day.year == datetime.MAXYEAR:
+                    return None
+                day = datetime.date(day.year + 1, 1, 1)
+            else:
+                day = datetime.date(day.year, day.month + 1, 1)
+            continue
+        try:
+            day += datetime.timedelta(days=1)
+        except OverflowError:
+            return None
