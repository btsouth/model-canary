+
+
+def _first_time(spec, hour, minute):
+    """First (hour, minute) in the schedule at or after hour:minute, or None."""
+    for h in spec.hours:
+        if h < hour:
+            continue
+        for m in spec.minutes:
+            if h > hour or m >= minute:
+                return h, m
+    return None
 
 
