 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(),
+                   range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if re.fullmatch(r"[0-9]+", token) is None:
+        raise ValueError(f"bad number: {token!r}")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+    unrestricted = text in ("*", "?")
+    if text == "?" and index in (2, 4):
+        text = "*"
+
+    def value(token):
+        n = names[token] if token in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return n
+
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if index == 4 and special:
+            weekday = value(special[1]) % 7
+            if special[2] == "L":
+                specials.append(("last_weekday", weekday))
+            else:
+                occurrence = _number(special[3])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence outside 1-5")
+                specials.append(("nth_weekday", weekday, occurrence))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"bad step: {item!r}")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"bad range: {base!r}")
+            start, end = map(value, ends)
+            if start > end:
+                raise ValueError("reversed range")
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        values.update(n % 7 if index == 4 else n
+                      for n in range(start, end + 1, step))
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("a schedule must have five fields")
+    return [_field(part, index) for index, part in enumerate(parts)]
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    month_end = calendar.monthrange(day.year, day.month)[1]
+    dom_matches = day.day in dom[0] or bool(dom[1]) and day.day == month_end
+    dow_matches = weekday in dow[0]
+    for special in dow[1]:
+        if weekday == special[1]:
+            if special[0] == "last_weekday":
+                dow_matches |= day.day + 7 > month_end
+            else:
+                dow_matches |= (day.day - 1) // 7 + 1 == special[2]
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_matches
+    if dow[2]:
+        return dom_matches
+    return dom_matches or dow_matches
+
 
