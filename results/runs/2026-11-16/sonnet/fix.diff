 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names and tok.isalpha() and tok.isascii():
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _parse_field(text, lo, hi, names=None, kind=None):
+    """Return (values, last_dom, last_dows, nths)."""
+    values, last, lasts, nths = set(), False, set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item == "L":
+            last = True
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)L", item)
+            if m:
+                lasts.add(_value(m.group(1), 0, 7, None) % 7)
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError("bad occurrence")
+                nths.add((_value(m.group(1), 0, 7, None) % 7, k))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError("bad step")
+        base = parts[0]
+        step = None
+        if len(parts) == 2:
+            if not _NUM.fullmatch(parts[1]) or int(parts[1]) < 1:
+                raise ValueError("bad step")
+            step = int(parts[1])
+        if base == "*":
+            lst = list(range(lo, hi + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a > b:
+                raise ValueError("descending range")
+            lst = list(range(a, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            lst = list(range(a, hi + 1)) if step else [a]
+        if step:
+            lst = lst[::step]
+        values.update(lst)
+    return values, last, lasts, nths
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError("unknown shortcut")
+    f = re.split(r"[ \t]+", text)
+    if len(f) != 5:
+        raise ValueError("need five fields")
+    for i in (0, 1, 3):
+        if f[i] in ("?",):
+            raise ValueError("? not allowed here")
+    minute = _parse_field(f[0], 0, 59)[0]
+    hour = _parse_field(f[1], 0, 23)[0]
+    dom_text, dow_text = f[2], f[4]
+    dom = _parse_field("*" if dom_text == "?" else dom_text, 1, 31, None, "dom")
+    month = _parse_field(f[3], 1, 12, _MONTHS)[0]
+    dv, _, dl, dn = _parse_field("*" if dow_text == "?" else dow_text, 0, 7, _DAYS, "dow")
+    dow = ({v % 7 for v in dv}, dl, dn)
+    dom_r = dom_text not in ("*", "?")
+    dow_r = dow_text not in ("*", "?")
+    return sorted(minute), sorted(hour), dom, month, dow, dom_r, dow_r
+
+
+def _day_ok(p, d):
+    _, _, dom, months, dow, dom_r, dow_r = p
+    if d.month not in months:
+        return False
+    if not dom_r and not dow_r:
+        return True
+    ndays = calendar.monthrange(d.year, d.month)[1]
+    dom_ok = d.day in dom[0] or (dom[1] and d.day == ndays)
+    wd = (d.weekday() + 1) % 7
+    vals, lasts, nths = dow
+    dow_ok = (wd in vals or (wd in lasts and d.day + 7 > ndays)
+              or (wd, (d.day - 1) // 7 + 1) in nths)
+    if dom_r and dow_r:
+        return dom_ok or dow_ok
+    return dom_ok if dom_r else dow_ok
 
 
