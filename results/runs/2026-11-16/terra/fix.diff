 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    fields = []
+    specials = [set(), set()]
+    bounds = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+    for index, (part, (lo, hi)) in enumerate(zip(parts, bounds)):
+        values = set()
+        if part == '?' and index in (2, 4):
+            part = '*'
+        for item in part.upper().split(','):
+            if index == 2 and item == 'L':
+                specials[0].add(('last',))
+                continue
+            special = re.fullmatch(r'([0-7])(?:L|#([1-5]))', item) if index == 4 else None
+            if special:
+                specials[1].add((int(special.group(1)) % 7, int(special.group(2)) if special.group(2) else None))
+                continue
+            bits = item.split('/')
+            if len(bits) > 2 or not bits[0] or (len(bits) == 2 and not re.fullmatch(r'[0-9]+', bits[1])):
+                raise ValueError('invalid item')
+            step = int(bits[1]) if len(bits) == 2 else 1
+            if step < 1:
+                raise ValueError('invalid step')
+            def number(token):
+                names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+                if token in names:
+                    value = names[token]
+                elif re.fullmatch(r'[0-9]+', token):
+                    value = int(token)
+                else:
+                    raise ValueError('invalid value')
+                if not lo <= value <= hi:
+                    raise ValueError('value out of range')
+                return value
+            base = bits[0]
+            if base == '*':
+                start, end = lo, hi
+            elif '-' in base:
+                pair = base.split('-')
+                if len(pair) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, pair)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = hi if len(bits) == 2 else start
+            values.update(v % 7 if index == 4 else v for v in range(start, end + 1, step))
+        fields.append(values)
+    return fields, specials, parts[2] in ('*', '?'), parts[4] in ('*', '?')
+
+
+def _day_matches(day, spec):
+    fields, specials, dom_free, dow_free = spec
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom = day.day in fields[2] or (bool(specials[0]) and day.day == last)
+    weekday = (day.weekday() + 1) % 7
+    dow = weekday in fields[4] or any(weekday == d and (day.day + 7 > last if k is None else (day.day - 1) // 7 + 1 == k) for d, k in specials[1])
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow
+    if dow_free:
+        return dom
+    return dom or dow
+
 
