 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    parsed = _parse(expr)
+    return (when.minute in parsed[0][0] and when.hour in parsed[1][0]
+            and when.month in parsed[3][0] and _day_matches(parsed, when))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    parsed = _parse(expr)
+    try:
+        limit = after + timedelta(days=10 * 365)
+    except OverflowError:
+        limit = datetime.max
+    times = sorted(h * 60 + m for h in parsed[1][0] for m in parsed[0][0])
+    day = after.replace(hour=0, minute=0, second=0, microsecond=0)
+    while day <= limit:
+        if day.month in parsed[3][0] and _day_matches(parsed, day):
+            index = bisect_right(times, after.hour * 60 + after.minute) if day.date() == after.date() else 0
+            if index < len(times):
+                candidate = day + timedelta(minutes=times[index])
+                return candidate if candidate <= limit else None
+        if day.date() == limit.date():
+            break
+        day += timedelta(days=1)
+    return None
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule needs five fields")
+    return tuple(_field(text, i) for i, text in enumerate(fields))
+
+
+def _field(text, index):
+    low, high = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def number(token):
+        if token.upper() in names:
+            value = names[token.upper()]
+        elif re.fullmatch(r"[0-9]+", token):
+            value = int(token)
+        else:
+            raise ValueError("invalid field value")
+        if not low <= value <= high:
+            raise ValueError("field value outside range")
+        return value
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        match = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if index == 4 and match:
+            weekday = number(match[1]) % 7
+            if match[2] == "L":
+                special.append(("last", weekday))
+            else:
+                ordinal = int(match[3])
+                if not 1 <= ordinal <= 5:
+                    raise ValueError("invalid weekday ordinal")
+                special.append(("nth", weekday, ordinal))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError("invalid step")
+            step = int(pieces[1])
+        base = pieces[0]
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError("invalid range")
+            start, end = map(number, endpoints)
+        else:
+            start = number(base)
+            end = high if len(pieces) == 2 else start
+        if start > end:
+            raise ValueError("descending range")
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, special
+
+
+def _day_matches(parsed, when):
+    last = calendar.monthrange(when.year, when.month)[1]
+    days, specials = parsed[2]
+    if when.day not in days and not (specials and when.day == last):
+        return False
+    weekdays, specials = parsed[4]
+    weekday = (when.weekday() + 1) % 7
+    if weekday in weekdays:
+        return True
+    return any(weekday == rule[1] and (
+        when.day + 7 > last if rule[0] == "last"
+        else (when.day - 1) // 7 + 1 == rule[2]) for rule in specials)
