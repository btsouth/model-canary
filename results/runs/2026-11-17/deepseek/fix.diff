 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_ALIASES = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+
+_DAY_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+_DAYS = 10 * 365
+
+
+class _Spec:
+    def __init__(self, low, high, names=None, kind=None):
+        self.low = low
+        self.high = high
+        self.names = names or {}
+        self.kind = kind
+
+
+_MINUTE = _Spec(0, 59)
+_HOUR = _Spec(0, 23)
+_DAY_OF_MONTH = _Spec(1, 31, kind="dom")
+_MONTH = _Spec(1, 12, names=_MONTH_NAMES)
+_DAY_OF_WEEK = _Spec(0, 7, names=_DAY_NAMES, kind="dow")
+
+
+class _Field:
+    def __init__(self):
+        self.values = set()
+        self.last_day = False
+        self.last_weekdays = set()
+        self.nth_weekdays = set()
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, day_of_month, months, day_of_week):
+        self.minutes = minutes.values
+        self.hours = hours.values
+        self.day_of_month = day_of_month
+        self.months = months.values
+        self.day_of_week = day_of_week
+        self.sorted_hours = sorted(self.hours)
+        self.sorted_minutes = sorted(self.minutes)
+
+
+def _token_value(token, spec):
+    if token.isascii() and token.isdigit():
+        return int(token), False
+    name = token.upper()
+    if name in spec.names:
+        return spec.names[name], True
+    raise ValueError(f"bad value: {token!r}")
+
+
+def _parse_item(item, spec, field):
+    if "/" in item:
+        pieces = item.split("/")
+        if len(pieces) != 2:
+            raise ValueError(f"bad step: {item!r}")
+        base, step_text = pieces
+        if not (step_text.isascii() and step_text.isdigit()):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+    else:
+        base = item
+        step = None
+
+    if spec.kind == "dom" and base == "L":
+        if step is not None:
+            raise ValueError(f"bad item: {item!r}")
+        field.last_day = True
+        return
+
+    if spec.kind == "dow":
+        match = re.fullmatch(r"([0-9]+)L", base)
+        if match:
+            if step is not None:
+                raise ValueError(f"bad item: {item!r}")
+            n = int(match.group(1))
+            if not 0 <= n <= 7:
+                raise ValueError(f"bad item: {item!r}")
+            field.last_weekdays.add(n % 7)
+            return
+
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", base)
+        if match:
+            if step is not None:
+                raise ValueError(f"bad item: {item!r}")
+            n = int(match.group(1))
+            k = int(match.group(2))
+            if not 0 <= n <= 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad item: {item!r}")
+            field.nth_weekdays.add((n % 7, k))
+            return
+
+    if base == "*":
+        values = list(range(spec.low, spec.high + 1))
+        used_name = False
+    elif "-" in base:
+        pieces = base.split("-")
+        if len(pieces) != 2:
+            raise ValueError(f"bad range: {base!r}")
+        start, start_name = _token_value(pieces[0], spec)
+        end, end_name = _token_value(pieces[1], spec)
+        if start > end:
+            raise ValueError(f"bad range: {base!r}")
+        values = list(range(start, end + 1))
+        used_name = start_name or end_name
+    else:
+        value, used_name = _token_value(base, spec)
+        if not spec.low <= value <= spec.high:
+            raise ValueError(f"value out of range: {value!r}")
+        if step is None:
+            values = [value]
+        else:
+            values = list(range(value, spec.high + 1))
+
+    if step is not None:
+        if used_name:
+            raise ValueError(f"name with step: {item!r}")
+        values = values[::step]
+
+    for value in values:
+        if not spec.low <= value <= spec.high:
+            raise ValueError(f"value out of range: {value!r}")
+
+    if spec.kind == "dow":
+        field.values.update(value % 7 for value in values)
+    else:
+        field.values.update(values)
+
+
+def _parse_field(raw, spec):
+    if raw == "?":
+        if spec.kind not in ("dom", "dow"):
+            raise ValueError("'?' is only allowed in day fields")
+        raw = "*"
+    elif "?" in raw:
+        raise ValueError("'?' is only allowed as a whole day field")
+
+    field = _Field()
+    for item in raw.split(","):
+        if item == "":
+            raise ValueError("empty item")
+        _parse_item(item, spec, field)
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule expression")
+
+    alias = _ALIASES.get(text.lower())
+    if alias is not None:
+        text = alias
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {text!r}")
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    minutes = _parse_field(fields[0], _MINUTE)
+    hours = _parse_field(fields[1], _HOUR)
+    day_of_month = _parse_field(fields[2], _DAY_OF_MONTH)
+    months = _parse_field(fields[3], _MONTH)
+    day_of_week = _parse_field(fields[4], _DAY_OF_WEEK)
+
+    return _Schedule(minutes, hours, day_of_month, months, day_of_week)
+
+
+def _day_allowed(schedule, moment):
+    if moment.month not in schedule.months:
+        return False
+
+    last_day = calendar.monthrange(moment.year, moment.month)[1]
+    dom = schedule.day_of_month
+    if not (moment.day in dom.values or (dom.last_day and moment.day == last_day)):
+        return False
+
+    dow = schedule.day_of_week
+    weekday = (moment.weekday() + 1) % 7
+    if weekday in dow.values:
+        return True
+    if weekday in dow.last_weekdays and moment.day + 7 > last_day:
+        return True
+    if (weekday, (moment.day - 1) // 7 + 1) in dow.nth_weekdays:
+        return True
+    return False
+
 
