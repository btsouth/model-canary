--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,210 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+_MONTH_NAMES = {name: i + 1 for i, name in enumerate(_MONTHS)}
+_DAY_NAMES = {name: i for i, name in enumerate(_DAYS)}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names) for each of the five fields.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTH_NAMES),
+    (0, 7, _DAY_NAMES),
+]
+
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+def _number(text, low, high, names, what):
+    """Read a plain number (or, where allowed, a name) within [low, high]."""
+    if text.isascii() and text.isdigit():
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad {what}: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"{what} {text!r} outside {low}-{high}")
+    return value
+
+
+def _step(text):
+    if not (text.isascii() and text.isdigit()):
+        raise ValueError(f"bad step: {text!r}")
+    step = int(text)
+    if step < 1:
+        raise ValueError(f"step must be at least 1: {text!r}")
+    return step
+
+
+def _parse_field(text, index):
+    """Return (values, last, last_dow, nth_dow) for one field.
+
+    values is a set of allowed numbers (None means every value). last is True
+    when the day-of-month field lists L. last_dow is a set of weekdays N from NL
+    items, and nth_dow a set of (N, K) pairs from N#K items.
+    """
+    low, high, names = _FIELDS[index]
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError("'?' only allowed in the day fields")
+        return None, False, set(), set()
+    values = set()
+    last = False
+    last_dow = set()
+    nth_dow = set()
+    every = False
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in field {text!r}")
+        if index == 2 and item == "L":
+            last = True
+            continue
+        if index == 4:
+            if item.endswith("L"):
+                last_dow.add(_number(item[:-1], 0, 7, None, "day of week") % 7)
+                continue
+            if "#" in item:
+                day, _, nth = item.partition("#")
+                day = _number(day, 0, 7, None, "day of week") % 7
+                nth = _number(nth, 1, 5, None, "week number")
+                nth_dow.add((day, nth))
+                continue
+        base, slash, step_text = item.partition("/")
+        step = _step(step_text) if slash else 1
+        if base == "*":
+            start, stop = low, high
+            if not slash:
+                every = True
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            start = _number(a, low, high, names, "value")
+            stop = _number(b, low, high, names, "value")
+            if start > stop:
+                raise ValueError(f"range start after end: {base!r}")
+        else:
+            start = _number(base, low, high, names, "value")
+            stop = high if slash else start
+        values.update(range(start, stop + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    if every:
+        values = None
+    return values, last, last_dow, nth_dow
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("expression must be a string")
+        text = expr.strip()
+        if text.startswith("@"):
+            try:
+                text = _SHORTCUTS[text.lower()]
+            except KeyError:
+                raise ValueError(f"unknown shortcut: {text!r}") from None
+        parts = re.split(r"[ \t]+", text) if text else []
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+        self.minutes = _parse_field(parts[0], 0)[0]
+        self.hours = _parse_field(parts[1], 1)[0]
+        self.doms, self.last_dom, _, _ = _parse_field(parts[2], 2)
+        self.months = _parse_field(parts[3], 3)[0]
+        self.dows, _, self.last_dows, self.nth_dows = _parse_field(parts[4], 4)
+        if self.minutes is None:
+            self.minutes = set(range(60))
+        if self.hours is None:
+            self.hours = set(range(24))
+        if self.months is None:
+            self.months = set(range(1, 13))
+        self.minute_list = sorted(self.minutes)
+        self.hour_list = sorted(self.hours)
+        # True when the day-of-month / day-of-week field matches every day.
+        self.any_dom = self.doms is None
+        self.any_dow = self.dows is None
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        days_in_month = calendar.monthrange(date.year, date.month)[1]
+        if not self.any_dom:
+            ok = date.day in self.doms
+            if not ok and self.last_dom and date.day == days_in_month:
+                ok = True
+            if not ok:
+                return False
+        if not self.any_dow:
+            dow = (date.weekday() + 1) % 7  # Sunday == 0
+            ok = dow in self.dows
+            if not ok and dow in self.last_dows and date.day + 7 > days_in_month:
+                ok = True
+            if not ok and (dow, (date.day - 1) // 7 + 1) in self.nth_dows:
+                ok = True
+            if not ok:
+                return False
+        return True
+
+    def matches(self, when):
+        return (
+            when.minute in self.minutes
+            and when.hour in self.hours
+            and self.day_allowed(when.date())
+        )
+
+    def next_run(self, after):
+        start = after.replace(second=0, microsecond=0) + _dt.timedelta(minutes=1)
+        try:
+            limit = after + _LIMIT
+        except OverflowError:
+            limit = _dt.datetime.max
+        date = start.date()
+        last_date = limit.date()
+        first_day = True
+        while date <= last_date:
+            if self.day_allowed(date):
+                for hour in self.hour_list:
+                    if first_day and hour < start.hour:
+                        continue
+                    for minute in self.minute_list:
+                        if first_day and hour == start.hour and minute < start.minute:
+                            continue
+                        candidate = _dt.datetime.combine(
+                            date, _dt.time(hour, minute)
+                        )
+                        if candidate > limit:
+                            return None
+                        return candidate
+            first_day = False
+            try:
+                date += _dt.timedelta(days=1)
+            except OverflowError:
+                return None
+        return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _Schedule(expr).matches(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    return _Schedule(expr).next_run(after)
