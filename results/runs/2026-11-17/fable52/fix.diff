 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+\Z")
+_LAST_DOW = re.compile(r"([0-9]+)L\Z")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)\Z")
+_LIMIT = datetime.timedelta(days=3650)
+
+
+def _value(token, low, high, names):
+    if _NUMBER.match(token):
+        number = int(token)
+    elif names is not None and token.upper() in names:
+        number = names[token.upper()]
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if not low <= number <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return number
+
+
+def _items(field, low, high, names=None):
+    """Yield the plain values of a field; special items are yielded as tuples."""
+    values = set()
+    for item in field.split(","):
+        if "/" in item:
+            base, step = item.split("/", 1)
+            if not _NUMBER.match(step) or int(step) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step)
+        else:
+            base, step = item, None
+        if base == "*":
+            first, last = low, high
+        elif "-" in base:
+            a, b = base.split("-", 1)
+            first, last = _value(a, low, high, names), _value(b, low, high, names)
+            if first > last:
+                raise ValueError(f"bad range: {item!r}")
+        else:
+            first = _value(base, low, high, names)
+            last = first if step is None else high
+        values.update(range(first, last + 1, step or 1))
+    return values
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+    minute, hour, dom, month, dow = parts
+
+    minutes = sorted(_items(minute, 0, 59))
+    hours = sorted(_items(hour, 0, 23))
+    months = _items(month, 1, 12, _MONTHS)
+
+    dom_last = False
+    if dom == "?":
+        doms = set(range(1, 32))
+    else:
+        doms = set()
+        for item in dom.split(","):
+            if item == "L":
+                dom_last = True
+            else:
+                doms |= _items(item, 1, 31)
+
+    last_dows, nth_dows = set(), set()
+    if dow == "?":
+        dows = set(range(7))
+    else:
+        dows = set()
+        for item in dow.split(","):
+            last = _LAST_DOW.match(item)
+            nth = _NTH_DOW.match(item)
+            if last:
+                last_dows.add(_value(last.group(1), 0, 7, None) % 7)
+            elif nth:
+                k = int(nth.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad day of week: {item!r}")
+                nth_dows.add((_value(nth.group(1), 0, 7, None) % 7, k))
+            else:
+                dows |= {v % 7 for v in _items(item, 0, 7, _DAYS)}
+
+    def day_ok(year, mon, day):
+        if mon not in months:
+            return False
+        first_weekday, length = calendar.monthrange(year, mon)
+        if not (day in doms or (dom_last and day == length)):
+            return False
+        weekday = (first_weekday + 1 + day - 1) % 7  # 0 = Sunday
+        if weekday in dows:
+            return True
+        if weekday in last_dows and day + 7 > length:
+            return True
+        return (weekday, (day - 1) // 7 + 1) in nth_dows
+
+    return minutes, hours, months, day_ok
 
 
