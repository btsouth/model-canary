 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from calendar import monthrange
+from datetime import datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
+        start=1,
+    )
+}
+_DAY_NAMES = {
+    name: number
+    for number, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))
+}
+
+# (label, lowest value, highest value, names accepted in the field)
+_FIELDS = (
+    ("minute", 0, 59, {}),
+    ("hour", 0, 23, {}),
+    ("day of month", 1, 31, {}),
+    ("month", 1, 12, _MONTH_NAMES),
+    ("day of week", 0, 7, _DAY_NAMES),
+)
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_DAY_FIELDS = (_DOM, _DOW)
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L", re.IGNORECASE)  # 5L: last Friday
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")  # 1#2: second Monday
+
+_LAST_DAY = "last day"  # extra marker for L in the day-of-month field
+
+_SEARCH_LIMIT = timedelta(days=10 * 365)
+_ONE_MINUTE = timedelta(minutes=1)
+_ONE_DAY = timedelta(days=1)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    return (
+        when.minute in fields[_MINUTE][0]
+        and when.hour in fields[_HOUR][0]
+        and _day_allowed(fields, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    minutes = sorted(fields[_MINUTE][0])
+    hours = sorted(fields[_HOUR][0])
+    try:
+        start = after.replace(second=0, microsecond=0) + _ONE_MINUTE
+    except OverflowError:
+        return None
+    try:
+        limit = after + _SEARCH_LIMIT
+    except OverflowError:
+        limit = datetime.max
+
+    day = start.date()
+    last_day = limit.date()
+    while day <= last_day:
+        if _day_allowed(fields, day):
+            # Hours and minutes are sorted, so the first candidate at or after start
+            # is the next run on this day.
+            for hour in hours:
+                for minute in minutes:
+                    candidate = datetime.combine(day, time(hour, minute))
+                    if candidate < start:
+                        continue
+                    return candidate if candidate <= limit else None
+        if day == last_day:
+            break
+        day += _ONE_DAY
+    return None
+
+
+def _parse(expr):
+    """Check the whole expression; return (values, extras) for each of the five fields."""
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields, got {len(parts)}: {expr!r}")
+    return tuple(_parse_field(part, index) for index, part in enumerate(parts))
+
+
+def _parse_field(text, index):
+    label, lo, hi, names = _FIELDS[index]
+    if index in _DAY_FIELDS and text == "?":
+        text = "*"
+    values, extras = set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {label} field: {text!r}")
+        item_values, item_extras = _parse_item(item, index)
+        values |= item_values
+        extras |= item_extras
+    if index == _DOW:
+        # 0 and 7 are both Sunday; store weekdays with Sunday = 0.
+        values = {v % 7 for v in values}
+    return frozenset(values), frozenset(extras)
+
+
+def _parse_item(item, index):
+    label, lo, hi, names = _FIELDS[index]
+    base, slash, step_text = item.partition("/")
+    if not slash:
+        if index == _DOM and item.upper() == "L":
+            return set(), {_LAST_DAY}
+        if index == _DOW:
+            match = _LAST_WEEKDAY.fullmatch(item)
+            if match:
+                weekday = _number(match.group(1), label, lo, hi, {}) % 7
+                return set(), {("last", weekday)}
+            match = _NTH_WEEKDAY.fullmatch(item)
+            if match:
+                weekday = _number(match.group(1), label, lo, hi, {}) % 7
+                nth = _number(match.group(2), "occurrence", 1, 5, {})
+                return set(), {("nth", weekday, nth)}
+        first, last = _span(base, label, lo, hi, names, stepped=False)
+        return set(range(first, last + 1)), set()
+
+    # A step may not use names, and L, NL and N#K cannot be stepped.
+    if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+        raise ValueError(f"bad step in {label} field: {item!r}")
+    first, last = _span(base, label, lo, hi, {}, stepped=True)
+    return set(range(first, last + 1, int(step_text))), set()
+
+
+def _span(base, label, lo, hi, names, stepped):
+    """First and last value listed by '*', 'N' or 'A-B'.
+
+    A stepped N lists N up to the field's maximum.
+    """
+    if base == "*":
+        return lo, hi
+    start_text, dash, end_text = base.partition("-")
+    start = _number(start_text, label, lo, hi, names)
+    if not dash:
+        return (start, hi) if stepped else (start, start)
+    end = _number(end_text, label, lo, hi, names)
+    if start > end:
+        raise ValueError(f"range goes backwards in {label} field: {base!r}")
+    return start, end
+
+
+def _number(text, label, lo, hi, names):
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad {label} value: {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"{label} value out of range: {text!r}")
+    return value
+
+
+def _day_allowed(fields, day):
+    """True if the date day matches both the day-of-month and day-of-week fields."""
+    dom_values, dom_extras = fields[_DOM]
+    dow_values, dow_extras = fields[_DOW]
+    if day.month not in fields[_MONTH][0]:
+        return False
+    last = monthrange(day.year, day.month)[1]
+    dom_ok = day.day in dom_values or (_LAST_DAY in dom_extras and day.day == last)
+    weekday = (day.weekday() + 1) % 7  # Monday = 0 in Python; here Sunday = 0
+    nth = (day.day - 1) // 7 + 1
+    dow_ok = (
+        weekday in dow_values
+        or (("last", weekday) in dow_extras and day.day + 7 > last)
+        or (("nth", weekday, nth) in dow_extras)
+    )
+    return dom_ok and dow_ok
