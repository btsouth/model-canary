--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,193 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import timedelta
+from typing import NamedTuple
+
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAY_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (lowest, highest, names) for minute, hour, day of month, month, day of week.
+_SPECS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTH_NAMES),
+    (0, 7, _DAY_NAMES),
+]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_DAY_OF_WEEK = re.compile(r"([0-9]+)L")
+_NTH_DAY_OF_WEEK = re.compile(r"([0-9]+)#([0-9]+)")
+_SEARCH_DAYS = 10 * 365
+
+
+class _Schedule(NamedTuple):
+    minutes: frozenset
+    hours: frozenset
+    days: frozenset          # plain day-of-month numbers
+    last_day: bool           # L in day of month
+    months: frozenset
+    weekdays: frozenset      # plain days of week, Sunday = 0
+    last_weekdays: frozenset  # N in NL
+    nth_weekdays: frozenset  # (N, K) in N#K
+
+
+def _value(token, lo, hi, names):
+    """Read one number or name and check it lies within lo..hi."""
+    if _DIGITS.fullmatch(token):
+        number = int(token)
+    elif names and token.upper() in names:
+        number = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r}")
+    if not lo <= number <= hi:
+        raise ValueError(f"value {token!r} out of range {lo}-{hi}")
+    return number
+
+
+def _expand(item, lo, hi, names):
+    """Return the list of values one plain item (not L, NL or N#K) lists, in order."""
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    elif "-" in base:
+        start_text, _, end_text = base.partition("-")
+        start = _value(start_text, lo, hi, names)
+        end = _value(end_text, lo, hi, names)
+        if start > end:
+            raise ValueError(f"range {base!r} runs backwards")
+        values = list(range(start, end + 1))
+    else:
+        start = _value(base, lo, hi, names)
+        values = list(range(start, hi + 1)) if step else [start]
+    if step:
+        values = values[::step]
+    return values
+
+
+def _parse_field(text, index):
+    lo, hi, names = _SPECS[index]
+    is_day_of_month = index == 2
+    is_day_of_week = index == 4
+    if (is_day_of_month or is_day_of_week) and text == "?":
+        text = "*"
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in field {text!r}")
+        if is_day_of_month and item.upper() == "L":
+            last_day = True
+            continue
+        if is_day_of_week:
+            match = _LAST_DAY_OF_WEEK.fullmatch(item.upper())
+            if match:
+                last_weekdays.add(_value(match.group(1), 0, 7, None) % 7)
+                continue
+            match = _NTH_DAY_OF_WEEK.fullmatch(item)
+            if match:
+                weekday = _value(match.group(1), 0, 7, None) % 7
+                nth = _value(match.group(2), 1, 5, None)
+                nth_weekdays.add((weekday, nth))
+                continue
+        values.update(_expand(item, lo, hi, names))
+    if is_day_of_week:
+        values = {v % 7 for v in values}
+    return values, last_day, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    """Check the whole expression and return its parsed form; ValueError if bad."""
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    text = expr.strip()
+    text = _SHORTCUTS.get(text.lower(), text)
+    pieces = re.split(r"[ \t]+", text)
+    if len(pieces) != 5:
+        raise ValueError(f"expected 5 fields, got {len(pieces)}: {expr!r}")
+    parsed = [_parse_field(piece, i) for i, piece in enumerate(pieces)]
+    minute_values, _, _, _ = parsed[0]
+    hour_values, _, _, _ = parsed[1]
+    day_values, last_day, _, _ = parsed[2]
+    month_values, _, _, _ = parsed[3]
+    weekday_values, _, last_weekdays, nth_weekdays = parsed[4]
+    return _Schedule(
+        minutes=frozenset(minute_values),
+        hours=frozenset(hour_values),
+        days=frozenset(day_values),
+        last_day=last_day,
+        months=frozenset(month_values),
+        weekdays=frozenset(weekday_values),
+        last_weekdays=frozenset(last_weekdays),
+        nth_weekdays=frozenset(nth_weekdays),
+    )
+
+
+def _day_allowed(spec, day):
+    """True if the calendar date day matches both the day-of-month and day-of-week fields."""
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    day_of_month_ok = day.day in spec.days or (spec.last_day and day.day == days_in_month)
+    if not day_of_month_ok:
+        return False
+    weekday = (day.weekday() + 1) % 7  # Sunday = 0
+    if weekday in spec.weekdays:
+        return True
+    if weekday in spec.last_weekdays and day.day + 7 > days_in_month:
+        return True
+    return (weekday, (day.day - 1) // 7 + 1) in spec.nth_weekdays
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return bool(
+        when.minute in spec.minutes
+        and when.hour in spec.hours
+        and when.month in spec.months
+        and _day_allowed(spec, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    try:
+        limit = after + timedelta(days=_SEARCH_DAYS)
+    except OverflowError:
+        limit = None
+    try:
+        t = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+        while limit is None or t <= limit:
+            if t.month not in spec.months:
+                t = (t.replace(day=1, hour=0, minute=0) + timedelta(days=32)).replace(day=1)
+            elif not _day_allowed(spec, t.date()):
+                t = t.replace(hour=0, minute=0) + timedelta(days=1)
+            elif t.hour not in spec.hours:
+                t = t.replace(minute=0) + timedelta(hours=1)
+            elif t.minute not in spec.minutes:
+                t += timedelta(minutes=1)
+            else:
+                return t
+    except OverflowError:
+        pass
+    return None
