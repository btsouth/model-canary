 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(calendar.day_abbr)}
+
+
+def _parse_field(text, index):
+    bounds = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))[index]
+    names = _MONTHS if index == 3 else (_DAYS if index == 4 else {})
+    if index in (2, 4) and text == "?":
+        text = "*"
+    wildcard = text == "*"
+    values = set()
+    specials = []
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if index == 4:
+            m = re.fullmatch(r"(\d+)L", item)
+            if m:
+                n = int(m.group(1))
+                if not 0 <= n <= 7:
+                    raise ValueError("day of week out of range")
+                specials.append(("last_weekday", 0 if n == 7 else n))
+                continue
+            m = re.fullmatch(r"(\d+)#(\d+)", item)
+            if m:
+                n, k = map(int, m.groups())
+                if not 0 <= n <= 7 or not 1 <= k <= 5:
+                    raise ValueError("day-of-week ordinal out of range")
+                specials.append(("nth_weekday", 0 if n == 7 else n, k))
+                continue
+
+        if item.count("/") > 1:
+            raise ValueError("bad step")
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not re.fullmatch(r"[0-9]+", step_text) or int(step_text) < 1:
+                raise ValueError("bad step")
+            step = int(step_text)
+
+        def atom(s):
+            if s.upper() in names:
+                if slash:
+                    raise ValueError("names are not allowed in steps")
+                return names[s.upper()]
+            if not re.fullmatch(r"[0-9]+", s):
+                raise ValueError("bad field value")
+            value = int(s)
+            if not bounds[0] <= value <= bounds[1]:
+                raise ValueError("field value out of range")
+            return value
+
+        if base == "*":
+            seq = range(bounds[0], bounds[1] + 1)
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("bad range")
+            a, b = base.split("-")
+            lo, hi = atom(a), atom(b)
+            if lo > hi:
+                raise ValueError("reversed range")
+            seq = range(lo, hi + 1)
+        else:
+            lo = atom(base)
+            seq = range(lo, bounds[1] + 1) if slash else (lo,)
+        values.update(list(seq)[::step])
+
+    if index == 4 and 7 in values:
+        values.remove(7)
+        values.add(0)
+    return values, specials, wildcard
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    candidate = expr.strip()
+    candidate = _SHORTCUTS.get(candidate.lower(), candidate)
+    fields = re.split(r"[ \t]+", candidate) if candidate else []
+    if len(fields) != 5:
+        raise ValueError("schedule must contain five fields")
+    return [_parse_field(field, i) for i, field in enumerate(fields)]
+
+
+def _day_matches(parsed, day):
+    dom_values, dom_specials, dom_wild = parsed[2]
+    dow_values, dow_specials, dow_wild = parsed[4]
+    dom_ok = day.day in dom_values
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    if ("last",) in dom_specials and day.day == last_day:
+        dom_ok = True
+    dow = (day.weekday() + 1) % 7
+    for special in dow_specials:
+        if special[0] == "last_weekday":
+            n = special[1]
+            if dow == n and day.day + 7 > last_day:
+                dow_values_ok = True
+                break
+        elif special[0] == "nth_weekday":
+            _, n, k = special
+            if dow == n and (day.day - 1) // 7 + 1 == k:
+                dow_values_ok = True
+                break
+    else:
+        dow_values_ok = dow in dow_values
+    return dom_ok and dow_values_ok
+
 
