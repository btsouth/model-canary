 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {"SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6}
+
+
+def _field(raw, index):
+    lo, hi = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))[index]
+    names = _MONTHS if index == 3 else (_DAYS if index == 4 else {})
+    wildcard = raw in ("*", "?")
+    if raw == "?" and index not in (2, 4):
+        raise ValueError("? only allowed in day fields")
+    result, specials = set(), []
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty field item")
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if index == 4:
+            m = re.fullmatch(r"(\d+)L", item)
+            if m:
+                n = int(m.group(1)); _check(n, 0, 7)
+                specials.append(("last_weekday", n % 7)); continue
+            m = re.fullmatch(r"(\d+)#([1-5])", item)
+            if m:
+                n = int(m.group(1)); _check(n, 0, 7)
+                specials.append(("nth", n % 7, int(m.group(2)))); continue
+        if "L" in item or "#" in item:
+            raise ValueError("invalid special day item")
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        step = 1
+        if len(pieces) == 2:
+            if not pieces[1].isdigit() or int(pieces[1]) < 1:
+                raise ValueError("invalid step")
+            step = int(pieces[1])
+        base = pieces[0]
+        if len(pieces) == 2 and any(c.isalpha() for c in base):
+            raise ValueError("names are not allowed in steps")
+        if base == "*":
+            vals = list(range(lo, hi + 1))
+        elif re.fullmatch(r"\d+", base):
+            n = int(base); _check(n, lo, hi)
+            vals = list(range(n, hi + 1)) if len(pieces) == 2 else [n]
+        elif "-" in base:
+            a, b = base.split("-", 1)
+            av, bv = _value(a, names), _value(b, names)
+            _check(av, lo, hi); _check(bv, lo, hi)
+            if av > bv: raise ValueError("descending range")
+            vals = list(range(av, bv + 1))
+        else:
+            if base in names:
+                n = names[base]
+                vals = [n]
+            else:
+                raise ValueError("invalid field item")
+        result.update(vals[::step])
+    return result, wildcard, specials
+
+
+def _check(n, lo, hi):
+    if not lo <= n <= hi: raise ValueError("value out of range")
+
+
+def _value(s, names):
+    s = s.upper()
+    if s in names: return names[s]
+    if not s.isdigit(): raise ValueError("invalid value")
+    return int(s)
+
+
+def _parse(expr):
+    if not isinstance(expr, str): raise ValueError("expression must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try: expr = _SHORTCUTS[expr.lower()]
+        except KeyError: raise ValueError("unknown shortcut") from None
+    fields = re.split(r"[ \t]+", expr) if expr else []
+    if len(fields) != 5: raise ValueError("expected five fields")
+    return [_field(f, i) for i, f in enumerate(fields)]
+
+
+def _day_ok(day, month, year, dom, dow):
+    dvals, dstar, dspecial = dom
+    wvals, wstar, wspecial = dow
+    dmatch = dstar or day in dvals
+    last = calendar.monthrange(year, month)[1]
+    if any(s[0] == "last" for s in dspecial) and day == last: dmatch = True
+    weekday = ( _dt.date(year, month, day).weekday() + 1) % 7
+    wmatch = wstar or weekday in wvals or (weekday == 0 and 7 in wvals)
+    for s in wspecial:
+        if s[0] == "last_weekday" and weekday == s[1] and day + 7 > last: wmatch = True
+        if s[0] == "nth" and weekday == s[1] and (day - 1) // 7 + 1 == s[2]: wmatch = True
+    return dmatch and wmatch
 
 
