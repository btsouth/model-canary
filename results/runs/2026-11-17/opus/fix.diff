 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"])}
+_DAYS = {name: i for i, name in enumerate(
+    ["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_NUM = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "days", "last_day", "months",
+                 "weekdays", "last_weekdays", "nth_weekdays")
+
+
+def _value(text, low, high, names):
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.lower() in names:
+        value = names[text.lower()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _number(text, low, high):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _item(item, low, high, names):
+    """The set of values listed by a plain item (*, N, A-B, optionally /S)."""
+    if not item:
+        raise ValueError("empty item")
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _NUM.fullmatch(step_text):
+            raise ValueError(f"bad step {step_text!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError("step must be at least 1")
+    else:
+        step = 1
+    if base == "*":
+        start, end = low, high
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        start = _value(a, low, high, names)
+        end = _value(b, low, high, names)
+        if start > end:
+            raise ValueError(f"range {base!r} runs backwards")
+    else:
+        start = _value(base, low, high, names)
+        end = high if slash else start
+    return set(range(start, end + 1, step))
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+
+    sched = _Schedule()
+    sched.last_day = False
+    sched.last_weekdays = set()
+    sched.nth_weekdays = set()
+    sets = []
+    for index, (field, (low, high, names)) in enumerate(zip(parts, _FIELDS)):
+        if field == "?":
+            if index not in (2, 4):
+                raise ValueError("'?' is only allowed in the day fields")
+            sets.append(set(range(low, high + 1)))
+            continue
+        values = set()
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                sched.last_day = True
+            elif index == 4 and re.fullmatch(r"[0-9]+L", item):
+                sched.last_weekdays.add(_number(item[:-1], 0, 7) % 7)
+            elif index == 4 and re.fullmatch(r"[0-9]+#[0-9]+", item):
+                n, _, k = item.partition("#")
+                sched.nth_weekdays.add((_number(n, 0, 7) % 7, _number(k, 1, 5)))
+            else:
+                values |= _item(item, low, high, names)
+        sets.append(values)
+    sched.minutes, sched.hours, sched.days, sched.months, weekdays = sets
+    sched.weekdays = {d % 7 for d in weekdays}
+    return sched
+
+
+def _day_allowed(sched, date):
+    last = calendar.monthrange(date.year, date.month)[1]
+    day = date.day
+    if not (day in sched.days or (sched.last_day and day == last)):
+        return False
+    weekday = (date.weekday() + 1) % 7  # 0 = Sunday
+    if weekday in sched.weekdays:
+        return True
+    if weekday in sched.last_weekdays and day + 7 > last:
+        return True
+    return (weekday, (day - 1) // 7 + 1) in sched.nth_weekdays
 
 
