 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError("expected decimal digits")
+    return int(text)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+
+        def value(token):
+            number = names[token] if token in names else _number(token)
+            if not low <= number <= high:
+                raise ValueError("value outside field range")
+            return number
+
+        values, special = set(), []
+        if field == "?" and index in (2, 4):
+            field = "*"
+        for item in field.upper().split(","):
+            if index == 2 and item == "L":
+                special.append(("last",))
+                continue
+            match = re.fullmatch(r"([0-9]+)(L|#[0-9]+)", item)
+            if index == 4 and match:
+                day = value(match[1]) % 7
+                nth = 0 if match[2] == "L" else _number(match[2][1:])
+                if match[2] != "L" and not 1 <= nth <= 5:
+                    raise ValueError("weekday occurrence outside range")
+                special.append(("weekday", day, nth))
+                continue
+            parts = item.split("/")
+            if len(parts) > 2:
+                raise ValueError("invalid step")
+            step = _number(parts[1]) if len(parts) == 2 else 1
+            if step < 1:
+                raise ValueError("step must be positive")
+            base = parts[0]
+            if base == "*":
+                start, end = low, high
+            elif "-" in base:
+                bounds = base.split("-")
+                if len(bounds) != 2:
+                    raise ValueError("invalid range")
+                start, end = map(value, bounds)
+                if start > end:
+                    raise ValueError("descending range")
+            else:
+                start = value(base)
+                end = high if len(parts) == 2 else start
+            values.update(range(start, end + 1, step))
+        if index == 4:
+            values = {day % 7 for day in values}
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, day):
+    if day.month not in parsed[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = parsed[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    dow, dow_special = parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    return weekday in dow or any(
+        weekday == target and (day.day + 7 > last if nth == 0 else (day.day - 1) // 7 + 1 == nth)
+        for _, target, nth in dow_special)
+
 
