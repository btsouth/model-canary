 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+\Z")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.match(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _field(text, lo, hi, names=None, kind=None):
+    """Return (set of values, extras). extras: list of special day tests."""
+    if kind and text == "?":
+        return set(range(lo, hi + 1)), []
+    values, extras = set(), []
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item.upper() == "L":
+            extras.append(("L",))
+            continue
+        if kind == "dow":
+            m = re.match(r"([0-9]+)[lL]\Z", item)
+            if m:
+                extras.append(("NL", _value(m.group(1), 0, 7, None) % 7))
+                continue
+            m = re.match(r"([0-9]+)#([0-9]+)\Z", item)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError("bad occurrence")
+                extras.append(("NK", _value(m.group(1), 0, 7, None) % 7, k))
+                continue
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.match(step) or int(step) < 1:
+                raise ValueError(f"bad step {step!r}")
+            step = int(step)
+        else:
+            step = 1
+        if base == "*":
+            vals = list(range(lo, hi + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a > b:
+                raise ValueError("descending range")
+            vals = list(range(a, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            vals = list(range(a, hi + 1)) if sep else [a]
+        values.update(vals[::step])
+    return values, extras
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORTCUTS.get(expr.lower())
+        if expr is None:
+            raise ValueError("unknown shortcut")
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minute, _ = _field(parts[0], 0, 59)
+    hour, _ = _field(parts[1], 0, 23)
+    dom, dom_x = _field(parts[2], 1, 31, None, "dom")
+    month, _ = _field(parts[3], 1, 12, _MONTHS)
+    dow, dow_x = _field(parts[4], 0, 7, _DAYS, "dow")
+    dow = {v % 7 for v in dow}
+    return (sorted(minute), sorted(hour), dom, dom_x, month, dow, dow_x)
+
+
+def _day_ok(p, d):
+    _, _, dom, dom_x, month, dow, dow_x = p
+    if d.month not in month:
+        return False
+    last = calendar.monthrange(d.year, d.month)[1]
+    if not (d.day in dom or (("L",) in dom_x and d.day == last)):
+        return False
+    wd = (d.weekday() + 1) % 7
+    if wd in dow:
+        return True
+    for x in dow_x:
+        if x[1] != wd:
+            continue
+        if x[0] == "NL" and d.day + 7 > last:
+            return True
+        if x[0] == "NK" and (d.day - 1) // 7 + 1 == x[2]:
+            return True
+    return False
 
 
