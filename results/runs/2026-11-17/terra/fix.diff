 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _BOUNDS[index]
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in names:
+                value = names[token.upper()]
+            else:
+                raise ValueError('bad value')
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])L', item) if index == 4 else None
+            if match:
+                special.append(('last_weekday', int(match[1]) % 7))
+                continue
+            match = re.fullmatch(r'([0-7])#([1-5])', item) if index == 4 else None
+            if match:
+                special.append(('nth_weekday', int(match[1]) % 7, int(match[2])))
+                continue
+            parts = item.split('/')
+            if len(parts) > 2 or not parts[0]:
+                raise ValueError('bad item')
+            if len(parts) == 2:
+                if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                    raise ValueError('bad step')
+                step = int(parts[1])
+            else:
+                step = 1
+            base = parts[0]
+            if base == '*':
+                start, end = low, high
+            elif '-' in base:
+                pair = base.split('-')
+                if len(pair) != 2:
+                    raise ValueError('bad range')
+                start, end = map(number, pair)
+                if start > end:
+                    raise ValueError('descending range')
+            else:
+                start = number(base)
+                end = high if len(parts) == 2 else start
+            values.update(range(start, end + 1, step))
+        if index == 4 and 7 in values:
+            values.add(0)
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(schedule, date):
+    dom, dom_special = schedule[2]
+    dow, dow_special = schedule[4]
+    weekday = (date.weekday() + 1) % 7
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom_ok = date.day in dom or bool(dom_special and date.day == last)
+    dow_ok = weekday in dow or any(
+        weekday == rule[1] and (date.day + 7 > last if rule[0] == 'last_weekday'
+                                else (date.day - 1) // 7 + 1 == rule[2])
+        for rule in dow_special
+    )
+    return dom_ok and dow_ok
+
 
