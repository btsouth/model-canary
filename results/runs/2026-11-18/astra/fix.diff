 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(),
+                   range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"bad number: {token!r}")
+    return int(token)
+
+
+def _value(token, field):
+    names = _MONTHS if field == 3 else _DAYS if field == 4 else {}
+    value = names[token] if token in names else _number(token)
+    low, high = _BOUNDS[field]
+    if not low <= value <= high:
+        raise ValueError(f"value outside field range: {token!r}")
+    return value % 7 if field == 4 else value
+
+
+def _field(text, field):
+    unrestricted = text in ("*", "?")
+    if text == "?" and field in (2, 4):
+        text = "*"
+    values, special = set(), []
+    low, high = _BOUNDS[field]
+    if field == 4:
+        high = 6
+    for item in text.split(","):
+        if field == 2 and item == "L":
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if field == 4 and (last or nth):
+            match = last or nth
+            day = _value(match[1], field)
+            if last:
+                special.append(("last", day))
+            else:
+                occurrence = _number(match[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("day occurrence must be 1 through 5")
+                special.append(("nth", day, occurrence))
+            continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"bad item: {item!r}")
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = parts[0]
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"bad range: {base!r}")
+            start, end = (_value(token, field) for token in ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _value(base, field)
+            sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+        values.update(sequence[::step])
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(text, i) for i, text in enumerate(fields)]
+
+
+def _day_matches(fields, when):
+    dom, dow = fields[2], fields[4]
+    day = when.day
+    weekday = (when.weekday() + 1) % 7
+    last = calendar.monthrange(when.year, when.month)[1]
+    dom_match = day in dom[0] or bool(dom[1]) and day == last
+    dow_match = weekday in dow[0] or any(
+        weekday == rule[1] and (
+            day + 7 > last if rule[0] == "last" else (day - 1) // 7 + 1 == rule[2]
+        ) for rule in dow[1]
+    )
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
