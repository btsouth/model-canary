 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _number(token, maximum):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"expected a number, got {token!r}")
+    # All callers only need to distinguish values up to their maximum.
+    digits = token.lstrip("0")
+    if len(digits) > len(str(maximum)):
+        return maximum + 1
+    return int(digits or "0")
+
+
+def _value(token, low, high, names):
+    if token.isascii() and token.upper() in names:
+        return names[token.upper()]
+    value = _number(token, high)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _item_values(item, low, high, names):
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text, high + 1) if slash else 1
+    if not step:
+        raise ValueError("step must be positive")
+
+    if base == "*":
+        start, end = low, high
+    else:
+        first, dash, last = base.partition("-")
+        start = _value(first, low, high, names)
+        end = _value(last, low, high, names) if dash else (high if slash else start)
+
+    if start > end and names is _WEEKDAYS:
+        start %= 7
+        high = 6
+    if start <= end:
+        values = range(start, end + 1)
+    else:
+        values = [*range(start, high + 1), *range(low, end + 1)]
+    return values[::step]
+
+
+def _field(field, low, high, names=None):
+    values = set()
+    for item in field.split(","):
+        values.update(_item_values(item, low, high, names or {}))
+    return values
+
+
+@dataclass
+class _Days:
+    month_days: set
+    weekdays: set
+    last_day: bool
+    last_weekdays: set
+    nth_weekdays: set
+    any_month_day: bool
+    any_weekday: bool
+
+    def allows(self, day):
+        weekday = (day.weekday() + 1) % 7
+        last = calendar.monthrange(day.year, day.month)[1]
+        month_match = day.day in self.month_days or (self.last_day and day.day == last)
+        week_match = (weekday in self.weekdays
+                      or (weekday in self.last_weekdays and day.day + 7 > last)
+                      or (weekday, (day.day - 1) // 7 + 1) in self.nth_weekdays)
+        return (self.any_month_day and self.any_weekday) or month_match or week_match
+
+
+def _days(dom, dow):
+    unrestricted = ("*", "?")
+    days = _Days(set(), set(), False, set(), set(), dom in unrestricted, dow in unrestricted)
+    if not days.any_month_day:
+        for item in dom.split(","):
+            if item == "L":
+                days.last_day = True
+            else:
+                days.month_days.update(_item_values(item, 1, 31, {}))
+    if not days.any_weekday:
+        for item in dow.split(","):
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if special:
+                weekday = _value(special[1], 0, 7, {}) % 7
+                if special[2] == "L":
+                    days.last_weekdays.add(weekday)
+                else:
+                    days.nth_weekdays.add((weekday, _value(special[3], 1, 5, {})))
+            else:
+                days.weekdays.update(n % 7 for n in _item_values(item, 0, 7, _WEEKDAYS))
+    return days
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    minute, hour, dom, month, dow = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    return (_field(minute, 0, 59), _field(hour, 0, 23),
+            _field(month, 1, 12, _MONTHS), _days(dom, dow))
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    minutes, hours, months, days = _parse(expr)
