--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,351 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "jan": 1,
+    "feb": 2,
+    "mar": 3,
+    "apr": 4,
+    "may": 5,
+    "jun": 6,
+    "jul": 7,
+    "aug": 8,
+    "sep": 9,
+    "oct": 10,
+    "nov": 11,
+    "dec": 12,
+}
+
+_DOW_NAMES = {
+    "sun": 0,
+    "mon": 1,
+    "tue": 2,
+    "wed": 3,
+    "thu": 4,
+    "fri": 5,
+    "sat": 6,
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_FIELD_SPLIT = re.compile(r"[ \t]+")
+
+_DAY_LIMIT = 20 * 365
+
+
+class _Schedule:
+    __slots__ = (
+        "minutes",
+        "hours",
+        "months",
+        "dom_values",
+        "dom_last",
+        "dom_restricted",
+        "dow_values",
+        "dow_last",
+        "dow_nth",
+        "dow_restricted",
+        "sorted_hours",
+        "sorted_minutes",
+    )
+
+    def __init__(self):
+        self.minutes = frozenset()
+        self.hours = frozenset()
+        self.months = frozenset()
+        self.dom_values = frozenset()
+        self.dom_last = False
+        self.dom_restricted = True
+        self.dow_values = frozenset()
+        self.dow_last = frozenset()
+        self.dow_nth = frozenset()
+        self.dow_restricted = True
+        self.sorted_hours = ()
+        self.sorted_minutes = ()
+
+
+def _parse_value(token, low, high, names):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    elif names is not None and _NAME.fullmatch(token):
+        value = names.get(token.lower())
+        if value is None:
+            raise ValueError(f"unknown name: {token!r}")
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if value < low or value > high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _split_step(item):
+    if "/" not in item:
+        return item, None
+    base, _, step_text = item.partition("/")
+    if not _NUMBER.fullmatch(step_text):
+        raise ValueError(f"bad step: {item!r}")
+    step = int(step_text)
+    if step < 1:
+        raise ValueError(f"bad step: {item!r}")
+    return base, step
+
+
+def _parse_item(item, low, high, names):
+    base, step = _split_step(item)
+
+    if base == "*":
+        values = list(range(low, high + 1))
+        return values[:: step] if step is not None else values
+
+    if "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range: {item!r}")
+        start_text, end_text = base.split("-")
+        if not start_text or not end_text:
+            raise ValueError(f"bad range: {item!r}")
+        start = _parse_value(start_text, low, high, names)
+        end = _parse_value(end_text, low, high, names)
+        if start > end:
+            values = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            values = list(range(start, end + 1))
+        return values[:: step] if step is not None else values
+
+    value = _parse_value(base, low, high, names)
+    if step is not None:
+        return list(range(value, high + 1))[::step]
+    return [value]
+
+
+def _parse_dow_range(start, end):
+    """Values of a day-of-week range, in cron order, before Sunday folding."""
+    if start > end:
+        if start == 7:
+            start = 0
+        if start <= end:
+            return list(range(start, end + 1))
+        return list(range(start, 7)) + list(range(0, end + 1))
+    return list(range(start, end + 1))
+
+
+def _parse_dow_item(item):
+    # NL: the last day N of the month.
+    if item.endswith("L") and _NUMBER.fullmatch(item[:-1]):
+        value = int(item[:-1])
+        if value > 7:
+            raise ValueError(f"value out of range: {item!r}")
+        return "last", value % 7
+
+    # N#K: the K-th day N of the month.
+    if "#" in item:
+        pieces = item.split("#")
+        if len(pieces) != 2:
+            raise ValueError(f"bad day-of-week item: {item!r}")
+        if not _NUMBER.fullmatch(pieces[0]) or not _NUMBER.fullmatch(pieces[1]):
+            raise ValueError(f"bad day-of-week item: {item!r}")
+        value = int(pieces[0])
+        nth = int(pieces[1])
+        if value > 7 or nth < 1 or nth > 5:
+            raise ValueError(f"value out of range: {item!r}")
+        return "nth", (value % 7, nth)
+
+    if "L" in item or "#" in item:
+        raise ValueError(f"bad day-of-week item: {item!r}")
+
+    base, step = _split_step(item)
+
+    if base == "*":
+        values = list(range(0, 8))
+        if step is not None:
+            values = values[::step]
+    elif "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range: {item!r}")
+        start_text, end_text = base.split("-")
+        if not start_text or not end_text:
+            raise ValueError(f"bad range: {item!r}")
+        start = _parse_value(start_text, 0, 7, _DOW_NAMES)
+        end = _parse_value(end_text, 0, 7, _DOW_NAMES)
+        values = _parse_dow_range(start, end)
+        if step is not None:
+            values = values[::step]
+    else:
+        value = _parse_value(base, 0, 7, _DOW_NAMES)
+        if step is not None:
+            values = list(range(value, 8))[::step]
+        else:
+            values = [value]
+
+    return "values", [value % 7 for value in values]
+
+
+def _parse_dom(text):
+    if text == "?":
+        return frozenset(range(1, 32)), False, False
+    values = set()
+    last = False
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if item == "L":
+            last = True
+            continue
+        values.update(_parse_item(item, 1, 31, None))
+    return frozenset(values), last, text not in ("*", "?")
+
+
+def _parse_dow(text):
+    if text == "?":
+        return frozenset(range(7)), frozenset(), frozenset(), False
+    values = set()
+    last = set()
+    nth = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        kind, data = _parse_dow_item(item)
+        if kind == "values":
+            values.update(data)
+        elif kind == "last":
+            last.add(data)
+        else:
+            nth.add(data)
+    return frozenset(values), frozenset(last), frozenset(nth), text not in ("*", "?")
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+
+    text = expr.strip()
+    lowered = text.lower()
+    if lowered in _SHORTCUTS:
+        text = _SHORTCUTS[lowered]
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    fields = _FIELD_SPLIT.split(text)
+    if len(fields) != 5:
+        raise ValueError(f"wrong number of fields: {expr!r}")
+
+    schedule = _Schedule()
+
+    schedule.minutes = frozenset(_parse_field(fields[0], 0, 59, None))
+    schedule.hours = frozenset(_parse_field(fields[1], 0, 23, None))
+    schedule.months = frozenset(_parse_field(fields[3], 1, 12, _MONTH_NAMES))
+    schedule.dom_values, schedule.dom_last, schedule.dom_restricted = _parse_dom(
+        fields[2]
+    )
+    (
+        schedule.dow_values,
+        schedule.dow_last,
+        schedule.dow_nth,
+        schedule.dow_restricted,
+    ) = _parse_dow(fields[4])
+
+    schedule.sorted_hours = tuple(sorted(schedule.hours))
+    schedule.sorted_minutes = tuple(sorted(schedule.minutes))
+    return schedule
+
+
+def _parse_field(text, low, high, names):
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        values.update(_parse_item(item, low, high, names))
+    return values
+
+
+def _days_in_month(date):
+    return calendar.monthrange(date.year, date.month)[1]
+
+
+def _day_allowed(schedule, date):
+    days = _days_in_month(date)
+
+    dom_ok = date.day in schedule.dom_values or (
+        schedule.dom_last and date.day == days
+    )
+
+    cron_dow = (date.weekday() + 1) % 7
+    dow_ok = cron_dow in schedule.dow_values
+    if not dow_ok and cron_dow in schedule.dow_last and date.day + 7 > days:
+        dow_ok = True
+    if not dow_ok:
+        occurrence = (date.day - 1) // 7 + 1
+        if (cron_dow, occurrence) in schedule.dow_nth:
+            dow_ok = True
+
+    if schedule.dom_restricted and schedule.dow_restricted:
+        return dom_ok or dow_ok
+    if schedule.dom_restricted:
+        return dom_ok
+    if schedule.dow_restricted:
+        return dow_ok
+    return True
+
+
+def _matches(schedule, when):
+    if (
+        when.minute not in schedule.minutes
+        or when.hour not in schedule.hours
+        or when.month not in schedule.months
+    ):
+        return False
+    return _day_allowed(schedule, when)
+
+
+def _earliest_time(schedule, min_minute):
+    for hour in schedule.sorted_hours:
+        base = hour * 60
+        for minute in schedule.sorted_minutes:
+            value = base + minute
+            if value >= min_minute:
+                return value
+    return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    return _matches(schedule, when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+
+    start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    limit = after + timedelta(days=_DAY_LIMIT)
+
+    day = start.date()
+    last_day = limit.date()
+    start_minute = start.hour * 60 + start.minute
+    first = True
+
+    while day <= last_day:
+        if day.month in schedule.months and _day_allowed(schedule, day):
+            min_minute = start_minute if first else 0
+            value = _earliest_time(schedule, min_minute)
+            if value is not None:
+                candidate = datetime.combine(day, time(value // 60, value % 60))
+                if candidate <= limit:
+                    return candidate
+                return None
+        first = False
+        day += timedelta(days=1)
+    return None
