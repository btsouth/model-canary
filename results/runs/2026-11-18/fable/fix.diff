+
+_MONTHS = {n: i for i, n in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"], 1)}
+_DAYS = {n: i for i, n in enumerate(["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+
+# (minimum, maximum, names) for minute, hour, day of month, month, day of week
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+
+_LIMIT = _dt.timedelta(days=20 * 365)
+
