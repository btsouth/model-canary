+def _value(text, index, expr):
+    """Parse a single number or name for field index into an int in range."""
+    low, high, names = _FIELDS[index]
+    if text.isdigit() and text.isascii():
+        value = int(text)
+    elif names is not None and text.lower() in names:
+        value = names[text.lower()]
+    else:
+        raise ValueError(f"bad value {text!r} in {expr!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range in {expr!r}")
+    return value
+
+
+def _step(text, expr):
+    if not (text.isdigit() and text.isascii()):
+        raise ValueError(f"bad step {text!r} in {expr!r}")
+    step = int(text)
+    if step < 1:
+        raise ValueError(f"step must be at least 1 in {expr!r}")
+    return step
+
+
+def _item_values(item, index, expr):
+    """Expand one item (without any specials) into the ordered list of values."""
+    low, high, _ = _FIELDS[index]
+    base, slash, step_text = item.partition("/")
+    step = _step(step_text, expr) if slash else 1
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        a_text, b_text = base.split("-", 1)
+        a = _value(a_text, index, expr)
+        b = _value(b_text, index, expr)
+        if index == _DOW:
+            a %= 7
+            b %= 7
+            top = 6
+        else:
+            top = high
+        if a <= b:
+            values = list(range(a, b + 1))
+        else:
+            values = list(range(a, top + 1)) + list(range(low, b + 1))
+    else:
+        n = _value(base, index, expr)
+        values = list(range(n, high + 1)) if slash else [n]
+    return values[::step]
+
+
+def _parse_field(text, index, expr):
+    """Return (values set, specials) for one field.
+
+    specials is None, or for the day fields a dict with keys 'last' (bool),
+    'last_dow' (set of weekdays) and 'nth' (set of (weekday, k)).
+    """
+    values = set()
+    specials = {"last": False, "last_dow": set(), "nth": set()}
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError(f"'?' not allowed in this field: {expr!r}")
+        text = "*"
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {expr!r}")
+        if index == _DOM and item == "L":
+            specials["last"] = True
+            continue
+        if index == _DOW and item.endswith("L") and item[:-1].isdigit() and item[:-1].isascii():
+            specials["last_dow"].add(_value(item[:-1], _DOW, expr) % 7)
+            continue
+        if index == _DOW and "#" in item:
+            n_text, k_text = item.split("#", 1)
+            if not (n_text.isdigit() and n_text.isascii() and k_text.isdigit() and k_text.isascii()):
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            k = int(k_text)
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            specials["nth"].add((_value(n_text, _DOW, expr) % 7, k))
+            continue
+        if any(ch in item for ch in "L#?"):
+            raise ValueError(f"bad item {item!r} in {expr!r}")
+        for v in _item_values(item, index, expr):
+            values.add(v % 7 if index == _DOW else v)
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut in {expr!r}") from None
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    s = _Schedule()
+    s.minutes, _ = _parse_field(parts[_MINUTE], _MINUTE, expr)
+    s.hours, _ = _parse_field(parts[_HOUR], _HOUR, expr)
+    s.dom, dom_special = _parse_field(parts[_DOM], _DOM, expr)
+    s.months, _ = _parse_field(parts[_MONTH], _MONTH, expr)
+    s.dow, dow_special = _parse_field(parts[_DOW], _DOW, expr)
+    s.dom_last = dom_special["last"]
+    s.dow_last = dow_special["last_dow"]
+    s.dow_nth = dow_special["nth"]
+    s.dom_any = parts[_DOM] in ("*", "?")
+    s.dow_any = parts[_DOW] in ("*", "?")
+    s.times = sorted((h, m) for h in s.hours for m in s.minutes)
+    return s
+
+
+def _dom_matches(s, date):
+    if date.day in s.dom:
+        return True
+    return s.dom_last and date.day == calendar.monthrange(date.year, date.month)[1]
+
+
+def _dow_matches(s, date):
+    dow = (date.weekday() + 1) % 7
+    if dow in s.dow:
+        return True
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    if dow in s.dow_last and date.day + 7 > days_in_month:
+        return True
+    return (dow, (date.day - 1) // 7 + 1) in s.dow_nth
+
+
+def _day_allowed(s, date):
+    if date.month not in s.months:
+        return False
+    if s.dom_any and s.dow_any:
+        return True
+    if s.dom_any:
+        return _dow_matches(s, date)
+    if s.dow_any:
+        return _dom_matches(s, date)
+    return _dom_matches(s, date) or _dow_matches(s, date)
+
 
