 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names)
+_MINUTE = (0, 59, None)
+_HOUR = (0, 23, None)
+_DOM = (1, 31, None)
+_MONTH = (1, 12, _MONTHS)
+_DOW = (0, 7, _DAYS)
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+def _value(text, spec):
+    low, high, names = spec
+    if _NUMBER.fullmatch(text):
+        number = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        number = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= number <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return number
+
+
+def _item(item, spec):
+    """The ordered list of values one ordinary item stands for."""
+    low, high, _ = spec
+    body, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+    if body == "*":
+        values = list(range(low, high + 1))
+    elif "-" in body:
+        first, _, last = body.partition("-")
+        first, last = _value(first, spec), _value(last, spec)
+        if first > last and spec is _DOW:
+            first %= 7
+        if first <= last:
+            values = list(range(first, last + 1))
+        elif spec is _DOW:
+            values = list(range(first, 7)) + list(range(0, last + 1))
+        else:
+            values = list(range(first, high + 1)) + list(range(low, last + 1))
+    else:
+        first = _value(body, spec)
+        values = list(range(first, high + 1)) if slash else [first]
+    return values[::step]
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("schedule expression must be a string")
+        expr = expr.strip()
+        if expr.startswith("@"):
+            try:
+                expr = _SHORTCUTS[expr.lower()]
+            except KeyError:
+                raise ValueError(f"unknown shortcut: {expr!r}") from None
+        parts = re.split(r"[ \t]+", expr)
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields, got {len(parts)}")
+        minute, hour, dom, month, dow = parts
+
+        self.minutes = sorted(self._plain(minute, _MINUTE))
+        self.hours = sorted(self._plain(hour, _HOUR))
+        self.months = self._plain(month, _MONTH)
+
+        self.dom_restricted = dom not in ("*", "?")
+        self.dom_values = set()
+        self.dom_last = False
+        if self.dom_restricted:
+            for item in dom.split(","):
+                if item == "L":
+                    self.dom_last = True
+                else:
+                    self.dom_values.update(_item(item, _DOM))
+
+        self.dow_restricted = dow not in ("*", "?")
+        self.dow_values = set()
+        self.dow_last = set()
+        self.dow_nth = set()
+        if self.dow_restricted:
+            for item in dow.split(","):
+                last = _LAST_DOW.fullmatch(item)
+                nth = _NTH_DOW.fullmatch(item)
+                if last:
+                    self.dow_last.add(self._dow_number(last.group(1)))
+                elif nth:
+                    k = int(nth.group(2))
+                    if not 1 <= k <= 5:
+                        raise ValueError(f"bad day-of-week item: {item!r}")
+                    self.dow_nth.add((self._dow_number(nth.group(1)), k))
+                else:
+                    self.dow_values.update(v % 7 for v in _item(item, _DOW))
+
+    @staticmethod
+    def _plain(field, spec):
+        values = set()
+        for item in field.split(","):
+            values.update(_item(item, spec))
+        return values
+
+    @staticmethod
+    def _dow_number(text):
+        number = int(text)
+        if number > 7:
+            raise ValueError(f"day of week out of range: {text!r}")
+        return number % 7
+
+    def day_ok(self, year, month, day):
+        if month not in self.months:
+            return False
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+        first_weekday, last = calendar.monthrange(year, month)  # Monday == 0
+        if self.dom_restricted:
+            if day in self.dom_values or (self.dom_last and day == last):
+                return True
+            if not self.dow_restricted:
+                return False
+        weekday = (first_weekday + day) % 7  # Sunday == 0
+        if weekday in self.dow_values:
+            return True
+        if weekday in self.dow_last and day + 7 > last:
+            return True
+        return (weekday, (day - 1) // 7 + 1) in self.dow_nth
 
 
