+def _split_fields(text):
+    """Split text on unquoted SEP. Each field is a list of (char, quoted) pairs with
+    the QUOTE characters removed; a doubled QUOTE inside quotes gives one QUOTE."""
+    fields, field, quoted = [], [], False
+    i = 0
+    while i < len(text):
+        ch = text[i]
+        if quoted:
+            if ch == QUOTE:
+                if text[i + 1:i + 2] == QUOTE:
+                    field.append((QUOTE, True))
+                    i += 2
+                    continue
+                quoted = False
+            else:
+                field.append((ch, True))
+        elif ch == QUOTE:
+            quoted = True
+        elif ch == SEP:
+            fields.append(field)
+            field = []
+        else:
+            field.append((ch, False))
+        i += 1
+    if quoted:
+        raise ValueError(f"unclosed quote in {text!r}")
+    fields.append(field)
+    return fields
+
+
+def _strip(chars):
+    """Text of a list of (char, quoted) pairs, minus unquoted whitespace at both ends."""
+    start, end = 0, len(chars)
+    while start < end and not chars[start][1] and chars[start][0].isspace():
+        start += 1
+    while end > start and not chars[end - 1][1] and chars[end - 1][0].isspace():
+        end -= 1
+    return "".join(ch for ch, _ in chars[start:end])
+
+
+def _plain(chars):
+    return "".join(ch for ch, _ in chars)
