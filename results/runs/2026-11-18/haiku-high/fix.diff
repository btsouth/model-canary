 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import functools
+import re
+from bisect import bisect_left
+from collections import namedtuple
+from datetime import date, datetime, time, timedelta
+
+# next_run looks at most this far past its starting point.
+_HORIZON = timedelta(days=20 * 365)
+
+_MONTH_NAMES = {"JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+                "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12}
+_DAY_NAMES = {"SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6}
+
+# field kind -> (lowest value, highest value, names allowed in the field)
+_RANGES = {
+    "minute": (0, 59, {}),
+    "hour": (0, 23, {}),
+    "dom": (1, 31, {}),
+    "month": (1, 12, _MONTH_NAMES),
+    "dow": (0, 7, _DAY_NAMES),
+}
+_KINDS = ("minute", "hour", "dom", "month", "dow")
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)[Ll]")      # NL, e.g. 5L: last Friday
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")  # N#K, e.g. 1#2: second Monday
+
+# values: plain numbers the field allows; specials: the L-style items;
+# restricted: False only when the whole field is '*' or '?'.
+_Field = namedtuple("_Field", "values specials restricted")
+# times: the run times of the day as minute-of-day numbers, sorted.
+_Schedule = namedtuple("_Schedule", "minutes hours dom months dow times")
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _schedule(expr)
+    return (when.minute in s.minutes and when.hour in s.hours
+            and when.month in s.months and _day_ok(s, when.date()))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    s = _schedule(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _HORIZON
+    except OverflowError:
+        limit = None
+    first = start.date().toordinal()
+    last = min(limit.date().toordinal() if limit is not None else date.max.toordinal(),
+               date.max.toordinal())
+    start_minute = start.hour * 60 + start.minute
+    for ordinal in range(first, last + 1):
+        day = date.fromordinal(ordinal)
+        if day.month not in s.months or not _day_ok(s, day):
+            continue
+        threshold = start_minute if ordinal == first else 0
+        i = bisect_left(s.times, threshold)
+        if i < len(s.times):
+            run = datetime.combine(day, time(*divmod(s.times[i], 60)), tzinfo=after.tzinfo)
+            if limit is not None and run > limit:
+                return None
+            return run
+    return None
+
+
+def _schedule(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"schedule must be a string: {expr!r}")
+    return _compile(expr)
+
+
+@functools.lru_cache(maxsize=256)
+def _compile(expr):
+    """Parse a whole expression, raising ValueError if any part of it is bad."""
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom, month, dow = (_parse_field(f, kind) for f, kind in zip(fields, _KINDS))
+    times = sorted(h * 60 + m for h in hour.values for m in minute.values)
+    return _Schedule(minute.values, hour.values, dom, month.values, dow, times)
+
+
+def _parse_field(text, kind):
+    restricted = text not in ("*", "?")
+    if text == "?" and kind in ("dom", "dow"):
+        text = "*"
+    values, specials = set(), set()
+    for item in text.split(","):
+        item_values, item_specials = _parse_item(item, kind)
+        values.update(item_values)
+        specials.update(item_specials)
+    if kind == "dow":
+        values = {v % 7 for v in values}  # 7 is Sunday too
+    return _Field(frozenset(values), frozenset(specials), restricted)
+
+
+def _parse_item(item, kind):
+    """Return (ordered list of plain values, set of special tuples) for one item."""
+    lo, hi, _ = _RANGES[kind]
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+
+    if kind == "dom" and base.upper() == "L":
+        if slash:
+            raise ValueError(f"L cannot have a step: {item!r}")
+        return [], {("L",)}
+    if kind == "dow":
+        match = _LAST_WEEKDAY.fullmatch(base)
+        if match:
+            if slash:
+                raise ValueError(f"NL cannot have a step: {item!r}")
+            return [], {("last", _number(match.group(1), 0, 7) % 7)}
+        match = _NTH_WEEKDAY.fullmatch(base)
+        if match:
+            if slash:
+                raise ValueError(f"N#K cannot have a step: {item!r}")
+            weekday = _number(match.group(1), 0, 7) % 7
+            return [], {("nth", weekday, _number(match.group(2), 1, 5))}
+
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    else:
+        start_text, dash, end_text = base.partition("-")
+        first = _value(start_text, kind)
+        if not dash:
+            values = list(range(first, hi + 1)) if step else [first]
+        else:
+            last = _value(end_text, kind)
+            if first <= last:
+                values = list(range(first, last + 1))
+            elif kind == "dow":
+                # Wraps through 0 to 6; 7 counts as 0 so it is not visited again.
+                values = list(range(first, 7)) + list(range(0, last + 1))
+            else:
+                values = list(range(first, hi + 1)) + list(range(lo, last + 1))
+    if step:
+        values = values[::step]
+    return values, set()
+
+
+def _value(text, kind):
+    """A number, or a month/day name in the fields that allow names."""
+    lo, hi, names = _RANGES[kind]
+    if names and text.upper() in names:
+        return names[text.upper()]
+    return _number(text, lo, hi)
+
+
+def _number(text, lo, hi):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"not a number: {text!r}")
+    value = int(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"{value} is outside {lo}-{hi}")
+    return value
+
+
+def _day_ok(s, day):
+    dom_ok = _dom_ok(s.dom, day)
+    dow_ok = _dow_ok(s.dow, day)
+    if s.dom.restricted and s.dow.restricted:
+        return dom_ok or dow_ok
+    return dom_ok and dow_ok
+
+
+def _dom_ok(field, day):
+    if day.day in field.values:
+        return True
+    return ("L",) in field.specials and day.day == calendar.monthrange(day.year, day.month)[1]
+
+
+def _dow_ok(field, day):
+    weekday = (day.weekday() + 1) % 7  # Python: Monday is 0; cron: Sunday is 0
+    if weekday in field.values:
+        return True
+    if ("last", weekday) in field.specials:
+        if day.day + 7 > calendar.monthrange(day.year, day.month)[1]:
+            return True
+    return ("nth", weekday, (day.day - 1) // 7 + 1) in field.specials
