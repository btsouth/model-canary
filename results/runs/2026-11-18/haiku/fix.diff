+def _split_fields(text):
+    """Split at SEP characters that are not inside quotes; check quotes close."""
+    fields, cur, quoted, i = [], [], False, 0
+    while i < len(text):
+        ch = text[i]
+        if ch == QUOTE and text[i + 1:i + 2] == QUOTE:
+            cur.append(QUOTE + QUOTE)  # a doubled quote is a literal quote
+            i += 2
+            continue
+        if ch == QUOTE:
+            quoted = not quoted
+        elif ch == SEP and not quoted:
+            fields.append("".join(cur))
+            cur = []
+            i += 1
+            continue
+        cur.append(ch)
+        i += 1
+    if quoted:
+        raise ValueError(f"unclosed quote in {text!r}")
+    fields.append("".join(cur))
+    return fields
