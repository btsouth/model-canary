 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from collections import namedtuple
+from datetime import datetime, timedelta
+from functools import lru_cache
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)[Ll]")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+# (name, minimum, maximum, names allowed)
+_FIELD_SPECS = {
+    "minute": (0, 59, None),
+    "hour": (0, 23, None),
+    "dom": (1, 31, None),
+    "month": (1, 12, _MONTHS),
+    "dow": (0, 7, _DAYS),
+}
+
+Schedule = namedtuple(
+    "Schedule",
+    "minute hour month dom dom_restricted dom_last "
+    "dow dow_restricted dow_last dow_nth",
+)
+
+
+def _number(text, lo, hi):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"not a number: {text!r}")
+    v = int(text)
+    if not lo <= v <= hi:
+        raise ValueError(f"{v} is outside {lo}-{hi}")
+    return v
+
+
+def _value(text, lo, hi, names):
+    """A single number, or a name where names are allowed."""
+    if names is not None and _NAME.fullmatch(text):
+        if text.upper() not in names:
+            raise ValueError(f"unknown name: {text!r}")
+        return names[text.upper()]
+    return _number(text, lo, hi)
+
+
+def _sequence(name, a, b, lo, hi):
+    """Values of the range a-b in the order the item lists them."""
+    if name == "dow":
+        # Wrapping counts through 0 to 6, with 7 treated as 0 (Sunday).
+        if a > b:
+            return list(range(a, 7)) + list(range(0, b + 1))
+        return list(range(a, b + 1))
+    if a > b:
+        return list(range(a, hi + 1)) + list(range(lo, b + 1))
+    return list(range(a, b + 1))
+
+
+def _item(item, name, lo, hi, names):
+    """Parse one comma-separated item.
+
+    Returns ("values", [ints in order]) or an extra: ("L",), ("last", n) or
+    ("nth", n, k).
+    """
+    if name == "dom" and item.upper() == "L":
+        return ("L",)
+    if name == "dow":
+        m = _LAST_WEEKDAY.fullmatch(item)
+        if m:
+            return ("last", _number(m.group(1), 0, 7) % 7)
+        m = _NTH_WEEKDAY.fullmatch(item)
+        if m:
+            k = _number(m.group(2), 1, 5)
+            return ("nth", _number(m.group(1), 0, 7) % 7, k)
+
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _DIGITS.fullmatch(step_text):
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step must be at least 1: {item!r}")
+
+    if base == "*":
+        seq = list(range(lo, hi + 1))
+    elif "-" in base:
+        parts = base.split("-")
+        if len(parts) != 2:
+            raise ValueError(f"bad range: {item!r}")
+        a = _value(parts[0], lo, hi, names)
+        b = _value(parts[1], lo, hi, names)
+        seq = _sequence(name, a, b, lo, hi)
+    else:
+        a = _value(base, lo, hi, names)
+        if step is None:
+            return ("values", [a])
+        seq = list(range(a, hi + 1))  # N/S lists N up to the field's maximum
+
+    if step is not None:
+        seq = seq[::step]
+    return ("values", seq)
+
+
+def _field(text, name):
+    """Parse one field. Returns (restricted, values set, extras list)."""
+    lo, hi, names = _FIELD_SPECS[name]
+    is_day = name in ("dom", "dow")
+    if is_day and text in ("*", "?"):
+        return False, set(range(lo, hi + 1)) if name == "dom" else set(range(7)), []
+    if text == "?":
+        raise ValueError("'?' is only allowed in the day fields")
+
+    values, extras = set(), []
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {name} field {text!r}")
+        kind = _item(item, name, lo, hi, names)
+        if kind[0] == "values":
+            if name == "dow":
+                values.update(v % 7 for v in kind[1])
+            else:
+                values.update(kind[1])
+        else:
+            extras.append(kind)
+    return True, values, extras
+
+
+@lru_cache(maxsize=256)
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields)}: {expr!r}")
+
+    minute_r, minute, _ = _field(fields[0], "minute")
+    hour_r, hour, _ = _field(fields[1], "hour")
+    dom_r, dom, dom_extras = _field(fields[2], "dom")
+    month_r, month, _ = _field(fields[3], "month")
+    dow_r, dow, dow_extras = _field(fields[4], "dow")
+
+    return Schedule(
+        minute=frozenset(minute),
+        hour=frozenset(hour),
+        month=frozenset(month),
+        dom=frozenset(dom),
+        dom_restricted=dom_r,
+        dom_last=any(e[0] == "L" for e in dom_extras),
+        dow=frozenset(dow),
+        dow_restricted=dow_r,
+        dow_last=frozenset(e[1] for e in dow_extras if e[0] == "last"),
+        dow_nth=frozenset((e[1], e[2]) for e in dow_extras if e[0] == "nth"),
+    )
+
+
+def _day_allowed(s, day):
+    """Classic cron day rule for a date."""
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_hit = day.day in s.dom or (s.dom_last and day.day == last)
+    cron_dow = (day.weekday() + 1) % 7  # Sunday is 0
+    dow_hit = (
+        cron_dow in s.dow
+        or (cron_dow in s.dow_last and day.day + 7 > last)
+        or (cron_dow, (day.day - 1) // 7 + 1) in s.dow_nth
+    )
+    if s.dom_restricted and s.dow_restricted:
+        return dom_hit or dow_hit
+    if s.dom_restricted:
+        return dom_hit
+    if s.dow_restricted:
+        return dow_hit
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _parse(expr)
+    return (
+        when.minute in s.minute
+        and when.hour in s.hour
+        and when.month in s.month
+        and _day_allowed(s, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
