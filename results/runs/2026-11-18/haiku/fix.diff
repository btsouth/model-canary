+def _tokens(raw):
+    """Return [(char, literal)] with quote delimiters removed.
+
+    literal is True for characters inside quotes (and for doubled quotes), which
+    must not be trimmed as whitespace.
+    """
+    out, quoted, i = [], False, 0
+    while i < len(raw):
+        ch = raw[i]
+        if ch == QUOTE and raw[i + 1:i + 2] == QUOTE:
+            out.append((QUOTE, True))
+            i += 2
+            continue
+        if ch == QUOTE:
+            quoted = not quoted
+        else:
+            out.append((ch, quoted))
+        i += 1
+    return out
+
+
+def _trim(tokens):
+    """Drop unquoted whitespace at both ends of decoded tokens."""
+    start, end = 0, len(tokens)
+    while start < end and not tokens[start][1] and tokens[start][0].isspace():
+        start += 1
+    while end > start and not tokens[end - 1][1] and tokens[end - 1][0].isspace():
+        end -= 1
+    return tokens[start:end]
+
+
+def _text(tokens):
+    return "".join(ch for ch, _ in tokens)
