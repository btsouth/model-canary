+def _find_equals(raw):
+    """Index of the first '=' outside quotes, or -1."""
+    quoted, i = False, 0
+    while i < len(raw):
+        ch = raw[i]
+        if ch == QUOTE and raw[i + 1:i + 2] == QUOTE:
+            i += 2
+            continue
+        if ch == QUOTE:
+            quoted = not quoted
+        elif ch == "=" and not quoted:
+            return i
+        i += 1
+    return -1
