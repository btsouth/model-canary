+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {calendar.day_abbr[(i - 1) % 7].upper(): i for i in range(7)}
+
+
+def _parse_field(raw, field):
+    """Return (values, special, unrestricted) for one cron field."""
+    if field in ("dom", "dow") and raw == "?":
+        raw = "*"
+        unrestricted = True
+    else:
+        unrestricted = raw == "*"
+
+    bounds = {"minute": (0, 59), "hour": (0, 23), "dom": (1, 31),
+              "month": (1, 12), "dow": (0, 7)}
+    lo, hi = bounds[field]
+    names = _MONTHS if field == "month" else _DAYS if field == "dow" else {}
+    special = []
+
+    def number(token, *, allow_name=True):
+        upper = token.upper()
+        if upper in names and allow_name:
+            return names[upper]
+        if not token.isdigit():
+            raise ValueError("invalid schedule value")
+        value = int(token)
+        if not lo <= value <= hi:
+            raise ValueError("schedule value out of range")
+        return value
+
+    values = set()
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if field == "dom" and item == "L":
+            special.append(("last",))
+            continue
+        if field == "dow":
+            m = re.fullmatch(r"(\d+)L", item, re.IGNORECASE)
+            if m:
+                n = number(m.group(1), allow_name=False)
+                special.append(("last_weekday", n % 7))
+                continue
+            m = re.fullmatch(r"(\d+)#([1-5])", item, re.IGNORECASE)
+            if m:
+                n = number(m.group(1), allow_name=False)
+                special.append(("nth_weekday", n % 7, int(m.group(2))))
+                continue
+
+        if item.count("/") > 1:
+            raise ValueError("invalid step")
+        base, step_text = item.split("/", 1) if "/" in item else (item, None)
+        step = 1
+        if step_text is not None:
+            if not step_text.isdigit() or int(step_text) < 1:
+                raise ValueError("invalid step")
+            if any(ch.isalpha() for ch in base):
+                raise ValueError("names cannot be used with a step")
+            step = int(step_text)
+        if base == "*":
+            listed = list(range(lo, hi + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("invalid range")
+            left, right = base.split("-")
+            a, b = number(left), number(right)
+            if field == "dow":
+                a %= 7
+                b %= 7
+                if a <= b:
+                    listed = list(range(a, b + 1))
+                else:
+                    listed = list(range(a, 7)) + list(range(0, b + 1))
+            elif a <= b:
+                listed = list(range(a, b + 1))
+            else:
+                listed = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            n = number(base)
+            listed = list(range(n, hi + 1)) if step_text is not None else [n]
+        for n in listed[::step]:
+            values.add(n % 7 if field == "dow" else n)
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        try:
+            stripped = _SHORTCUTS[stripped.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    parsed = [_parse_field(raw, field) for raw, field in zip(fields,
+               ("minute", "hour", "dom", "month", "dow"))]
+    return parsed
+
+
+def _day_allowed(parsed, when):
+    dom, dow = parsed[2], parsed[4]
+    dom_values, dom_special, dom_any = dom
+    dow_values, dow_special, dow_any = dow
+    day = when.day
+    dom_match = day in dom_values or any(
+        kind == "last" and day == calendar.monthrange(when.year, when.month)[1]
+        for (kind, *_) in dom_special)
+    weekday = (when.weekday() + 1) % 7
+    dow_match = weekday in dow_values
+    last_day = calendar.monthrange(when.year, when.month)[1]
+    for rule in dow_special:
+        if rule[0] == "last_weekday" and weekday == rule[1] and day + 7 > last_day:
+            dow_match = True
+        elif rule[0] == "nth_weekday" and weekday == rule[1] and (day - 1) // 7 + 1 == rule[2]:
+            dow_match = True
+    if dom_any and dow_any:
+        return True
+    if dom_any:
+        return dow_match
+    if dow_any:
+        return dom_match
+    return dom_match or dow_match
+
 
