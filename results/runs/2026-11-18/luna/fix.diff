 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+_SHORT = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    raw = expr.strip()
+    raw = _SHORT.get(raw.lower(), raw)
+    fields = re.split(r"[ \t]+", raw) if raw else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    parsed = []
+    for fi, field in enumerate(fields):
+        lo, hi = _BOUNDS[fi]
+        if fi in (2, 4) and field == "?":
+            field = "*"
+        values, special = set(), set()
+        unrestricted = field == "*" or (fi in (2, 4) and fields[fi] == "?")
+        for item in field.split(','):
+            if not item:
+                raise ValueError("empty list item")
+            if fi == 2 and item == 'L':
+                special.add(('last',)); continue
+            if fi == 4:
+                m = re.fullmatch(r"(\d)L", item)
+                if m:
+                    n = int(m.group(1))
+                    if n > 7: raise ValueError("day out of range")
+                    special.add(('last_weekday', n % 7)); continue
+                m = re.fullmatch(r"(\d)#([1-5])", item)
+                if m:
+                    n = int(m.group(1))
+                    if n > 7: raise ValueError("day out of range")
+                    special.add(('nth_weekday', n % 7, int(m.group(2)))); continue
+            p = item.split('/')
+            if len(p) > 2 or (len(p) == 2 and (not p[1].isdigit() or int(p[1]) < 1)):
+                raise ValueError("invalid step")
+            step = int(p[1]) if len(p) == 2 else 1
+            base = p[0]
+            if base == '*': seq = list(range(lo, hi + 1))
+            else:
+                parts = base.split('-')
+                if len(parts) > 2: raise ValueError("invalid range")
+                def number(s):
+                    u = s.upper()
+                    if fi == 3 and u in _MONTHS: return _MONTHS[u]
+                    if fi == 4 and u in _DAYS: return _DAYS[u]
+                    if not s.isdigit(): raise ValueError("invalid value")
+                    x = int(s)
+                    if not lo <= x <= hi: raise ValueError("value out of range")
+                    return x
+                a = number(parts[0])
+                if len(parts) == 1:
+                    b = hi if len(p) == 2 else a
+                else: b = number(parts[1])
+                if a <= b: seq = list(range(a, b + 1))
+                elif fi == 4:
+                    seq=[]; x=a % 7
+                    while True:
+                        seq.append(x)
+                        if x == b % 7: break
+                        x=(x+1)%7
+                else: seq=list(range(a, hi+1))+list(range(lo,b+1))
+            seq = seq[::step]
+            values.update((x % 7 if fi == 4 else x) for x in seq)
+        parsed.append((values, special, unrestricted))
+    return parsed
+
+
+def _day_ok(parsed, date):
+    dom, dow = parsed[2], parsed[4]
+    dom_ok = date.day in dom[0] or ('last',) in dom[1] and date.day == calendar.monthrange(date.year,date.month)[1]
+    cron_dow = (date.weekday() + 1) % 7
+    dow_ok = cron_dow in dow[0]
+    for kind, *args in dow[1]:
+        if kind == 'last_weekday':
+            n=args[0]; dow_ok |= cron_dow == n and date.day + 7 > calendar.monthrange(date.year,date.month)[1]
+        else:
+            n,k=args; dow_ok |= cron_dow == n and (date.day-1)//7+1 == k
+    if dom[2]: return dow_ok
+    if dow[2]: return dom_ok
+    return dom_ok or dow_ok
 
 
