 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_DOM, _DOW = 2, 4
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+def _value(text, low, high, names):
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range")
+    return value
+
+
+def _number(text, low, high):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"number {text!r} out of range")
+    return value
+
+
+class _Field:
+    def __init__(self):
+        self.values = set()
+        self.last = False      # day of month: L
+        self.last_dow = set()  # day of week: NL
+        self.nth = set()       # day of week: (N, K)
+        self.restricted = True
+
+
+def _parse_field(text, index):
+    low, high, names = _FIELDS[index]
+    field = _Field()
+    if text in ("*", "?"):
+        if text == "?" and index not in (_DOM, _DOW):
+            raise ValueError("'?' only allowed in day fields")
+        field.restricted = False
+        field.values = set(range(low, high + 1))
+        if index == _DOW:
+            field.values = set(range(7))
+        return field
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == _DOM and item == "L":
+            field.last = True
+            continue
+        if index == _DOW and item.endswith("L") and _NUM.fullmatch(item[:-1]):
+            field.last_dow.add(_number(item[:-1], 0, 7) % 7)
+            continue
+        if index == _DOW and "#" in item:
+            n, _, k = item.partition("#")
+            field.nth.add((_number(n, 0, 7) % 7, _number(k, 1, 5)))
+            continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not _NUM.fullmatch(step_text):
+                raise ValueError(f"bad step {step_text!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError("step must be at least 1")
+        if base == "*":
+            listed = list(range(low, high + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a = _value(a_text, low, high, names)
+            b = _value(b_text, low, high, names)
+            if a <= b:
+                listed = list(range(a, b + 1))
+            elif index == _DOW:
+                a, b = a % 7, b % 7
+                listed = [a]
+                while listed[-1] != b:
+                    listed.append((listed[-1] + 1) % 7)
+            else:
+                listed = list(range(a, high + 1)) + list(range(low, b + 1))
+        else:
+            a = _value(base, low, high, names)
+            listed = list(range(a, high + 1)) if slash else [a]
+        chosen = listed[::step]
+        if index == _DOW:
+            chosen = [v % 7 for v in chosen]
+        field.values.update(chosen)
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5 or not all(parts):
+        raise ValueError(f"expected five fields in {expr!r}")
+    return [_parse_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_ok(fields, date):
+    dom, month, dow = fields[_DOM], fields[3], fields[_DOW]
+    if date.month not in month.values:
+        return False
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+
+    def dom_match():
+        return date.day in dom.values or (dom.last and date.day == days_in_month)
+
+    def dow_match():
+        return (weekday in dow.values
+                or (weekday in dow.last_dow and date.day + 7 > days_in_month)
+                or (weekday, (date.day - 1) // 7 + 1) in dow.nth)
+
+    if dom.restricted and dow.restricted:
+        return dom_match() or dow_match()
+    if dom.restricted:
+        return dom_match()
+    if dow.restricted:
+        return dow_match()
+    return True
 
 
