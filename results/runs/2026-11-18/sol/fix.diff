 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from bisect import bisect_left
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_NAMES = {
+    3: dict(zip(('JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN',
+                 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'), range(1, 13))),
+    4: dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7))),
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError(f'expected decimal digits: {text!r}')
+    return int(text)
+
+
+def _value(text, index):
+    value = _NAMES.get(index, {}).get(text.upper())
+    if value is None:
+        value = _number(text)
+    low, high = _BOUNDS[index]
+    if not low <= value <= high:
+        raise ValueError(f'value outside field range: {text!r}')
+    return value
+
+
+def _field(text, index):
+    values, specials = set(), []
+    if text == '?' and index in (2, 4):
+        text = '*'
+    low, high = _BOUNDS[index]
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            specials.append(('last',))
+            continue
+        if index == 4:
+            last = re.fullmatch(r'([0-9]+)L', item)
+            nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item)
+            if last:
+                specials.append(('last', _value(last[1], index) % 7))
+                continue
+            if nth:
+                occurrence = _number(nth[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError('weekday occurrence must be from 1 to 5')
+                specials.append(('nth', _value(nth[1], index) % 7, occurrence))
+                continue
+        parts = item.split('/')
+        if len(parts) > 2:
+            raise ValueError(f'bad step: {item!r}')
+        base = parts[0]
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            ends = base.split('-')
+            if len(ends) != 2:
+                raise ValueError(f'bad range: {base!r}')
+            start, end = (_value(part, index) for part in ends)
+            range_high = high
+            if index == 4 and start > end:
+                start, end = start % 7, end % 7
+                range_high = 6
+            sequence = (list(range(start, end + 1)) if start <= end else
+                        list(range(start, range_high + 1)) + list(range(low, end + 1)))
+        else:
+            start = _value(base, index)
+            sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+        values.update(value % 7 if index == 4 else value for value in sequence[::step])
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('a schedule must contain five fields')
+    parsed = [_field(field, index) for index, field in enumerate(fields)]
+    return parsed, fields[2] in ('*', '?'), fields[4] in ('*', '?')
+
+
+def _day_allowed(parsed, dom_free, dow_free, day):
+    dom, dom_specials = parsed[2]
+    dow, dow_specials = parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    month_end = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom or bool(dom_specials and day.day == month_end)
+    dow_match = weekday in dow or any(
+        weekday == special[1] and
+        (day.day + 7 > month_end if special[0] == 'last'
+         else (day.day - 1) // 7 + 1 == special[2])
+        for special in dow_specials)
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_match
+    if dow_free:
+        return dom_match
+    return dom_match or dow_match
+
 
