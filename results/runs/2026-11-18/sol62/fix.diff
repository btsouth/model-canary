 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, datetime
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_DECIMAL = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+_UNRESTRICTED = {"*", "?"}
+
+
+def _decimal(token):
+    if not _DECIMAL.fullmatch(token):
+        raise ValueError(f"invalid schedule number: {token!r}")
+    digits = token.lstrip("0")
+    # Values above 99 are out of range as endpoints and all act alike as steps.
+    return 100 if len(digits) > 2 else int(digits or "0")
+
+
+def _value(token, minimum, maximum, names=None):
+    if names is not None and token.isascii():
+        named_value = names.get(token.upper())
+        if named_value is not None:
+            return named_value
+    value = _decimal(token)
+    if not minimum <= value <= maximum:
+        raise ValueError(f"schedule value out of range: {token!r}")
+    return value
+
+
+def _item_values(item, minimum, maximum, names=None, *, sunday_alias=False):
+    base, slash, step_token = item.partition("/")
+    step = _decimal(step_token) if slash else 1
+    if not step:
+        raise ValueError("schedule step must be positive")
+
+    if base == "*":
+        values = range(minimum, maximum + 1)
+    else:
+        start_token, dash, end_token = base.partition("-")
+        start = _value(start_token, minimum, maximum, names)
+        if dash:
+            end = _value(end_token, minimum, maximum, names)
+            if sunday_alias and start == 7:
+                start = 0
+            if start <= end:
+                values = range(start, end + 1)
+            else:
+                wrap_end = 6 if sunday_alias else maximum
+                values = list(range(start, wrap_end + 1)) + list(range(minimum, end + 1))
+        else:
+            values = range(start, (maximum if slash else start) + 1)
+    return values[::step]
+
+
+def _field_values(field, minimum, maximum, names=None):
+    values = set()
+    for item in field.split(","):
+        values.update(_item_values(item, minimum, maximum, names))
+    return values
+
+
+@dataclass
+class _Schedule:
+    minutes: set[int]
+    hours: set[int]
+    months: set[int]
+    month_days: set[int] | None
+    last_day: bool
+    weekdays: set[int] | None
+    last_weekdays: set[int]
+    nth_weekdays: set[tuple[int, int]]
+
+    def allows_day(self, day):
+        if day.month not in self.months:
+            return False
+        if self.month_days is None and self.weekdays is None:
+            return True
+        if self.month_days is not None and day.day in self.month_days:
+            return True
+        if self.last_day and day.day == monthrange(day.year, day.month)[1]:
+            return True
+        if self.weekdays is None:
+            return False
+
+        weekday = (day.weekday() + 1) % 7
+        occurrence = (day.day - 1) // 7 + 1
+        return (
+            weekday in self.weekdays
+            or (weekday, occurrence) in self.nth_weekdays
+            or (weekday in self.last_weekdays and day.day + 7 > monthrange(day.year, day.month)[1])
+        )
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    expr = expr.strip()
+    parts = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    if len(parts) != 5:
+        raise ValueError("schedule expression must have five fields or be a shortcut")
+    minute, hour, month_day, month, weekday = parts
+    minutes = _field_values(minute, 0, 59)
+    hours = _field_values(hour, 0, 23)
+    months = _field_values(month, 1, 12, _MONTHS)
+
+    month_days = None
+    last_day = False
+    if month_day not in _UNRESTRICTED:
+        month_days = set()
+        for item in month_day.split(","):
+            if item == "L":
+                last_day = True
+            else:
+                month_days.update(_item_values(item, 1, 31))
+
+    weekdays = None
+    last_weekdays = set()
+    nth_weekdays = set()
+    if weekday not in _UNRESTRICTED:
+        weekdays = set()
+        for item in weekday.split(","):
+            last = _LAST_WEEKDAY.fullmatch(item)
+            nth = _NTH_WEEKDAY.fullmatch(item)
+            if last:
+                last_weekdays.add(_value(last[1], 0, 7) % 7)
+            elif nth:
+                nth_weekdays.add((_value(nth[1], 0, 7) % 7, _value(nth[2], 1, 5)))
+            else:
+                values = _item_values(item, 0, 7, _WEEKDAYS, sunday_alias=True)
+                weekdays.update(value % 7 for value in values)
+
+    return _Schedule(minutes, hours, months, month_days, last_day, weekdays, last_weekdays, nth_weekdays)
+
 
