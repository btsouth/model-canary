 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+import calendar
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+\Z")
+
+
+def _bad(msg):
+    raise ValueError(msg)
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.match(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        _bad(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        _bad(f"value out of range: {tok!r}")
+    return v
+
+
+def _parse_field(text, kind):
+    lo, hi, names = {
+        "min": (0, 59, None), "hour": (0, 23, None), "dom": (1, 31, None),
+        "mon": (1, 12, _MONTHS), "dow": (0, 7, _DAYS),
+    }[kind]
+    values, last, nth_last, nth = set(), False, set(), set()
+    for item in text.split(","):
+        if not item:
+            _bad("empty item")
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.match(step) or int(step) < 1:
+                _bad(f"bad step {step!r}")
+            step = int(step)
+        else:
+            step = 1
+        if not base:
+            _bad("empty item")
+        special = None
+        if kind == "dom" and base.upper() == "L":
+            special = "L"
+        elif kind == "dow" and re.match(r"[0-9]+[lL]\Z", base):
+            special = ("last", _value(base[:-1], 0, 7, None) % 7)
+        elif kind == "dow" and "#" in base:
+            a, _, b = base.partition("#")
+            if not (_NUM.match(a) and _NUM.match(b)):
+                _bad("bad N#K")
+            if not 1 <= int(b) <= 5:
+                _bad("K out of range")
+            special = ("nth", _value(a, 0, 7, None) % 7, int(b))
+        if special is not None:
+            if special == "L":
+                last = True
+            elif special[0] == "last":
+                nth_last.add(special[1])
+            else:
+                nth.add(special[1:])
+            continue
+        if base == "*" or (base == "?" and False):
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif kind == "dow":
+                seq = ([7] if a == 7 else list(range(a, 7))) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            seq = list(range(a, hi + 1)) if sep else [a]
+        values.update(seq[::step])
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, last, nth_last, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        _bad("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORTCUTS.get(expr.lower()) or _bad(f"unknown shortcut {expr!r}")
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        _bad("expected five fields")
+    dom_free = parts[2] in ("*", "?")
+    dow_free = parts[4] in ("*", "?")
+    parts = [("*" if p == "?" and i in (2, 4) else p) for i, p in enumerate(parts)]
+    mins = _parse_field(parts[0], "min")[0]
+    hours = _parse_field(parts[1], "hour")[0]
+    dom = _parse_field(parts[2], "dom")
+    months = _parse_field(parts[3], "mon")[0]
+    dow = _parse_field(parts[4], "dow")
+    return mins, hours, dom, months, dow, dom_free, dow_free
+
+
+def _day_ok(p, y, m, d):
+    _, _, (dom, last, _, _), _, (dow, _, nth_last, nth), dom_free, dow_free = p
+    wd = (datetime(y, m, d).weekday() + 1) % 7
+    ndays = calendar.monthrange(y, m)[1]
+    dom_m = d in dom or (last and d == ndays)
+    dow_m = (wd in dow or (wd in nth_last and d + 7 > ndays)
+             or (wd, (d - 1) // 7 + 1) in nth)
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_m
+    if dow_free:
+        return dom_m
+    return dom_m or dow_m
 
 
