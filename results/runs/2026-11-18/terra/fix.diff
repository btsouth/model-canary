 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7)))
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))[index]
+        unrestricted = field in ('*', '?')
+        if field == '?':
+            if index not in (2, 4):
+                raise ValueError('invalid question mark')
+            field = '*'
+        values, specials = set(), []
+        def number(s):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if s.upper() in names:
+                return names[s.upper()]
+            if not re.fullmatch(r'[0-9]+', s):
+                raise ValueError('invalid value')
+            n = int(s)
+            if not low <= n <= high:
+                raise ValueError('out of range')
+            return n
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                specials.append(('last',))
+                continue
+            special = re.fullmatch(r'([0-7])(L|#([1-5]))', item) if index == 4 else None
+            if special:
+                specials.append(('weekday', int(special[1]) % 7, special[2], int(special[3]) if special[3] else None))
+                continue
+            parts = item.split('/')
+            if len(parts) > 2 or not parts[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(parts) == 2:
+                if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(parts[1])
+            base = parts[0]
+            if base == '*':
+                seq = list(range(low, high + 1))
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                a, b = map(number, ends)
+                if index == 4:
+                    if a == 0 and b == 7:
+                        seq = list(range(7))
+                    else:
+                        a, b = a % 7, b % 7
+                        seq = list(range(a, b + 1)) if a <= b else list(range(a, 7)) + list(range(0, b + 1))
+                else:
+                    seq = list(range(a, b + 1)) if a <= b else list(range(a, high + 1)) + list(range(low, b + 1))
+            else:
+                a = number(base)
+                seq = list(range(a, high + 1)) if len(parts) == 2 else [a]
+            values.update(n % 7 if index == 4 else n for n in seq[::step])
+        parsed.append((values, specials, unrestricted))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    dom, dow = parsed[2], parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dm = date.day in dom[0] or (bool(dom[1]) and date.day == last)
+    dw = weekday in dow[0] or any(weekday == s[1] and
+        (date.day + 7 > last if s[2] == 'L' else (date.day - 1) // 7 + 1 == s[3])
+        for s in dow[1])
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dw
+    if dow[2]:
+        return dm
+    return dm or dw
+
 
