 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+_NAMES = {
+    3: dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13))),
+    4: dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7))),
+}
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    values, specials = set(), []
+
+    def value(token):
+        n = _NAMES.get(index, {}).get(token)
+        if n is None:
+            n = _number(token)
+        if not low <= n <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return n
+
+    unrestricted = text in ("*", "?")
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if index == 4 and (last or nth):
+            match = last or nth
+            weekday = value(match[1]) % 7
+            if last:
+                specials.append(("last_weekday", weekday))
+            else:
+                occurrence = _number(match[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence must be 1 to 5")
+                specials.append(("nth_weekday", weekday, occurrence))
+            continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError("too many steps")
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = parts[0]
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError("invalid range")
+            start, end = map(value, endpoints)
+        else:
+            start = value(base)
+            end = high if len(parts) == 2 else start
+        if start > end:
+            raise ValueError("descending range")
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {n % 7 for n in values}
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(part, index) for index, part in enumerate(parts)]
+
+
+def _day_matches(fields, day):
+    dom, dom_specials, dom_any = fields[2]
+    dow, dow_specials, dow_any = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom or bool(dom_specials and day.day == last_day)
+    dow_match = weekday in dow
+    for special in dow_specials:
+        if weekday == special[1]:
+            if special[0] == "last_weekday":
+                dow_match |= day.day + 7 > last_day
+            else:
+                dow_match |= (day.day - 1) // 7 + 1 == special[2]
+    if dom_any and dow_any:
+        return True
+    if dom_any:
+        return dow_match
+    if dow_any:
+        return dom_match
+    return dom_match or dow_match
+
 
