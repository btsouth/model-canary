 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import date, datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+
+
+def _number(token):
+    if not token.isascii() or not token.isdecimal():
+        raise ValueError(f"expected decimal digits: {token!r}")
+    # Three significant digits already exceed every field's span. Larger
+    # steps have the same effect, and larger field values are invalid.
+    return int((token.lstrip("0") or "0")[:3])
+
+
+def _value(token, low, high, names):
+    if token.isascii() and token.upper() in names:
+        return names[token.upper()]
+    value = _number(token)
+    if not low <= value <= high:
+        raise ValueError(f"value outside field range: {token!r}")
+    return value
+
+
+def _expand(item, low, high, names):
+    base, stepped, step_text = item.partition("/")
+    step = _number(step_text) if stepped else 1
+    if step == 0:
+        raise ValueError("zero step")
+    if base == "*":
+        start, end = low, high
+    else:
+        first, ranged, last = base.partition("-")
+        start = _value(first, low, high, names)
+        end = high if stepped else start
+        if ranged:
+            end = _value(last, low, high, names)
+        if start > end:
+            raise ValueError("descending range")
+    return range(start, end + 1, step)
+
+
+def _field(field, low, high, names=None):
+    values = set()
+    for item in field.split(","):
+        values.update(_expand(item, low, high, names or {}))
+    return sorted(values)
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("expected a schedule string")
+        expr = expr.strip()
+        expr = _SHORTCUTS.get(expr.lower(), expr)
+        minute, hour, dom, month, dow = re.split(r"[ \t]+", expr)
+        self.minutes = _field(minute, 0, 59)
+        self.hours = _field(hour, 0, 23)
+        self.months = _field(month, 1, 12, _MONTHS)
+        self.dom_restricted = dom not in ("*", "?")
+        self.dow_restricted = dow not in ("*", "?")
+        self.month_days = set()
+        self.last_day = False
+        for item in dom.split(","):
+            if item == "L":
+                self.last_day = True
+            else:
+                self.month_days.update(_expand("*" if dom == "?" else item, 1, 31, {}))
+
+        self.weekdays = set()
+        self.last_weekdays = set()
+        self.nth_weekdays = set()
+        for item in dow.split(","):
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if special:
+                weekday = _value(special[1], 0, 7, {}) % 7
+                if special[2] == "L":
+                    self.last_weekdays.add(weekday)
+                else:
+                    self.nth_weekdays.add((weekday, _value(special[3], 1, 5, {})))
+            else:
+                values = _expand("*" if dow == "?" else item, 0, 7, _WEEKDAYS)
+                self.weekdays.update(value % 7 for value in values)
+
+    def allows_day(self, day, weekday, length):
+        dom = day in self.month_days or (self.last_day and day == length)
+        dow = (weekday in self.weekdays
+               or (weekday in self.last_weekdays and day + 7 > length)
+               or (weekday, (day - 1) // 7 + 1) in self.nth_weekdays)
+        if self.dom_restricted and self.dow_restricted:
+            return dom or dow
+        return dom and dow
 
 
