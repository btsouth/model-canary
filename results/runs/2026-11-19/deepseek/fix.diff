 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, time, timedelta
+from functools import lru_cache
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
+        1,
+    )
+}
+
+_DOW_NAMES = {
+    name: number
+    for number, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))
+}
+
+
+def _is_number(text):
+    return re.fullmatch(r"[0-9]+", text) is not None
+
+
+def _value(text, low, high, names):
+    if _is_number(text):
+        number = int(text)
+        if low <= number <= high:
+            return number
+        raise ValueError(f"value out of range: {text!r}")
+    if names is not None:
+        number = names.get(text.upper())
+        if number is not None:
+            return number
+    raise ValueError(f"bad value: {text!r}")
+
+
+def _step_base(base, low, high, step):
+    """Values selected by an item with a /S suffix (names are not allowed here)."""
+    if base == "*":
+        start, end = low, high
+    elif "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range: {base!r}")
+        first, last = base.split("-")
+        if not _is_number(first) or not _is_number(last):
+            raise ValueError(f"bad range: {base!r}")
+        start, end = int(first), int(last)
+        if not (low <= start <= high and low <= end <= high):
+            raise ValueError(f"range out of bounds: {base!r}")
+        if start > end:
+            raise ValueError(f"bad range: {base!r}")
+    else:
+        if not _is_number(base):
+            raise ValueError(f"bad stepped item: {base!r}")
+        start = int(base)
+        if not low <= start <= high:
+            raise ValueError(f"value out of range: {base!r}")
+        end = high
+    return list(range(start, end + 1, step))
+
+
+def _field(raw, low, high, names, day_kind):
+    """Parse one field into (values, last_day, last_weekday, nth_weekday)."""
+    if day_kind in ("dom", "dow") and raw == "?":
+        raw = "*"
+    values = set()
+    last_day = False
+    last_weekday = []
+    nth_weekday = []
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if item.count("/") > 1:
+            raise ValueError(f"bad step: {item!r}")
+        if "/" in item:
+            base, step_text = item.split("/")
+            if not _is_number(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+            values.update(_step_base(base, low, high, step))
+            continue
+        if day_kind == "dom" and item == "L":
+            last_day = True
+            continue
+        if day_kind == "dow":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                number = int(match.group(1))
+                if not 0 <= number <= 7:
+                    raise ValueError(f"bad last weekday: {item!r}")
+                last_weekday.append(number)
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                number = int(match.group(1))
+                nth = int(match.group(2))
+                if not 0 <= number <= 7 or not 1 <= nth <= 5:
+                    raise ValueError(f"bad nth weekday: {item!r}")
+                nth_weekday.append((number, nth))
+                continue
+        if item == "*":
+            values.update(range(low, high + 1))
+        elif "-" in item:
+            if item.count("-") != 1:
+                raise ValueError(f"bad range: {item!r}")
+            first, last = item.split("-")
+            start = _value(first, low, high, names)
+            end = _value(last, low, high, names)
+            if start > end:
+                raise ValueError(f"bad range: {item!r}")
+            values.update(range(start, end + 1))
+        else:
+            values.add(_value(item, low, high, names))
+    return values, last_day, last_weekday, nth_weekday
+
+
+@lru_cache(maxsize=None)
+def _parse(expr):
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty expression")
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+
+    minutes, _, _, _ = _field(fields[0], 0, 59, None, None)
+    hours, _, _, _ = _field(fields[1], 0, 23, None, None)
+    days, last_day, _, _ = _field(fields[2], 1, 31, None, "dom")
+    months, _, _, _ = _field(fields[3], 1, 12, _MONTH_NAMES, None)
+    weekdays, _, last_weekday, nth_weekday = _field(
+        fields[4], 0, 7, _DOW_NAMES, "dow"
+    )
+
+    weekdays = {day % 7 for day in weekdays}
+    last_weekday = [day % 7 for day in last_weekday]
+    nth_weekday = [(day % 7, nth) for day, nth in nth_weekday]
+
+    return {
+        "minutes": minutes,
+        "hours": hours,
+        "days": days,
+        "last_day": last_day,
+        "months": months,
+        "weekdays": weekdays,
+        "last_weekday": last_weekday,
+        "nth_weekday": nth_weekday,
+        "dom_restricted": fields[2] not in ("*", "?"),
+        "dow_restricted": fields[4] not in ("*", "?"),
+        "times": sorted(
+            hour * 60 + minute for hour in hours for minute in minutes
+        ),
+    }
+
+
+def _day_allowed(schedule, day):
+    dom_restricted = schedule["dom_restricted"]
+    dow_restricted = schedule["dow_restricted"]
+    if not dom_restricted and not dow_restricted:
+        return True
+
+    last_number = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in schedule["days"] or (
+        schedule["last_day"] and day.day == last_number
+    )
+
+    cron_weekday = (day.weekday() + 1) % 7
+    dow_match = cron_weekday in schedule["weekdays"]
+    if not dow_match and schedule["last_weekday"]:
+        first_weekday = calendar.monthrange(day.year, day.month)[0]
+        last_cron = (first_weekday + last_number) % 7
+        for target in schedule["last_weekday"]:
+            if day.day == last_number - ((last_cron - target) % 7):
+                dow_match = True
+                break
+    if not dow_match:
+        first_weekday = calendar.monthrange(day.year, day.month)[0]
+        first_cron = (first_weekday + 1) % 7
+        for target, nth in schedule["nth_weekday"]:
+            occurrence = 1 + ((target - first_cron) % 7) + (nth - 1) * 7
+            if occurrence == day.day:
+                dow_match = True
+                break
+
+    if dom_restricted and dow_restricted:
+        return dom_match or dow_match
+    if dom_restricted:
+        return dom_match
+    return dow_match
+
 
