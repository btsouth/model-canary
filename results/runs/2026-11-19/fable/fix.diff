 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (low, high, names) per field
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_LIMIT = dt.timedelta(days=20 * 365)
+
+
+def _number(text, expr):
+    if not text or not text.isdigit() or not text.isascii():
+        raise ValueError(f"bad number {text!r} in {expr!r}")
+    return int(text)
+
+
+def _value(text, low, high, names, expr):
+    """Parse a single value, allowing names when names is given."""
+    if names is not None:
+        name = text.upper()
+        if name in names:
+            return names.index(name) + low
+    value = _number(text, expr)
+    if value < low or value > high:
+        raise ValueError(f"value {text!r} out of range in {expr!r}")
+    return value
+
+
+def _parse_field(text, low, high, names, expr):
+    """Return a set of values listed by a plain field."""
+    values = set()
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {expr!r}")
+        step = None
+        if "/" in item:
+            base, _, step_text = item.partition("/")
+            step = _number(step_text, expr)
+            if step < 1:
+                raise ValueError(f"step of 0 in {expr!r}")
+        else:
+            base = item
+        if base == "*":
+            listed = range(low, high + 1)
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a = _value(a, low, high, names, expr)
+            b = _value(b, low, high, names, expr)
+            if a > b:
+                raise ValueError(f"range {base!r} out of order in {expr!r}")
+            listed = range(a, b + 1)
+        else:
+            value = _value(base, low, high, names, expr)
+            listed = range(value, high + 1) if step is not None else [value]
+        if step is not None:
+            listed = list(listed)[::step]
+        values.update(listed)
+    return values
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last", "dom_any",
+                 "dow", "dow_last", "dow_nth", "dow_any")
+
+    def __init__(self, expr):
+        original = expr
+        expr = expr.strip()
+        if expr.lower() in _SHORTCUTS:
+            expr = _SHORTCUTS[expr.lower()]
+        elif expr.startswith("@"):
+            raise ValueError(f"unknown shortcut {original!r}")
+        parts = expr.split()
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields in {original!r}")
+        minute, hour, dom, month, dow = parts
+        self.minutes = _parse_field(minute, 0, 59, None, original)
+        self.hours = _parse_field(hour, 0, 23, None, original)
+        self.months = _parse_field(month, 1, 12, _MONTHS, original)
+        self._parse_dom(dom, original)
+        self._parse_dow(dow, original)
+
+    def _parse_dom(self, text, expr):
+        self.dom_any = text in ("*", "?")
+        self.dom = set()
+        self.dom_last = False
+        if self.dom_any:
+            return
+        plain = []
+        for item in text.split(","):
+            if item.upper() == "L":
+                self.dom_last = True
+            else:
+                plain.append(item)
+        if plain:
+            self.dom = _parse_field(",".join(plain), 1, 31, None, expr)
+
+    def _parse_dow(self, text, expr):
+        self.dow_any = text in ("*", "?")
+        self.dow = set()
+        self.dow_last = set()
+        self.dow_nth = set()
+        if self.dow_any:
+            return
+        plain = []
+        for item in text.split(","):
+            if item == "":
+                raise ValueError(f"empty item in {expr!r}")
+            if item[-1].upper() == "L" and len(item) > 1:
+                n = _number(item[:-1], expr)
+                if n > 7:
+                    raise ValueError(f"value out of range in {expr!r}")
+                self.dow_last.add(n % 7)
+            elif "#" in item:
+                n, _, k = item.partition("#")
+                n = _number(n, expr)
+                k = _number(k, expr)
+                if n > 7 or k < 1 or k > 5:
+                    raise ValueError(f"bad item {item!r} in {expr!r}")
+                self.dow_nth.add((n % 7, k))
+            else:
+                plain.append(item)
+        if plain:
+            self.dow = {v % 7 for v in _parse_field(",".join(plain), 0, 7, _DAYS, expr)}
+
+    def day_allowed(self, date):
+        if self.dom_any and self.dow_any:
+            return True
+        dom_ok = self.dom_any or self._dom_match(date)
+        dow_ok = self.dow_any or self._dow_match(date)
+        if self.dom_any:
+            return dow_ok
+        if self.dow_any:
+            return dom_ok
+        return dom_ok or dow_ok
+
+    def _dom_match(self, date):
+        if date.day in self.dom:
+            return True
+        if self.dom_last:
+            return date.day == calendar.monthrange(date.year, date.month)[1]
+        return False
+
+    def _dow_match(self, date):
+        wd = (date.weekday() + 1) % 7
+        if wd in self.dow:
+            return True
+        if wd in self.dow_last:
+            if date.day + 7 > calendar.monthrange(date.year, date.month)[1]:
+                return True
+        if self.dow_nth and (wd, (date.day - 1) // 7 + 1) in self.dow_nth:
+            return True
+        return False
+
 
