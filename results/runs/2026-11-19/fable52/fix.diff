--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,182 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import date, datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {
+    name: i + 1
+    for i, name in enumerate(
+        "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split()
+    )
+}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = timedelta(days=20 * 365)
+
+
+def _value(text, low, high, names):
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _field(text, low, high, names=None):
+    """Return the set of values a plain field lists."""
+    values = set()
+    for item in text.split(","):
+        values.update(_item(item, low, high, names))
+    return values
+
+
+def _item(item, low, high, names):
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+    else:
+        step = 1
+    if base == "*":
+        first, last = low, high
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        first = _value(a, low, high, names)
+        last = _value(b, low, high, names)
+        if first > last:
+            raise ValueError(f"bad range: {item!r}")
+    else:
+        first = _value(base, low, high, names)
+        last = high if slash else first
+    return range(first, last + 1, step)
+
+
+class _Schedule:
+    def __init__(self, expr):
+        text = expr.strip()
+        if text.startswith("@"):
+            try:
+                text = _SHORTCUTS[text.lower()]
+            except KeyError:
+                raise ValueError(f"unknown shortcut: {expr!r}") from None
+        parts = re.split(r"[ \t]+", text)
+        if len(parts) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        minute, hour, dom, month, dow = parts
+        self.minutes = sorted(_field(minute, 0, 59))
+        self.hours = sorted(_field(hour, 0, 23))
+        self.months = _field(month, 1, 12, _MONTHS)
+
+        self.dom_restricted = dom not in ("*", "?")
+        self.dom_last = False
+        self.doms = set()
+        if self.dom_restricted:
+            for item in dom.split(","):
+                if item == "L":
+                    self.dom_last = True
+                else:
+                    self.doms.update(_item(item, 1, 31, None))
+
+        self.dow_restricted = dow not in ("*", "?")
+        self.dows = set()
+        self.dow_last = set()
+        self.dow_nth = set()
+        if self.dow_restricted:
+            for item in dow.split(","):
+                last = _LAST_DOW.fullmatch(item)
+                nth = _NTH_DOW.fullmatch(item)
+                if last:
+                    self.dow_last.add(_value(last.group(1), 0, 7, None) % 7)
+                elif nth:
+                    k = int(nth.group(2))
+                    if not 1 <= k <= 5:
+                        raise ValueError(f"bad occurrence: {item!r}")
+                    self.dow_nth.add((_value(nth.group(1), 0, 7, None) % 7, k))
+                else:
+                    self.dows.update(v % 7 for v in _item(item, 0, 7, _DAYS))
+
+    def day_ok(self, year, month, day):
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+        first_weekday, length = calendar.monthrange(year, month)
+        if self.dom_restricted:
+            if day in self.doms or (self.dom_last and day == length):
+                return True
+            if not self.dow_restricted:
+                return False
+        weekday = (first_weekday + day) % 7  # 0 is Sunday
+        if weekday in self.dows:
+            return True
+        if weekday in self.dow_last and day + 7 > length:
+            return True
+        return (weekday, (day - 1) // 7 + 1) in self.dow_nth
+
+    def matches(self, when):
+        return (
+            when.minute in self.minutes
+            and when.hour in self.hours
+            and when.month in self.months
+            and self.day_ok(when.year, when.month, when.day)
+        )
 
 
