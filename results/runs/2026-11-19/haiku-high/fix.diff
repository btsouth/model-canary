@@ -1,11 +1,212 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import date, datetime, time, timedelta
+
+_SEARCH_LIMIT = timedelta(days=20 * 365)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)
+}
+_WEEKDAY_NAMES = {name: number for number, name in enumerate(
+    ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (field name, lowest value, highest value, names allowed in the field)
+_MINUTE = ("minute", 0, 59, {})
+_HOUR = ("hour", 0, 23, {})
+_DAY_OF_MONTH = ("day of month", 1, 31, {})
+_MONTH = ("month", 1, 12, _MONTH_NAMES)
+_DAY_OF_WEEK = ("day of week", 0, 7, _WEEKDAY_NAMES)
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")  # NL: last day N of the month
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")  # N#K: K-th day N of the month
+
+
+class _Schedule:
+    """A parsed expression, ready to check days and minutes."""
+
+    def __init__(self, minute, hour, dom, month, dow):
+        self.minutes = sorted(minute[0])
+        self.hours = sorted(hour[0])
+        self.months = month[0]
+        self.dom, self.dom_restricted, dom_extras = dom
+        self.dom_last = any(extra == ("L",) for extra in dom_extras)
+        self.dow_restricted = dow[1]
+        # Cron treats Sunday as both 0 and 7, so keep weekdays as 0-6 with Sunday = 0.
+        self.dow = {n % 7 for n in dow[0]}
+        self.dow_last = [extra[1] % 7 for extra in dow[2] if extra[0] == "last"]
+        self.dow_nth = [(extra[1] % 7, extra[2]) for extra in dow[2] if extra[0] == "nth"]
+
+
+def _split(expr):
+    """The five field strings of an expression, or the expansion of a shortcut."""
+    text = expr.strip()
+    shortcut = _SHORTCUTS.get(text.lower())
+    if shortcut is not None:
+        return shortcut.split()
+    if text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {text!r}")
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields)}: {text!r}")
+    return fields
+
+
+def _value(token, field):
+    """One number or name from a field, range checked."""
+    _, low, high, names = field
+    if _DIGITS.fullmatch(token):
+        number = int(token)
+    elif names and token.isascii() and token.upper() in names:
+        number = names[token.upper()]
+    else:
+        raise ValueError(f"bad {field[0]} value: {token!r}")
+    if not low <= number <= high:
+        raise ValueError(f"{field[0]} value out of range: {token!r}")
+    return number
+
+
+def _plain_item(item, field):
+    """Values listed by an item made of *, N, A-B, optionally followed by /S."""
+    _, low, high, _ = field
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {field[0]} field: {item!r}")
+        step = int(step_text)
+    else:
+        step = 1
+    if base == "*":
+        first, last = low, high
+    else:
+        start_text, dash, end_text = base.partition("-")
+        first = _value(start_text, field)
+        if dash:
+            last = _value(end_text, field)
+            if first > last:
+                raise ValueError(f"range goes backwards in {field[0]} field: {item!r}")
+        elif slash:
+            last = high  # N/S lists N up to the field's maximum
+        else:
+            last = first
+    return range(first, last + 1, step)
+
+
+def _field(text, field):
+    """Parse one field. Returns (values, restricted, extras).
+
+    values are the plain numbers listed. restricted is False only for a whole field of
+    '*' or '?'. extras are the special day items: ('L',), ('last', N) and ('nth', N, K).
+    """
+    name, low, high, _ = field
+    if text == "?" and name not in ("day of month", "day of week"):
+        raise ValueError(f"'?' is not allowed in the {name} field")
+    if text in ("*", "?"):
+        return set(range(low, high + 1)), False, []
+    values, extras = set(), []
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {name} field: {text!r}")
+        if item == "L" and name == "day of month":
+            extras.append(("L",))
+            continue
+        if name == "day of week":
+            match = _LAST_WEEKDAY.fullmatch(item)
+            if match:
+                extras.append(("last", _weekday_number(match.group(1))))
+                continue
+            match = _NTH_WEEKDAY.fullmatch(item)
+            if match:
+                k = int(match.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"occurrence must be 1 to 5: {item!r}")
+                extras.append(("nth", _weekday_number(match.group(1)), k))
+                continue
+        values.update(_plain_item(item, field))
+    return values, True, extras
+
+
+def _weekday_number(digits):
+    number = int(digits)
+    if number > 7:
+        raise ValueError(f"weekday must be 0 to 7: {digits!r}")
+    return number
+
+
+def _parse(expr):
+    """Check the whole expression and return a _Schedule. Raises ValueError if bad."""
+    texts = _split(expr)
+    return _Schedule(
+        _field(texts[0], _MINUTE),
+        _field(texts[1], _HOUR),
+        _field(texts[2], _DAY_OF_MONTH),
+        _field(texts[3], _MONTH),
+        _field(texts[4], _DAY_OF_WEEK),
+    )
+
+
+def _day_matches(schedule, day):
+    """True if a date is allowed by the day-of-month and day-of-week fields together."""
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_hit = day.day in schedule.dom or (schedule.dom_last and day.day == last)
+    weekday = (day.weekday() + 1) % 7  # Python: Monday is 0; cron: Sunday is 0
+    nth_hit = any(weekday == n and (day.day - 1) // 7 + 1 == k for n, k in schedule.dow_nth)
+    last_hit = any(weekday == n and day.day + 7 > last for n in schedule.dow_last)
+    dow_hit = weekday in schedule.dow or nth_hit or last_hit
+    if schedule.dom_restricted and schedule.dow_restricted:
+        return dom_hit or dow_hit
+    if schedule.dom_restricted:
+        return dom_hit
+    if schedule.dow_restricted:
+        return dow_hit
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    return (when.minute in schedule.minutes
+            and when.hour in schedule.hours
+            and when.month in schedule.months
+            and _day_matches(schedule, when.date()))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _SEARCH_LIMIT
+    except OverflowError:
+        limit = datetime.max
+    day = start.date()
+    last_day = limit.date()
+    while day <= last_day:
+        if day.month in schedule.months and _day_matches(schedule, day):
+            for hour in schedule.hours:
+                for minute in schedule.minutes:
+                    candidate = datetime.combine(day, time(hour, minute))
+                    if candidate < start:
+                        continue
+                    return candidate if candidate <= limit else None
+        if day == date.max:
+            break
+        day += timedelta(days=1)
+    return None
