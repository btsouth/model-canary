 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass, field
+from datetime import datetime, time, timedelta
+from functools import lru_cache
+
+_LIMIT = timedelta(days=20 * 365)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_BOUNDS = {"minute": (0, 59), "hour": (0, 23), "dom": (1, 31), "month": (1, 12), "dow": (0, 7)}
+_NAMES = {
+    "month": {n: i + 1 for i, n in enumerate(
+        ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"])},
+    "dow": {n: i for i, n in enumerate(["sun", "mon", "tue", "wed", "thu", "fri", "sat"])},
+}
+
+
+@dataclass
+class _Field:
+    restricted: bool = False      # False only for a whole field of '*' or '?'
+    values: set = field(default_factory=set)
+    last: bool = False            # day of month 'L'
+    nl: set = field(default_factory=set)    # day of week 'NL' (N mod 7)
+    nth: set = field(default_factory=set)   # day of week 'N#K' as (N mod 7, K)
+
+
+def _number(tok, name):
+    if not re.fullmatch(r"[0-9]+", tok):
+        raise ValueError(f"bad number {tok!r} in {name} field")
+    n = int(tok)
+    lo, hi = _BOUNDS[name]
+    if not lo <= n <= hi:
+        raise ValueError(f"{n} out of range in {name} field")
+    return n
+
+
+def _value(tok, name):
+    names = _NAMES.get(name)
+    if names is not None and re.fullmatch(r"[A-Za-z]{3}", tok) and tok.lower() in names:
+        return names[tok.lower()]
+    return _number(tok, name)
+
+
+def _expand(text, name):
+    """Values of '*', 'A-B' or 'N' (no step)."""
+    lo, hi = _BOUNDS[name]
+    if text == "*":
+        return list(range(lo, hi + 1))
+    if "-" in text:
+        a_text, sep, b_text = text.partition("-")
+        if "-" in b_text:
+            raise ValueError(f"bad range {text!r}")
+        a, b = _value(a_text, name), _value(b_text, name)
+        if a > b:
+            raise ValueError(f"range {text!r} runs backwards")
+        return list(range(a, b + 1))
+    return [_value(text, name)]
+
+
+def _parse_item(item, name, out):
+    if item == "?":
+        raise ValueError("'?' is only allowed as a whole day field")
+    if "/" in item:
+        base, _, step_text = item.partition("/")
+        if not re.fullmatch(r"[0-9]+", step_text) or int(step_text) < 1 or "/" in base:
+            raise ValueError(f"bad step in {item!r}")
+        if base == "*" or "-" in base:
+            values = _expand(base, name)
+        else:
+            lo, hi = _BOUNDS[name]
+            values = list(range(_value(base, name), hi + 1))
+        values = values[::int(step_text)]
+    elif item == "L":
+        if name != "dom":
+            raise ValueError("'L' is only allowed in the day of month field")
+        out.last = True
+        return
+    elif re.fullmatch(r"[0-9]+L", item):
+        if name != "dow":
+            raise ValueError("'NL' is only allowed in the day of week field")
+        n = _number(item[:-1], "dow")
+        out.nl.add(n % 7)
+        return
+    elif "#" in item:
+        m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if name != "dow" or not m:
+            raise ValueError(f"bad 'N#K' item {item!r}")
+        n = _number(m.group(1), "dow")
+        k = int(m.group(2))
+        if not 1 <= k <= 5:
+            raise ValueError(f"occurrence must be 1 to 5 in {item!r}")
+        out.nth.add((n % 7, k))
+        return
+    else:
+        values = _expand(item, name)
+    for v in values:
+        out.values.add(v % 7 if name == "dow" else v)
+
+
+def _parse_field(text, name):
+    out = _Field()
+    if text in ("*", "?"):
+        if text == "?" and name not in ("dom", "dow"):
+            raise ValueError(f"'?' is not allowed in the {name} field")
+        lo, hi = _BOUNDS[name]
+        out.values = {v % 7 if name == "dow" else v for v in range(lo, hi + 1)}
+        return out
+    out.restricted = True
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {name} field")
+        _parse_item(item, name, out)
+    return out
+
+
+@dataclass(frozen=True)
+class _Schedule:
+    minute: _Field
+    hour: _Field
+    dom: _Field
+    month: _Field
+    dow: _Field
+
+
+@lru_cache(maxsize=256)
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)} in {expr!r}")
+    return _Schedule(*(_parse_field(p, n)
+                       for p, n in zip(parts, ("minute", "hour", "dom", "month", "dow"))))
+
+
+def _day_ok(s, day):
+    dim = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in s.dom.values or (s.dom.last and day.day == dim)
+    cron_dow = (day.weekday() + 1) % 7
+    dow_ok = (cron_dow in s.dow.values
+              or (cron_dow in s.dow.nl and day.day + 7 > dim)
+              or any(cron_dow == n and (day.day - 1) // 7 + 1 == k for n, k in s.dow.nth))
+    if s.dom.restricted and s.dow.restricted:
+        return dom_ok or dow_ok
+    if s.dom.restricted:
+        return dom_ok
+    if s.dow.restricted:
+        return dow_ok
+    return True
+
 
