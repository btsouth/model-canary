 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(calendar.day_abbr)}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _field(raw, kind, low, high):
+    """Return (values, special-days, unrestricted)."""
+    if kind in ("dom", "dow") and raw == "?":
+        return set(range(low, high + 1)), [], True
+    if raw == "*":
+        return set(range(low, high + 1)), [], True
+    values = set()
+    special = []
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if kind == "dom" and item == "L":
+            special.append(("last",))
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"(\d+)L", item)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError("day of week out of range")
+                special.append(("last_weekday", n % 7))
+                continue
+            m = re.fullmatch(r"(\d+)#(\d+)", item)
+            if m:
+                n, occurrence = int(m.group(1)), int(m.group(2))
+                if n > 7 or occurrence < 1 or occurrence > 5:
+                    raise ValueError("day of week occurrence out of range")
+                special.append(("nth_weekday", n % 7, occurrence))
+                continue
+        if item.count("/") > 1:
+            raise ValueError("bad step")
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not re.fullmatch(r"\d+", step_text) or int(step_text) < 1:
+                raise ValueError("bad step")
+            if not base.isdigit() and base != "*" and "-" not in base:
+                raise ValueError("names are not allowed with steps")
+            step = int(step_text)
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("bad range")
+            a, b = base.split("-")
+            start = _value(a, kind, low, high)
+            end = _value(b, kind, low, high)
+            if start > end:
+                raise ValueError("descending range")
+        else:
+            start = _value(base, kind, low, high)
+            end = high if slash else start
+        expanded = list(range(start, end + 1, step))
+        if kind == "dow":
+            expanded = [v % 7 for v in expanded]
+        values.update(expanded)
+    return values, special, False
+
+
+def _value(value, kind, low, high):
+    if not value:
+        raise ValueError("missing value")
+    if value.isdigit():
+        number = int(value)
+    elif kind == "month" and value.upper() in _MONTHS:
+        number = _MONTHS[value.upper()]
+    elif kind == "dow" and value.upper() in _DAYS:
+        number = _DAYS[value.upper()]
+    else:
+        raise ValueError("bad schedule value")
+    if not low <= number <= high:
+        raise ValueError("schedule value out of range")
+    return number
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    normalized = _SHORTCUTS.get(expr.strip().lower(), expr.strip())
+    fields = re.split(r"[ \t]+", normalized) if normalized else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    mins = _field(fields[0], "minute", 0, 59)
+    hours = _field(fields[1], "hour", 0, 23)
+    dom = _field(fields[2], "dom", 1, 31)
+    months = _field(fields[3], "month", 1, 12)
+    dow = _field(fields[4], "dow", 0, 7)
+    return mins, hours, dom, months, dow
+
+
+def _day_matches(day, dom, dow):
+    dom_values, dom_special, dom_any = dom
+    dow_values, dow_special, dow_any = dow
+    dom_match = day.day in dom_values or any(s[0] == "last" and day.day == calendar.monthrange(day.year, day.month)[1] for s in dom_special)
+    cron_dow = (day.weekday() + 1) % 7
+    dow_match = cron_dow in dow_values
+    month_days = calendar.monthrange(day.year, day.month)[1]
+    for special in dow_special:
+        if special[0] == "last_weekday" and cron_dow == special[1] and day.day + 7 > month_days:
+            dow_match = True
+        elif special[0] == "nth_weekday" and cron_dow == special[1] and (day.day - 1) // 7 + 1 == special[2]:
+            dow_match = True
+    if dom_any and dow_any:
+        return True
+    if dom_any:
+        return dow_match
+    if dow_any:
+        return dom_match
+    return dom_match or dow_match
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
