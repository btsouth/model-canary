 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"))}
+
+
+def _parse_field(raw, lo, hi, names=None, kind="normal"):
+    if raw == "?" and kind in ("dom", "dow"):
+        return {"values": set(range(lo, hi + 1)), "wild": True, "special": [], "raw": raw}
+    values, special = set(), []
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item == "L":
+            special.append(("last",)); continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-7])L", item)
+            h = re.fullmatch(r"([0-7])#([1-5])", item)
+            if m:
+                special.append(("last_weekday", int(m.group(1)) % 7)); continue
+            if h:
+                special.append(("nth_weekday", int(h.group(1)) % 7, int(h.group(2)))); continue
+        base, slash, step_s = item.partition("/")
+        if slash:
+            if not step_s.isdigit() or int(step_s) < 1:
+                raise ValueError("invalid step")
+            step = int(step_s)
+        else: step = 1
+        if base == "*": start, end = lo, hi
+        elif "-" in base:
+            if base.count("-") != 1: raise ValueError("invalid range")
+            a, b = base.split("-")
+            start, end = _value(a, names), _value(b, names)
+            if start > end: raise ValueError("descending range")
+        else:
+            start = _value(base, names)
+            end = hi if slash else start
+        if start < lo or end > hi: raise ValueError("out of range")
+        values.update(range(start, end + 1, step))
+    return {"values": values, "wild": raw in ("*", "?"), "special": special, "raw": raw}
+
+
+def _value(s, names):
+    if names and s.upper() in names: return names[s.upper()]
+    if not s.isdigit(): raise ValueError("invalid value")
+    return int(s)
+
+
+def _compile(expr):
+    if not isinstance(expr, str): raise ValueError("invalid expression")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        try: stripped = _SHORTCUTS[stripped.lower()]
+        except KeyError: raise ValueError("unknown shortcut") from None
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5: raise ValueError("expected five fields")
+    return (_parse_field(fields[0], 0, 59), _parse_field(fields[1], 0, 23),
+            _parse_field(fields[2], 1, 31, kind="dom"),
+            _parse_field(fields[3], 1, 12, _MONTHS),
+            _parse_field(fields[4], 0, 7, _DAYS, "dow"))
+
+
+def _day_ok(dom, dow, when):
+    dom_match = when.day in dom["values"] or any(s[0] == "last" and when.day == calendar.monthrange(when.year, when.month)[1] for s in dom["special"])
+    cron_dow = (when.weekday() + 1) % 7
+    dow_match = cron_dow in dow["values"] or (cron_dow == 0 and 7 in dow["values"])
+    last = calendar.monthrange(when.year, when.month)[1]
+    for s in dow["special"]:
+        if s[0] == "last_weekday" and cron_dow == s[1] and when.day + 7 > last: dow_match = True
+        if s[0] == "nth_weekday" and cron_dow == s[1] and (when.day - 1) // 7 + 1 == s[2]: dow_match = True
+    if dom["wild"] and dow["wild"]: return True
+    if dom["wild"]: return dow_match
+    if dow["wild"]: return dom_match
+    return dom_match or dow_match
 
 
