+                if i < len(sched.minutes):
+                    run = _dt.datetime(day.year, day.month, day.day, hour,
+                                       sched.minutes[i], tzinfo=tz)
+                    return run if run <= limit else None
+        if day == _dt.date.max:
+            break
+        day += one_day
+    return None
