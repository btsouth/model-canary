--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,194 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+from bisect import bisect_left
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_DOM, _DOW = 2, 4
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_SPLIT = re.compile(r"[ \t]+")
+_LIMIT = _dt.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last",
+                 "dow", "dow_last", "dow_nth", "dom_any", "dow_any")
+
+
+def _value(text, index):
+    low, high, names = _FIELDS[index]
+    if _NUM.fullmatch(text):
+        number = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        number = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= number <= high:
+        raise ValueError(f"value {text!r} out of range")
+    return number
+
+
+def _number(text, low, high):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number {text!r}")
+    number = int(text)
+    if not low <= number <= high:
+        raise ValueError(f"number {text!r} out of range")
+    return number
+
+
+def _parse_field(text, index):
+    """Return (values, last_flag, last_weekdays, nth_pairs)."""
+    low, high, _ = _FIELDS[index]
+    values, last, last_days, nth = set(), False, set(), set()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(range(low, high + 1)), last, last_days, nth
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if index == _DOM and item == "L":
+            last = True
+            continue
+        if index == _DOW and "#" in item:
+            day, _, k = item.partition("#")
+            nth.add((_number(day, 0, 7) % 7, _number(k, 1, 5)))
+            continue
+        if index == _DOW and item.endswith("L"):
+            last_days.add(_number(item[:-1], 0, 7) % 7)
+            continue
+        base, slash, step = item.partition("/")
+        if slash:
+            if not _NUM.fullmatch(step):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step)
+            if step < 1:
+                raise ValueError(f"step must be at least 1 in {item!r}")
+        else:
+            step = 1
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            start, end = _value(a, index), _value(b, index)
+            if start > end:
+                raise ValueError(f"backwards range {item!r}")
+        else:
+            start = _value(base, index)
+            end = high if slash else start
+        values.update(range(start, end + 1, step))
+    return values, last, last_days, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string, not {type(expr).__name__}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = _SPLIT.split(text) if text else []
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    sched = _Schedule()
+    sched.minutes = sorted(_parse_field(parts[0], 0)[0])
+    sched.hours = sorted(_parse_field(parts[1], 1)[0])
+    sched.months = frozenset(_parse_field(parts[3], 3)[0])
+    sched.dom, sched.dom_last, _, _ = _parse_field(parts[_DOM], _DOM)
+    dow, _, sched.dow_last, sched.dow_nth = _parse_field(parts[_DOW], _DOW)
+    sched.dow = {d % 7 for d in dow}
+    sched.dom_any = parts[_DOM] in ("*", "?")
+    sched.dow_any = parts[_DOW] in ("*", "?")
+    return sched
+
+
+def _day_ok(sched, day):
+    if day.month not in sched.months:
+        return False
+    if sched.dom_any and sched.dow_any:
+        return True
+    length = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in sched.dom or (sched.dom_last and day.day == length)
+    weekday = (day.weekday() + 1) % 7  # Sunday is 0
+    dow_ok = (
+        weekday in sched.dow
+        or (weekday in sched.dow_last and day.day + 7 > length)
+        or (weekday, (day.day - 1) // 7 + 1) in sched.dow_nth
+    )
+    if sched.dom_any:
+        return dow_ok
+    if sched.dow_any:
+        return dom_ok
+    return dom_ok or dow_ok
 
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    sched = _parse(expr)
+    return (
+        when.minute in sched.minutes
