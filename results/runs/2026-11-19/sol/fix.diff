 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT",
+     "NOV", "DEC"), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_RANGES = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, low, high, names=None):
+    if re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    elif names is not None and token in names:
+        value = names[token]
+    else:
+        raise ValueError(f"invalid schedule value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"schedule value out of range: {token!r}")
+    return value
+
+
+def _field(text, index):
+    low, high = _RANGES[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    values, specials = set(), []
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if index == 4:
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if special:
+                weekday = _number(special[1], 0, 7) % 7
+                if special[2] == "L":
+                    specials.append(("last", weekday))
+                else:
+                    specials.append(("nth", weekday, _number(special[3], 1, 5)))
+                continue
+        stepped = item.split("/")
+        if len(stepped) > 2:
+            raise ValueError(f"invalid schedule item: {item!r}")
+        base = stepped[0]
+        step = 1
+        if len(stepped) == 2:
+            if not re.fullmatch(r"[0-9]+", stepped[1]) or int(stepped[1]) < 1:
+                raise ValueError(f"invalid schedule step: {item!r}")
+            step = int(stepped[1])
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid schedule range: {item!r}")
+            start, end = (_number(token, low, high, names) for token in ends)
+            if start > end:
+                raise ValueError(f"reversed schedule range: {item!r}")
+        else:
+            start = _number(base, low, high, names)
+            end = high if len(stepped) == 2 else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {value % 7 for value in values}
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown schedule shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    parsed = [_field(field, index) for index, field in enumerate(fields)]
+    return parsed, fields[2] in ("*", "?"), fields[4] in ("*", "?")
+
+
+def _day_matches(parsed, dom_unrestricted, dow_unrestricted, day):
+    dom, dom_specials = parsed[2]
+    dow, dow_specials = parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    dom_match = day.day in dom
+    dow_match = weekday in dow
+    if dom_specials or dow_specials:
+        last = calendar.monthrange(day.year, day.month)[1]
+        dom_match |= bool(dom_specials) and day.day == last
+        for special in dow_specials:
+            if weekday == special[1]:
+                if special[0] == "last":
+                    dow_match |= day.day + 7 > last
+                else:
+                    dow_match |= (day.day - 1) // 7 + 1 == special[2]
+    if dom_unrestricted:
+        return dow_unrestricted or dow_match
+    if dow_unrestricted:
+        return dom_match
+    return dom_match or dow_match
+
 
