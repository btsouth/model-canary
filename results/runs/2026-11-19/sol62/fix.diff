 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import date, datetime
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_MONTH_NAMES = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAY_NAMES = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_NAMES_BY_FIELD = {3: _MONTH_NAMES, 4: _WEEKDAY_NAMES}
+_WEEKDAY_SPECIAL = re.compile(r"([0-9]+)(?:L|#([0-9]+))")
+_SEARCH_DAYS = 20 * 365
+
+
+def _decimal(text, cap):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid decimal number: {text!r}")
+    digits = text.lstrip("0") or "0"
+    # Avoid converting arbitrarily large steps or out-of-range values to int.
+    return cap if len(digits) > len(str(cap)) else min(int(digits), cap)
+
+
+def _field_value(text, low, high, names):
+    value = names.get(text.upper())
+    if value is None:
+        value = _decimal(text, high + 1)
+    if not low <= value <= high:
+        raise ValueError(f"schedule value out of range: {text!r}")
+    return value
+
+
+def _parse_field(field, index):
+    if index in (2, 4) and field in ("*", "?"):
+        return None
+
+    low, high = _BOUNDS[index]
+    names = _NAMES_BY_FIELD.get(index, {})
+    values = set()
+    for item in field.split(","):
+        if index == 2 and item == "L":
+            values.add("L")
+            continue
+        if index == 4:
+            special = _WEEKDAY_SPECIAL.fullmatch(item)
+            if special:
+                weekday = _field_value(special[1], low, high, names) % 7
+                occurrence = "L" if special[2] is None else _field_value(special[2], 1, 5, {})
+                values.add((weekday, occurrence))
+                continue
+
+        base, slash, step_text = item.partition("/")
+        step = _decimal(step_text, high - low + 1) if slash else 1
+        if step == 0:
+            raise ValueError("schedule step must be positive")
+        if base == "*":
+            start, end = low, high
+        else:
+            first, dash, last = base.partition("-")
+            start = _field_value(first, low, high, names)
+            if dash:
+                end = _field_value(last, low, high, names)
+            else:
+                end = high if slash else start
+            if start > end:
+                raise ValueError(f"reversed schedule range: {base!r}")
+        values.update(range(start, end + 1, step))
+
+    # Sunday aliases are merged after stepping through the original numeric range.
+    if index == 4 and 7 in values:
+        values.remove(7)
+        values.add(0)
+    return values
+
+
+def _parse_expression(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+    expr = expr.strip()
+    fields = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    if len(fields) != len(_BOUNDS):
+        raise ValueError("schedule expression must have five fields")
+    return tuple(_parse_field(field, index) for index, field in enumerate(fields))
+
+
+def _day_matches(day, month_days, weekdays):
+    if month_days is None and weekdays is None:
+        return True
+    if month_days is not None:
+        if day.day in month_days:
+            return True
+        if "L" in month_days and day.day == monthrange(day.year, day.month)[1]:
+            return True
+    if weekdays is None:
+        return False
+
+    weekday = (day.weekday() + 1) % 7
+    occurrence = (day.day - 1) // 7 + 1
+    return (
+        weekday in weekdays
+        or (weekday, occurrence) in weekdays
+        or ((weekday, "L") in weekdays and day.day + 7 > monthrange(day.year, day.month)[1])
+    )
+
 
