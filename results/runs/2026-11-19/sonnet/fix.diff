 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _num(text, names, lo, hi):
+    if _NUM.fullmatch(text):
+        v = int(text)
+    elif names and text.upper() in names:
+        v = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {text!r}")
+    return v
+
+
+def _parse_field(text, lo, hi, names=None, kind=None):
+    """Return (values, last_dom, last_dows, nth_dows, restricted)."""
+    values, last_dom, last_dows, nth = set(), False, set(), set()
+    if kind in ("dom", "dow") and text == "?":
+        return values_all(lo, hi), False, set(), set(), False
+    if text == "*" and kind in ("dom", "dow"):
+        return values_all(lo, hi), False, set(), set(), False
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item.upper() == "L":
+            last_dom = True
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)L", item, re.I)
+            if m:
+                last_dows.add(_num(m.group(1), None, 0, 7) % 7)
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError("bad nth")
+                nth.add((_num(m.group(1), None, 0, 7) % 7, k))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError("bad step")
+        base = parts[0]
+        step = None
+        if len(parts) == 2:
+            if not _NUM.fullmatch(parts[1]) or int(parts[1]) < 1:
+                raise ValueError("bad step")
+            step = int(parts[1])
+        if base == "*":
+            a, b = lo, hi
+        elif "-" in base:
+            x = base.split("-")
+            if len(x) != 2:
+                raise ValueError("bad range")
+            a, b = _num(x[0], names, lo, hi), _num(x[1], names, lo, hi)
+            if a > b:
+                raise ValueError("reversed range")
+        else:
+            a = _num(base, names, lo, hi)
+            b = hi if step is not None else a
+        values.update(range(a, b + 1, step or 1))
+    return values, last_dom, last_dows, nth, True
+
+
+def values_all(lo, hi):
+    return set(range(lo, hi + 1))
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    s = expr.strip()
+    if s.startswith("@"):
+        if s.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        s = _SHORTCUTS[s.lower()]
+    f = re.split(r"[ \t]+", s)
+    if len(f) != 5:
+        raise ValueError("expected five fields")
+    minute = _parse_field(f[0], 0, 59)[0]
+    hour = _parse_field(f[1], 0, 23)[0]
+    dom = _parse_field(f[2], 1, 31, None, "dom")
+    month = _parse_field(f[3], 1, 12, _MONTHS)[0]
+    dow = _parse_field(f[4], 0, 7, _DAYS, "dow")
+    dow = (({v % 7 for v in dow[0]},) + dow[1:])
+    return sorted(minute), sorted(hour), dom, month, dow
+
+
+def _day_ok(dom, dow, d):
+    dvals, dlast, _, _, drestr = dom
+    wvals, _, wlast, wnth, wrestr = dow
+    last = calendar.monthrange(d.year, d.month)[1]
+    dm = d.day in dvals or (dlast and d.day == last)
+    wd = (d.weekday() + 1) % 7
+    wm = (wd in wvals or (wd in wlast and d.day + 7 > last)
+          or (wd, (d.day - 1) // 7 + 1) in wnth)
+    if drestr and wrestr:
+        return dm or wm
+    if drestr:
+        return dm
+    if wrestr:
+        return wm
+    return True
 
 
