 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(parts):
+        lo, hi = _LIMITS[index]
+        values, special = set(), []
+        unrestricted = field in ('*', '?') and index in (2, 4)
+        if field == '?':
+            if index not in (2, 4):
+                raise ValueError('invalid question mark')
+            field = '*'
+        def number(s):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if s.upper() in names:
+                value = names[s.upper()]
+            elif re.fullmatch(r'[0-9]+', s):
+                value = int(s)
+            else:
+                raise ValueError('invalid value')
+            if not lo <= value <= hi:
+                raise ValueError('value out of range')
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            m = re.fullmatch(r'([0-7])L|([0-7])#([1-5])', item) if index == 4 else None
+            if m:
+                special.append(('weekday_last', int(m[1]) % 7) if m[1] else
+                               ('weekday_nth', int(m[2]) % 7, int(m[3])))
+                continue
+            match = re.fullmatch(r'([^/]+)(?:/([0-9]+))?', item)
+            if not match:
+                raise ValueError('invalid item')
+            base, step_text = match.groups()
+            step = int(step_text) if step_text is not None else 1
+            if step < 1:
+                raise ValueError('invalid step')
+            if base == '*':
+                start, end = lo, hi
+            elif '-' in base:
+                bits = base.split('-')
+                if len(bits) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, bits)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = hi if step_text is not None else start
+            values.update(v % 7 if index == 4 else v for v in range(start, end + 1, step))
+        parsed.append((values, special, unrestricted))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    dom, dow = parsed[2], parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dm = date.day in dom[0] or (('last',) in dom[1] and date.day == last)
+    dw = weekday in dow[0] or any(
+        s[1] == weekday and (date.day + 7 > last if s[0] == 'weekday_last'
+                             else (date.day - 1) // 7 + 1 == s[2])
+        for s in dow[1])
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dw
+    if dow[2]:
+        return dm
+    return dm or dw
+
 
