 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_left
+import calendar
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())},
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal digits')
+    return int(text)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError('expected schedule text')
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _BOUNDS[index]
+        values, special = set(), []
+
+        def value(token):
+            n = _NAMES.get(index, {}).get(token.upper())
+            if n is None:
+                n = _number(token)
+            if not low <= n <= high:
+                raise ValueError('value out of range')
+            return n
+
+        if field == '?' and index in (2, 4):
+            field = '*'
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+            if index == 4 and match:
+                weekday = value(match[1]) % 7
+                if match[2] == 'L':
+                    special.append(('last', weekday))
+                else:
+                    nth = _number(match[3])
+                    if not 1 <= nth <= 5:
+                        raise ValueError('weekday occurrence out of range')
+                    special.append(('nth', weekday, nth))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2:
+                raise ValueError('invalid step')
+            step = _number(pieces[1]) if len(pieces) == 2 else 1
+            if step < 1:
+                raise ValueError('step must be positive')
+            base = pieces[0]
+            if base == '*':
+                first, last = low, high
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                first, last = map(value, ends)
+            else:
+                first = value(base)
+                last = high if len(pieces) == 2 else first
+            if first > last:
+                raise ValueError('reversed range')
+            values.update(n % 7 if index == 4 else n
+                          for n in range(first, last + 1, step))
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, day):
+    if day.month not in parsed[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = parsed[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow, dow_special = parsed[4]
+    return weekday in dow or any(
+        weekday == rule[1] and (
+            day.day + 7 > last if rule[0] == 'last'
+            else (day.day - 1) // 7 + 1 == rule[2])
+        for rule in dow_special)
+
 
