 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_FIELDS = ((0, 59, {}), (0, 23, {}), (1, 31, {}), (1, 12, _MONTHS), (0, 7, _WEEKDAYS))
+_TOKEN = r"(?:[0-9]+|[a-zA-Z]{3})"
+_ITEM = re.compile(rf"(?:\*|({_TOKEN})(?:-({_TOKEN}))?)(?:/([0-9]+))?")
+_SPECIAL_WEEKDAY = re.compile(r"([0-9]+)(?:L|#([0-9]+))")
+_HORIZON = timedelta(days=20 * 365)
+
+
+def _value(token, low, high, names):
+    if token.isdigit():
+        value = int(token.lstrip("0") or "0")
+    else:
+        value = names.get(token.upper())
+    if value is None or not low <= value <= high:
+        raise ValueError(f"invalid schedule value: {token!r}")
+    return value
+
+
+def _expand(item, low, high, names):
+    match = _ITEM.fullmatch(item)
+    if not match:
+        raise ValueError(f"invalid schedule item: {item!r}")
+    start, end, step = match.groups()
+    first = _value(start, low, high, names) if start else low
+    last = high if step or not start else first
+    if end:
+        last = _value(end, low, high, names)
+    # A step larger than the field can only select the first value.
+    digits = (step or "1").lstrip("0")
+    stride = high + 1 if len(digits) > len(str(high)) else int(digits or "0")
+    if last < first or stride == 0:
+        raise ValueError(f"invalid range or step: {item!r}")
+    return range(first, last + 1, stride)
+
+
+@dataclass
+class _Schedule:
+    minutes: tuple
+    hours: tuple
+    days: set
+    months: set
+    weekdays: set
+    last_day: bool
+    special_weekdays: set
+
+    def allows_date(self, day):
+        if day.month not in self.months:
+            return False
+        month_end = calendar.monthrange(day.year, day.month)[1]
+        if day.day not in self.days and not (self.last_day and day.day == month_end):
+            return False
+        weekday = (day.weekday() + 1) % 7
+        occurrence = (day.day - 1) // 7 + 1
+        return (weekday in self.weekdays
+                or (weekday, occurrence) in self.special_weekdays
+                or (day.day + 7 > month_end and (weekday, -1) in self.special_weekdays))
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("expected five schedule fields")
+    values = []
+    last_day = False
+    special_weekdays = set()
+    for index, (field, bounds) in enumerate(zip(fields, _FIELDS)):
+        if index in (2, 4) and field == "?":
+            field = "*"
+        selected = set()
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                last_day = True
+                continue
+            if index == 4:
+                special = _SPECIAL_WEEKDAY.fullmatch(item)
+                if special:
+                    weekday = _value(special[1], 0, 7, {}) % 7
+                    occurrence = _value(special[2], 1, 5, {}) if special[2] else -1
+                    special_weekdays.add((weekday, occurrence))
+                    continue
+            selected.update(_expand(item, *bounds))
+        values.append(selected)
+    minutes, hours, days, months, weekdays = values
+    return _Schedule(tuple(sorted(minutes)), tuple(sorted(hours)), days, months,
+                     {w % 7 for w in weekdays}, last_day, special_weekdays)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
