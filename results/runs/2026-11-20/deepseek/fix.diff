 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_RANGES = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "day": (1, 31),
+    "month": (1, 12),
+    "weekday": (0, 7),
+}
+
+_MONTHS = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+
+_WEEKDAYS = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3,
+    "THU": 4, "FRI": 5, "SAT": 6,
+}
+
+_NUMBER = re.compile(r"[0-9]+\Z")
+
+
+class _Schedule:
+    __slots__ = (
+        "minutes", "hours", "days", "months", "weekdays",
+        "last_day", "last_weekdays", "nth_weekdays",
+    )
+
+
+def _value(token, kind):
+    low, high = _RANGES[kind]
+    if _NUMBER.fullmatch(token):
+        number = int(token)
+        if not low <= number <= high:
+            raise ValueError(f"value out of range: {token!r}")
+        return number
+    name = token.upper()
+    table = _MONTHS if kind == "month" else _WEEKDAYS if kind == "weekday" else None
+    if table is not None and name in table:
+        return table[name]
+    raise ValueError(f"bad value in {kind}: {token!r}")
+
+
+def _item_values(item, kind):
+    low, high = _RANGES[kind]
+    if "/" in item:
+        if item.count("/") != 1:
+            raise ValueError(f"bad step: {item!r}")
+        base, step_text = item.split("/")
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
