+    schedule = _Schedule()
+    schedule.minutes = _parse_field(fields[0], "minute")[0]
+    schedule.hours = _parse_field(fields[1], "hour")[0]
+    days, day_specials = _parse_field(fields[2], "day")
+    schedule.days = days
+    schedule.last_day = bool(day_specials)
+    schedule.months = _parse_field(fields[3], "month")[0]
+    weekdays, weekday_specials = _parse_field(fields[4], "weekday")
+    schedule.weekdays = {0 if value == 7 else value for value in weekdays}
+    schedule.last_weekdays = [
+        (0 if value == 7 else value)
+        for tag, value in weekday_specials if tag == "last_weekday"
+    ]
+    schedule.nth_weekdays = [
+        (0 if value[0] == 7 else value[0], value[1])
+        for tag, value in weekday_specials if tag == "nth_weekday"
+    ]
+    return schedule
+
+
+def _month_length(when):
+    return calendar.monthrange(when.year, when.month)[1]
+
+
+def _dom_matches(schedule, when):
+    if when.day in schedule.days:
+        return True
+    return schedule.last_day and when.day == _month_length(when)
+
+
+def _first_weekday_of_month(when, weekday):
+    first = datetime(when.year, when.month, 1).weekday()
+    first = (first + 1) % 7
+    return 1 + (weekday - first) % 7
+
+
+def _dow_matches(schedule, when):
+    weekday = (when.weekday() + 1) % 7
+    if weekday in schedule.weekdays:
+        return True
+    if weekday in schedule.last_weekdays and when.day + 7 > _month_length(when):
+        return True
+    for number, rank in schedule.nth_weekdays:
+        if number == weekday:
+            if when.day == _first_weekday_of_month(when, number) + 7 * (rank - 1):
+                return True
+    return False
+
+
+def _day_allowed(schedule, when):
+    return _dom_matches(schedule, when) and _dow_matches(schedule, when)
+
+
+def _matches(schedule, when):
+    return (
+        when.minute in schedule.minutes
+        and when.hour in schedule.hours
+        and when.month in schedule.months
+        and _day_allowed(schedule, when)
+    )
+
 
