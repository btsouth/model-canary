+        if len(ends) != 2:
+            raise ValueError(f"bad range: {item!r}")
+        first = _value(ends[0], kind)
+        last = _value(ends[1], kind)
+        if first > last:
+            raise ValueError(f"bad range: {item!r}")
+        return list(range(first, last + 1))
+    return [_value(item, kind)]
+
+
+def _parse_field(text, kind):
+    low, high = _RANGES[kind]
+    if text == "?":
+        if kind not in ("day", "weekday"):
+            raise ValueError("'?' outside the day fields")
+        return set(range(low, high + 1)), []
+    if "?" in text:
+        raise ValueError("bad '?'")
+    items = text.split(",")
+    if any(item == "" for item in items):
+        raise ValueError(f"empty item in {text!r}")
+    values = set()
+    specials = []
+    for item in items:
+        if kind == "day" and item == "L":
+            specials.append(("last", None))
+            continue
+        if kind == "weekday":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                number = int(match.group(1))
+                if not 0 <= number <= 7:
+                    raise ValueError(f"value out of range: {item!r}")
+                specials.append(("last_weekday", number))
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                number = int(match.group(1))
+                rank = int(match.group(2))
+                if not 0 <= number <= 7:
+                    raise ValueError(f"value out of range: {item!r}")
+                if not 1 <= rank <= 5:
+                    raise ValueError(f"value out of range: {item!r}")
+                specials.append(("nth_weekday", (number, rank)))
+                continue
