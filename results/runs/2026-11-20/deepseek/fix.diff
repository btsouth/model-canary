+            if len(ends) != 2 or not all(_NUMBER.fullmatch(e) for e in ends):
+                raise ValueError(f"bad step: {item!r}")
+            first, last = int(ends[0]), int(ends[1])
+            if not (low <= first <= high and low <= last <= high):
+                raise ValueError(f"value out of range: {base!r}")
+            if first > last:
+                raise ValueError(f"bad range: {base!r}")
+            values = list(range(first, last + 1))
+        else:
+            raise ValueError(f"bad step: {item!r}")
+        return values[::step]
+    if item == "*":
+        return list(range(low, high + 1))
+    if "-" in item:
