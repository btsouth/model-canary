 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_MONTH_NAMES = {name: i + 1 for i, name in enumerate(_MONTHS)}
+_DAY_NAMES = {name: i for i, name in enumerate(_DAYS)}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"^[0-9]+$")
+_NTH = re.compile(r"^([0-9]+)#([0-9]+)$")
+_LAST_DOW = re.compile(r"^([0-9]+)L$")
+
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+class _Field:
+    """A parsed field: a set of plain values plus the special day items."""
+
+    def __init__(self):
+        self.values = set()
+        self.last_dom = False          # L in the day-of-month field
+        self.last_dow = set()          # NL in the day-of-week field
+        self.nth_dow = set()           # N#K in the day-of-week field
+
+    @property
+    def any(self):
+        return self.values is None
+
+
+def _value(token, low, high, names, where):
+    """Turn a number or name into an int within [low, high]."""
+    if not token:
+        raise ValueError(f"empty value in {where} field")
+    if _NUMBER.match(token):
+        n = int(token)
+    elif names is not None and token.upper() in names:
+        n = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r} in {where} field")
+    if not low <= n <= high:
+        raise ValueError(f"value {n} out of range {low}-{high} in {where} field")
+    return n
+
+
+def _parse_field(text, low, high, names, where):
+    field = _Field()
+    is_dom = where == "day of month"
+    is_dow = where == "day of week"
+    if text == "?" and (is_dom or is_dow):
+        field.values = None
+        return field
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {where} field")
+        base, sep, step_text = item.partition("/")
+        if sep:
+            if not _NUMBER.match(step_text):
+                raise ValueError(f"bad step {step_text!r} in {where} field")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1 in {where} field")
+        else:
+            step = 1
+        if base == "*":
+            listed = range(low, high + 1)
+        elif base == "L" and is_dom and not sep:
+            field.last_dom = True
+            continue
+        elif is_dow and not sep and _LAST_DOW.match(base):
+            n = _value(_LAST_DOW.match(base).group(1), 0, 7, None, where)
+            field.last_dow.add(n % 7)
+            continue
+        elif is_dow and not sep and _NTH.match(base):
+            n_text, k_text = _NTH.match(base).groups()
+            n = _value(n_text, 0, 7, None, where)
+            k = int(k_text)
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad occurrence {k} in {where} field")
+            field.nth_dow.add((n % 7, k))
+            continue
+        elif "-" in base:
+            a_text, b_text = base.split("-", 1)
+            a = _value(a_text, low, high, names, where)
+            b = _value(b_text, low, high, names, where)
+            if a > b:
+                raise ValueError(f"range {base!r} runs backwards in {where} field")
+            listed = range(a, b + 1)
+        else:
+            n = _value(base, low, high, names, where)
+            listed = range(n, high + 1) if sep else range(n, n + 1)
+        field.values.update(listed[::step])
+    if is_dow:
+        field.values = {v % 7 for v in field.values}
+    full = set(range(low, high + 1)) if not is_dow else set(range(7))
+    if field.values == full and not (field.last_dom or field.last_dow or field.nth_dow):
+        field.values = None
+    return field
+
+
+def _parse(expr):
+    """Parse expr into (minutes, hours, dom, months, dow) fields."""
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    for part in parts:
+        if not part.isascii() or not part.isprintable() or any(c.isspace() for c in part):
+            raise ValueError(f"bad field {part!r} in {expr!r}")
+    minutes = _parse_field(parts[0], 0, 59, None, "minute")
+    hours = _parse_field(parts[1], 0, 23, None, "hour")
+    dom = _parse_field(parts[2], 1, 31, None, "day of month")
+    months = _parse_field(parts[3], 1, 12, _MONTH_NAMES, "month")
+    dow = _parse_field(parts[4], 0, 7, _DAY_NAMES, "day of week")
+    return minutes, hours, dom, months, dow
+
+
+def _in(field, value):
+    return field.values is None or value in field.values
+
+
+def _day_allowed(dom, dow, date):
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7  # Sunday is 0
+    if dom.values is not None:
+        ok = date.day in dom.values or (dom.last_dom and date.day == days_in_month)
+        if not ok:
+            return False
+    if dow.values is not None:
+        ok = weekday in dow.values
+        if not ok and weekday in dow.last_dow and date.day + 7 > days_in_month:
+            ok = True
+        if not ok and (weekday, (date.day - 1) // 7 + 1) in dow.nth_dow:
+            ok = True
+        if not ok:
+            return False
+    return True
+
 
