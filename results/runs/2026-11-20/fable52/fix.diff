 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+from functools import lru_cache
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_HORIZON = _dt.timedelta(days=20 * 365)
+
+
+def _value(text, low, high, names):
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _items(field, low, high, names=None, special=None):
+    """The set of plain values a field lists; special() handles the extra forms."""
+    values = set()
+    for item in field.split(","):
+        if special is not None and special(item):
+            continue
+        base, slash, step = item.partition("/")
+        if slash:
+            if not _NUMBER.fullmatch(step) or int(step) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step)
+        else:
+            step = 1
+        if base == "*":
+            first, last = low, high
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            first, last = _value(a, low, high, names), _value(b, low, high, names)
+            if first > last:
+                raise ValueError(f"backwards range: {item!r}")
+        else:
+            first = _value(base, low, high, names)
+            last = high if slash else first
+        values.update(range(first, last + 1, step))
+    return values
+
+
+@lru_cache(maxsize=256)
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+    minute, hour, dom, month, dow = parts
+
+    minutes = sorted(_items(minute, 0, 59))
+    hours = sorted(_items(hour, 0, 23))
+    months = _items(month, 1, 12, _MONTHS)
+
+    dom_last = []
+
+    def dom_special(item):
+        if item == "L":
+            dom_last.append(True)
+            return True
+        return False
+
+    dom_any = dom in ("*", "?")
+    doms = set() if dom_any else _items(dom, 1, 31, special=dom_special)
+
+    last_dows, nth_dows = set(), set()
+
+    def dow_special(item):
+        found = _LAST_DOW.fullmatch(item)
+        if found:
+            last_dows.add(_value(found.group(1), 0, 7, None) % 7)
+            return True
+        found = _NTH_DOW.fullmatch(item)
+        if found:
+            nth = int(found.group(2))
+            if not 1 <= nth <= 5:
+                raise ValueError(f"bad occurrence: {item!r}")
+            nth_dows.add((_value(found.group(1), 0, 7, None) % 7, nth))
+            return True
+        return False
+
+    dow_any = dow in ("*", "?")
+    dows = set() if dow_any else {
+        v % 7 for v in _items(dow, 0, 7, _DAYS, special=dow_special)}
+
+    def day_ok(date):
+        day = date.day
+        if not dom_any and day not in doms:
+            if not (dom_last and day == calendar.monthrange(date.year, date.month)[1]):
+                return False
+        if dow_any:
+            return True
+        weekday = (date.weekday() + 1) % 7
+        if weekday in dows:
+            return True
+        if (weekday, (day - 1) // 7 + 1) in nth_dows:
+            return True
+        if weekday in last_dows:
+            return day + 7 > calendar.monthrange(date.year, date.month)[1]
+        return False
+
+    return minutes, hours, months, day_ok
 
 
