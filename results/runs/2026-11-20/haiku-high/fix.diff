+    exact_weights = [Fraction(w) for w in weights]
+    whole = sum(exact_weights)
+    if any(w < 0 for w in exact_weights) or whole == 0:
+        raise ValueError("weights must be non-negative and not all zero")
+    sign = -1 if total < 0 else 1
+    total = abs(total)
+    exact = [total * w / whole for w in exact_weights]
+    shares = [math.floor(e) for e in exact]
+    leftover = total - sum(shares)
+    by_remainder = sorted(range(len(shares)), key=lambda i: (-(exact[i] - shares[i]), i))
+    for i in by_remainder[:leftover]:
+        shares[i] += 1
+    return [sign * s for s in shares]
 
 
