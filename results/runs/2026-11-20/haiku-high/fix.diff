 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+_SEARCH_LIMIT = timedelta(days=20 * 365)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_RANGES = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+
+_NAMES = {
+    "month": {n: i for i, n in enumerate(
+        ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)},
+    "dow": {n: i for i, n in enumerate(
+        ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])},
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-7])L")
+_NTH_DOW = re.compile(r"([0-7])#([1-5])")
+
+
+@dataclass(frozen=True)
+class _Schedule:
+    minutes: frozenset
+    hours: frozenset
+    months: frozenset
+    dom_days: frozenset
+    dom_last: bool
+    dow_days: frozenset      # weekdays with cron numbering, 0 = Sunday .. 6 = Saturday
+    dow_last: frozenset      # weekdays that are the last such weekday of the month
+    dow_nth: frozenset       # (weekday, K) pairs: the K-th such weekday of the month
+
+    def day_ok(self, d):
+        month_length = calendar.monthrange(d.year, d.month)[1]
+        dom_ok = d.day in self.dom_days or (self.dom_last and d.day == month_length)
+        wd = (d.weekday() + 1) % 7
+        dow_ok = (wd in self.dow_days
+                  or (wd in self.dow_last and d.day + 7 > month_length)
+                  or (wd, (d.day - 1) // 7 + 1) in self.dow_nth)
+        return dom_ok and dow_ok
+
+
+def _value(token, kind):
+    lo, hi = _RANGES[kind]
+    if _DIGITS.fullmatch(token):
+        value = int(token)
+    elif token.upper() in _NAMES.get(kind, {}):
+        value = _NAMES[kind][token.upper()]
+    else:
+        raise ValueError(f"bad {kind} value: {token!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"{kind} value out of range: {token!r}")
+    return value
+
+
+def _parse_item(item, kind, acc):
+    if kind == "dom" and item == "L":
+        acc["last_day"] = True
+        return
+    if kind == "dow":
+        m = _LAST_DOW.fullmatch(item)
+        if m:
+            acc["last_dow"].add(int(m.group(1)) % 7)
+            return
+        m = _NTH_DOW.fullmatch(item)
+        if m:
+            acc["nth"].add((int(m.group(1)) % 7, int(m.group(2))))
+            return
+
+    lo, hi = _RANGES[kind]
+    base, slash, step_text = item.partition("/")
+    step = None
+    if slash:
+        if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+
+    if base == "*":
+        first, last = lo, hi
+    elif "-" in base:
+        parts = base.split("-")
+        if len(parts) != 2:
+            raise ValueError(f"bad range: {item!r}")
+        first, last = _value(parts[0], kind), _value(parts[1], kind)
+        if first > last:
+            raise ValueError(f"range start after end: {item!r}")
+    else:
+        first = _value(base, kind)
+        last = hi if step else first
+
+    values = list(range(first, last + 1))
+    if step:
+        values = values[::step]
+    acc["values"].update(values)
+
+
+def _parse_field(text, kind):
+    if kind in ("dom", "dow") and text == "?":
+        text = "*"
+    acc = {"values": set(), "last_day": False, "last_dow": set(), "nth": set()}
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in field {text!r}")
+        _parse_item(item, kind, acc)
+    return acc
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom, month, dow = (
+        _parse_field(f, kind)
+        for f, kind in zip(fields, ["minute", "hour", "dom", "month", "dow"])
+    )
+    dom_days = frozenset(dom["values"])
+    dow_days = frozenset(v % 7 for v in dow["values"])
+    return _Schedule(
+        minutes=frozenset(minute["values"]),
+        hours=frozenset(hour["values"]),
+        months=frozenset(month["values"]),
+        dom_days=dom_days,
+        dom_last=dom["last_day"],
+        dow_days=dow_days,
+        dow_last=frozenset(dow["last_dow"]),
+        dow_nth=frozenset(dow["nth"]),
+    )
+
 
