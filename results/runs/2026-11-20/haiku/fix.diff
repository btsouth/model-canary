+def _split(text):
+    """Split on unquoted SEP. Returns (chars, saw_quote) per field, where chars is a
+    list of (character, quoted) pairs with the quote characters themselves removed."""
+    fields, chars, saw_quote, quoted = [], [], False, False
+    i, n = 0, len(text)
+    while i < n:
+        ch = text[i]
+        if quoted:
+            if ch == QUOTE:
+                if i + 1 < n and text[i + 1] == QUOTE:
+                    chars.append((QUOTE, True))
+                    i += 2
+                    continue
+                quoted = False
+            else:
+                chars.append((ch, True))
+        elif ch == QUOTE:
+            quoted = saw_quote = True
+        elif ch == SEP:
+            fields.append((chars, saw_quote))
+            chars, saw_quote = [], False
+        else:
+            chars.append((ch, False))
+        i += 1
+    if quoted:
+        raise ValueError("unclosed quote")
+    fields.append((chars, saw_quote))
+    return fields
+
+
+def _trim(chars):
+    """Drop unquoted whitespace from both ends."""
+    lo, hi = 0, len(chars)
+    while lo < hi and not chars[lo][1] and chars[lo][0].isspace():
+        lo += 1
+    while hi > lo and not chars[hi - 1][1] and chars[hi - 1][0].isspace():
+        hi -= 1
+    return chars[lo:hi]
+
+
+def _text(chars):
+    return "".join(c for c, _ in chars)
