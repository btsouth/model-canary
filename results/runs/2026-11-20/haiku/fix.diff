@@ -1,11 +1,187 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {n: i for i, n in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {n: i for i, n in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+
+# (name, lowest value, highest value, names allowed in this field)
+_FIELDS = (
+    ("minute", 0, 59, {}),
+    ("hour", 0, 23, {}),
+    ("dom", 1, 31, {}),
+    ("month", 1, 12, _MONTHS),
+    ("dow", 0, 7, _DAYS),
+)
+
+_NUM = r"[0-9]+"
+_NAME = r"[A-Za-z]{3}"
+_TOKEN = re.compile(rf"({_NUM}|{_NAME})(?:-({_NUM}|{_NAME}))?(?:/([0-9]+))?")
+_STAR = re.compile(r"\*(?:/([0-9]+))?")
+_LAST_N = re.compile(rf"({_NUM})L")
+_NTH_N = re.compile(rf"({_NUM})#({_NUM})")
+_NAME_RE = re.compile(_NAME)
+
+
+@dataclass(frozen=True)
+class _Spec:
+    minutes: tuple
+    hours: tuple
+    dom_days: frozenset
+    dom_last: bool
+    months: frozenset
+    dows: frozenset        # cron weekdays 0-6, Sunday = 0
+    dow_nth: frozenset     # (weekday, K): the K-th such weekday of the month
+    dow_last: frozenset    # weekdays whose last occurrence in the month counts
+
+
+def _value(tok, lo, hi, names):
+    if re.fullmatch(_NUM, tok):
+        n = int(tok)
+    elif names and _NAME_RE.fullmatch(tok) and tok.upper() in names:
+        n = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= n <= hi:
+        raise ValueError(f"value {n} out of range {lo}-{hi}")
+    return n
+
+
+def _parse_field(text, index):
+    name, lo, hi, names = _FIELDS[index]
+    day_field = name in ("dom", "dow")
+    if text == "?":
+        if not day_field:
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    elif "?" in text:
+        raise ValueError("'?' must be the whole field")
+
+    values, last, nth, last_n = set(), False, set(), set()
+    for item in text.split(","):
+        if m := _STAR.fullmatch(item):
+            step = int(m.group(1)) if m.group(1) else 1
+            if step < 1:
+                raise ValueError("step must be at least 1")
+            values.update(range(lo, hi + 1, step))
+            continue
+        if name == "dom" and item == "L":
+            last = True
+            continue
+        if name == "dow":
+            if m := _LAST_N.fullmatch(item):
+                last_n.add(_value(m.group(1), 0, 7, {}) % 7)
+                continue
+            if m := _NTH_N.fullmatch(item):
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError("K in N#K must be 1 to 5")
+                nth.add((_value(m.group(1), 0, 7, {}) % 7, k))
+                continue
+        m = _TOKEN.fullmatch(item)
+        if not m:
+            raise ValueError(f"bad item {item!r} in {name} field")
+        a_tok, b_tok, s_tok = m.groups()
+        if s_tok is not None:
+            if any(t is not None and _NAME_RE.fullmatch(t) for t in (a_tok, b_tok)):
+                raise ValueError("names are not allowed in a step")
+            step = int(s_tok)
+            if step < 1:
+                raise ValueError("step must be at least 1")
+        else:
+            step = 1
+        a = _value(a_tok, lo, hi, names)
+        if b_tok is not None:
+            b = _value(b_tok, lo, hi, names)
+            if a > b:
+                raise ValueError(f"range {a_tok}-{b_tok} runs backwards")
+            values.update(range(a, b + 1, step))
+        elif s_tok is not None:
+            values.update(range(a, hi + 1, step))
+        else:
+            values.add(a)
+    return values, last, nth, last_n
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {text!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}")
+    minute, _, _, _ = _parse_field(parts[0], 0)
+    hour, _, _, _ = _parse_field(parts[1], 1)
+    dom, dom_last, _, _ = _parse_field(parts[2], 2)
+    month, _, _, _ = _parse_field(parts[3], 3)
+    dow_vals, _, dow_nth, dow_last = _parse_field(parts[4], 4)
+    return _Spec(
+        minutes=tuple(sorted(minute)),
+        hours=tuple(sorted(hour)),
+        dom_days=frozenset(dom),
+        dom_last=dom_last,
+        months=frozenset(month),
+        dows=frozenset(v % 7 for v in dow_vals),
+        dow_nth=frozenset(dow_nth),
+        dow_last=frozenset(dow_last),
+    )
+
+
+def _day_ok(spec, day):
+    """True if the date day is allowed by both the day-of-month and day-of-week fields."""
+    if day.month not in spec.months:
+        return False
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    if day.day not in spec.dom_days and not (spec.dom_last and day.day == days_in_month):
+        return False
+    weekday = (day.weekday() + 1) % 7  # Sunday = 0
+    if weekday in spec.dows:
+        return True
+    if (weekday, (day.day - 1) // 7 + 1) in spec.dow_nth:
+        return True
+    return weekday in spec.dow_last and day.day + 7 > days_in_month
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return (when.minute in spec.minutes
+            and when.hour in spec.hours
+            and _day_ok(spec, when.date()))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    limit = after + timedelta(days=20 * 365)
+    day = start.date()
+    last_day = limit.date()
+    while day <= last_day:
+        if _day_ok(spec, day):
+            for hour in spec.hours:
+                for minute in spec.minutes:
+                    candidate = datetime.combine(day, time(hour, minute))
+                    if candidate < start:
+                        continue
+                    return candidate if candidate <= limit else None
+        day += timedelta(days=1)
+    return None
