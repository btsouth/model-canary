 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_WEEKDAYS = {name.upper(): i for i, name in enumerate(("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"))}
+
+
+def _value(token, names, low, high, allow_names):
+    upper = token.upper()
+    if allow_names and upper in names:
+        return names[upper]
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError("invalid schedule value")
+    value = int(token)
+    if not low <= value <= high:
+        raise ValueError("schedule value out of range")
+    return value
+
+
+def _field(text, low, high, names=None, kind="normal"):
+    names = names or {}
+    if kind in ("dom", "dow") and text == "?":
+        text = "*"
+    if not text:
+        raise ValueError("empty schedule field")
+    values, last_dom, last_dow, nth_dow = set(), set(), set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if kind == "dom" and item == "L":
+            last_dom.add(True)
+            continue
+        if kind == "dow":
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                n = _value(match.group(1), {}, 0, 7, False) % 7
+                last_dow.add(n)
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                n = _value(match.group(1), {}, 0, 7, False) % 7
+                occurrence = int(match.group(2))
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("invalid weekday occurrence")
+                nth_dow.add((n, occurrence))
+                continue
+        if "L" in item or "#" in item:
+            raise ValueError("invalid special schedule item")
+        if item.count("/") > 1:
+            raise ValueError("invalid schedule step")
+        base, step_text = (item.split("/", 1) + [None])[:2] if "/" in item else (item, None)
+        if step_text is not None:
+            if not re.fullmatch(r"[0-9]+", step_text) or int(step_text) < 1:
+                raise ValueError("invalid schedule step")
+            if any(name in base.upper() for name in names):
+                raise ValueError("names cannot be used with steps")
+            step = int(step_text)
+        else:
+            step = 1
+        if base == "*":
+            seq = list(range(low, high + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("invalid schedule range")
+            a, b = base.split("-")
+            start = _value(a, names, low, high, True)
+            end = _value(b, names, low, high, True)
+            if start > end:
+                raise ValueError("descending schedule range")
+            seq = list(range(start, end + 1))
+        else:
+            start = _value(base, names, low, high, True)
+            seq = list(range(start, high + 1)) if step_text is not None else [start]
+        values.update(seq[::step])
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, bool(text == "*" or text == "?"), last_dom, last_dow, nth_dow
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        try:
+            stripped = _SHORTCUTS[stripped.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    minute = _field(fields[0], 0, 59)
+    hour = _field(fields[1], 0, 23)
+    dom = _field(fields[2], 1, 31, kind="dom")
+    month = _field(fields[3], 1, 12, _MONTHS)
+    dow = _field(fields[4], 0, 7, _WEEKDAYS, "dow")
+    return minute[0], hour[0], dom, month[0], dow
+
+
+def _day_matches(parsed, day):
+    _, _, dom, months, dow = parsed
+    _, dom_all, last_dom, _, _ = dom
+    dow_values, dow_all, _, last_dow, nth_dow = dow
+    month = day.month
+    if month not in months:
+        return False
+    dom_values = dom[0]
+    dom_ok = day.day in dom_values or (last_dom and day.day == calendar.monthrange(day.year, month)[1])
+    weekday = (day.weekday() + 1) % 7
+    dow_ok = weekday in dow_values
+    if last_dow:
+        last_date = calendar.monthrange(day.year, month)[1]
+        dow_ok = dow_ok or (weekday in last_dow and day.day + 7 > last_date)
+    for n, occurrence in nth_dow:
+        if weekday == n and (day.day - 1) // 7 + 1 == occurrence:
+            dow_ok = True
+    return (True if dom_all else dom_ok) and (True if dow_all else dow_ok)
+
 
