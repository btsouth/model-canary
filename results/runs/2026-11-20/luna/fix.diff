 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): (i + 1) % 7 for i, n in enumerate(calendar.day_abbr)}
+_SHORT = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("invalid schedule")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORT.get(expr.lower(), "")
+        if not expr:
+            raise ValueError("unknown shortcut")
+    fields = re.split(r"[ \t]+", expr) if expr else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+
+    def values(token, lo, hi, names=None, allow_q=False, special=None):
+        if token == "?" and allow_q:
+            token = "*"
+        if special:
+            if token == "*":
+                return {"all": True, "vals": set(range(lo, hi + 1)), "special": []}
+            specs = []
+            ordinary = []
+            for item in token.split(","):
+                if not item:
+                    raise ValueError("empty item")
+                if item == "L" and special == "dom":
+                    specs.append(("last",))
+                elif special == "dow" and re.fullmatch(r"[0-7]L|[0-7]#[1-5]", item):
+                    n = int(item[0]) % 7
+                    specs.append(("lastweekday", n) if item.endswith("L") else ("nthweekday", n, int(item[2])))
+                else:
+                    ordinary.append(item)
+            out = set()
+            if ordinary:
+                out = values(",".join(ordinary), lo, hi, names, allow_q)
+            return {"all": token == "*", "vals": out, "special": specs}
+        result, all_values = set(), token == "*"
+        for item in token.split(","):
+            if not item:
+                raise ValueError("empty item")
+            bits = item.split("/")
+            if len(bits) > 2:
+                raise ValueError("bad step")
+            step = 1
+            if len(bits) == 2:
+                if not bits[1].isdigit() or int(bits[1]) < 1:
+                    raise ValueError("bad step")
+                if any(c.isalpha() for c in bits[0]):
+                    raise ValueError("names are not allowed with steps")
+                step = int(bits[1])
+            base = bits[0]
+            def number(s):
+                if names and s.upper() in names:
+                    return names[s.upper()]
+                if not s.isdigit():
+                    raise ValueError("bad value")
+                n = int(s)
+                if not lo <= n <= hi:
+                    raise ValueError("out of range")
+                return n
+            if base == "*":
+                start, end = lo, hi
+            elif "-" in base:
+                if base.count("-") != 1:
+                    raise ValueError("bad range")
+                start, end = map(number, base.split("-"))
+                if start > end:
+                    raise ValueError("descending range")
+            else:
+                start = number(base)
+                end = hi if len(bits) == 2 else start
+            result.update(range(start, end + 1, step))
+        return {"all": all_values, "vals": result, "special": []}
+
+    minute = values(fields[0], 0, 59)
+    hour = values(fields[1], 0, 23)
+    dom = values(fields[2], 1, 31, allow_q=True, special="dom")
+    month = values(fields[3], 1, 12, _MONTHS)
+    dow = values(fields[4], 0, 7, _DAYS, allow_q=True, special="dow")
