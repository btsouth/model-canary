+    for spec in dow["special"]:
+        if spec[0] == "lastweekday" and wd == spec[1] and day.day + 7 > last:
+            dow_match = True
+        if spec[0] == "nthweekday" and wd == spec[1] and (day.day - 1) // 7 + 1 == spec[2]:
+            dow_match = True
+    return dom_match and dow_match
 
 
