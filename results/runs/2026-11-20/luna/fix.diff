+        dow["vals"].add(0)
+    return minute["vals"], hour["vals"], dom, month["vals"], dow
+
+
+def _day_ok(day, dom, dow):
+    last = calendar.monthrange(day.year, day.month)[1]
+    wd = (day.weekday() + 1) % 7
+    dom_match = dom["all"] or day.day in dom["vals"]
+    dow_match = dow["all"] or wd in dow["vals"]
