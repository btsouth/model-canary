 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "days", "last_day", "months",
+                 "weekdays", "last_weekdays", "nth_weekdays")
+
+
+def _value(text, low, high, names):
+    if _DIGITS.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _weekday_number(text):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad day of week {text!r}")
+    value = int(text)
+    if not 0 <= value <= 7:
+        raise ValueError(f"day of week {text!r} out of range")
+    return value % 7
+
+
+def _parse_field(text, index):
+    low, high, names = _FIELDS[index]
+    values = set()
+    specials = []
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(range(low, high + 1)), specials
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if index == 2 and item == "L":
+            specials.append(("L",))
+            continue
+        if index == 4:
+            match = _LAST_WEEKDAY.fullmatch(item)
+            if match:
+                specials.append(("L", _weekday_number(match.group(1))))
+                continue
+            match = _NTH_WEEKDAY.fullmatch(item)
+            if match:
+                k = int(match.group(2)) if _DIGITS.fullmatch(match.group(2)) else 0
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad week number in {item!r}")
+                specials.append(("#", _weekday_number(match.group(1)), k))
+                continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not _DIGITS.fullmatch(step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1 in {item!r}")
+        else:
+            step = 1
+        if base == "*":
+            start, stop = low, high
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            start = _value(a, low, high, names)
+            stop = _value(b, low, high, names)
+            if start > stop:
+                raise ValueError(f"range {base!r} goes backwards")
+        else:
+            start = _value(base, low, high, names)
+            stop = high if slash else start
+        values.update(range(start, stop + 1, step))
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    parsed = [_parse_field(part, i) for i, part in enumerate(parts)]
+    s = _Schedule()
+    s.minutes = sorted(parsed[0][0])
+    s.hours = sorted(parsed[1][0])
+    s.days = parsed[2][0]
+    s.last_day = bool(parsed[2][1])
+    s.months = parsed[3][0]
+    s.weekdays = {v % 7 for v in parsed[4][0]}
+    s.last_weekdays = {sp[1] for sp in parsed[4][1] if sp[0] == "L"}
+    s.nth_weekdays = {(sp[1], sp[2]) for sp in parsed[4][1] if sp[0] == "#"}
+    return s
+
+
+def _day_allowed(s, year, month, day, last, weekday):
+    """weekday is 0 for Sunday."""
+    if not (day in s.days or (s.last_day and day == last)):
+        return False
+    return (weekday in s.weekdays
+            or (weekday in s.last_weekdays and day + 7 > last)
+            or (weekday, (day - 1) // 7 + 1) in s.nth_weekdays)
 
 
