 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError("expected decimal digits")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError("schedule value out of range")
+        return number
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        if index == 4:
+            match = re.fullmatch(r"([0-9]+)(L|#[0-9]+)", item)
+            if match:
+                weekday = value(match[1]) % 7
+                if match[2] != "L" and not 1 <= int(match[2][1:]) <= 5:
+                    raise ValueError("weekday occurrence out of range")
+                special.append(("last", weekday) if match[2] == "L"
+                               else ("nth", weekday, int(match[2][1:])))
+                continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid schedule step")
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("schedule step must be positive")
+        base = pieces[0]
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError("invalid schedule range")
+            start, end = map(value, ends)
+            if start > end:
+                raise ValueError("descending schedule range")
+        else:
+            start = value(base)
+            end = high if len(pieces) == 2 else start
+        listed = range(start, end + 1, step)
+        values.update(n % 7 if index == 4 else n for n in listed)
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("a schedule needs five fields")
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(parsed, day):
+    if day.month not in parsed[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = parsed[2]
+    if day.day not in dom and not (dom_special and day.day == last):
+        return False
+    dow, dow_special = parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    if weekday in dow:
+        return True
+    for rule in dow_special:
+        if weekday == rule[1]:
+            if rule[0] == "last" and day.day + 7 > last:
+                return True
+            if rule[0] == "nth" and (day.day - 1) // 7 + 1 == rule[2]:
+                return True
+    return False
+
 
