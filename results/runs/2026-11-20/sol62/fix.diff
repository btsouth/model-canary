 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, datetime
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {
+    name: number
+    for number, name in enumerate("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)
+}
+_WEEKDAYS = {
+    name: number for number, name in enumerate("SUN MON TUE WED THU FRI SAT".split())
+}
+_DIGITS = re.compile(r"[0-9]+")
+_SEARCH_DAYS = 20 * 365
+
+
+def _number(text):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"expected a decimal number: {text!r}")
+    digits = text.lstrip("0")
+    # No field or ordinal has three digits, and a step of 100 keeps only the first value.
+    return 100 if len(digits) > 2 else int(digits or "0")
+
+
+def _value(text, minimum, maximum, names):
+    if names is not None and text.isascii() and text.upper() in names:
+        return names[text.upper()]
+    value = _number(text)
+    if not minimum <= value <= maximum:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _item_values(item, minimum, maximum, names=None):
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text) if slash else 1
+    if step == 0:
+        raise ValueError("step must be positive")
+    if base == "*":
+        return range(minimum, maximum + 1, step)
+    first, dash, last = base.partition("-")
+    start = _value(first, minimum, maximum, names)
+    if dash:
+        end = _value(last, minimum, maximum, names)
+        if start > end:
+            raise ValueError(f"reversed range: {base!r}")
+    else:
+        end = maximum if slash else start
+    return range(start, end + 1, step)
+
+
+def _field_values(field, minimum, maximum, names=None):
+    return {
+        value
+        for item in field.split(",")
+        for value in _item_values(item, minimum, maximum, names)
+    }
+
+
+def _day_items(field):
+    return ("*",) if field == "?" else field.split(",")
+
+
+@dataclass
+class _Schedule:
+    minutes: set[int]
+    hours: set[int]
+    months: set[int]
+    month_days: set[int]
+    weekdays: set[int]
+    last_day: bool
+    last_weekdays: set[int]
+    nth_weekdays: set[tuple[int, int]]
+
+    def allows_day(self, day):
+        if day.month not in self.months:
+            return False
+        if day.day not in self.month_days:
+            if not self.last_day or day.day != monthrange(day.year, day.month)[1]:
+                return False
+
+        weekday = (day.weekday() + 1) % 7
+        occurrence = (day.day - 1) // 7 + 1
+        return (
+            weekday in self.weekdays
+            or (weekday, occurrence) in self.nth_weekdays
+            or (weekday in self.last_weekdays and day.day + 7 > monthrange(day.year, day.month)[1])
+        )
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+    expr = expr.strip()
+    expression = _SHORTCUTS.get(expr.lower(), expr) if expr.isascii() else expr
+    fields = re.split(r"[ \t]+", expression)
+    if len(fields) != 5:
+        raise ValueError("expected five schedule fields")
+    minute, hour, month_day, month, weekday = fields
+    minutes = _field_values(minute, 0, 59)
+    hours = _field_values(hour, 0, 23)
+    months = _field_values(month, 1, 12, _MONTHS)
+
+    month_days = set()
+    last_day = False
+    for item in _day_items(month_day):
+        if item == "L":
+            last_day = True
+        else:
+            month_days.update(_item_values(item, 1, 31))
+
+    weekdays = set()
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in _day_items(weekday):
+        if item.endswith("L"):
+            last_weekdays.add(_value(item[:-1], 0, 7, None) % 7)
+        elif "#" in item:
+            number, _, occurrence = item.partition("#")
+            nth_weekdays.add((_value(number, 0, 7, None) % 7, _value(occurrence, 1, 5, None)))
+        else:
+            weekdays.update(value % 7 for value in _item_values(item, 0, 7, _WEEKDAYS))
+
+    return _Schedule(
+        minutes, hours, months, month_days, weekdays, last_day, last_weekdays, nth_weekdays
+    )
+
 
