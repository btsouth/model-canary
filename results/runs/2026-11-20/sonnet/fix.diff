 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "jan feb mar apr may jun jul aug sep oct nov dec".split())}
+_DAYS = {n: i for i, n in enumerate("sun mon tue wed thu fri sat".split())}
+_NUM = re.compile(r"[0-9]+\Z")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.match(tok):
+        v = int(tok)
+    elif names and tok.lower() in names:
+        v = names[tok.lower()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _item(item, lo, hi, names):
+    base, sep, step = item.partition("/")
+    if sep:
+        if not _NUM.match(step) or int(step) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step)
+    else:
+        step = None
+    if base == "*":
+        a, b = lo, hi
+    elif "-" in base:
+        x, _, y = base.partition("-")
+        a, b = _value(x, lo, hi, names), _value(y, lo, hi, names)
+        if a > b:
+            raise ValueError(f"descending range {item!r}")
+    else:
+        a = _value(base, lo, hi, names)
+        b = hi if step else a
+    return list(range(a, b + 1, step or 1))
+
+
+def _parse_field(text, lo, hi, names=None):
+    vals = set()
+    for item in text.split(","):
+        vals.update(_item(item, lo, hi, names))
+    return vals
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minute = _parse_field(parts[0], 0, 59)
+    hour = _parse_field(parts[1], 0, 23)
+    month = _parse_field(parts[3], 1, 12, _MONTHS)
+
+    dom_text, dow_text = parts[2], parts[4]
+    dom_any = dom_text == "?" or dom_text == "*"
+    dom, dom_last = set(), False
+    if dom_text == "?":
+        dom = set(range(1, 32))
+    else:
+        for item in dom_text.split(","):
+            if item.upper() == "L":
+                dom_last = True
+            else:
+                dom.update(_item(item, 1, 31, None))
+    dow_any = dow_text == "?" or dow_text == "*"
+    dow, dow_last, dow_nth = set(), set(), set()
+    if dow_text == "?":
+        dow = set(range(7))
+    else:
+        for item in dow_text.split(","):
+            m = re.match(r"([0-9]+)[lL]\Z", item)
+            n = re.match(r"([0-9]+)#([0-9]+)\Z", item)
+            if m:
+                dow_last.add(_value(m.group(1), 0, 7, None) % 7)
+            elif n:
+                k = int(n.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad occurrence in {item!r}")
+                dow_nth.add((_value(n.group(1), 0, 7, None) % 7, k))
+            else:
+                dow.update(v % 7 for v in _item(item, 0, 7, _DAYS))
+    return (minute, hour, month, dom_any, dom, dom_last,
+            dow_any, dow, dow_last, dow_nth)
+
+
+def _day_ok(p, d):
+    _, _, month, dom_any, dom, dom_last, dow_any, dow, dow_last, dow_nth = p
+    if d.month not in month:
+        return False
+    if not dom_any:
+        last = calendar.monthrange(d.year, d.month)[1]
+        if not (d.day in dom or (dom_last and d.day == last)):
+            return False
+    if not dow_any:
+        wd = (d.weekday() + 1) % 7
+        last = calendar.monthrange(d.year, d.month)[1]
+        ok = (wd in dow
+              or (wd in dow_last and d.day + 7 > last)
+              or (wd, (d.day - 1) // 7 + 1) in dow_nth)
+        if not ok:
+            return False
+    return True
 
 
