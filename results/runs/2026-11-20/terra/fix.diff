 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from bisect import bisect_left
+
+_SHORTCUTS = {'yearly': '0 0 1 1 *', 'annually': '0 0 1 1 *',
+              'monthly': '0 0 1 * *', 'weekly': '0 0 * * 0',
+              'daily': '0 0 * * *', 'midnight': '0 0 * * *',
+              'hourly': '0 * * * *'}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7)))
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr[1:].lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, part in enumerate(parts):
+        lo, hi = _LIMITS[index]
+        values, special = set(), []
+        if part == '?' and index in (2, 4):
+            part = '*'
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+
+        def number(text):
+            if re.fullmatch(r'[0-9]+', text):
+                n = int(text)
+            elif text.upper() in names:
+                n = names[text.upper()]
+            else:
+                raise ValueError('invalid value')
+            if not lo <= n <= hi:
+                raise ValueError('value out of range')
+            return n
+
+        for item in part.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            m = re.fullmatch(r'([0-7])(?:L|#([1-5]))', item) if index == 4 else None
+            if m:
+                special.append(('weekday', int(m.group(1)) % 7, int(m.group(2)) if m.group(2) else None))
+                continue
+            chunks = item.split('/')
+            if len(chunks) > 2 or not chunks[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(chunks) == 2:
+                if not re.fullmatch(r'[0-9]+', chunks[1]) or int(chunks[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(chunks[1])
+            base = chunks[0]
+            if base == '*':
+                start, end = lo, hi
+            elif '-' in base:
+                bounds = base.split('-')
+                if len(bounds) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, bounds)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = hi if len(chunks) == 2 else start
+            values.update(n % 7 if index == 4 else n for n in range(start, end + 1, step))
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_ok(parsed, date):
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    weekday = (date.weekday() + 1) % 7
+    return (date.day in dom or (dom_special and date.day == last)) and (
+        weekday in dow or any(weekday == n and
+            (date.day + 7 > last if k is None else (date.day - 1) // 7 + 1 == k)
+            for _, n, k in dow_special))
+
 
