 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
 
+import calendar
+from bisect import bisect_right
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)},
+    4: {name: i for i, name in enumerate(
+        "SUN MON TUE WED THU FRI SAT".split())},
+}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError("expected decimal digits")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _LIMITS[index]
+    values, special = set(), []
+    if text == "?" and index in (2, 4):
+        text = "*"
+
+    def value(token):
+        number = _NAMES.get(index, {}).get(token)
+        if number is None:
+            number = _number(token)
+        if not low <= number <= high:
+            raise ValueError("value outside field range")
+        return number
+
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if index == 4 and (last or nth):
+            weekday = value((last or nth)[1]) % 7
+            if last:
+                special.append(("last_weekday", weekday))
+            else:
+                occurrence = _number(nth[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence outside range")
+                special.append(("nth_weekday", weekday, occurrence))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError("invalid range")
+            start, end = map(value, endpoints)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown shortcut") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    return [_field(field, i) for i, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    month_end = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    if day.day not in dom and not (dom_special and day.day == month_end):
+        return False
+    weekdays, special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    if weekday in weekdays:
+        return True
+    return any(
+        weekday == rule[1] and (
+            day.day + 7 > month_end if rule[0] == "last_weekday"
+            else (day.day - 1) // 7 + 1 == rule[2]
+        )
+        for rule in special
+    )
+
+
