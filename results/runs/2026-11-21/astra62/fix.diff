 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from calendar import monthrange
+from datetime import date, datetime
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@YEARLY": "0 0 1 1 *", "@ANNUALLY": "0 0 1 1 *",
+    "@MONTHLY": "0 0 1 * *", "@WEEKLY": "0 0 * * 0",
+    "@DAILY": "0 0 * * *", "@MIDNIGHT": "0 0 * * *", "@HOURLY": "0 * * * *",
+}
+
+
+def _decimal(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"expected a decimal number: {token!r}")
+    # Every field has at most 60 values, so larger steps all select just one.
+    digits = token.lstrip("0")
+    return 100 if len(digits) > 2 else int(digits or "0")
+
+
+def _value(token, low, high, names):
+    value = names[token] if token in names else _decimal(token)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _item_values(item, low, high, names):
+    base, slash, stride = item.partition("/")
+    step = _decimal(stride) if slash else 1
+    if step == 0:
+        raise ValueError("zero step")
+    if base == "*":
+        first, last = low, high
+    else:
+        start, dash, end = base.partition("-")
+        first = _value(start, low, high, names)
+        last = _value(end, low, high, names) if dash else (high if slash else first)
+
+    if first > last and names is _WEEKDAYS:
+        # A wrapped range passes Sunday only once.
+        first %= 7
+        high = 6
+    if first <= last:
+        values = list(range(first, last + 1))
+    else:
+        values = list(range(first, high + 1)) + list(range(low, last + 1))
+    return values[::step]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    if not expr.isascii():
+        raise ValueError("invalid schedule character")
+    expr = expr.upper()
+    parts = re.split(r"[ \t]+", _SHORTCUTS.get(expr, expr))
+    if len(parts) != 5:
+        raise ValueError("expected five schedule fields")
+
+    fields = []
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+    bounds = [(0, 59, {}), (0, 23, {}), (1, 31, {}), (1, 12, _MONTHS), (0, 7, _WEEKDAYS)]
+    for index, (field, (low, high, names)) in enumerate(zip(parts, bounds)):
+        values = set()
+        if index in (2, 4) and field == "?":
+            field = "*"
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                last_day = True
+                continue
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item) if index == 4 else None
+            if special:
+                weekday = _value(special[1], 0, 7, {}) % 7
+                if special[2] == "L":
+                    last_weekdays.add(weekday)
+                else:
+                    nth_weekdays.add((weekday, _value(special[3], 1, 5, {})))
+            else:
+                values.update(_item_values(item, low, high, names))
+        fields.append(values)
+    minutes, hours, days, months, weekdays = fields
+    if 7 in weekdays:
+        weekdays.add(0)
+
+    def allowed(day):
+        if day.month not in months:
+            return False
+        length = monthrange(day.year, day.month)[1]
+        if day.day not in days and not (last_day and day.day == length):
+            return False
+        weekday = (day.weekday() + 1) % 7
+        return (weekday in weekdays
+                or (weekday in last_weekdays and day.day + 7 > length)
+                or (weekday, (day.day - 1) // 7 + 1) in nth_weekdays)
+
+    return minutes, hours, allowed
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    minutes, hours, allowed = _parse(expr)
