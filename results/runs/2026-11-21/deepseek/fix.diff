+            sequence = deduped
+
+        if step is not None:
+            sequence = sequence[::step]
+        values.update(sequence)
+
+    if kind == "dow":
+        values = {value % 7 for value in values}
+
+    return (
+        tuple(sorted(values)),
+        last_day,
+        frozenset(last_weekdays),
+        frozenset(nth_weekdays),
+    )
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression: {expr!r}")
+    text = expr.strip()
+    lowered = text.lower()
+    if lowered.startswith("@"):
+        if lowered not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[lowered]
+
+    fields = _SPLIT.split(text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    minutes, _, _, _ = _parse_field(fields[0], "minute")
+    hours, _, _, _ = _parse_field(fields[1], "hour")
+    days, last_day, _, _ = _parse_field(fields[2], "dom")
+    months, _, _, _ = _parse_field(fields[3], "month")
+    weekdays, _, last_weekdays, nth_weekdays = _parse_field(fields[4], "dow")
+
+    return _Schedule(
+        minutes,
+        hours,
+        months,
+        days,
+        weekdays,
+        last_day,
+        last_weekdays,
+        nth_weekdays,
+    )
+
+
+def _cron_weekday(date):
+    return (date.weekday() + 1) % 7
+
+
+def _day_allowed(schedule, date):
+    last = calendar.monthrange(date.year, date.month)[1]
+
+    day_ok = date.day in schedule.days
+    if not day_ok and schedule.last_day and date.day == last:
+        day_ok = True
+    if not day_ok:
+        return False
+
+    weekday = _cron_weekday(date)
+    if weekday in schedule.weekdays:
+        return True
+
+    if schedule.last_weekdays:
+        last_weekday = _cron_weekday(dt.date(date.year, date.month, last))
+        for number in schedule.last_weekdays:
+            if date.day == last - ((last_weekday - number) % 7):
+                return True
+
+    if schedule.nth_weekdays:
+        first_weekday = _cron_weekday(dt.date(date.year, date.month, 1))
+        for number, occurrence in schedule.nth_weekdays:
+            day = 1 + ((number - first_weekday) % 7) + 7 * (occurrence - 1)
+            if day <= last and date.day == day:
+                return True
+
+    return False
+
 
