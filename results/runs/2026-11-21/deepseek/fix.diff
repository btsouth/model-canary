+
+def _parse_value(token, names, low, high):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _parse_field(text, kind):
+    if kind == "minute":
+        low, high, names, allow_last, allow_dow_special = 0, 59, None, False, False
+    elif kind == "hour":
+        low, high, names, allow_last, allow_dow_special = 0, 23, None, False, False
+    elif kind == "dom":
+        low, high, names, allow_last, allow_dow_special = 1, 31, None, True, False
+    elif kind == "month":
+        low, high, names, allow_last, allow_dow_special = 1, 12, _MONTH_NAMES, False, False
+    else:
+        low, high, names, allow_last, allow_dow_special = 0, 7, _DAY_NAMES, False, True
+
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    if "?" in text:
+        raise ValueError("'?' must be the whole field")
+
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+
+    for item in text.split(","):
+        if item == "":
+            raise ValueError("empty item")
+
+        if allow_last and item == "L":
+            last_day = True
+            continue
+
+        if allow_dow_special:
+            if item == "L":
+                raise ValueError("L is not allowed here")
+            if item.endswith("L"):
+                prefix = item[:-1]
+                if not _NUMBER.fullmatch(prefix):
+                    raise ValueError(f"bad item: {item!r}")
+                number = int(prefix)
+                if not 0 <= number <= 7:
+                    raise ValueError(f"value out of range: {item!r}")
+                last_weekdays.add(number % 7)
+                continue
+            if "#" in item:
+                if item.count("#") != 1:
+                    raise ValueError(f"bad item: {item!r}")
+                left, right = item.split("#")
+                if not _NUMBER.fullmatch(left) or not _NUMBER.fullmatch(right):
+                    raise ValueError(f"bad item: {item!r}")
+                number, occurrence = int(left), int(right)
+                if not 0 <= number <= 7:
+                    raise ValueError(f"value out of range: {item!r}")
+                if not 1 <= occurrence <= 5:
+                    raise ValueError(f"value out of range: {item!r}")
+                nth_weekdays.add((number % 7, occurrence))
+                continue
