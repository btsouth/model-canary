+class _Schedule:
+    __slots__ = (
+        "minutes",
+        "hours",
+        "months",
+        "days",
+        "weekdays",
+        "last_day",
+        "last_weekdays",
+        "nth_weekdays",
+    )
+
+    def __init__(
