 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+
+_MONTHS = ["jan", "feb", "mar", "apr", "may", "jun",
+           "jul", "aug", "sep", "oct", "nov", "dec"]
+_DAYS = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names) for the five fields.
+_SPECS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_HORIZON = _dt.timedelta(days=10 * 365)
+
+
+class _Field:
+    """One parsed field: a set of plain values plus the day-only extras."""
+
+    def __init__(self):
+        self.values = set()
+        self.any = False          # '*' or '?': matches everything
+        self.last_dom = False     # 'L' in day of month
+        self.last_dow = set()     # N from 'NL' in day of week
+        self.nth_dow = set()      # (N, K) from 'N#K' in day of week
+
+
+def _number(text, names, allow_names, expr):
+    if text.isdigit() and text.isascii():
+        return int(text)
+    if allow_names and names and text.lower() in names:
+        return names.index(text.lower()) + (0 if names is _DAYS else 1)
+    raise ValueError(f"bad value {text!r} in {expr!r}")
+
+
+def _item_values(item, lo, hi, names, expr, allow_names=True):
+    """Values an item lists, in order, before any step is applied."""
+    if item == "*":
+        return list(range(lo, hi + 1)), True
+    if "-" in item:
+        a, b = item.split("-", 1)
+        if not a or not b:
+            raise ValueError(f"bad range {item!r} in {expr!r}")
+        a = _number(a, names, allow_names, expr)
+        b = _number(b, names, allow_names, expr)
+        for v in (a, b):
+            if not lo <= v <= hi:
+                raise ValueError(f"{v} out of range in {expr!r}")
+        if names is _DAYS:
+            a %= 7
+            b %= 7
+            if a > b:
+                return list(range(a, 7)) + list(range(0, b + 1)), False
+            return list(range(a, b + 1)), False
+        if a > b:
+            return list(range(a, hi + 1)) + list(range(lo, b + 1)), False
+        return list(range(a, b + 1)), False
+    n = _number(item, names, allow_names, expr)
+    if not lo <= n <= hi:
+        raise ValueError(f"{n} out of range in {expr!r}")
+    return [n], False
+
+
+def _parse_field(text, index, expr):
+    lo, hi, names = _SPECS[index]
+    field = _Field()
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError(f"'?' not allowed in field {index + 1} of {expr!r}")
+        field.any = True
+        return field
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {expr!r}")
+        if index == 2 and item == "L":
+            field.last_dom = True
+            continue
+        if index == 4 and item.endswith("L"):
+            n = item[:-1]
+            if not (n.isdigit() and n.isascii()) or not 0 <= int(n) <= 7:
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            field.last_dow.add(int(n) % 7)
+            continue
+        if index == 4 and "#" in item:
+            n, k = item.split("#", 1)
+            if not (n.isdigit() and n.isascii() and k.isdigit() and k.isascii()):
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            n, k = int(n), int(k)
+            if not 0 <= n <= 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            field.nth_dow.add((n % 7, k))
+            continue
+        if "/" in item:
+            base, step = item.split("/", 1)
+            if not (step.isdigit() and step.isascii()) or int(step) < 1:
+                raise ValueError(f"bad step in {item!r} in {expr!r}")
+            step = int(step)
+            if base.isdigit() and base.isascii():
+                n = int(base)
+                if not lo <= n <= hi:
+                    raise ValueError(f"{n} out of range in {expr!r}")
+                listed = list(range(n, hi + 1))
+            else:
+                listed, _ = _item_values(base, lo, hi, names, expr, allow_names=False)
+            listed = listed[::step]
+            star = False
+        else:
+            listed, star = _item_values(item, lo, hi, names, expr)
+        if star and index in (2, 4):
+            field.any = True
+        if names is _DAYS:
+            listed = [v % 7 for v in listed]
+        field.values.update(listed)
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    return [_parse_field(part, i, expr) for i, part in enumerate(parts)]
+
+
+def _dow(day):
+    """Cron day of week: Sunday is 0."""
+    return (day.weekday() + 1) % 7
+
+
+def _day_allowed(fields, day):
+    minute, hour, dom, month, dow = fields
+    if day.month not in month.values:
+        return False
+    days_in_month = calendar.monthrange(day.year, day.month)[1]
+    if not dom.any:
+        ok = day.day in dom.values or (dom.last_dom and day.day == days_in_month)
+        if not ok:
+            return False
+    if not dow.any:
+        wd = _dow(day)
+        ok = wd in dow.values
+        if not ok and wd in dow.last_dow and day.day + 7 > days_in_month:
+            ok = True
+        if not ok and (wd, (day.day - 1) // 7 + 1) in dow.nth_dow:
+            ok = True
+        if not ok:
+            return False
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    minute, hour = fields[0], fields[1]
+    return (when.minute in minute.values and when.hour in hour.values
+            and _day_allowed(fields, when.date()))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    fields = _parse(expr)
+    minutes = sorted(fields[0].values)
+    hours = sorted(fields[1].values)
+    limit = after + _HORIZON
+    start = after.replace(second=0, microsecond=0) + _dt.timedelta(minutes=1)
+    day = start.date()
+    last_day = limit.date()
+    first = True
+    while day <= last_day:
+        if _day_allowed(fields, day):
+            for h in hours:
+                if first and h < start.hour:
+                    continue
+                for m in minutes:
+                    if first and h == start.hour and m < start.minute:
+                        continue
+                    run = _dt.datetime(day.year, day.month, day.day, h, m)
+                    return run if run <= limit else None
+        first = False
+        day += _dt.timedelta(days=1)
+    return None
