 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+# (minimum, maximum, names) for each field, in order.
+_FIELDS = [(0, 59, {}), (0, 23, {}), (1, 31, {}), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = timedelta(days=3650)
+
+
+def _value(text, index):
+    low, high, names = _FIELDS[index]
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _item(item, index):
+    """The ordered list of values one plain item (not L, NL or N#K) lists."""
+    low, high, _ = _FIELDS[index]
+    base, slash, step = item.partition("/")
+    if slash:
+        if not _NUMBER.fullmatch(step) or int(step) < 1:
+            raise ValueError(f"bad step: {item!r}")
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        first, _, last = base.partition("-")
+        first, last = _value(first, index), _value(last, index)
+        if first <= last:
+            values = list(range(first, last + 1))
+        elif index == _DOW:
+            first, last = first % 7, last % 7
+            if first <= last:
+                values = list(range(first, last + 1))
+            else:
+                values = list(range(first, 7)) + list(range(0, last + 1))
+        else:
+            values = list(range(first, high + 1)) + list(range(low, last + 1))
+    else:
+        first = _value(base, index)
+        values = list(range(first, high + 1)) if slash else [first]
+    if slash:
+        values = values[::int(step)]
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    return values
+
+
+def _parse(expr):
+    """Check expr and return its five fields as (values, specials) pairs.
+
+    values is a set of numbers. specials holds "L" for the last day of the month,
+    ("L", n) for the last weekday n and ("#", n, k) for the k-th weekday n.
+    """
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+    fields = []
+    for index, part in enumerate(parts):
+        values, specials = set(), set()
+        if part == "?" and index in (_DOM, _DOW):
+            part = "*"
+        for item in part.split(","):
+            if index == _DOM and item == "L":
+                specials.add("L")
+                continue
+            if index == _DOW:
+                found = _LAST_DOW.fullmatch(item)
+                if found:
+                    specials.add(("L", _value(found.group(1), index) % 7))
+                    continue
+                found = _NTH_DOW.fullmatch(item)
+                if found:
+                    nth = int(found.group(2))
+                    if not 1 <= nth <= 5:
+                        raise ValueError(f"bad item: {item!r}")
+                    specials.add(("#", _value(found.group(1), index) % 7, nth))
+                    continue
+            values.update(_item(item, index))
+        fields.append((values, specials))
+    return fields
+
+
+def _day_ok(fields, year, month, day):
+    values, specials = fields[_DOM]
+    last = calendar.monthrange(year, month)[1]
+    if day not in values and not ("L" in specials and day == last):
+        return False
+    values, specials = fields[_DOW]
+    weekday = (calendar.weekday(year, month, day) + 1) % 7
+    if weekday in values:
+        return True
+    for special in specials:
+        if special[1] != weekday:
+            continue
+        if special[0] == "L":
+            if day + 7 > last:
+                return True
+        elif (day - 1) // 7 + 1 == special[2]:
+            return True
+    return False
 
 
