 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from collections import namedtuple
+from datetime import date, timedelta
+
+_MONTHS = {"JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+           "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12}
+_DAYS = {"SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6}
+
+# (field name, lowest value, highest value, names allowed in the field)
+_FIELDS = (
+    ("minute", 0, 59, {}),
+    ("hour", 0, 23, {}),
+    ("dom", 1, 31, {}),
+    ("month", 1, 12, _MONTHS),
+    ("dow", 0, 7, _DAYS),
+)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L", re.IGNORECASE)   # NL, e.g. 5L = last Friday
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")           # N#K, e.g. 1#2 = second Monday
+_SEARCH_DAYS = 10 * 365
+_ONE_MINUTE = timedelta(minutes=1)
+
+# minutes, hours, dom: sets of ints; dom_last: 'L' was used.
+# months: set of ints; dow: set of cron weekdays 0-6 (0 = Sunday);
+# dow_nth: set of (weekday, K) pairs; dow_last: set of weekdays used as NL.
+Schedule = namedtuple(
+    "Schedule", "minutes hours dom dom_last months dow dow_nth dow_last")
+
+
+def _value(text, field):
+    """One number or name from a field, range-checked."""
+    name, low, high, names = field
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad {name} value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"{name} value {text!r} is out of range")
+    return value
+
+
+def _listed(item, field):
+    """Values listed by an item: *, N or A-B, optionally followed by /S; in list order."""
+    name, low, high, _ = field
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        start_text, _, end_text = base.partition("-")
+        start = _value(start_text, field)
+        end = _value(end_text, field)
+        if start <= end:
+            values = list(range(start, end + 1))
+        else:
+            # Wrap around. Day-of-week counts 0 to 6 with 7 treated as 0.
+            wrap_high = 6 if name == "dow" else high
+            values = list(range(start, wrap_high + 1)) + list(range(low, end + 1))
+    else:
+        start = _value(base, field)
+        values = list(range(start, high + 1)) if slash else [start]
+    return values[::step]
+
+
+def _field(text, field):
+    """Parse one field into (values, dom_last, dow_nth, dow_last)."""
+    name = field[0]
+    if text == "?" and name in ("dom", "dow"):
+        text = "*"
+    values, last, nth, last_weekdays = set(), False, set(), set()
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {name} field {text!r}")
+        last_match = _LAST_WEEKDAY.fullmatch(item)
+        nth_match = _NTH_WEEKDAY.fullmatch(item)
+        if name == "dom" and item.upper() == "L":
+            last = True
+        elif name == "dow" and last_match:
+            last_weekdays.add(_weekday_number(last_match.group(1)))
+        elif name == "dow" and nth_match:
+            k = int(nth_match.group(2))
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad occurrence in {item!r}")
+            nth.add((_weekday_number(nth_match.group(1)), k))
+        else:
+            values.update(_listed(item, field))
+    if name == "dow":
+        values = {v % 7 for v in values}  # 7 is Sunday, the same as 0
+    return values, last, nth, last_weekdays
+
+
+def _weekday_number(text):
+    """A weekday number 0-7 for N in NL or N#K, reduced so that 7 becomes 0."""
+    number = int(text)
+    if number > 7:
+        raise ValueError(f"bad weekday {text!r}")
+    return number % 7
+
+
+def _compile(expr):
+    """Parse a whole expression; raises ValueError if it is not valid."""
+    if not isinstance(expr, str):
+        raise ValueError(f"schedule must be a string, not {type(expr).__name__}")
+    text = expr.strip()
+    text = _SHORTCUTS.get(text.lower(), text)
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}, found {len(parts)}")
+    minutes, _, _, _ = _field(parts[0], _FIELDS[0])
+    hours, _, _, _ = _field(parts[1], _FIELDS[1])
+    dom, dom_last, _, _ = _field(parts[2], _FIELDS[2])
+    months, _, _, _ = _field(parts[3], _FIELDS[3])
+    dow, _, dow_nth, dow_last = _field(parts[4], _FIELDS[4])
+    return Schedule(frozenset(minutes), frozenset(hours), frozenset(dom), dom_last,
+                    frozenset(months), frozenset(dow), frozenset(dow_nth),
+                    frozenset(dow_last))
+
+
+def _day_allowed(day, s):
+    """True if the date day is allowed by both the day-of-month and day-of-week fields."""
+    if day.month not in s.months:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    weekday = (day.weekday() + 1) % 7  # cron numbering: Sunday is 0
+    dom_ok = day.day in s.dom or (s.dom_last and day.day == last)
+    occurrence = (day.day - 1) // 7 + 1
+    dow_ok = (weekday in s.dow
+              or (weekday, occurrence) in s.dow_nth
+              or (weekday in s.dow_last and day.day + 7 > last))
+    return dom_ok and dow_ok
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _compile(expr)
+    return (when.minute in s.minutes and when.hour in s.hours
+            and _day_allowed(when.date(), s))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    s = _compile(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + _ONE_MINUTE
+    except OverflowError:
+        return None
+    try:
+        limit = after + timedelta(days=_SEARCH_DAYS)
+    except OverflowError:
+        limit = None
+    last_ordinal = date.max.toordinal() if limit is None else limit.date().toordinal()
+    minutes, hours = sorted(s.minutes), sorted(s.hours)
+    start_day = start.date()
+    ordinal = start_day.toordinal()
+    while ordinal <= last_ordinal:
+        day = date.fromordinal(ordinal)
+        if _day_allowed(day, s):
+            same_day = day == start_day
+            for hour in hours:
+                if same_day and hour < start.hour:
+                    continue
+                for minute in minutes:
+                    if same_day and hour == start.hour and minute < start.minute:
+                        continue
+                    run = after.replace(year=day.year, month=day.month, day=day.day,
+                                        hour=hour, minute=minute, second=0, microsecond=0)
+                    if limit is not None and run > limit:
+                        return None
+                    return run
+        ordinal += 1
+    return None
