 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import date, datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAY_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (field name, lowest value, highest value, name table)
+_FIELDS = (
+    ("minute", 0, 59, None),
+    ("hour", 0, 23, None),
+    ("day of month", 1, 31, None),
+    ("month", 1, 12, _MONTH_NAMES),
+    ("day of week", 0, 7, _DAY_NAMES),
+)
+
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_NTH_LAST = re.compile(r"([0-9]+)L", re.IGNORECASE)
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+def _number(tok, lo, hi, names):
+    if names is not None and _NAME.fullmatch(tok) and tok.upper() in names:
+        return names[tok.upper()]
+    if not _DIGITS.fullmatch(tok):
+        raise ValueError(f"bad value {tok!r}")
+    value = int(tok)
+    if not lo <= value <= hi:
+        raise ValueError(f"value {value} outside {lo}-{hi}")
+    return value
+
+
+def _parse_item(item, lo, hi, names, kind):
+    """Return (values, special) for one comma-separated item of a field."""
+    parts = item.split("/")
+    if len(parts) > 2:
+        raise ValueError(f"bad item {item!r}")
+    base = parts[0]
+    step = 1
+    if len(parts) == 2:
+        if not _DIGITS.fullmatch(parts[1]):
+            raise ValueError(f"bad step in {item!r}")
+        step = int(parts[1])
+        if step < 1:
+            raise ValueError("step must be at least 1")
+
+    if kind == "day of month" and base.upper() == "L":
+        return [], ("last",)
+    if kind == "day of week":
+        m = _NTH_LAST.fullmatch(base)
+        if m:
+            return [], ("nth_last", _number(m.group(1), 0, 7, None) % 7)
+        m = _NTH.fullmatch(base)
+        if m:
+            return [], ("nth", _number(m.group(1), 0, 7, None) % 7,
+                        _number(m.group(2), 1, 5, None))
+
+    if base == "*":
+        seq = list(range(lo, hi + 1))
+    elif "-" in base:
+        pieces = base.split("-")
+        if len(pieces) != 2:
+            raise ValueError(f"bad range {base!r}")
+        a = _number(pieces[0], lo, hi, names)
+        b = _number(pieces[1], lo, hi, names)
+        if kind == "day of week" and a == 7 and b < 7:
+            a = 0  # 7 is Sunday, so a range starting there starts at 0
+        if a <= b:
+            seq = list(range(a, b + 1))
+        elif kind == "day of week":
+            seq = list(range(a, 7)) + list(range(0, b + 1))
+        else:
+            seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        v = _number(base, lo, hi, names)
+        # A bare N lists just N; with a step it lists N up to the field's maximum.
+        seq = list(range(v, hi + 1)) if len(parts) == 2 else [v]
+    return seq[::step], None
+
+
+def _parse_field(text, lo, hi, names, kind):
+    """Return (set of values, list of day specials) for one field."""
+    if kind in ("day of month", "day of week") and text == "?":
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        seq, special = _parse_item(item, lo, hi, names, kind)
+        for v in seq:
+            values.add(v % 7 if kind == "day of week" else v)
+        if special is not None:
+            specials.append(special)
+    return values, specials
+
+
+def _parse(expr):
+    """Return the five parsed fields of expr, or raise ValueError."""
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[key]
+    tokens = re.split(r"[ \t]+", text)
+    if len(tokens) != 5:
+        raise ValueError(f"expected 5 fields, got {len(tokens)}: {expr!r}")
+    return [_parse_field(tok, lo, hi, names, kind)
+            for tok, (kind, lo, hi, names) in zip(tokens, _FIELDS)]
+
+
+def _day_allowed(fields, day):
+    dom_values, dom_specials = fields[2]
+    dow_values, dow_specials = fields[4]
+    dim = calendar.monthrange(day.year, day.month)[1]
+    weekday = (day.weekday() + 1) % 7  # Sunday is 0
+    dom_ok = day.day in dom_values or any(
+        s[0] == "last" and day.day == dim for s in dom_specials)
+    dow_ok = weekday in dow_values or any(
+        (s[0] == "nth_last" and s[1] == weekday and day.day > dim - 7)
+        or (s[0] == "nth" and s[1] == weekday and (day.day - 1) // 7 == s[2] - 1)
+        for s in dow_specials)
+    return dom_ok and dow_ok
+
 
