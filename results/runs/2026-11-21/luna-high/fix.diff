+        if date.month in month["values"] and _day_matches(date, dom, dow):
+            start_minute = base.hour * 60 + base.minute if date == base.date() else 0
+            index = bisect_right(times, start_minute - 1)
+            if index < len(times):
+                candidate = datetime.combine(date, time(times[index] // 60, times[index] % 60))
+                if candidate > after and candidate <= limit:
+                    return candidate
+        date += timedelta(days=1)
+    return None
