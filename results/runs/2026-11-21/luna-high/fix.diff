 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import datetime, time, timedelta
+import re
+
+
+_MONTHS = {name: index for index, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1
+)}
+_DAYS = {name: index for index, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _fields(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        stripped = _SHORTCUTS.get(stripped.lower(), "")
+        if not stripped:
+            raise ValueError("unknown schedule shortcut")
+    parts = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    minute = _parse_field(parts[0], 0, 59)
+    hour = _parse_field(parts[1], 0, 23)
+    dom = _parse_field(parts[2], 1, 31, question=True, last=True)
+    month = _parse_field(parts[3], 1, 12, names=_MONTHS)
+    dow = _parse_field(parts[4], 0, 7, question=True, names=_DAYS, weekday=True, special=True)
+    return minute, hour, dom, month, dow
+
+
+def _parse_field(text, low, high, *, question=False, last=False, names=None, weekday=False, special=False):
+    if text == "?":
+        if not question:
+            raise ValueError("? is only valid in day fields")
+        return {"all": True, "values": set(), "last": False, "nth": set(), "last_weekdays": set()}
+    if not text:
+        raise ValueError("empty field")
+    result = {"all": text == "*", "values": set(), "last": False, "nth": set(), "last_weekdays": set()}
+
+    def value(token, allow_name=True):
+        if names and allow_name and token.upper() in names:
+            return names[token.upper()]
+        if not re.fullmatch(r"\d+", token):
+            raise ValueError("bad field value")
+        n = int(token)
+        if not low <= n <= high:
+            raise ValueError("field value out of range")
+        return n
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty list item")
+        if item == "L" and last:
+            result["last"] = True
+            continue
+        if weekday and special:
+            m = re.fullmatch(r"(\d+)(L|#([1-5]))", item, re.IGNORECASE)
+            if m:
+                n = value(m.group(1), allow_name=False)
+                n %= 7
+                if m.group(2).upper() == "L":
+                    result["last_weekdays"].add(n)
+                else:
+                    result["nth"].add((n, int(m.group(3))))
+                continue
+        if "/" in item:
+            if item.count("/") != 1:
+                raise ValueError("bad step")
+            base, step_text = item.split("/")
+            if re.search(r"[A-Za-z]", base):
+                raise ValueError("names are not allowed with a step")
+            if not re.fullmatch(r"\d+", step_text) or int(step_text) < 1:
+                raise ValueError("bad step")
+            step = int(step_text)
+        else:
+            base, step = item, None
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("bad range")
+            left, right = base.split("-")
+            start, end = value(left), value(right)
+            if weekday and start > end:
+                sequence = [start]
+                first = start % 7
+                end = end % 7
+                n = first
+                while n != end:
+                    n = (n + 1) % 7
+                    sequence.append(n)
+            elif start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            if step is not None:
+                sequence = list(range(start, high + 1))
+            else:
+                sequence = [start]
+        if step is not None:
+            sequence = sequence[::step]
+        result["values"].update(n % 7 if weekday else n for n in sequence)
+    return result
+
+
+def _weekday(dt):
+    return (dt.weekday() + 1) % 7
+
+
+def _day_matches(date, dom, dow):
+    day = date.day
+    cron_day = (date.weekday() + 1) % 7
+    dom_ok = dom["all"] or day in dom["values"] or (dom["last"] and day == monthrange(date.year, date.month)[1])
+    if dow["all"]:
+        dow_ok = True
+    else:
+        last_day = monthrange(date.year, date.month)[1]
+        occurrence = (day - 1) // 7 + 1
+        last_weekday = day + 7 > last_day
+        dow_ok = (
+            cron_day in dow["values"]
+            or (cron_day, occurrence) in dow["nth"]
+            or (last_weekday and cron_day in dow["last_weekdays"])
+        )
+    return dom_ok and dow_ok
+
+
+def _run_at(parsed, when):
+    minute, hour, dom, month, dow = parsed
+    return (
+        when.minute in minute["values"]
+        and when.hour in hour["values"]
+        and when.month in month["values"]
+        and _day_matches(when.date(), dom, dow)
+    )
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    parsed = _fields(expr)
