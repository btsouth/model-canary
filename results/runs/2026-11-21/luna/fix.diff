 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(calendar.day_abbr)}
+_RANGES = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _field_values(token, field):
+    lo, hi = _RANGES[field]
+    names = _MONTHS if field == 3 else _DAYS if field == 4 else {}
+
+    def val(s):
+        if s.upper() in names:
+            return names[s.upper()]
+        if not re.fullmatch(r"\d+", s):
+            raise ValueError("invalid schedule value")
+        n = int(s)
+        if not lo <= n <= hi:
+            raise ValueError("schedule value out of range")
+        return n
+
+    if token == "?":
+        if field not in (2, 4):
+            raise ValueError("? only allowed in day fields")
+        token = "*"
+    values = set()
+    specials = set()
+    for item in token.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if field == 2 and item == "L":
+            specials.add("last")
+            continue
+        if field == 4:
+            m = re.fullmatch(r"(\d+)L", item)
+            if m:
+                n = int(m.group(1))
+                if not 0 <= n <= 7: raise ValueError("day out of range")
+                specials.add(("last_weekday", n % 7))
+                continue
+            m = re.fullmatch(r"(\d+)#([1-5])", item)
+            if m:
+                n = int(m.group(1))
+                if not 0 <= n <= 7: raise ValueError("day out of range")
+                specials.add(("nth_weekday", n % 7, int(m.group(2))))
+                continue
+        if item.count("/") > 1:
+            raise ValueError("invalid step")
+        base, slash, step_s = item.partition("/")
+        if slash:
+            if not re.fullmatch(r"\d+", step_s) or int(step_s) < 1:
+                raise ValueError("invalid step")
+            if base not in ("*") and ("-" not in base and not re.fullmatch(r"\d+", base)):
+                raise ValueError("names and special items cannot have steps")
+            step = int(step_s)
+        else:
+            step = 1
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            if base.count("-") != 1: raise ValueError("invalid range")
+            a_s, b_s = base.split("-")
+            a, b = val(a_s), val(b_s)
+            if field == 4:
+                a, b = a % 7, b % 7
+                seq = list(range(a, b + 1)) if a <= b else list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, b + 1)) if a <= b else list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            n = val(base)
+            if slash:
+                seq = list(range(n, hi + 1))
+            else:
+                seq = [n]
+        values.update(seq[::step])
+    if field == 4 and 7 in values:
+        values.add(0)
+        values.discard(7)
+    return values, specials or None
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    source = expr.strip()
+    if source.startswith("@"):
+        try: source = _SHORTCUTS[source.lower()]
+        except KeyError: raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", source) if source else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    parsed = [_field_values(t, i) for i, t in enumerate(fields)]
+    return parsed
+
+
+def _weekday(date):
+    return (date.weekday() + 1) % 7
+
+
+def _day_match(parsed, date):
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    dom_ok = date.day in dom
+    if "last" in (dom_special or ()):
+        dom_ok = dom_ok or date.day == calendar.monthrange(date.year, date.month)[1]
+    wd = _weekday(date)
+    dow_ok = wd in dow
+    for special in dow_special or ():
+        if special[0] == "last_weekday":
+            _, n = special
+            last = calendar.monthrange(date.year, date.month)[1]
+            dow_ok = dow_ok or (wd == n and date.day + 7 > last)
+        else:
+            _, n, k = special
+            dow_ok = dow_ok or (wd == n and (date.day - 1) // 7 + 1 == k)
+    return dom_ok and dow_ok
+
 
