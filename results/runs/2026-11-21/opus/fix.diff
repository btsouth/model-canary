--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,234 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import bisect
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (low, high, names mapped to values or None)
+_MINUTE = (0, 59, None)
+_HOUR = (0, 23, None)
+_DOM = (1, 31, None)
+_MONTH = (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)})
+_DOW = (0, 7, {name: i for i, name in enumerate(_DAYS)})
+
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = _dt.timedelta(days=10 * 365)
+
+
+def _bad(expr, why):
+    return ValueError(f"bad schedule {expr!r}: {why}")
+
+
+def _value(token, spec, expr):
+    low, high, names = spec
+    if _DIGITS.fullmatch(token):
+        value = int(token)
+    elif names is not None and _NAME.fullmatch(token) and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise _bad(expr, f"bad value {token!r}")
+    if not low <= value <= high:
+        raise _bad(expr, f"value {token!r} out of range")
+    return value
+
+
+def _item_values(item, spec, is_dow, expr):
+    """The values a plain item (*, N, A-B, with optional /S) lists, in order."""
+    low, high, _ = spec
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _DIGITS.fullmatch(step_text):
+            raise _bad(expr, f"bad step in {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise _bad(expr, f"step of 0 in {item!r}")
+    else:
+        step = 1
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        first, _, last = base.partition("-")
+        a = _value(first, spec, expr)
+        b = _value(last, spec, expr)
+        if a <= b:
+            values = list(range(a, b + 1))
+        elif is_dow:
+            a, b = a % 7, b % 7
+            values = [a]
+            while values[-1] != b:
+                values.append((values[-1] + 1) % 7)
+        else:
+            values = list(range(a, high + 1)) + list(range(low, b + 1))
+    else:
+        a = _value(base, spec, expr)
+        values = list(range(a, high + 1)) if slash else [a]
+    return values[::step]
+
+
+def _plain_field(text, spec, expr, is_dow=False):
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise _bad(expr, "empty item")
+        values.update(_item_values(item, spec, is_dow, expr))
+    return values
+
+
+def _dom_field(text, expr):
+    """Returns (days, last) or None for every day."""
+    if text == "?":
+        return None
+    days, last = set(), False
+    for item in text.split(","):
+        if not item:
+            raise _bad(expr, "empty item")
+        if item == "L":
+            last = True
+        else:
+            days.update(_item_values(item, _DOM, False, expr))
+    return days, last
+
+
+def _dow_number(token, expr):
+    value = int(token)
+    if not 0 <= value <= 7:
+        raise _bad(expr, f"day of week {token!r} out of range")
+    return value % 7
+
+
+def _dow_field(text, expr):
+    """Returns (weekdays, last_weekdays, nth_weekdays) or None for every day."""
+    if text == "?":
+        return None
+    days, last, nth = set(), set(), set()
+    for item in text.split(","):
+        if not item:
+            raise _bad(expr, "empty item")
+        m = _LAST_DOW.fullmatch(item)
+        if m:
+            last.add(_dow_number(m.group(1), expr))
+            continue
+        m = _NTH_DOW.fullmatch(item)
+        if m:
+            k = int(m.group(2))
+            if not 1 <= k <= 5:
+                raise _bad(expr, f"bad week number in {item!r}")
+            nth.add((_dow_number(m.group(1), expr), k))
+            continue
+        days.update(v % 7 for v in _item_values(item, _DOW, True, expr))
+    return days, last, nth
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"schedule must be a string, not {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            shortcut = _SHORTCUTS.get(text.lower())
+            if shortcut is None:
+                raise _bad(expr, "unknown shortcut")
+            text = shortcut
+        parts = [p for p in re.split(r"[ \t]+", text) if p]
+        if len(parts) != 5 or not re.fullmatch(r"[^ \t]+(?:[ \t]+[^ \t]+){4}", text):
+            raise _bad(expr, "expected five fields")
+        minute, hour, dom, month, dow = parts
+        self.minutes = sorted(_plain_field(minute, _MINUTE, expr))
+        self.hours = sorted(_plain_field(hour, _HOUR, expr))
+        self.dom = _dom_field(dom, expr)
+        self.months = _plain_field(month, _MONTH, expr)
+        self.dow = _dow_field(dow, expr)
+
+    def day_ok(self, day):
+        days_in_month = calendar.monthrange(day.year, day.month)[1]
+        if self.dom is not None:
+            days, last = self.dom
+            if not (day.day in days or (last and day.day == days_in_month)):
+                return False
+        if self.dow is not None:
+            days, last, nth = self.dow
+            weekday = (day.weekday() + 1) % 7
+            if not (weekday in days
+                    or (weekday in last and day.day + 7 > days_in_month)
+                    or (weekday, (day.day - 1) // 7 + 1) in nth):
+                return False
+        return True
+
+    def matches(self, when):
+        return (when.minute in self.minutes and when.hour in self.hours
+                and when.month in self.months and self.day_ok(when.date()))
+
+    def next_run(self, after):
+        try:
+            limit = after + _LIMIT
+        except OverflowError:
+            limit = _dt.datetime.max
+        try:
+            start = after.replace(second=0, microsecond=0) + _dt.timedelta(minutes=1)
+        except OverflowError:
+            return None
+        day = start.date()
+        last_day = limit.date()
+        one_day = _dt.timedelta(days=1)
+        while day <= last_day:
+            if day.month not in self.months:
+                # Jump to the first day of the next month.
+                if day.month == 12:
+                    if day.year == _dt.MAXYEAR:
+                        return None
+                    day = _dt.date(day.year + 1, 1, 1)
+                else:
+                    day = _dt.date(day.year, day.month + 1, 1)
+                continue
+            if self.day_ok(day):
+                found = self._first_time(day, start)
+                if found is not None:
+                    return found if found <= limit else None
+            if day == _dt.date.max:
+                return None
+            day += one_day
+        return None
+
+    def _first_time(self, day, start):
+        hour_from = minute_from = 0
+        if day == start.date():
+            hour_from, minute_from = start.hour, start.minute
+        i = bisect.bisect_left(self.hours, hour_from)
+        if i == len(self.hours):
+            return None
+        hour = self.hours[i]
+        if hour == hour_from:
+            j = bisect.bisect_left(self.minutes, minute_from)
+            if j < len(self.minutes):
+                return _dt.datetime(day.year, day.month, day.day, hour, self.minutes[j])
+            if i + 1 == len(self.hours):
+                return None
+            hour = self.hours[i + 1]
+        return _dt.datetime(day.year, day.month, day.day, hour, self.minutes[0])
 
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _Schedule(expr).matches(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    return _Schedule(expr).next_run(after)
