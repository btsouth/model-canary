 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from bisect import bisect_left
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f"value out of range: {token!r}")
+        return number
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    maximum = high
+    for item in text.split(","):
+        if item == "L" and index == 2:
+            specials.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if index == 4 and (last or nth):
+            match = last or nth
+            weekday = value(match[1]) % 7
+            if last:
+                specials.append(("last_weekday", weekday))
+            else:
+                count = _number(nth[2])
+                if not 1 <= count <= 5:
+                    raise ValueError("weekday occurrence out of range")
+                specials.append(("nth_weekday", weekday, count))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            ordered = list(range(low, maximum + 1))
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(value, endpoints)
+            if start <= end:
+                ordered = list(range(start, end + 1))
+            else:
+                if index == 4:
+                    start, end = start % 7, end % 7
+                    ordered = [start]
+                    while ordered[-1] != end:
+                        ordered.append((ordered[-1] + 1) % 7)
+                else:
+                    ordered = list(range(start, maximum + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            ordered = list(range(start, maximum + 1)) if len(pieces) == 2 else [start]
+        selected = ordered[::step]
+        if index == 4:
+            values.update(n % 7 for n in selected)
+        else:
+            values.update(selected)
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    text = expr.strip().upper()
+    text = _SHORTCUTS.get(text.lower(), text)
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_matches(parsed, day):
+    month_days, month_specials = parsed[2]
+    weekdays, week_specials = parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom = day.day in month_days or (bool(month_specials) and day.day == last_day)
+    dow = weekday in weekdays
+    for special in week_specials:
+        if weekday == special[1]:
+            if special[0] == "last_weekday":
+                dow = dow or day.day + 7 > last_day
+            else:
+                dow = dow or (day.day - 1) // 7 + 1 == special[2]
+    return dom and dow
+
 
