 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import date, datetime
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTH_NAMES = dict(
+    zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13))
+)
+_WEEKDAY_NAMES = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_WEEKDAY_RULE = re.compile(r"([0-9]+)(?:L|#([0-9]+))")
+_HORIZON_DAYS = 10 * 365
+
+
+def _number(text, maximum):
+    if not text.isascii() or not text.isdecimal():
+        raise ValueError(f"invalid number: {text!r}")
+    digits = text.lstrip("0")
+    if len(digits) > len(str(maximum)):
+        return maximum + 1
+    return int(digits or "0")
+
+
+def _value(text, minimum, maximum, names):
+    if names:
+        named_value = names.get(text.upper())
+        if named_value is not None:
+            return named_value
+    value = _number(text, maximum)
+    if not minimum <= value <= maximum:
+        raise ValueError(f"value outside {minimum}-{maximum}: {text!r}")
+    return value
+
+
+def _item(text, minimum, maximum, names=None):
+    base, slash, step_text = text.partition("/")
+    # A step over 99 can only select the first value in any field.
+    step = _number(step_text, 99) if slash else 1
+    if step == 0:
+        raise ValueError("step must be positive")
+
+    if base == "*":
+        values = range(minimum, maximum + 1)
+    else:
+        first, dash, last = base.partition("-")
+        start = _value(first, minimum, maximum, names)
+        if not dash:
+            values = range(start, maximum + 1 if slash else start + 1)
+        else:
+            end = _value(last, minimum, maximum, names)
+            if start > end and names is _WEEKDAY_NAMES:
+                start %= 7
+                maximum = 6
+            if start <= end:
+                values = range(start, end + 1)
+            else:
+                values = [*range(start, maximum + 1), *range(minimum, end + 1)]
+    selected = values[::step]
+    if names is _WEEKDAY_NAMES:
+        return {value % 7 for value in selected}
+    return set(selected)
+
+
+def _field(text, minimum, maximum, names=None):
+    values = set()
+    for item in text.split(","):
+        values.update(_item(item, minimum, maximum, names))
+    return values
+
+
+def _month_days(text):
+    values = set()
+    last_date = False
+    for item in ("*" if text == "?" else text).split(","):
+        if item == "L":
+            last_date = True
+        else:
+            values.update(_item(item, 1, 31))
+    return values, last_date
+
+
+def _week_days(text):
+    values = set()
+    last_days = set()
+    nth_days = set()
+    for item in ("*" if text == "?" else text).split(","):
+        rule = _WEEKDAY_RULE.fullmatch(item)
+        if rule is None:
+            values.update(_item(item, 0, 7, _WEEKDAY_NAMES))
+            continue
+        day_text, nth_text = rule.groups()
+        day = _value(day_text, 0, 7, None) % 7
+        if nth_text is None:
+            last_days.add(day)
+        else:
+            nth_days.add((day, _value(nth_text, 1, 5, None)))
+    return values, last_days, nth_days
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be a string")
+    expr = expr.strip()
+    if not expr.isascii():
+        raise ValueError("schedule fields must be ASCII")
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    minute, hour, month_day, month, week_day = fields
+    return (
+        _field(minute, 0, 59),
+        _field(hour, 0, 23),
+        _month_days(month_day),
+        _field(month, 1, 12, _MONTH_NAMES),
+        _week_days(week_day),
+    )
+
+
+def _matches_day(day, month_days, week_days):
+    dates, last_date = month_days
+    weekdays, last_weekdays, nth_weekdays = week_days
+    if day.day not in dates:
+        if not last_date or day.day != monthrange(day.year, day.month)[1]:
+            return False
+    weekday = (day.weekday() + 1) % 7
+    return (
+        weekday in weekdays
+        or (weekday, (day.day - 1) // 7 + 1) in nth_weekdays
+        or (weekday in last_weekdays and day.day + 7 > monthrange(day.year, day.month)[1])
+    )
+
 
