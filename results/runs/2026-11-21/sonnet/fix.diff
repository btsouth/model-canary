 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names.index(tok.upper()) + (1 if names is _MONTHS else 0)
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _field(text, lo, hi, names=None, kind=None):
+    """Parse a field. Returns (set of values, specials)."""
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("? not allowed here")
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item.upper() == "L":
+            specials.append(("L",))
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)[lL]", item)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError("bad day of week")
+                specials.append(("NL", n % 7))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if n > 7 or not 1 <= k <= 5:
+                    raise ValueError("bad day of week")
+                specials.append(("NK", n % 7, k))
+                continue
+        if "/" in item:
+            base, s = item.split("/", 1)
+            if not _NUM.fullmatch(s) or int(s) < 1:
+                raise ValueError(f"bad step {s!r}")
+            step = int(s)
+            if "-" not in base and base != "*":
+                a = _value(base, lo, hi, None)
+                vals = list(range(a, hi + 1))[::step]
+                values.update(v % 7 if kind == "dow" else v for v in vals)
+                continue
+            # ranges and * : names allowed in the range, not in the step
+            vals = _expand_range(base, lo, hi, names, kind == "dow")[::step]
+        else:
+            vals = _expand_range(item, lo, hi, names, kind == "dow")
+        values.update(v % 7 if kind == "dow" else v for v in vals)
+    return values, specials
+
+
+def _expand_range(item, lo, hi, names, is_dow):
+    top = 6 if is_dow else hi
+    if item == "*":
+        return list(range(lo, top + 1))
+    if "-" in item:
+        a, _, b = item.partition("-")
+        a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+        if a <= b:
+            return list(range(a, b + 1))
+        if is_dow:
+            return list(range(a % 7, 7)) + list(range(0, b + 1))
+        return list(range(a, hi + 1)) + list(range(lo, b + 1))
+    return [_value(item, lo, hi, names)]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        if expr.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        expr = _SHORTCUTS[expr.lower()]
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minutes, _ = _field(parts[0], 0, 59)
+    hours, _ = _field(parts[1], 0, 23)
+    dom, dom_sp = _field(parts[2], 1, 31, None, "dom")
+    months, _ = _field(parts[3], 1, 12, _MONTHS)
+    dow, dow_sp = _field(parts[4], 0, 7, _DAYS, "dow")
+    return sorted(minutes), sorted(hours), (dom, dom_sp), months, (dow, dow_sp)
+
+
+def _day_ok(day, dom_spec, dow_spec):
+    dom, dom_sp = dom_spec
+    dow, dow_sp = dow_spec
+    last = calendar.monthrange(day.year, day.month)[1]
+    if not (day.day in dom or (dom_sp and day.day == last)):
+        return False
+    wd = (day.weekday() + 1) % 7
+    if wd in dow:
+        return True
+    for sp in dow_sp:
+        if sp[1] != wd:
+            continue
+        if sp[0] == "NL" and day.day + 7 > last:
+            return True
+        if sp[0] == "NK" and (day.day - 1) // 7 + 1 == sp[2]:
+            return True
+    return False
 
 
