 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if i}
+_DAYS = dict(zip(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        lo, hi = _BOUNDS[index]
+        if field == '?' and index in (2, 4):
+            field = '*'
+        values, special = set(), []
+
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in names:
+                value = names[token.upper()]
+            else:
+                raise ValueError('invalid value')
+            if not lo <= value <= hi:
+                raise ValueError('value out of range')
+            return value
+
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            m = re.fullmatch(r'(0*[0-7])(?:L|#(0*[1-5]))', item) if index == 4 else None
+            if m:
+                special.append(('weekday', int(m[1]) % 7, int(m[2]) if m[2] else None))
+                continue
+            parts = item.split('/')
+            if len(parts) > 2 or not parts[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(parts) == 2:
+                if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(parts[1])
+            base = parts[0]
+            if base == '*':
+                sequence = list(range(lo, hi + 1))
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                a, b = map(number, ends)
+                if index == 4:
+                    a, b = a % 7, b % 7
+                    sequence = list(range(a, b + 1)) if a <= b else list(range(a, 7)) + list(range(0, b + 1))
+                else:
+                    sequence = list(range(a, b + 1)) if a <= b else list(range(a, hi + 1)) + list(range(lo, b + 1))
+            else:
+                a = number(base)
+                sequence = list(range(a, hi + 1)) if len(parts) == 2 else [a]
+            values.update((v % 7 if index == 4 else v) for v in sequence[::step])
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    dom, dow = parsed[2], parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dom_ok = date.day in dom[0] or (('last',) in dom[1] and date.day == last)
+    dow_ok = weekday in dow[0] or any(
+        weekday == n and (date.day + 7 > last if k is None else (date.day - 1) // 7 + 1 == k)
+        for _, n, k in dow[1])
+    return dom_ok and dow_ok
+
 
