 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())},
+}
+
+
+def _number(token):
+    if not re.fullmatch(r'[0-9]+', token):
+        raise ValueError('expected decimal digits')
+    return int(token)
+
+
+def _value(token, field):
+    value = _NAMES.get(field, {}).get(token.upper())
+    if value is None:
+        value = _number(token)
+    low, high = _BOUNDS[field]
+    if not low <= value <= high:
+        raise ValueError('schedule value out of range')
+    return value
+
+
+def _field(text, field):
+    values, specials = set(), []
+    low, high = _BOUNDS[field]
+    if text == '?' and field in (2, 4):
+        text = '*'
+    for item in text.split(','):
+        if item == 'L' and field == 2:
+            specials.append(('last',))
+            continue
+        special = re.fullmatch(r'([0-9]+)(L|#[0-9]+)', item)
+        if special and field == 4:
+            day = _value(special[1], field) % 7
+            if special[2].startswith('#') and not 1 <= _number(special[2][1:]) <= 5:
+                raise ValueError('weekday occurrence out of range')
+            specials.append(('weekday', day, special[2]))
+            continue
+        pieces = item.split('/')
+        if len(pieces) > 2:
+            raise ValueError('invalid step')
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            sequence = list(range(low, high + 1))
+        elif '-' in base:
+            ends = base.split('-')
+            if len(ends) != 2:
+                raise ValueError('invalid range')
+            start, end = (_value(token, field) for token in ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif field == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _value(base, field)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(v % 7 if field == 4 else v for v in sequence[::step])
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five schedule fields')
+    return [_field(text, i) for i, text in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_specials = fields[2]
+    if day.day not in dom and not (dom_specials and day.day == last):
+        return False
+    dow, dow_specials = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    if weekday in dow:
+        return True
+    return any(weekday == n and (
+        day.day + 7 > last if rule == 'L' else (day.day - 1) // 7 + 1 == int(rule[1:])
+    ) for _, n, rule in dow_specials)
+
 
