 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"expected decimal digits: {token!r}")
+    digits = token.lstrip("0")
+    # Every field has fewer than 100 values. Larger numbers are equivalent
+    # both for range validation and for stepping through an item.
+    return int(digits or "0") if len(digits) <= 2 else 100
+
+
+def _value(token, low, high, names):
+    value = names[token] if token in names else _number(token)
+    if not low <= value <= high:
+        raise ValueError(f"value outside {low}-{high}: {token!r}")
+    return value
+
+
+def _item_values(item, low, high, names):
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text) if slash else 1
+    if step == 0:
+        raise ValueError("step must be positive")
+    if base == "*":
+        start, end = low, high
+    else:
+        first, dash, last = base.partition("-")
+        start = _value(first, low, high, names)
+        end = _value(last, low, high, names) if dash else start
+        if slash and not dash:
+            end = high
+
+    if start <= end:
+        values = list(range(start, end + 1))
+    elif names is _WEEKDAYS:
+        start %= 7
+        values = [(start + offset) % 7 for offset in range((end - start) % 7 + 1)]
+    else:
+        values = [*range(start, high + 1), *range(low, end + 1)]
+    return values[::step]
+
+
+def _values(field, low, high, names=()):
+    values = set()
+    for item in field.split(","):
+        values.update(_item_values(item, low, high, names))
+    return values
+
+
+@dataclass
+class _Schedule:
+    minutes: set
+    hours: set
+    days: set
+    months: set
+    weekdays: set
+    last_day: bool
+    last_weekdays: set
+    nth_weekdays: set
+
+    def allows_date(self, day):
+        if day.month not in self.months:
+            return False
+        last = monthrange(day.year, day.month)[1]
+        if day.day not in self.days and not (self.last_day and day.day == last):
+            return False
+        weekday = (day.weekday() + 1) % 7
+        return (weekday in self.weekdays
+                or (weekday in self.last_weekdays and day.day + 7 > last)
+                or (weekday, (day.day - 1) // 7 + 1) in self.nth_weekdays)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    if not expr.isascii():
+        raise ValueError("expected ASCII schedule fields")
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    minute, hour, day, month, weekday = re.split(r"[ \t]+", expr)
+    days = set()
+    last_day = False
+    for item in ("*" if day == "?" else day).split(","):
+        if item == "L":
+            last_day = True
+        else:
+            days.update(_item_values(item, 1, 31, ()))
+
+    weekdays = set()
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in ("*" if weekday == "?" else weekday).split(","):
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if special:
+            number = _value(special[1], 0, 7, ()) % 7
+            if special[2] == "L":
+                last_weekdays.add(number)
+            else:
+                nth_weekdays.add((number, _value(special[3], 1, 5, ())))
+        else:
+            weekdays.update(n % 7 for n in _item_values(item.upper(), 0, 7, _WEEKDAYS))
+
+    return _Schedule(_values(minute, 0, 59), _values(hour, 0, 23), days,
+                     _values(month.upper(), 1, 12, _MONTHS), weekdays,
+                     last_day, last_weekdays, nth_weekdays)
+
 
