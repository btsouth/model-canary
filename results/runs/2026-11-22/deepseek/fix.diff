 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ("jan", "feb", "mar", "apr", "may", "jun",
+         "jul", "aug", "sep", "oct", "nov", "dec"),
+        1,
+    )
+}
+_DOW_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ("sun", "mon", "tue", "wed", "thu", "fri", "sat")
+    )
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_FIELD_NAMES = ("minute", "hour", "day_of_month", "month", "day_of_week")
+_FIELD_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_FIELD_NAMESETS = (None, None, None, _MONTH_NAMES, _DOW_NAMES)
+
+
+class _Schedule:
+    __slots__ = (
+        "minutes", "hours", "months", "days_of_month", "last_day",
+        "days_of_week", "last_weekdays", "nth_weekdays",
+        "minute_list", "hour_list",
+    )
+
+    def __init__(self, minutes, hours, months, days_of_month, last_day,
+                 days_of_week, last_weekdays, nth_weekdays):
+        self.minutes = set(minutes)
+        self.hours = set(hours)
+        self.months = set(months)
+        self.days_of_month = set(days_of_month)
+        self.last_day = last_day
+        self.days_of_week = set(days_of_week)
+        self.last_weekdays = set(last_weekdays)
+        self.nth_weekdays = set(nth_weekdays)
+        self.minute_list = sorted(self.minutes)
+        self.hour_list = sorted(self.hours)
+
+
+def _is_number(text):
+    return _NUMBER.fullmatch(text) is not None
+
+
+def _parse_value(text, field, low, high, names):
+    if _is_number(text):
+        value = int(text)
+        if value < low or value > high:
+            raise ValueError(f"{_FIELD_NAMES[field]} value out of range: {text!r}")
+        return value
+    if names is not None and len(text) == 3:
+        value = names.get(text.lower())
+        if value is not None:
+            return value
+    raise ValueError(f"bad {_FIELD_NAMES[field]} value: {text!r}")
+
+
+def _range_values(start, end, low, high, field):
+    if field == 4:  # day of week
+        if start <= end:
+            return list(range(start, end + 1))
+        # A wrapping day-of-week range counts 0, 1, ..., 6 with 7 being Sunday.
+        start %= 7
+        end %= 7
+        if start <= end:
+            return list(range(start, end + 1))
+        return list(range(start, 7)) + list(range(0, end + 1))
+
+    if start <= end:
+        return list(range(start, end + 1))
+    return list(range(start, high + 1)) + list(range(low, end + 1))
+
+
+def _parse_field(text, field):
+    low, high = _FIELD_LIMITS[field]
+    names = _FIELD_NAMESETS[field]
+
+    if field in (2, 4) and text == "?":
+        text = "*"
+
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+
+        if "/" in item:
+            pieces = item.split("/")
+            if len(pieces) != 2:
+                raise ValueError(f"bad step: {item!r}")
+            base, step_text = pieces
+            if not _is_number(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+            has_step = True
+        else:
+            base = item
+            step = 1
+            has_step = False
+
+        if field == 2 and base == "L":
+            if has_step:
+                raise ValueError(f"bad day-of-month item: {item!r}")
+            last_day = True
+            continue
+
+        if field == 4:
+            match = _LAST_WEEKDAY.fullmatch(base)
+            if match is not None:
+                if has_step:
+                    raise ValueError(f"bad day-of-week item: {item!r}")
+                number = int(match.group(1))
+                if number > 7:
+                    raise ValueError(f"bad day-of-week item: {item!r}")
+                last_weekdays.add(number % 7)
+                continue
+
+            match = _NTH_WEEKDAY.fullmatch(base)
+            if match is not None:
+                if has_step:
+                    raise ValueError(f"bad day-of-week item: {item!r}")
+                number = int(match.group(1))
+                nth = int(match.group(2))
+                if number > 7 or nth < 1 or nth > 5:
+                    raise ValueError(f"bad day-of-week item: {item!r}")
+                nth_weekdays.add((number % 7, nth))
+                continue
+
+        if base == "*":
+            listed = list(range(low, high + 1))
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError(f"bad range: {item!r}")
+            start = _parse_value(endpoints[0], field, low, high, names)
+            end = _parse_value(endpoints[1], field, low, high, names)
+            listed = _range_values(start, end, low, high, field)
+        else:
+            value = _parse_value(base, field, low, high, names)
+            if has_step:
+                # N/S only takes a number, not a name.
+                if names is not None and not _is_number(base):
+                    raise ValueError(f"bad step: {item!r}")
+                listed = list(range(value, high + 1))
+            else:
+                listed = [value]
+
+        if has_step:
+            listed = listed[::step]
+
+        for value in listed:
+            values.add(value % 7 if field == 4 else value)
+
+    return values, last_day, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    shortcut = _SHORTCUTS.get(text.lower())
+    if shortcut is not None:
+        text = shortcut
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"wrong number of fields: {expr!r}")
+
+    parsed = [_parse_field(field_text, index)
+              for index, field_text in enumerate(fields)]
+
+    return _Schedule(
+        minutes=parsed[0][0],
+        hours=parsed[1][0],
+        months=parsed[3][0],
+        days_of_month=parsed[2][0],
+        last_day=parsed[2][1],
+        days_of_week=parsed[4][0],
+        last_weekdays=parsed[4][2],
+        nth_weekdays=parsed[4][3],
+    )
+
+
+def _day_matches(date, schedule):
+    last = calendar.monthrange(date.year, date.month)[1]
+
+    day_of_month_ok = date.day in schedule.days_of_month
+    if not day_of_month_ok and schedule.last_day and date.day == last:
+        day_of_month_ok = True
+    if not day_of_month_ok:
+        return False
+
+    weekday = (date.weekday() + 1) % 7
+    day_of_week_ok = weekday in schedule.days_of_week
+    if not day_of_week_ok and weekday in schedule.last_weekdays and date.day + 7 > last:
+        day_of_week_ok = True
+    if not day_of_week_ok:
+        occurrence = (date.day - 1) // 7 + 1
+        for number, nth in schedule.nth_weekdays:
+            if weekday == number and occurrence == nth:
+                day_of_week_ok = True
+                break
+
+    return day_of_week_ok
+
+
+def _earliest_time(date, lower, schedule):
+    start_hour, start_minute = lower
+    index = bisect.bisect_left(schedule.hour_list, start_hour)
+    for hour in schedule.hour_list[index:]:
+        first_minute = start_minute if hour == start_hour else 0
+        minute_index = bisect.bisect_left(schedule.minute_list, first_minute)
+        if minute_index < len(schedule.minute_list):
+            return hour, schedule.minute_list[minute_index]
+    return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
