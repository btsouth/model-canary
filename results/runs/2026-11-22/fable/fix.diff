 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (minimum, maximum, names) for each of the five fields
+_FIELDS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_LIMIT = datetime.timedelta(days=10 * 365)
+_SPECIAL_DOW = re.compile(r"(\d+)(L|#(\d+))")
+
+
+class _Schedule:
+    """A parsed expression."""
+
+    __slots__ = ("minutes", "hours", "months", "doms", "dom_last",
+                 "dows", "dow_last", "dow_nth", "times")
+
+    def __init__(self, expr):
+        text = expr.strip()
+        if text.startswith("@"):
+            try:
+                text = _SHORTCUTS[text.lower()]
+            except KeyError:
+                raise ValueError(f"unknown shortcut: {expr!r}") from None
+        parts = re.split(r"[ \t]+", text) if text else []
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields: {expr!r}")
+        self.minutes = _parse_field(parts[_MINUTE], _MINUTE)
+        self.hours = _parse_field(parts[_HOUR], _HOUR)
+        self.doms, self.dom_last = _parse_dom(parts[_DOM])
+        self.months = _parse_field(parts[_MONTH], _MONTH)
+        self.dows, self.dow_last, self.dow_nth = _parse_dow(parts[_DOW])
+        self.times = sorted((h, m) for h in self.hours for m in self.minutes)
+
+    def day_allowed(self, year, month, day):
+        if self.doms is not None:
+            if day not in self.doms and not (
+                self.dom_last and day == calendar.monthrange(year, month)[1]
+            ):
+                return False
+        if self.dows is not None:
+            dow = (datetime.date(year, month, day).weekday() + 1) % 7
+            if dow in self.dows:
+                return True
+            nth = (day - 1) // 7 + 1
+            if (dow, nth) in self.dow_nth:
+                return True
+            last = calendar.monthrange(year, month)[1]
+            if dow in self.dow_last and day + 7 > last:
+                return True
+            return False
+        return True
+
+
+def _number(text, field, allow_names):
+    """A single value of a field, as a number, checked against the field's range."""
+    low, high, names = _FIELDS[field]
+    if text.isdigit() and text.isascii():
+        value = int(text)
+    elif allow_names and names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {value} out of range {low}-{high}")
+    return value
+
+
+def _parse_item(item, field):
+    """The values an item lists, in order, as a list of ints."""
+    low, high, _ = _FIELDS[field]
+    step = 1
+    if "/" in item:
+        base, _, step_text = item.partition("/")
+        if not (step_text.isdigit() and step_text.isascii()) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    else:
+        base = item
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        a_text, _, b_text = base.partition("-")
+        a, b = _number(a_text, field, True), _number(b_text, field, True)
+        if a <= b:
+            values = list(range(a, b + 1))
+        else:
+            values = list(range(a, high + 1)) + list(range(low, b + 1))
+    else:
+        n = _number(base, field, True)
+        values = list(range(n, high + 1)) if step > 1 else [n]
+    return values[::step]
+
+
+def _items(text):
+    items = text.split(",")
+    if any(not item for item in items):
+        raise ValueError(f"empty item in {text!r}")
+    return items
+
+
+def _parse_field(text, field):
+    """A plain field (minute, hour, month) as a set of allowed values."""
+    values = set()
+    for item in _items(text):
+        values.update(_parse_item(item, field))
+    return values
+
+
+def _parse_dom(text):
+    """Day of month: (set of days or None for every day, whether L is present)."""
+    if text in ("*", "?"):
+        return None, False
+    days, last = set(), False
+    for item in _items(text):
+        if item == "L":
+            last = True
+        else:
+            days.update(_parse_item(item, _DOM))
+    return days, last
+
+
+def _parse_dow(text):
+    """Day of week: (set of days or None, set of N for NL, set of (N, K) for N#K)."""
+    if text in ("*", "?"):
+        return None, set(), set()
+    days, last, nth = set(), set(), set()
+    for item in _items(text):
+        special = _SPECIAL_DOW.fullmatch(item)
+        if special is not None:
+            n = _number(special.group(1), _DOW, False) % 7
+            if special.group(2) == "L":
+                last.add(n)
+            else:
+                k = int(special.group(3))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad week number in {item!r}")
+                nth.add((n, k))
+        else:
+            days.update(v % 7 for v in _parse_item(item, _DOW))
+    return days, last, nth
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    sched = _Schedule(expr)
