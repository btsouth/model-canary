+            day = datetime.date(year, month, 1)
+            first = 0
+            continue
+        if sched.day_allowed(day.year, day.month, day.day) and first < len(sched.times):
+            hour, minute = sched.times[first]
+            run = datetime.datetime(day.year, day.month, day.day, hour, minute)
+            return run if run <= limit else None
+        day += one_day
+        first = 0
+    return None
