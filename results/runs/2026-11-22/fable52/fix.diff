 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = timedelta(days=10 * 365)
+
+# (minimum, maximum, names) for each field
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+_SPECS = [(0, 59, {}), (0, 23, {}), (1, 31, {}), (1, 12, _MONTHS), (0, 7, _DAYS)]
+
+
+def _number(text, lo, hi, what):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad {what}: {text!r}")
+    value = int(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"{what} out of range: {text!r}")
+    return value
+
+
+def _value(text, kind):
+    lo, hi, names = _SPECS[kind]
+    name = text.upper()
+    if name in names:
+        return names[name]
+    return _number(text, lo, hi, "value")
+
+
+def _parse_field(text, kind):
+    """Return (values, every, last, last_days, nth_days) for one field."""
+    lo, hi, _ = _SPECS[kind]
+    values, every, last, last_days, nth_days = set(), False, False, set(), set()
+    if text == "?":
+        if kind not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        return values, True, last, last_days, nth_days
+    all_stars = True
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if item != "*":
+            all_stars = False
+        if kind == _DOM and item == "L":
+            last = True
+            continue
+        if kind == _DOW:
+            if item[-1] == "L" and _NUMBER.fullmatch(item[:-1]):
+                last_days.add(_number(item[:-1], 0, 7, "day") % 7)
+                continue
+            if "#" in item:
+                day, _, nth = item.partition("#")
+                nth_days.add((_number(day, 0, 7, "day") % 7, _number(nth, 1, 5, "count")))
+                continue
+        base, slash, step = item.partition("/")
+        if slash:
+            if not _NUMBER.fullmatch(step) or int(step) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step)
+        else:
+            step = 1
+        if base == "*":
+            listed = list(range(lo, 7 if kind == _DOW else hi + 1))
+        elif "-" in base:
+            first, _, second = base.partition("-")
+            a, b = _value(first, kind), _value(second, kind)
+            if a <= b:
+                listed = list(range(a, b + 1))
+            elif kind == _DOW:
+                a, b = a % 7, b % 7
+                listed = [a]
+                while listed[-1] != b:
+                    listed.append((listed[-1] + 1) % 7)
+            else:
+                listed = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, kind)
+            listed = list(range(a, hi + 1)) if slash else [a]
+        listed = listed[::step]
+        if kind == _DOW:
+            listed = [v % 7 for v in listed]
+        values.update(listed)
+    return values, all_stars, last, last_days, nth_days
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad schedule: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+    return [_parse_field(field, kind) for kind, field in enumerate(fields)]
+
+
+def _day_allowed(spec, year, month, day):
+    if month not in spec[_MONTH][0]:
+        return False
+    values, every, last, _, _ = spec[_DOM]
+    weekday, length = calendar.monthrange(year, month)
+    if not (every or day in values or (last and day == length)):
+        return False
+    values, every, _, last_days, nth_days = spec[_DOW]
+    if every:
+        return True
+    dow = (weekday + day) % 7  # monthrange: Monday is 0; cron: Sunday is 0
+    return (
+        dow in values
+        or (dow in last_days and day + 7 > length)
+        or (dow, (day - 1) // 7 + 1) in nth_days
+    )
 
 
