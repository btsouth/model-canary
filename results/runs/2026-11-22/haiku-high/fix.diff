+def _split(text):
+    """Split text on unquoted SEP. Each field is a list of (char, quoted) pairs.
+
+    Quote characters are not kept. Two QUOTE characters in a row inside quotes give
+    one literal QUOTE. A quote that is never closed raises ValueError.
+    """
+    fields = [[]]
+    quoted = False
+    i = 0
+    while i < len(text):
+        ch = text[i]
+        if ch == QUOTE:
+            if quoted and text[i + 1:i + 2] == QUOTE:
+                fields[-1].append((QUOTE, True))
+                i += 2
+                continue
+            quoted = not quoted
+        elif ch == SEP and not quoted:
+            fields.append([])
+        else:
+            fields[-1].append((ch, quoted))
+        i += 1
+    if quoted:
+        raise ValueError(f"quote never closed in {text!r}")
+    return fields
+
+
+def _trim(chars):
+    """Drop unquoted whitespace from both ends of a list of (char, quoted) pairs."""
+    start, end = 0, len(chars)
+    while start < end and not chars[start][1] and chars[start][0].isspace():
+        start += 1
+    while end > start and not chars[end - 1][1] and chars[end - 1][0].isspace():
+        end -= 1
+    return chars[start:end]
+
+
+def _text(chars):
+    return "".join(ch for ch, _ in chars)
+
