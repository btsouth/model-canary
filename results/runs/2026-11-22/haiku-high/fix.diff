 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import datetime as _dt
+import re
+from calendar import monthrange
+from collections import namedtuple
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_DIGITS = re.compile(r"[0-9]+")
+_WORD = re.compile(r"[A-Za-z]{3}")
+_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+_LAST_OF = re.compile(r"([0-9]+)L")
+
+# How far past `after` next_run() looks: 10 * 365 days.
+_SEARCH_DAYS = 10 * 365
+
+_Parsed = namedtuple(
+    "_Parsed", "minutes hours days dom_last months weekdays nth nth_last")
+
+
+def _digits(tok):
+    if not _DIGITS.fullmatch(tok):
+        raise ValueError(f"not a number: {tok!r}")
+    return int(tok)
+
+
+def _value(tok, lo, hi, names=None):
+    """One value: a number from lo to hi, or a name from names."""
+    if names is not None and _WORD.fullmatch(tok):
+        if tok.upper() not in names:
+            raise ValueError(f"unknown name: {tok!r}")
+        return names[tok.upper()]
+    n = _digits(tok)
+    if not lo <= n <= hi:
+        raise ValueError(f"{n} is outside {lo}-{hi}")
+    return n
+
+
+def _parse_field(text, lo, hi, names=None, dom=False, dow=False):
+    """Parse one field. Returns (values, last, nth, nth_last).
+
+    values is a set of numbers (day-of-week values are reduced mod 7). last is True
+    for L. nth is a set of (weekday, K) pairs for N#K, and nth_last a set of weekdays
+    for NL.
+    """
+    if text == "?":
+        if not (dom or dow):
+            raise ValueError(f"? is not allowed in {text!r}")
+        text = "*"
+    values, last, nth, nth_last = set(), False, set(), set()
+    for item in text.split(","):
+        if dom and item == "L":
+            last = True
+            continue
+        if dow:
+            match = _NTH.fullmatch(item)
+            if match:
+                weekday = _value(match.group(1), 0, 7) % 7
+                k = _digits(match.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"K must be 1 to 5: {item!r}")
+                nth.add((weekday, k))
+                continue
+            match = _LAST_OF.fullmatch(item)
+            if match:
+                nth_last.add(_value(match.group(1), 0, 7) % 7)
+                continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            step = _digits(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1: {item!r}")
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        else:
+            a_text, dash, b_text = base.partition("-")
+            a = _value(a_text, lo, hi, names)
+            if dash:
+                b = _value(b_text, lo, hi, names)
+                if a <= b:
+                    seq = list(range(a, b + 1))
+                elif dow:
+                    # Wrapping day-of-week ranges count through 0 to 6.
+                    seq = list(range(a, 7)) + list(range(0, b + 1))
+                else:
+                    seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+            elif slash:
+                seq = list(range(a, hi + 1))
+            else:
+                seq = [a]
+        seq = seq[::step]
+        values.update(v % 7 if dow else v for v in seq)
+    return values, last, nth, nth_last
+
+
+def _parse(expr):
+    """Check and parse a whole expression. Raises ValueError if it is bad."""
+    if not isinstance(expr, str):
+        raise ValueError(f"not a schedule: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minutes = _parse_field(fields[0], 0, 59)[0]
+    hours = _parse_field(fields[1], 0, 23)[0]
+    days, dom_last, _, _ = _parse_field(fields[2], 1, 31, dom=True)
+    months = _parse_field(fields[3], 1, 12, names=_MONTHS)[0]
+    weekdays, _, nth, nth_last = _parse_field(fields[4], 0, 7, names=_DAYS, dow=True)
+    return _Parsed(minutes, hours, days, dom_last, months, weekdays, nth, nth_last)
+
+
+def _day_ok(p, day):
+    """True if the date day matches both the day-of-month and day-of-week fields."""
+    last = monthrange(day.year, day.month)[1]
+    if day.day not in p.days and not (p.dom_last and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7  # Sunday is 0
+    if weekday in p.weekdays:
+        return True
+    if (weekday, (day.day - 1) // 7 + 1) in p.nth:
+        return True
+    return weekday in p.nth_last and day.day > last - 7
+
 
