 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, time, timedelta
+from functools import lru_cache
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTH_NAMES = {name[:3].upper(): i for i, name in enumerate(calendar.month_name) if name}
+# Python's Monday is 0, so this maps each name to the cron number (Sunday is 0).
+_DAY_NAMES = {name[:3].upper(): (i + 1) % 7 for i, name in enumerate(calendar.day_name)}
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+
+
+class _Schedule:
+    """A parsed expression: the sets of allowed values for each field."""
+
+    def __init__(self, minutes, hours, dom, dom_last, months, dow, dow_last, dow_nth):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.months = set(months)
+        self.dom = set(dom)
+        self.dom_last = dom_last
+        self.dow = set(dow)
+        self.dow_last = set(dow_last)
+        self.dow_nth = set(dow_nth)
+
+    def day_ok(self, day):
+        last = calendar.monthrange(day.year, day.month)[1]
+        dom_ok = day.day in self.dom or (self.dom_last and day.day == last)
+        if not dom_ok:
+            return False
+        wd = (day.weekday() + 1) % 7
+        return (
+            wd in self.dow
+            or (wd in self.dow_last and day.day + 7 > last)
+            or (wd, (day.day - 1) // 7 + 1) in self.dow_nth
+        )
+
+
+def _value(token, lo, hi, names):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+        if not lo <= value <= hi:
+            raise ValueError(f"value {value} out of range {lo}-{hi}")
+        return value
+    if names is not None and _NAME.fullmatch(token) and token.upper() in names:
+        return names[token.upper()]
+    raise ValueError(f"bad value {token!r}")
+
+
+def _weekday_number(token):
+    if not _NUMBER.fullmatch(token) or int(token) > 7:
+        raise ValueError(f"bad weekday {token!r}")
+    return int(token) % 7
+
+
+def _parse_field(text, lo, hi, names=None, day=None):
+    """Parse one field. Returns (plain values, last-day flag, last-weekday set, nth set).
+
+    day is None, "dom" or "dow" and enables the special items for that field.
+    """
+    plain, last_weekdays, nth = set(), set(), set()
+    last_day = False
+    if day is not None and text == "?":
+        text = "*"
+    for item in text.split(","):
+        if day == "dom" and item == "L":
+            last_day = True
+            continue
+        if day == "dow":
+            m = re.fullmatch(r"([0-9]+)L", item)
+            if m:
+                last_weekdays.add(_weekday_number(m.group(1)))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad occurrence in {item!r}")
+                nth.add((_weekday_number(m.group(1)), k))
+                continue
+        base, step = item, None
+        if "/" in item:
+            parts = item.split("/")
+            if len(parts) != 2 or not _NUMBER.fullmatch(parts[1]) or int(parts[1]) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            base, step = parts[0], int(parts[1])
+        if base == "*":
+            values = list(range(lo, hi + 1))
+        elif "-" in base:
+            parts = base.split("-")
+            if len(parts) != 2:
+                raise ValueError(f"bad range {base!r}")
+            a = _value(parts[0], lo, hi, names)
+            b = _value(parts[1], lo, hi, names)
+            if a <= b:
+                values = list(range(a, b + 1))
+            else:
+                values = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            values = list(range(a, hi + 1)) if step is not None else [a]
+        if step is not None:
+            values = values[::step]
+        if day == "dow":
+            values = [v % 7 for v in values]
+        plain.update(values)
+    return plain, last_day, last_weekdays, nth
+
+
+@lru_cache(maxsize=256)
+def _compile(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    minute, _, _, _ = _parse_field(fields[0], 0, 59)
+    hour, _, _, _ = _parse_field(fields[1], 0, 23)
+    dom, dom_last, _, _ = _parse_field(fields[2], 1, 31, day="dom")
+    month, _, _, _ = _parse_field(fields[3], 1, 12, names=_MONTH_NAMES)
+    dow, _, dow_last, dow_nth = _parse_field(fields[4], 0, 7, names=_DAY_NAMES, day="dow")
+    return _Schedule(minute, hour, dom, dom_last, month, dow, dow_last, dow_nth)
+
+
+def _compile_checked(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string, not {type(expr).__name__}")
+    return _compile(expr)
+
 
 def matches(expr, when):
