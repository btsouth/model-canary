 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from datetime import datetime, timedelta
+import calendar
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): number for number, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): number for number, name in enumerate(calendar.day_abbr)}
+
+
+def _parse_field(field, index):
+    """Return (values, special, is_any) for one field."""
+    bounds = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))[index]
+    minimum, maximum = bounds
+    if index in (2, 4) and field == "?":
+        return set(range(minimum, maximum + 1)), [], True
+    if not field:
+        raise ValueError("empty schedule field")
+
+    values = set()
+    special = []
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if index == 2 and item == "L":
+            special.append(("last_dom",))
+            continue
+        if index == 4:
+            m = re.fullmatch(r"([0-9]+)L", item)
+            if m:
+                value = int(m.group(1))
+                if value > 7:
+                    raise ValueError("day-of-week value out of range")
+                special.append(("last_dow", value % 7))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                value, occurrence = int(m.group(1)), int(m.group(2))
+                if value > 7 or not 1 <= occurrence <= 5:
+                    raise ValueError("invalid nth weekday")
+                special.append(("nth_dow", value % 7, occurrence))
+                continue
+
+        if "/" in item:
+            if item.count("/") != 1:
+                raise ValueError("invalid step")
+            base, step_text = item.split("/")
+            if not re.fullmatch(r"[0-9]+", step_text) or int(step_text) < 1:
+                raise ValueError("invalid step")
+            step = int(step_text)
+            if index in (3, 4) and any(ch.isalpha() for ch in base):
+                raise ValueError("names are not allowed with steps")
+        else:
+            base, step = item, 1
+
+        if base == "*":
+            sequence = list(range(minimum, maximum + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("invalid range")
+            left, right = base.split("-")
+            start = _parse_value(left, index, minimum, maximum)
+            end = _parse_value(right, index, minimum, maximum)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                # Sunday has two spellings; normalize it while wrapping through 0..6.
+                sequence = []
+                v = start % 7
+                target = end % 7
+                while True:
+                    sequence.append(v)
+                    if v == target:
+                        break
+                    v = (v + 1) % 7
+            else:
+                sequence = list(range(start, maximum + 1)) + list(range(minimum, end + 1))
+        else:
+            start = _parse_value(base, index, minimum, maximum)
+            if "/" in item:
+                sequence = list(range(start, maximum + 1))
+            else:
+                sequence = [start]
+        values.update(sequence[::step])
+
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, special, False
+
+
+def _parse_value(token, index, minimum, maximum):
+    if index == 3 and token.upper() in _MONTHS:
+        value = _MONTHS[token.upper()]
+    elif index == 4 and token.upper() in _DAYS:
+        value = (_DAYS[token.upper()] + 1) % 7  # Python Monday=0; cron Sunday=0.
+    elif re.fullmatch(r"[0-9]+", token):
+        value = int(token)
+    else:
+        raise ValueError(f"invalid schedule value: {token!r}")
+    if not minimum <= value <= maximum:
+        raise ValueError(f"schedule value out of range: {token!r}")
+    return value
+
+
+def _compile(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    raw = expr.strip()
+    if raw.startswith("@"):
+        try:
+            raw = _SHORTCUTS[raw.lower()]
+        except KeyError as exc:
+            raise ValueError(f"unknown schedule shortcut: {raw!r}") from exc
+    fields = re.split(r"[ \t]+", raw) if raw else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    parsed = [_parse_field(field, i) for i, field in enumerate(fields)]
+    return parsed
+
+
+def _weekday(day):
+    return (day.weekday() + 1) % 7
+
+
+def _day_matches(day, dom, dow):
+    dom_values, dom_special, _ = dom
+    dow_values, dow_special, _ = dow
+    dom_ok = day.day in dom_values
+    if ("last_dom",) in dom_special:
+        dom_ok = dom_ok or day.day == calendar.monthrange(day.year, day.month)[1]
+
+    weekday = _weekday(day)
+    dow_ok = weekday in dow_values
+    last_weekday = day.day + 7 > calendar.monthrange(day.year, day.month)[1]
+    for rule in dow_special:
+        if rule[0] == "last_dow" and weekday == rule[1] and last_weekday:
+            dow_ok = True
+        elif rule[0] == "nth_dow" and weekday == rule[1] and (day.day - 1) // 7 + 1 == rule[2]:
+            dow_ok = True
+    return dom_ok and dow_ok
+
 
