 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4,
+    "MAY": 5, "JUN": 6, "JUL": 7, "AUG": 8,
+    "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+
+_DOW_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3,
+    "THU": 4, "FRI": 5, "SAT": 6,
+}
+
+_DIGITS = re.compile(r"^[0-9]+$")
+_FIELD_SEP = re.compile(r"[ \t]+")
+
+
+def _parse_int(token, lo, hi):
+    if not _DIGITS.match(token):
+        raise ValueError(f"invalid number: {token!r}")
+    val = int(token)
+    if val < lo or val > hi:
+        raise ValueError(f"value {val} out of range {lo}-{hi}")
+    return val
+
+
+def _parse_value(token, lo, hi, names):
+    if names is not None:
+        upper = token.upper()
+        if upper in names:
+            return names[upper]
+    return _parse_int(token, lo, hi)
+
+
+def _parse_standard_item(item, lo, hi, names, is_dow=False):
+    if "/" in item:
+        parts = item.split("/")
+        if len(parts) != 2 or not parts[0] or not parts[1]:
+            raise ValueError(f"invalid stepped item: {item!r}")
+        base, step_str = parts
+        if not _DIGITS.match(step_str):
+            raise ValueError(f"invalid step: {step_str!r}")
+        step = int(step_str)
+        if step < 1:
+            raise ValueError(f"step must be >= 1: {step}")
+    else:
+        base = item
+        step = None
+
+    if base == "*":
+        vals = list(range(0, 7)) if is_dow else list(range(lo, hi + 1))
+    elif "-" in base:
+        bounds = base.split("-")
+        if len(bounds) != 2 or not bounds[0] or not bounds[1]:
+            raise ValueError(f"invalid range: {base!r}")
+        a = _parse_value(bounds[0], lo, hi, names)
+        b = _parse_value(bounds[1], lo, hi, names)
+        if is_dow:
+            if a == 7 and b == 7:
+                vals = [0]
+            elif a == 7:
+                vals = list(range(0, b + 1))
+            elif b == 7:
+                vals = [v % 7 for v in range(a, 8)]
+            elif a <= b:
+                vals = list(range(a, b + 1))
+            else:
+                vals = list(range(a, 7)) + list(range(0, b + 1))
+        else:
+            if a <= b:
+                vals = list(range(a, b + 1))
+            else:
+                vals = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        val = _parse_value(base, lo, hi, names)
+        if step is None:
+            vals = [val % 7] if is_dow else [val]
+        else:
+            if is_dow:
+                vals = list(range(val % 7, 7))
+            else:
+                vals = list(range(val, hi + 1))
+
+    if step is not None:
+        vals = vals[::step]
+    return vals
+
+
+def _parse_simple_field(field, lo, hi, names):
+    if not field:
+        raise ValueError("empty field")
+    values = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        values.update(_parse_standard_item(item, lo, hi, names))
+    return sorted(values)
+
+
+def _parse_dom_field(field):
+    if not field:
+        raise ValueError("empty day-of-month field")
+    if field == "?":
+        return set(range(1, 32)), False
+    days = set()
+    has_last = False
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        if item == "L":
+            has_last = True
+        else:
+            days.update(_parse_standard_item(item, 1, 31, None))
+    return days, has_last
+
+
+def _parse_dow_field(field):
+    if not field:
+        raise ValueError("empty day-of-week field")
+    if field == "?":
+        return set(range(0, 7)), set(), set()
+    days = set()
+    last_dows = set()
+    nth_dows = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        if item.endswith("L"):
+            n_str = item[:-1]
+            if not n_str:
+                raise ValueError(f"invalid day-of-week item: {item!r}")
+            n = _parse_int(n_str, 0, 7)
+            last_dows.add(n % 7)
+        elif "#" in item:
+            parts = item.split("#")
+            if len(parts) != 2 or not parts[0] or not parts[1]:
+                raise ValueError(f"invalid day-of-week item: {item!r}")
+            n = _parse_int(parts[0], 0, 7)
+            k = _parse_int(parts[1], 1, 5)
+            nth_dows.add((n % 7, k))
+        else:
+            days.update(_parse_standard_item(item, 0, 7, _DOW_NAMES, is_dow=True))
+    return days, last_dows, nth_dows
+
+
+def _parse_expr(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    s = expr.strip()
+    if not s:
+        raise ValueError("empty expression")
+    lower = s.lower()
+    if lower in _SHORTCUTS:
+        s = _SHORTCUTS[lower]
+    parts = _FIELD_SEP.split(s)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    minutes = _parse_simple_field(parts[0], 0, 59, None)
+    hours = _parse_simple_field(parts[1], 0, 23, None)
+    dom_days, dom_last = _parse_dom_field(parts[2])
+    months = _parse_simple_field(parts[3], 1, 12, _MONTH_NAMES)
+    dow_days, dow_last, dow_nth = _parse_dow_field(parts[4])
+    return (
+        minutes,
+        hours,
+        dom_days,
+        dom_last,
+        months,
+        dow_days,
+        dow_last,
+        dow_nth,
+    )
+
+
+def _day_matches(year, month, day, last_day, dom_days, dom_last, dow_days, dow_last, dow_nth):
+    if day not in dom_days and not (dom_last and day == last_day):
+        return False
+    dow = (dt.date(year, month, day).weekday() + 1) % 7
+    if dow in dow_days:
+        return True
+    if dow in dow_last and day + 7 > last_day:
+        return True
+    if (dow, (day - 1) // 7 + 1) in dow_nth:
+        return True
+    return False
+
 
