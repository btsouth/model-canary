 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"])}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_NUMBER = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+# (low, high, names)
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+_DOM, _DOW = 2, 4
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays, last_weekdays, nth):
+        self.minutes = sorted(minutes)
+        self.minute_set = set(minutes)
+        self.hours = sorted(hours)
+        self.hour_set = set(hours)
+        self.days = days
+        self.last_day = last_day
+        self.months = months
+        self.weekdays = weekdays
+        self.last_weekdays = last_weekdays
+        self.nth = nth
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        last = calendar.monthrange(date.year, date.month)[1]
+        if not (date.day in self.days or (self.last_day and date.day == last)):
+            return False
+        weekday = date.isoweekday() % 7
+        if weekday in self.weekdays:
+            return True
+        if weekday in self.last_weekdays and date.day + 7 > last:
+            return True
+        if (weekday, (date.day - 1) // 7 + 1) in self.nth:
+            return True
+        return False
+
+
+def _number(text, low, high):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value {value} out of range {low}-{high}")
+    return value
+
+
+def _value(text, low, high, names):
+    if names is not None and text.upper() in names:
+        return names[text.upper()]
+    return _number(text, low, high)
+
+
+def _range_values(a, b, low, high, is_dow):
+    if a <= b:
+        return list(range(a, b + 1))
+    if is_dow:
+        a, b = a % 7, b % 7
+        if a <= b:
+            return list(range(a, b + 1))
+        return list(range(a, 7)) + list(range(0, b + 1))
+    return list(range(a, high + 1)) + list(range(low, b + 1))
+
+
+def _parse_field(text, index):
+    low, high, names = _FIELDS[index]
+    is_dow = index == _DOW
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth = set()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == _DOM and item == "L":
+            last_day = True
+            continue
+        if is_dow:
+            match = re.fullmatch(r"([0-9]+)L", item)
+            if match:
+                last_weekdays.add(_number(match.group(1), 0, 7) % 7)
+                continue
+            match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if match:
+                nth.add((_number(match.group(1), 0, 7) % 7, _number(match.group(2), 1, 5)))
+                continue
+        base, sep, step_text = item.partition("/")
+        if sep:
+            step = _number(step_text, 1, float("inf"))
+        else:
+            step = 1
+        if base == "*":
+            listed = list(range(low, high + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a = _value(a_text, low, high, names)
+            b = _value(b_text, low, high, names)
+            listed = _range_values(a, b, low, high, is_dow)
+        else:
+            a = _value(base, low, high, names)
+            listed = list(range(a, high + 1)) if sep else [a]
+        values.update(listed[::step])
+    if is_dow:
+        values = {v % 7 for v in values}
+    return values, last_day, last_weekdays, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minutes = _parse_field(parts[0], 0)[0]
+    hours = _parse_field(parts[1], 1)[0]
+    days, last_day, _, _ = _parse_field(parts[2], 2)
+    months = _parse_field(parts[3], 3)[0]
+    weekdays, _, last_weekdays, nth = _parse_field(parts[4], 4)
+    return _Schedule(minutes, hours, days, last_day, months, weekdays, last_weekdays, nth)
 
 
