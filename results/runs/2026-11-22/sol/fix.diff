 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text, field):
+    names = _MONTHS if field == 3 else _DAYS if field == 4 else {}
+    if text.upper() in names:
+        return names[text.upper()]
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid schedule value: {text!r}")
+    value = int(text)
+    low, high = _LIMITS[field]
+    if not low <= value <= high:
+        raise ValueError(f"schedule value out of range: {text!r}")
+    return value
+
+
+def _field(text, field):
+    values, special = set(), []
+    if text == "?" and field in (2, 4):
+        text = "*"
+    low, high = _LIMITS[field]
+    if field == 4:
+        high = 6
+    for item in text.split(","):
+        if field == 2 and item == "L":
+            special.append(("last",))
+            continue
+        if field == 4:
+            match = re.fullmatch(r"([0-9]+)(?:L|#([1-5]))", item)
+            if match:
+                day = _number(match[1], field) % 7
+                special.append(("nth", day, int(match[2])) if match[2]
+                               else ("last_weekday", day))
+                continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid schedule item: {item!r}")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) == 0:
+                raise ValueError(f"invalid schedule step: {item!r}")
+            step = int(pieces[1])
+        if base == "*":
+            ordered = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid schedule range: {item!r}")
+            start, end = (_number(part, field) for part in ends)
+            full_week = field == 4 and start == 0 and end == 7
+            if field == 4:
+                start, end = start % 7, end % 7
+            if full_week:
+                ordered = list(range(7))
+            elif start <= end:
+                ordered = list(range(start, end + 1))
+            else:
+                ordered = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _number(base, field)
+            if field == 4:
+                start %= 7
+            ordered = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(ordered[::step])
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown schedule shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("a schedule must have five fields")
+    return [_field(text, i) for i, text in enumerate(fields)]
+
+
+def _day_matches(parsed, when):
+    day, weekday = when.day, (when.weekday() + 1) % 7
+    last = calendar.monthrange(when.year, when.month)[1]
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    dom_ok = day in dom or bool(dom_special and day == last)
+    dow_ok = weekday in dow or any(
+        weekday == rule[1] and (
+            day + 7 > last if rule[0] == "last_weekday"
+            else (day - 1) // 7 + 1 == rule[2])
+        for rule in dow_special)
+    return dom_ok and dow_ok
+
 
