 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_left
+from calendar import monthrange
+from datetime import datetime
+from typing import NamedTuple
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DECIMAL = re.compile(r"[0-9]+")
+_WEEKDAY_OCCURRENCE = re.compile(r"([0-9]+)(?:L|#([0-9]+))")
+_SEARCH_DAYS = 10 * 365
+
+
+def _number(text):
+    if not _DECIMAL.fullmatch(text):
+        raise ValueError(f"invalid number: {text!r}")
+    digits = text.lstrip("0") or "0"
+    # Above 99, values are out of range and steps always keep only the first value.
+    return int(digits) if len(digits) <= 2 else 100
+
+
+def _value(text, low, high, names):
+    value = names.get(text) if names else None
+    if value is None:
+        value = _number(text)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _item_values(item, low, high, names):
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text) if slash else 1
+    if not step:
+        raise ValueError("step must be positive")
+
+    if base == "*":
+        values = range(low, high + 1)
+    else:
+        first, dash, last = base.partition("-")
+        start = _value(first, low, high, names)
+        end = _value(last, low, high, names) if dash else high if slash else start
+        if start > end and names is _WEEKDAYS:
+            start, end, high = start % 7, end % 7, 6
+        if start <= end:
+            values = range(start, end + 1)
+        else:
+            values = (*range(start, high + 1), *range(low, end + 1))
+    return values[::step]
+
+
+def _field_values(items, low, high, names=None):
+    return {value for item in items for value in _item_values(item, low, high, names)}
+
+
+class _Schedule(NamedTuple):
+    minutes: tuple
+    hours: tuple
+    days: set
+    months: set
+    weekdays: set
+    occurrences: set
+    last_day: bool
+
+    def allows_day(self, day):
+        days_in_month = monthrange(day.year, day.month)[1]
+        if day.day not in self.days and not (self.last_day and day.day == days_in_month):
+            return False
+        weekday = (day.weekday() + 1) % 7
+        return (
+            weekday in self.weekdays
+            or (weekday, (day.day - 1) // 7 + 1) in self.occurrences
+            or (day.day + 7 > days_in_month and (weekday, None) in self.occurrences)
+        )
+
+
+def _parse_expression(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be a string")
+    expr = expr.strip()
+    if not expr.isascii():
+        raise ValueError("schedule fields must use ASCII characters")
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must contain five fields")
+    minute, hour, day, month, weekday = fields
+
+    day_items = ("*" if day == "?" else day).split(",")
+    weekday_items = ("*" if weekday == "?" else weekday).split(",")
+    weekdays, occurrences = set(), set()
+    for item in weekday_items:
+        special = _WEEKDAY_OCCURRENCE.fullmatch(item)
+        if special:
+            number, occurrence = special.groups()
+            number = _value(number, 0, 7, None) % 7
+            occurrence = _value(occurrence, 1, 5, None) if occurrence is not None else None
+            occurrences.add((number, occurrence))
+        else:
+            weekdays.update(value % 7 for value in _item_values(item.upper(), 0, 7, _WEEKDAYS))
+
+    return _Schedule(
+        tuple(sorted(_field_values(minute.split(","), 0, 59))),
+        tuple(sorted(_field_values(hour.split(","), 0, 23))),
+        _field_values((item for item in day_items if item != "L"), 1, 31),
+        _field_values(month.upper().split(","), 1, 12, _MONTHS),
+        weekdays,
+        occurrences,
+        "L" in day_items,
+    )
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse_expression(expr)
+    return (
