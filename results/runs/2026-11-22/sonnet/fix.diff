 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _parse_field(text, lo, hi, names=None, dow=False, dom=False):
+    """Return (set of plain values, set of special matchers)."""
+    values, specials = set(), []
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if dom and item.upper() == "L":
+            specials.append(("L",))
+            continue
+        if dow:
+            m = re.fullmatch(r"([0-9]+)L", item, re.IGNORECASE)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError("bad day")
+                specials.append(("NL", n % 7))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if n > 7 or not 1 <= k <= 5:
+                    raise ValueError("bad day")
+                specials.append(("NK", n % 7, k))
+                continue
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.fullmatch(step) or int(step) < 1:
+                raise ValueError("bad step")
+            step = int(step)
+        else:
+            step = None
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif dow:
+                seq = list(range(0, b + 1)) if a == 7 else \
+                    list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, lo, hi, names)
+            seq = list(range(a, hi + 1)) if step else [a]
+        if step:
+            seq = seq[::step]
+        values.update(seq)
+    if dow:
+        values = {v % 7 for v in values}
+    return values, specials
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError("unknown shortcut")
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    mi, ho, dm, mo, dw = parts
+    minutes, _ = _parse_field(mi, 0, 59)
+    hours, _ = _parse_field(ho, 0, 23)
+    months, _ = _parse_field(mo, 1, 12, _MONTHS)
+    if dm == "?":
+        dm = "*"
+    if dw == "?":
+        dw = "*"
+    dom = _parse_field(dm, 1, 31, dom=True)
+    dows = _parse_field(dw, 0, 7, _DAYS, dow=True)
+    return sorted(minutes), sorted(hours), months, dom, dows
+
+
+def _day_ok(d, dom, dows):
+    last = calendar.monthrange(d.year, d.month)[1]
+    vals, specials = dom
+    if not (d.day in vals or any(s[0] == "L" and d.day == last for s in specials)):
+        return False
+    wd = (d.weekday() + 1) % 7
+    vals, specials = dows
+    if wd in vals:
+        return True
+    for s in specials:
+        if s[1] != wd:
+            continue
+        if s[0] == "NL" and d.day + 7 > last:
+            return True
+        if s[0] == "NK" and (d.day - 1) // 7 + 1 == s[2]:
+            return True
+    return False
 
 
