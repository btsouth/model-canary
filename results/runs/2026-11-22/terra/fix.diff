 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    result = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if token.upper() in names:
+                value = names[token.upper()]
+            elif re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            else:
+                raise ValueError('invalid value')
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-9]+)(L|#([1-5]))', item) if index == 4 else None
+            if match:
+                if int(match[1]) > 7:
+                    raise ValueError('value out of range')
+                special.append(('weekday', int(match[1]) % 7, None if match[2] == 'L' else int(match[3])))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) == 0:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                seq = list(range(low, high + 1))
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, ends)
+                if index == 4:
+                    start, end = start % 7, end % 7
+                    seq = list(range(start, end + 1)) if start <= end else list(range(start, 7)) + list(range(0, end + 1))
+                else:
+                    seq = list(range(start, end + 1)) if start <= end else list(range(start, high + 1)) + list(range(low, end + 1))
+            else:
+                start = number(base)
+                seq = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+            values.update((v % 7 if index == 4 else v) for v in seq[::step])
+        result.append((values, special))
+    return result
+
+
+def _day_matches(fields, day):
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    dow, dow_special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    return (day.day in dom or bool(dom_special) and day.day == last) and (
+        weekday in dow or any(weekday == n and (day.day + 7 > last if k is None else (day.day - 1) // 7 + 1 == k)
+                              for _, n, k in dow_special))
+
 
