 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"invalid number: {token!r}")
+    return int(token)
+
+
+def _value(token, field):
+    names = _MONTHS if field == 3 else _DAYS if field == 4 else {}
+    value = names[token] if token in names else _number(token)
+    low, high = _BOUNDS[field]
+    if not low <= value <= high:
+        raise ValueError(f"value outside field range: {token!r}")
+    return value
+
+
+def _field(text, field):
+    low, high = _BOUNDS[field]
+    values, special = set(), []
+    if text == "?" and field in (2, 4):
+        text = "*"
+    for item in text.upper().split(","):
+        if field == 2 and item == "L":
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if field == 4 and (last or nth):
+            match = last or nth
+            weekday = _value(match[1], field) % 7
+            if last:
+                special.append(("last", weekday))
+            else:
+                occurrence = _number(match[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence must be between 1 and 5")
+                special.append(("nth", weekday, occurrence))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = (_value(token, field) for token in ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif field == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _value(base, field)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(value % 7 if field == 4 else value for value in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(text, index) for index, text in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom, dom_special = fields[2]
+    if day.day not in dom and not (dom_special and day.day == last_day):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow, dow_special = fields[4]
+    if weekday in dow:
+        return True
+    for special in dow_special:
+        if weekday == special[1]:
+            if special[0] == "last" and day.day + 7 > last_day:
+                return True
+            if special[0] == "nth" and (day.day - 1) // 7 + 1 == special[2]:
+                return True
+    return False
+
 
