 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, datetime
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _number(token, minimum, maximum, names):
+    if token in names:
+        return names[token]
+    if re.fullmatch(r"[0-9]+", token):
+        digits = token.lstrip("0") or "0"
+        if len(digits) <= len(str(maximum)):
+            value = int(digits)
+            if minimum <= value <= maximum:
+                return value
+    raise ValueError(f"invalid field value: {token!r}")
+
+
+def _values(item, minimum, maximum, names):
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not re.fullmatch(r"[0-9]+", step_text) or not step_text.strip("0"):
+            raise ValueError(f"invalid step: {step_text!r}")
+        # A stride above the field size can only select the first value.
+        digits = step_text.lstrip("0")
+        step = int(digits) if len(digits) <= 2 else maximum + 1
+    if base == "*":
+        sequence = range(minimum, maximum + 1)
+    else:
+        first, dash, last = base.partition("-")
+        start = _number(first, minimum, maximum, names)
+        if dash:
+            end = _number(last, minimum, maximum, names)
+        else:
+            end = maximum if slash else start
+        if start <= end:
+            sequence = range(start, end + 1)
+        elif names is _WEEKDAYS:
+            sequence = [(start + i) % 7 for i in range((end - start) % 7 + 1)]
+        else:
+            sequence = [*range(start, maximum + 1), *range(minimum, end + 1)]
+    return sequence[::step]
+
+
+@dataclass
+class _Schedule:
+    minutes: list
+    hours: list
+    days: set
+    months: set
+    weekdays: set
+    last_day: bool
+    last_weekdays: set
+    nth_weekdays: set
+
+    def allows_date(self, day):
+        if day.month not in self.months:
+            return False
+        length = monthrange(day.year, day.month)[1]
+        weekday = (day.weekday() + 1) % 7
+        return (day.day in self.days or self.last_day and day.day == length) and (
+            weekday in self.weekdays
+            or weekday in self.last_weekdays and day.day + 7 > length
+            or (weekday, (day.day - 1) // 7 + 1) in self.nth_weekdays
+        )
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    fields = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    limits = [(0, 59, {}), (0, 23, {}), (1, 31, {}), (1, 12, _MONTHS), (0, 7, _WEEKDAYS)]
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+    parsed = []
+    for index, (field, bounds) in enumerate(zip(fields, limits)):
+        if index in (2, 4) and field == "?":
+            field = "*"
+        values = set()
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                last_day = True
+            elif index == 4 and item.endswith("L") and item != "L":
+                last_weekdays.add(_number(item[:-1], 0, 7, {}) % 7)
+            elif index == 4 and "#" in item:
+                weekday, occurrence = item.split("#", 1)
+                nth_weekdays.add((_number(weekday, 0, 7, {}) % 7,
+                                  _number(occurrence, 1, 5, {})))
+            else:
+                if not item.isascii():
+                    raise ValueError(f"invalid item: {item!r}")
+                values.update(_values(item.upper(), *bounds))
+        parsed.append(values)
+    minutes, hours, days, months, weekdays = parsed
+    return _Schedule(sorted(minutes), sorted(hours), days, months,
+                     {day % 7 for day in weekdays}, last_day, last_weekdays, nth_weekdays)
+
 
