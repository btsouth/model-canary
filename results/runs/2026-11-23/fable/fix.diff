 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_LIMIT = _dt.timedelta(days=10 * 365)
+_NL = re.compile(r"^(\d+)L$")
+_NHASH = re.compile(r"^(\d+)#(\d+)$")
+
+
+def _value(text, lo, hi, names, expr):
+    if text.isdigit():
+        v = int(text)
+    elif names is not None and text.upper() in names:
+        v = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r} in {expr!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value {text!r} out of range in {expr!r}")
+    return v
+
+
+def _item(text, lo, hi, names, expr, dow=False):
+    """Values listed by one plain item (*, N, A-B, optionally with /S)."""
+    if not text:
+        raise ValueError(f"empty item in {expr!r}")
+    step = 1
+    if "/" in text:
+        base, _, step_text = text.partition("/")
+        if "/" in step_text or not step_text.isdigit() or int(step_text) < 1:
+            raise ValueError(f"bad step in {expr!r}")
+        step = int(step_text)
+    else:
+        base = text
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    elif "-" in base:
+        a_text, _, b_text = base.partition("-")
+        a = _value(a_text, lo, hi, names, expr)
+        b = _value(b_text, lo, hi, names, expr)
+        if a <= b:
+            values = list(range(a, b + 1))
+        else:
+            top = hi
+            if dow:
+                a, b, top = a % 7, b % 7, 6
+            values = list(range(a, top + 1)) + list(range(lo, b + 1))
+    else:
+        n = _value(base, lo, hi, names, expr)
+        values = list(range(n, hi + 1)) if "/" in text else [n]
+    values = values[::step]
+    if dow:
+        values = [v % 7 for v in values]
+    return values
+
+
+def _simple_field(text, lo, hi, names, expr):
+    out = set()
+    for item in text.split(","):
+        out.update(_item(item, lo, hi, names, expr))
+    return out
+
+
+def _dom_field(text, expr):
+    """Returns (set of days or None for any, last_day flag)."""
+    if text in ("*", "?"):
+        return None, False
+    days, last = set(), False
+    for item in text.split(","):
+        if item == "L":
+            last = True
+        else:
+            days.update(_item(item, 1, 31, None, expr))
+    return days, last
+
+
+def _dow_field(text, expr):
+    """Returns (set of weekdays 0-6 or None for any, list of (n, 'L'|k) specials)."""
+    if text in ("*", "?"):
+        return None, []
+    days, specials = set(), []
+    for item in text.split(","):
+        m = _NL.match(item)
+        if m:
+            specials.append((_value(m.group(1), 0, 7, None, expr) % 7, "L"))
+            continue
+        m = _NHASH.match(item)
+        if m:
+            n = _value(m.group(1), 0, 7, None, expr) % 7
+            k = int(m.group(2))
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad week number in {expr!r}")
+            specials.append((n, k))
+            continue
+        days.update(_item(item, 0, 7, _DAYS, expr, dow=True))
+    return days, specials
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.lower() in _SHORTCUTS:
+        text = _SHORTCUTS[text.lower()]
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut {expr!r}")
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields in {expr!r}")
+    minute, hour, dom, month, dow = parts
+    return (
+        sorted(_simple_field(minute, 0, 59, None, expr)),
+        sorted(_simple_field(hour, 0, 23, None, expr)),
+        _dom_field(dom, expr),
+        _simple_field(month, 1, 12, _MONTHS, expr),
+        _dow_field(dow, expr),
+    )
+
+
+def _day_ok(spec, date):
+    _, _, (dom_days, last), months, (dow_days, specials) = spec
+    if date.month not in months:
+        return False
+    days_in_month = calendar.monthrange(date.year, date.month)[1]
+    if dom_days is not None:
+        if date.day not in dom_days and not (last and date.day == days_in_month):
+            return False
+    if dow_days is not None:
+        wd = (date.weekday() + 1) % 7  # Sunday = 0
+        if wd in dow_days:
+            return True
+        for n, k in specials:
+            if n != wd:
+                continue
+            if k == "L":
+                if date.day + 7 > days_in_month:
+                    return True
+            elif (date.day - 1) // 7 + 1 == k:
+                return True
+        return False
+    return True
+
 
