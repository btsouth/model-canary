 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+# (minimum, maximum, names) for each of the five fields
+_SPECS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = datetime.timedelta(days=10 * 365)
+
+
+def _value(text, index):
+    low, high, names = _SPECS[index]
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _item(item, index):
+    """The ordered list of values one plain item stands for."""
+    low, high, _ = _SPECS[index]
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        first, _, last = base.partition("-")
+        first, last = _value(first, index), _value(last, index)
+        if index == _DOW and first > last:
+            first %= 7
+            last %= 7
+            if first <= last:
+                values = list(range(first, last + 1))
+            else:
+                values = list(range(first, 7)) + list(range(0, last + 1))
+        elif first > last:
+            values = list(range(first, high + 1)) + list(range(low, last + 1))
+        else:
+            values = list(range(first, last + 1))
+    else:
+        first = _value(base, index)
+        values = list(range(first, high + 1)) if slash else [first]
+    values = values[::step]
+    if index == _DOW:
+        values = [v % 7 for v in values]
+    return values
+
+
+def _parse(expr):
+    """Return (minutes, hours, dom, months, dow) for a valid expression.
+
+    minutes, hours and months are sorted lists. dom is (days, last) and dow is
+    (weekdays, last_weekdays, nth_weekdays); either is None if it allows any day.
+    """
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+    parsed = []
+    for index, field in enumerate(parts):
+        if field == "?":
+            if index not in (_DOM, _DOW):
+                raise ValueError(f"'?' not allowed here: {expr!r}")
+            parsed.append(None)
+            continue
+        values, last, last_days, nth = set(), False, set(), set()
+        for item in field.split(","):
+            if index == _DOM and item == "L":
+                last = True
+                continue
+            if index == _DOW:
+                found = _LAST_DOW.fullmatch(item)
+                if found:
+                    day = int(found.group(1))
+                    if day > 7:
+                        raise ValueError(f"bad day of week: {item!r}")
+                    last_days.add(day % 7)
+                    continue
+                found = _NTH_DOW.fullmatch(item)
+                if found:
+                    day, nth_k = int(found.group(1)), int(found.group(2))
+                    if day > 7 or not 1 <= nth_k <= 5:
+                        raise ValueError(f"bad day of week: {item!r}")
+                    nth.add((day % 7, nth_k))
+                    continue
+            values.update(_item(item, index))
+        if index == _DOM:
+            parsed.append(None if field == "*" else (values, last))
+        elif index == _DOW:
+            parsed.append(None if field == "*" else (values, last_days, nth))
+        else:
+            parsed.append(sorted(values))
+    return parsed
+
+
+def _day_ok(dom, dow, year, month, day, first_weekday, days_in_month):
+    """first_weekday is the cron weekday (0 = Sunday) of the 1st of the month."""
+    if dom is not None:
+        days, last = dom
+        if not (day in days or (last and day == days_in_month)):
+            return False
+    if dow is not None:
+        weekdays, last_days, nth = dow
+        weekday = (first_weekday + day - 1) % 7
+        if not (weekday in weekdays
+                or (weekday in last_days and day + 7 > days_in_month)
+                or (weekday, (day - 1) // 7 + 1) in nth):
+            return False
+    return True
+
+
+def _month_info(year, month):
+    weekday, days_in_month = calendar.monthrange(year, month)
+    return (weekday + 1) % 7, days_in_month
 
 
