 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (name, minimum, maximum, names allowed in the field)
+_FIELDS = (
+    ("minute", 0, 59, None),
+    ("hour", 0, 23, None),
+    ("day of month", 1, 31, None),
+    ("month", 1, 12, _MONTHS),
+    ("day of week", 0, 7, _DAYS),
+)
+
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")       # e.g. 5L: last Friday
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")  # e.g. 1#2: second Monday
+
+_HORIZON = datetime.timedelta(days=10 * 365)
+_MINUTE = datetime.timedelta(minutes=1)
+
+
+def _parse_value(text, lo, hi, names):
+    if _DIGITS.fullmatch(text):
+        value = int(text)
+    elif names is not None and len(text) == 3 and text.isascii() and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {value} out of range {lo}-{hi}")
+    return value
+
+
+def _parse_field(text, field):
+    """Return (values, last_day, nth_weekdays) for one field.
+
+    values is a set of ints; last_day is True for day-of-month L; nth_weekdays is a
+    list of (weekday, k) pairs for day-of-week NL (k is None) and N#K.
+    """
+    name, lo, hi, names = field
+    day_of_month = name == "day of month"
+    day_of_week = name == "day of week"
+    if text == "?":
+        if not (day_of_month or day_of_week):
+            raise ValueError(f"'?' is not allowed in the {name} field")
+        text = "*"
+
+    values, last_day, nth = set(), False, []
+    for item in text.split(","):
+        if day_of_month and item == "L":
+            last_day = True
+            continue
+        if day_of_week:
+            m = _LAST_WEEKDAY.fullmatch(item)
+            if m:
+                nth.append((_parse_value(m.group(1), 0, 7, None) % 7, None))
+                continue
+            m = _NTH_WEEKDAY.fullmatch(item)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"occurrence must be 1 to 5 in {item!r}")
+                nth.append((_parse_value(m.group(1), 0, 7, None) % 7, k))
+                continue
+
+        base, slash, step_text = item.partition("/")
+        step = None
+        if slash:
+            if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        else:
+            a_text, dash, b_text = base.partition("-")
+            if dash:
+                a = _parse_value(a_text, lo, hi, names)
+                b = _parse_value(b_text, lo, hi, names)
+                if a <= b:
+                    seq = list(range(a, b + 1))
+                elif day_of_week:
+                    # Counts through 0 to 6, with 7 treated as 0.
+                    seq = list(range(a, 7)) + list(range(0, b + 1))
+                else:
+                    seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+            else:
+                n = _parse_value(base, lo, hi, names)
+                seq = list(range(n, hi + 1)) if step is not None else [n]
+        if step is not None:
+            seq = seq[::step]
+        values.update(seq)
+
+    if day_of_week:
+        values = {v % 7 for v in values}
+    return values, last_day, nth
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, days, last_day, months, weekdays, nth_weekdays):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.days = days
+        self.last_day = last_day
+        self.months = months
+        self.weekdays = weekdays
+        self.nth_weekdays = nth_weekdays
+
+
+def _parse(expr):
+    """Parse expr into a _Schedule. Raises ValueError for anything invalid."""
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    parsed = [_parse_field(part, field) for part, field in zip(parts, _FIELDS)]
+    (minutes, _, _), (hours, _, _), (days, last_day, _), (months, _, _), (weekdays, _, nth) = parsed
+    return _Schedule(minutes, hours, days, last_day, months, weekdays, nth)
+
+
+def _day_ok(spec, year, month, day):
+    days_in_month = calendar.monthrange(year, month)[1]
+    if day not in spec.days and not (spec.last_day and day == days_in_month):
+        return False
+    weekday = datetime.date(year, month, day).isoweekday() % 7  # Sunday is 0
+    if weekday in spec.weekdays:
+        return True
+    for wd, k in spec.nth_weekdays:
+        if wd != weekday:
+            continue
+        if k is None:
+            if day + 7 > days_in_month:
+                return True
+        elif (day - 1) // 7 + 1 == k:
+            return True
+    return False
+
+
+def _first_at_least(sorted_values, x):
+    return next((v for v in sorted_values if v >= x), None)
+
+
+def _next_day(t):
+    return t.replace(hour=0, minute=0) + datetime.timedelta(days=1)
+
+
+def _next_month(t):
+    first = t.replace(day=1, hour=0, minute=0)
+    return first + datetime.timedelta(days=calendar.monthrange(t.year, t.month)[1])
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
