+                continue
+            if not _day_ok(spec, t.year, t.month, t.day):
+                t = _next_day(t)
+                continue
+            hour = _first_at_least(spec.hours, t.hour)
+            if hour is None:
+                t = _next_day(t)
+                continue
+            if hour != t.hour:
+                t = t.replace(hour=hour, minute=0)
+            minute = _first_at_least(spec.minutes, t.minute)
+            if minute is None:
+                t = t.replace(minute=0) + datetime.timedelta(hours=1)
+                continue
+            t = t.replace(minute=minute)
+            return t if t <= limit else None
+        return None
+    except OverflowError:
+        return None
