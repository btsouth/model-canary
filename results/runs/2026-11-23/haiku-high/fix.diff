+def _tokenize(text):
+    """Split text into fields. Each field is a list of (char, quoted) pairs.
+
+    Unquoted SEP ends a field. Quote characters are not kept; two QUOTE characters
+    in a row inside quotes stand for one literal QUOTE.
+    """
+    fields, field = [], []
+    quoted = False
+    i, n = 0, len(text)
+    while i < n:
+        ch = text[i]
+        if ch == QUOTE:
+            if quoted and i + 1 < n and text[i + 1] == QUOTE:
+                field.append((QUOTE, True))
+                i += 2
+                continue
+            quoted = not quoted
+        elif ch == SEP and not quoted:
+            fields.append(field)
+            field = []
+        else:
+            field.append((ch, quoted))
+        i += 1
+    if quoted:
+        raise ValueError("unclosed quote")
+    fields.append(field)
+    return fields
+
+
+def _strip(pairs):
+    """Drop unquoted whitespace from both ends of a list of (char, quoted) pairs."""
+    start, end = 0, len(pairs)
+    while start < end and not pairs[start][1] and pairs[start][0].isspace():
+        start += 1
+    while end > start and not pairs[end - 1][1] and pairs[end - 1][0].isspace():
+        end -= 1
+    return pairs[start:end]
+
+
+def _text(pairs):
+    return "".join(ch for ch, _ in pairs)
+
