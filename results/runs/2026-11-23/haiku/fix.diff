--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,211 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from collections import namedtuple
+from datetime import date, datetime, time, timedelta
+
+_SHORTCUTS = {
+    "yearly": "0 0 1 1 *",
+    "annually": "0 0 1 1 *",
+    "monthly": "0 0 1 * *",
+    "weekly": "0 0 * * 0",
+    "daily": "0 0 * * *",
+    "midnight": "0 0 * * *",
+    "hourly": "0 * * * *",
+}
+_MONTHS = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_NTH = re.compile(r"([0-9])#([0-9]+)")
+_NTH_LAST = re.compile(r"([0-9])[Ll]")
+
+_Spec = namedtuple(
+    "_Spec", "minutes hours months dom dom_last dow nth last_weekday")
+
+
+def _value(tok, lo, hi, names=None):
+    if names is not None and _NAME.fullmatch(tok):
+        key = tok.upper()
+        if key not in names:
+            raise ValueError(f"unknown name: {tok!r}")
+        return names[key]
+    if _NUM.fullmatch(tok):
+        n = int(tok)
+        if lo <= n <= hi:
+            return n
+    raise ValueError(f"bad value: {tok!r}")
+
+
+def _expand(item, lo, hi, names=None, dow=False):
+    """Values listed by one item (not L, NL or N#K), in order."""
+    parts = item.split("/")
+    if len(parts) > 2:
+        raise ValueError(f"bad item: {item!r}")
+    base = parts[0]
+    step = None
+    if len(parts) == 2:
+        if not _NUM.fullmatch(parts[1]) or int(parts[1]) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(parts[1])
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    elif "-" in base:
+        ends = base.split("-")
+        if len(ends) != 2:
+            raise ValueError(f"bad range: {item!r}")
+        a = _value(ends[0], lo, hi, names)
+        b = _value(ends[1], lo, hi, names)
+        if dow and a == 7:
+            a = 0
+        if a <= b:
+            values = list(range(a, b + 1))
+        elif dow:
+            values = list(range(a, 7)) + list(range(0, b + 1))
+        else:
+            values = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        n = _value(base, lo, hi, names)
+        values = list(range(n, hi + 1)) if step is not None else [n]
+    if step is not None:
+        values = values[::step]
+    return values
+
+
+def _field(text, lo, hi, names=None, dow=False):
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        values.update(_expand(item, lo, hi, names, dow))
+    if dow:
+        values = {v % 7 for v in values}
+    return values
+
+
+def _parse_dom(text):
+    if text == "?":
+        text = "*"
+    days, last = set(), False
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        if item.upper() == "L":
+            last = True
+            continue
+        days.update(_expand(item, 1, 31))
+    return days, last
+
+
+def _parse_dow(text):
+    if text == "?":
+        text = "*"
+    days, nth, last = set(), set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {text!r}")
+        m = _NTH.fullmatch(item)
+        if m:
+            n, k = int(m.group(1)), int(m.group(2))
+            if n > 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad nth weekday: {item!r}")
+            nth.add((n % 7, k))
+            continue
+        m = _NTH_LAST.fullmatch(item)
+        if m:
+            n = int(m.group(1))
+            if n > 7:
+                raise ValueError(f"bad last weekday: {item!r}")
+            last.add(n % 7)
+            continue
+        days.update(_expand(item, 0, 7, _DAYS, dow=True))
+    return {v % 7 for v in days}, nth, last
+
+
+_cache = {}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be a string")
+    if expr in _cache:
+        return _cache[expr]
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text[1:].lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom_text, month, dow_text = fields
+    dom, dom_last = _parse_dom(dom_text)
+    dow, nth, last = _parse_dow(dow_text)
+    spec = _Spec(
+        minutes=_field(minute, 0, 59),
+        hours=_field(hour, 0, 23),
+        months=_field(month, 1, 12, _MONTHS),
+        dom=dom,
+        dom_last=dom_last,
+        dow=dow,
+        nth=nth,
+        last_weekday=last,
+    )
+    _cache[expr] = spec
+    return spec
+
+
+def _day_ok(spec, day):
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in spec.dom or (spec.dom_last and day.day == last_day)
+    weekday = (day.weekday() + 1) % 7  # cron: Sunday is 0
+    occurrence = (day.day - 1) // 7 + 1
+    dow_ok = (
+        weekday in spec.dow
+        or (weekday, occurrence) in spec.nth
+        or (weekday in spec.last_weekday and day.day + 7 > last_day)
+    )
+    return dom_ok and dow_ok
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return (
+        when.minute in spec.minutes
+        and when.hour in spec.hours
+        and when.month in spec.months
+        and _day_ok(spec, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    try:
+        limit = after + timedelta(days=3650)
+    except OverflowError:
+        limit = datetime.max
+    hours = sorted(spec.hours)
+    minutes = sorted(spec.minutes)
+    day = start.date()
+    while True:
+        if datetime.combine(day, time.min) > limit:
+            return None
+        if day.month in spec.months and _day_ok(spec, day):
+            for hour in hours:
+                for minute in minutes:
+                    candidate = datetime.combine(day, time(hour, minute))
+                    if candidate < start:
+                        continue
+                    if candidate > limit:
+                        return None
+                    return candidate
+        if day == date.max:
+            return None
+        day += timedelta(days=1)
