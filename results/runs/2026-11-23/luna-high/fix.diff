 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"))}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_SPECS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, field):
+    if field == 3 and token.upper() in _MONTHS:
+        return _MONTHS[token.upper()]
+    if field == 4 and token.upper() in _DAYS:
+        return _DAYS[token.upper()]
+    if not re.fullmatch(r"\d+", token):
+        raise ValueError("invalid value")
+    value = int(token)
+    low, high = _SPECS[field]
+    if not low <= value <= high:
+        raise ValueError("value out of range")
+    return value
+
+
+def _parse_list(text, field):
+    low, high = _SPECS[field]
+    values, last_days, nth_days = set(), set(), set()
+    if field in (2, 4) and text == "?":
+        text = "*"
+    if not text:
+        raise ValueError("empty field")
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty list item")
+        if field == 2 and item == "L":
+            last_days.add("last")
+            continue
+        if field == 4:
+            special = re.fullmatch(r"(\d+)(L|#([1-5]))", item)
+            if special:
+                day = int(special.group(1))
+                if not 0 <= day <= 7:
+                    raise ValueError("day of week out of range")
+                day %= 7
+                if special.group(2).upper() == "L":
+                    last_days.add(day)
+                else:
+                    nth_days.add((day, int(special.group(3))))
+                continue
+        if "L" in item.upper() or "#" in item or "?" in item:
+            raise ValueError("invalid special value")
+
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"\d+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError("invalid step")
+            step = int(pieces[1])
+
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("invalid range")
+            left, right = base.split("-")
+            start, end = _number(left, field), _number(right, field)
+            if field == 4:
+                if start <= end:
+                    sequence = list(range(start, end + 1))
+                else:
+                    # Wrapping weekday ranges cycle through canonical 0..6;
+                    # 7 is only another spelling of Sunday.
+                    start %= 7
+                    end %= 7
+                    sequence = list(range(start, 7)) + list(range(0, end + 1))
+            elif start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _number(base, field)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        chosen = sequence[::step]
+        values.update(value % 7 if field == 4 else value for value in chosen)
+    return {"values": values, "last": last_days, "nth": nth_days,
+            "any": text == "*"}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        try:
+            stripped = _SHORTCUTS[stripped.lower()]
+        except KeyError:
+            raise ValueError("unknown shortcut") from None
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_parse_list(token, index) for index, token in enumerate(fields)]
+
+
+def _day_matches(date, dom, dow):
+    day = date.day
+    weekday = (date.weekday() + 1) % 7
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom_match = dom["any"] or day in dom["values"] or ("last" in dom["last"] and day == last)
+    dow_match = dow["any"] or weekday in dow["values"]
+    if weekday in dow["last"] and day + 7 > last:
+        dow_match = True
+    if (weekday, (day - 1) // 7 + 1) in dow["nth"]:
+        dow_match = True
+    return dom_match and dow_match
+
 
