 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
+
+_SHORT = {"@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *", "@hourly": "0 * * * *"}
+_MONTHS = {calendar.month_abbr[i].upper(): i for i in range(1, 13)}
+_DAYS = {calendar.day_abbr[i].upper(): (i + 1) % 7 for i in range(7)}
+_RANGES = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _value(s, index):
+    if index == 3 and s.upper() in _MONTHS:
+        return _MONTHS[s.upper()]
+    if index == 4 and s.upper() in _DAYS:
+        return _DAYS[s.upper()]
+    if not s.isdigit():
+        raise ValueError("invalid value")
+    n = int(s)
+    lo, hi = _RANGES[index]
+    if not lo <= n <= hi:
+        raise ValueError("value out of range")
+    return n
+
+
+def _field(raw, index):
+    lo, hi = _RANGES[index]
+    if index in (2, 4) and raw == "?":
+        raw = "*"
+    if "?" in raw:
+        raise ValueError("invalid ?")
+    if index == 2 and raw == "L":
+        return set(), False, "lastday"
+    special = []
+    if index == 4:
+        keep = []
+        for item in raw.split(","):
+            m = re.fullmatch(r"(\d+)(L|#([1-5]))", item)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError("weekday out of range")
+                special.append((n % 7, "last" if m.group(2) == "L" else int(m.group(3))))
+            else:
+                keep.append(item)
+        raw = ",".join(keep)
+    values = set()
+    if raw:
+        for item in raw.split(","):
+            if not item:
+                raise ValueError("empty item")
+            bits = item.split("/")
+            if len(bits) > 2 or (len(bits) == 2 and (not bits[1].isdigit() or int(bits[1]) < 1)):
+                raise ValueError("invalid step")
+            step = int(bits[1]) if len(bits) == 2 else 1
+            base = bits[0]
+            if base == "*":
+                seq = list(range(lo, hi + 1))
+            elif "-" in base:
+                ends = base.split("-")
+                if len(ends) != 2:
+                    raise ValueError("invalid range")
+                a, b = _value(ends[0], index), _value(ends[1], index)
+                if index == 4:
+                    a, b = a % 7, b % 7
+                    seq = list(range(a, b + 1)) if a <= b else list(range(a, 7)) + list(range(0, b + 1))
+                else:
+                    seq = list(range(a, b + 1)) if a <= b else list(range(a, hi + 1)) + list(range(lo, b + 1))
+            else:
+                a = _value(base, index)
+                if len(bits) == 2:
+                    seq = list(range(a, hi + 1))
+                else:
+                    seq = [a]
+            values.update(seq[::step])
+    any_value = raw == "*" or (index in (2, 4) and raw == "")
+    return values, any_value, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("invalid expression")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        if expr.lower() not in _SHORT:
+            raise ValueError("unknown shortcut")
+        expr = _SHORT[expr.lower()]
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    return [_field(x, i) for i, x in enumerate(parts)]
+
+
+def _day_ok(day, month, year, dom, dow):
+    d, d_any, d_special = dom
+    w, w_any, w_special = dow
+    last = calendar.monthrange(year, month)[1]
+    weekday = (dt.date(year, month, day).weekday() + 1) % 7
+    dom_ok = d_any or day in d or d_special == "lastday" and day == last
+    dow_ok = w_any or weekday in w or weekday == 0 and 7 in w
+    for n, k in w_special:
+        if weekday == n and ((k == "last" and day + 7 > last) or (k != "last" and (day - 1) // 7 + 1 == k)):
+            dow_ok = True
+    return dom_ok and dow_ok
 
 
