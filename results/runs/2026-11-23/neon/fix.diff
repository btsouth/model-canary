+        floor = exact.numerator // exact.denominator
+        floors.append(floor)
+        remainders.append(exact - floor)
+
+    leftover = abs_total - sum(floors)
+    order = sorted(range(len(frac_weights)), key=lambda i: (-remainders[i], i))
+    for i in order[:leftover]:
+        floors[i] += 1
+
+    if sign < 0:
