--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,335 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from datetime import date, datetime, timedelta
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4,
+    "MAY": 5, "JUN": 6, "JUL": 7, "AUG": 8,
+    "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+
+_DOW_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3,
+    "THU": 4, "FRI": 5, "SAT": 6,
+}
+
+_SEP_RE = re.compile(r"[ \t]+")
+
+
+def _parse_int(token):
+    if not token or not (token.isascii() and token.isdigit()):
+        raise ValueError(f"invalid number: {token!r}")
+    return int(token)
+
+
+def _parse_value(token, lo, hi, names):
+    if not token:
+        raise ValueError("empty value")
+    if names is not None and token.upper() in names:
+        return names[token.upper()]
+    val = _parse_int(token)
+    if val < lo or val > hi:
+        raise ValueError(f"value {val} out of range [{lo}, {hi}]")
+    return val
+
+
+def _parse_simple_field(field, lo, hi, names=None):
+    items = field.split(",")
+    result = set()
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in field: {field!r}")
+        if "/" in item:
+            parts = item.split("/")
+            if len(parts) != 2:
+                raise ValueError(f"invalid step syntax: {item!r}")
+            base, step_str = parts
+            step = _parse_int(step_str)
+            if step < 1:
+                raise ValueError(f"step must be >= 1: {item!r}")
+        else:
+            base = item
+            step = None
+
+        if base == "*":
+            values = list(range(lo, hi + 1))
+        elif "-" in base:
+            rparts = base.split("-")
+            if len(rparts) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            a = _parse_value(rparts[0], lo, hi, names)
+            b = _parse_value(rparts[1], lo, hi, names)
+            if a <= b:
+                values = list(range(a, b + 1))
+            else:
+                values = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            val = _parse_value(base, lo, hi, names)
+            if step is not None:
+                values = list(range(val, hi + 1))
+            else:
+                values = [val]
+
+        if step is not None:
+            values = values[::step]
+        result.update(values)
+    return result
+
+
+def _parse_dom_field(field):
+    if field == "?":
+        return set(range(1, 32)), False
+    items = field.split(",")
+    days = set()
+    has_last = False
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in field: {field!r}")
+        if item == "L":
+            has_last = True
+            continue
+        days.update(_parse_simple_field(item, 1, 31, names=None))
+    return days, has_last
+
+
+def _parse_dow_field(field):
+    if field == "?":
+        return set(range(0, 7)), set(), set()
+    items = field.split(",")
+    days = set()
+    last_days = set()
+    nth_days = set()
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in field: {field!r}")
+        if item.endswith("L"):
+            if "/" in item or "-" in item or "#" in item:
+                raise ValueError(f"invalid dow item: {item!r}")
+            n_str = item[:-1]
+            n = _parse_int(n_str)
+            if n < 0 or n > 7:
+                raise ValueError(f"day of week out of range: {item!r}")
+            last_days.add(n % 7)
+            continue
+        if "#" in item:
+            if "/" in item or "-" in item:
+                raise ValueError(f"invalid dow item: {item!r}")
+            parts = item.split("#")
+            if len(parts) != 2:
+                raise ValueError(f"invalid dow item: {item!r}")
+            n = _parse_int(parts[0])
+            k = _parse_int(parts[1])
+            if n < 0 or n > 7 or k < 1 or k > 5:
+                raise ValueError(f"invalid dow nth item: {item!r}")
+            nth_days.add((n % 7, k))
+            continue
+
+        if "/" in item:
+            parts = item.split("/")
+            if len(parts) != 2:
+                raise ValueError(f"invalid step syntax: {item!r}")
+            base, step_str = parts
+            step = _parse_int(step_str)
+            if step < 1:
+                raise ValueError(f"step must be >= 1: {item!r}")
+        else:
+            base = item
+            step = None
+
+        if base == "*":
+            values = list(range(0, 7))
+        elif "-" in base:
+            rparts = base.split("-")
+            if len(rparts) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            a = _parse_value(rparts[0], 0, 7, _DOW_NAMES)
+            b = _parse_value(rparts[1], 0, 7, _DOW_NAMES)
+            if a <= b:
+                values = [v % 7 for v in range(a, b + 1)]
+            else:
+                a_norm = a % 7
+                b_norm = b % 7
+                if a_norm <= b_norm:
+                    values = list(range(a_norm, b_norm + 1))
+                else:
+                    values = list(range(a_norm, 7)) + list(range(0, b_norm + 1))
+        else:
+            val = _parse_value(base, 0, 7, _DOW_NAMES)
+            val_norm = val % 7
+            if step is not None:
+                values = list(range(val_norm, 7))
+            else:
+                values = [val_norm]
+
+        if step is not None:
+            values = values[::step]
+        days.update(values)
+
+    return days, last_days, nth_days
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, dom_days, dom_last, months, dow_days, dow_last, dow_nth):
+        self.minutes = sorted(minutes)
+        self.minutes_set = minutes
+        self.hours = sorted(hours)
+        self.hours_set = hours
+        self.dom_days = dom_days
+        self.dom_last = dom_last
+        self.months = sorted(months)
+        self.months_set = months
+        self.dow_days = dow_days
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+
+    def day_matches(self, year, month, day):
+        last_day = calendar.monthrange(year, month)[1]
+        if not (day in self.dom_days or (self.dom_last and day == last_day)):
+            return False
+        dow = (date(year, month, day).weekday() + 1) % 7
+        if dow in self.dow_days:
+            return True
+        if dow in self.dow_last and day + 7 > last_day:
+            return True
+        if (dow, (day - 1) // 7 + 1) in self.dow_nth:
+            return True
+        return False
+
+
+def _parse_expr(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+    s = expr.strip()
+    if not s:
+        raise ValueError("empty schedule expression")
+    lower = s.lower()
+    if lower in _SHORTCUTS:
+        s = _SHORTCUTS[lower]
+    fields = _SEP_RE.split(s)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields)}: {expr!r}")
+
+    min_f, hour_f, dom_f, mon_f, dow_f = fields
+    minutes = _parse_simple_field(min_f, 0, 59)
+    hours = _parse_simple_field(hour_f, 0, 23)
+    dom_days, dom_last = _parse_dom_field(dom_f)
+    months = _parse_simple_field(mon_f, 1, 12, names=_MONTH_NAMES)
+    dow_days, dow_last, dow_nth = _parse_dow_field(dow_f)
+    return _Schedule(minutes, hours, dom_days, dom_last, months, dow_days, dow_last, dow_nth)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
