--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,195 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+
+# (minimum, maximum, names mapping or None)
+_MINUTE = (0, 59, None)
+_HOUR = (0, 23, None)
+_DOM = (1, 31, None)
+_MONTH = (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)})
+_DOW = (0, 7, {name: i for i, name in enumerate(_DAYS)})
+
+_LIMIT = _dt.timedelta(days=10 * 365)
+_MINUTE_STEP = _dt.timedelta(minutes=1)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last", "dom_any",
+                 "dow", "dow_last", "dow_nth", "dow_any", "times")
+
+
+def _number(text, lo, hi):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"value {value} out of range {lo}-{hi}")
+    return value
+
+
+def _value(text, spec):
+    lo, hi, names = spec
+    if names is not None and _NAME.fullmatch(text):
+        value = names.get(text.upper())
+        if value is None:
+            raise ValueError(f"unknown name: {text!r}")
+        return value
+    return _number(text, lo, hi)
+
+
+def _item_values(item, spec, is_dow):
+    """The values a plain item (`*`, `N`, `A-B`, optional `/S`) lists, in order."""
+    lo, hi, _ = spec
+    if not item:
+        raise ValueError("empty item")
+    step = 1
+    if "/" in item:
+        base, step_text = item.split("/", 1)
+        step = _number(step_text, 1, float("inf"))
+    else:
+        base = item
+    if not base:
+        raise ValueError(f"bad item: {item!r}")
+    if base == "*":
+        values = list(range(lo, 7 if is_dow else hi + 1))
+    elif "-" in base:
+        a_text, b_text = base.split("-", 1)
+        a = _value(a_text, spec)
+        b = _value(b_text, spec)
+        if a <= b:
+            values = list(range(a, b + 1))
+        elif is_dow:
+            a, b = a % 7, b % 7
+            values = [a]
+            while values[-1] != b:
+                values.append((values[-1] + 1) % 7)
+        else:
+            values = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        n = _value(base, spec)
+        values = list(range(n, hi + 1)) if "/" in item else [n]
+    return values[::step]
+
+
+def _field(text, spec, kind):
+    """Parse one field. Returns (values, any, last, nth)."""
+    is_dow = kind == "dow"
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(), True, set(), set()
+    values, last, nth = set(), set(), set()
+    for item in text.split(","):
+        if kind == "dom" and item == "L":
+            last.add(True)
+            continue
+        if is_dow and item.endswith("L") and "/" not in item:
+            last.add(_number(item[:-1], 0, 7) % 7)
+            continue
+        if is_dow and "#" in item:
+            n_text, k_text = item.split("#", 1)
+            nth.add((_number(n_text, 0, 7) % 7, _number(k_text, 1, 5)))
+            continue
+        for v in _item_values(item, spec, is_dow):
+            values.add(v % 7 if is_dow else v)
+    return values, text == "*", last, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string: {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower() if text.isascii() else None
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {text!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+    s = _Schedule()
+    s.minutes = _field(parts[0], _MINUTE, "minute")[0]
+    s.hours = _field(parts[1], _HOUR, "hour")[0]
+    s.dom, s.dom_any, dom_last, _ = _field(parts[2], _DOM, "dom")
+    s.dom_last = bool(dom_last)
+    s.months = _field(parts[3], _MONTH, "month")[0]
+    s.dow, s.dow_any, s.dow_last, s.dow_nth = _field(parts[4], _DOW, "dow")
+    s.times = sorted((h, m) for h in s.hours for m in s.minutes)
+    return s
+
+
+def _days_in_month(year, month):
+    if month == 12:
+        return 31
+    return (_dt.date(year, month + 1, 1) - _dt.date(year, month, 1)).days
+
+
+def _day_allowed(s, day):
+    if day.month not in s.months:
+        return False
+    if not s.dom_any or not s.dow_any:
+        length = _days_in_month(day.year, day.month)
+    if not s.dom_any:
+        if not (day.day in s.dom or (s.dom_last and day.day == length)):
+            return False
+    if not s.dow_any:
+        weekday = (day.weekday() + 1) % 7
+        if not (weekday in s.dow
+                or (weekday in s.dow_last and day.day + 7 > length)
+                or (weekday, (day.day - 1) // 7 + 1) in s.dow_nth):
+            return False
+    return True
 
 
