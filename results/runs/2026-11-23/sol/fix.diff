 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+
+    def value(token):
+        n = names[token] if token in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return n
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    values, special = set(), []
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        if index == 4:
+            last = re.fullmatch(r"([0-9]+)L", item)
+            nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if last or nth:
+                n = value((last or nth).group(1)) % 7
+                if last:
+                    special.append(("last_weekday", n))
+                else:
+                    k = _number(nth.group(2))
+                    if not 1 <= k <= 5:
+                        raise ValueError("weekday occurrence must be 1 to 5")
+                    special.append(("nth_weekday", n, k))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError("too many steps")
+        base = parts[0]
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError("invalid range")
+            start, end = map(value, ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown shortcut") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("expected five fields")
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    weekday = (day.weekday() + 1) % 7
+    month_end = calendar.monthrange(day.year, day.month)[1]
+    dom = day.day in fields[2][0] or bool(fields[2][1]) and day.day == month_end
+    dow = weekday in fields[4][0]
+    for special in fields[4][1]:
+        if weekday == special[1]:
+            if special[0] == "last_weekday":
+                dow |= day.day + 7 > month_end
+            else:
+                dow |= (day.day - 1) // 7 + 1 == special[2]
+    return dom and dow
+
 
