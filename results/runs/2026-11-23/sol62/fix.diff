 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_SEARCH_DAYS = 10 * 365
+
+
+@dataclass
+class _Schedule:
+    minutes: set[int]
+    hours: set[int]
+    days: set[int]
+    months: set[int]
+    weekdays: set[int]
+    last_day: bool
+    last_weekdays: set[int]
+    nth_weekdays: set[tuple[int, int]]
+
+    def allows_day(self, day):
+        if day.month not in self.months:
+            return False
+        if day.day not in self.days:
+            if not self.last_day or day.day != monthrange(day.year, day.month)[1]:
+                return False
+
+        weekday = (day.weekday() + 1) % 7
+        return (
+            weekday in self.weekdays
+            or (weekday, (day.day - 1) // 7 + 1) in self.nth_weekdays
+            or (weekday in self.last_weekdays and day.day + 7 > monthrange(day.year, day.month)[1])
+        )
+
+
+def _decimal(token, limit):
+    if re.fullmatch(r"[0-9]+", token) is None:
+        raise ValueError(f"invalid number: {token!r}")
+    digits = token.lstrip("0")
+    if len(digits) > len(str(limit)):
+        return limit
+    return min(int(digits or "0"), limit)
+
+
+def _value(token, minimum, maximum, names):
+    if names and token.isascii() and token.upper() in names:
+        return names[token.upper()]
+    value = _decimal(token, maximum + 1)
+    if not minimum <= value <= maximum:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _item_values(item, minimum, maximum, names=None):
+    base, slash, step_text = item.partition("/")
+    step = _decimal(step_text, maximum - minimum + 1) if slash else 1
+    if step == 0:
+        raise ValueError("step must be positive")
+
+    if base == "*":
+        values = range(minimum, maximum + 1)
+    else:
+        first, dash, last = base.partition("-")
+        start = _value(first, minimum, maximum, names)
+        end = maximum if slash else start
+        if dash:
+            end = _value(last, minimum, maximum, names)
+        if start <= end:
+            values = range(start, end + 1)
+        else:
+            wrap_maximum = 6 if names is _WEEKDAYS else maximum
+            values = [*range(start, wrap_maximum + 1), *range(minimum, end + 1)]
+
+    if names is _WEEKDAYS:
+        return {value % 7 for value in values[::step]}
+    return set(values[::step])
+
+
+def _field_values(field, minimum, maximum, names=None):
+    values = set()
+    for item in field.split(","):
+        values.update(_item_values(item, minimum, maximum, names))
+    return values
+
+
+def _day_items(field):
+    return ["*"] if field == "?" else field.split(",")
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+    expr = expr.strip()
+    if expr.isascii():
+        expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule expression must have five fields")
+    minute, hour, day, month, weekday = fields
+
+    days = set()
+    last_day = False
+    for item in _day_items(day):
+        if item == "L":
+            last_day = True
+        else:
+            days.update(_item_values(item, 1, 31))
+
+    weekdays, last_weekdays, nth_weekdays = set(), set(), set()
+    for item in _day_items(weekday):
+        if item.endswith("L"):
+            last_weekdays.add(_value(item[:-1], 0, 7, None) % 7)
+        elif "#" in item:
+            number, _, occurrence = item.partition("#")
+            nth_weekdays.add((_value(number, 0, 7, None) % 7, _value(occurrence, 1, 5, None)))
+        else:
+            weekdays.update(_item_values(item, 0, 7, _WEEKDAYS))
+
+    return _Schedule(
+        _field_values(minute, 0, 59),
+        _field_values(hour, 0, 23),
+        days,
+        _field_values(month, 1, 12, _MONTHS),
+        weekdays,
+        last_day,
+        last_weekdays,
+        nth_weekdays,
+    )
+
 
