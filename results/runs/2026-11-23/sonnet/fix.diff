 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUM = re.compile(r"[0-9]+")
+
+
+def _bad(msg):
+    raise ValueError(msg)
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        _bad(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        _bad(f"value out of range: {tok!r}")
+    return v
+
+
+def _parse_field(text, lo, hi, names, kind):
+    """Return (values, flags). kind is 'dom', 'dow' or None."""
+    values = set()
+    last_dom = False
+    last_dow = set()   # weekdays (0-6) for NL
+    nth = set()        # (weekday, k)
+    if text == "?":
+        if kind is None:
+            _bad("? not allowed here")
+        text = "*"
+    items = text.split(",")
+    for item in items:
+        if not item:
+            _bad("empty item")
+        if kind == "dom" and item.upper() == "L":
+            last_dom = True
+            continue
+        if kind == "dow":
+            m = re.fullmatch(r"([0-9]+)[lL]", item)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    _bad("bad weekday")
+                last_dow.add(n % 7)
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if n > 7 or not 1 <= k <= 5:
+                    _bad("bad N#K")
+                nth.add((n % 7, k))
+                continue
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.fullmatch(step) or int(step) < 1:
+                _bad("bad step")
+            step = int(step)
+            names_ok = None
+        else:
+            step = 1
+            names_ok = names
+        if base == "*":
+            seq = list(range(lo, (6 if kind == "dow" else hi) + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            a = _value(a, lo, hi, names_ok)
+            b = _value(b, lo, hi, names_ok)
+            if kind == "dow":
+                if a == 7:
+                    a = 0
+                if a <= b:
+                    seq = list(range(a, b + 1))
+                else:
+                    seq = list(range(a, 7)) + list(range(0, b + 1))
+            elif a <= b:
+                seq = list(range(a, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, lo, hi, names_ok)
+            seq = list(range(a, hi + 1)) if sep else [a]
+        seq = seq[::step]
+        if kind == "dow":
+            seq = [v % 7 for v in seq]
+        values.update(seq)
+    return values, last_dom, last_dow, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        key = expr.lower()
+        if key not in _SHORTCUTS:
+            _bad("unknown shortcut")
+        expr = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        _bad("need five fields")
+    minute = _parse_field(parts[0], 0, 59, None, None)
+    hour = _parse_field(parts[1], 0, 23, None, None)
+    dom = _parse_field(parts[2], 1, 31, None, "dom")
+    month = _parse_field(parts[3], 1, 12, _MONTHS, None)
+    dow = _parse_field(parts[4], 0, 7, _DAYS, "dow")
+    return sorted(minute[0]), sorted(hour[0]), dom, month[0], dow
+
+
+def _day_ok(dom, dow, d):
+    if dom is not None:
+        values, last_dom, _, _ = dom
+        last = calendar.monthrange(d.year, d.month)[1]
+        if not (d.day in values or (last_dom and d.day == last)):
+            return False
+    if dow is not None:
+        values, _, last_dow, nth = dow
+        wd = (d.weekday() + 1) % 7
+        ok = wd in values
+        if not ok and wd in last_dow:
+            ok = d.day + 7 > calendar.monthrange(d.year, d.month)[1]
+        if not ok and nth:
+            ok = (wd, (d.day - 1) // 7 + 1) in nth
+        if not ok:
+            return False
+    return True
 
 
