 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(text):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if text.upper() in names:
+                return names[text.upper()]
+            if not re.fullmatch(r'[0-9]+', text):
+                raise ValueError('invalid value')
+            n = int(text)
+            if not low <= n <= high:
+                raise ValueError('value out of range')
+            return n
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])(?:(L)|#([1-5]))', item) if index == 4 else None
+            if match:
+                special.append(('last_weekday' if match.group(2) else 'nth', int(match.group(1)) % 7, int(match.group(3) or 0)))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                sequence = list(range(low, high + 1))
+            elif '-' in base:
+                ends = base.split('-')
+                if len(ends) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, ends)
+                if index == 4:
+                    start, end = start % 7, end % 7
+                    sequence = list(range(start, end + 1)) if start <= end else list(range(start, 7)) + list(range(0, end + 1))
+                else:
+                    sequence = list(range(start, end + 1)) if start <= end else list(range(start, high + 1)) + list(range(low, end + 1))
+            else:
+                start = number(base)
+                sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+            values.update(n % 7 if index == 4 else n for n in sequence[::step])
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    weekday = (date.weekday() + 1) % 7
+    return (date.day in dom or (('last',) in dom_special and date.day == last)) and (
+        weekday in dow or any(weekday == n and (date.day + 7 > last if kind == 'last_weekday' else (date.day - 1) // 7 + 1 == k) for kind, n, k in dow_special))
+
 
