 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+
+
+def _number(text, low, high, names=None):
+    if re.fullmatch(r"[0-9]+", text):
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"invalid value: {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("a schedule needs five fields")
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _BOUNDS[index]
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+        values, specials = set(), []
+        if field == "?" and index in (2, 4):
+            field = "*"
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                specials.append(("last",))
+                continue
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if index == 4 and special:
+                day = _number(special[1], 0, 7) % 7
+                if special[2] == "L":
+                    specials.append(("last_weekday", day))
+                else:
+                    specials.append(("nth_weekday", day, _number(special[3], 1, 5)))
+                continue
+            pieces = item.split("/")
+            if len(pieces) > 2:
+                raise ValueError(f"invalid item: {item!r}")
+            base = pieces[0]
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError(f"invalid step: {item!r}")
+                step = int(pieces[1])
+            if base == "*":
+                start, end = low, high
+            elif "-" in base:
+                endpoints = base.split("-")
+                if len(endpoints) != 2:
+                    raise ValueError(f"invalid range: {item!r}")
+                start, end = (_number(v, low, high, names) for v in endpoints)
+                if start > end:
+                    raise ValueError(f"reversed range: {item!r}")
+            else:
+                start = _number(base, low, high, names)
+                end = high if len(pieces) == 2 else start
+            values.update(range(start, end + 1, step))
+        if index == 4:
+            values = {value % 7 for value in values}
+        parsed.append((values, specials))
+    return parsed
+
+
+def _day_matches(parsed, day, weekday, month_length):
+    days, day_specials = parsed[2]
+    weekdays, weekday_specials = parsed[4]
+    if day not in days and not (day_specials and day == month_length):
+        return False
+    if weekday in weekdays:
+        return True
+    for special in weekday_specials:
+        if weekday == special[1]:
+            if special[0] == "last_weekday" and day + 7 > month_length:
+                return True
+            if special[0] == "nth_weekday" and (day - 1) // 7 + 1 == special[2]:
+                return True
+    return False
+
 
