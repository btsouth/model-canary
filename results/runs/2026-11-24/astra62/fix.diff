 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from calendar import monthrange
+from dataclasses import dataclass, field
+from datetime import datetime, timedelta
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _number(text, low, high, names):
+    if text.upper() in names and text.isascii():
+        return names[text.upper()]
+    if re.fullmatch(r"[0-9]+", text):
+        value = int(text.lstrip("0") or "0")
+        if low <= value <= high:
+            return value
+    raise ValueError(f"invalid field value: {text!r}")
+
+
+@dataclass
+class _Field:
+    values: set = field(default_factory=set)
+    last_day: bool = False
+    last_weekdays: set = field(default_factory=set)
+    nth_weekdays: set = field(default_factory=set)
+
+
+def _parse_field(text, low, high, names, *, month_day=False, week_day=False):
+    result = _Field()
+    if text == "?" and (month_day or week_day):
+        text = "*"
+    for item in text.split(","):
+        if month_day and item == "L":
+            result.last_day = True
+            continue
+        if week_day:
+            special = re.fullmatch(r"([0-9]+)(?:L|#([0-9]+))", item)
+            if special:
+                weekday = _number(special[1], 0, 7, {}) % 7
+                if special[2] is None:
+                    result.last_weekdays.add(weekday)
+                else:
+                    occurrence = _number(special[2], 1, 5, {})
+                    result.nth_weekdays.add((weekday, occurrence))
+                continue
+
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not re.fullmatch(r"[0-9]+", step_text) or not step_text.strip("0"):
+                raise ValueError(f"invalid step: {step_text!r}")
+            # Any step wider than the field selects only its first value.
+            step = int(step_text.lstrip("0")[:3])
+        if base == "*":
+            start, end = low, high
+        else:
+            first, dash, last = base.partition("-")
+            start = _number(first, low, high, names)
+            end = _number(last, low, high, names) if dash else (high if slash else start)
+            if end < start:
+                raise ValueError(f"descending range: {base!r}")
+        result.values.update(range(start, end + 1, step))
+    if week_day and 7 in result.values:
+        result.values.remove(7)
+        result.values.add(0)
+    return result
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    minute, hour, day, month, weekday = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    return (
+        _parse_field(minute, 0, 59, {}).values,
+        _parse_field(hour, 0, 23, {}).values,
+        _parse_field(day, 1, 31, {}, month_day=True),
+        _parse_field(month, 1, 12, _MONTHS).values,
+        _parse_field(weekday, 0, 7, _WEEKDAYS, week_day=True),
+    )
+
+
+def _allowed_day(day, weekday, length, month_days, week_days):
+    return (day in month_days.values or (month_days.last_day and day == length)) and (
+        weekday in week_days.values
+        or (day + 7 > length and weekday in week_days.last_weekdays)
+        or (weekday, (day - 1) // 7 + 1) in week_days.nth_weekdays
+    )
+
 
