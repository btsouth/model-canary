 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import datetime, timedelta
+
+_MONTHS = {
+    name: number
+    for number, name in enumerate(
+        ("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
+        1,
+    )
+}
+_WEEKDAYS = {
+    name: number
+    for number, name in enumerate(
+        ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT")
+    )
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+
+
+class _Schedule:
+    __slots__ = (
+        "minutes",
+        "hours",
+        "days_of_month",
+        "last_day",
+        "months",
+        "days_of_week",
+        "last_weekday",
+        "nth_weekday",
+    )
+
+    def __init__(
+        self,
+        minutes,
+        hours,
+        days_of_month,
+        last_day,
+        months,
+        days_of_week,
+        last_weekday,
+        nth_weekday,
+    ):
+        self.minutes = tuple(sorted(minutes))
+        self.hours = tuple(sorted(hours))
+        self.days_of_month = frozenset(days_of_month)
+        self.last_day = last_day
+        self.months = frozenset(months)
+        self.days_of_week = frozenset(days_of_week)
+        self.last_weekday = frozenset(last_weekday)
+        self.nth_weekday = frozenset(nth_weekday)
+
+
+def _named_value(token, low, high, names):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+        if value < low or value > high:
+            raise ValueError(f"value out of range: {token!r}")
+        return value
+    if names is not None:
+        value = names.get(token.upper())
+        if value is not None:
+            return value
+    raise ValueError(f"bad value: {token!r}")
+
+
+def _generic_item(item, low, high, names):
+    if item.count("/") > 1:
+        raise ValueError(f"bad item: {item!r}")
+
+    if "/" in item:
+        base, step_text = item.split("/")
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+
+        if base == "*":
+            listed = list(range(low, high + 1))
+        elif "-" in base:
+            first, last = base.split("-")
+            if not _NUMBER.fullmatch(first) or not _NUMBER.fullmatch(last):
+                raise ValueError(f"name in a step: {item!r}")
+            first, last = int(first), int(last)
+            if first < low or last > high or first > last:
+                raise ValueError(f"bad range: {item!r}")
+            listed = list(range(first, last + 1))
+        else:
+            if not _NUMBER.fullmatch(base):
+                raise ValueError(f"name in a step: {item!r}")
+            first = int(base)
+            if first < low or first > high:
+                raise ValueError(f"value out of range: {item!r}")
+            listed = list(range(first, high + 1))
+        return set(listed[::step])
+
+    if item == "*":
+        return set(range(low, high + 1))
+
+    if "-" in item:
+        first, last = item.split("-")
+        first = _named_value(first, low, high, names)
+        last = _named_value(last, low, high, names)
+        if first > last:
+            raise ValueError(f"bad range: {item!r}")
+        return set(range(first, last + 1))
+
+    return {_named_value(item, low, high, names)}
+
+
+def _parse_field(field, low, high, names):
+    values = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+        values.update(_generic_item(item, low, high, names))
+    return values
+
+
+def _parse_day_of_month(field):
+    if field == "?":
+        return set(range(1, 32)), False
+    values = set()
+    last_day = False
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if item == "L":
+            last_day = True
+        else:
+            values.update(_generic_item(item, 1, 31, None))
+    return values, last_day
+
+
+def _parse_day_of_week(field):
+    if field == "?":
+        return set(range(0, 7)), set(), set()
+
+    values = set()
+    last_weekday = set()
+    nth_weekday = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+
+        match = re.fullmatch(r"([0-9]+)L", item)
+        if match:
+            weekday = int(match.group(1))
+            if weekday > 7:
+                raise ValueError(f"weekday out of range: {item!r}")
+            last_weekday.add(weekday % 7)
+            continue
+
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if match:
+            weekday = int(match.group(1))
+            occurrence = int(match.group(2))
+            if weekday > 7 or occurrence < 1 or occurrence > 5:
+                raise ValueError(f"bad weekday item: {item!r}")
+            nth_weekday.add((weekday % 7, occurrence))
+            continue
+
+        values.update(_generic_item(item, 0, 7, _WEEKDAYS))
+
+    return {value % 7 for value in values}, last_weekday, nth_weekday
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+    text = expr.strip()
+    shortcut = _SHORTCUTS.get(text.lower())
+    if shortcut is not None:
+        text = shortcut
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"bad schedule expression: {expr!r}")
+
+    minutes = _parse_field(fields[0], 0, 59, None)
+    hours = _parse_field(fields[1], 0, 23, None)
+    days_of_month, last_day = _parse_day_of_month(fields[2])
+    months = _parse_field(fields[3], 1, 12, _MONTHS)
+    days_of_week, last_weekday, nth_weekday = _parse_day_of_week(fields[4])
+
+    return _Schedule(
+        minutes,
+        hours,
+        days_of_month,
+        last_day,
+        months,
+        days_of_week,
+        last_weekday,
+        nth_weekday,
+    )
+
+
+def _last_day_of_month(day):
+    return calendar.monthrange(day.year, day.month)[1]
+
+
+def _day_matches(schedule, day):
+    last_day = _last_day_of_month(day)
+    if day.day not in schedule.days_of_month:
+        if not (schedule.last_day and day.day == last_day):
+            return False
+
+    weekday = (day.weekday() + 1) % 7
+    if weekday in schedule.days_of_week:
+        return True
+    if weekday in schedule.last_weekday and day.day + 7 > last_day:
+        return True
+    occurrence = (day.day - 1) // 7 + 1
+    return (weekday, occurrence) in schedule.nth_weekday
+
+
+def _first_time(schedule, min_hour, min_minute):
+    for hour in schedule.hours:
+        if hour < min_hour:
+            continue
+        if hour == min_hour:
+            position = bisect_left(schedule.minutes, min_minute)
+            if position < len(schedule.minutes):
+                return hour, schedule.minutes[position]
+        else:
+            return hour, schedule.minutes[0]
+    return None
+
 
