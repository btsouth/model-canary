 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_LIMIT = _dt.timedelta(days=50 * 365)
+
+
+def _number(text, names, low, high, expr):
+    """Parse a plain number or (if names given) a three-letter name."""
+    if text.isdigit() and text.isascii():
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names.index(text.upper()) + (1 if names is _MONTHS else 0)
+    else:
+        raise ValueError(f"bad value {text!r} in {expr!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range in {expr!r}")
+    return value
+
+
+def _step(text, expr):
+    if not (text.isdigit() and text.isascii()) or int(text) < 1:
+        raise ValueError(f"bad step {text!r} in {expr!r}")
+    return int(text)
+
+
+def _parse_item(item, low, high, names, expr):
+    """Parse one plain item (*, N, A-B, with optional /S) into a list of values."""
+    if not item:
+        raise ValueError(f"empty item in {expr!r}")
+    step = 1
+    if "/" in item:
+        base, _, step_text = item.partition("/")
+        step = _step(step_text, expr)
+        if "/" in step_text or not base:
+            raise ValueError(f"bad item {item!r} in {expr!r}")
+    else:
+        base = item
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        start = _number(a, names, low, high, expr)
+        end = _number(b, names, low, high, expr)
+        if start > end:
+            raise ValueError(f"range {base!r} reversed in {expr!r}")
+        values = list(range(start, end + 1))
+    else:
+        start = _number(base, names, low, high, expr)
+        if "/" in item:
+            values = list(range(start, high + 1))
+        else:
+            values = [start]
+    return values[::step]
+
+
+def _parse_simple(field, low, high, names, expr):
+    values = set()
+    for item in field.split(","):
+        values.update(_parse_item(item, low, high, names, expr))
+    return values
+
+
+def _parse_dom(field, expr):
+    """Return (set of days or None for every day, last_flag)."""
+    if field == "?" or field == "*":
+        return None, False
+    days, last = set(), False
+    for item in field.split(","):
+        if item.upper() == "L":
+            last = True
+        else:
+            days.update(_parse_item(item, 1, 31, None, expr))
+    return days, last
+
+
+def _parse_dow(field, expr):
+    """Return (set of weekdays or None, list of (N, 'L'|K) specials)."""
+    if field == "?" or field == "*":
+        return None, []
+    days, specials = set(), []
+    for item in field.split(","):
+        upper = item.upper()
+        if "#" in item:
+            n, _, k = item.partition("#")
+            if not (n.isdigit() and k.isdigit() and n.isascii() and k.isascii()):
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            n, k = int(n), int(k)
+            if not 0 <= n <= 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            specials.append((n % 7, k))
+        elif upper.endswith("L") and upper[:-1].isdigit() and upper[:-1].isascii():
+            n = int(upper[:-1])
+            if not 0 <= n <= 7:
+                raise ValueError(f"bad item {item!r} in {expr!r}")
+            specials.append((n % 7, "L"))
+        else:
+            days.update(v % 7 for v in _parse_item(item, 0, 7, _DAYS, expr))
+    return days, specials
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "months", "dom", "dom_last", "dow", "dow_special")
+
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad expression {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            try:
+                text = _SHORTCUTS[text.lower()]
+            except KeyError:
+                raise ValueError(f"unknown shortcut {expr!r}") from None
+        fields = text.split()
+        if len(fields) != 5:
+            raise ValueError(f"expected 5 fields in {expr!r}")
+        minute, hour, dom, month, dow = fields
+        self.minutes = _parse_simple(minute, 0, 59, None, expr)
+        self.hours = _parse_simple(hour, 0, 23, None, expr)
+        self.dom, self.dom_last = _parse_dom(dom, expr)
+        self.months = _parse_simple(month, 1, 12, _MONTHS, expr)
+        self.dow, self.dow_special = _parse_dow(dow, expr)
+
+    def day_allowed(self, date):
+        if date.month not in self.months:
+            return False
+        days_in_month = calendar.monthrange(date.year, date.month)[1]
+        if self.dom is not None:
+            if date.day not in self.dom and not (self.dom_last and date.day == days_in_month):
+                return False
+        if self.dow is not None:
+            weekday = date.isoweekday() % 7
+            ok = weekday in self.dow
+            for n, k in self.dow_special:
+                if n != weekday:
+                    continue
+                if k == "L":
+                    ok = ok or date.day + 7 > days_in_month
+                else:
+                    ok = ok or (date.day - 1) // 7 + 1 == k
+            if not ok:
+                return False
+        return True
+
 
