 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+# (low, high, names) for minute, hour, day of month, month, day of week
+_SPECS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+
+def _value(text, low, high, names):
+    if _NUMBER.fullmatch(text):
+        number = int(text)
+    elif names is not None and text.upper() in names:
+        number = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= number <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return number
+
+
+def _field(text, index):
+    """Return (values, last, last_dows, nth_dows) for one field."""
+    low, high, names = _SPECS[index]
+    values, last, last_dows, nth_dows = set(), False, set(), set()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    for item in text.split(","):
+        if index == _DOM and item == "L":
+            last = True
+            continue
+        if index == _DOW:
+            found = _LAST_DOW.fullmatch(item)
+            if found:
+                last_dows.add(_value(found.group(1), 0, 7, None) % 7)
+                continue
+            found = _NTH_DOW.fullmatch(item)
+            if found:
+                nth = _value(found.group(2), 1, 5, None)
+                nth_dows.add((_value(found.group(1), 0, 7, None) % 7, nth))
+                continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1: {item!r}")
+        if base == "*":
+            first, final = low, high
+        elif "-" in base:
+            left, _, right = base.partition("-")
+            first = _value(left, low, high, names)
+            final = _value(right, low, high, names)
+            if first > final:
+                raise ValueError(f"range runs backwards: {item!r}")
+        else:
+            first = _value(base, low, high, names)
+            final = high if slash else first
+        picked = range(first, final + 1, step)
+        values.update(v % 7 for v in picked) if index == _DOW else values.update(picked)
+    return values, last, last_dows, nth_dows
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        expr = expr.strip()
+        if expr.startswith("@"):
+            if expr.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            expr = _SHORTCUTS[expr.lower()]
+        parts = re.split(r"[ \t]+", expr)
+        if len(parts) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        parsed = [_field(part, i) for i, part in enumerate(parts)]
+        self.minutes = sorted(parsed[0][0])
+        self.hours = sorted(parsed[1][0])
+        self.doms, self.last_dom = parsed[2][0], parsed[2][1]
+        self.months = parsed[3][0]
+        self.dows, _, self.last_dows, self.nth_dows = parsed[4]
+
+    def day_ok(self, day, dow, days_in_month):
+        """dow is 0 for Sunday."""
+        if not (day in self.doms or (self.last_dom and day == days_in_month)):
+            return False
+        if dow in self.dows:
+            return True
+        if dow in self.last_dows and day + 7 > days_in_month:
+            return True
+        return (dow, (day - 1) // 7 + 1) in self.nth_dows
+
+    def date_ok(self, year, month, day):
+        if month not in self.months:
+            return False
+        first_weekday, days_in_month = calendar.monthrange(year, month)
+        dow = (first_weekday + day) % 7  # Monday=0 on the 1st -> Sunday=0 scale
+        return self.day_ok(day, dow, days_in_month)
+
+    def first_time(self, hour, minute):
+        """First (hour, minute) run at or after the given time of day, or None."""
+        for h in self.hours:
+            if h < hour:
+                continue
+            if h > hour:
+                return h, self.minutes[0]
+            for m in self.minutes:
+                if m >= minute:
+                    return h, m
+        return None
 
 
