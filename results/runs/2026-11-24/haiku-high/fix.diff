 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from typing import NamedTuple
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"],
+        start=1,
+    )
+}
+_DAY_NAMES = {name: number for number, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# kind -> (lowest value, highest value, name table or None)
+_BOUNDS = {
+    "minute": (0, 59, None),
+    "hour": (0, 23, None),
+    "dom": (1, 31, None),
+    "month": (1, 12, _MONTH_NAMES),
+    "dow": (0, 7, _DAY_NAMES),
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")  # day of week only, e.g. 5L
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")  # day of week only, e.g. 1#2
+
+_SPAN = dt.timedelta(days=50 * 365)
+_ONE_MINUTE = dt.timedelta(minutes=1)
+
+
+class _Spec(NamedTuple):
+    minutes: tuple  # sorted
+    hours: tuple  # sorted
+    days: frozenset  # day-of-month values 1-31
+    last_day: bool  # day-of-month field contains L
+    months: frozenset
+    weekdays: frozenset  # cron numbers 0-6, Sunday is 0
+    nth: tuple  # (weekday, K) pairs from N#K
+    last_weekdays: tuple  # weekday numbers from NL
+
+
+def _number(text, lo, hi):
+    if not _NUMBER.fullmatch(text):
+        raise ValueError(f"not a number: {text!r}")
+    value = int(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"{value} is outside {lo}-{hi}")
+    return value
+
+
+def _value(text, lo, hi, names):
+    """A single number, or a name if the field allows names."""
+    if _NUMBER.fullmatch(text):
+        return _number(text, lo, hi)
+    if names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        return names[text.upper()]
+    raise ValueError(f"bad value: {text!r}")
+
+
+def _expand(item, lo, hi, names):
+    """Values listed by one plain item: *, N, A-B, optionally followed by /S."""
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    else:
+        step = 1
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    elif "-" in base:
+        first, _, last = base.partition("-")
+        start = _value(first, lo, hi, names)
+        end = _value(last, lo, hi, names)
+        if start > end:
+            raise ValueError(f"range start is after its end: {item!r}")
+        values = list(range(start, end + 1))
+    else:
+        start = _value(base, lo, hi, names)
+        values = list(range(start, hi + 1)) if slash else [start]
+    return values[::step]
+
+
+def _parse_field(text, kind):
+    """Return (values, last_day, nth, last_weekdays) for one field."""
+    lo, hi, names = _BOUNDS[kind]
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError(f"'?' is not allowed in the {kind} field")
+        text = "*"
+    values, last_day, nth, last_weekdays = set(), False, [], []
+    for item in text.split(","):
+        if kind == "dom" and item == "L":
+            last_day = True
+        elif kind == "dow" and _LAST_WEEKDAY.fullmatch(item):
+            match = _LAST_WEEKDAY.fullmatch(item)
+            last_weekdays.append(_number(match.group(1), 0, 7) % 7)
+        elif kind == "dow" and _NTH_WEEKDAY.fullmatch(item):
+            match = _NTH_WEEKDAY.fullmatch(item)
+            nth.append((_number(match.group(1), 0, 7) % 7, _number(match.group(2), 1, 5)))
+        else:
+            values.update(_expand(item, lo, hi, names))
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, last_day, nth, last_weekdays
+
+
+def _parse(expr):
+    """Check the whole expression and return its _Spec. Raises ValueError if it is bad."""
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom, month, dow = parts
+    minutes, _, _, _ = _parse_field(minute, "minute")
+    hours, _, _, _ = _parse_field(hour, "hour")
+    days, last_day, _, _ = _parse_field(dom, "dom")
+    months, _, _, _ = _parse_field(month, "month")
+    weekdays, _, nth, last_weekdays = _parse_field(dow, "dow")
+    return _Spec(
+        minutes=tuple(sorted(minutes)),
+        hours=tuple(sorted(hours)),
+        days=frozenset(days),
+        last_day=last_day,
+        months=frozenset(months),
+        weekdays=frozenset(weekdays),
+        nth=tuple(nth),
+        last_weekdays=tuple(last_weekdays),
+    )
+
+
+def _day_ok(spec, day, days_in_month):
+    """True if the date day is allowed by both the day-of-month and day-of-week fields."""
+    if day.day not in spec.days and not (spec.last_day and day.day == days_in_month):
+        return False
+    weekday = (day.weekday() + 1) % 7  # cron numbering: Sunday is 0
+    if weekday in spec.weekdays:
+        return True
+    if any(n == weekday and (day.day - 1) // 7 + 1 == k for n, k in spec.nth):
+        return True
+    return any(n == weekday and day.day + 7 > days_in_month for n in spec.last_weekdays)
+
+
+def _first_time(spec, min_hour, min_minute):
+    """The earliest (hour, minute) in the schedule that is not before (min_hour, min_minute)."""
+    for hour in spec.hours:
+        if hour < min_hour:
+            continue
+        for minute in spec.minutes:
+            if hour == min_hour and minute < min_minute:
+                continue
+            return hour, minute
+    return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    days_in_month = calendar.monthrange(when.year, when.month)[1]
+    return bool(
+        when.minute in spec.minutes
+        and when.hour in spec.hours
+        and when.month in spec.months
+        and _day_ok(spec, when.date(), days_in_month)
+    )
 
 
