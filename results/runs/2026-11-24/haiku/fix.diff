+def _unquoted_equals(field):
+    """Index of the first '=' outside quotes, or None."""
+    quoted = False
+    for i, ch in enumerate(field):
+        if ch == QUOTE:
+            quoted = not quoted
+        elif ch == "=" and not quoted:
+            return i
+    return None
+
+
+def _unquote(raw):
+    """Remove quoting from raw text, keeping whitespace inside quotes only.
+
+    Inside quotes, two QUOTE characters in a row stand for one QUOTE character.
+    Whitespace outside quotes is trimmed from both ends.
+    """
+    chars = []  # (character, was_quoted)
+    quoted = False
+    i = 0
+    while i < len(raw):
+        ch = raw[i]
+        if quoted:
+            if ch == QUOTE:
+                if i + 1 < len(raw) and raw[i + 1] == QUOTE:
+                    chars.append((QUOTE, True))
+                    i += 2
+                    continue
+                quoted = False
+            else:
+                chars.append((ch, True))
+        elif ch == QUOTE:
+            quoted = True
+        else:
+            chars.append((ch, False))
+        i += 1
+    while chars and not chars[0][1] and chars[0][0].isspace():
+        chars.pop(0)
+    while chars and not chars[-1][1] and chars[-1][0].isspace():
+        chars.pop()
+    return "".join(ch for ch, _ in chars)
