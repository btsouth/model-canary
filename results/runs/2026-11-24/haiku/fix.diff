 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DOW_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_NTH_LAST = re.compile(r"([0-9]+)[lL]")
+_NTH_K = re.compile(r"([0-9]+)#([0-9]+)")
+_LOOKAHEAD_DAYS = 50 * 365  # next_run gives up after this many days
+
+
+class _Spec:
+    """A parsed expression. dom/dow are the day rules; hours etc. are sets."""
+
+    def __init__(self, minutes, hours, days_of_month, dom_last, months, weekdays, nths):
+        self.minutes = minutes
+        self.hours = hours
+        self.days_of_month = days_of_month
+        self.dom_last = dom_last
+        self.months = months
+        self.weekdays = weekdays  # cron weekdays, 0 = Sunday .. 6
+        self.nths = nths  # set of (cron weekday, K) with K 1..5 or "L"
+
+    def day_ok(self, day):
+        """True if the calendar date day is allowed by both day fields."""
+        dom_hit = day.day in self.days_of_month or (
+            self.dom_last and day.day == calendar.monthrange(day.year, day.month)[1])
+        if not dom_hit:
+            return False
+        cron_dow = (day.weekday() + 1) % 7
+        if cron_dow in self.weekdays:
+            return True
+        occurrence = (day.day - 1) // 7 + 1
+        last = day.day + 7 > calendar.monthrange(day.year, day.month)[1]
+        return any(wd == cron_dow and (k == occurrence or (k == "L" and last))
+                   for wd, k in self.nths)
+
+
+def _value(token, lo, hi, names):
+    """A single value: digits, or a name when the field allows names."""
+    if _NUM.fullmatch(token):
+        value = int(token)
+    elif names is not None and _NAME.fullmatch(token) and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _field(text, lo, hi, names=None, dom=False, dow=False):
+    """Parse one field into (values, dom_last, nths)."""
+    if text == "?":
+        if not (dom or dow):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(range(lo, hi + 1)), False, set()
+    values, dom_last, nths = set(), False, set()
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {text!r}")
+        body, slash, step_text = item.partition("/")
+        step = None
+        if slash:
+            if not _NUM.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+        if not body:
+            raise ValueError(f"empty item in {text!r}")
+
+        if dom and body in ("L", "l"):
+            if step is not None:
+                raise ValueError(f"L cannot have a step: {item!r}")
+            dom_last = True
+            continue
+        if dow and (m := _NTH_LAST.fullmatch(body)):
+            if step is not None:
+                raise ValueError(f"NL cannot have a step: {item!r}")
+            nths.add((_value(m.group(1), 0, 7, None) % 7, "L"))
+            continue
+        if dow and (m := _NTH_K.fullmatch(body)):
+            if step is not None:
+                raise ValueError(f"N#K cannot have a step: {item!r}")
+            k = int(m.group(2))
+            if not 1 <= k <= 5:
+                raise ValueError(f"bad occurrence: {item!r}")
+            nths.add((_value(m.group(1), 0, 7, None) % 7, k))
+            continue
+
+        if body == "*":
+            first, last = lo, hi
+        else:
+            parts = body.split("-")
+            if len(parts) > 2:
+                raise ValueError(f"bad range: {item!r}")
+            first = _value(parts[0], lo, hi, names)
+            if len(parts) == 2:
+                last = _value(parts[1], lo, hi, names)
+            elif step is not None:
+                last = hi  # N/S lists N up to the field's maximum
+            else:
+                last = first
+            if first > last:
+                raise ValueError(f"range goes backwards: {item!r}")
+        seq = range(first, last + 1)
+        if step is not None:
+            seq = seq[::step]
+        values.update(v % 7 if dow else v for v in seq)
+    return values, dom_last, nths
+
+
+def _parse(expr):
+    """Parse expr into a _Spec, raising ValueError for anything invalid."""
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute, hour, dom, month, dow = fields
+    minutes, _, _ = _field(minute, 0, 59)
+    hours, _, _ = _field(hour, 0, 23)
+    days, dom_last, _ = _field(dom, 1, 31, dom=True)
+    months, _, _ = _field(month, 1, 12, names=_MONTH_NAMES)
+    weekdays, _, nths = _field(dow, 0, 7, names=_DOW_NAMES, dow=True)
+    return _Spec(minutes, hours, days, dom_last, months, weekdays, nths)
+
 
