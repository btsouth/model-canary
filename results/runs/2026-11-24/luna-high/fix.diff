 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from bisect import bisect_left
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ("", "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC")
+) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"))}
+
+
+def _number(token, low, high, names=None):
+    upper = token.upper()
+    if names is not None and upper in names:
+        return names[upper]
+    if not re.fullmatch(r"\d+", token):
+        raise ValueError("invalid field value")
+    value = int(token)
+    if not low <= value <= high:
+        raise ValueError("field value out of range")
+    return value
+
+
+def _field(text, low, high, names=None, day_kind=None):
+    if text == "?":
+        if day_kind not in ("dom", "dow"):
+            raise ValueError("? is only valid in day fields")
+        text = "*"
+    wildcard = text == "*"
+    values = set()
+    lasts = []
+    nths = []
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty list item")
+        if day_kind == "dom" and item.upper() == "L":
+            lasts.append(True)
+            continue
+        if day_kind == "dow":
+            m = re.fullmatch(r"(\d+)L", item, re.IGNORECASE)
+            n = re.fullmatch(r"(\d+)#([1-5])", item, re.IGNORECASE)
+            if m:
+                val = _number(m.group(1), 0, 7)
+                lasts.append(0 if val == 7 else val)
+                continue
+            if n:
+                val = _number(n.group(1), 0, 7)
+                nths.append((0 if val == 7 else val, int(n.group(2))))
+                continue
+        if day_kind in ("dom", "dow") and ("L" in item.upper() or "#" in item):
+            raise ValueError("special day syntax in wrong field")
+        if item.count("/") > 1:
+            raise ValueError("invalid step")
+        if "/" in item:
+            base, step_text = item.split("/")
+            if names is not None and re.search(r"[A-Za-z]", base):
+                raise ValueError("names cannot be used with steps")
+            if not re.fullmatch(r"\d+", step_text) or int(step_text) < 1:
+                raise ValueError("invalid step")
+            step = int(step_text)
+        else:
+            base, step = item, 1
+        if base == "*":
+            seq = list(range(low, high + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("invalid range")
+            a, b = base.split("-")
+            start = _number(a, low, high, names)
+            end = _number(b, low, high, names)
+            if start > end:
+                raise ValueError("descending range")
+            seq = list(range(start, end + 1))
+        else:
+            start = _number(base, low, high, names)
+            if "/" in item:
+                seq = list(range(start, high + 1))
+            else:
+                seq = [start]
+        values.update(seq[::step])
+    return {"values": values, "wildcard": wildcard, "lasts": lasts, "nths": nths}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    source = expr.strip()
+    if source.startswith("@"):
+        try:
+            source = _SHORTCUTS[source.lower()]
+        except KeyError as e:
+            raise ValueError("unknown schedule shortcut") from e
+    parts = re.split(r"[ \t]+", source) if source else []
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    minute = _field(parts[0], 0, 59)
+    hour = _field(parts[1], 0, 23)
+    dom = _field(parts[2], 1, 31, day_kind="dom")
+    month = _field(parts[3], 1, 12, _MONTHS)
+    dow = _field(parts[4], 0, 7, _DAYS, "dow")
+    # Sunday 7 is an accepted alias for Sunday 0.
+    if 7 in dow["values"]:
+        dow["values"].add(0)
+    return minute, hour, dom, month, dow
+
+
+def _day_match(day, dom, dow):
+    dom_ok = dom["wildcard"] or day.day in dom["values"]
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    if day.day == last_day and dom["lasts"]:
+        dom_ok = True
+    cron_dow = (day.weekday() + 1) % 7
+    dow_ok = dow["wildcard"] or cron_dow in dow["values"]
+    if dow["lasts"] and day.day + 7 > last_day and cron_dow in dow["lasts"]:
+        dow_ok = True
+    if any(cron_dow == n and (day.day - 1) // 7 + 1 == k for n, k in dow["nths"]):
+        dow_ok = True
+    return dom_ok and dow_ok
+
 
