 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+_RANGES = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _field(token, index):
+    lo, hi = _RANGES[index]
+    if token == "?":
+        if index not in (2, 4):
+            raise ValueError("? only allowed in day fields")
+        token = "*"
+    result, special = set(), []
+    for item in token.split(","):
+        if not item:
+            raise ValueError("empty field item")
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        if index == 4 and re.fullmatch(r"\d+L", item):
+            n = int(item[:-1]); _check(n, index)
+            special.append(("last_weekday", n % 7))
+            continue
+        if index == 4 and re.fullmatch(r"\d+#\d+", item):
+            n, k = map(int, item.split("#")); _check(n, index)
+            if not 1 <= k <= 5: raise ValueError("bad weekday ordinal")
+            special.append(("nth_weekday", n % 7, k))
+            continue
+        bits = item.split("/")
+        if len(bits) > 2 or (len(bits) == 2 and (not bits[1].isdigit() or int(bits[1]) < 1)):
+            raise ValueError("bad step")
+        base = bits[0]
+        step = int(bits[1]) if len(bits) == 2 else 1
+        if len(bits) == 2 and (index == 3 and any(c.isalpha() for c in base) or index == 4 and any(c.isalpha() for c in base)):
+            raise ValueError("names are not allowed in a step")
+        if base == "*":
+            values = list(range(lo, hi + 1))
+        else:
+            vals = base.split("-")
+            if len(vals) > 2 or any(not x for x in vals): raise ValueError("bad range")
+            a = _value(vals[0], index); b = _value(vals[-1], index)
+            if a > b: raise ValueError("reversed range")
+            values = list(range(a, b + 1))
+            if len(bits) == 2 and len(vals) == 1:
+                values = list(range(a, hi + 1))
+        result.update(values[::step])
+    return result, special
+
+
+def _value(s, index):
+    if s.isdigit(): n = int(s)
+    elif index == 3 and s.upper() in _MONTHS: n = _MONTHS[s.upper()]
+    elif index == 4 and s.upper() in _DAYS: n = _DAYS[s.upper()]
+    else: raise ValueError("bad value")
+    _check(n, index)
+    return n
+
+
+def _check(n, index):
+    lo, hi = _RANGES[index]
+    if not lo <= n <= hi: raise ValueError("value out of range")
+
+
+def _parse(expr):
+    if not isinstance(expr, str): raise ValueError("bad schedule")
+    raw = expr.strip()
+    raw = _SHORTCUTS.get(raw.lower(), raw)
+    parts = re.split(r"[ \t]+", raw) if raw else []
+    if len(parts) != 5: raise ValueError("schedule must have five fields")
+    parsed = [_field(p, i) for i, p in enumerate(parts)]
+    return parsed
+
+
+def _day_match(parsed, day):
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    weekday = (day.weekday() + 1) % 7
+    dom_ok = day.day in dom or any(s[0] == "last" and day.day == calendar.monthrange(day.year, day.month)[1] for s in dom_special)
+    dow_ok = weekday in dow or (weekday == 0 and 7 in dow)
+    for s in dow_special:
+        if s[0] == "last_weekday" and weekday == s[1] and day.day + 7 > calendar.monthrange(day.year, day.month)[1]: dow_ok = True
+        if s[0] == "nth_weekday" and weekday == s[1] and (day.day - 1) // 7 + 1 == s[2]: dow_ok = True
+    return dom_ok and dow_ok
 
 
