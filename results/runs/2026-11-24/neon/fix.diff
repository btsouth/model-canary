 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4,
+    "MAY": 5, "JUN": 6, "JUL": 7, "AUG": 8,
+    "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+
+_DOW_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3,
+    "THU": 4, "FRI": 5, "SAT": 6,
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_DOW_LAST = re.compile(r"([0-9]+)L")
+_DOW_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+def _parse_value(token, lo, hi, names):
+    if not token:
+        raise ValueError("empty value")
+    if _DIGITS.fullmatch(token):
+        val = int(token)
+        if lo <= val <= hi:
+            return val
+        raise ValueError(f"value {val} out of range {lo}-{hi}")
+    if names is not None:
+        upper = token.upper()
+        if upper in names:
+            return names[upper]
+    raise ValueError(f"invalid value: {token!r}")
+
+
+def _parse_standard_item(item, lo, hi, names):
+    if "/" in item:
+        parts = item.split("/")
+        if len(parts) != 2:
+            raise ValueError(f"invalid step syntax: {item!r}")
+        base, step_str = parts
+        if not _DIGITS.fullmatch(step_str):
+            raise ValueError(f"invalid step: {step_str!r}")
+        step = int(step_str)
+        if step < 1:
+            raise ValueError(f"step must be >= 1: {step}")
+        has_step = True
+    else:
+        base = item
+        step = 1
+        has_step = False
+
+    if not base:
+        raise ValueError(f"empty item: {item!r}")
+
+    if base == "*":
+        values = range(lo, hi + 1, step)
+    elif "-" in base:
+        bounds = base.split("-")
+        if len(bounds) != 2:
+            raise ValueError(f"invalid range: {base!r}")
+        start = _parse_value(bounds[0], lo, hi, names)
+        end = _parse_value(bounds[1], lo, hi, names)
+        if start > end:
+            raise ValueError(f"range start > end: {base!r}")
+        values = range(start, end + 1, step)
+    else:
+        val = _parse_value(base, lo, hi, names)
+        if has_step:
+            values = range(val, hi + 1, step)
+        else:
+            values = (val,)
+    return values
+
+
+def _parse_simple_field(field, lo, hi, names=None):
+    if not field:
+        raise ValueError("empty field")
+    result = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        result.update(_parse_standard_item(item, lo, hi, names))
+    return sorted(result)
+
+
+def _parse_dom_field(field):
+    if not field:
+        raise ValueError("empty day-of-month field")
+    if field == "?":
+        return set(range(1, 32)), False
+    fixed = set()
+    has_last = False
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        if item == "L":
+            has_last = True
+        else:
+            fixed.update(_parse_standard_item(item, 1, 31, None))
+    return fixed, has_last
+
+
+def _parse_dow_field(field):
+    if not field:
+        raise ValueError("empty day-of-week field")
+    if field == "?":
+        return set(range(7)), set(), set()
+    fixed = set()
+    lasts = set()
+    nths = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError(f"empty item in {field!r}")
+        m_last = _DOW_LAST.fullmatch(item)
+        if m_last:
+            n = int(m_last.group(1))
+            if not (0 <= n <= 7):
+                raise ValueError(f"day of week out of range: {item!r}")
+            lasts.add(n % 7)
+            continue
+        m_nth = _DOW_NTH.fullmatch(item)
+        if m_nth:
+            n = int(m_nth.group(1))
+            k = int(m_nth.group(2))
+            if not (0 <= n <= 7) or not (1 <= k <= 5):
+                raise ValueError(f"invalid N#K item: {item!r}")
+            nths.add((n % 7, k))
+            continue
+        for val in _parse_standard_item(item, 0, 7, _DOW_NAMES):
+            fixed.add(val % 7)
+    return fixed, lasts, nths
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, dom_fixed, dom_last, months, dow_fixed, dow_last, dow_nth):
+        self.minutes = minutes
+        self.minutes_set = set(minutes)
+        self.hours = hours
+        self.hours_set = set(hours)
+        self.dom_fixed = dom_fixed
+        self.dom_last = dom_last
+        self.months = months
+        self.months_set = set(months)
+        self.dow_fixed = dow_fixed
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+
+    def valid_days(self, year, month):
+        first_weekday, last_day = calendar.monthrange(year, month)
+        first_dow = (first_weekday + 1) % 7  # 0=Sun..6=Sat
+        last_dow = (first_dow + last_day - 1) % 7
+
+        dom_days = {d for d in self.dom_fixed if d <= last_day}
+        if self.dom_last:
+            dom_days.add(last_day)
+        if not dom_days:
+            return []
+
+        dow_days = set()
+        if self.dow_fixed:
+            if len(self.dow_fixed) == 7:
+                dow_days.update(range(1, last_day + 1))
+            else:
+                for n in self.dow_fixed:
+                    first_d = 1 + ((n - first_dow) % 7)
+                    dow_days.update(range(first_d, last_day + 1, 7))
+        for n in self.dow_last:
+            dow_days.add(last_day - ((last_dow - n) % 7))
+        for n, k in self.dow_nth:
+            d = 1 + ((n - first_dow) % 7) + 7 * (k - 1)
+            if d <= last_day:
+                dow_days.add(d)
+
+        return sorted(dom_days & dow_days)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    s = expr.strip()
+    if not s:
+        raise ValueError("empty schedule expression")
+    if s.startswith("@"):
+        expanded = _SHORTCUTS.get(s.lower())
+        if expanded is None:
+            raise ValueError(f"unknown shortcut: {s!r}")
+        s = expanded
+    parts = re.split(r"[ \t]+", s)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}")
+    min_f, hour_f, dom_f, mon_f, dow_f = parts
+    minutes = _parse_simple_field(min_f, 0, 59)
+    hours = _parse_simple_field(hour_f, 0, 23)
+    dom_fixed, dom_last = _parse_dom_field(dom_f)
+    months = _parse_simple_field(mon_f, 1, 12, _MONTH_NAMES)
+    dow_fixed, dow_last, dow_nth = _parse_dow_field(dow_f)
+    return _Schedule(minutes, hours, dom_fixed, dom_last, months, dow_fixed, dow_last, dow_nth)
+
 
