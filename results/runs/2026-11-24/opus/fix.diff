 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i + 1 for i, name in enumerate(
+    ["jan", "feb", "mar", "apr", "may", "jun",
+     "jul", "aug", "sep", "oct", "nov", "dec"])}
+_DAYS = {name: i for i, name in enumerate(
+    ["sun", "mon", "tue", "wed", "thu", "fri", "sat"])}
+
+# (low, high, names) for minute, hour, day of month, month, day of week.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, _MONTHS),
+    (0, 7, _DAYS),
+]
+
+_NUM = re.compile(r"[0-9]+")
+_WORD = re.compile(r"[A-Za-z]{3}")
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+def _value(text, low, high, names, expr):
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and _WORD.fullmatch(text) and text.lower() in names:
+        value = names[text.lower()]
+    else:
+        raise ValueError(f"bad value {text!r} in {expr!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range in {expr!r}")
+    return value
+
+
+def _number(text, low, high, expr):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number {text!r} in {expr!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"number {text!r} out of range in {expr!r}")
+    return value
+
+
+def _parse_field(text, index, expr):
+    """Return (values, last, nth_last, nth) for one field."""
+    low, high, names = _FIELDS[index]
+    values, last, nth_last, nth = set(), False, set(), set()
+    if text == "?":
+        if index not in (2, 4):
+            raise ValueError(f"'?' outside the day fields in {expr!r}")
+        text = "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {expr!r}")
+        if index == 2 and item == "L":
+            last = True
+            continue
+        if index == 4 and item.endswith("L"):
+            nth_last.add(_number(item[:-1], 0, 7, expr) % 7)
+            continue
+        if index == 4 and "#" in item:
+            day, _, k = item.partition("#")
+            nth.add((_number(day, 0, 7, expr) % 7, _number(k, 1, 5, expr)))
+            continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            step = _number(step_text, 1, 10 ** 9, expr)
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            start = _value(a, low, high, names, expr)
+            end = _value(b, low, high, names, expr)
+            if start > end:
+                raise ValueError(f"range {base!r} is backwards in {expr!r}")
+        else:
+            start = _value(base, low, high, names, expr)
+            end = high if slash else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {v % 7 for v in values}
+    return values, last, nth_last, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"bad expression {expr!r}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields in {expr!r}")
+    return [_parse_field(part, i, expr) for i, part in enumerate(parts)]
+
+
+def _allowed_days(fields, year, month):
+    """Sorted list of the allowed days of the given month."""
+    dom_values, dom_last = fields[2][0], fields[2][1]
+    dow_values, _, dow_last, dow_nth = fields[4]
+    first, length = calendar.monthrange(year, month)
+    first = (first + 1) % 7  # cron numbering, Sunday is 0
+    days = []
+    for day in range(1, length + 1):
+        if not (day in dom_values or (dom_last and day == length)):
+            continue
+        dow = (first + day - 1) % 7
+        if (dow in dow_values
+                or (dow in dow_last and day + 7 > length)
+                or (dow, (day - 1) // 7 + 1) in dow_nth):
+            days.append(day)
+    return days
 
 
