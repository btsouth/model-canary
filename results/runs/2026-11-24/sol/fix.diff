 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from bisect import bisect_left
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *',
+    '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *',
+    '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *',
+    '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+_NAMES = {
+    3: {name: i + 1 for i, name in enumerate(
+        ('JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN',
+         'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'))},
+    4: {name: i for i, name in enumerate(
+        ('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))},
+}
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal digits')
+    return int(text)
+
+
+def _value(text, field):
+    value = _NAMES.get(field, {}).get(text)
+    if value is None:
+        value = _number(text)
+    low, high = _LIMITS[field]
+    if not low <= value <= high:
+        raise ValueError('value outside field range')
+    return value
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for field, text in enumerate(fields):
+        values, special = set(), []
+        if text == '?' and field in (2, 4):
+            text = '*'
+        for item in text.split(','):
+            if field == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            last = re.fullmatch(r'([0-9]+)L', item) if field == 4 else None
+            nth = re.fullmatch(r'([0-9]+)#([0-9]+)', item) if field == 4 else None
+            if last or nth:
+                match = last or nth
+                weekday = _value(match[1], field) % 7
+                if last:
+                    special.append(('weekday_last', weekday))
+                else:
+                    count = _number(match[2])
+                    if not 1 <= count <= 5:
+                        raise ValueError('weekday occurrence outside range')
+                    special.append(('weekday_nth', weekday, count))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2:
+                raise ValueError('invalid step')
+            base = pieces[0]
+            step = _number(pieces[1]) if len(pieces) == 2 else 1
+            if step < 1:
+                raise ValueError('step must be positive')
+            if base == '*':
+                start, end = _LIMITS[field]
+            elif '-' in base:
+                bounds = base.split('-')
+                if len(bounds) != 2:
+                    raise ValueError('invalid range')
+                start, end = (_value(v, field) for v in bounds)
+                if start > end:
+                    raise ValueError('descending range')
+            else:
+                start = _value(base, field)
+                end = _LIMITS[field][1] if len(pieces) == 2 else start
+            values.update(range(start, end + 1, step))
+        if field == 4:
+            values = {v % 7 for v in values}
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, year, month, day, last_day):
+    dom, dom_special = parsed[2]
+    if day not in dom and not (dom_special and day == last_day):
+        return False
+    dow, dow_special = parsed[4]
+    weekday = (dt.date(year, month, day).weekday() + 1) % 7
+    if weekday in dow:
+        return True
+    for item in dow_special:
+        if weekday == item[1]:
+            if item[0] == 'weekday_last' and day + 7 > last_day:
+                return True
+            if item[0] == 'weekday_nth' and (day - 1) // 7 + 1 == item[2]:
+                return True
+    return False
+
 
