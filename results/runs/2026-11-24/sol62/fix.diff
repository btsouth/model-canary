 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DECIMAL = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+_SEARCH_LIMIT = timedelta(days=50 * 365)
+
+
+def _bounded_number(token, maximum):
+    if not _DECIMAL.fullmatch(token):
+        raise ValueError(f"bad schedule number: {token!r}")
+    digits = token.lstrip("0")
+    if len(digits) > len(str(maximum)):
+        return maximum + 1
+    return min(int(digits or "0"), maximum + 1)
+
+
+def _value(token, minimum, maximum, names=None):
+    if names and token.isascii():
+        named_value = names.get(token.upper())
+        if named_value is not None:
+            return named_value
+    number = _bounded_number(token, maximum)
+    if not minimum <= number <= maximum:
+        raise ValueError(f"schedule value outside its field's range: {token!r}")
+    return number
+
+
+def _item_values(item, minimum, maximum, names):
+    base, slash, step = item.partition("/")
+    stride = _bounded_number(step, maximum - minimum + 1) if slash else 1
+    if stride == 0:
+        raise ValueError("schedule step must be positive")
+
+    if base == "*":
+        start, end = minimum, maximum
+    else:
+        first, hyphen, last = base.partition("-")
+        start = _value(first, minimum, maximum, names)
+        if hyphen:
+            end = _value(last, minimum, maximum, names)
+        else:
+            end = maximum if slash else start
+    if start > end:
+        raise ValueError(f"descending schedule range: {base!r}")
+    return range(start, end + 1, stride)
+
+
+def _field_values(field, minimum, maximum, names=None):
+    return {
+        value
+        for item in field.split(",")
+        for value in _item_values(item, minimum, maximum, names)
+    }
+
+
+def _month_days(field):
+    days = set()
+    last_day = False
+    for item in ("*" if field == "?" else field).split(","):
+        if item == "L":
+            last_day = True
+        else:
+            days.update(_item_values(item, 1, 31, None))
+    return days, last_day
+
+
+def _week_days(field):
+    weekdays, last_weekdays, nth_weekdays = set(), set(), set()
+    for item in ("*" if field == "?" else field).split(","):
+        last = _LAST_WEEKDAY.fullmatch(item)
+        nth = _NTH_WEEKDAY.fullmatch(item)
+        if last:
+            last_weekdays.add(_value(last[1], 0, 7) % 7)
+        elif nth:
+            weekday = _value(nth[1], 0, 7) % 7
+            nth_weekdays.add((weekday, _value(nth[2], 1, 5)))
+        else:
+            weekdays.update(value % 7 for value in _item_values(item, 0, 7, _WEEKDAYS))
+    return weekdays, last_weekdays, nth_weekdays
+
+
+@dataclass
+class _Schedule:
+    minutes: set
+    hours: set
+    months: set
+    days: set
+    last_day: bool
+    weekdays: set
+    last_weekdays: set
+    nth_weekdays: set
+
+    def allows_day(self, day, weekday, month_length):
+        if day not in self.days and not (self.last_day and day == month_length):
+            return False
+        return (
+            weekday in self.weekdays
+            or (weekday in self.last_weekdays and day + 7 > month_length)
+            or (weekday, (day - 1) // 7 + 1) in self.nth_weekdays
+        )
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be a string")
+    expr = expr.strip()
+    if expr.isascii():
+        expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule expression must contain five fields")
+    minute, hour, day, month, weekday = fields
+    days, last_day = _month_days(day)
+    weekdays, last_weekdays, nth_weekdays = _week_days(weekday)
+    return _Schedule(
+        _field_values(minute, 0, 59),
+        _field_values(hour, 0, 23),
+        _field_values(month, 1, 12, _MONTHS),
+        days, last_day, weekdays, last_weekdays, nth_weekdays,
+    )
+
 
