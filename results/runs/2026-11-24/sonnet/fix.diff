 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUM = re.compile(r"[0-9]+", re.ASCII)
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names.index(tok.upper()) + (1 if names is _MONTHS else 0)
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _simple_field(text, lo, hi, names=None):
+    """Return the set of values of an ordinary list field."""
+    out = set()
+    for item in text.split(","):
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.fullmatch(step) or int(step) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step)
+        else:
+            step = None
+        if base == "*":
+            a, b = lo, hi
+        elif "-" in base:
+            x, _, y = base.partition("-")
+            a, b = _value(x, lo, hi, names), _value(y, lo, hi, names)
+            if a > b:
+                raise ValueError(f"descending range {item!r}")
+        else:
+            a = _value(base, lo, hi, names)
+            b = hi if step else a
+        out.update(range(a, b + 1, step or 1))
+    return out
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        if expr.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        expr = _SHORTCUTS[expr.lower()]
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    minute = _simple_field(parts[0], 0, 59)
+    hour = _simple_field(parts[1], 0, 23)
+    month = _simple_field(parts[3], 1, 12, _MONTHS)
+
+    dom_text, dow_text = parts[2], parts[4]
+    dom, dom_last = set(), False
+    if dom_text == "?":
+        dom = set(range(1, 32))
+    else:
+        rest = []
+        for item in dom_text.split(","):
+            if item == "L":
+                dom_last = True
+            else:
+                rest.append(item)
+        if rest:
+            dom = _simple_field(",".join(rest), 1, 31)
+        elif not dom_last:
+            raise ValueError("empty day of month")
+    if dom_text != "?" and dom_text.split(",") == [] :
+        raise ValueError("empty")
+
+    dow, dow_last, dow_nth = set(), set(), set()
+    if dow_text == "?":
+        dow = set(range(7))
+    else:
+        rest = []
+        for item in dow_text.split(","):
+            m = re.fullmatch(r"([0-9]+)L", item, re.ASCII)
+            k = re.fullmatch(r"([0-9]+)#([0-9]+)", item, re.ASCII)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError(f"bad day {item!r}")
+                dow_last.add(n % 7)
+            elif k:
+                n, c = int(k.group(1)), int(k.group(2))
+                if n > 7 or not 1 <= c <= 5:
+                    raise ValueError(f"bad item {item!r}")
+                dow_nth.add((n % 7, c))
+            else:
+                rest.append(item)
+        if rest:
+            dow = {d % 7 for d in _simple_field(",".join(rest), 0, 7, _DAYS)}
+    return minute, hour, month, (dom, dom_last), (dow, dow_last, dow_nth)
+
+
+def _day_ok(d, dompart, dowpart):
+    dom, dom_last = dompart
+    dow, dow_last, dow_nth = dowpart
+    last = calendar.monthrange(d.year, d.month)[1]
+    if not (d.day in dom or (dom_last and d.day == last)):
+        return False
+    wd = (d.weekday() + 1) % 7
+    return (wd in dow
+            or (wd in dow_last and d.day + 7 > last)
+            or (wd, (d.day - 1) // 7 + 1) in dow_nth)
 
 
