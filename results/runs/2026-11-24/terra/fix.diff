 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {'SUN': 0, 'MON': 1, 'TUE': 2, 'WED': 3, 'THU': 4, 'FRI': 5, 'SAT': 6}
+_LIMITS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        lo, hi = _LIMITS[index]
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if token.upper() in names:
+                value = names[token.upper()]
+            elif re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            else:
+                raise ValueError('invalid value')
+            if not lo <= value <= hi:
+                raise ValueError('value out of range')
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])L', item) if index == 4 else None
+            if match:
+                special.append(('weekday_last', int(match[1]) % 7))
+                continue
+            match = re.fullmatch(r'([0-7])#([1-5])', item) if index == 4 else None
+            if match:
+                special.append(('weekday_nth', int(match[1]) % 7, int(match[2])))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                start, end = lo, hi
+            elif '-' in base:
+                endpoints = base.split('-')
+                if len(endpoints) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, endpoints)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = hi if len(pieces) == 2 else start
+            values.update(range(start, end + 1, step))
+        if index == 4 and 7 in values:
+            values.add(0)
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    return (date.day in dom or bool(dom_special) and date.day == last) and (
+        weekday in dow or any(s[1] == weekday and
+            (date.day + 7 > last if s[0] == 'weekday_last' else (date.day - 1) // 7 + 1 == s[2])
+            for s in dow_special))
+
 
