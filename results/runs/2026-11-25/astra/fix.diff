 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid number: {text!r}")
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, specials = set(), []
+    unrestricted = text in ("*", "?")
+    if text == "?" and index in (2, 4):
+        text = "*"
+
+    def value(token):
+        number = names[token.upper()] if token.upper() in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return number
+
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if index == 4:
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if special:
+                weekday = value(special[1]) % 7
+                if special[2] == "L":
+                    specials.append(("last", weekday))
+                else:
+                    nth = _number(special[3])
+                    if not 1 <= nth <= 5:
+                        raise ValueError("weekday occurrence must be 1 to 5")
+                    specials.append(("nth", weekday, nth))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = parts[0]
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(value, ends)
+        else:
+            start = value(base)
+            end = high if len(parts) == 2 else start
+        if start > end:
+            raise ValueError("range runs backwards")
+        values.update(n % 7 if index == 4 else n for n in range(start, end + 1, step))
+    return values, specials, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    return [_field(text, index) for index, text in enumerate(fields)]
+
+
+def _day_matches(fields, year, month, day, last_day):
+    dom, dom_specials, dom_free = fields[2]
+    dow, dow_specials, dow_free = fields[4]
+    weekday = (datetime(year, month, day).weekday() + 1) % 7
+    month_match = day in dom or bool(dom_specials) and day == last_day
+    week_match = weekday in dow or any(
+        weekday == special[1] and (
+            day + 7 > last_day if special[0] == "last"
+            else (day - 1) // 7 + 1 == special[2])
+        for special in dow_specials)
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return week_match
+    if dow_free:
+        return month_match
+    return month_match or week_match
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    fields = _parse(expr)
