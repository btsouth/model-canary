 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+
+_HORIZON = timedelta(days=50 * 365)
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+
+
+def _number(token, maximum):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"invalid number: {token!r}")
+    digits = token.lstrip("0")
+    # All field bounds fit in two digits. Larger steps select only the first value.
+    if len(digits) > 2:
+        return maximum + 1
+    return int(digits or "0")
+
+
+def _value(token, low, high, names):
+    value = names.get(token.upper()) if names and token.isascii() else None
+    if value is None:
+        value = _number(token, high)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _values(items, low, high, names=None):
+    values = set()
+    for item in items:
+        span, slash, stride = item.partition("/")
+        step = _number(stride, high) if slash else 1
+        if step == 0:
+            raise ValueError("step must be positive")
+        if span == "*":
+            start, end = low, high
+        else:
+            first, dash, last = span.partition("-")
+            start = _value(first, low, high, names)
+            end = high if slash else start
+            if dash:
+                end = _value(last, low, high, names)
+            if end < start:
+                raise ValueError(f"backwards range: {span!r}")
+        values.update(range(start, end + 1, step))
+    return sorted(values)
+
+
+@dataclass
+class _Schedule:
+    minutes: list
+    hours: list
+    months: list
+    month_days: set
+    last_day: bool
+    weekdays: set
+    last_weekdays: set
+    nth_weekdays: set
+    dom_restricted: bool
+    dow_restricted: bool
+
+    def allows_day(self, day, weekday, month_length):
+        dom = day in self.month_days or (self.last_day and day == month_length)
+        dow = (weekday in self.weekdays
+               or (weekday in self.last_weekdays and day + 7 > month_length)
+               or (weekday, (day - 1) // 7 + 1) in self.nth_weekdays)
+        if self.dom_restricted and self.dow_restricted:
+            return dom or dow
+        return dom and dow
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    minute, hour, dom, month, dow = re.split(r"[ \t]+", expr)
+    dom_items = ("*" if dom == "?" else dom).split(",")
+    dow_items = ("*" if dow == "?" else dow).split(",")
+    regular = []
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in dow_items:
+        special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+        if special:
+            weekday = _value(special[1], 0, 7, None) % 7
+            if special[2] == "L":
+                last_weekdays.add(weekday)
+            else:
+                nth_weekdays.add((weekday, _value(special[3], 1, 5, None)))
+        else:
+            regular.append(item)
+    return _Schedule(
+        minutes=_values(minute.split(","), 0, 59),
+        hours=_values(hour.split(","), 0, 23),
+        months=_values(month.split(","), 1, 12, _MONTHS),
+        month_days=set(_values([item for item in dom_items if item != "L"], 1, 31)),
+        last_day="L" in dom_items,
+        weekdays={n % 7 for n in _values(regular, 0, 7, _WEEKDAYS)},
+        last_weekdays=last_weekdays,
+        nth_weekdays=nth_weekdays,
+        dom_restricted=dom not in ("?", "*"),
+        dow_restricted=dow not in ("?", "*"),
+    )
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
