 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import date, datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: index + 1
+    for index, name in enumerate(
+        ("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC")
+    )
+}
+_DOW_NAMES = {
+    name: index
+    for index, name in enumerate(
+        ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT")
+    )
+}
+
+_BOUNDS = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+
+
+class _Field:
+    __slots__ = ("values", "restricted", "last_day", "last_weekdays",
+                 "nth_weekdays")
+
+    def __init__(self, values, restricted, last_day=False,
+                 last_weekdays=(), nth_weekdays=()):
+        self.values = set(values)
+        self.restricted = restricted
+        self.last_day = last_day
+        self.last_weekdays = set(last_weekdays)
+        self.nth_weekdays = set(nth_weekdays)
+
+
+def _number(text, low, high):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"bad number: {text!r}")
+    value = int(text)
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _value(text, kind):
+    low, high = _BOUNDS[kind]
+    if kind in ("month", "dow") and _NAME.fullmatch(text):
+        names = _MONTH_NAMES if kind == "month" else _DOW_NAMES
+        upper = text.upper()
+        if upper in names:
+            return names[upper]
+        raise ValueError(f"bad name: {text!r}")
+    return _number(text, low, high)
+
+
+def _parse_field(raw, kind):
+    low, high = _BOUNDS[kind]
+    if raw == "?":
+        if kind not in ("dom", "dow"):
+            raise ValueError("'?' is only allowed in the day fields")
+        raw = "*"
+
+    restricted = raw not in ("*", "?")
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+
+    items = raw.split(",")
+    if any(item == "" for item in items):
+        raise ValueError("empty item")
+
+    for item in items:
+        if "/" in item:
+            if item.count("/") != 1:
+                raise ValueError(f"bad step: {item!r}")
+            base, step_text = item.split("/")
+            if not _DIGITS.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+            if kind in ("month", "dow") and re.search(r"[A-Za-z]", base):
+                raise ValueError(f"a name cannot be used in a step: {item!r}")
+        else:
+            base = item
+            step = None
+
+        if not base:
+            raise ValueError("empty item")
+
+        if kind == "dom" and base == "L":
+            if step is not None:
+                raise ValueError(f"L cannot have a step: {item!r}")
+            last_day = True
+            continue
+
+        if kind == "dow":
+            last_match = re.fullmatch(r"([0-9]+)L", base)
+            if last_match:
+                if step is not None:
+                    raise ValueError(f"NL cannot have a step: {item!r}")
+                last_weekdays.add(_number(last_match.group(1), 0, 7))
+                continue
+            if "#" in base:
+                if base.count("#") != 1:
+                    raise ValueError(f"bad N#K item: {item!r}")
+                if step is not None:
+                    raise ValueError(f"N#K cannot have a step: {item!r}")
+                n_text, k_text = base.split("#")
+                nth_weekdays.add(
+                    (_number(n_text, 0, 7), _number(k_text, 1, 5))
+                )
+                continue
+
+        if base == "*":
+            listed = list(range(low, high + 1))
+            if step is not None:
+                listed = listed[::step]
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError(f"bad range: {item!r}")
+            start_text, end_text = base.split("-")
+            start = _value(start_text, kind)
+            end = _value(end_text, kind)
+            if start > end:
+                raise ValueError(f"bad range: {item!r}")
+            listed = list(range(start, end + 1))
+            if step is not None:
+                listed = listed[::step]
+        else:
+            start = _value(base, kind)
+            if step is not None:
+                listed = list(range(start, high + 1, step))
+            else:
+                listed = [start]
+
+        values.update(listed)
+
+    if kind == "dow":
+        values = {0 if value == 7 else value for value in values}
+        last_weekdays = {
+            0 if value == 7 else value for value in last_weekdays
+        }
+        nth_weekdays = {
+            (0 if value == 7 else value, n)
+            for value, n in nth_weekdays
+        }
+
+    return _Field(values, restricted, last_day, last_weekdays, nth_weekdays)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "minute_set", "hours", "hour_set", "months",
+                 "dom", "dow")
+
+    def __init__(self, minute, hour, dom, month, dow):
+        self.minutes = sorted(minute.values)
+        self.minute_set = set(minute.values)
+        self.hours = sorted(hour.values)
+        self.hour_set = set(hour.values)
+        self.months = set(month.values)
+        self.dom = dom
+        self.dow = dow
+
+    def _dom_matches(self, day):
+        if day.day in self.dom.values:
+            return True
+        return (
+            self.dom.last_day
+            and day.day == _days_in_month(day.year, day.month)
+        )
+
+    def _dow_matches(self, day):
+        weekday = (day.weekday() + 1) % 7
+        if weekday in self.dow.values:
+            return True
+        last = _days_in_month(day.year, day.month)
+        if weekday in self.dow.last_weekdays and day.day + 7 > last:
+            return True
+        for n, k in self.dow.nth_weekdays:
+            if weekday == n and (day.day - 1) // 7 + 1 == k:
+                return True
+        return False
+
+    def _day_allowed(self, day):
+        dom_restricted = self.dom.restricted
+        dow_restricted = self.dow.restricted
+        if not dom_restricted and not dow_restricted:
+            return True
+        if dom_restricted and dow_restricted:
+            return self._dom_matches(day) or self._dow_matches(day)
+        if dom_restricted:
+            return self._dom_matches(day)
+        return self._dow_matches(day)
+
+    def matches(self, when):
+        if when.minute not in self.minute_set:
+            return False
+        if when.hour not in self.hour_set:
+            return False
+        if when.month not in self.months:
+            return False
+        return self._day_allowed(when.date())
+
+    def earliest_time(self, base_hour, base_minute):
+        for hour in self.hours:
+            if hour < base_hour:
+                continue
+            if hour == base_hour:
+                index = bisect_left(self.minutes, base_minute)
+                if index < len(self.minutes):
+                    return hour, self.minutes[index]
+            else:
+                return hour, self.minutes[0]
+        return None, None
+
+
+def _days_in_month(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _parse_expression(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+
+    text = expr.strip()
+    shortcut = _SHORTCUTS.get(text.lower())
+    if shortcut is not None:
+        text = shortcut
+
+    if not text:
+        raise ValueError("empty schedule expression")
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"a schedule needs five fields: {expr!r}")
+
+    minute = _parse_field(fields[0], "minute")
+    hour = _parse_field(fields[1], "hour")
+    dom = _parse_field(fields[2], "dom")
+    month = _parse_field(fields[3], "month")
+    dow = _parse_field(fields[4], "dow")
+    return _Schedule(minute, hour, dom, month, dow)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
