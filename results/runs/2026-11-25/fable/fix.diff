+def _tokenize(text):
+    """Split text into fields, each a list of (text, quoted) pieces.
+
+    Only the unquoted pieces may be split on SEP; the quoted pieces are already
+    unescaped (QUOTE QUOTE -> QUOTE).
+    """
+    fields, field, piece = [], [], ""
+    i, n = 0, len(text)
+    while i < n:
+        ch = text[i]
+        if ch == QUOTE:
+            if piece:
+                field.append((piece, False))
+                piece = ""
+            i += 1
+            quoted = ""
+            while True:
+                if i >= n:
+                    raise ValueError(f"unclosed quote in {text!r}")
+                if text[i] == QUOTE:
+                    if i + 1 < n and text[i + 1] == QUOTE:
+                        quoted += QUOTE
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                quoted += text[i]
+                i += 1
+            field.append((quoted, True))
+        elif ch == SEP:
+            if piece:
+                field.append((piece, False))
+                piece = ""
+            fields.append(field)
+            field = []
+            i += 1
+        else:
+            piece += ch
+            i += 1
+    if piece:
+        field.append((piece, False))
+    fields.append(field)
+    return fields
+
+
+def _join(pieces):
+    """Join pieces, dropping whitespace outside quotes at either end."""
+    pieces = list(pieces)
+    if pieces and not pieces[0][1]:
+        pieces[0] = (pieces[0][0].lstrip(), False)
+    if pieces and not pieces[-1][1]:
+        pieces[-1] = (pieces[-1][0].rstrip(), False)
+    return "".join(p for p, _ in pieces)
+
+
