 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+_MONTH_NAMES = {name: i + 1 for i, name in enumerate(_MONTHS)}
+_DAY_NAMES = {name: i for i, name in enumerate(_DAYS)}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+def _number(text, lo, hi, names, what):
+    if text.isdigit() and text.isascii():
+        value = int(text)
+    elif names and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r} in {what} field")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {text!r} out of range in {what} field")
+    return value
+
+
+def _step(text, what):
+    if not (text.isdigit() and text.isascii()) or int(text) < 1:
+        raise ValueError(f"bad step {text!r} in {what} field")
+    return int(text)
+
+
+def _parse_field(text, lo, hi, names, what):
+    """Parse a plain numeric field into a sorted list of values."""
+    values = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {what} field")
+        base, _, step = item.partition("/")
+        step = _step(step, what) if _ else 1
+        if base == "*":
+            listed = range(lo, hi + 1)
+        elif "-" in base:
+            a, b = base.split("-", 1)
+            a, b = _number(a, lo, hi, names, what), _number(b, lo, hi, names, what)
+            if a > b:
+                raise ValueError(f"range {base!r} runs backwards in {what} field")
+            listed = range(a, b + 1)
+        else:
+            n = _number(base, lo, hi, names, what)
+            listed = range(n, hi + 1) if _ else range(n, n + 1)
+        values.update(listed[::step])
+    return sorted(values)
+
+
+def _parse_dom(text):
+    """Returns (restricted, days, last)."""
+    if text in ("*", "?"):
+        return False, list(range(1, 32)), False
+    last = False
+    items = [item for item in text.split(",") if item != "L"]
+    if len(items) != text.count(",") + 1:
+        last = True
+    days = _parse_field(",".join(items), 1, 31, None, "day of month") if items else []
+    return True, days, last
+
+
+def _parse_dow(text):
+    """Returns (restricted, weekdays, lasts, nths)."""
+    if text in ("*", "?"):
+        return False, list(range(7)), set(), set()
+    plain, lasts, nths = [], set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item in day of week field")
+        if item.endswith("L") and item[:-1].isdigit() and item[:-1].isascii():
+            lasts.add(_number(item[:-1], 0, 7, None, "day of week") % 7)
+        elif "#" in item:
+            n, k = item.split("#", 1)
+            n = _number(n, 0, 7, None, "day of week") % 7
+            if not (k.isdigit() and k.isascii() and 1 <= int(k) <= 5):
+                raise ValueError(f"bad occurrence {k!r} in day of week field")
+            nths.add((n, int(k)))
+        else:
+            plain.append(item)
+    weekdays = _parse_field(",".join(plain), 0, 7, _DAY_NAMES, "day of week") if plain else []
+    weekdays = sorted({d % 7 for d in weekdays})
+    return True, weekdays, lasts, nths
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("expression must be a string")
+        text = expr.strip()
+        if text.lower() in _SHORTCUTS:
+            text = _SHORTCUTS[text.lower()]
+        elif text.startswith("@"):
+            raise ValueError(f"unknown shortcut {text!r}")
+        parts = text.split()
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields, got {len(parts)}")
+        minute, hour, dom, month, dow = parts
+        self.minutes = _parse_field(minute, 0, 59, None, "minute")
+        self.hours = _parse_field(hour, 0, 23, None, "hour")
+        self.dom_restricted, self.doms, self.dom_last = _parse_dom(dom)
+        self.months = _parse_field(month, 1, 12, _MONTH_NAMES, "month")
+        self.dow_restricted, self.dows, self.dow_lasts, self.dow_nths = _parse_dow(dow)
+        self.month_set = set(self.months)
+
+    def day_ok(self, date):
+        dom_ok = dow_ok = None
+        if self.dom_restricted:
+            days_in_month = calendar.monthrange(date.year, date.month)[1]
+            dom_ok = date.day in self.doms or (self.dom_last and date.day == days_in_month)
+        if self.dow_restricted:
+            wd = (date.weekday() + 1) % 7
+            days_in_month = calendar.monthrange(date.year, date.month)[1]
+            dow_ok = (
+                wd in self.dows
+                or (wd in self.dow_lasts and date.day + 7 > days_in_month)
+                or (wd, (date.day - 1) // 7 + 1) in self.dow_nths
+            )
+        if dom_ok is None and dow_ok is None:
+            return True
+        if dom_ok is None:
+            return dow_ok
+        if dow_ok is None:
+            return dom_ok
+        return dom_ok or dow_ok
+
+    def matches(self, when):
+        return (
+            when.minute in self.minutes
+            and when.hour in self.hours
+            and when.month in self.month_set
+            and self.day_ok(when.date())
+        )
+
+    def next_run(self, after):
+        start = after.replace(second=0, microsecond=0) + datetime.timedelta(minutes=1)
+        limit = after + _LIMIT
+        day = start.date()
+        first = True
+        while True:
+            if day.month not in self.month_set:
+                year, month = day.year, day.month + 1
+                if month > 12:
+                    year, month = year + 1, 1
+                day = datetime.date(year, month, 1)
+                first = False
+                if datetime.datetime.combine(day, datetime.time()) > limit:
+                    return None
+                continue
+            if datetime.datetime.combine(day, datetime.time()) > limit:
+                return None
+            if self.day_ok(day):
+                for h in self.hours:
+                    if first and h < start.hour:
+                        continue
+                    for m in self.minutes:
+                        candidate = datetime.datetime.combine(day, datetime.time(h, m))
+                        if candidate < start:
+                            continue
+                        if candidate > limit:
+                            return None
+                        return candidate
+            first = False
+            day += datetime.timedelta(days=1)
+
 
