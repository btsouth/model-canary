 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+def _value(text, low, high, names):
+    if _NUMBER.fullmatch(text):
+        number = int(text)
+    elif names and _NAME.fullmatch(text) and text.upper() in names:
+        number = names[text.upper()]
+    else:
+        raise ValueError(f"bad value: {text!r}")
+    if not low <= number <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return number
+
+
+def _item(item, low, high, names):
+    """The values one ordinary item (no L or #) lists."""
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+    if base == "*":
+        first, last = low, high
+    elif "-" in base:
+        left, _, right = base.partition("-")
+        first = _value(left, low, high, names)
+        last = _value(right, low, high, names)
+        if first > last:
+            raise ValueError(f"backwards range: {item!r}")
+    else:
+        first = _value(base, low, high, names)
+        last = high if slash else first
+    return range(first, last + 1, step)
+
+
+def _field(text, low, high, names=None, kind=None):
+    """Parse one field into (values, extras); extras are the L and # items."""
+    values, extras = set(), []
+    if text == "?":
+        if kind is None:
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    for item in text.split(","):
+        if kind == "dom" and item == "L":
+            extras.append("L")
+            continue
+        if kind == "dow":
+            found = _LAST_DOW.fullmatch(item)
+            if found:
+                extras.append(("L", _value(found.group(1), 0, 7, None) % 7))
+                continue
+            found = _NTH_DOW.fullmatch(item)
+            if found:
+                nth = int(found.group(2))
+                if not 1 <= nth <= 5:
+                    raise ValueError(f"bad occurrence: {item!r}")
+                extras.append(("#", _value(found.group(1), 0, 7, None) % 7, nth))
+                continue
+        values.update(_item(item, low, high, names))
+    if kind == "dow":
+        values = {v % 7 for v in values}
+    return values, extras
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        expr = expr.strip()
+        if expr.startswith("@"):
+            if expr.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            expr = _SHORTCUTS[expr.lower()]
+        parts = re.split(r"[ \t]+", expr)
+        if len(parts) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        self.minutes = sorted(_field(parts[0], 0, 59)[0])
+        self.hours = sorted(_field(parts[1], 0, 23)[0])
+        self.dom, self.dom_extras = _field(parts[2], 1, 31, kind="dom")
+        self.months = _field(parts[3], 1, 12, _MONTHS)[0]
+        self.dow, self.dow_extras = _field(parts[4], 0, 7, _DAYS, kind="dow")
+        self.dom_restricted = parts[2] not in ("*", "?")
+        self.dow_restricted = parts[4] not in ("*", "?")
+
+    def _dom_ok(self, date):
+        if date.day in self.dom:
+            return True
+        return bool(self.dom_extras) and \
+            date.day == calendar.monthrange(date.year, date.month)[1]
+
+    def _dow_ok(self, date):
+        weekday = (date.weekday() + 1) % 7
+        if weekday in self.dow:
+            return True
+        for extra in self.dow_extras:
+            if extra[1] != weekday:
+                continue
+            if extra[0] == "L":
+                if date.day + 7 > calendar.monthrange(date.year, date.month)[1]:
+                    return True
+            elif (date.day - 1) // 7 + 1 == extra[2]:
+                return True
+        return False
+
+    def day_ok(self, date):
+        if date.month not in self.months:
+            return False
+        if self.dom_restricted and self.dow_restricted:
+            return self._dom_ok(date) or self._dow_ok(date)
+        if self.dom_restricted:
+            return self._dom_ok(date)
+        if self.dow_restricted:
+            return self._dow_ok(date)
+        return True
+
+    def first_time(self, hour=0, minute=0):
+        """The first (hour, minute) run at or after the given time of day."""
+        for h in self.hours:
+            if h < hour:
+                continue
+            for m in self.minutes:
+                if h > hour or m >= minute:
+                    return h, m
+        return None
 
 
