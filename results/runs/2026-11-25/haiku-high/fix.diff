 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from calendar import monthrange
+from collections import namedtuple
+from datetime import datetime, time, timedelta
+
+MINUTE, HOUR, DOM, MONTH, DOW = range(5)
+_FIELD_NAMES = ("minute", "hour", "day of month", "month", "day of week")
+_MONTH_NAMES = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_WEEKDAY_NAMES = {name: i for i, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+# (lowest, highest, names) for each field, indexed by the constants above.
+_RANGES = {
+    MINUTE: (0, 59, {}),
+    HOUR: (0, 23, {}),
+    DOM: (1, 31, {}),
+    MONTH: (1, 12, _MONTH_NAMES),
+    DOW: (0, 7, _WEEKDAY_NAMES),
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+_SEPARATOR = re.compile(r"[ \t]+")
+_SPAN = timedelta(days=50 * 365)
+_ONE_DAY = timedelta(days=1)
+
+# values: set of ints; last: 'L' allowed; lastwd: 'NL' weekdays; nth: 'N#K' pairs;
+# restricted: False only when the field is exactly '*' or '?'.
+_Field = namedtuple("_Field", "values last lastwd nth restricted")
+_Schedule = namedtuple("_Schedule", "minutes hours months dom dow pairs")
+
+
+def _value(text, lo, hi, names):
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"value {text!r} is outside {lo}-{hi}")
+    return value
+
+
+def _step(text):
+    if not _NUMBER.fullmatch(text) or int(text) < 1:
+        raise ValueError(f"bad step {text!r}")
+    return int(text)
+
+
+def _parse_item(item, field):
+    """Return (kind, payload) for one comma-separated item of a field."""
+    lo, hi, names = _RANGES[field]
+    if field == DOM and item == "L":
+        return "last", None
+    if field == DOW:
+        match = _LAST_WEEKDAY.fullmatch(item)
+        if match:
+            return "lastwd", _value(match.group(1), 0, 7, {})
+        match = _NTH_WEEKDAY.fullmatch(item)
+        if match:
+            return "nth", (_value(match.group(1), 0, 7, {}), _value(match.group(2), 1, 5, {}))
+    base, slash, step_text = item.partition("/")
+    if base == "*":
+        first, last = lo, hi
+    elif "-" in base:
+        low, _, high = base.partition("-")
+        first = _value(low, lo, hi, names)
+        last = _value(high, lo, hi, names)
+        if first > last:
+            raise ValueError(f"range {base!r} runs backwards")
+    else:
+        first = _value(base, lo, hi, names)
+        last = hi if slash else first
+    step = _step(step_text) if slash else 1
+    return "values", list(range(first, last + 1, step))
+
+
+def _field(text, field):
+    if text == "?":
+        if field not in (DOM, DOW):
+            raise ValueError(f"'?' is not allowed in the {_FIELD_NAMES[field]} field")
+        text = "*"
+    values, last, lastwd, nth = set(), False, set(), set()
+    for item in text.split(","):
+        kind, payload = _parse_item(item, field)
+        if kind == "last":
+            last = True
+        elif kind == "lastwd":
+            lastwd.add(payload % 7)
+        elif kind == "nth":
+            nth.add((payload[0] % 7, payload[1]))
+        else:
+            values.update(v % 7 if field == DOW else v for v in payload)
+    return _Field(values, last, lastwd, nth, text != "*")
+
+
+def _parse(expr):
+    """Validate the whole expression and return it as a _Schedule."""
+    if not isinstance(expr, str):
+        raise ValueError(f"schedule must be a string, not {type(expr).__name__}")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    fields = _SEPARATOR.split(text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields)}: {expr!r}")
+    parsed = [_field(f, i) for i, f in enumerate(fields)]
+    minutes = frozenset(parsed[MINUTE].values)
+    hours = frozenset(parsed[HOUR].values)
+    pairs = sorted((h, m) for h in hours for m in minutes)
+    return _Schedule(minutes, hours, frozenset(parsed[MONTH].values),
+                     parsed[DOM], parsed[DOW], pairs)
+
+
+def _day_matches(s, day):
+    """Classic cron day rule: both restricted means either matches."""
+    last = monthrange(day.year, day.month)[1]
+    dom, dow = s.dom, s.dow
+    dom_hit = day.day in dom.values or (dom.last and day.day == last)
+    weekday = (day.weekday() + 1) % 7  # cron numbering: Sunday is 0
+    dow_hit = (weekday in dow.values
+               or (weekday in dow.lastwd and day.day + 7 > last)
+               or (weekday, (day.day - 1) // 7 + 1) in dow.nth)
+    if dom.restricted and dow.restricted:
+        return bool(dom_hit or dow_hit)
+    if dom.restricted:
+        return bool(dom_hit)
+    if dow.restricted:
+        return bool(dow_hit)
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _parse(expr)
+    return (when.minute in s.minutes and when.hour in s.hours
+            and when.month in s.months and _day_matches(s, when.date()))
 
 
