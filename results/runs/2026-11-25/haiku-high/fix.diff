     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    s = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _SPAN
+    except OverflowError:
+        limit = datetime.max
+    day = start.date()
+    try:
+        while day <= limit.date():
+            if day.month not in s.months:
+                day = (day.replace(day=1) + timedelta(days=32)).replace(day=1)
+                continue
+            if _day_matches(s, day):
+                for hour, minute in s.pairs:
+                    candidate = datetime.combine(day, time(hour, minute))
+                    if candidate >= start:
+                        return candidate if candidate <= limit else None
+            day += _ONE_DAY
+    except OverflowError:
+        pass  # ran off the end of the representable calendar
+    return None
