+import math
 from fractions import Fraction
 
 
@@ -16,8 +17,18 @@ def apportion(total, weights):
     """
     if not weights or any(w < 0 for w in weights) or sum(weights) == 0:
         raise ValueError("weights must be non-negative and not all zero")
-    whole = sum(weights)
-    return [round(total * w / whole) for w in weights]
+    ws = [Fraction(w) for w in weights]
+    whole = sum(ws)
+    sign = -1 if total < 0 else 1
+    amount = abs(total)
+    exact = [amount * w / whole for w in ws]
+    shares = [math.floor(e) for e in exact]
+    left = amount - sum(shares)
+    remainders = [e - s for e, s in zip(exact, shares)]
+    order = sorted(range(len(ws)), key=lambda i: (remainders[i], i), reverse=True)
+    for i in order[:left]:
+        shares[i] += 1
+    return [sign * s for s in shares]
 
 
