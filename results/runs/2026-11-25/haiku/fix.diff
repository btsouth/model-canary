index 8965296..f7e9f8b 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,214 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+from functools import lru_cache
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAY_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (field name, lowest value, highest value, names allowed in the field)
+_FIELD_SPECS = (
+    ("minute", 0, 59, {}),
+    ("hour", 0, 23, {}),
+    ("day of month", 1, 31, {}),
+    ("month", 1, 12, _MONTH_NAMES),
+    ("day of week", 0, 7, _DAY_NAMES),
+)
+_DAY_FIELDS = ("day of month", "day of week")
+
+_DIGITS = re.compile(r"[0-9]+")
+_STEP_BASE = re.compile(r"[0-9]+(?:-[0-9]+)?")
+_DOW_SPECIAL = re.compile(r"([0-9]+)(?:(L)|#([0-9]+))", re.IGNORECASE)
+
+
+class _Schedule:
+    """A parsed expression: the sets of allowed values for each part."""
+
+    def __init__(self, minutes, hours, dom_values, dom_last, dom_restricted,
+                 months, dow_values, dow_last, dow_nth, dow_restricted):
+        self.minutes = minutes
+        self.hours = hours
+        self.dom_values = dom_values
+        self.dom_last = dom_last
+        self.dom_restricted = dom_restricted
+        self.months = months
+        self.dow_values = dow_values      # 0-6, Sunday is 0
+        self.dow_last = dow_last          # weekdays whose last occurrence counts
+        self.dow_nth = dow_nth            # (weekday, K) pairs
+        self.dow_restricted = dow_restricted
+
+
+def _number(tok, spec):
+    """Value of a plain number or allowed name token, range-checked."""
+    _, low, high, names = spec
+    if _DIGITS.fullmatch(tok):
+        value = int(tok)
+    elif names and tok.upper() in names:
+        value = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {value} out of range {low}-{high}")
+    return value
+
+
+def _parse_item(item, spec, is_day):
+    """Parse one comma-separated item. Returns (values, specials)."""
+    name, low, high, _ = spec
+    if item == "":
+        raise ValueError("empty item")
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _DIGITS.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    if base == "*":
+        return set(range(low, high + 1, step)), set()
+    if is_day and not slash:
+        if name == "day of month" and base.upper() == "L":
+            return set(), {("L",)}
+        if name == "day of week":
+            m = _DOW_SPECIAL.fullmatch(base)
+            if m:
+                if int(m.group(1)) > 7:
+                    raise ValueError(f"bad weekday in {item!r}")
+                weekday = int(m.group(1)) % 7
+                if m.group(2):
+                    return set(), {("last", weekday)}
+                k = int(m.group(3))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad occurrence in {item!r}")
+                return set(), {("nth", weekday, k)}
+    if slash and not _STEP_BASE.fullmatch(base):
+        raise ValueError(f"step needs a plain number or range: {item!r}")
+    if "-" in base:
+        if base.count("-") != 1:
+            raise ValueError(f"bad range {item!r}")
+        first_text, last_text = base.split("-")
+        first = _number(first_text, spec)
+        last = _number(last_text, spec)
+        if first > last:
+            raise ValueError(f"range start after end: {item!r}")
+    else:
+        first = _number(base, spec)
+        last = high if slash else first
+    return set(range(first, last + 1, step)), set()
+
+
+def _parse_text(text):
+    text = text.strip()
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {text!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {text!r}")
+
+    parsed = []
+    for raw, spec in zip(parts, _FIELD_SPECS):
+        is_day = spec[0] in _DAY_FIELDS
+        restricted = raw not in ("*", "?")
+        if raw == "?":
+            if not is_day:
+                raise ValueError(f"'?' not allowed in {spec[0]} field")
+            raw = "*"
+        values, specials = set(), set()
+        for item in raw.split(","):
+            v, s = _parse_item(item, spec, is_day)
+            values |= v
+            specials |= s
+        parsed.append((values, specials, restricted))
+
+    (minutes, _, _), (hours, _, _), (dom, dom_specials, dom_r), \
+        (months, _, _), (dow, dow_specials, dow_r) = parsed
+    return _Schedule(
+        minutes=minutes,
+        hours=hours,
+        dom_values=dom,
+        dom_last=("L",) in dom_specials,
+        dom_restricted=dom_r,
+        months=months,
+        dow_values={v % 7 for v in dow},
+        dow_last={n for kind, *rest in dow_specials if kind == "last" for n in rest},
+        dow_nth={tuple(rest) for kind, *rest in dow_specials if kind == "nth"},
+        dow_restricted=dow_r,
+    )
+
+
+@lru_cache(maxsize=256)
+def _compile_str(expr):
+    return _parse_text(expr)
+
+
+def _compile(expr):
+    if not isinstance(expr, str):
+        raise ValueError(f"expression must be a string, not {type(expr).__name__}")
+    return _compile_str(expr)
+
+
+def _day_ok(s, when):
+    """True if the day of when is allowed by the day-of-month and day-of-week fields."""
+    last_day = calendar.monthrange(when.year, when.month)[1]
+    day = when.day
+    weekday = when.isoweekday() % 7  # Sunday is 0
+    dom_ok = day in s.dom_values or (s.dom_last and day == last_day)
+    dow_ok = (weekday in s.dow_values
+              or (weekday in s.dow_last and day + 7 > last_day)
+              or (weekday, (day - 1) // 7 + 1) in s.dow_nth)
+    if s.dom_restricted and s.dow_restricted:
+        return dom_ok or dow_ok
+    if s.dom_restricted:
+        return dom_ok
+    if s.dow_restricted:
+        return dow_ok
+    return True
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _compile(expr)
+    return (when.minute in s.minutes and when.hour in s.hours
+            and when.month in s.months and _day_ok(s, when))
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    s = _compile(expr)
+    try:
+        limit = after + timedelta(days=50 * 365)
+    except OverflowError:
+        limit = datetime.max
+    try:
+        t = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+        while t <= limit:
+            if t.month not in s.months:
+                year, month = (t.year + 1, 1) if t.month == 12 else (t.year, t.month + 1)
+                t = t.replace(year=year, month=month, day=1, hour=0, minute=0)
+            elif not _day_ok(s, t):
+                t = t.replace(hour=0, minute=0) + timedelta(days=1)
+            elif t.hour not in s.hours:
+                t = t.replace(minute=0) + timedelta(hours=1)
+            elif t.minute not in s.minutes:
+                t = t + timedelta(minutes=1)
+            else:
+                return t
+        return None
+    except (OverflowError, ValueError):
+        # Ran off the end of the datetime range.
+        return None
