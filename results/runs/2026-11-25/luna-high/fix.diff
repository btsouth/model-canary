+    limit = after + datetime.timedelta(days=50 * 365)
+    day = after.date()
+    while day <= limit.date():
+        if day.month in schedule["month"] and _day_matches(schedule, day):
+            threshold = start_minute if day == after.date() else 0
+            index = bisect_left(minute_of_day, threshold)
+            if index < len(minute_of_day):
+                value = minute_of_day[index]
+                result = datetime.datetime(day.year, day.month, day.day, value // 60, value % 60)
+                if result > after and result <= limit:
+                    return result
+        day += datetime.timedelta(days=1)
+    return None
