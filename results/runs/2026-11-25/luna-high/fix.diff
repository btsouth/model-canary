 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+from bisect import bisect_left
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): index for index, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): (index + 1) % 7 for index, name in enumerate(calendar.day_abbr)}
+_SPECS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _bad():
+    raise ValueError("invalid schedule expression")
+
+
+def _number(token, field):
+    names = _MONTHS if field == 3 else (_DAYS if field == 4 else {})
+    if token.upper() in names:
+        return names[token.upper()]
+    if not re.fullmatch(r"\d+", token):
+        _bad()
+    value = int(token)
+    low, high = _SPECS[field]
+    if not low <= value <= high:
+        _bad()
+    return value
+
+
+def _parse_list(source, field):
+    low, high = _SPECS[field]
+    values = set()
+    last_days = set()
+    nth_days = set()
+    for item in source.split(","):
+        if not item:
+            _bad()
+        if field == 2 and item == "L":
+            last_days.add(True)
+            continue
+        if field == 4:
+            m = re.fullmatch(r"(\d+)L", item)
+            if m:
+                n = _number(m.group(1), field)
+                last_days.add(n % 7)
+                continue
+            m = re.fullmatch(r"(\d+)#([1-5])", item)
+            if m:
+                n = _number(m.group(1), field)
+                nth_days.add((n % 7, int(m.group(2))))
+                continue
+        if "L" in item or "#" in item:
+            _bad()
+        if item.count("/") > 1:
+            _bad()
+        if "/" in item:
+            base, step_text = item.split("/")
+            if not re.fullmatch(r"\d+", step_text) or int(step_text) < 1:
+                _bad()
+            step = int(step_text)
+            if not base:
+                _bad()
+            if re.search(r"[A-Za-z]", base) and base != "*":
+                _bad()
+        else:
+            base, step = item, 1
+        if base == "*":
+            candidates = list(range(low, high + 1))
+        elif base.count("-") == 1:
+            first, end = base.split("-")
+            start_value, end_value = _number(first, field), _number(end, field)
+            if start_value > end_value:
+                _bad()
+            candidates = list(range(start_value, end_value + 1))
+        elif "-" in base:
+            _bad()
+        else:
+            start_value = _number(base, field)
+            candidates = list(range(start_value, high + 1)) if "/" in item else [start_value]
+        for value in candidates[::step]:
+            values.add(value % 7 if field == 4 else value)
+    return values, last_days, nth_days
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        _bad()
+    source = expr.strip()
+    shortcut = _SHORTCUTS.get(source.lower())
+    if shortcut is not None:
+        source = shortcut
+    fields = re.split(r"[ \t]+", source) if source else []
+    if len(fields) != 5:
+        _bad()
+    parsed_fields = ["*" if value == "?" and index in (2, 4) else value
+                     for index, value in enumerate(fields)]
+    parsed = [_parse_list(value, index) for index, value in enumerate(parsed_fields)]
+    return {
+        "minute": parsed[0][0], "hour": parsed[1][0],
+        "dom": parsed[2][0], "dom_last": bool(parsed[2][1]),
+        "month": parsed[3][0], "dow": parsed[4][0],
+        "dow_last": parsed[4][1], "dow_nth": parsed[4][2],
+        "dom_open": fields[2] in ("*", "?"),
+        "dow_open": fields[4] in ("*", "?"),
+    }
+
+
+def _day_matches(schedule, day):
+    weekday = (day.weekday() + 1) % 7  # cron Sunday is zero
+    month_last = calendar.monthrange(day.year, day.month)[1]
+    dom = day.day in schedule["dom"] or (schedule["dom_last"] and day.day == month_last)
+    dow = weekday in schedule["dow"]
+    if weekday in schedule["dow_last"] and day.day + 7 > month_last:
+        dow = True
+    if (weekday, (day.day - 1) // 7 + 1) in schedule["dow_nth"]:
+        dow = True
+    if schedule["dom_open"] and schedule["dow_open"]:
+        return True
+    if schedule["dom_open"]:
+        return dow
+    if schedule["dow_open"]:
+        return dom
+    return dom or dow
+
 
