+            for hour in hours:
+                for minute in minutes:
+                    candidate = _dt.datetime(date.year, date.month, date.day, hour, minute)
+                    if candidate > after and candidate <= limit:
+                        return candidate
+        if date == _dt.date.max:
+            break
+        date += _dt.timedelta(days=1)
+    return None
