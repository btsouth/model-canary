 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+_RANGES = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(s, field, names=False):
+    if names and s.upper() in field:
+        return field[s.upper()]
+    if not re.fullmatch(r"\d+", s):
+        raise ValueError("invalid field value")
+    return int(s)
+
+
+def _parse_field(raw, index):
+    lo, hi = _RANGES[index]
+    if raw == "?":
+        if index not in (2, 4):
+            raise ValueError("? only valid in day fields")
+        raw = "*"
+        question = True
+    else:
+        question = False
+    values = set()
+    last = set()
+    nth = set()
+    for item in raw.split(","):
+        if not item:
+            raise ValueError("empty list item")
+        if index == 2 and item == "L":
+            last.add("L")
+            continue
+        if index == 4:
+            m = re.fullmatch(r"(\d+)L", item)
+            n = re.fullmatch(r"(\d+)#([1-5])", item)
+            if m:
+                d = int(m.group(1))
+                if not 0 <= d <= 7: raise ValueError("day out of range")
+                last.add(d % 7); continue
+            if n:
+                d, k = int(n.group(1)), int(n.group(2))
+                if not 0 <= d <= 7: raise ValueError("day out of range")
+                nth.add((d % 7, k)); continue
+        if "L" in item or "#" in item:
+            raise ValueError("invalid special day item")
+        bits = item.split("/")
+        if len(bits) > 2: raise ValueError("invalid step")
+        step = 1
+        if len(bits) == 2:
+            if not re.fullmatch(r"\d+", bits[1]) or int(bits[1]) < 1: raise ValueError("invalid step")
+            if index in (3, 4) and base not in ("*",) and any(base.upper().startswith(name) for name in (_MONTHS if index == 3 else _DAYS)):
+                raise ValueError("names cannot be stepped")
+            step = int(bits[1])
+        base = bits[0]
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2: raise ValueError("invalid range")
+            a = _number(ends[0], _MONTHS if index == 3 else _DAYS if index == 4 else {})
+            b = _number(ends[1], _MONTHS if index == 3 else _DAYS if index == 4 else {})
+            if a < lo or a > hi or b < lo or b > hi or a > b: raise ValueError("invalid range")
+            seq = list(range(a, b + 1))
+        else:
+            a = _number(base, _MONTHS if index == 3 else _DAYS if index == 4 else {})
+            if a < lo or a > hi: raise ValueError("value out of range")
+            seq = list(range(a, hi + 1)) if len(bits) == 2 else [a]
+        values.update(v % 7 if index == 4 else v for v in seq[::step])
+    return values, last, nth, question or raw == "*"
+
+
+def _compile(expr):
+    if not isinstance(expr, str): raise ValueError("expression must be text")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORTCUTS.get(expr.lower(), "")
+        if not expr: raise ValueError("unknown shortcut")
+    fields = re.split(r"[ \t]+", expr) if expr else []
+    if len(fields) != 5: raise ValueError("expected five fields")
+    parsed = [_parse_field(f, i) for i, f in enumerate(fields)]
+    return parsed
+
+
+def _dow(day):
+    return (day.weekday() + 1) % 7
+
+
+def _day_allowed(parsed, date):
+    dom, dow = parsed[2], parsed[4]
+    dom_match = date.day in dom[0] or "L" in dom[1] and date.day == calendar.monthrange(date.year, date.month)[1]
+    wd = _dow(date)
+    dow_match = wd in dow[0] or wd in dow[1]
+    if any(d == wd and (date.day - 1) // 7 + 1 == k for d, k in dow[2]): dow_match = True
+    if dom[3] and dow[3]: return True
+    if dom[3]: return dow_match
+    if dow[3]: return dom_match
+    return dom_match or dow_match
+
+
+def _matches(parsed, when):
+    if when.minute not in parsed[0][0] or when.hour not in parsed[1][0] or when.month not in parsed[3][0]: return False
+    return _day_allowed(parsed, when.date())
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    parsed = _compile(expr)
+    return _matches(parsed, when)
 
 
