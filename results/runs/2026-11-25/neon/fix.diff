diff --git a/tally/schedule.py b/tally/schedule.py
index 8965296..6ac76a3 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,307 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "jan": 1,
+    "feb": 2,
+    "mar": 3,
+    "apr": 4,
+    "may": 5,
+    "jun": 6,
+    "jul": 7,
+    "aug": 8,
+    "sep": 9,
+    "oct": 10,
+    "nov": 11,
+    "dec": 12,
+}
+
+_DOW_NAMES = {
+    "sun": 0,
+    "mon": 1,
+    "tue": 2,
+    "wed": 3,
+    "thu": 4,
+    "fri": 5,
+    "sat": 6,
+}
+
+_DIGITS = re.compile(r"[0-9]+")
+_FIELD_SEP = re.compile(r"[ \t]+")
+
+
+def _parse_int(token):
+    if not _DIGITS.fullmatch(token):
+        raise ValueError(f"invalid number: {token!r}")
+    return int(token)
+
+
+def _parse_value(token, min_val, max_val, names):
+    if _DIGITS.fullmatch(token):
+        val = int(token)
+        if not (min_val <= val <= max_val):
+            raise ValueError(f"value {val} out of range {min_val}-{max_val}")
+        return val
+    if names is not None:
+        key = token.lower()
+        if key in names:
+            return names[key]
+    raise ValueError(f"invalid field value: {token!r}")
+
+
+def _parse_standard_item(item, min_val, max_val, names):
+    if "/" in item:
+        parts = item.split("/")
+        if len(parts) != 2 or not parts[0] or not parts[1]:
+            raise ValueError(f"invalid step item: {item!r}")
+        base, step_str = parts
+        step = _parse_int(step_str)
+        if step < 1:
+            raise ValueError(f"step must be >= 1: {item!r}")
+    else:
+        base = item
+        step = None
+
+    if base == "*":
+        start, end = min_val, max_val
+    elif "-" in base:
+        bounds = base.split("-")
+        if len(bounds) != 2 or not bounds[0] or not bounds[1]:
+            raise ValueError(f"invalid range: {item!r}")
+        start = _parse_value(bounds[0], min_val, max_val, names)
+        end = _parse_value(bounds[1], min_val, max_val, names)
+        if start > end:
+            raise ValueError(f"range start > end: {item!r}")
+    else:
+        val = _parse_value(base, min_val, max_val, names)
+        if step is None:
+            return [val]
+        start, end = val, max_val
+
+    if step is None:
+        return list(range(start, end + 1))
+    return list(range(start, end + 1, step))
+
+
+def _parse_simple_field(field, min_val, max_val, names=None):
+    items = field.split(",")
+    values = set()
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in field: {field!r}")
+        values.update(_parse_standard_item(item, min_val, max_val, names))
+    return sorted(values)
+
+
+def _parse_dom_field(field):
+    if field in ("*", "?"):
+        return False, set(range(1, 32)), False
+    items = field.split(",")
+    days = set()
+    has_last = False
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in day-of-month field: {field!r}")
+        if item == "L":
+            has_last = True
+        else:
+            days.update(_parse_standard_item(item, 1, 31, None))
+    return True, days, has_last
+
+
+def _parse_dow_field(field):
+    if field in ("*", "?"):
+        return False, set(range(7)), set(), set()
+    items = field.split(",")
+    dows = set()
+    last_dows = set()
+    nth_dows = set()
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in day-of-week field: {field!r}")
+        if item.endswith("L") and "/" not in item and "-" not in item and "#" not in item:
+            num_str = item[:-1]
+            if not num_str:
+                raise ValueError(f"invalid day-of-week item: {item!r}")
+            n = _parse_int(num_str)
+            if not (0 <= n <= 7):
+                raise ValueError(f"day-of-week out of range: {item!r}")
+            last_dows.add(n % 7)
+        elif "#" in item and "/" not in item and "-" not in item:
+            parts = item.split("#")
+            if len(parts) != 2 or not parts[0] or not parts[1]:
+                raise ValueError(f"invalid nth day-of-week item: {item!r}")
+            n = _parse_int(parts[0])
+            k = _parse_int(parts[1])
+            if not (0 <= n <= 7) or not (1 <= k <= 5):
+                raise ValueError(f"nth day-of-week out of range: {item!r}")
+            nth_dows.add((n % 7, k))
+        else:
+            for v in _parse_standard_item(item, 0, 7, _DOW_NAMES):
+                dows.add(v % 7)
+    return True, dows, last_dows, nth_dows
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("expression must be a string")
+        text = expr.strip()
+        if not text:
+            raise ValueError("empty schedule expression")
+        lower = text.lower()
+        if lower in _SHORTCUTS:
+            text = _SHORTCUTS[lower]
+        elif lower.startswith("@"):
+            raise ValueError(f"unknown shortcut: {expr!r}")
+
+        parts = _FIELD_SEP.split(text)
+        if len(parts) != 5:
+            raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+
+        min_f, hour_f, dom_f, mon_f, dow_f = parts
+        self.minutes = _parse_simple_field(min_f, 0, 59)
+        self.minute_set = set(self.minutes)
+        self.hours = _parse_simple_field(hour_f, 0, 23)
+        self.hour_set = set(self.hours)
+        self.dom_restricted, self.dom_days, self.dom_last = _parse_dom_field(dom_f)
+        self.months = _parse_simple_field(mon_f, 1, 12, _MONTH_NAMES)
+        self.month_set = set(self.months)
+        self.dow_restricted, self.dow_days, self.dow_last, self.dow_nth = _parse_dow_field(dow_f)
+
+    def _day_allowed(self, year, month, day):
+        if not self.dom_restricted and not self.dow_restricted:
+            return True
+        first_py_wd, num_days = calendar.monthrange(year, month)
+        dom_match = (day in self.dom_days) or (self.dom_last and day == num_days)
+        if self.dom_restricted and not self.dow_restricted:
+            return dom_match
+        dow = ((first_py_wd + 1) % 7 + day - 1) % 7
+        dow_match = (
+            (dow in self.dow_days)
+            or (dow in self.dow_last and day + 7 > num_days)
+            or ((dow, (day - 1) // 7 + 1) in self.dow_nth)
+        )
+        if self.dow_restricted and not self.dom_restricted:
+            return dow_match
+        return dom_match or dow_match
+
+    def _allowed_days(self, year, month):
+        first_py_wd, num_days = calendar.monthrange(year, month)
+        if not self.dom_restricted and not self.dow_restricted:
+            return list(range(1, num_days + 1))
+        first_cron_wd = (first_py_wd + 1) % 7
+        result = []
+        for day in range(1, num_days + 1):
+            dom_match = (day in self.dom_days) or (self.dom_last and day == num_days)
+            if self.dom_restricted and not self.dow_restricted:
+                if dom_match:
+                    result.append(day)
+                continue
+            dow = (first_cron_wd + day - 1) % 7
+            dow_match = (
+                (dow in self.dow_days)
+                or (dow in self.dow_last and day + 7 > num_days)
+                or ((dow, (day - 1) // 7 + 1) in self.dow_nth)
+            )
+            if self.dow_restricted and not self.dom_restricted:
+                if dow_match:
+                    result.append(day)
+            elif dom_match or dow_match:
+                result.append(day)
+        return result
+
+    def matches(self, when):
+        return (
+            when.month in self.month_set
+            and when.hour in self.hour_set
+            and when.minute in self.minute_set
+            and self._day_allowed(when.year, when.month, when.day)
+        )
+
+    def next_run(self, after):
+        start = after.replace(second=0, microsecond=0) + dt.timedelta(minutes=1)
+        try:
+            limit = after + dt.timedelta(days=50 * 365)
+        except OverflowError:
+            limit = dt.datetime.max
+
+        start_date = (start.year, start.month, start.day)
+        limit_date = (limit.year, limit.month, limit.day)
+        min_hour = self.hours[0]
+        min_minute = self.minutes[0]
+
+        year = start.year
+        month = start.month
+        while (year, month) <= (limit.year, limit.month):
+            if month not in self.month_set:
+                next_months = [m for m in self.months if m > month]
+                if next_months:
+                    month = next_months[0]
+                else:
+                    year += 1
+                    month = self.months[0]
+                continue
+
+            for day in self._allowed_days(year, month):
+                cur_date = (year, month, day)
+                if cur_date < start_date:
+                    continue
+                if cur_date > limit_date:
+                    return None
+                if cur_date == start_date:
+                    found = None
+                    for h in self.hours:
+                        if h < start.hour:
+                            continue
+                        if h == start.hour:
+                            for m in self.minutes:
+                                if m >= start.minute:
+                                    found = (h, m)
+                                    break
+                        else:
+                            found = (h, min_minute)
+                        if found is not None:
+                            break
+                    if found is None:
+                        continue
+                    hour, minute = found
+                else:
+                    hour, minute = min_hour, min_minute
+
+                candidate = dt.datetime(year, month, day, hour, minute)
+                if candidate <= limit:
+                    return candidate
+                return None
+
+            next_months = [m for m in self.months if m > month]
+            if next_months:
+                month = next_months[0]
+            else:
+                year += 1
+                month = self.months[0]
+
+        return None
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
