+
+    sign = -1 if total < 0 else 1
+    abs_total = abs(total)
+    exact = [Fraction(abs_total) * w / whole for w in frac_weights]
+    shares = [e.numerator // e.denominator for e in exact]
+    remainders = [e - s for e, s in zip(exact, shares)]
+    leftover = abs_total - sum(shares)
+    order = sorted(range(len(shares)), key=lambda i: (remainders[i], i), reverse=True)
+    for i in order[:leftover]:
+        shares[i] += 1
+    return [sign * s for s in shares]
 
 
