+    if total < 0:
+        return [-share for share in apportion(-total, weights)]
+    exact = [Fraction(w) for w in weights]
+    whole = sum(exact)
+    parts = [total * w / whole for w in exact]
+    shares = [p.numerator // p.denominator for p in parts]
