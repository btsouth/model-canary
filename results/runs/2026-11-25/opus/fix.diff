+    return _day_allowed(sched, when.day, (when.weekday() + 1) % 7, last_day)
+
+
+def _first_time(sched, hour, minute):
+    """The first (hour, minute) of the schedule at or after hour:minute, or None."""
+    for h in sched.hours:
+        if h < hour:
+            continue
+        for m in sched.minutes:
+            if h > hour or m >= minute:
+                return h, m
+    return None
 
 
