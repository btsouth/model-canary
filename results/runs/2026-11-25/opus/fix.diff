 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (minimum, maximum, names mapping or None)
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "dom", "dom_last", "months", "dow",
+                 "dow_last", "dow_nth", "dom_restricted", "dow_restricted")
+
+
+def _value(text, low, high, names):
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {text!r} out of range {low}-{high}")
+    return value
+
+
+def _parse_field(text, index, sched):
+    low, high, names = _FIELDS[index]
+    is_dom, is_dow = index == 2, index == 4
+    values = set()
+    last = False
+    lasts = set()
+    nths = set()
+    if text == "?":
+        if not (is_dom or is_dow):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    for item in text.split(","):
+        if item == "":
+            raise ValueError("empty item")
+        if is_dom and item == "L":
+            last = True
+            continue
+        if is_dow:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                day = int(m.group(1))
+                if day > 7:
+                    raise ValueError(f"bad day of week in {item!r}")
+                lasts.add(day % 7)
+                continue
+            m = _NTH_DOW.fullmatch(item)
+            if m:
+                day, nth = int(m.group(1)), int(m.group(2))
+                if day > 7 or not 1 <= nth <= 5:
+                    raise ValueError(f"bad item {item!r}")
+                nths.add((day % 7, nth))
+                continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"step must be at least 1 in {item!r}")
+        else:
+            step = 1
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            start, end = _value(a, low, high, names), _value(b, low, high, names)
+            if start > end:
+                raise ValueError(f"range {base!r} goes backwards")
+        else:
+            start = _value(base, low, high, names)
+            end = high if slash else start
+        values.update(range(start, end + 1, step))
+    if is_dow:
+        values = {v % 7 for v in values}
+    return values, last, lasts, nths
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {expr!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields in {expr!r}")
+    sched = _Schedule()
+    sched.minutes = sorted(_parse_field(parts[0], 0, sched)[0])
+    sched.hours = sorted(_parse_field(parts[1], 1, sched)[0])
+    sched.dom, sched.dom_last, _, _ = _parse_field(parts[2], 2, sched)
+    sched.months = _parse_field(parts[3], 3, sched)[0]
+    sched.dow, _, sched.dow_last, sched.dow_nth = _parse_field(parts[4], 4, sched)
+    sched.dom_restricted = parts[2] not in ("*", "?")
+    sched.dow_restricted = parts[4] not in ("*", "?")
+    return sched
+
+
+def _day_allowed(sched, day, dow, last_day):
+    """dow is 0 for Sunday through 6 for Saturday."""
+    if sched.dom_restricted:
+        dom_ok = day in sched.dom or (sched.dom_last and day == last_day)
+        if not sched.dow_restricted:
+            return dom_ok
+        if dom_ok:
+            return True
+    elif not sched.dow_restricted:
+        return True
+    return (dow in sched.dow
+            or (dow in sched.dow_last and day + 7 > last_day)
+            or (dow, (day - 1) // 7 + 1) in sched.dow_nth)
 
 
