 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import date, datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(token):
+    if re.fullmatch(r"[0-9]+", token) is None:
+        raise ValueError(f"invalid number: {token!r}")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def value(token):
+        number = names.get(token.upper())
+        if number is None:
+            number = _number(token)
+        if not low <= number <= high:
+            raise ValueError(f"value outside field range: {token!r}")
+        return number
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        if index == 4:
+            match = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if match:
+                weekday = value(match[1]) % 7
+                if match[2] == "L":
+                    special.append(("last_weekday", weekday))
+                else:
+                    occurrence = _number(match[3])
+                    if not 1 <= occurrence <= 5:
+                        raise ValueError("weekday occurrence outside 1-5")
+                    special.append(("nth_weekday", weekday, occurrence))
+                continue
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"invalid step: {item!r}")
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = parts[0]
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(value, endpoints)
+            if start > end:
+                raise ValueError("range starts after its end")
+        else:
+            start = value(base)
+            end = high if len(parts) == 2 else start
+        values.update(range(start, end + 1, step))
+    if index == 4:
+        values = {n % 7 for n in values}
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("schedule must have five fields")
+    fields = [_field(part, i) for i, part in enumerate(parts)]
+    return fields, parts[2] in ("*", "?"), parts[4] in ("*", "?")
+
+
+def _day_matches(parsed, day):
+    fields, dom_free, dow_free = parsed
+    dom_values, dom_special = fields[2]
+    dow_values, dow_special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    dom = day.day in dom_values
+    dow = weekday in dow_values
+    if dom_special or dow_special:
+        last = calendar.monthrange(day.year, day.month)[1]
+        dom = dom or bool(dom_special and day.day == last)
+        for rule in dow_special:
+            if weekday == rule[1]:
+                if rule[0] == "last_weekday":
+                    dow = dow or day.day + 7 > last
+                else:
+                    dow = dow or (day.day - 1) // 7 + 1 == rule[2]
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow
+    if dow_free:
+        return dom
+    return dom or dow
+
 
