 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_left
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+
+_MONTH_NAMES = {name: number for number, name in
+                enumerate("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_WEEKDAY_NAMES = {name: number for number, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DECIMAL = re.compile(r"[0-9]+")
+_SPECIAL_WEEKDAY = re.compile(r"([0-9]+)(?:L|#([0-9]+))")
+_LOOKAHEAD_DAYS = 50 * 365
+
+
+@dataclass
+class _Schedule:
+    minutes: set
+    hours: set
+    month_days: set | None
+    months: set
+    weekdays: set | None
+    last_month_day: bool
+    last_weekdays: set
+    nth_weekdays: set
+
+    def allows_day(self, day, weekday, month_length):
+        if self.month_days is None and self.weekdays is None:
+            return True
+        if self.month_days is not None and (
+            day in self.month_days or (self.last_month_day and day == month_length)
+        ):
+            return True
+        return self.weekdays is not None and (
+            weekday in self.weekdays
+            or (weekday in self.last_weekdays and day + 7 > month_length)
+            or (weekday, (day - 1) // 7 + 1) in self.nth_weekdays
+        )
+
+
+def _number(token, maximum):
+    if not _DECIMAL.fullmatch(token):
+        raise ValueError(f"expected decimal digits: {token!r}")
+    digits = token.lstrip("0")
+    # A number this large is either out of range or a step that keeps only the first value.
+    if len(digits) > len(str(maximum)):
+        return maximum + 1
+    return int(digits or "0")
+
+
+def _value(token, minimum, maximum, names=None):
+    name = token.upper()
+    if names is not None and token.isascii() and name in names:
+        return names[name]
+    number = _number(token, maximum)
+    if not minimum <= number <= maximum:
+        raise ValueError(f"schedule value outside its field's range: {token!r}")
+    return number
+
+
+def _item_values(item, minimum, maximum, names=None):
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text, maximum - minimum + 1) if slash else 1
+    if step == 0:
+        raise ValueError("a schedule step must be positive")
+    if base == "*":
+        start, end = minimum, maximum
+    else:
+        start_text, dash, end_text = base.partition("-")
+        start = _value(start_text, minimum, maximum, names)
+        if dash:
+            end = _value(end_text, minimum, maximum, names)
+        else:
+            end = maximum if slash else start
+        if start > end:
+            raise ValueError(f"schedule range is reversed: {base!r}")
+    return range(start, end + 1, step)
+
+
+def _field_values(items, minimum, maximum, names=None):
+    values = set()
+    for item in items:
+        values.update(_item_values(item, minimum, maximum, names))
+    return values
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    expr = expr.strip()
+    fields = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    if len(fields) != 5:
+        raise ValueError("a schedule must have five fields")
+    minute, hour, month_day, month, weekday = fields
+    minutes = _field_values(minute.split(","), 0, 59)
+    hours = _field_values(hour.split(","), 0, 23)
+    months = _field_values(month.split(","), 1, 12, _MONTH_NAMES)
+
+    month_day_items = month_day.split(",")
+    month_days = None
+    if month_day not in ("*", "?"):
+        month_days = _field_values((item for item in month_day_items if item != "L"), 1, 31)
+
+    weekdays = None
+    last_weekdays = set()
+    nth_weekdays = set()
+    if weekday not in ("*", "?"):
+        weekdays = set()
+        for item in weekday.split(","):
+            special = _SPECIAL_WEEKDAY.fullmatch(item)
+            if special is None:
+                weekdays.update(day % 7 for day in _item_values(item, 0, 7, _WEEKDAY_NAMES))
+            else:
+                day = _value(special[1], 0, 7) % 7
+                if special[2] is None:
+                    last_weekdays.add(day)
+                else:
+                    nth_weekdays.add((day, _value(special[2], 1, 5)))
+
+    return _Schedule(
+        minutes, hours, month_days, months, weekdays,
+        "L" in month_day_items, last_weekdays, nth_weekdays,
+    )
+
 
