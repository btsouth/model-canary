 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad value: {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _field(text, lo, hi, names=None, day_kind=None):
+    """Return (set of values, extras). extras: for dom {'L'}; for dow
+    ('last', n) / ('nth', n, k) tuples."""
+    values, extras = set(), set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if day_kind == "dom" and item.upper() == "L":
+            extras.add("L")
+            continue
+        if day_kind == "dow":
+            m = re.fullmatch(r"([0-9]+)[Ll]", item)
+            if m:
+                n = _value(m.group(1), 0, 7, None)
+                extras.add(("last", n % 7))
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                n = _value(m.group(1), 0, 7, None)
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError("bad occurrence")
+                extras.add(("nth", n % 7, k))
+                continue
+        step = None
+        base = item
+        if "/" in item:
+            base, s = item.split("/", 1)
+            if not _NUM.fullmatch(s) or int(s) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(s)
+        if base == "*":
+            vals = list(range(lo, hi + 1))
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            if step is not None and (not _NUM.fullmatch(a) or not _NUM.fullmatch(b)):
+                raise ValueError("name in step")
+            a, b = _value(a, lo, hi, names), _value(b, lo, hi, names)
+            if a > b:
+                raise ValueError("descending range")
+            vals = list(range(a, b + 1))
+        else:
+            if step is not None and not _NUM.fullmatch(base):
+                raise ValueError("name in step")
+            a = _value(base, lo, hi, names)
+            vals = list(range(a, hi + 1)) if step is not None else [a]
+        if step is not None:
+            vals = vals[::step]
+        values.update(vals)
+    return values, extras
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError("unknown shortcut")
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    mi, ho, dom, mo, dow = parts
+    minutes = _field(mi, 0, 59)[0]
+    hours = _field(ho, 0, 23)[0]
+    months = _field(mo, 1, 12, _MONTHS)[0]
+    dom_free = dom in ("*", "?")
+    dow_free = dow in ("*", "?")
+    dom_set, dom_x = _field("*" if dom == "?" else dom, 1, 31, None, "dom")
+    dow_set, dow_x = _field("*" if dow == "?" else dow, 0, 7, _DAYS, "dow")
+    dow_set = {v % 7 for v in dow_set}
+    return (sorted(minutes), sorted(hours), months, dom_set, dom_x, dom_free,
+            dow_set, dow_x, dow_free)
+
+
+def _day_ok(p, d):
+    _, _, months, dom_set, dom_x, dom_free, dow_set, dow_x, dow_free = p
+    if d.month not in months:
+        return False
+    if dom_free and dow_free:
+        return True
+    last = calendar.monthrange(d.year, d.month)[1]
+    dom_ok = d.day in dom_set or ("L" in dom_x and d.day == last)
+    wd = d.isoweekday() % 7
+    dow_ok = wd in dow_set
+    if not dow_ok:
+        for x in dow_x:
+            if x[0] == "last" and x[1] == wd and d.day + 7 > last:
+                dow_ok = True
+            elif x[0] == "nth" and x[1] == wd and (d.day - 1) // 7 + 1 == x[2]:
+                dow_ok = True
+    if dom_free:
+        return dow_ok
+    if dow_free:
+        return dom_ok
+    return dom_ok or dow_ok
 
 
