 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        unrestricted = field in ('*', '?')
+        if field == '?' and index in (2, 4):
+            field = '*'
+        values, special = set(), []
+        def number(s):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if s.upper() in names:
+                return names[s.upper()]
+            if not re.fullmatch(r'[0-9]+', s):
+                raise ValueError('invalid value')
+            n = int(s)
+            if not low <= n <= high:
+                raise ValueError('value out of range')
+            return n
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])L|([0-7])#([1-5])', item) if index == 4 else None
+            if match:
+                if match.group(1) is not None:
+                    special.append(('weekday_last', int(match.group(1)) % 7))
+                else:
+                    special.append(('weekday_nth', int(match.group(2)) % 7, int(match.group(3))))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                start, end = low, high
+            elif '-' in base:
+                bounds = base.split('-')
+                if len(bounds) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, bounds)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = high if len(pieces) == 2 else start
+            values.update(n % 7 if index == 4 else n for n in range(start, end + 1, step))
+        parsed.append((values, special, unrestricted))
+    return parsed
+
+
+def _day_matches(schedule, day):
+    dom, dow = schedule[2], schedule[4]
+    last = calendar.monthrange(day.year, day.month)[1]
+    weekday = (day.weekday() + 1) % 7
+    dm = day.day in dom[0] or (('last',) in dom[1] and day.day == last)
+    dw = weekday in dow[0] or any(
+        (item[0] == 'weekday_last' and weekday == item[1] and day.day + 7 > last)
+        or (item[0] == 'weekday_nth' and weekday == item[1] and (day.day - 1) // 7 + 1 == item[2])
+        for item in dow[1])
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dw
+    if dow[2]:
+        return dm
+    return dm or dw
+
 
