 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import date, datetime
+from typing import NamedTuple
+
+
+_MONTHS = "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split()
+_WEEKDAYS = "SUN MON TUE WED THU FRI SAT".split()
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_ITEM = re.compile(r"(\*|[0-9]+|[a-zA-Z]{3})(?:-([0-9]+|[a-zA-Z]{3}))?(?:/([0-9]+))?")
+
+
+def _number(token, maximum):
+    digits = token.lstrip("0") or "0"
+    if len(digits) > len(str(maximum)):
+        return maximum + 1
+    return int(digits)
+
+
+def _field(text, low, high, names=()):
+    def endpoint(token):
+        if token.upper() in names:
+            return low + names.index(token.upper())
+        if token.isascii() and token.isdecimal():
+            value = _number(token, high)
+            if low <= value <= high:
+                return value
+        raise ValueError(f"invalid field value: {token!r}")
+
+    values = set()
+    for item in text.split(","):
+        match = _ITEM.fullmatch(item)
+        if not match:
+            raise ValueError(f"invalid item: {item!r}")
+        first, last, stride = match.groups()
+        step = _number(stride, high + 1) if stride else 1
+        if step == 0:
+            raise ValueError("zero step")
+        if first == "*":
+            if last:
+                raise ValueError("wildcard range endpoint")
+            start, end = low, high
+        else:
+            start = endpoint(first)
+            end = endpoint(last) if last else (high if stride else start)
+
+        if start <= end:
+            sequence = range(start, end + 1)
+        elif names == _WEEKDAYS:
+            # A wrapped week crosses Sunday once, even though it has two names.
+            start %= 7
+            sequence = [(start + offset) % 7 for offset in range((end - start) % 7 + 1)]
+        else:
+            sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        values.update(sequence[::step])
+    return values
+
+
+class _Schedule(NamedTuple):
+    minutes: list
+    hours: list
+    days: set
+    months: set
+    weekdays: set
+    last_day: bool
+    last_weekdays: set
+    nth_weekdays: set
+
+    def allows_date(self, day):
+        if day.month not in self.months:
+            return False
+        last = calendar.monthrange(day.year, day.month)[1]
+        if day.day not in self.days and not (self.last_day and day.day == last):
+            return False
+        weekday = (day.weekday() + 1) % 7
+        return (weekday in self.weekdays
+                or (weekday in self.last_weekdays and day.day + 7 > last)
+                or (weekday, (day.day - 1) // 7 + 1) in self.nth_weekdays)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    parts = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    if len(parts) != 5:
+        raise ValueError("expected five schedule fields")
+    minute, hour, dom, month, dow = parts
+    minutes = sorted(_field(minute, 0, 59))
+    hours = sorted(_field(hour, 0, 23))
+    months = _field(month, 1, 12, _MONTHS)
+
+    days = set()
+    last_day = False
+    for item in ("*" if dom == "?" else dom).split(","):
+        if item == "L":
+            last_day = True
+        else:
+            days.update(_field(item, 1, 31))
+
+    weekdays = set()
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in ("*" if dow == "?" else dow).split(","):
+        special = re.fullmatch(r"([0-9]+)(?:L|#([0-9]+))", item)
+        if special:
+            weekday = _number(special[1], 7)
+            if weekday > 7:
+                raise ValueError("weekday out of range")
+            if special[2] is None:
+                last_weekdays.add(weekday % 7)
+            else:
+                occurrence = _number(special[2], 5)
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence out of range")
+                nth_weekdays.add((weekday % 7, occurrence))
+        else:
+            weekdays.update(n % 7 for n in _field(item, 0, 7, _WEEKDAYS))
+    return _Schedule(minutes, hours, days, months, weekdays,
+                     last_day, last_weekdays, nth_weekdays)
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    schedule = _parse(expr)
+    return (schedule.allows_date(when) and when.hour in schedule.hours
+            and when.minute in schedule.minutes)
 
 
