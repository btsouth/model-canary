 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_MONTH_NAMES = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+_DOW_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_FIELD_SPECS = (
+    {"name": "minute", "lo": 0, "hi": 59, "names": None},
+    {"name": "hour", "lo": 0, "hi": 23, "names": None},
+    {"name": "day of month", "lo": 1, "hi": 31, "names": None},
+    {"name": "month", "lo": 1, "hi": 12, "names": _MONTH_NAMES},
+    {"name": "day of week", "lo": 0, "hi": 7, "names": _DOW_NAMES},
+)
+
+_NUMBER = re.compile(r"^[0-9]+$")
+
+
+def _value(token, spec):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    else:
+        names = spec["names"]
+        if names is None or token.upper() not in names:
+            raise ValueError(f"bad value {token!r} in {spec['name']}")
+        value = names[token.upper()]
+    if not spec["lo"] <= value <= spec["hi"]:
+        raise ValueError(f"value out of range in {spec['name']}: {token!r}")
+    return value
+
+
+def _expand_range(start, end, spec, is_dow):
+    if start <= end:
+        return list(range(start, end + 1))
+    maximum = 6 if is_dow else spec["hi"]
+    return list(range(start, maximum + 1)) + list(range(spec["lo"], end + 1))
+
+
+def _parse_field(text, spec, is_dom, is_dow):
+    if text == "?":
+        if not (is_dom or is_dow):
+            raise ValueError(f"'?' is not allowed in {spec['name']}")
+        text = "*"
+
+    values = set()
+    last = False
+    last_weekdays = []
+    nth_weekdays = []
+
+    for item in text.split(","):
+        if not item:
+            raise ValueError(f"empty item in {spec['name']}")
+        if "?" in item:
+            raise ValueError(f"'?' is not allowed in {spec['name']}")
+
+        if is_dom and item == "L":
+            last = True
+            continue
+        if is_dow:
+            match = re.fullmatch(r"([0-7])L", item)
+            if match:
+                last_weekdays.append(int(match.group(1)) % 7)
+                continue
+            match = re.fullmatch(r"([0-7])#([1-5])", item)
+            if match:
+                nth_weekdays.append((int(match.group(1)) % 7, int(match.group(2))))
+                continue
+
+        if "/" in item:
+            if item.count("/") != 1:
+                raise ValueError(f"bad step in {item!r}")
+            base, step_text = item.split("/")
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step in {item!r}")
+        else:
+            base = item
+            step = None
+
+        if not base:
+            raise ValueError(f"empty item in {spec['name']}")
+
+        if base == "*":
+            item_values = list(range(spec["lo"], spec["hi"] + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError(f"bad range {base!r}")
+            first, second = base.split("-")
+            if not first or not second:
+                raise ValueError(f"bad range {base!r}")
+            item_values = _expand_range(
+                _value(first, spec), _value(second, spec), spec, is_dow
+            )
+        else:
+            value = _value(base, spec)
+            if step is None:
+                item_values = [value]
+            else:
+                item_values = list(range(value, spec["hi"] + 1))
+
+        if step is not None:
+            item_values = item_values[::step]
+
+        for value in item_values:
+            values.add(value % 7 if is_dow else value)
+
+    return values, last, last_weekdays, nth_weekdays
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    text = expr.strip()
+    lowered = text.lower()
+    if lowered.startswith("@"):
+        if lowered not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[lowered]
+    fields = re.split(r"[ \t]+", text) if text else []
+    if len(fields) != 5:
+        raise ValueError(f"schedule must have five fields: {expr!r}")
+
+    parsed = {}
+    for index, spec in enumerate(_FIELD_SPECS):
+        is_dom = spec["name"] == "day of month"
+        is_dow = spec["name"] == "day of week"
+        values, last, last_weekdays, nth_weekdays = _parse_field(
+            fields[index], spec, is_dom, is_dow
+        )
+        parsed[spec["name"]] = values
+        if is_dom:
+            parsed["dom_last"] = last
+        if is_dow:
+            parsed["dow_last"] = last_weekdays
+            parsed["dow_nth"] = nth_weekdays
+    return parsed
+
+
+def _last_day(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _day_matches(parsed, day):
+    year, month, number = day.year, day.month, day.day
+    last = _last_day(year, month)
+
+    if number not in parsed["day of month"]:
+        if not (parsed["dom_last"] and number == last):
+            return False
+
+    weekday = (day.weekday() + 1) % 7
+    if weekday in parsed["day of week"]:
+        return True
+    if parsed["dow_last"] and weekday in parsed["dow_last"] and number + 7 > last:
+        return True
+    occurrence = (number - 1) // 7 + 1
+    for nth_weekday, nth in parsed["dow_nth"]:
+        if weekday == nth_weekday and occurrence == nth:
+            return True
+    return False
+
 
