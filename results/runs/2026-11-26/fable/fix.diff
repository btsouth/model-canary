 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# (minimum, maximum, names) for each of the five fields.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+MINUTE, HOUR, DOM, MONTH, DOW = range(5)
+
+_NUMBER = re.compile(r"\d+")
+_LIMIT_DAYS = 20 * 365
+
+
+def _value(token, index):
+    """Read a single field value, which may be a name in the month/day-of-week fields."""
+    low, high, names = _FIELDS[index]
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value {token!r} out of range {low}-{high}")
+    if index == DOW and value == 7:
+        value = 0
+    return value
+
+
+def _ranged(token, index):
+    """Values of `*`, `N` or `A-B`, in listed order (wrapping ranges wrap)."""
+    low, high, _ = _FIELDS[index]
+    if index == DOW:
+        high = 6  # 7 is folded into 0
+    if token == "*":
+        return list(range(low, high + 1))
+    if "-" in token:
+        first, last = token.split("-", 1)
+        a, b = _value(first, index), _value(last, index)
+        if a <= b:
+            return list(range(a, b + 1))
+        return list(range(a, high + 1)) + list(range(low, b + 1))
+    value = _value(token, index)
+    return [value]
+
+
+def _item(token, index):
+    """Parse one comma-separated item into a set of plain values and special markers.
+
+    Returns (values, specials) where specials is a set of ("L",), ("NL", n) or
+    ("#", n, k) tuples.
+    """
+    if token == "":
+        raise ValueError("empty item")
+    if index == DOM and token.upper() == "L":
+        return set(), {("L",)}
+    if index == DOW:
+        if token[-1:].upper() == "L" and _NUMBER.fullmatch(token[:-1] or "x"):
+            return set(), {("NL", _value(token[:-1], index))}
+        if "#" in token:
+            n, k = token.split("#", 1)
+            if not (_NUMBER.fullmatch(n) and _NUMBER.fullmatch(k)):
+                raise ValueError(f"bad item {token!r}")
+            if not 1 <= int(k) <= 5:
+                raise ValueError(f"bad week number in {token!r}")
+            return set(), {("#", _value(n, index), int(k))}
+    if "/" in token:
+        base, step = token.split("/", 1)
+        if not _NUMBER.fullmatch(step) or int(step) < 1:
+            raise ValueError(f"bad step in {token!r}")
+        step = int(step)
+        if base != "*" and "-" not in base:
+            # N/S lists N up to the field's maximum.
+            low, high, _ = _FIELDS[index]
+            if index == DOW:
+                high = 6
+            values = list(range(_value(base, index), high + 1))
+        else:
+            values = _ranged(base, index)
+        return set(values[::step]), set()
+    return set(_ranged(token, index)), set()
+
+
+def _field(text, index):
+    """Parse a whole field into (values, specials, is_any)."""
+    if text == "?":
+        if index not in (DOM, DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(), set(), True
+    values, specials = set(), set()
+    for token in text.split(","):
+        v, s = _item(token, index)
+        values |= v
+        specials |= s
+    is_any = index in (DOM, DOW) and any(token == "*" for token in text.split(","))
+    return values, specials, is_any
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {text!r}") from None
+    parts = text.split()
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}")
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_allowed(fields, date):
+    dom_values, dom_specials, dom_any = fields[DOM]
+    dow_values, dow_specials, dow_any = fields[DOW]
+    last = calendar.monthrange(date.year, date.month)[1]
+    cron_dow = (date.weekday() + 1) % 7
+
+    dom_ok = dom_any or date.day in dom_values or (("L",) in dom_specials and date.day == last)
+    if not dom_ok:
+        return False
+    if dow_any or cron_dow in dow_values:
+        return True
+    for special in dow_specials:
+        if special[0] == "NL" and special[1] == cron_dow and date.day + 7 > last:
+            return True
+        if special[0] == "#" and special[1] == cron_dow and (date.day - 1) // 7 + 1 == special[2]:
+            return True
+    return False
+
 
