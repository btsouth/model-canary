 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+# index: (minimum, maximum, names)
+_SPECS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = datetime.timedelta(days=20 * 365)
+
+
+def _value(text, index):
+    low, high, names = _SPECS[index]
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+        if not low <= value <= high:
+            raise ValueError(f"value out of range: {text!r}")
+        return value
+    if names and _NAME.fullmatch(text) and text.upper() in names:
+        return names[text.upper()]
+    raise ValueError(f"bad value: {text!r}")
+
+
+def _field(text, index):
+    """Parse one field into (values, last, last_dows, nth_dows)."""
+    low, high, _ = _SPECS[index]
+    values, last, last_dows, nth_dows = set(), False, set(), set()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' outside the day fields")
+        text = "*"
+    for item in text.split(","):
+        if index == _DOM and item == "L":
+            last = True
+            continue
+        if index == _DOW:
+            found = _LAST_DOW.fullmatch(item)
+            if found:
+                day = int(found.group(1))
+                if day > 7:
+                    raise ValueError(f"bad day: {item!r}")
+                last_dows.add(day % 7)
+                continue
+            found = _NTH_DOW.fullmatch(item)
+            if found:
+                day, nth = int(found.group(1)), int(found.group(2))
+                if day > 7 or not 1 <= nth <= 5:
+                    raise ValueError(f"bad item: {item!r}")
+                nth_dows.add((day % 7, nth))
+                continue
+        base, slash, step = item.partition("/")
+        if slash:
+            if not _NUMBER.fullmatch(step) or int(step) < 1:
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step)
+        else:
+            step = 1
+        if base == "*":
+            listed = list(range(low, high + 1))
+        elif "-" in base:
+            first, _, second = base.partition("-")
+            first, second = _value(first, index), _value(second, index)
+            if first <= second:
+                listed = list(range(first, second + 1))
+            elif index == _DOW:
+                first %= 7
+                if first <= second:
+                    listed = list(range(first, second + 1))
+                else:
+                    listed = list(range(first, 7)) + list(range(0, second + 1))
+            else:
+                listed = list(range(first, high + 1)) + list(range(low, second + 1))
+        else:
+            first = _value(base, index)
+            listed = list(range(first, high + 1)) if slash else [first]
+        kept = listed[::step]
+        if index == _DOW:
+            kept = [v % 7 for v in kept]
+        values.update(kept)
+    return values, last, last_dows, nth_dows
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        expr = expr.strip()
+        if expr.startswith("@"):
+            if expr.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            expr = _SHORTCUTS[expr.lower()]
+        parts = re.split(r"[ \t]+", expr)
+        if len(parts) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        parsed = [_field(part, i) for i, part in enumerate(parts)]
+        self.minutes = sorted(parsed[0][0])
+        self.hours = sorted(parsed[1][0])
+        self.months = parsed[3][0]
+        self.doms, self.dom_last = parsed[_DOM][0], parsed[_DOM][1]
+        self.dows, _, self.last_dows, self.nth_dows = parsed[_DOW]
+
+    def day_ok(self, year, month, day, weekday, length):
+        """weekday is 0 for Sunday; length is the number of days in the month."""
+        if not (day in self.doms or (self.dom_last and day == length)):
+            return False
+        if weekday in self.dows:
+            return True
+        if weekday in self.last_dows and day + 7 > length:
+            return True
+        return (weekday, (day - 1) // 7 + 1) in self.nth_dows
+
+    def date_ok(self, date):
+        if date.month not in self.months:
+            return False
+        first, length = calendar.monthrange(date.year, date.month)
+        return self.day_ok(date.year, date.month, date.day, (date.weekday() + 1) % 7, length)
+
 
 def matches(expr, when):
