 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+from collections import namedtuple
+
+_MONTH_NAMES = {"JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+                "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12}
+_DAY_NAMES = {"SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+# kind names the field; lo and hi are its allowed values; names maps allowed names.
+_Field = namedtuple("_Field", "kind lo hi names")
+_MINUTE = _Field("minute", 0, 59, {})
+_HOUR = _Field("hour", 0, 23, {})
+_DOM = _Field("dom", 1, 31, {})
+_MONTH = _Field("month", 1, 12, _MONTH_NAMES)
+_DOW = _Field("dow", 0, 7, _DAY_NAMES)
+
+_SHORTCUT = re.compile(r"@[A-Za-z]+")
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+# A parsed expression. days and last_day come from the day-of-month field; weekdays
+# (0-6, Sunday is 0) and nth come from day-of-week. nth holds (weekday, K) pairs for
+# N#K, and (weekday, 0) for NL, the last such weekday of the month.
+_Schedule = namedtuple("_Schedule", "minutes hours days last_day months weekdays nth")
+
+
+def _value(text, f):
+    """One number or name from field f."""
+    if _NUMBER.fullmatch(text):
+        value = int(text)
+        if f.lo <= value <= f.hi:
+            return value
+    elif _NAME.fullmatch(text) and text.upper() in f.names:
+        return f.names[text.upper()]
+    raise ValueError(f"bad {f.kind} value {text!r}")
+
+
+def _bounded(digits, lo, hi, item):
+    """A plain number from digits, which must lie in lo to hi."""
+    value = int(digits)
+    if not lo <= value <= hi:
+        raise ValueError(f"value out of range in {item!r}")
+    return value
+
+
+def _split_step(item):
+    """Split an item into (base, step); step is None when there is no /S."""
+    base, slash, step_text = item.partition("/")
+    if not slash:
+        return base, None
+    if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+        raise ValueError(f"bad step in {item!r}")
+    return base, int(step_text)
+
+
+def _no_step(item, step):
+    if step is not None:
+        raise ValueError(f"a step cannot follow {item!r}")
+
+
+def _span(base, step, f):
+    """The values one item lists, in order, after its step is applied."""
+    if base == "*":
+        values = list(range(f.lo, f.hi + 1))
+    elif "-" in base:
+        low_text, _, high_text = base.partition("-")
+        low, high = _value(low_text, f), _value(high_text, f)
+        if low <= high:
+            values = list(range(low, high + 1))
+        else:
+            # Wraps around. A day-of-week range counts through 0 to 6 (7 is Sunday,
+            # the same as 0), so it never runs past 6 before wrapping.
+            top = 6 if f.kind == "dow" else f.hi
+            values = list(range(low, top + 1)) + list(range(f.lo, high + 1))
+    else:
+        value = _value(base, f)
+        values = list(range(value, f.hi + 1)) if step is not None else [value]
+    return values[::step] if step is not None else values
+
+
+def _field(text, f):
+    """Parse one field into (values, last_day, nth)."""
+    values, nth, last_day = set(), set(), False
+    if text == "?" and f.kind in ("dom", "dow"):
+        text = "*"
+    for item in text.split(","):
+        base, step = _split_step(item)
+        if f.kind == "dom" and base == "L":
+            _no_step(item, step)
+            last_day = True
+            continue
+        if f.kind == "dow":
+            match = _LAST_WEEKDAY.fullmatch(base)
+            if match:
+                _no_step(item, step)
+                nth.add((_bounded(match.group(1), 0, 7, item) % 7, 0))
+                continue
+            match = _NTH_WEEKDAY.fullmatch(base)
+            if match:
+                _no_step(item, step)
+                weekday = _bounded(match.group(1), 0, 7, item) % 7
+                nth.add((weekday, _bounded(match.group(2), 1, 5, item)))
+                continue
+        for value in _span(base, step, f):
+            values.add(value % 7 if f.kind == "dow" else value)
+    return values, last_day, nth
+
+
+def _parse(expr):
+    """Parse a whole expression into a _Schedule, or raise ValueError."""
+    text = expr.strip()
+    if text.startswith("@"):
+        if not _SHORTCUT.fullmatch(text) or text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected five fields in {expr!r}")
+    minutes, _, _ = _field(parts[0], _MINUTE)
+    hours, _, _ = _field(parts[1], _HOUR)
+    days, last_day, _ = _field(parts[2], _DOM)
+    months, _, _ = _field(parts[3], _MONTH)
+    weekdays, _, nth = _field(parts[4], _DOW)
+    return _Schedule(minutes, hours, days, last_day, months, weekdays, nth)
+
+
+def _day_ok(spec, day):
+    """True if the date day is allowed by both the day-of-month and day-of-week fields."""
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in spec.days or (spec.last_day and day.day == last)
+    weekday = (day.weekday() + 1) % 7
+    week = (day.day - 1) // 7 + 1
+    dow_ok = (weekday in spec.weekdays
+              or (weekday, week) in spec.nth
+              or ((weekday, 0) in spec.nth and day.day + 7 > last))
+    return dom_ok and dow_ok
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    return (when.minute in spec.minutes and when.hour in spec.hours
+            and when.month in spec.months and _day_ok(spec, when.date()))
 
 
