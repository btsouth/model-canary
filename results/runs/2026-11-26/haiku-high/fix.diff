     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    spec = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + dt.timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + dt.timedelta(days=20 * 365)
+    except OverflowError:
+        limit = dt.datetime.max
+    hours, minutes = sorted(spec.hours), sorted(spec.minutes)
+    day = start.date()
+    # Walk day by day, which is cheap even when nothing matches: the limit is 20 years.
+    while day <= limit.date():
+        if day.month in spec.months and _day_ok(spec, day):
+            for hour in hours:
+                for minute in minutes:
+                    run = dt.datetime(day.year, day.month, day.day, hour, minute)
+                    if run < start:
+                        continue
+                    return run if run <= limit else None
+        if day == dt.date.max:
+            break
+        day += dt.timedelta(days=1)
+    return None
