@@ -1,11 +1,190 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import date, datetime, time, timedelta
+
+_LIMIT = timedelta(days=20 * 365)
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAY_NAMES = {n: i for i, n in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+
+# (name, lowest value, highest value, names allowed in the field)
+_MINUTE = ("minute", 0, 59, {})
+_HOUR = ("hour", 0, 23, {})
+_DOM = ("day of month", 1, 31, {})
+_MONTH = ("month", 1, 12, _MONTH_NAMES)
+_DOW = ("day of week", 0, 7, _DAY_NAMES)
+
+_NUM = re.compile(r"[0-9]+")
+_LAST_DAY = re.compile(r"([0-9]+)L")       # NL, day-of-week field only
+_NTH_DAY = re.compile(r"([0-9]+)#([0-9]+)")  # N#K, day-of-week field only
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, dom, dom_last, months, dow, dow_last, dow_nth):
+        self.minutes = minutes
+        self.hours = hours
+        self.dom = dom            # allowed days of month
+        self.dom_last = dom_last  # True if L (last day of month) is listed
+        self.months = months
+        self.dow = dow            # allowed weekdays, 0 = Sunday .. 6 = Saturday
+        self.dow_last = dow_last  # weekdays that match as the last one in the month
+        self.dow_nth = dow_nth    # (weekday, K) pairs: the K-th such weekday
+        self.times = sorted((h, m) for h in hours for m in minutes)
+
+
+def _value(tok, field):
+    name, lo, hi, names = field
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        raise ValueError(f"bad {name} value: {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"{name} value out of range: {tok!r}")
+    return v
+
+
+def _listed(item, field):
+    """The values of a plain item (*, N, A-B, optionally with /S), in order."""
+    name, lo, hi, _ = field
+    base, slash, step = item.partition("/")
+    if slash:
+        if not _NUM.fullmatch(step) or int(step) < 1:
+            raise ValueError(f"bad step: {item!r}")
+    if base == "*":
+        seq = list(range(lo, hi + 1))
+    elif "-" in base:
+        a, _, b = base.partition("-")
+        start, end = _value(a, field), _value(b, field)
+        if start <= end:
+            seq = list(range(start, end + 1))
+        elif name == "day of week":
+            seq = list(range(start, 7)) + list(range(0, end + 1))
+        else:
+            seq = list(range(start, hi + 1)) + list(range(lo, end + 1))
+    else:
+        v = _value(base, field)
+        seq = list(range(v, hi + 1)) if slash else [v]
+    return seq[::int(step)] if slash else seq
+
+
+def _field(text, field):
+    """Return (values, lasts, nths) for one field.
+
+    values: plain values (weekdays are reduced mod 7).
+    lasts: for day of month, the string "L" if listed; for day of week, the weekdays
+        listed as NL.
+    nths: for day of week, (weekday, K) pairs from N#K.
+    """
+    name, lo, hi, _ = field
+    is_dom = field is _DOM
+    is_dow = field is _DOW
+    if text == "?":
+        if not (is_dom or is_dow):
+            raise ValueError(f"'?' is not allowed in the {name} field")
+        text = "*"
+    values, lasts, nths = set(), set(), set()
+    for item in text.split(","):
+        if is_dom and item == "L":
+            lasts.add("L")
+        elif is_dow and _LAST_DAY.fullmatch(item):
+            n = int(_LAST_DAY.fullmatch(item).group(1))
+            if n > 7:
+                raise ValueError(f"bad day of week: {item!r}")
+            lasts.add(n % 7)
+        elif is_dow and _NTH_DAY.fullmatch(item):
+            n, k = (int(g) for g in _NTH_DAY.fullmatch(item).groups())
+            if n > 7 or not 1 <= k <= 5:
+                raise ValueError(f"bad day of week: {item!r}")
+            nths.add((n % 7, k))
+        else:
+            for v in _listed(item, field):
+                values.add(v % 7 if is_dow else v)
+    return values, lasts, nths
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be a string")
+    text = expr.strip(" \t")
+    if text.startswith("@"):
+        key = text.lower()
+        if key not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[key]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minutes, _, _ = _field(parts[0], _MINUTE)
+    hours, _, _ = _field(parts[1], _HOUR)
+    dom, dom_lasts, _ = _field(parts[2], _DOM)
+    months, _, _ = _field(parts[3], _MONTH)
+    dow, dow_lasts, dow_nth = _field(parts[4], _DOW)
+    return _Schedule(
+        minutes, hours,
+        dom, "L" in dom_lasts,
+        months,
+        dow, dow_lasts, dow_nth,
+    )
+
+
+def _day_ok(p, d):
+    if d.month not in p.months:
+        return False
+    dim = calendar.monthrange(d.year, d.month)[1]
+    if d.day not in p.dom and not (p.dom_last and d.day == dim):
+        return False
+    wd = (d.weekday() + 1) % 7  # Python: Monday = 0; cron: Sunday = 0
+    nth = (d.day - 1) // 7 + 1
+    return (
+        wd in p.dow
+        or (wd in p.dow_last and d.day + 7 > dim)
+        or (wd, nth) in p.dow_nth
+    )
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    p = _parse(expr)
+    return when.hour in p.hours and when.minute in p.minutes and _day_ok(p, when.date())
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    p = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _LIMIT
+    except OverflowError:
+        limit = datetime.max
+    first = start.date()
+    for o in range(first.toordinal(), limit.date().toordinal() + 1):
+        d = date.fromordinal(o)
+        if not _day_ok(p, d):
+            continue
+        low = (start.hour, start.minute) if d == first else (0, 0)
+        i = bisect_left(p.times, low)
+        if i == len(p.times):
+            continue
+        h, m = p.times[i]
+        run = datetime.combine(d, time(h, m))
+        return run if run <= limit else None
+    return None
