 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+
+_MONTHS = {name: i for i, name in enumerate(
+    ("", "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC")
+) if name}
+_DAYS = {name: i for i, name in enumerate(("MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"))}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    source = expr.strip()
+    if source.startswith("@"):
+        try:
+            source = _SHORTCUTS[source.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", source) if source else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    minute = _field(fields[0], 0, 59)
+    hour = _field(fields[1], 0, 23)
+    dom = _day_field(fields[2], "dom", 1, 31)
+    month = _field(fields[3], 1, 12, _MONTHS)
+    dow = _day_field(fields[4], "dow", 0, 7, _DAYS)
+    return minute, hour, dom, month, dow
+
+
+def _field(text, low, high, names=None):
+    values = set()
+    if not text:
+        raise ValueError("empty schedule field")
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if item.count("/") > 1:
+            raise ValueError("bad step")
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not re.fullmatch(r"\d+", step_text) or int(step_text) < 1:
+                raise ValueError("bad step")
+            step = int(step_text)
+        else:
+            step = 1
+        if base == "*":
+            seq = list(range(low, high + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("bad range")
+            left, right = base.split("-")
+            start = _number(left, low, high, names)
+            end = _number(right, low, high, names)
+            if low == 0 and high == 7:
+                start %= 7
+                end %= 7
+                seq = [start]
+                while seq[-1] != end:
+                    seq.append((seq[-1] + 1) % 7)
+            elif start <= end:
+                seq = list(range(start, end + 1))
+            else:
+                seq = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _number(base, low, high, names)
+            seq = list(range(start, high + 1)) if slash else [start]
+        values.update(seq[::step])
+    return frozenset(values)
+
+
+def _number(token, low, high, names=None):
+    if names and token.upper() in names:
+        value = names[token.upper()]
+    elif re.fullmatch(r"\d+", token):
+        value = int(token)
+    else:
+        raise ValueError("bad schedule value")
+    if not low <= value <= high:
+        raise ValueError("schedule value out of range")
+    return value
+
+
+def _day_field(text, kind, low, high, names=None):
+    if text == "?":
+        text = "*"
+    rules = []
+    for item in text.split(","):
+        if kind == "dom" and item == "L":
+            rules.append(("last",))
+        elif kind == "dow" and (m := re.fullmatch(r"(\d+)L", item)):
+            n = int(m.group(1))
+            if not 0 <= n <= 7:
+                raise ValueError("day of week out of range")
+            rules.append(("last_dow", n % 7))
+        elif kind == "dow" and (m := re.fullmatch(r"(\d+)#([1-5])", item)):
+            n = int(m.group(1))
+            if not 0 <= n <= 7:
+                raise ValueError("day of week out of range")
+            rules.append(("nth_dow", n % 7, int(m.group(2))))
+        else:
+            values = _field(item, low, high, names)
+            if kind == "dow" and 7 in values:
+                values = frozenset((values - {7}) | {0})
+            rules.append(("set", values))
+    return ("rules", tuple(rules))
+
+
+def _day_matches(dom, dow, date):
+    last = calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dom_ok = any(rule[0] == "last" and date.day == last or
+                 rule[0] == "set" and date.day in rule[1] for rule in dom[1])
+    dow_ok = any(
+        rule[0] == "set" and weekday in rule[1] or
+        rule[0] == "last_dow" and weekday == rule[1] and date.day + 7 > last or
+        rule[0] == "nth_dow" and weekday == rule[1] and (date.day - 1) // 7 + 1 == rule[2]
+        for rule in dow[1]
+    )
+    return dom_ok and dow_ok
 
 
