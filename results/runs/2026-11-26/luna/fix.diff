 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
+
+_SHORT = {"@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+          "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+          "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+          "@hourly": "0 * * * *"}
+_MONTHS = {n.upper(): i for i, n in enumerate(calendar.month_abbr) if n}
+_DAYS = {n.upper(): i for i, n in enumerate(calendar.day_abbr)}
+
+
+def _field(src, lo, hi, kind):
+    src = src.upper()
+    if kind in ('dom', 'dow') and src == '?':
+        src = '*'
+    if kind in ('dom', 'dow') and src == '*':
+        return set(range(lo, hi + 1)), True, []
+    values, specials = set(), []
+    for item in src.split(','):
+        if not item:
+            raise ValueError('empty item')
+        if kind == 'dom' and item == 'L':
+            specials.append(('last',)); continue
+        if kind == 'dow' and re.fullmatch(r'[0-7]L', item):
+            specials.append(('dowlast', int(item[:-1]) % 7)); continue
+        if kind == 'dow' and re.fullmatch(r'[0-7]#[1-5]', item):
+            a, b = item.split('#'); specials.append(('nth', int(a) % 7, int(b))); continue
+        if 'L' in item or '#' in item:
+            raise ValueError('bad special')
+        bits = item.split('/')
+        if len(bits) > 2 or (len(bits) == 2 and (not bits[1].isdigit() or int(bits[1]) < 1)):
+            raise ValueError('bad step')
+        if len(bits) == 2 and kind in ('month', 'dow'):
+            names = _MONTHS if kind == 'month' else _DAYS
+            if any(re.search(r'[A-Z]', part) for part in bits[0].split('-')):
+                raise ValueError('names cannot be stepped')
+        step = int(bits[1]) if len(bits) == 2 else 1
+        base = bits[0]
+        def val(x):
+            if kind in ('month', 'dow') and x in (_MONTHS if kind == 'month' else _DAYS):
+                return (_MONTHS if kind == 'month' else _DAYS)[x]
+            if not x.isdigit(): raise ValueError('bad value')
+            return int(x)
+        if base == '*':
+            seq = list(range(lo, hi + 1))
+        elif '-' in base:
+            if base.count('-') != 1: raise ValueError('bad range')
+            a, b = map(val, base.split('-'))
+            if not lo <= a <= hi or not lo <= b <= hi: raise ValueError('out of range')
+            if kind == 'dow':
+                a %= 7; b %= 7
+                seq = list(range(a, b + 1)) if a <= b else list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, b + 1)) if a <= b else list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = val(base)
+            if not lo <= a <= hi: raise ValueError('out of range')
+            original = a
+            if kind == 'dow': a %= 7
+            seq = list(range(original, hi + 1)) if len(bits) == 2 else [a]
+            if kind == 'dow' and len(bits) == 2:
+                seq = [x % 7 for x in seq]
+        values.update(seq[::step])
+    return values, False, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str): raise ValueError('bad expression')
+    e = expr.strip().lower()
+    if e.startswith('@'):
+        if e not in _SHORT: raise ValueError('unknown shortcut')
+        e = _SHORT[e]
+    fields = re.split(r'[ \t]+', e)
+    if len(fields) != 5: raise ValueError('expected five fields')
+    return (_field(fields[0], 0, 59, 'minute'), _field(fields[1], 0, 23, 'hour'),
+            _field(fields[2], 1, 31, 'dom'), _field(fields[3], 1, 12, 'month'),
+            _field(fields[4], 0, 7, 'dow'))
+
+
+def _day_ok(day, dom, dow):
+    dv, _, ds = dom; wv, _, ws = dow
+    a = day.day in dv or any(s[0] == 'last' and day.day == calendar.monthrange(day.year, day.month)[1] for s in ds)
+    weekday = (day.weekday() + 1) % 7
