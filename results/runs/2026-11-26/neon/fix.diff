 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import datetime
+import re
+from dataclasses import dataclass
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    "JAN": 1,
+    "FEB": 2,
+    "MAR": 3,
+    "APR": 4,
+    "MAY": 5,
+    "JUN": 6,
+    "JUL": 7,
+    "AUG": 8,
+    "SEP": 9,
+    "OCT": 10,
+    "NOV": 11,
+    "DEC": 12,
+}
+
+_DOW_NAMES = {
+    "SUN": 0,
+    "MON": 1,
+    "TUE": 2,
+    "WED": 3,
+    "THU": 4,
+    "FRI": 5,
+    "SAT": 6,
+}
+
+_DIGITS = re.compile(r"^[0-9]+$")
+_DOW_LAST = re.compile(r"^([0-9]+)L$")
+_DOW_NTH = re.compile(r"^([0-9]+)#([0-9]+)$")
+_SEP = re.compile(r"[ \t]+")
+
+
+@dataclass(frozen=True)
+class _Schedule:
+    minutes: tuple[int, ...]
+    minutes_set: frozenset[int]
+    hours: tuple[int, ...]
+    hours_set: frozenset[int]
+    months: tuple[int, ...]
+    months_set: frozenset[int]
+    dom_days: frozenset[int]
+    dom_last: bool
+    dow_days: frozenset[int]
+    dow_last: frozenset[int]
+    dow_nth: frozenset[tuple[int, int]]
+
+
+def _parse_value(token, min_val, max_val, names):
+    if _DIGITS.fullmatch(token):
+        val = int(token)
+        if min_val <= val <= max_val:
+            return val
+        raise ValueError(f"value {val} out of range {min_val}-{max_val}")
+    if names is not None:
+        upper = token.upper()
+        if upper in names:
+            return names[upper]
+    raise ValueError(f"invalid value: {token!r}")
+
+
+def _parse_standard_item(item, min_val, max_val, names, is_dow):
+    if "/" in item:
+        parts = item.split("/")
+        if len(parts) != 2:
+            raise ValueError(f"invalid step syntax: {item!r}")
+        base, step_str = parts
+        if not _DIGITS.fullmatch(step_str):
+            raise ValueError(f"invalid step: {step_str!r}")
+        step = int(step_str)
+        if step < 1:
+            raise ValueError(f"step must be >= 1: {step}")
+        has_step = True
+    else:
+        base = item
+        step = 1
+        has_step = False
+
+    if not base:
+        raise ValueError(f"empty item: {item!r}")
+
+    if base == "*":
+        vals = list(range(0, 7)) if is_dow else list(range(min_val, max_val + 1))
+    elif "-" in base:
+        bounds = base.split("-")
+        if len(bounds) != 2:
+            raise ValueError(f"invalid range: {base!r}")
+        a = _parse_value(bounds[0], min_val, max_val, names)
+        b = _parse_value(bounds[1], min_val, max_val, names)
+        if is_dow:
+            if a <= b:
+                vals = [v % 7 for v in range(a, b + 1)]
+            else:
+                a %= 7
+                b %= 7
+                if a <= b:
+                    vals = list(range(a, b + 1))
+                else:
+                    vals = list(range(a, 7)) + list(range(0, b + 1))
+        else:
+            if a <= b:
+                vals = list(range(a, b + 1))
+            else:
+                vals = list(range(a, max_val + 1)) + list(range(min_val, b + 1))
+    else:
+        v = _parse_value(base, min_val, max_val, names)
+        if has_step:
+            if is_dow:
+                vals = list(range(v % 7, 7))
+            else:
+                vals = list(range(v, max_val + 1))
+        else:
+            vals = [v % 7] if is_dow else [v]
+
+    return vals[::step]
+
+
+def _parse_simple_field(field, min_val, max_val, names=None):
+    items = field.split(",")
+    result = set()
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in field: {field!r}")
+        result.update(_parse_standard_item(item, min_val, max_val, names, is_dow=False))
+    return result
+
+
+def _parse_dom_field(field):
+    if field == "?":
+        return frozenset(range(1, 32)), False
+    items = field.split(",")
+    days = set()
+    has_last = False
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in dom field: {field!r}")
+        if item == "L":
+            has_last = True
+        else:
+            days.update(_parse_standard_item(item, 1, 31, None, is_dow=False))
+    return frozenset(days), has_last
+
+
+def _parse_dow_field(field):
+    if field == "?":
+        return frozenset(range(0, 7)), frozenset(), frozenset()
+    items = field.split(",")
+    days = set()
+    last_dows = set()
+    nth_dows = set()
+    for item in items:
+        if not item:
+            raise ValueError(f"empty item in dow field: {field!r}")
+        m_last = _DOW_LAST.fullmatch(item)
+        if m_last:
+            d = int(m_last.group(1))
+            if not (0 <= d <= 7):
+                raise ValueError(f"day of week out of range: {item!r}")
+            last_dows.add(d % 7)
+            continue
+        m_nth = _DOW_NTH.fullmatch(item)
+        if m_nth:
+            d = int(m_nth.group(1))
+            k = int(m_nth.group(2))
+            if not (0 <= d <= 7) or not (1 <= k <= 5):
+                raise ValueError(f"invalid nth day of week: {item!r}")
+            nth_dows.add((d % 7, k))
+            continue
+        days.update(_parse_standard_item(item, 0, 7, _DOW_NAMES, is_dow=True))
+    return frozenset(days), frozenset(last_dows), frozenset(nth_dows)
+
+
+def _parse_expr(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    s = expr.strip()
+    if not s:
+        raise ValueError("empty schedule expression")
+    lower = s.lower()
+    if lower in _SHORTCUTS:
+        s = _SHORTCUTS[lower]
+    elif s.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    parts = _SEP.split(s)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields, got {len(parts)}: {expr!r}")
+
+    min_set = _parse_simple_field(parts[0], 0, 59)
+    hour_set = _parse_simple_field(parts[1], 0, 23)
+    dom_days, dom_last = _parse_dom_field(parts[2])
+    month_set = _parse_simple_field(parts[3], 1, 12, _MONTH_NAMES)
+    dow_days, dow_last, dow_nth = _parse_dow_field(parts[4])
+
+    return _Schedule(
+        minutes=tuple(sorted(min_set)),
+        minutes_set=frozenset(min_set),
+        hours=tuple(sorted(hour_set)),
+        hours_set=frozenset(hour_set),
+        months=tuple(sorted(month_set)),
+        months_set=frozenset(month_set),
+        dom_days=dom_days,
+        dom_last=dom_last,
+        dow_days=dow_days,
+        dow_last=dow_last,
+        dow_nth=dow_nth,
+    )
+
+
+def _day_matches(sched, year, month, day, last_day=None):
+    if last_day is None:
+        last_day = calendar.monthrange(year, month)[1]
+    if day not in sched.dom_days and not (sched.dom_last and day == last_day):
+        return False
+    cron_dow = (datetime.date(year, month, day).weekday() + 1) % 7
+    if cron_dow in sched.dow_days:
+        return True
+    if cron_dow in sched.dow_last and day + 7 > last_day:
+        return True
+    if sched.dow_nth and (cron_dow, (day - 1) // 7 + 1) in sched.dow_nth:
+        return True
+    return False
+
 
