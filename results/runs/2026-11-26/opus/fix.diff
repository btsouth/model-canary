 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (minimum, maximum, names mapping or None)
+_MINUTE = (0, 59, None)
+_HOUR = (0, 23, None)
+_DOM = (1, 31, None)
+_MONTH = (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)})
+_DOW = (0, 7, {name: i for i, name in enumerate(_DAYS)})
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_FIELD_SPLIT = re.compile(r"[ \t]+")
+
+_SEARCH_DAYS = 20 * 365
+
+
+def _bad(msg):
+    raise ValueError(msg)
+
+
+def _number(text, lo, hi):
+    if not _NUMBER.fullmatch(text):
+        _bad(f"bad number: {text!r}")
+    value = int(text)
+    if not lo <= value <= hi:
+        _bad(f"value {value} out of range {lo}-{hi}")
+    return value
+
+
+def _value(text, spec):
+    lo, hi, names = spec
+    if names is not None and _NAME.fullmatch(text):
+        upper = text.upper()
+        if upper not in names:
+            _bad(f"unknown name: {text!r}")
+        return names[upper]
+    return _number(text, lo, hi)
+
+
+def _range_values(text, spec, is_dow):
+    """The values an item lists (without a step), in order."""
+    lo, hi, _ = spec
+    if text == "*":
+        return list(range(lo, 7 if is_dow else hi + 1))
+    if "-" in text:
+        a_text, b_text = text.split("-", 1)
+        a = _value(a_text, spec)
+        b = _value(b_text, spec)
+        if a <= b:
+            return list(range(a, b + 1))
+        if is_dow:
+            a, b = a % 7, b % 7
+            out = [a]
+            while out[-1] != b:
+                out.append((out[-1] + 1) % 7)
+            return out
+        return list(range(a, hi + 1)) + list(range(lo, b + 1))
+    return None
+
+
+class _Field:
+    def __init__(self):
+        self.star = False
+        self.values = set()
+        self.last = False          # day of month: L
+        self.last_dow = set()      # day of week: NL
+        self.nth_dow = set()       # day of week: (N, K)
+
+
+def _parse_field(text, spec, kind):
+    field = _Field()
+    is_dow = kind == "dow"
+    if text == "?":
+        if kind not in ("dom", "dow"):
+            _bad("'?' is only allowed in the day fields")
+        field.star = True
+        return field
+    if text == "*":
+        field.star = True
+    for item in text.split(","):
+        if not item:
+            _bad(f"empty item in {text!r}")
+        if kind == "dom" and item == "L":
+            field.last = True
+            continue
+        if is_dow:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                field.last_dow.add(_number(m.group(1), 0, 7) % 7)
+                continue
+            m = _NTH_DOW.fullmatch(item)
+            if m:
+                n = _number(m.group(1), 0, 7) % 7
+                k = _number(m.group(2), 1, 5)
+                field.nth_dow.add((n, k))
+                continue
+        if "/" in item:
+            base, step_text = item.split("/", 1)
+            if not _NUMBER.fullmatch(step_text):
+                _bad(f"bad step: {step_text!r}")
+            step = int(step_text)
+            if step < 1:
+                _bad("step must be at least 1")
+            values = _range_values(base, spec, is_dow)
+            if values is None:
+                start = _value(base, spec)
+                values = list(range(start, spec[1] + 1))
+            values = values[::step]
+        else:
+            values = _range_values(item, spec, is_dow)
+            if values is None:
+                values = [_value(item, spec)]
+        if is_dow:
+            values = [v % 7 for v in values]
+        field.values.update(values)
+    return field
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            _bad("expression must be a string")
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                _bad(f"unknown shortcut: {expr!r}")
+            text = _SHORTCUTS[text.lower()]
+        parts = _FIELD_SPLIT.split(text)
+        if len(parts) != 5:
+            _bad(f"expected 5 fields: {expr!r}")
+        minute, hour, dom, month, dow = parts
+        self.minutes = sorted(_parse_field(minute, _MINUTE, "minute").values)
+        self.hours = sorted(_parse_field(hour, _HOUR, "hour").values)
+        self.dom = _parse_field(dom, _DOM, "dom")
+        self.months = _parse_field(month, _MONTH, "month").values
+        self.dow = _parse_field(dow, _DOW, "dow")
+        self.minute_set = set(self.minutes)
+        self.hour_set = set(self.hours)
+
+    def day_allowed(self, date):
+        last_day = calendar.monthrange(date.year, date.month)[1]
+        dom = self.dom
+        if not dom.star:
+            if not (date.day in dom.values or (dom.last and date.day == last_day)):
+                return False
+        dow = self.dow
+        if not dow.star:
+            wd = (date.weekday() + 1) % 7
+            ok = (wd in dow.values
+                  or (wd in dow.last_dow and date.day + 7 > last_day)
+                  or (wd, (date.day - 1) // 7 + 1) in dow.nth_dow)
+            if not ok:
+                return False
+        return True
+
+    def matches(self, when):
+        return (when.minute in self.minute_set
+                and when.hour in self.hour_set
+                and when.month in self.months
+                and self.day_allowed(when.date()))
+
+    def first_time(self, hour, minute):
+        """First (hour, minute) run on a day at or after hour:minute, or None."""
+        for h in self.hours:
+            if h < hour:
+                continue
+            for m in self.minutes:
+                if h > hour or m >= minute:
+                    return h, m
+        return None
 
 
