 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_right
+from datetime import date, datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_WEEKDAYS = {name: i for i, name in enumerate(
+    "SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"invalid number: {token!r}")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _WEEKDAYS if index == 4 else {}
+    values, special = set(), []
+
+    def value(token):
+        number = names[token] if token in names else _number(token)
+        if not low <= number <= high:
+            raise ValueError(f"value out of range: {token!r}")
+        return number
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if item == "L" and index == 2:
+            special.append(("last",))
+            continue
+        last = re.fullmatch(r"([0-9]+)L", item)
+        nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if index == 4 and (last or nth):
+            match = last or nth
+            weekday = value(match[1]) % 7
+            if last:
+                special.append(("last", weekday))
+            else:
+                occurrence = _number(match[2])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence out of range")
+                special.append(("nth", weekday, occurrence))
+            continue
+
+        parts = item.split("/")
+        if len(parts) > 2:
+            raise ValueError(f"invalid item: {item!r}")
+        base = parts[0]
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(value, ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            elif index == 4:
+                # Sunday has one position in a wrapping weekday range.
+                start, end = start % 7, end % 7
+                sequence = [start]
+                while sequence[-1] != end:
+                    sequence.append((sequence[-1] + 1) % 7)
+            else:
+                sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = value(base)
+            sequence = list(range(start, high + 1)) if len(parts) == 2 else [start]
+        values.update(n % 7 if index == 4 else n for n in sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    expression = expr.strip().upper()
+    if expression.startswith("@"):
+        try:
+            expression = _SHORTCUTS[expression.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expression)
+    if len(fields) != 5:
+        raise ValueError("a schedule must have five fields")
+    return [_field(text, index) for index, text in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    if day.month not in fields[3][0]:
+        return False
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_values, dom_special = fields[2]
+    if day.day not in dom_values and not (dom_special and day.day == last):
+        return False
+    weekday = (day.weekday() + 1) % 7
+    dow_values, dow_special = fields[4]
+    if weekday in dow_values:
+        return True
+    for special in dow_special:
+        if weekday != special[1]:
+            continue
+        if special[0] == "last" and day.day + 7 > last:
+            return True
+        if special[0] == "nth" and (day.day - 1) // 7 + 1 == special[2]:
+            return True
+    return False
+
 
