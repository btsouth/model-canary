 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import date, datetime, timedelta
+
+
+_MONTHS = {
+    name: number
+    for number, name in enumerate("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)
+}
+_WEEKDAYS = {name: number for number, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DECIMAL = re.compile(r"[0-9]+")
+_HORIZON = timedelta(days=20 * 365)
+
+
+def _value(token, minimum, maximum, names=None):
+    if _DECIMAL.fullmatch(token):
+        number = int(token.lstrip("0") or "0")
+    elif names is not None and token.isascii() and token.upper() in names:
+        number = names[token.upper()]
+    else:
+        raise ValueError(f"invalid schedule value: {token!r}")
+    if not minimum <= number <= maximum:
+        raise ValueError(f"schedule value out of range: {token!r}")
+    return number
+
+
+def _field(text, minimum, maximum, names=None, *, month_day=False, week_day=False):
+    if text == "?" and (month_day or week_day):
+        text = "*"
+
+    values = set()
+    for item in text.split(","):
+        if month_day and item == "L":
+            values.add("L")
+            continue
+        if week_day and item.endswith("L"):
+            values.add((_value(item[:-1], 0, 7) % 7, 0))
+            continue
+        if week_day and "#" in item:
+            weekday, _, occurrence = item.partition("#")
+            values.add((_value(weekday, 0, 7) % 7, _value(occurrence, 1, 5)))
+            continue
+
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            digits = step_text.lstrip("0")
+            if not _DECIMAL.fullmatch(step_text) or not digits:
+                raise ValueError(f"invalid schedule step: {step_text!r}")
+            # A step of 60 or more keeps only the first value of any item.
+            step = int(digits) if len(digits) <= 2 else 60
+
+        if base == "*":
+            sequence = range(minimum, maximum + 1)
+        else:
+            first, dash, last = base.partition("-")
+            start = _value(first, minimum, maximum, names)
+            if dash:
+                end = _value(last, minimum, maximum, names)
+                if start <= end:
+                    sequence = range(start, end + 1)
+                else:
+                    wrap_stop = 7 if week_day else maximum + 1
+                    sequence = list(range(start, wrap_stop)) + list(range(minimum, end + 1))
+            else:
+                stop = maximum + 1 if slash else start + 1
+                sequence = range(start, stop)
+
+        selected = sequence[::step]
+        if week_day:
+            selected = (value % 7 for value in selected)
+        values.update(selected)
+    return values
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    expr = expr.strip()
+    if expr.isascii():
+        expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule expression must have five fields")
+    minute, hour, month_day, month, week_day = fields
+    return (
+        _field(minute, 0, 59),
+        _field(hour, 0, 23),
+        _field(month_day, 1, 31, month_day=True),
+        _field(month, 1, 12, _MONTHS),
+        _field(week_day, 0, 7, _WEEKDAYS, week_day=True),
+    )
+
+
+def _day_matches(day, month_days, week_days):
+    if day.day not in month_days:
+        if "L" not in month_days or day.day != monthrange(day.year, day.month)[1]:
+            return False
+    weekday = (day.weekday() + 1) % 7
+    occurrence = (day.day - 1) // 7 + 1
+    return (
+        weekday in week_days
+        or (weekday, occurrence) in week_days
+        or ((weekday, 0) in week_days and day.day + 7 > monthrange(day.year, day.month)[1])
+    )
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    minutes, hours, month_days, months, week_days = _parse(expr)
+    return (
+        when.minute in minutes
+        and when.hour in hours
+        and when.month in months
+        and _day_matches(when, month_days, week_days)
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    minutes, hours, month_days, months, week_days = _parse(expr)
+    run_minutes = sorted(hour * 60 + minute for hour in hours for minute in minutes)
+    first_day = after.toordinal()
+    last_day = min(first_day + _HORIZON.days, date.max.toordinal())
+    first_index = bisect_right(run_minutes, after.hour * 60 + after.minute)
+
+    for ordinal in range(first_day, last_day + 1):
+        index = first_index if ordinal == first_day else 0
+        if index == len(run_minutes):
+            continue
+        day = date.fromordinal(ordinal)
+        if day.month in months and _day_matches(day, month_days, week_days):
+            hour, minute = divmod(run_minutes[index], 60)
+            run = datetime(day.year, day.month, day.day, hour, minute)
+            return run if run - after <= _HORIZON else None
+    return None
