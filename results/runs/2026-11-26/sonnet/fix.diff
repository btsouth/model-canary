 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "jan feb mar apr may jun jul aug sep oct nov dec".split())}
+_DAYS = {n: i for i, n in enumerate("sun mon tue wed thu fri sat".split())}
+_NUM = re.compile(r"[0-9]+")
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.fullmatch(tok):
+        v = int(tok)
+    elif names and tok.lower() in names:
+        v = names[tok.lower()]
+    else:
+        raise ValueError(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        raise ValueError(f"value out of range: {tok!r}")
+    return v
+
+
+def _plain_item(item, lo, hi, names, dow):
+    """Values listed by a *, N, A-B item with optional /S, in order."""
+    base, sep, step = item.partition("/")
+    if sep:
+        if not _NUM.fullmatch(step) or int(step) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step)
+    if base == "*":
+        vals = list(range(lo, (6 if dow else hi) + 1))
+    elif "-" in base:
+        parts = base.split("-")
+        if len(parts) != 2:
+            raise ValueError(f"bad range {item!r}")
+        a = _value(parts[0], lo, hi, names)
+        b = _value(parts[1], lo, hi, names)
+        if a <= b:
+            vals = list(range(a, b + 1))
+        elif dow:
+            if a == 7:
+                a = 0
+            vals = (list(range(a, 7)) if a > b else []) + list(range(0, b + 1))
+            if a <= b:
+                vals = list(range(a, b + 1))
+        else:
+            vals = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        a = _value(base, lo, hi, names)
+        vals = list(range(a, hi + 1)) if sep else [a]
+    if sep:
+        vals = vals[::step]
+    if dow:
+        vals = [v % 7 for v in vals]
+    return vals
+
+
+def _parse_field(text, lo, hi, names, kind):
+    """Returns (values set, extras)."""
+    if kind in ("dom", "dow") and text == "?":
+        text = "*"
+    values = set()
+    last = False
+    last_dow = set()
+    nth = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if kind == "dom" and item == "L":
+            last = True
+        elif kind == "dow" and re.fullmatch(r"[0-9]+L", item):
+            last_dow.add(_value(item[:-1], 0, 7, None) % 7)
+        elif kind == "dow" and "#" in item:
+            n, _, k = item.partition("#")
+            if not _NUM.fullmatch(k) or not 1 <= int(k) <= 5:
+                raise ValueError(f"bad nth in {item!r}")
+            nth.add((_value(n, 0, 7, None) % 7, int(k)))
+        else:
+            values.update(_plain_item(item, lo, hi, names, kind == "dow"))
+    return values, last, last_dow, nth
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut {text!r}")
+        text = _SHORTCUTS[text.lower()]
+    toks = re.split(r"[ \t]+", text)
+    if len(toks) != 5:
+        raise ValueError("expected five fields")
+    minute = _parse_field(toks[0], 0, 59, None, "min")[0]
+    hour = _parse_field(toks[1], 0, 23, None, "hour")[0]
+    dom = _parse_field(toks[2], 1, 31, None, "dom")
+    month = _parse_field(toks[3], 1, 12, _MONTHS, "month")[0]
+    dow = _parse_field(toks[4], 0, 7, _DAYS, "dow")
+    return (sorted(minute), sorted(hour), dom, month, dow)
+
+
+def _day_ok(dom, dow, d):
+    dvals, last, _, _ = dom
+    if not (d.day in dvals or (last and d.day == calendar.monthrange(d.year, d.month)[1])):
+        return False
+    wvals, _, last_dow, nth = dow
+    wd = (d.weekday() + 1) % 7
+    if wd in wvals:
+        return True
+    if wd in last_dow and d.day + 7 > calendar.monthrange(d.year, d.month)[1]:
+        return True
+    return (wd, (d.day - 1) // 7 + 1) in nth
 
 
