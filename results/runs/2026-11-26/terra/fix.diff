 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        lo, hi = _LIMITS[index]
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+        def number(token):
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in names:
+                value = names[token.upper()]
+            else:
+                raise ValueError('invalid value')
+            if not lo <= value <= hi:
+                raise ValueError('value out of range')
+            return value
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'([0-7])L|([0-7])#([1-5])', item) if index == 4 else None
+            if match:
+                if match.group(1) is not None:
+                    special.append(('last_weekday', int(match.group(1)) % 7))
+                else:
+                    special.append(('nth', int(match.group(2)) % 7, int(match.group(3))))
+                continue
+            parts = item.split('/')
+            if len(parts) > 2 or not parts[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(parts) == 2:
+                if not re.fullmatch(r'[0-9]+', parts[1]) or int(parts[1]) < 1:
+                    raise ValueError('invalid step')
+                step = int(parts[1])
+            base = parts[0]
+            if base == '*':
+                sequence = list(range(lo, hi + 1))
+            elif '-' in base:
+                bounds = base.split('-')
+                if len(bounds) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, bounds)
+                if start <= end:
+                    sequence = list(range(start, end + 1))
+                elif index == 4:
+                    start, end = start % 7, end % 7
+                    sequence = (list(range(start, end + 1)) if start <= end else
+                                list(range(start, 7)) + list(range(0, end + 1)))
+                else:
+                    sequence = list(range(start, hi + 1)) + list(range(lo, end + 1))
+            else:
+                start = number(base)
+                sequence = list(range(start, hi + 1)) if len(parts) == 2 else [start]
+            values.update(x % 7 if index == 4 else x for x in sequence[::step])
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, date):
+    weekday = (date.weekday() + 1) % 7
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    return (date.day in dom or (('last',) in dom_special and date.day == last)) and (
+        weekday in dow or any(
+            (rule[0] == 'last_weekday' and weekday == rule[1] and date.day + 7 > last) or
+            (rule[0] == 'nth' and weekday == rule[1] and (date.day - 1) // 7 + 1 == rule[2])
+            for rule in dow_special))
 
 
