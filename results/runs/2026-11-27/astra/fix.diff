 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_DAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token):
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError("expected decimal digits")
+    return int(token)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+    values, special = set(), []
+
+    def value(token):
+        n = names[token] if token in names else _number(token)
+        if not low <= n <= high:
+            raise ValueError("value outside field range")
+        return n % 7 if index == 4 else n
+
+    if text == "?" and index in (2, 4):
+        text = "*"
+    maximum = 6 if index == 4 else high
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            special.append(("last",))
+            continue
+        if index == 4:
+            last = re.fullmatch(r"([0-9]+)L", item)
+            nth = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if last:
+                special.append(("last", value(last[1])))
+                continue
+            if nth:
+                k = _number(nth[2])
+                if not 1 <= k <= 5:
+                    raise ValueError("weekday occurrence outside range")
+                special.append(("nth", value(nth[1]), k))
+                continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError("invalid step")
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        base = pieces[0]
+        if base == "*":
+            sequence = list(range(low, maximum + 1))
+        elif "-" in base:
+            endpoints = base.split("-")
+            if len(endpoints) != 2:
+                raise ValueError("invalid range")
+            start, end = map(value, endpoints)
+            sequence = (list(range(start, end + 1)) if start <= end else
+                        list(range(start, maximum + 1)) + list(range(low, end + 1)))
+        else:
+            start = value(base)
+            sequence = list(range(start, maximum + 1)) if len(pieces) == 2 else [start]
+        values.update(sequence[::step])
+    return values, special
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("expected five schedule fields")
+    return [_field(part, i) for i, part in enumerate(parts)]
+
+
+def _day_matches(fields, day, last_day):
+    dom, dom_special = fields[2]
+    dow, dow_special = fields[4]
+    weekday = (day.weekday() + 1) % 7
+    if day.day not in dom and not (dom_special and day.day == last_day):
+        return False
+    return weekday in dow or any(
+        weekday == item[1] and
+        (day.day + 7 > last_day if item[0] == "last" else
+         (day.day - 1) // 7 + 1 == item[2])
+        for item in dow_special
+    )
+
 
