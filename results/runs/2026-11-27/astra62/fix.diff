 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import date, datetime
+
+_MONTHS = "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split()
+_WEEKDAYS = "SUN MON TUE WED THU FRI SAT".split()
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _number(token):
+    if not re.fullmatch("[0-9]+", token):
+        raise ValueError(f"invalid number: {token!r}")
+    # No field has more than 60 values, even for a step with many digits.
+    digits = token.lstrip("0")
+    return int(digits or "0") if len(digits) <= 2 else 100
+
+
+def _value(token, low, high, names):
+    if token.isascii() and token.upper() in names:
+        return low + names.index(token.upper())
+    value = _number(token)
+    if not low <= value <= high:
+        raise ValueError(f"field value out of range: {token!r}")
+    return value
+
+
+def _ordinary_item(item, low, high, names):
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text) if slash else 1
+    if step == 0:
+        raise ValueError("zero step")
+    if base == "*":
+        start, end = low, high
+    else:
+        first, dash, last = base.partition("-")
+        start = _value(first, low, high, names)
+        end = _value(last, low, high, names) if dash else (high if slash else start)
+    if end >= start:
+        values = list(range(start, end + 1))
+    elif names == _WEEKDAYS:
+        start %= 7
+        values = [(start + i) % 7 for i in range((end - start) % 7 + 1)]
+    else:
+        values = list(range(start, high + 1)) + list(range(low, end + 1))
+    return values[::step]
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule expression")
+    expr = expr.strip()
+    fields = re.split("[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    if len(fields) != 5:
+        raise ValueError("expected five schedule fields")
+
+    values = []
+    last_day = False
+    weekday_rules = set()
+    limits = [(0, 59, ()), (0, 23, ()), (1, 31, ()),
+              (1, 12, _MONTHS), (0, 7, _WEEKDAYS)]
+    for index, (field, bounds) in enumerate(zip(fields, limits)):
+        selected = set()
+        if index in (2, 4) and field == "?":
+            field = "*"
+        for item in field.split(","):
+            if index == 2 and item == "L":
+                last_day = True
+                continue
+            if index == 4:
+                special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+                if special:
+                    day = _value(special[1], 0, 7, ()) % 7
+                    occurrence = _value(special[3], 1, 5, ()) if special[3] else -1
+                    weekday_rules.add((day, occurrence))
+                    continue
+            selected.update(_ordinary_item(item, *bounds))
+        values.append(selected)
+    minutes, hours, days, months, weekdays = values
+    return minutes, hours, days, months, {n % 7 for n in weekdays}, last_day, weekday_rules
+
+
+def _allowed_day(day, days, weekdays, last_day, weekday_rules):
+    weekday = (day.weekday() + 1) % 7
+    length = calendar.monthrange(day.year, day.month)[1]
+    return ((day.day in days or (last_day and day.day == length))
+            and (weekday in weekdays
+                 or (weekday, (day.day - 1) // 7 + 1) in weekday_rules
+                 or (day.day + 7 > length and (weekday, -1) in weekday_rules)))
+
 
