 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import date, datetime, timedelta
+
+_MONTH_NAMES = {
+    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
+    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
+}
+
+_DOW_NAMES = {
+    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3,
+    "THU": 4, "FRI": 5, "SAT": 6,
+}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_DIGITS = re.compile(r"[0-9]+\Z")
+_STEP_BASE = re.compile(r"(?:\*|[0-9]+(?:-[0-9]+)?)\Z")
+
+
+class _Schedule:
+    def __init__(self, minutes, hours, months, dom_values, dom_last,
+                 dow_values, dow_last, dow_nth):
+        self.minutes = minutes
+        self.hours = hours
+        self.months = months
+        self.dom_values = dom_values
+        self.dom_last = dom_last
+        self.dow_values = dow_values
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+
+
+def _single_value(token, names, low, high):
+    if _DIGITS.fullmatch(token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if value < low or value > high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _expand(item, low, high, names):
+    if not item:
+        raise ValueError("empty item")
+    pieces = item.split("/")
+    if len(pieces) > 2:
+        raise ValueError(f"bad step: {item!r}")
+    base = pieces[0]
+    step = None
+    if len(pieces) == 2:
+        step_text = pieces[1]
+        if not _DIGITS.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+        if not _STEP_BASE.fullmatch(base):
+            raise ValueError(f"bad step: {item!r}")
+
+    if base == "*":
+        values = list(range(low, high + 1))
+    elif "-" in base:
+        ends = base.split("-")
+        if len(ends) != 2 or not ends[0] or not ends[1]:
+            raise ValueError(f"bad range: {item!r}")
+        start = _single_value(ends[0], names, low, high)
+        end = _single_value(ends[1], names, low, high)
+        if start <= end:
+            values = list(range(start, end + 1))
+        else:
+            values = list(range(start, high + 1)) + list(range(low, end + 1))
+    else:
+        start = _single_value(base, names, low, high)
+        if step is None:
+            values = [start]
+        else:
+            values = list(range(start, high + 1))
+
+    if step is not None:
+        values = values[::step]
+    return values
+
+
+def _parse_simple(field, low, high, names):
+    values = set()
+    for item in field.split(","):
+        values.update(_expand(item, low, high, names))
+    return values
+
+
+def _parse_dom(field):
+    if field == "?":
+        field = "*"
+    if field == "*":
+        return set(range(1, 32)), False
+
+    values = set()
+    last = False
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if item == "L":
+            last = True
+        else:
+            values.update(_expand(item, 1, 31, None))
+    return values, last
+
+
+def _parse_dow(field):
+    if field == "?":
+        field = "*"
+    if field == "*":
+        return set(range(7)), set(), set()
+
+    values = set()
+    last = set()
+    nth = set()
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty item")
+
+        match = re.fullmatch(r"([0-9]+)L", item)
+        if match:
+            n = int(match.group(1))
+            if n > 7:
+                raise ValueError(f"value out of range: {item!r}")
+            last.add(n % 7)
+            continue
+
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+        if match:
+            n = int(match.group(1))
+            k = int(match.group(2))
+            if n > 7 or k < 1 or k > 5:
+                raise ValueError(f"value out of range: {item!r}")
+            nth.add((n % 7, k))
+            continue
+
+        values.update(value % 7 for value in _expand(item, 0, 7, _DOW_NAMES))
+    return values, last, nth
+
+
+def _parse(expr):
+    text = expr.strip()
+    shortcut = _SHORTCUTS.get(text.lower())
+    if shortcut is not None:
+        text = shortcut
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"bad schedule: {expr!r}")
+
+    minute, hour, dom, month, dow = fields
+    minutes = _parse_simple(minute, 0, 59, None)
+    hours = _parse_simple(hour, 0, 23, None)
+    months = _parse_simple(month, 1, 12, _MONTH_NAMES)
+    dom_values, dom_last = _parse_dom(dom)
+    dow_values, dow_last, dow_nth = _parse_dow(dow)
+    return _Schedule(minutes, hours, months, dom_values, dom_last,
+                     dow_values, dow_last, dow_nth)
+
+
+def _day_matches(sched, day):
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    if day.day not in sched.dom_values:
+        if not (sched.dom_last and day.day == last_day):
+            return False
+
+    cron_dow = (day.weekday() + 1) % 7
+    if cron_dow in sched.dow_values:
+        return True
+    if cron_dow in sched.dow_last and day.day + 7 > last_day:
+        return True
+    occurrence = (day.day - 1) // 7 + 1
+    for weekday, number in sched.dow_nth:
+        if weekday == cron_dow and number == occurrence:
+            return True
+    return False
+
 
 def matches(expr, when):
