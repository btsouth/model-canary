 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_VALUE = r"[0-9]+|[A-Za-z]{3}"
+_ITEM = re.compile(rf"(\*|(?:{_VALUE})(?:-(?:{_VALUE}))?)(?:/([0-9]+))?")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+def _value(text, low, high, names):
+    if text.isdigit():
+        value = int(text)
+    else:
+        if names is None or text.upper() not in names:
+            raise ValueError(f"bad value: {text!r}")
+        value = names[text.upper()]
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {text!r}")
+    return value
+
+
+def _field(text, low, high, names=None, kind=None):
+    """Return (values, last_dom, last_dows, nth_dows) for one field."""
+    values, last_dom, last_dows, nth_dows = set(), False, set(), set()
+    if text == "?":
+        if kind is None:
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    week = kind == "dow"
+    for item in text.split(","):
+        if kind == "dom" and item == "L":
+            last_dom = True
+            continue
+        if week:
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                last_dows.add(_value(m.group(1), 0, 7, None) % 7)
+                continue
+            m = _NTH_DOW.fullmatch(item)
+            if m:
+                k = int(m.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"bad item: {item!r}")
+                nth_dows.add((_value(m.group(1), 0, 7, None) % 7, k))
+                continue
+        m = _ITEM.fullmatch(item)
+        if not m:
+            raise ValueError(f"bad item: {item!r}")
+        body, step = m.groups()
+        if step is not None:
+            step = int(step)
+            if step < 1:
+                raise ValueError(f"bad step in {item!r}")
+        if body == "*":
+            listed = list(range(low, 7 if week else high + 1))
+        elif "-" in body:
+            a, b = (_value(part, low, high, names) for part in body.split("-"))
+            if a <= b:
+                listed = list(range(a, b + 1))
+            elif week:
+                a %= 7
+                listed = list(range(a, 7)) + list(range(0, b + 1)) if a > b else list(range(a, b + 1))
+            else:
+                listed = list(range(a, high + 1)) + list(range(low, b + 1))
+        else:
+            a = _value(body, low, high, names)
+            listed = list(range(a, high + 1)) if step is not None else [a]
+        listed = listed[::step or 1]
+        values.update(v % 7 for v in listed) if week else values.update(listed)
+    return values, last_dom, last_dows, nth_dows
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad expression: {expr!r}")
+        expr = expr.strip()
+        if expr.startswith("@"):
+            if expr.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            expr = _SHORTCUTS[expr.lower()]
+        parts = re.split(r"[ \t]+", expr)
+        if len(parts) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        self.minutes = sorted(_field(parts[0], 0, 59)[0])
+        self.hours = sorted(_field(parts[1], 0, 23)[0])
+        self.doms, self.last_dom, _, _ = _field(parts[2], 1, 31, kind="dom")
+        self.months = _field(parts[3], 1, 12, _MONTHS)[0]
+        self.dows, _, self.last_dows, self.nth_dows = _field(parts[4], 0, 7, _DAYS, kind="dow")
+
+    def day_ok(self, year, month, day):
+        first_weekday, ndays = calendar.monthrange(year, month)
+        if day > ndays:
+            return False
+        if not (day in self.doms or (self.last_dom and day == ndays)):
+            return False
+        dow = (first_weekday + day) % 7  # Sunday is 0
+        return (dow in self.dows
+                or (dow in self.last_dows and day + 7 > ndays)
+                or (dow, (day - 1) // 7 + 1) in self.nth_dows)
+
+    def time_ok(self, when):
+        return (when.minute in self.minutes and when.hour in self.hours
+                and when.month in self.months)
 
 
