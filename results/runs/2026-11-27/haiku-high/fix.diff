 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from datetime import date, datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {n: i for i, n in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAY_NAMES = {n: i for i, n in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# field -> (smallest value, largest value, names)
+_RANGES = {
+    "minute": (0, 59, {}),
+    "hour": (0, 23, {}),
+    "dom": (1, 31, {}),
+    "month": (1, 12, _MONTH_NAMES),
+    "dow": (0, 7, _DAY_NAMES),
+}
+
+_SEARCH_SPAN = timedelta(days=50 * 365)
+_DIGITS = re.compile(r"[0-9]+")
+_DOW_LAST = re.compile(r"([0-9]+)L")
+_DOW_NTH = re.compile(r"([0-9]+)#([0-9]+)")
+
+
+def _number(text, lo, hi=None):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"not a number: {text!r}")
+    n = int(text)
+    if n < lo or (hi is not None and n > hi):
+        raise ValueError(f"number out of range: {text!r}")
+    return n
+
+
+def _value(text, field):
+    """A single value: a number in range, or a name where the field allows names."""
+    lo, hi, names = _RANGES[field]
+    if _DIGITS.fullmatch(text):
+        return _number(text, lo, hi)
+    if text.upper() in names:
+        return names[text.upper()]
+    raise ValueError(f"bad {field} value: {text!r}")
+
+
+def _item(item, field):
+    """Parse one comma-separated item.
+
+    Returns (values, special): values is the ordered list of values the item lists,
+    and special is None or one of ('L',), ('last', N) or ('nth', N, K).
+    """
+    lo, hi, _ = _RANGES[field]
+    if field == "dom" and item == "L":
+        return [], ("L",)
+    if field == "dow":
+        m = _DOW_LAST.fullmatch(item)
+        if m:
+            return [], ("last", _number(m.group(1), 0, 7) % 7)
+        m = _DOW_NTH.fullmatch(item)
+        if m:
+            return [], ("nth", _number(m.group(1), 0, 7) % 7, _number(m.group(2), 1, 5))
+
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text, 1) if slash else None
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    elif "-" in base:
+        start_text, _, end_text = base.partition("-")
+        if "-" in end_text:
+            raise ValueError(f"bad range: {base!r}")
+        start = _value(start_text, field)
+        end = _value(end_text, field)
+        if start <= end:
+            values = list(range(start, end + 1))
+        elif field == "dow":
+            # Counts through 0 to 6; 7 is Sunday already covered by 0.
+            values = list(range(start, 7)) + list(range(0, end + 1))
+        else:
+            values = list(range(start, hi + 1)) + list(range(lo, end + 1))
+    else:
+        start = _value(base, field)
+        values = list(range(start, hi + 1)) if slash else [start]
+    if step is not None:
+        values = values[::step]
+    return values, None
+
+
+def _field(text, field):
+    """Parse one field. Returns (set of values, list of specials)."""
+    if field in ("dom", "dow") and text == "?":
+        text = "*"
+    values, specials = set(), []
+    for item in text.split(","):
+        listed, special = _item(item, field)
+        values.update(listed)
+        if special is not None:
+            specials.append(special)
+    return values, specials
+
+
+class _Spec:
+    """A parsed expression. Day-of-week values are normalised so Sunday is 0."""
+
+    def __init__(self, minutes, hours, doms, dom_last, months, dows, dow_last, dow_nth):
+        self.minutes = frozenset(minutes)
+        self.hours = frozenset(hours)
+        self.doms = frozenset(doms)
+        self.dom_last = dom_last
+        self.months = frozenset(months)
+        self.dows = frozenset(dows)
+        self.dow_last = frozenset(dow_last)
+        self.dow_nth = frozenset(dow_nth)
+        # Minute-of-day values at which the schedule fires, ascending.
+        self.times = sorted(h * 60 + m for h in hours for m in minutes)
+
+
+def _parse(expr):
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minutes, _ = _field(parts[0], "minute")
+    hours, _ = _field(parts[1], "hour")
+    doms, dom_specials = _field(parts[2], "dom")
+    months, _ = _field(parts[3], "month")
+    dows, dow_specials = _field(parts[4], "dow")
+    dom_last = any(s == ("L",) for s in dom_specials)
+    dow_last = {s[1] for s in dow_specials if s[0] == "last"}
+    dow_nth = {(s[1], s[2]) for s in dow_specials if s[0] == "nth"}
+    return _Spec(minutes, hours, doms, dom_last, months,
+                 {v % 7 for v in dows}, dow_last, dow_nth)
+
+
+def _day_ok(spec, day, weekday, days_in_month):
+    """Whether a day is allowed: it must match both the day-of-month and day-of-week fields.
+
+    day is 1 to 31; weekday is 0 for Sunday to 6 for Saturday.
+    """
+    if day not in spec.doms and not (spec.dom_last and day == days_in_month):
+        return False
+    if weekday in spec.dows:
+        return True
+    if weekday in spec.dow_last and day + 7 > days_in_month:
+        return True
+    return (weekday, (day - 1) // 7 + 1) in spec.dow_nth
+
+
+def _month_days(spec, year, month):
+    """The allowed day numbers in a month, ascending."""
+    days_in_month = calendar.monthrange(year, month)[1]
+    first_weekday = (date(year, month, 1).weekday() + 1) % 7
+    return [d for d in range(1, days_in_month + 1)
+            if _day_ok(spec, d, (first_weekday + d - 1) % 7, days_in_month)]
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    spec = _parse(expr)
