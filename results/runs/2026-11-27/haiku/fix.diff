@@ -1,11 +1,201 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date, datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+# (lowest, highest) allowed value per field kind.
+_BOUNDS = {"min": (0, 59), "hour": (0, 23), "dom": (1, 31), "mon": (1, 12), "dow": (0, 7)}
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], start=1)}
+_WEEKDAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_HORIZON = timedelta(days=50 * 365)
+
+
+@dataclass(frozen=True)
+class _Schedule:
+    minutes: tuple        # sorted
+    hours: tuple          # sorted
+    months: frozenset
+    days: frozenset       # day-of-month values
+    last_day: bool        # day-of-month field includes L
+    weekdays: frozenset   # day-of-week values, 0-6 (Sunday is 0)
+    last_weekdays: frozenset  # NL: last weekday N of the month
+    nth_weekdays: frozenset   # (N, K): K-th weekday N of the month
+
+
+def _value(text, kind):
+    """A single number or name for a field kind, range checked."""
+    if _NUMBER.fullmatch(text):
+        n = int(text)
+    elif kind in ("mon", "dow") and _NAME.fullmatch(text):
+        table = _MONTHS if kind == "mon" else _WEEKDAYS
+        if text.upper() not in table:
+            raise ValueError(f"unknown name {text!r}")
+        n = table[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    lo, hi = _BOUNDS[kind]
+    if not lo <= n <= hi:
+        raise ValueError(f"value {n} out of range")
+    return n
+
+
+def _items(field, kind):
+    """Parse one comma-separated field. Returns (values, specials)."""
+    lo, hi = _BOUNDS[kind]
+    if field == "?" and kind in ("dom", "dow"):
+        field = "*"
+    values, specials = set(), []
+    for item in field.split(","):
+        if "?" in item:
+            raise ValueError("? is only allowed as a whole day field")
+        if kind == "dom" and item == "L":
+            specials.append("L")
+            continue
+        if kind == "dow":
+            m = _LAST_DOW.fullmatch(item)
+            if m:
+                n = int(m.group(1))
+                if n > 7:
+                    raise ValueError(f"weekday {n} out of range")
+                specials.append(("last", n % 7))
+                continue
+            m = _NTH_DOW.fullmatch(item)
+            if m:
+                n, k = int(m.group(1)), int(m.group(2))
+                if n > 7 or not 1 <= k <= 5:
+                    raise ValueError(f"bad weekday occurrence {item!r}")
+                specials.append(("nth", n % 7, k))
+                continue
+        base, step = item, None
+        if "/" in item:
+            base, _, step_text = item.partition("/")
+            if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+                raise ValueError(f"bad step in {item!r}")
+            step = int(step_text)
+        if base == "*":
+            seq = list(range(lo, hi + 1))
+        elif "-" in base:
+            a_text, _, b_text = base.partition("-")
+            a, b = _value(a_text, kind), _value(b_text, kind)
+            if a <= b:
+                seq = list(range(a, b + 1))
+            elif kind == "dow":
+                seq = list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                seq = list(range(a, hi + 1)) + list(range(lo, b + 1))
+        else:
+            a = _value(base, kind)
+            seq = list(range(a, hi + 1)) if step is not None else [a]
+        if step is not None:
+            seq = seq[::step]
+        values.update(seq)
+    if not values and not specials:
+        raise ValueError(f"empty field {field!r}")
+    return values, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        text = _SHORTCUTS.get(text.lower())
+        if text is None:
+            raise ValueError(f"unknown shortcut {expr!r}")
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields, got {len(fields)}")
+    minutes, _ = _items(fields[0], "min")
+    hours, _ = _items(fields[1], "hour")
+    days, day_specials = _items(fields[2], "dom")
+    months, _ = _items(fields[3], "mon")
+    weekdays, dow_specials = _items(fields[4], "dow")
+    return _Schedule(
+        minutes=tuple(sorted(minutes)),
+        hours=tuple(sorted(hours)),
+        months=frozenset(months),
+        days=frozenset(days),
+        last_day="L" in day_specials,
+        weekdays=frozenset(v % 7 for v in weekdays),
+        last_weekdays=frozenset(s[1] for s in dow_specials if s[0] == "last"),
+        nth_weekdays=frozenset((s[1], s[2]) for s in dow_specials if s[0] == "nth"),
+    )
+
+
+def _day_ok(s, d):
+    """True if date d is allowed by both the day-of-month and day-of-week fields."""
+    last = calendar.monthrange(d.year, d.month)[1]
+    if d.day not in s.days and not (s.last_day and d.day == last):
+        return False
+    wd = d.isoweekday() % 7
+    if wd in s.weekdays:
+        return True
+    if wd in s.last_weekdays and d.day + 7 > last:
+        return True
+    return (wd, (d.day - 1) // 7 + 1) in s.nth_weekdays
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _parse(expr)
+    return (when.minute in s.minutes and when.hour in s.hours
+            and when.month in s.months and _day_ok(s, when.date()))
+
+
+def _first_time(s, d, start):
+    """The earliest run on date d that is not before start, or None."""
+    lo = (start.hour, start.minute) if d == start.date() else (0, 0)
+    for h in s.hours:
+        for m in s.minutes:
+            if (h, m) >= lo:
+                return datetime.combine(d, time(h, m))
+    return None
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    s = _parse(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _HORIZON
+    except OverflowError:
+        limit = datetime.max
+    limit_date = limit.date()
+    d = start.date()
+    while True:
+        if d > limit_date:
+            return None
+        if d.month not in s.months:
+            if d.year == date.max.year and d.month == 12:
+                return None
+            if d.month == 12:
+                d = date(d.year + 1, 1, 1)
+            else:
+                d = date(d.year, d.month + 1, 1)
+            continue
+        if _day_ok(s, d):
+            found = _first_time(s, d, start)
+            if found is not None:
+                return found if found <= limit else None
+        if d >= limit_date:
+            return None
+        d += timedelta(days=1)
