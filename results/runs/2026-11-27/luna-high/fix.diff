 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as _dt
+import re
+
+
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): (i + 1) % 7 for i, name in enumerate(calendar.day_abbr)}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_SPECS = ((0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS))
+
+
+def _parse_number(token, field, allow_names=True):
+    low, high, names = _SPECS[field]
+    upper = token.upper()
+    if allow_names and names and upper in names:
+        return names[upper]
+    if not re.fullmatch(r"\d+", token):
+        raise ValueError("invalid schedule value")
+    value = int(token)
+    if not low <= value <= high:
+        raise ValueError("schedule value out of range")
+    return value
+
+
+def _field(text, field):
+    low, high, _ = _SPECS[field]
+    if text == "?":
+        if field not in (2, 4):
+            raise ValueError("? is only allowed in day fields")
+        text = "*"
+    result = set()
+    specials = []
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty schedule item")
+        if field == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if field == 4:
+            m = re.fullmatch(r"(\d+)L", item, re.IGNORECASE)
+            if m:
+                n = _parse_number(m.group(1), field, False)
+                specials.append(("dow_last", 0 if n == 7 else n))
+                continue
+            m = re.fullmatch(r"(\d+)#([1-5])", item)
+            if m:
+                n = _parse_number(m.group(1), field, False)
+                specials.append(("dow_nth", 0 if n == 7 else n, int(m.group(2))))
+                continue
+        if item.count("/") > 1:
+            raise ValueError("invalid step")
+        if "/" in item:
+            base, step_text = item.split("/")
+            if not re.fullmatch(r"\d+", step_text) or int(step_text) < 1:
+                raise ValueError("invalid step")
+            step = int(step_text)
+        else:
+            base, step = item, 1
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("invalid range")
+            a_text, b_text = base.split("-")
+            a = _parse_number(a_text, field)
+            b = _parse_number(b_text, field)
+            if field == 4:
+                a = 0 if a == 7 else a
+                b = 0 if b == 7 else b
+            if a <= b:
+                sequence = list(range(a, b + 1))
+            elif field == 4:
+                sequence = list(range(a, 7)) + list(range(0, b + 1))
+            else:
+                sequence = list(range(a, high + 1)) + list(range(low, b + 1))
+        else:
+            value = _parse_number(base, field)
+            if "/" in item:
+                sequence = list(range(value, high + 1))
+            else:
+                sequence = [value]
+        selected = sequence[::step]
+        if field == 4:
+            selected = [0 if x == 7 else x for x in selected]
+        result.update(selected)
+    return result, specials
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    raw = expr.strip()
+    if raw.startswith("@"):
+        raw = _SHORTCUTS.get(raw.lower())
+        if raw is None:
+            raise ValueError("unknown schedule shortcut")
+    fields = re.split(r"[ \t]+", raw.strip())
+    if len(fields) != 5 or not all(fields):
+        raise ValueError("schedule must have five fields")
+    parsed = [_field(value, i) for i, value in enumerate(fields)]
+    # Keep track of the syntactic wildcard: both wildcard day fields match all days.
+    dom_any = fields[2] in ("*", "?")
+    dow_any = fields[4] in ("*", "?")
+    return parsed, dom_any, dow_any
+
+
+def _day_allowed(parsed, dom_any, dow_any, date):
+    dom_values, dom_specials = parsed[2]
+    dow_values, dow_specials = parsed[4]
+    dom_ok = dom_any or date.day in dom_values
+    if ("last",) in dom_specials:
+        dom_ok = dom_ok or date.day == calendar.monthrange(date.year, date.month)[1]
+    weekday = (date.weekday() + 1) % 7
+    dow_ok = dow_any or weekday in dow_values
+    for special in dow_specials:
+        if special[0] == "dow_last":
+            last_day = calendar.monthrange(date.year, date.month)[1]
+            dow_ok |= weekday == special[1] and date.day + 7 > last_day
+        else:
+            dow_ok |= weekday == special[1] and (date.day - 1) // 7 + 1 == special[2]
+    return dom_ok and dow_ok
+
 
