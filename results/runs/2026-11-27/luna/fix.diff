 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
+
+_SHORT = {"@yearly":"0 0 1 1 *", "@annually":"0 0 1 1 *", "@monthly":"0 0 1 * *",
+          "@weekly":"0 0 * * 0", "@daily":"0 0 * * *", "@midnight":"0 0 * * *", "@hourly":"0 * * * *"}
+_MONTH = {x.upper(): i for i, x in enumerate(calendar.month_abbr) if x}
+_DAYS = {x.upper(): i for i, x in enumerate(["SUN","MON","TUE","WED","THU","FRI","SAT"])}
+
+def _parse(expr):
+    if not isinstance(expr, str): raise ValueError("bad schedule")
+    expr = _SHORT.get(expr.strip().lower(), expr.strip())
+    fs = re.split(r"[ \t]+", expr)
+    if len(fs) != 5: raise ValueError("schedule needs five fields")
+    mins = _field(fs[0],0,59)
+    hours = _field(fs[1],0,23)
+    dom = _field(fs[2],1,31, special="dom")
+    months = _field(fs[3],1,12,names=_MONTH)
+    dow = _field(fs[4],0,7,names=_DAYS,special="dow")
+    return mins,hours,dom,months,dow
+
+def _field(s, lo, hi, names=None, special=None):
+    if s in ("*", "?"):
+        if s == "?" and special not in ("dom","dow"): raise ValueError("bad ?")
+        return {"all":True,"vals":set(range(lo,hi+1)),"last":False,"spec":[]}
+    out=set(); specs=[]
+    for item in s.split(","):
+        if not item: raise ValueError("empty item")
+        if special == "dom" and item == "L":
+            specs.append(("L",)); continue
+        if special == "dow":
+            m=re.fullmatch(r"(\d+)(L|#([1-5]))",item)
+            if m:
+                n=int(m.group(1)); k=m.group(3)
+                if not 0<=n<=7: raise ValueError("bad weekday")
+                specs.append(("last" if m.group(2)=="L" else "nth", n%7, int(k) if k else None)); continue
+        if "#" in item or item.endswith("L"): raise ValueError("bad special")
+        bits=item.split("/")
+        if len(bits)>2: raise ValueError("bad step")
+        step=1
+        if len(bits)==2:
+            if not bits[1].isdigit() or int(bits[1])<1: raise ValueError("bad step")
+            if names and any(part.upper() in names for part in re.split(r"[-]", bits[0])):
+                raise ValueError("names cannot be stepped")
+            step=int(bits[1])
+        base=bits[0]
+        def val(t):
+            if names and t.upper() in names: return names[t.upper()]
+            if not t.isdigit(): raise ValueError("bad value")
+            return int(t)
+        if base=="*": seq=list(range(lo,hi+1))
+        elif "-" in base:
+            if base.count("-")!=1: raise ValueError("bad range")
+            a,b=map(val,base.split("-"))
+            if not lo<=a<=hi or not lo<=b<=hi: raise ValueError("out of range")
+            if a<=b: seq=list(range(a,b+1))
+            elif special=="dow": seq=list(range(a,8))+list(range(0,b+1))
+            else: seq=list(range(a,hi+1))+list(range(lo,b+1))
+        else:
+            a=val(base)
+            if not lo<=a<=hi: raise ValueError("out of range")
+            seq=list(range(a,hi+1)) if len(bits)==2 else [a]
+        out.update(seq[::step])
+    if special=="dow": out={v%7 for v in out}
+    return {"all":False,"vals":out,"last":False,"spec":specs}
+
+def _day_ok(d, dom, dow):
+    md=calendar.monthrange(d.year,d.month)[1]
+    wd=(d.weekday()+1)%7
+    a=(d.day in dom["vals"] or ("L",) in dom["spec"] and d.day==md)
+    for typ,n,k in dow["spec"] if dow["spec"] else []:
+        if typ=="last" and wd==n and d.day+7>md: a_dow=True; break
+        if typ=="nth" and wd==n and (d.day-1)//7+1==k: a_dow=True; break
+    else: a_dow=False
+    b=wd in dow["vals"] or a_dow
+    return a and b
 
 
