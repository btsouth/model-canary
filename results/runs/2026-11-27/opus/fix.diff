+    if total < 0:
+        return [-share for share in apportion(-total, weights)]
+    exact = [Fraction(w) for w in weights]
+    whole = sum(exact)
+    shares = []
+    remainders = []
+    for w in exact:
+        q = total * w / whole
+        floor = q.numerator // q.denominator
+        shares.append(floor)
