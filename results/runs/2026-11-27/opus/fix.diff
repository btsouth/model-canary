--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,234 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as _dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# (minimum, maximum, names)
+_MINUTE = (0, 59, None)
+_HOUR = (0, 23, None)
+_DOM = (1, 31, None)
+_MONTH = (1, 12, _MONTHS)
+_DOW = (0, 7, _DAYS)
+
+_NUM = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LIMIT = _dt.timedelta(days=50 * 365)
+
+
+def _bad(expr):
+    return ValueError(f"bad schedule expression: {expr!r}")
+
+
+def _value(text, spec, expr):
+    lo, hi, names = spec
+    if _NUM.fullmatch(text):
+        value = int(text)
+    elif names is not None and _NAME.fullmatch(text) and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise _bad(expr)
+    if not lo <= value <= hi:
+        raise _bad(expr)
+    return value
+
+
+def _number(text, lo, hi, expr):
+    if not _NUM.fullmatch(text):
+        raise _bad(expr)
+    value = int(text)
+    if not lo <= value <= hi:
+        raise _bad(expr)
+    return value
+
+
+def _item_values(item, spec, expr, is_dow):
+    """The values an ordinary item (*, N, A-B, optionally /S) lists, in order."""
+    lo, hi, _ = spec
+    base, slash, step_text = item.partition("/")
+    if slash:
+        if not _NUM.fullmatch(step_text):
+            raise _bad(expr)
+        step = int(step_text)
+        if step < 1:
+            raise _bad(expr)
+    else:
+        step = 1
+    if base == "*":
+        values = list(range(lo, hi + 1))
+    elif "-" in base:
+        a_text, _, b_text = base.partition("-")
+        a = _value(a_text, spec, expr)
+        b = _value(b_text, spec, expr)
+        if a <= b:
+            values = list(range(a, b + 1))
+        elif is_dow:
+            a, b = a % 7, b % 7
+            values = [a]
+            while values[-1] != b:
+                values.append((values[-1] + 1) % 7)
+        else:
+            values = list(range(a, hi + 1)) + list(range(lo, b + 1))
+    else:
+        a = _value(base, spec, expr)
+        values = list(range(a, hi + 1)) if slash else [a]
+    return values[::step]
+
+
+def _parse_simple(text, spec, expr):
+    if not text:
+        raise _bad(expr)
+    result = set()
+    for item in text.split(","):
+        if not item:
+            raise _bad(expr)
+        result.update(_item_values(item, spec, expr, False))
+    return frozenset(result)
+
+
+def _parse_dom(text, expr):
+    if text == "?":
+        text = "*"
+    days, last = set(), False
+    for item in text.split(","):
+        if not item:
+            raise _bad(expr)
+        if item == "L":
+            last = True
+        else:
+            days.update(_item_values(item, _DOM, expr, False))
+    return frozenset(days), last
+
+
+def _parse_dow(text, expr):
+    if text == "?":
+        text = "*"
+    days, lasts, nths = set(), set(), set()
+    for item in text.split(","):
+        if not item:
+            raise _bad(expr)
+        if item.endswith("L") and _NUM.fullmatch(item[:-1]):
+            lasts.add(_number(item[:-1], 0, 7, expr) % 7)
+        elif "#" in item:
+            n_text, _, k_text = item.partition("#")
+            n = _number(n_text, 0, 7, expr) % 7
+            k = _number(k_text, 1, 5, expr)
+            nths.add((n, k))
+        else:
+            days.update(v % 7 for v in _item_values(item, _DOW, expr, True))
+    return frozenset(days), frozenset(lasts), frozenset(nths)
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise _bad(expr)
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                raise _bad(expr)
+            text = _SHORTCUTS[text.lower()]
+        parts = re.split(r"[ \t]+", text)
+        if len(parts) != 5 or any(not p for p in parts):
+            raise _bad(expr)
+        minute, hour, dom, month, dow = parts
+        self.minutes = sorted(_parse_simple(minute, _MINUTE, expr))
+        self.hours = sorted(_parse_simple(hour, _HOUR, expr))
+        self.minute_set = frozenset(self.minutes)
+        self.hour_set = frozenset(self.hours)
+        self.months = frozenset(_parse_simple(month, _MONTH, expr))
+        self.dom_days, self.dom_last = _parse_dom(dom, expr)
+        self.dow_days, self.dow_lasts, self.dow_nths = _parse_dow(dow, expr)
+        self._cache = {}
+
+    def _day_ok(self, day, ndays, weekday):
+        """weekday is cron-style: 0 is Sunday."""
+        dom_ok = day in self.dom_days or (self.dom_last and day == ndays)
+        if not dom_ok:
+            return False
+        return (weekday in self.dow_days
+                or (weekday in self.dow_lasts and day + 7 > ndays)
+                or (weekday, (day - 1) // 7 + 1) in self.dow_nths)
+
+    def allowed_days(self, year, month):
+        first, ndays = calendar.monthrange(year, month)  # first: Monday is 0
+        key = (first, ndays)
+        days = self._cache.get(key)
+        if days is None:
+            first_cron = (first + 1) % 7
+            days = [d for d in range(1, ndays + 1)
+                    if self._day_ok(d, ndays, (first_cron + d - 1) % 7)]
+            self._cache[key] = days
+        return days
+
+    def matches(self, when):
+        if (when.minute not in self.minute_set or when.hour not in self.hour_set
+                or when.month not in self.months):
+            return False
+        return when.day in self.allowed_days(when.year, when.month)
+
+    def next_run(self, after):
+        base = after.replace(second=0, microsecond=0)
+        try:
+            start = base + _dt.timedelta(minutes=1)
+        except OverflowError:
+            return None
+        try:
+            limit = after + _LIMIT
+        except OverflowError:
+            limit = _dt.datetime.max.replace(tzinfo=after.tzinfo)
+        year, month = start.year, start.month
+        while (year, month) <= (limit.year, limit.month):
+            if month in self.months:
+                for day in self.allowed_days(year, month):
+                    if (year, month, day) < (start.year, start.month, start.day):
+                        continue
+                    if (year, month, day) == (start.year, start.month, start.day):
+                        found = self._first_time(start.hour, start.minute)
+                        if found is None:
+                            continue
+                        hour, minute = found
+                    else:
+                        hour, minute = self.hours[0], self.minutes[0]
+                    run = start.replace(year=year, month=month, day=day,
+                                        hour=hour, minute=minute)
+                    return run if run <= limit else None
+            month += 1
+            if month > 12:
+                year, month = year + 1, 1
+        return None
+
+    def _first_time(self, hour, minute):
+        for h in self.hours:
+            if h < hour:
+                continue
+            if h == hour:
+                for m in self.minutes:
+                    if m >= minute:
+                        return h, m
+                continue
+            return h, self.minutes[0]
+        return None
 
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    return _Schedule(expr).matches(when)
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    return _Schedule(expr).next_run(after)
