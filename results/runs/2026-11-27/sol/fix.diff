 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    "SUN MON TUE WED THU FRI SAT".split())}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _number(token, low, high, names=None):
+    if names and token in names:
+        return names[token]
+    if not re.fullmatch(r"[0-9]+", token):
+        raise ValueError(f"bad schedule value: {token!r}")
+    value = int(token)
+    if not low <= value <= high:
+        raise ValueError(f"schedule value out of range: {token!r}")
+    return value
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    names = _MONTHS if index == 3 else _DAYS if index == 4 else None
+    values, specials = set(), []
+    if text == "?" and index in (2, 4):
+        text = "*"
+    for item in text.split(","):
+        if index == 2 and item == "L":
+            specials.append(("last",))
+            continue
+        if index == 4:
+            special = re.fullmatch(r"([0-9]+)(L|#([0-9]+))", item)
+            if special:
+                weekday = _number(special[1], 0, 7) % 7
+                if special[2] == "L":
+                    specials.append(("last_weekday", weekday))
+                else:
+                    specials.append(("nth_weekday", weekday,
+                                     _number(special[3], 1, 5)))
+                continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"bad schedule item: {item!r}")
+        base = pieces[0]
+        step = 1
+        if len(pieces) == 2:
+            if not re.fullmatch(r"[0-9]+", pieces[1]) or int(pieces[1]) < 1:
+                raise ValueError(f"bad schedule step: {pieces[1]!r}")
+            step = int(pieces[1])
+        if base == "*":
+            sequence = list(range(low, high + 1))
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"bad schedule range: {base!r}")
+            start, end = (_number(part, low, high, names) for part in ends)
+            if start <= end:
+                sequence = list(range(start, end + 1))
+            else:
+                if index == 4:
+                    start, end = start % 7, end % 7
+                    sequence = [start]
+                    while sequence[-1] != end:
+                        sequence.append((sequence[-1] + 1) % 7)
+                else:
+                    sequence = list(range(start, high + 1)) + list(range(low, end + 1))
+        else:
+            start = _number(base, low, high, names)
+            sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+        values.update(value % 7 if index == 4 else value for value in sequence[::step])
+    return values, specials
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    if expr.startswith("@"):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError(f"unknown schedule shortcut: {expr!r}") from None
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule requires five fields")
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(parsed, date):
+    day = date.day
+    weekday = (date.weekday() + 1) % 7
+    days, day_specials = parsed[2]
+    weekdays, weekday_specials = parsed[4]
+    last = calendar.monthrange(date.year, date.month)[1]
+    dom = day in days or bool(day_specials and day == last)
+    dow = weekday in weekdays or any(
+        weekday == special[1] and (
+            day + 7 > last if special[0] == "last_weekday"
+            else (day - 1) // 7 + 1 == special[2])
+        for special in weekday_specials)
+    return dom and dow
+
 
