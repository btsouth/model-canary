 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_left
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DIGITS = re.compile(r"[0-9]+")
+_WEEKDAY_SPECIAL = re.compile(r"([0-9]+)(?:L|#([0-9]+))")
+_SEARCH_WINDOW = timedelta(days=50 * 365)
+
+
+@dataclass
+class _Schedule:
+    minutes: set[int]
+    hours: set[int]
+    month_days: set[int]
+    months: set[int]
+    weekdays: set[int]
+    last_day: bool
+    last_weekdays: set[int]
+    nth_weekdays: set[tuple[int, int]]
+
+    def allows_day(self, day, month_length, weekday):
+        return (
+            (day in self.month_days or (self.last_day and day == month_length))
+            and (
+                weekday in self.weekdays
+                or (weekday in self.last_weekdays and day + 7 > month_length)
+                or (weekday, (day - 1) // 7 + 1) in self.nth_weekdays
+            )
+        )
+
+
+def _bounded_number(token, maximum):
+    if not _DIGITS.fullmatch(token):
+        raise ValueError(f"invalid schedule number: {token!r}")
+    digits = token.lstrip("0")
+    if len(digits) > len(str(maximum)):
+        return maximum + 1
+    return min(int(digits or "0"), maximum + 1)
+
+
+def _value(token, lower, upper, names=None):
+    if names is not None and token.isascii() and token.upper() in names:
+        return names[token.upper()]
+    value = _bounded_number(token, upper)
+    if not lower <= value <= upper:
+        raise ValueError(f"schedule value out of range: {token!r}")
+    return value
+
+
+def _item_values(item, lower, upper, names=None):
+    base, slash, step_text = item.partition("/")
+    step = _bounded_number(step_text, upper - lower + 1) if slash else 1
+    if step == 0:
+        raise ValueError("schedule step must be positive")
+
+    if base == "*":
+        return range(lower, upper + 1, step)
+    first, dash, last = base.partition("-")
+    start = _value(first, lower, upper, names)
+    if not dash:
+        return range(start, (upper if slash else start) + 1, step)
+
+    end = _value(last, lower, upper, names)
+    if start <= end:
+        return range(start, end + 1, step)
+    if names is _WEEKDAYS:
+        start %= 7
+        end %= 7
+        upper = 6
+        if start <= end:
+            return range(start, end + 1, step)
+    return (list(range(start, upper + 1)) + list(range(lower, end + 1)))[::step]
+
+
+def _parse_field(field, lower, upper, names=None):
+    return {value for item in field.split(",") for value in _item_values(item, lower, upper, names)}
+
+
+def _parse_schedule(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule expression must be text")
+    expr = expr.strip()
+    if expr.isascii():
+        expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r"[ \t]+", expr)
+    if len(fields) != 5:
+        raise ValueError("schedule expression must have five fields")
+    minute, hour, month_day, month, weekday = fields
+
+    month_days = set()
+    last_day = False
+    for item in ("*" if month_day == "?" else month_day).split(","):
+        if item == "L":
+            last_day = True
+        else:
+            month_days.update(_item_values(item, 1, 31))
+
+    weekdays = set()
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in ("*" if weekday == "?" else weekday).split(","):
+        special = _WEEKDAY_SPECIAL.fullmatch(item)
+        if special is None:
+            weekdays.update(value % 7 for value in _item_values(item, 0, 7, _WEEKDAYS))
+        else:
+            number, occurrence = special.groups()
+            day = _value(number, 0, 7) % 7
+            if occurrence is None:
+                last_weekdays.add(day)
+            else:
+                nth_weekdays.add((day, _value(occurrence, 1, 5)))
+
+    return _Schedule(
+        _parse_field(minute, 0, 59),
+        _parse_field(hour, 0, 23),
+        month_days,
+        _parse_field(month, 1, 12, _MONTHS),
+        weekdays,
+        last_day,
+        last_weekdays,
+        nth_weekdays,
+    )
+
 
