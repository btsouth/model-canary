+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        _bad("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        expr = _SHORTCUTS.get(expr.lower()) or _bad("unknown shortcut")
+    toks = re.split(r"[ \t]+", expr)
