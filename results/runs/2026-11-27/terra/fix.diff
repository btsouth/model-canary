 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {'@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+              '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+              '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+              '@hourly': '0 * * * *'}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    parsed = []
+    for index, field in enumerate(fields):
+        low, high = _LIMITS[index]
+        values, special = set(), []
+        if field == '?' and index in (2, 4):
+            field = '*'
+
+        def number(token):
+            names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+            if token.upper() in names:
+                return names[token.upper()]
+            if not re.fullmatch(r'[0-9]+', token):
+                raise ValueError('invalid value')
+            value = int(token)
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+
+        for item in field.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            m = re.fullmatch(r'([0-7])(?:L|#([1-5]))', item) if index == 4 else None
+            if m:
+                special.append(('nth', int(m[1]) % 7, int(m[2])) if m[2] else ('last_weekday', int(m[1]) % 7))
+                continue
+            pieces = item.split('/')
+            if len(pieces) > 2 or not pieces[0]:
+                raise ValueError('invalid item')
+            step = 1
+            if len(pieces) == 2:
+                if not re.fullmatch(r'[0-9]+', pieces[1]) or int(pieces[1]) == 0:
+                    raise ValueError('invalid step')
+                step = int(pieces[1])
+            base = pieces[0]
+            if base == '*':
+                sequence = list(range(low, high + 1))
+            elif '-' in base:
+                endpoints = base.split('-')
+                if len(endpoints) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, endpoints)
+                if index == 4:
+                    if start <= end:
+                        sequence = list(range(start, end + 1))
+                    else:
+                        start, end = start % 7, end % 7
+                        sequence = list(range(start, end + 1)) if start <= end else list(range(start, 7)) + list(range(0, end + 1))
+                else:
+                    sequence = list(range(start, end + 1)) if start <= end else list(range(start, high + 1)) + list(range(low, end + 1))
+            else:
+                start = number(base)
+                sequence = list(range(start, high + 1)) if len(pieces) == 2 else [start]
+            values.update(v % 7 if index == 4 else v for v in sequence[::step])
+        parsed.append((values, special))
+    return parsed
+
+
+def _day_matches(parsed, year, month, day):
+    last = calendar.monthrange(year, month)[1]
+    weekday = (datetime(year, month, day).weekday() + 1) % 7
+    dom, dom_special = parsed[2]
+    dow, dow_special = parsed[4]
+    return (day in dom or (('last',) in dom_special and day == last)) and (
+        weekday in dow or any((rule[0] == 'last_weekday' and weekday == rule[1] and day + 7 > last) or
+                              (rule[0] == 'nth' and weekday == rule[1] and (day - 1) // 7 + 1 == rule[2])
+                              for rule in dow_special))
+
 
