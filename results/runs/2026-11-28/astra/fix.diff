 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_NAMES = {
+    3: {name: i for i, name in enumerate(
+        'JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC'.split(), 1)},
+    4: {name: i for i, name in enumerate('SUN MON TUE WED THU FRI SAT'.split())},
+}
+_BOUNDS = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
+
+
+def _number(text):
+    if not re.fullmatch(r'[0-9]+', text):
+        raise ValueError('expected decimal digits')
+    return int(text)
+
+
+def _field(text, index):
+    low, high = _BOUNDS[index]
+    values, special = set(), []
+    unrestricted = text in ('*', '?')
+    if text == '?' and index in (2, 4):
+        text = '*'
+
+    def value(token):
+        number = _NAMES.get(index, {}).get(token)
+        if number is None:
+            number = _number(token)
+        if not low <= number <= high:
+            raise ValueError('value outside field range')
+        return number
+
+    for item in text.split(','):
+        if index == 2 and item == 'L':
+            special.append(('last',))
+            continue
+        if index == 4:
+            match = re.fullmatch(r'([0-9]+)(L|#([0-9]+))', item)
+            if match:
+                day = value(match[1]) % 7
+                if match[2] == 'L':
+                    special.append(('last', day))
+                else:
+                    nth = _number(match[3])
+                    if not 1 <= nth <= 5:
+                        raise ValueError('weekday occurrence outside range')
+                    special.append(('nth', day, nth))
+                continue
+        parts = item.split('/')
+        if len(parts) > 2:
+            raise ValueError('too many steps')
+        base = parts[0]
+        step = _number(parts[1]) if len(parts) == 2 else 1
+        if step < 1:
+            raise ValueError('step must be positive')
+        if base == '*':
+            start, end = low, high
+        elif '-' in base:
+            bounds = base.split('-')
+            if len(bounds) != 2:
+                raise ValueError('invalid range')
+            start, end = map(value, bounds)
+        else:
+            start = value(base)
+            end = high if len(parts) == 2 else start
+        if start > end:
+            raise ValueError('descending range')
+        values.update(n % 7 if index == 4 else n for n in range(start, end + 1, step))
+    return values, special, unrestricted
+
+
+def _parse(expr):
+    expr = expr.strip().upper()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    fields = re.split(r'[ \t]+', expr)
+    if len(fields) != 5:
+        raise ValueError('expected five fields')
+    return [_field(field, index) for index, field in enumerate(fields)]
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last = monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom[0] or (bool(dom[1]) and day.day == last)
+    dow_match = weekday in dow[0] or any(
+        weekday == rule[1] and (
+            day.day + 7 > last if rule[0] == 'last'
+            else (day.day - 1) // 7 + 1 == rule[2])
+        for rule in dow[1])
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    fields = _parse(expr)
