 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_left
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta
+
+_WINDOW = timedelta(days=50 * 365)
+_MONTHS = dict(zip("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), range(1, 13)))
+_WEEKDAYS = dict(zip("SUN MON TUE WED THU FRI SAT".split(), range(7)))
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+
+def _number(token, low, high, names=None):
+    if names and token.isascii() and token.upper() in names:
+        return names[token.upper()]
+    if re.fullmatch(r"[0-9]+", token):
+        value = int(token.lstrip("0") or "0")
+        if low <= value <= high:
+            return value
+    raise ValueError(f"invalid field value: {token!r}")
+
+
+def _values(item, low, high, names):
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not re.fullmatch(r"[0-9]+", step_text) or not step_text.strip("0"):
+            raise ValueError(f"invalid step: {step_text!r}")
+        # Every field has fewer than 100 values, so larger steps keep only the first.
+        digits = step_text.lstrip("0")
+        step = int(digits) if len(digits) <= 2 else 100
+    if base == "*":
+        start, end = low, high
+    else:
+        first, dash, last = base.partition("-")
+        start = _number(first, low, high, names)
+        end = _number(last, low, high, names) if dash else (high if slash else start)
+        if start > end:
+            raise ValueError(f"reversed range: {base!r}")
+    return range(start, end + 1, step)
+
+
+@dataclass
+class _Schedule:
+    minutes: list
+    hours: list
+    month_days: set
+    months: list
+    weekdays: set
+    last_day: bool
+    weekday_occurrences: list
+    any_month_day: bool
+    any_weekday: bool
+
+    def days(self, year, month):
+        first_weekday, length = monthrange(year, month)
+        if self.any_month_day and self.any_weekday:
+            return range(1, length + 1)
+
+        days = set()
+        if not self.any_month_day:
+            days.update(day for day in self.month_days if day <= length)
+            if self.last_day:
+                days.add(length)
+        # monthrange numbers weekdays from Monday, cron from Sunday.
+        first_weekday = (first_weekday + 1) % 7
+        if not self.any_weekday:
+            for weekday in self.weekdays:
+                first = 1 + (weekday - first_weekday) % 7
+                days.update(range(first, length + 1, 7))
+            for weekday, occurrence in self.weekday_occurrences:
+                first = 1 + (weekday - first_weekday) % 7
+                if occurrence is None:
+                    days.add(first + 7 * ((length - first) // 7))
+                else:
+                    day = first + 7 * (occurrence - 1)
+                    if day <= length:
+                        days.add(day)
+        return sorted(days)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expected a schedule string")
+    expr = expr.strip()
+    fields = re.split(r"[ \t]+", _SHORTCUTS.get(expr.lower(), expr))
+    if len(fields) != 5:
+        raise ValueError("expected five schedule fields")
+
+    limits = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _WEEKDAYS)]
+    values = []
+    last_day = False
+    occurrences = []
+    for i, (field, (low, high, names)) in enumerate(zip(fields, limits)):
+        if i in (2, 4) and field == "?":
+            field = "*"
+        selected = set()
+        for item in field.split(","):
+            if i == 2 and item == "L":
+                last_day = True
+                continue
+            if i == 4:
+                special = re.fullmatch(r"([0-9]+)(?:L|#([0-9]+))", item)
+                if special:
+                    weekday = _number(special[1], 0, 7) % 7
+                    occurrence = _number(special[2], 1, 5) if special[2] else None
+                    occurrences.append((weekday, occurrence))
+                    continue
+            selected.update(_values(item, low, high, names))
+        values.append(selected)
+    minutes, hours, month_days, months, weekdays = values
+    return _Schedule(sorted(minutes), sorted(hours), month_days, sorted(months),
+                     {day % 7 for day in weekdays}, last_day, occurrences,
+                     fields[2] in ("?", "*"), fields[4] in ("?", "*"))
+
 
