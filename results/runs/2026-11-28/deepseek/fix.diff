+                raise ValueError(f"bad last weekday: {item!r}")
+            day = int(match.group(1))
+            if day > 7:
+                raise ValueError(f"bad last weekday: {item!r}")
+            return ("last_weekday", day)
+        match = re.fullmatch(r"([0-9]+)#([0-9]+)", base)
+        if match:
+            if step is not None:
+                raise ValueError(f"bad nth weekday: {item!r}")
+            day = int(match.group(1))
+            nth = int(match.group(2))
+            if day > 7 or not 1 <= nth <= 5:
+                raise ValueError(f"bad nth weekday: {item!r}")
+            return ("nth_weekday", (day, nth))
+
+    if base == "*":
+        start, end = low, high
+    elif "-" in base:
+        parts = base.split("-")
+        if len(parts) != 2:
+            raise ValueError(f"bad range: {item!r}")
+        start = _parse_value(parts[0], names)
+        end = _parse_value(parts[1], names)
+        if not low <= start <= high or not low <= end <= high:
+            raise ValueError(f"value out of range: {item!r}")
+        if start > end:
+            raise ValueError(f"descending range: {item!r}")
+    else:
+        value = _parse_value(base, names)
+        if not low <= value <= high:
+            raise ValueError(f"value out of range: {item!r}")
+        if step is None:
+            start = end = value
+        else:
+            start, end = value, high
+
+    values = list(range(start, end + 1))
+    if step is not None:
+        values = values[::step]
+    return ("values", values)
+
+
+def _parse_field(text, low, high, names, allow_last_day, allow_dow_special,
+                 allow_question):
+    if text == "?":
+        if not allow_question:
+            raise ValueError("'?' is only allowed in the day fields")
+        return {
+            "values": set(range(low, high + 1)),
+            "last_day": False,
+            "last_weekdays": set(),
+            "nth_weekdays": set(),
+            "unrestricted": True,
+        }
+
+    values = set()
+    last_day = False
+    last_weekdays = set()
+    nth_weekdays = set()
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        parsed = _parse_item(
+            item, low, high, names, allow_last_day, allow_dow_special
+        )
+        kind = parsed[0]
+        if kind == "values":
+            values.update(parsed[1])
+        elif kind == "last_day":
+            last_day = True
+        elif kind == "last_weekday":
+            last_weekdays.add(parsed[1] % 7)
+        else:
+            day, nth = parsed[1]
+            nth_weekdays.add((day % 7, nth))
+
+    if allow_dow_special:
+        values = {value % 7 for value in values}
+
+    return {
+        "values": values,
+        "last_day": last_day,
+        "last_weekdays": last_weekdays,
+        "nth_weekdays": nth_weekdays,
+        "unrestricted": text == "*",
+    }
+
+
+def _parse(expr):
+    text = expr.strip()
+    if not text:
+        raise ValueError("empty schedule")
+    if text.lower() in _SHORTCUTS:
+        text = _SHORTCUTS[text.lower()]
+    elif text.startswith("@"):
+        raise ValueError(f"unknown shortcut: {expr!r}")
+
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected five fields: {expr!r}")
+
+    minute = _parse_field(fields[0], 0, 59, None, False, False, False)
+    hour = _parse_field(fields[1], 0, 23, None, False, False, False)
+    dom = _parse_field(fields[2], 1, 31, None, True, False, True)
+    month = _parse_field(fields[3], 1, 12, _MONTH_NAMES, False, False, False)
+    dow = _parse_field(fields[4], 0, 7, _DOW_NAMES, False, True, True)
+
+    minutes = sorted(minute["values"])
+    hours = sorted(hour["values"])
+    times = sorted({h * 60 + m for h in hours for m in minutes})
+    return {
+        "minutes": minute["values"],
+        "hours": hour["values"],
+        "months": month["values"],
+        "dom": dom,
+        "dow": dow,
+        "times": times,
+    }
+
+
+def _days_in_month(date):
+    return calendar.monthrange(date.year, date.month)[1]
+
+
+def _dom_matches(schedule, date, days):
+    dom = schedule["dom"]
+    return date.day in dom["values"] or (dom["last_day"] and date.day == days)
+
+
+def _dow_matches(schedule, date):
+    dow = schedule["dow"]
+    weekday = (date.weekday() + 1) % 7
+    if weekday in dow["values"]:
+        return True
+    if weekday in dow["last_weekdays"]:
+        if date.day + 7 > _days_in_month(date):
+            return True
+    nth = (date.day - 1) // 7 + 1
+    return (weekday, nth) in dow["nth_weekdays"]
+
+
+def _day_matches(schedule, date):
+    dom_restricted = not schedule["dom"]["unrestricted"]
+    dow_restricted = not schedule["dow"]["unrestricted"]
+    if not dom_restricted and not dow_restricted:
+        return True
+
+    days = _days_in_month(date)
+    dom_match = _dom_matches(schedule, date, days)
+    if dom_restricted and dow_restricted:
+        return dom_match or _dow_matches(schedule, date)
+    if dom_restricted:
+        return dom_match
+    return _dow_matches(schedule, date)
+
 
