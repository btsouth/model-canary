+
+def _parse_value(token, names):
+    if _NUMBER.fullmatch(token):
+        return int(token)
+    if names and token.lower() in names:
+        return names[token.lower()]
+    raise ValueError(f"bad value: {token!r}")
+
+
+def _parse_item(item, low, high, names, allow_last_day, allow_dow_special):
+    step = None
+    if "/" in item:
+        base, _, step_text = item.partition("/")
+        if "/" in step_text or not base or not step_text:
+            raise ValueError(f"bad step: {item!r}")
+        if not _NUMBER.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"bad step: {item!r}")
+    else:
+        base = item
+
+    if allow_last_day and base == "L":
+        if step is not None:
+            raise ValueError(f"bad last day: {item!r}")
+        return ("last_day",)
