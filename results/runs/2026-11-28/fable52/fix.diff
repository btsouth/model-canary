 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+
+# (low, high, names) for minute, hour, day of month, month, day of week
+_SPECS = [(0, 59, None), (0, 23, None), (1, 31, None), (1, 12, _MONTHS), (0, 7, _DAYS)]
+_DOM, _DOW = 2, 4
+
+_NUMBER = re.compile(r"[0-9]+")
+_LAST_DOW = re.compile(r"([0-9]+)L")
+_NTH_DOW = re.compile(r"([0-9]+)#([0-9]+)")
+_LIMIT = timedelta(days=50 * 365)
+
+
+def _value(token, low, high, names):
+    if _NUMBER.fullmatch(token):
+        value = int(token)
+    elif names is not None and token.upper() in names:
+        value = names[token.upper()]
+    else:
+        raise ValueError(f"bad value: {token!r}")
+    if not low <= value <= high:
+        raise ValueError(f"value out of range: {token!r}")
+    return value
+
+
+def _parse_field(text, index):
+    """Return (values, restricted, last_dom, last_dows, nth_dows) for one field."""
+    low, high, names = _SPECS[index]
+    values, last_dom, last_dows, nth_dows = set(), False, set(), set()
+    if text == "?":
+        if index not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        text = "*"
+    restricted = text != "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if index == _DOM and item == "L":
+            last_dom = True
+            continue
+        if index == _DOW:
+            found = _LAST_DOW.fullmatch(item)
+            if found:
+                last_dows.add(_value(found.group(1), 0, 7, None) % 7)
+                continue
+            found = _NTH_DOW.fullmatch(item)
+            if found:
+                nth = int(found.group(2))
+                if not 1 <= nth <= 5:
+                    raise ValueError(f"bad item: {item!r}")
+                nth_dows.add((_value(found.group(1), 0, 7, None) % 7, nth))
+                continue
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not _NUMBER.fullmatch(step_text):
+                raise ValueError(f"bad step: {item!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError(f"bad step: {item!r}")
+        if base == "*":
+            first, last = low, high
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            first, last = _value(a, low, high, names), _value(b, low, high, names)
+            if first > last:
+                raise ValueError(f"bad range: {item!r}")
+        else:
+            first = _value(base, low, high, names)
+            last = high if slash else first
+        listed = range(first, last + 1, step)
+        if index == _DOW:
+            values.update(v % 7 for v in listed)
+        else:
+            values.update(listed)
+    return values, restricted, last_dom, last_dows, nth_dows
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError(f"bad schedule: {expr!r}")
+        text = expr.strip()
+        if text.startswith("@"):
+            if text.lower() not in _SHORTCUTS:
+                raise ValueError(f"unknown shortcut: {expr!r}")
+            text = _SHORTCUTS[text.lower()]
+        fields = re.split(r"[ \t]+", text)
+        if len(fields) != 5:
+            raise ValueError(f"expected five fields: {expr!r}")
+        parsed = [_parse_field(f, i) for i, f in enumerate(fields)]
+        self.minutes = sorted(parsed[0][0])
+        self.hours = sorted(parsed[1][0])
+        self.months = parsed[3][0]
+        self.doms, self.dom_restricted, self.last_dom = parsed[_DOM][:3]
+        self.dows, self.dow_restricted = parsed[_DOW][:2]
+        self.last_dows, self.nth_dows = parsed[_DOW][3:]
+
+    def day_ok(self, day, weekday, ndays):
+        """weekday is 0 for Sunday; ndays is the length of the month."""
+        if self.dom_restricted:
+            dom = day in self.doms or (self.last_dom and day == ndays)
+            if not self.dow_restricted:
+                return dom
+            if dom:
+                return True
+        elif not self.dow_restricted:
+            return True
+        return (weekday in self.dows
+                or (weekday in self.last_dows and day + 7 > ndays)
+                or (weekday, (day - 1) // 7 + 1) in self.nth_dows)
 
 
