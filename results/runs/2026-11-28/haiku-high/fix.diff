index 8965296..3bb545b 100644
--- a/tally/schedule.py
+++ b/tally/schedule.py
@@ -1,11 +1,208 @@
 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from datetime import datetime, time, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTH_NAMES = {
+    name: number
+    for number, name in enumerate(
+        ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+         "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], start=1)
+}
+_DAY_NAMES = {
+    name: number
+    for number, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])
+}
+
+_MINUTE, _HOUR, _DOM, _MONTH, _DOW = range(5)
+# field -> (smallest value, largest value, names allowed in the field)
+_LIMITS = {
+    _MINUTE: (0, 59, None),
+    _HOUR: (0, 23, None),
+    _DOM: (1, 31, None),
+    _MONTH: (1, 12, _MONTH_NAMES),
+    _DOW: (0, 7, _DAY_NAMES),
+}
+
+_NUMBER = re.compile(r"[0-9]+")
+_NAME = re.compile(r"[A-Za-z]{3}")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+_HORIZON = timedelta(days=50 * 365)
+_ONE_DAY = timedelta(days=1)
+
+
+class _Schedule:
+    """A parsed expression: the sets of values each field allows."""
+
+    def __init__(self, minutes, hours, dom, dom_last, dom_restricted,
+                 months, dow, dow_last, dow_nth, dow_restricted):
+        self.minutes = sorted(minutes)
+        self.hours = sorted(hours)
+        self.dom = dom
+        self.dom_last = dom_last
+        self.dom_restricted = dom_restricted
+        self.months = months
+        self.dow = dow
+        self.dow_last = dow_last
+        self.dow_nth = dow_nth
+        self.dow_restricted = dow_restricted
+
+
+def _number(token, lo, hi):
+    if not _NUMBER.fullmatch(token):
+        raise ValueError(f"bad number: {token!r}")
+    n = int(token)
+    if not lo <= n <= hi:
+        raise ValueError(f"{n} out of range {lo}-{hi}")
+    return n
+
+
+def _value(token, field):
+    lo, hi, names = _LIMITS[field]
+    if _NUMBER.fullmatch(token):
+        return _number(token, lo, hi)
+    if names is not None and _NAME.fullmatch(token) and token.upper() in names:
+        return names[token.upper()]
+    raise ValueError(f"bad value: {token!r}")
+
+
+def _parse_item(item, field):
+    """Return (values, special) for one item. special is None, 'last-day',
+    ('last', n) for NL, or ('nth', n, k) for N#K."""
+    lo, hi, _ = _LIMITS[field]
+    base, slash, step_text = item.partition("/")
+    step = 1
+    if slash:
+        if not _NUMBER.fullmatch(step_text) or int(step_text) < 1:
+            raise ValueError(f"bad step in {item!r}")
+        step = int(step_text)
+    else:
+        if field == _DOM and base == "L":
+            return [], "last-day"
+        if field == _DOW:
+            m = _LAST_WEEKDAY.fullmatch(base)
+            if m:
+                return [], ("last", _number(m.group(1), 0, 7))
+            m = _NTH_WEEKDAY.fullmatch(base)
+            if m:
+                return [], ("nth", _number(m.group(1), 0, 7),
+                            _number(m.group(2), 1, 5))
+    if base == "*":
+        start, stop = lo, hi
+    elif "-" in base:
+        parts = base.split("-")
+        if len(parts) != 2:
+            raise ValueError(f"bad range: {base!r}")
+        start = _value(parts[0], field)
+        stop = _value(parts[1], field)
+        if start > stop:
+            raise ValueError(f"range goes backwards: {base!r}")
+    else:
+        start = _value(base, field)
+        stop = hi if slash else start
+    return list(range(start, stop + 1, step)), None
+
+
+def _parse_field(text, field):
+    values, specials = set(), []
+    for item in text.split(","):
+        item_values, special = _parse_item(item, field)
+        values.update(item_values)
+        if special is not None:
+            specials.append(special)
+    return values, specials
+
+
+def _compile(expr):
+    body = expr.strip()
+    body = _SHORTCUTS.get(body.lower(), body)
+    parts = re.split(r"[ \t]+", body)
+    if len(parts) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute_text, hour_text, dom_text, month_text, dow_text = parts
+
+    dom_restricted = dom_text not in ("*", "?")
+    dow_restricted = dow_text not in ("*", "?")
+    if dom_text == "?":
+        dom_text = "*"
+    if dow_text == "?":
+        dow_text = "*"
+
+    minutes, _ = _parse_field(minute_text, _MINUTE)
+    hours, _ = _parse_field(hour_text, _HOUR)
+    months, _ = _parse_field(month_text, _MONTH)
+    dom, dom_specials = _parse_field(dom_text, _DOM)
+    dow_raw, dow_specials = _parse_field(dow_text, _DOW)
+
+    dom_last = bool(dom_specials)
+    dow = {v % 7 for v in dow_raw}
+    dow_last, dow_nth = set(), set()
+    for special in dow_specials:
+        if special[0] == "last":
+            dow_last.add(special[1] % 7)
+        else:
+            dow_nth.add((special[1] % 7, special[2]))
+
+    return _Schedule(minutes, hours, dom, dom_last, dom_restricted,
+                     months, dow, dow_last, dow_nth, dow_restricted)
+
+
+def _day_matches(s, day):
+    last = calendar.monthrange(day.year, day.month)[1]
+    dom_ok = day.day in s.dom or (s.dom_last and day.day == last)
+    weekday = (day.weekday() + 1) % 7
+    dow_ok = (
+        weekday in s.dow
+        or (weekday in s.dow_last and day.day + 7 > last)
+        or (weekday, (day.day - 1) // 7 + 1) in s.dow_nth
+    )
+    if s.dom_restricted and s.dow_restricted:
+        return dom_ok or dow_ok
+    return dom_ok and dow_ok
+
 
 def matches(expr, when):
     """True if the schedule expr runs at the minute of the datetime when."""
-    raise NotImplementedError
+    s = _compile(expr)
+    return (
+        when.minute in s.minutes
+        and when.hour in s.hours
+        and when.month in s.months
+        and _day_matches(s, when.date())
+    )
 
 
 def next_run(expr, after):
     """The first run of expr strictly after the datetime after, or None."""
-    raise NotImplementedError
+    s = _compile(expr)
+    try:
+        start = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
+    except OverflowError:
+        return None
+    try:
+        limit = after + _HORIZON
+    except OverflowError:
+        limit = datetime.max
+    day, last_day = start.date(), limit.date()
+    while True:
+        if day.month in s.months and _day_matches(s, day):
+            for hour in s.hours:
+                for minute in s.minutes:
+                    run = datetime.combine(day, time(hour, minute), tzinfo=start.tzinfo)
+                    if run >= start:
+                        return run if run <= limit else None
+        if day >= last_day:
+            return None
+        day += _ONE_DAY
