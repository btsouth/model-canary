 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import bisect
+import calendar
+import re
+from collections import namedtuple
+from datetime import date, datetime, timedelta
+
+_RANGES = {
+    "minute": (0, 59),
+    "hour": (0, 23),
+    "dom": (1, 31),
+    "month": (1, 12),
+    "dow": (0, 7),
+}
+_NAMES = {
+    "month": {n: i for i, n in enumerate(
+        ["jan", "feb", "mar", "apr", "may", "jun",
+         "jul", "aug", "sep", "oct", "nov", "dec"], 1)},
+    "dow": {n: i for i, n in enumerate(
+        ["sun", "mon", "tue", "wed", "thu", "fri", "sat"])},
+}
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DIGITS = re.compile(r"[0-9]+")
+_LAST_WEEKDAY = re.compile(r"([0-9]+)L")
+_NTH_WEEKDAY = re.compile(r"([0-9]+)#([0-9]+)")
+
+_Spec = namedtuple(
+    "_Spec",
+    "minutes_of_day months dom dom_last dow dow_extras dom_free dow_free")
+
+
+def _number(text, field):
+    if not _DIGITS.fullmatch(text):
+        raise ValueError(f"not a number: {text!r}")
+    lo, hi = _RANGES[field]
+    value = int(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"{value} out of range for {field}")
+    return value
+
+
+def _value(text, field):
+    """A single number, or a month/day name in the fields that allow names."""
+    names = _NAMES.get(field, {})
+    if text.lower() in names:
+        return names[text.lower()]
+    return _number(text, field)
+
+
+def _item_values(item, field):
+    """Values listed by a plain item: '*', 'N', 'A-B', optionally followed by '/S'."""
+    base, slash, step_text = item.partition("/")
+    lo, hi = _RANGES[field]
+    step = 1
+    if slash:
+        if not _DIGITS.fullmatch(step_text):
+            raise ValueError(f"bad step: {item!r}")
+        step = int(step_text)
+        if step < 1:
+            raise ValueError(f"step must be at least 1: {item!r}")
+    if base == "*":
+        start, end = lo, hi
+    elif "-" in base:
+        first, _, last = base.partition("-")
+        start, end = _value(first, field), _value(last, field)
+        if start > end:
+            raise ValueError(f"range goes backwards: {item!r}")
+    else:
+        start = _value(base, field)
+        end = hi if slash else start
+    return range(start, end + 1, step)
+
+
+def _parse_items(text, field):
+    """Parse one field into (set of values, list of day-of-month/weekday extras)."""
+    values, extras = set(), []
+    for item in text.split(","):
+        if item == "":
+            raise ValueError(f"empty item in {field} field")
+        if field == "dom" and item == "L":
+            extras.append(("last_day",))
+            continue
+        if field == "dow":
+            match = _LAST_WEEKDAY.fullmatch(item)
+            if match:
+                extras.append(("last", _number(match.group(1), "dow") % 7))
+                continue
+            match = _NTH_WEEKDAY.fullmatch(item)
+            if match:
+                k = int(match.group(2))
+                if not 1 <= k <= 5:
+                    raise ValueError(f"occurrence must be 1 to 5: {item!r}")
+                extras.append(("nth", _number(match.group(1), "dow") % 7, k))
+                continue
+        values.update(_item_values(item, field))
+    return values, extras
+
+
+def _parse(expr):
+    """Validate expr and return its _Spec. Raises ValueError if it is bad."""
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        if text.lower() not in _SHORTCUTS:
+            raise ValueError(f"unknown shortcut: {expr!r}")
+        text = _SHORTCUTS[text.lower()]
+    fields = re.split(r"[ \t]+", text)
+    if len(fields) != 5:
+        raise ValueError(f"expected 5 fields: {expr!r}")
+    minute_t, hour_t, dom_t, month_t, dow_t = fields
+
+    dom_free = dom_t in ("*", "?")
+    dow_free = dow_t in ("*", "?")
+    dom_t = "*" if dom_t == "?" else dom_t
+    dow_t = "*" if dow_t == "?" else dow_t
+
+    minutes, _ = _parse_items(minute_t, "minute")
+    hours, _ = _parse_items(hour_t, "hour")
+    dom, dom_extras = _parse_items(dom_t, "dom")
+    months, _ = _parse_items(month_t, "month")
+    dow, dow_extras = _parse_items(dow_t, "dow")
+
+    minutes_of_day = sorted(h * 60 + m for h in hours for m in minutes)
+    return _Spec(
+        minutes_of_day=minutes_of_day,
+        months=months,
+        dom=dom,
+        dom_last=bool(dom_extras),
+        dow={d % 7 for d in dow},
+        dow_extras=dow_extras,
+        dom_free=dom_free,
+        dow_free=dow_free,
+    )
+
+
+def _weekday_hit(extra, day, last):
+    """True if the day matches one NL or N#K item, where last is the month's length."""
+    wd = (day.weekday() + 1) % 7  # Sunday is 0
+    if extra[0] == "last":
+        return wd == extra[1] and day.day > last - 7
+    if extra[0] == "nth":
+        return wd == extra[1] and (day.day - 1) // 7 == extra[2] - 1
+    return False
+
+
+def _day_matches(spec, day, last):
+    """Apply the classic cron day rule to a date. last is the month's length."""
+    wd = (day.weekday() + 1) % 7
+    dom_hit = day.day in spec.dom or (spec.dom_last and day.day == last)
+    dow_hit = wd in spec.dow or any(_weekday_hit(e, day, last) for e in spec.dow_extras)
+    if not spec.dom_free and not spec.dow_free:
+        return dom_hit or dow_hit
+    return dom_hit and dow_hit
+
 
