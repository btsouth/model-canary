 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+from calendar import monthrange
+from datetime import datetime, timedelta
+import re
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {name: i for i, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+
+
+def _parse_field(field, low, high, names=None, special=None):
+    """Parse one field into values, day modifiers, and its unrestricted marker."""
+    if field == "?":
+        if special not in ("dom", "dow"):
+            raise ValueError("? is only valid in a day field")
+        return set(range(low, high + 1)), [], True
+    if not field:
+        raise ValueError("empty field")
+    values = set()
+    modifiers = []
+    for item in field.split(","):
+        if not item:
+            raise ValueError("empty list item")
+        if special == "dom" and item == "L":
+            modifiers.append(("last_day",))
+            continue
+        if special == "dow":
+            match = re.fullmatch(r"(\d+)(L|#([1-5]))", item)
+            if match:
+                day = int(match.group(1))
+                if not 0 <= day <= 7:
+                    raise ValueError("day of week out of range")
+                day %= 7
+                if match.group(2) == "L":
+                    modifiers.append(("last_weekday", day))
+                else:
+                    modifiers.append(("nth_weekday", day, int(match.group(3))))
+                continue
+        if "L" in item or "#" in item:
+            raise ValueError("invalid day modifier")
+        if item.count("/") > 1:
+            raise ValueError("invalid step")
+        base, slash, step_text = item.partition("/")
+        if slash and names is not None and base.upper() in names:
+            raise ValueError("names cannot be used with a step")
+        step = 1
+        if slash:
+            if not step_text.isdigit() or int(step_text) < 1:
+                raise ValueError("invalid step")
+            step = int(step_text)
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            if base.count("-") != 1:
+                raise ValueError("invalid range")
+            left, right = base.split("-")
+            start = _field_value(left, names)
+            end = _field_value(right, names)
+            if start > end:
+                raise ValueError("descending range")
+        else:
+            start = _field_value(base, names)
+            if slash:
+                end = high
+            else:
+                end = start
+        if not low <= start <= high or not low <= end <= high:
+            raise ValueError("field value out of range")
+        values.update(range(start, end + 1, step))
+    return values, modifiers, field in ("*", "?")
+
+
+def _field_value(value, names):
+    if names is not None and value.upper() in names:
+        return names[value.upper()]
+    if not value.isdigit():
+        raise ValueError("invalid field value")
+    return int(value)
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    stripped = expr.strip()
+    if stripped.startswith("@"):
+        try:
+            stripped = _SHORTCUTS[stripped.lower()]
+        except KeyError:
+            raise ValueError("unknown schedule shortcut") from None
+    fields = re.split(r"[ \t]+", stripped) if stripped else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    minute, _, _ = _parse_field(fields[0], 0, 59)
+    hour, _, _ = _parse_field(fields[1], 0, 23)
+    dom, dom_modifiers, dom_unrestricted = _parse_field(fields[2], 1, 31, special="dom")
+    month, _, _ = _parse_field(fields[3], 1, 12, _MONTHS)
+    dow, dow_modifiers, dow_unrestricted = _parse_field(fields[4], 0, 7, _DAYS, "dow")
+    # Cron accepts 7 as Sunday; normalize it before matching.
+    if 7 in dow:
+        dow.remove(7)
+        dow.add(0)
+    return (minute, hour, dom, month, dow, dom_modifiers, dow_modifiers,
+            dom_unrestricted, dow_unrestricted)
+
+
+def _day_matches(parsed, date):
+    _, _, dom, months, dow, dom_mod, dow_mod, dom_free, dow_free = parsed
+    if date.month not in months:
+        return False
+    dom_match = date.day in dom
+    if ("last_day",) in dom_mod and date.day == monthrange(date.year, date.month)[1]:
+        dom_match = True
+    py_weekday = date.weekday()
+    cron_weekday = (py_weekday + 1) % 7
+    dow_match = cron_weekday in dow
+    last_day = monthrange(date.year, date.month)[1]
+    for modifier in dow_mod:
+        if modifier[0] == "last_weekday":
+            day = modifier[1]
+            if cron_weekday == day and date.day + 7 > last_day:
+                dow_match = True
+        elif modifier[0] == "nth_weekday":
+            _, day, occurrence = modifier
+            if cron_weekday == day and (date.day - 1) // 7 + 1 == occurrence:
+                dow_match = True
+    if dom_free and dow_free:
+        return True
+    if dom_free:
+        return dow_match
+    if dow_free:
+        return dom_match
+    return dom_match or dow_match
+
 
