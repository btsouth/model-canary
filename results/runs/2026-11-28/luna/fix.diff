 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name.upper(): i for i, name in enumerate(calendar.day_abbr)}
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("schedule must be text")
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError("unknown shortcut") from None
+    fields = re.split(r"[ \t]+", expr) if expr else []
+    if len(fields) != 5:
+        raise ValueError("schedule must have five fields")
+    specs = [(0, 59, None), (0, 23, None), (1, 31, "dom"), (1, 12, "month"), (0, 7, "dow")]
+    parsed=[]
+    for idx, (field, (lo, hi, kind)) in enumerate(zip(fields, specs)):
+        if field == '?' and kind in ("dom", "dow"):
+            parsed.append({"wild": True, "vals": set(range(lo, hi+1)), "special": []}); continue
+        unrestricted = field == '*'
+        values=set(); specials=[]
+        for item in field.split(','):
+            if not item: raise ValueError("empty item")
+            if kind == 'dom' and item == 'L':
+                specials.append(('last',)); continue
+            if kind == 'dow' and re.fullmatch(r'\dL', item):
+                n=int(item[:-1]);
+                if n > 7: raise ValueError("day out of range")
+                specials.append(('last_weekday', 0 if n == 7 else n)); continue
+            if kind == 'dow' and re.fullmatch(r'\d#[1-5]', item):
+                n,k=map(int,item.split('#'))
+                if n > 7: raise ValueError("day out of range")
+                specials.append(('nth_weekday', 0 if n == 7 else n, k)); continue
+            bits=item.split('/')
+            if len(bits)>2: raise ValueError("bad step")
+            base=bits[0]; step=1
+            if len(bits)==2:
+                if not bits[1].isdigit() or int(bits[1]) < 1: raise ValueError("bad step")
+                step=int(bits[1])
+            if base == '*': start,end=lo,hi
+            else:
+                rng=re.fullmatch(r'([^\-]+)-([^\-]+)',base)
+                if rng:
+                    start=_value(rng.group(1), idx); end=_value(rng.group(2), idx)
+                    if start>end: raise ValueError("descending range")
+                else:
+                    start=_value(base,idx)
+                    if '/' in item: end=hi
+                    else: end=start
+            if start<lo or end>hi: raise ValueError("value out of range")
+            values.update(range(start,end+1,step))
+        parsed.append({"wild": unrestricted, "vals": values, "special": specials})
+    return parsed
+
+
+def _value(token, idx):
+    if idx == 3 and token.upper() in _MONTHS: return _MONTHS[token.upper()]
+    if idx == 4 and token.upper() in _DAYS: return (_DAYS[token.upper()] + 1) % 7
+    if not token.isdigit(): raise ValueError("bad value")
+    return int(token)
+
+
+def _day_ok(specs, date):
+    dom, dow=specs[2], specs[4]
+    cron_dow=(date.weekday()+1)%7
+    md=calendar.monthrange(date.year,date.month)[1]
+    dom_match=date.day in dom['vals'] or any(x[0]=='last' and date.day==md for x in dom['special'])
+    dow_match=cron_dow in dow['vals']
+    for x in dow['special']:
+        if x[0]=='last_weekday' and cron_dow==x[1] and date.day+7>md: dow_match=True
+        if x[0]=='nth_weekday' and cron_dow==x[1] and (date.day-1)//7+1==x[2]: dow_match=True
+    if dom['wild'] and dow['wild']: return True
+    if dom['wild']: return dow_match
+    if dow['wild']: return dom_match
+    return dom_match or dow_match
 
 
