 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import datetime
+import re
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+
+_MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
+           "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
+_DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
+
+# (low, high, names) per field; names map to their numeric values.
+_FIELDS = [
+    (0, 59, None),
+    (0, 23, None),
+    (1, 31, None),
+    (1, 12, {name: i + 1 for i, name in enumerate(_MONTHS)}),
+    (0, 7, {name: i for i, name in enumerate(_DAYS)}),
+]
+_DOM, _DOW = 2, 4
+
+_NUM = re.compile(r"[0-9]+")
+_LIMIT = datetime.timedelta(days=50 * 365)
+
+
+class _Schedule:
+    __slots__ = ("minutes", "hours", "dom", "dom_last", "months",
+                 "dow", "dow_last", "dow_nth", "dom_restricted", "dow_restricted")
+
+
+def _value(text, field, allow_names=True):
+    low, high, names = _FIELDS[field]
+    if _NUM.fullmatch(text):
+        v = int(text)
+    elif allow_names and names is not None and text.upper() in names:
+        v = names[text.upper()]
+    else:
+        raise ValueError(f"bad value {text!r}")
+    if not low <= v <= high:
+        raise ValueError(f"value {text!r} out of range")
+    return v
+
+
+def _number(text, low, high):
+    if not _NUM.fullmatch(text):
+        raise ValueError(f"bad number {text!r}")
+    v = int(text)
+    if not low <= v <= high:
+        raise ValueError(f"number {text!r} out of range")
+    return v
+
+
+def _parse_field(text, field, sched):
+    low, high, _ = _FIELDS[field]
+    values = set()
+    if text == "?":
+        if field not in (_DOM, _DOW):
+            raise ValueError("'?' is only allowed in the day fields")
+        return set(range(low, high + 1)), False
+    restricted = text != "*"
+    for item in text.split(","):
+        if not item:
+            raise ValueError("empty item")
+        if field == _DOM and item == "L":
+            sched.dom_last = True
+            continue
+        if field == _DOW:
+            m = re.fullmatch(r"([0-9]+)L", item)
+            if m:
+                sched.dow_last.add(_number(m.group(1), 0, 7) % 7)
+                continue
+            m = re.fullmatch(r"([0-9]+)#([0-9]+)", item)
+            if m:
+                sched.dow_nth.add((_number(m.group(1), 0, 7) % 7,
+                                   _number(m.group(2), 1, 5)))
+                continue
+        base, slash, step_text = item.partition("/")
+        if slash:
+            if not _NUM.fullmatch(step_text):
+                raise ValueError(f"bad step {step_text!r}")
+            step = int(step_text)
+            if step < 1:
+                raise ValueError("step must be at least 1")
+        else:
+            step = 1
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            a, _, b = base.partition("-")
+            start, end = _value(a, field), _value(b, field)
+            if start > end:
+                raise ValueError(f"bad range {base!r}")
+        else:
+            start = _value(base, field)
+            end = high if slash else start
+        values.update(range(start, end + 1, step))
+    if field == _DOW:
+        values = {v % 7 for v in values}
+    return values, restricted
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be a string")
+    text = expr.strip()
+    if text.startswith("@"):
+        try:
+            text = _SHORTCUTS[text.lower()]
+        except KeyError:
+            raise ValueError(f"unknown shortcut {text!r}") from None
+    parts = re.split(r"[ \t]+", text)
+    if len(parts) != 5:
+        raise ValueError("expected five fields")
+    s = _Schedule()
+    s.dom_last = False
+    s.dow_last = set()
+    s.dow_nth = set()
+    s.minutes, _ = _parse_field(parts[0], 0, s)
+    s.hours, _ = _parse_field(parts[1], 1, s)
+    s.dom, s.dom_restricted = _parse_field(parts[2], 2, s)
+    s.months, _ = _parse_field(parts[3], 3, s)
+    s.dow, s.dow_restricted = _parse_field(parts[4], 4, s)
+    return s
+
+
+def _day_ok(s, year, month, day):
+    last = calendar.monthrange(year, month)[1]
+    cron_dow = (datetime.date(year, month, day).weekday() + 1) % 7
+
+    def dom_ok():
+        return day in s.dom or (s.dom_last and day == last)
+
+    def dow_ok():
+        return (cron_dow in s.dow
+                or (cron_dow in s.dow_last and day + 7 > last)
+                or (cron_dow, (day - 1) // 7 + 1) in s.dow_nth)
+
+    if s.dom_restricted and s.dow_restricted:
+        return dom_ok() or dow_ok()
+    if s.dom_restricted:
+        return dom_ok()
+    if s.dow_restricted:
+        return dow_ok()
+    return True
 
 
