 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import re
+from bisect import bisect_left
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: i for i, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+_DAYS = {name: i for i, name in enumerate(
+    ("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+_BOUNDS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+@dataclass
+class _Field:
+    values: set
+    unrestricted: bool = False
+    last: bool = False
+    last_weekdays: tuple = ()
+    nth_weekdays: tuple = ()
+
+
+def _number(text):
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"invalid number: {text!r}")
+    return int(text)
+
+
+def _parse_field(text, position):
+    low, high = _BOUNDS[position]
+    names = _MONTHS if position == 3 else _DAYS if position == 4 else {}
+    field = _Field(set(), text in ("*", "?"))
+    last_weekdays, nth_weekdays = [], []
+    if text == "?":
+        if position not in (2, 4):
+            raise ValueError("? is only allowed in day fields")
+        text = "*"
+
+    def endpoint(token):
+        value = names[token] if token in names else _number(token)
+        if not low <= value <= high:
+            raise ValueError(f"value out of range: {token!r}")
+        return value
+
+    for item in text.upper().split(","):
+        if position == 2 and item == "L":
+            field.last = True
+            continue
+        special = re.fullmatch(r"([0-9]+)(L|#[0-9]+)", item)
+        if position == 4 and special:
+            weekday = endpoint(special[1]) % 7
+            if special[2] == "L":
+                last_weekdays.append(weekday)
+            else:
+                occurrence = _number(special[2][1:])
+                if not 1 <= occurrence <= 5:
+                    raise ValueError("weekday occurrence must be from 1 to 5")
+                nth_weekdays.append((weekday, occurrence))
+            continue
+        pieces = item.split("/")
+        if len(pieces) > 2:
+            raise ValueError(f"invalid step: {item!r}")
+        base = pieces[0]
+        step = _number(pieces[1]) if len(pieces) == 2 else 1
+        if step < 1:
+            raise ValueError("step must be positive")
+        if base == "*":
+            start, end = low, high
+        elif "-" in base:
+            ends = base.split("-")
+            if len(ends) != 2:
+                raise ValueError(f"invalid range: {base!r}")
+            start, end = map(endpoint, ends)
+            if start > end:
+                raise ValueError("range starts after its end")
+        else:
+            start = endpoint(base)
+            end = high if len(pieces) == 2 else start
+        field.values.update(value % 7 if position == 4 else value
+                            for value in range(start, end + 1, step))
+    field.last_weekdays = tuple(last_weekdays)
+    field.nth_weekdays = tuple(nth_weekdays)
+    return field
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        raise ValueError("expression must be text")
+    expr = expr.strip()
+    expr = _SHORTCUTS.get(expr.lower(), expr)
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        raise ValueError("a schedule needs five fields")
+    return tuple(_parse_field(part, i) for i, part in enumerate(parts))
+
+
+def _day_matches(fields, day):
+    dom, dow = fields[2], fields[4]
+    weekday = (day.weekday() + 1) % 7
+    last_day = calendar.monthrange(day.year, day.month)[1]
+    dom_match = day.day in dom.values or (dom.last and day.day == last_day)
+    dow_match = (weekday in dow.values
+                 or (weekday in dow.last_weekdays and day.day + 7 > last_day)
+                 or (weekday, (day.day - 1) // 7 + 1) in dow.nth_weekdays)
+    if dom.unrestricted:
+        return dow.unrestricted or dow_match
+    if dow.unrestricted:
+        return dom_match
+    return dom_match or dow_match
+
 
