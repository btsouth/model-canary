 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import re
+from bisect import bisect_right
+from calendar import monthrange
+from datetime import date, datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {name: number for number, name in
+           enumerate("JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split(), 1)}
+_WEEKDAYS = {name: number for number, name in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_DIGITS = re.compile(r"[0-9]+")
+_SPECIAL_WEEKDAY = re.compile(r"([0-9]+)(?:L|#([0-9]+))")
+_SEARCH_LIMIT = timedelta(days=50 * 365)
+
+
+def _number(token):
+    if _DIGITS.fullmatch(token) is None:
+        raise ValueError(f"invalid number: {token!r}")
+    digits = token.lstrip("0")
+    # Any three-digit value exceeds every field maximum and every item length.
+    return 100 if len(digits) > 2 else int(digits or "0")
+
+
+def _value(token, minimum, maximum, names):
+    name = token.upper() if token.isascii() else ""
+    value = names[name] if names is not None and name in names else _number(token)
+    if not minimum <= value <= maximum:
+        raise ValueError(f"value outside {minimum}-{maximum}: {token!r}")
+    return value
+
+
+def _item_values(item, minimum, maximum, names=None):
+    base, slash, step_text = item.partition("/")
+    step = _number(step_text) if slash else 1
+    if step == 0:
+        raise ValueError("step must be positive")
+    if base == "*":
+        return range(minimum, maximum + 1, step)
+
+    first, dash, last = base.partition("-")
+    start = _value(first, minimum, maximum, names)
+    end = maximum if slash else start
+    if dash:
+        end = _value(last, minimum, maximum, names)
+    if start > end:
+        raise ValueError(f"reversed range: {base!r}")
+    return range(start, end + 1, step)
+
+
+def _field_values(field, minimum, maximum, names=None):
+    return {value for item in field.split(",")
+            for value in _item_values(item, minimum, maximum, names)}
+
+
+class _Schedule:
+    def __init__(self, expr):
+        if not isinstance(expr, str):
+            raise ValueError("schedule expression must be text")
+        expr = expr.strip()
+        if expr.isascii():
+            expr = _SHORTCUTS.get(expr.lower(), expr)
+        fields = re.split(r"[ \t]+", expr)
+        if len(fields) != 5:
+            raise ValueError("schedule must have five fields")
+
+        minute, hour, month_day, month, week_day = fields
+        self.minutes = _field_values(minute, 0, 59)
+        self.hours = _field_values(hour, 0, 23)
+        self.months = _field_values(month, 1, 12, _MONTHS)
+        self.month_day_restricted = month_day not in ("*", "?")
+        self.week_day_restricted = week_day not in ("*", "?")
+        self.month_days = set()
+        self.last_month_day = False
+        self.week_days = set()
+        self.last_week_days = set()
+        self.nth_week_days = set()
+
+        if self.month_day_restricted:
+            for item in month_day.split(","):
+                if item == "L":
+                    self.last_month_day = True
+                else:
+                    self.month_days.update(_item_values(item, 1, 31))
+
+        if self.week_day_restricted:
+            for item in week_day.split(","):
+                special = _SPECIAL_WEEKDAY.fullmatch(item)
+                if special is None:
+                    self.week_days.update(day % 7 for day in _item_values(item, 0, 7, _WEEKDAYS))
+                    continue
+                day, occurrence = special.groups()
+                weekday = _value(day, 0, 7, None) % 7
+                if occurrence is None:
+                    self.last_week_days.add(weekday)
+                else:
+                    self.nth_week_days.add((weekday, _value(occurrence, 1, 5, None)))
+
+    def allows_day(self, day, weekday, month_length):
+        if not self.month_day_restricted and not self.week_day_restricted:
+            return True
+        return (
+            day in self.month_days
+            or (self.last_month_day and day == month_length)
+            or weekday in self.week_days
+            or (weekday in self.last_week_days and day + 7 > month_length)
+            or (weekday, (day - 1) // 7 + 1) in self.nth_week_days
+        )
+
 
