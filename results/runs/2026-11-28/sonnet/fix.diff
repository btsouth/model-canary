 """Cron-style schedules. SCHEDULE.md has the full rules."""
+import calendar
+import re
+from datetime import datetime, timedelta
+
+_SHORTCUTS = {
+    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *", "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0", "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_MONTHS = {n: i + 1 for i, n in enumerate(
+    "JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC".split())}
+_DAYS = {n: i for i, n in enumerate("SUN MON TUE WED THU FRI SAT".split())}
+_NUM = re.compile(r"[0-9]+\Z")
+
+
+def _bad(msg):
+    raise ValueError(msg)
+
+
+def _value(tok, lo, hi, names):
+    if _NUM.match(tok):
+        v = int(tok)
+    elif names and tok.upper() in names:
+        v = names[tok.upper()]
+    else:
+        _bad(f"bad value {tok!r}")
+    if not lo <= v <= hi:
+        _bad(f"value out of range {tok!r}")
+    return v
+
+
+def _parse_field(text, lo, hi, names=None, special=None):
+    """Return (values, extras). extras collects L / NL / N#K items."""
+    vals, extras = set(), []
+    for item in text.split(","):
+        if not item:
+            _bad("empty item")
+        if special:
+            e = special(item)
+            if e is not None:
+                extras.append(e)
+                continue
+        base, sep, step = item.partition("/")
+        if sep:
+            if not _NUM.match(step) or int(step) < 1:
+                _bad("bad step")
+            step = int(step)
+        else:
+            step = 1
+        if base == "*":
+            a, b = lo, hi
+        elif "-" in base:
+            x, _, y = base.partition("-")
+            a, b = _value(x, lo, hi, names), _value(y, lo, hi, names)
+            if a > b:
+                _bad("descending range")
+        else:
+            a = _value(base, lo, hi, names)
+            b = hi if sep else a
+        vals.update(range(a, b + 1, step))
+    return vals, extras
+
+
+def _dom_special(item):
+    if item == "L":
+        return ("L",)
+    return None
+
+
+def _dow_special(item):
+    m = re.match(r"([0-9]+)[Ll]\Z", item)
+    if m:
+        n = int(m.group(1))
+        if n > 7:
+            _bad("bad weekday")
+        return ("last", n % 7)
+    m = re.match(r"([0-9]+)#([0-9]+)\Z", item)
+    if m:
+        n, k = int(m.group(1)), int(m.group(2))
+        if n > 7 or not 1 <= k <= 5:
+            _bad("bad N#K")
+        return ("nth", n % 7, k)
+    if "#" in item or item[-1:] in "Ll" and item[:-1].isdigit():
+        _bad("bad item")
+    return None
+
+
+def _parse(expr):
+    if not isinstance(expr, str):
+        _bad("expression must be a string")
+    expr = expr.strip()
+    if expr.startswith("@"):
+        if expr.lower() not in _SHORTCUTS:
+            _bad("unknown shortcut")
+        expr = _SHORTCUTS[expr.lower()]
+    parts = re.split(r"[ \t]+", expr)
+    if len(parts) != 5:
+        _bad("need five fields")
+    mi, ho, dom, mo, dow = parts
+    minutes, _ = _parse_field(mi, 0, 59)
+    hours, _ = _parse_field(ho, 0, 23)
+    months, _ = _parse_field(mo, 1, 12, _MONTHS)
+    dom_free = dom in ("*", "?")
+    dow_free = dow in ("*", "?")
+    if dom_free:
+        doms, domx = set(range(1, 32)), []
+    else:
+        doms, domx = _parse_field(dom, 1, 31, None, _dom_special)
+    if dow_free:
+        dows, dowx = set(range(7)), []
+    else:
+        dows, dowx = _parse_field(dow, 0, 7, _DAYS, _dow_special)
+        dows = {d % 7 for d in dows}
+    return (sorted(minutes), sorted(hours), months,
+            (dom_free, doms, domx), (dow_free, dows, dowx))
+
+
+def _day_ok(d, dompart, dowpart):
+    dom_free, doms, domx = dompart
+    dow_free, dows, dowx = dowpart
+    if dom_free and dow_free:
+        return True
+    last = calendar.monthrange(d.year, d.month)[1]
+    dom_m = d.day in doms or (bool(domx) and d.day == last)
+    wd = (d.weekday() + 1) % 7
+    dow_m = wd in dows
+    if not dow_m:
+        for e in dowx:
+            if e[0] == "last" and e[1] == wd and d.day + 7 > last:
+                dow_m = True
+            elif e[0] == "nth" and e[1] == wd and (d.day - 1) // 7 + 1 == e[2]:
+                dow_m = True
+    if dom_free:
+        return dow_m
+    if dow_free:
+        return dom_m
+    return dom_m or dow_m
 
 
