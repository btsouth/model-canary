 """Cron-style schedules. SCHEDULE.md has the full rules."""
 
+import calendar
+import datetime as dt
+import re
+
+_SHORTCUTS = {
+    '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
+    '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
+    '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+    '@hourly': '0 * * * *',
+}
+_MONTHS = {name.upper(): i for i, name in enumerate(calendar.month_abbr) if name}
+_DAYS = {name: i for i, name in enumerate(('SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'))}
+_LIMITS = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+
+
+def _parse(expr):
+    expr = expr.strip()
+    if expr.startswith('@'):
+        try:
+            expr = _SHORTCUTS[expr.lower()]
+        except KeyError:
+            raise ValueError('unknown shortcut') from None
+    parts = re.split(r'[ \t]+', expr)
+    if len(parts) != 5:
+        raise ValueError('expected five fields')
+    fields = []
+    for index, part in enumerate(parts):
+        low, high = _LIMITS[index]
+        values, special = set(), []
+        unrestricted = part in ('*', '?') and index in (2, 4)
+        if part == '?' and index in (2, 4):
+            part = '*'
+        names = _MONTHS if index == 3 else _DAYS if index == 4 else {}
+
+        def number(token):
+            if re.fullmatch(r'[0-9]+', token):
+                value = int(token)
+            elif token.upper() in names:
+                value = names[token.upper()]
+            else:
+                raise ValueError('invalid value')
+            if not low <= value <= high:
+                raise ValueError('value out of range')
+            return value
+
+        for item in part.split(','):
+            if index == 2 and item == 'L':
+                special.append(('last',))
+                continue
+            match = re.fullmatch(r'(0*[0-7])(?:L|#(0*[1-5]))', item) if index == 4 else None
+            if match:
+                special.append(('weekday', int(match[1]) % 7, int(match[2]) if match[2] else None))
+                continue
+            match = re.fullmatch(r'([^/]+)(?:/([0-9]+))?', item)
+            if not match:
+                raise ValueError('invalid item')
+            base, step_text = match.groups()
+            step = int(step_text) if step_text is not None else 1
+            if not step:
+                raise ValueError('zero step')
+            if base == '*':
+                start, end = low, high
+            elif '-' in base:
+                pair = base.split('-')
+                if len(pair) != 2:
+                    raise ValueError('invalid range')
+                start, end = map(number, pair)
+                if start > end:
+                    raise ValueError('reversed range')
+            else:
+                start = number(base)
+                end = high if step_text is not None else start
+            values.update(range(start, end + 1, step))
+        if index == 4 and 7 in values:
+            values.remove(7)
+            values.add(0)
+        fields.append((values, special, unrestricted))
+    return fields
+
+
+def _day_matches(fields, date, last):
+    dom, dow = fields[2], fields[4]
+    weekday = (date.weekday() + 1) % 7
+    dom_match = date.day in dom[0] or (bool(dom[1]) and date.day == last)
+    dow_match = weekday in dow[0] or any(
+        weekday == day and (date.day + 7 > last if nth is None else (date.day - 1) // 7 + 1 == nth)
+        for _, day, nth in dow[1]
+    )
+    if dom[2] and dow[2]:
+        return True
+    if dom[2]:
+        return dow_match
+    if dow[2]:
+        return dom_match
+    return dom_match or dow_match
+
 
